import adou.src.tools.path_utils
import adou.src.config.paths
import adou.src.platform.cwd as platform_cwd
import fs
import path
import syscall

pub type file_t = struct {
    string path
    string content
}

pub type load_result_t = struct {
    [ref<file_t>] files = []
    [string] warnings = []
}

pub type file_load_t = struct {
    ref<file_t>? file = null
    string warning
}

pub fn load(string cwd, string agent_dir): load_result_t! {
    string resolved_cwd = path_utils.resolve_to_cwd(cwd, platform_cwd.current())
    string resolved_agent_dir = agent_dir
    if resolved_agent_dir == '' {
        resolved_agent_dir = paths.agent_dir()
    } else {
        resolved_agent_dir = path_utils.resolve_to_cwd(resolved_agent_dir, resolved_cwd)
    }
    var result = load_result_t{}
    [string] warnings = []
    var global_context = load_from_dir(resolved_agent_dir)
    if global_context.warning != '' {
        warnings.push(global_context.warning)
    }
    if global_context.file is ref<file_t> global_file {
        result.files.push(global_file)
    }
    [ref<file_t>] ancestors = []
    string current = resolved_cwd
    for true {
        var found = load_from_dir(current)
        if found.warning != '' {
            warnings.push(found.warning)
        }
        if found.file is ref<file_t> context_file {
            if !contains_path(result.files, context_file.path) {
                ancestors.push(context_file)
            }
        }
        if current == '/' {
            break
        }
        string parent = path.dir(current)
        if parent == current {
            break
        }
        current = parent
    }
    for int index = ancestors.len() - 1; index >= 0; index -= 1 {
        result.files.push(ancestors[index])
    }
    result.warnings = warnings
    return result
}

// Adou treats the project .adou system prompt as a project-scoped override,
// with the user agent-dir file as the fallback. These files are distinct from
// AGENTS.md/CLAUDE.md context discovery and are loaded for the active session
// cwd only.
pub fn system_prompt_file(string cwd, string agent_dir): ref<file_t>? {
    string base_cwd = platform_cwd.current() catch error {'/'}
    string resolved_cwd = path_utils.resolve_to_cwd(cwd, base_cwd)
    string resolved_agent_dir = agent_dir
    if resolved_agent_dir == '' {
        resolved_agent_dir = paths.agent_dir()
    } else {
        resolved_agent_dir = path_utils.resolve_to_cwd(resolved_agent_dir, resolved_cwd)
    }
    ref<file_t>? project_file = read_named_file(path.join(resolved_cwd, '.adou/SYSTEM.md'))
    if project_file is ref<file_t> found_project {
        return found_project
    }
    return read_named_file(path.join(resolved_agent_dir, 'SYSTEM.md'))
}

pub fn append_system_prompt_file(string cwd, string agent_dir): ref<file_t>? {
    string base_cwd = platform_cwd.current() catch error {'/'}
    string resolved_cwd = path_utils.resolve_to_cwd(cwd, base_cwd)
    string resolved_agent_dir = agent_dir
    if resolved_agent_dir == '' {
        resolved_agent_dir = paths.agent_dir()
    } else {
        resolved_agent_dir = path_utils.resolve_to_cwd(resolved_agent_dir, resolved_cwd)
    }
    ref<file_t>? project_file = read_named_file(path.join(resolved_cwd, '.adou/APPEND_SYSTEM.md'))
    if project_file is ref<file_t> found_project {
        return found_project
    }
    return read_named_file(path.join(resolved_agent_dir, 'APPEND_SYSTEM.md'))
}

fn load_from_dir(string directory): file_load_t {
    [string] candidates = ['AGENTS.md', 'AGENTS.MD', 'CLAUDE.md', 'CLAUDE.MD']
    for candidate in candidates {
        string file_path = path.join(directory, candidate)
        if !path_utils.exists(file_path) {
            continue
        }
        var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {
            return file_load_t {warning: 'Could not read ' + file_path + ': ' + error.msg(),}
        }
        string content = input.content() catch error {
            input.close()
            return file_load_t {warning: 'Could not read ' + file_path + ': ' + error.msg(),}
        }
        input.close()
        return file_load_t {file: new file_t(path = file_path, content = content),}
    }
    return file_load_t{}
}

fn read_named_file(string file_path): ref<file_t>? {
    if !path_utils.exists(file_path) {
        return null
    }
    var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {
        return new file_t(path = file_path, content = '')
    }
    string content = input.content() catch error {
        input.close()
        return new file_t(path = file_path, content = '')
    }
    input.close()
    return new file_t(path = file_path, content = content)
}

fn contains_path([ref<file_t>] files, string value): bool {
    for file in files {
        if file.path == value {
            return true
        }
    }
    return false
}
