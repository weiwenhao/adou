import adou.src.context.prompt_templates
import adou.src.context.skills

// Port of the get_commands composition in agent-session.ts: prompt templates
// and skills register dynamic slash commands (skill names carry a skill:
// prefix), complementing the built-in commands in the TUI.

pub type slash_command_info_t = struct {
    string name
    string description
    string argument_hint
    string source
    skills.source_info_t source_info
}

pub fn prompt_commands([ref<prompt_templates.prompt_template_t>] templates): [slash_command_info_t] {
    [slash_command_info_t] result = []
    for template in templates {
        result.push(slash_command_info_t {name: template.name, description: template.description, argument_hint: template.argument_hint, source: 'prompt', source_info: template.source_info})
    }
    return result
}

pub fn skill_commands([ref<skills.skill_t>] skills_list): [slash_command_info_t] {
    [slash_command_info_t] result = []
    for skill in skills_list {
        result.push(slash_command_info_t {name: 'skill:' + skill.name, description: skill.description, source: 'skill', source_info: skill.source_info})
    }
    return result
}

// Shared enable-list filters (B1-R2-07): `configured=false` means the setting
// is absent and all resources remain available; `configured=true` applies the
// exact allow-list, including an explicit empty list (none). Production
// snapshot paths use these functions so menu, execution and display agree.
pub fn filter_prompt_templates_configured([ref<prompt_templates.prompt_template_t>] templates, [string] enabled_prompt_names, bool configured): [ref<prompt_templates.prompt_template_t>] {
    if !configured {
        return templates
    }
    [ref<prompt_templates.prompt_template_t>] result = []
    for template in templates {
        if contains_name(enabled_prompt_names, template.name) {
            result.push(template)
        }
    }
    return result
}

pub fn filter_skills_configured([ref<skills.skill_t>] skills_list, [string] enabled_skill_names, bool configured): [ref<skills.skill_t>] {
    if !configured {
        return skills_list
    }
    [ref<skills.skill_t>] result = []
    for skill in skills_list {
        if contains_name(enabled_skill_names, skill.name) {
            result.push(skill)
        }
    }
    return result
}

#local
fn contains_name([string] names, string wanted): bool {
    for name in names {
        if name == wanted {
            return true
        }
    }
    return false
}

// Production assembly shared by the TUI and the tests (B1-R2-07/08): the
// completion-menu commands are built from the SAME already-filtered
// resources that drive execution (prompt_templates for /prompt expansion,
// skills for the system prompt), so menu metadata (argument_hint,
// source_info, description) can never diverge from what actually runs.
// Order matches Pi's get_commands: prompts first, skills second.  All
// metadata fields are carried through untouched.  Pi's enableSkillCommands
// setting gates the /skill:name registration (Batch 3).
pub fn compose_resource_commands([ref<prompt_templates.prompt_template_t>] templates, [ref<skills.skill_t>] skills_list, bool enable_skill_commands): [slash_command_info_t] {
    [slash_command_info_t] result = []
    for info in prompt_commands(templates) {
        result.push(info)
    }
    if enable_skill_commands {
        for info in skill_commands(skills_list) {
            result.push(info)
        }
    }
    return result
}

// Pi RPC RpcSlashCommand wire mapping (B1-R3-08): name/description/source
// plus the full SourceInfo object {path, source, scope, origin, baseDir}.
// argument_hint is NOT part of the Pi RPC contract and is never emitted.
pub fn rpc_command_json(slash_command_info_t info): {string:any} {
    {string:any} object = {}
    object['name'] = info.name
    if info.description != '' {
        object['description'] = info.description
    }
    object['source'] = info.source
    {string:any} source_info = {}
    source_info['path'] = info.source_info.path
    source_info['source'] = info.source_info.source
    source_info['scope'] = info.source_info.scope
    source_info['origin'] = info.source_info.origin
    source_info['baseDir'] = info.source_info.base_dir
    object['sourceInfo'] = source_info
    return object
}
