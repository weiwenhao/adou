import adou.src.context.project

pub fn build(string cwd, [ref<project.file_t>] context_files, string append_text): string {
    return build_custom(cwd, context_files, '', append_text)
}

// Build the same prompt shape as Pi's custom systemPrompt option: supplied
// text replaces the default assistant instructions, while append text,
// project context and the working directory remain attached.
pub fn build_custom(string cwd, [ref<project.file_t>] context_files, string custom_prompt, string append_text): string {
    // Pi's default registry contains only the coding quartet.  grep/find/ls
    // are opt-in helpers and must not leak into prompts built without an
    // explicit selectedTools list.
    return build_with_tools(cwd, context_files, custom_prompt, append_text, ['read', 'bash', 'edit', 'write'])
}

pub fn build_with_tools(string cwd, [ref<project.file_t>] context_files, string custom_prompt, string append_text, [string] tool_names): string {
    string tool_lines = tool_descriptions(tool_names)
    string prompt = custom_prompt != '' ? custom_prompt : 'You are an expert coding assistant operating inside Adou, a Nature implementation of the Pi coding agent harness. You help users by reading files, executing commands, editing code, and writing new files.\n\nAvailable tools:\n' + (tool_lines == '' ? '(none)' : tool_lines) + '\n\nGuidelines:\n' + prompt_guidelines(tool_names)
    if append_text != '' {
        prompt += '\n\n' + append_text
    }
    if context_files.len() > 0 {
        prompt += '\n\n<project_context>\n\nProject-specific instructions and guidelines:\n\n'
        for file in context_files {
            prompt += '<project_instructions path="' + file.path + '">\n' + file.content + '\n</project_instructions>\n\n'
        }
        prompt += '</project_context>\n'
    }
    prompt += '\nCurrent working directory: ' + cwd.replace('\\', '/')
    return prompt
}

fn tool_descriptions([string] tool_names): string {
    string result = ''
    for name in tool_names {
        string description = tool_snippet(name)
        if description == '' {
            continue
        }
        result += '- ' + name + ': ' + description + '\n'
    }
    return result.trim(['\n'])
}

fn prompt_guidelines([string] tool_names): string {
    [string] values = []
    if has_tool(tool_names, 'bash') && !has_tool(tool_names, 'grep') && !has_tool(tool_names, 'find') && !has_tool(tool_names, 'ls') {
        values.push('Use bash for file operations like ls, rg, find')
    }
    // Pi appends tool-provided guidelines in the same order as the active
    // tool registry. Preserve that ordering so the model sees an identical
    // prompt when a custom --tools list is supplied.
    for name in tool_names {
        if name == 'read' {
            values.push('Use read to examine files instead of cat or sed.')
        } else if name == 'bash' {
            values.push('Inspect PI_* environment variables for current model and session details.')
        } else if name == 'edit' {
            values.push('Use edit for precise changes (edits[].oldText must match exactly)')
            values.push('When changing multiple separate locations in one file, use one edit call with multiple entries in edits[] instead of multiple edit calls')
            values.push('Each edits[].oldText is matched against the original file, not after earlier edits are applied. Do not emit overlapping or nested edits. Merge nearby changes into one edit.')
            values.push('Keep edits[].oldText as small as possible while still being unique in the file. Do not pad with large unchanged regions.')
        } else if name == 'write' {
            values.push('Use write only for new files or complete rewrites.')
        }
    }
    values.push('Be concise in your responses')
    values.push('Show file paths clearly when working with files')
    string result = ''
    for value in values {
        result += '- ' + value + '\n'
    }
    return result.trim(['\n'])
}

fn has_tool([string] tool_names, string wanted): bool {
    for name in tool_names {
        if name == wanted {return true}
    }
    return false
}

fn tool_snippet(string name): string {
    return name == 'read' ? 'Read file contents' : name == 'write' ? 'Create or overwrite files' : name == 'edit' ? 'Make precise file edits with exact text replacement, including multiple disjoint edits in one call' : name == 'bash' ? 'Execute bash commands (ls, grep, find, etc.)' : name == 'grep' ? 'Search file contents for patterns (respects .gitignore)' : name == 'find' ? 'Find files by glob pattern (respects .gitignore)' : name == 'ls' ? 'List directory contents' : ''
}
