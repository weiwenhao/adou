#linkid adou_icu_nfkc
pub fn nfkc_raw(anyptr text, int length, anyptr output, int capacity): int
#linkid adou_icu_nfd
pub fn nfd_raw(anyptr text, int length, anyptr output, int capacity): int

pub fn nfkc(string text): string! {
    if text == '' {
        return ''
    }
    int required = nfkc_raw(text.ref(), text.len(), 0, 0)
    if required < 0 {
        throw errorf('ICU NFKC normalization failed')
    }
    [u8] output = vec<u8>.new(0, required + 1)
    int length = nfkc_raw(text.ref(), text.len(), output.ref(), output.len())
    if length < 0 {
        throw errorf('ICU NFKC normalization failed')
    }
    return output.slice(0, length) as string
}

pub fn nfd(string text): string! {
    if text == '' {
        return ''
    }
    int required = nfd_raw(text.ref(), text.len(), 0, 0)
    if required < 0 {
        throw errorf('ICU NFD normalization failed')
    }
    [u8] output = vec<u8>.new(0, required + 1)
    int length = nfd_raw(text.ref(), text.len(), output.ref(), output.len())
    if length < 0 {
        throw errorf('ICU NFD normalization failed')
    }
    return output.slice(0, length) as string
}
