pub const VERSION = '0.1.0-dev'

pub type rpc_bash_update_state_t = struct {
    string id
    ref<mutex.mutex_t> output_lock
}

pub fn run(): void! {
    timings.reset_timings()
    timings.time('parseArgs')
    var argv = os.args()
    // Pi's `auth print-api-key` surface for external clients: resolve one
    // configured credential and print it alone on stdout.
    if argv.len() > 2 && argv[1] == 'auth' && argv[2] == 'print-api-key' {
        run_auth_print_api_key(argv)
        return
    }
    var arguments = args.parse(argv)
    debug.configure(arguments.debug)
    debug.log('startup', 'adou start pid=' + fmt.sprintf('%d', syscall.getpid()))
    timings.time('resolveConfig')
    if arguments.version {
        println('adou ', VERSION)
        return
    }
    if arguments.help {
        println(args.HELP)
        return
    }
    if arguments.list_models {
        string listed = models.list_filtered(arguments.list_models_pattern)
        if listed != '' {println(listed)}
        return
    }

    string cwd = platform_cwd.current()
    // Pi's CLI export is independent of provider/session startup: the first
    // value names an existing JSONL session and the optional positional value
    // is the HTML destination.  Resolve it before loading model credentials
    // or creating a new active session so exporting never mutates state.
    if arguments.export_path != '' {
        string output_path = arguments.messages.len() > 0 ? arguments.messages[0] : ''
        export_session_file(arguments.export_path, output_path, cwd) catch error {
            println('Error: ' + error.msg())
            syscall.exit(1) catch exit_error {}
        }
        return
    }
    // Configuration errors are user input, not runtime panics.  Pi reports
    // invalid provider/model/option combinations as a concise startup error
    // and exits normally; letting Nature propagate the error would expose a
    // coroutine backtrace (and, in a TTY, can leave the caller with no useful
    // guidance).  Validate the complete set of errors that resolve() can
    // produce before constructing its value-typed config result.
    if !report_startup_config_error(arguments) {
        return
    }
    var config = resolve.resolve(arguments, cwd)
    // Pi's ModelRuntime.create loads the persisted remote catalog overlay
    // before the model resolver runs; an opt-in network refresh follows.
    models.load_remote_overlays()
    if !config.offline {
        models.refresh_remote_catalogs()
    }
    if config.mode == 'rpc' && arguments.file_args.len() > 0 {
        println('Error: @file arguments are not supported in RPC mode')
        syscall.exit(1) catch exit_error {}
        return
    }
    if arguments.file_args.len() > 0 {
        string file_text = load_file_arguments(arguments.file_args, cwd)
        if file_text != '' {
            config.initial_messages = args.prepend_initial_text(config.initial_messages, file_text)
        }
    }
    bool stdin_tty = term.is_tty(term.STDIN)
    bool stdout_tty = term.is_tty(term.STDOUT)
    bool interactive = stdin_tty
    if !stdout_tty {
        interactive = false
    }
    // RPC owns stdin as its command stream.  Reading piped stdin here would
    // consume the JSONL commands before run_rpc() gets a chance to decode
    // them, making `--mode rpc` appear to hang with no responses.
    // A positional prompt is already authoritative.  Avoid probing stdin in
    // that case: on some Nature runtimes a closed non-TTY descriptor reports
    // a full zero-filled buffer instead of a zero-byte read, which would
    // silently prepend thousands of NULs to the real prompt.
    // A positional prompt is authoritative for the same reason: probing stdin
    // would consume it before the resolver gets a chance to decode it, and a
    // closed non-TTY descriptor can report a full zero-filled buffer.
    if !stdin_tty && config.mode != 'rpc' && stdin_can_contain_prompt() {
        string piped = read_piped_stdin()
        if piped != '' {
            config.initial_messages = args.prepend_initial_text(config.initial_messages, piped.trim([' ', '\t', '\r', '\n']))
            config.print_mode = true
        }
    }
    // Piped stdin and @file prompts join initial_messages after the early
    // startup checks, so the offline guard must run here to cover them.
    if config.offline && config.initial_messages.len() > 0 {
        if config.mode == 'json' {
            println(json_error('Offline mode cannot send prompts to a provider'))
        } else {
            println('Offline mode cannot send prompts to a provider')
        }
        return
    }
    if config.initial_messages.len() == 0 && !interactive && !config.print_mode && config.mode != 'rpc' {
        println('adou requires a TTY for interactive mode; pass a prompt argument for one-shot mode')
        return
    }
    var repository = open_repository(config, cwd) catch error {
        // Corrupt or invalid session files surface as a friendly startup
        // error instead of an uncaught panic.
        println('Error: ' + error.msg())
        syscall.exit(1) catch exit_error {}
        return
    }
    if repository.persisted && !path_utils.exists(repository.cwd) {
        // Pi's assertSessionCwdExists: opening a session whose stored cwd is
        // gone would silently bind every tool to a missing directory.
        string session_file = repository.session_file != '' ? '\nSession file: ' + repository.session_file : ''
        throw errorf('Stored session working directory does not exist: %s%s\nCurrent working directory: %s', repository.cwd, session_file, cwd)
    }
    // A selected Pi session carries its own working directory.  All project
    // resources, built-in tool executors, and footer paths must follow that
    // session cwd rather than the directory from which Adou was launched.
    string session_cwd = repository.cwd
    // Resolve cwd-bound settings after opening the session.  A --session or
    // --resume target may belong to another project, and Pi binds its runtime
    // to that target's .pi/settings.json rather than the launch directory.
    // Untrusted projects only get the global settings.
    var session_preferences = config.project_trusted ? settings.load_for(session_cwd) : settings.load()
    config.steering_mode = session_preferences.steering_mode
    config.follow_up_mode = session_preferences.follow_up_mode
    config.compaction.enabled = arguments.no_compaction ? false : session_preferences.auto_compaction
    config.retry_enabled = session_preferences.retry_enabled
    config.retry_max_attempts = session_preferences.retry_max_attempts
    config.retry_base_delay_ms = session_preferences.retry_base_delay_ms
    config.hide_thinking = session_preferences.hide_thinking
    if config.scoped_models.len() == 0 && session_preferences.enabled_model_ids.len() > 0 {
        config.scoped_models = session_preferences.enabled_model_ids
    }
    bool scoped_models_explicit = config.scoped_models.len() > 0
    var stored_context = repository.build_context()
    // Pi considers enabledModels a model scope, so it wins over the saved
    // default model: resolve() already selected the first scoped model and
    // this restore must not override it with the plain defaultModel.
    if !config.provider_explicit && !config.model_explicit && session_preferences.enabled_model_ids.len() == 0 && !stored_context.has_model && session_preferences.default_model != '' {
        string preferred = session_preferences.default_provider != '' ? session_preferences.default_provider + '/' + session_preferences.default_model : session_preferences.default_model
        ref<ai_types.model_t>? preferred_model = models.find(preferred)
        if preferred_model is ref<ai_types.model_t> selected_model {
            config.model = selected_model
            config.provider = selected_model.provider
            if arguments.base_url != '' {config.model.base_url = arguments.base_url}
            if arguments.context_window > 0 {config.model.context_window = arguments.context_window}
            if arguments.max_tokens > 0 {config.model.max_tokens = arguments.max_tokens}
            if !config.api_key_explicit {
                config.stream_options.api_key = auth.effective(selected_model.provider)
            }
            config.stream_options.max_tokens = config.model.max_tokens
        }
    }
    if !arguments.thinking_explicit && !stored_context.has_thinking_level && !scoped_models_explicit {
        config.thinking = models.clamp_thinking_level(config.model, session_preferences.default_thinking_level)
        config.stream_options.reasoning_effort = config.thinking
        config.stream_options.thinking_enabled = config.thinking != 'off'
    }
    if config.session_name != '' {
        repository.append_session_info(config.session_name) catch error {
            println('Could not set session name')
            ''
        }
    }
    if !config.provider_explicit && !config.model_explicit {
        var stored = repository.build_context()
        if stored.has_model {
            ref<ai_types.model_t>? restored = models.find(stored.provider + '/' + stored.model_id)
            if restored is ref<ai_types.model_t> session_model {
                config.model = session_model
                config.provider = session_model.provider
                config.stream_options.max_tokens = session_model.max_tokens
                if !config.api_key_explicit {
                    config.stream_options.api_key = auth.effective(session_model.provider)
                }
            }
        }
    }
    // Pi restores the session's persisted thinking preference independently of
    // model/provider restoration. An explicit CLI thinking value still wins.
    // Without this step a resumed session silently falls back to the global
    // default even though its thinking_level_change entry is present in JSONL.
    if !arguments.thinking_explicit && stored_context.has_thinking_level {
        config.thinking = models.clamp_thinking_level(config.model, stored_context.thinking_level)
        config.stream_options.reasoning_effort = config.thinking
        config.stream_options.thinking_enabled = config.thinking != 'off'
    }
    // Pi records the initial model and thinking level in every newly created
    // session. Existing sessions only receive a missing thinking entry; their
    // model is restored from the active branch or assistant messages. These
    // metadata entries are required for a later resume to reconstruct the same
    // runtime configuration, including an empty session that has no messages.
    if stored_context.messages.len() == 0 {
        repository.append_model_change(config.provider, config.model.id) catch error {
            println('Could not persist initial model')
            syscall.exit(1) catch exit_error {}
            return
        }
        repository.append_thinking_change(config.thinking) catch error {
            println('Could not persist initial thinking level')
            syscall.exit(1) catch exit_error {}
            return
        }
    } else if !stored_context.has_thinking_level {
        repository.append_thinking_change(config.thinking) catch error {
            println('Could not persist session thinking level')
            syscall.exit(1) catch exit_error {}
            return
        }
    }
    command.configure_agent_environment(repository.get_session_id(), repository.get_session_file(), config.provider, config.model.id, config.thinking)
    config.stream_options.session_id = repository.get_session_id()
    [ref<project.file_t>] context_files = []
    // Untrusted projects skip their AGENTS.md/CLAUDE.md context, matching
    // Pi's trust gate on project resource loading.
    if !config.no_context_files && config.project_trusted {
        var loaded = project.load(session_cwd, '')
        context_files = loaded.files
    }
    string resolved_system_prompt = config.system_prompt
    if resolved_system_prompt == '' {
        var discovered_system = project.system_prompt_file(session_cwd, '')
        if discovered_system is ref<project.file_t> system_file {
            resolved_system_prompt = system_file.content
        }
    }
    [string] resolved_append_prompts = config.append_system_prompts
    if resolved_append_prompts.len() == 0 {
        var discovered_append = project.append_system_prompt_file(session_cwd, '')
        if discovered_append is ref<project.file_t> append_file {
            resolved_append_prompts.push(append_file.content)
        }
    }
    string append_prompt = strings.join(resolved_append_prompts, '\n\n')
    [string] extra_skill_paths = []
    var skills_result = skills.load_skills(session_cwd, config_paths.agent_dir(), extra_skill_paths, true)
    // The config selector's enabledSkills list filters the model-visible
    // skills; an empty list keeps everything.
    var skill_settings = config_settings.load()
    if skill_settings.enabled_skill_names.len() > 0 {
        [ref<skills.skill_t>] filtered_skills = []
        for skill in skills_result.skills {
            if list_contains_skill(skill_settings.enabled_skill_names, skill.name) {
                filtered_skills.push(skill)
            }
        }
        skills_result.skills = filtered_skills
    }
    string skills_prompt = skills.format_skills_for_prompt(skills_result.skills)
    if skills_prompt != '' {
        if append_prompt != '' {
            append_prompt += '\n\n'
        }
        append_prompt += skills_prompt
    }
    // Extension loading is disabled: Pi's extension runtime is out of
    // scope until redesigned.  Tools are assembled from built-ins only, so
    // extension tools can never reach the model's tool surface.
    var tools = builtins.select_tools(session_cwd, config.tool_names, config.exclude_tool_names, config.no_tools || config.no_builtin_tools)
    [string] tool_names = []
    for tool in tools {
        tool_names.push(tool.name)
    }
    string system = system_prompt.build_with_tools(session_cwd, context_files, resolved_system_prompt, append_prompt, tool_names)
    var context = new agent_types.context_t(system_prompt = system, tools = tools)
    var agent_config = new agent_types.config_t(model = config.model, stream_options = config.stream_options)
    agent_config.queues.steering_mode = config.steering_mode
    agent_config.queues.follow_up_mode = config.follow_up_mode
    var runner = session.new(repository, context, agent_config, stream_provider(), config.compaction)
    runner.retry_enabled = config.retry_enabled
    runner.retry_max_attempts = config.retry_max_attempts
    runner.retry_base_delay_ms = config.retry_base_delay_ms

    if config.mode == 'rpc' {
        // Keep the original CLI overrides for later RPC session switches;
        // an empty value means the new session should rediscover its own
        // project .pi SYSTEM.md/APPEND_SYSTEM.md files.
        debug.log('mode', 'starting rpc loop')
        run_rpc(runner, config.no_context_files, config.system_prompt, config.append_system_prompts, config.scoped_models)
        timings.print_timings()
        return
    }

    // Pi's JSON mode is always headless, even when stdin/stdout are TTYs and
    // even when no prompt was supplied.  Explicit print mode is likewise a
    // one-shot runner with no TUI; a missing prompt simply produces no final
    // text, matching Pi's runPrintMode() behavior.  A positional prompt in a
    // non-TTY is also plain text (Pi resolves that app mode to "print").
    if config.mode == 'json' {
        run_headless(runner, config.initial_messages, true, true)
        return
    }
    if config.print_mode {
        run_headless(runner, config.initial_messages, true, false)
        return
    }
    if config.initial_messages.len() > 0 && !interactive {
        run_headless(runner, config.initial_messages, true, false)
        return
    }
    if !interactive {
        return
    }

    var terminal = term.open()
    var view = session_view.new(terminal, runner, config.model.id, session_cwd)
    view.model_scope_patterns = config.scoped_models
    view.system_prompt_override = config.system_prompt
    view.append_system_prompts = config.append_system_prompts
    view.no_context_files = config.no_context_files
    view.chat.thinking_visible = !config.hide_thinking
    if config.resume && config.initial_messages.len() == 0 {
        // Pi's --resume opens the session picker.  Keep the headless path
        // deterministic (open_repository already selected the recent
        // session there), while interactive startup gets the same selector
        // affordance as /resume.
        view.startup_session_picker = true
        view.show_session_overlay()
    }
    // Pi's first-time setup: a theme + telemetry welcome shown once until
    // the marker below the agent directory exists.
    if !path_utils.exists(path.join(config_paths.agent_dir(), '.adou-setup')) && config.initial_messages.len() == 0 {
        view.show_setup_overlay()
    }
    if config.initial_messages.len() > 0 {
        view.pending_initial_messages = config.initial_messages
        view.active_stream = view.start_next_initial_prompt()
    }
    view.run() catch error {
        terminal.restore() catch restore_error {}
        throw error
    }
    terminal.restore()
    // The terminal reader coroutine stays parked in a blocking PTY read after
    // the run loop exits, so the process would never terminate on its own.
    // Exit explicitly after restoring the terminal.
    syscall.exit(0) catch exit_error {}
    return
}

#local
fn stream_provider(): agent_types.stream_fn {
    agent_types.stream_fn result = fn(ref<ai_types.model_t> model, ref<ai_types.context_t> context, ref<ai_types.stream_options_t> options): ref<ai_event_stream.assistant_stream_t> {
        return provider.stream(model, context, options)
    }
    return result
}

#local
fn list_contains_skill([string] values, string target): bool {
    for value in values {
        if value == target {
            return true
        }
    }
    return false
}

// Pi's credential-print.ts print-api-key: validates --model, forbids
// --api-key, resolves the configured key (env or stored) and prints it.
#local
fn run_auth_print_api_key([string] argv): void! {
    var arguments = args.parse(argv)
    if arguments.errors.len() > 0 {
        println('Error: ' + strings.join(arguments.errors, '; '))
        syscall.exit(1) catch exit_error {}
        return
    }
    if arguments.model == '' {
        println('Error: Credential printing requires --model <model>')
        syscall.exit(1) catch exit_error {}
        return
    }
    if arguments.api_key != '' {
        println('Error: Credential printing reads configured credentials; --api-key is not supported')
        syscall.exit(1) catch exit_error {}
        return
    }
    string provider = arguments.provider
    if provider == '' && arguments.model.find('/') >= 0 {
        provider = arguments.model.slice(0, arguments.model.find('/'))
    }
    if provider == '' {
        println('Error: Credential printing requires --provider <provider> when the model is not provider-prefixed')
        syscall.exit(1) catch exit_error {}
        return
    }
    string api_key = auth.effective(provider)
    if api_key == '' {
        println('No configured API key for ' + provider)
        syscall.exit(1) catch exit_error {}
        return
    }
    println(api_key)
}

#local
fn report_startup_config_error(config_types.cli_args_t arguments): bool {
    string message = ''
    if arguments.errors.len() > 0 {
        for index, item in arguments.errors {
            if index > 0 {
                message += '\n'
            }
            message += item
        }
    }
    if arguments.api_key != '' && arguments.model == '' && arguments.scoped_models.len() == 0 {
        if message != '' {message += '\n'}
        message += '--api-key requires a model to be specified via --model, --provider/--model, or --models'
    }
    // resolve() accepts a provider from the CLI or environment.  Check those
    // explicit sources before entering the value-typed resolver so malformed
    // command-line input cannot become an uncaught coroutine error.  A stale
    // persisted provider is deliberately not rejected: Pi starts
    // interactively without credentials and lets /login repair it.
    string provider = arguments.provider
    if provider == '' {
        provider = syscall.get_env('ADOU_PROVIDER')
    }
    // An invalid persisted default is recoverable: resolve() ignores it and
    // falls back to the built-in model so `/login` remains available. Only an
    // explicit CLI/environment provider is a startup error.
    if provider != '' {
        var known = registry.find_def(provider)
        if known is null {
            if message != '' {message += '\n'}
            message += 'Unsupported provider: ' + provider
        }
    }
    if message == '' {
        return true
    }
    if arguments.mode == 'json' {
        string encoded = json_error(message) catch error {message}
        println(encoded)
    } else {
        println('Error: ' + message)
    }
    syscall.exit(1) catch exit_error {}
    return false
}

#local
fn open_repository(config_types.config_t config, string cwd): ref<repository.manager_t>! {
    if config.no_session {
        return repository.in_memory(cwd)
    }
    if config.session_path != '' {
        if config.session_path.find('/') >= 0 || config.session_path.find('\\') >= 0 || config.session_path.to_lower().ends_with('.jsonl') || config.session_path.starts_with('~') {
            return repository.open(config.session_path)
        }
        return repository.open_reference(cwd, config.session_dir, config.session_path)
    }
    if config.session_id != '' {
        return repository.open_by_id_or_create(cwd, config.session_dir, config.session_id)
    }
    if config.fork_path != '' {
        var source = repository.open_reference(cwd, config.session_dir, config.fork_path)
        // Pi's CLI --fork copies the complete source JSONL into the current
        // project's session directory.  --session-id is an optional exact
        // target id for this new child session.
        return source.fork_to(cwd, config.session_dir, config.session_id)
    }
    if config.resume {
        // Pi presents the session selector before binding a runtime to any
        // existing JSONL. Keep the placeholder in memory so cancelling the
        // picker cannot silently continue the newest project session or
        // create a new file.
        var placeholder = repository.in_memory(cwd)
        placeholder.session_dir = repository.directory_for(cwd, config.session_dir)
        return placeholder
    }
    if config.continue_recent {
        return repository.continue_recent(cwd, config.session_dir)
    }
    return repository.create(cwd, config.session_dir)
}

#local
fn run_headless(ref<session.runner_t> runner, [string] prompts, bool plain, bool json_mode): void! {
    if json_mode {
        run_json(runner, prompts)
        return
    }
    if plain {
        [ai_types.message_t] messages = []
        for prompt in prompts {
            var stream = runner.prompt(prompt) catch error {
                println('Error: ' + error.msg())
                return
            }
            for true {
                var event = stream.recv() catch error {
                    break
                }
                if event.kind == session_stream.EVENT_SESSION_END {
                    break
                }
            }
            messages = stream.result() catch error {
                string message = error.msg()
                println('Error: ' + message)
                return
            }
        }
        string answer = last_assistant_text(messages)
        if answer != '' {
            println(answer)
        }
        return
    }
    var view = chat.new(runner.agent_config.model.id, runner.repository.cwd)
    string thinking = runner.agent_config.stream_options.reasoning_effort
    if !runner.agent_config.stream_options.thinking_enabled {
        thinking = 'off'
    } else if thinking == '' {
        thinking = 'on'
    }
    view.configure(runner.agent_config.model.context_window, thinking)
    for prompt in prompts {
        var stream = runner.prompt(prompt) catch error {
            view.error_message = error.msg()
            break
        }
        for true {
            var event = stream.recv() catch error {
                break
            }
            view.apply(event)
            if event.kind == session_stream.EVENT_SESSION_END {
                break
            }
        }
        stream.result() catch error {
            view.error_message = error.msg()
        }
    }
    var lines = view.render(120)
    println(strings.join(lines, '\n'))
}

#local
fn run_json(ref<session.runner_t> runner, [string] prompts): void! {
    if runner.repository.persisted {
        println(runner.repository.header_json())
    }
    for prompt in prompts {
        var stream = runner.prompt(prompt) catch error {
            println(json_error(error.msg()))
            return
        }
        for true {
            var event = stream.recv() catch error {break}
            println(event_json.encode(event))
            if event.kind == session_stream.EVENT_SESSION_END {break}
        }
        var ignored = stream.result() catch error {
            println(json_error(error.msg()))
            return
        }
    }
}

#local
fn json_error(string message): string! {
    {string:any} object = {}
    object['type'] = 'error'
    object['message'] = message
    return json.serialize(object)
}

#local
fn export_repository(ref<repository.manager_t> repository, string target): void! {
    string absolute = write_export(repository, target)
    println('Exported session to ' + absolute)
}

#local
fn export_session_file(string source_path, string requested_output, string cwd): void! {
    string source = path_utils.resolve_to_cwd(source_path, cwd)
    var session_repository = repository.open(source)
    string target = requested_output
    if target == '' {
        string basename = path.base(source)
        if basename.to_lower().ends_with('.jsonl') {
            basename = basename.slice(0, basename.len() - 5)
        }
        target = 'adou-session-' + basename + '.html'
    }
    string absolute = path_utils.resolve_to_cwd(target, cwd)
    os.mkdirs(path.dir(absolute), 0o755)
    string html = session_export.render(session_repository)
    var destination = fs.open(absolute, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    int written = destination.write(html as [u8])
    destination.close()
    if written != html.len() {
        throw errorf('Could not write export file: %s', absolute)
    }
    println('Exported to: ' + absolute)
}

#local
fn write_export(ref<repository.manager_t> repository, string target): string! {
    if !repository.persisted {
        throw errorf('Cannot export an in-memory session')
    }
    string source_path = repository.get_session_file()
    var source = fs.open(source_path, syscall.O_RDONLY, 0)
    string content = source.content() catch error {
        source.close()
        throw error
    }
    source.close()
    string absolute = path_utils.resolve_to_cwd(target, repository.cwd)
    os.mkdirs(path.dir(absolute), 0o755)
    // Pi chooses HTML unless the caller explicitly asks for a JSONL export.
    // Keep the CLI, RPC, and interactive `/export` paths consistent.
    string output = content
    if !target.to_lower().ends_with('.jsonl') {
        output = session_export.render(repository)
    }
    var destination = fs.open(absolute, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    int written = destination.write(output as [u8])
    destination.close()
    if written != output.len() {throw errorf('Could not write export file: %s', absolute)}
    return absolute
}

pub fn html_escape(string value): string {
    return value.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')
}

// Pi's RPC mode is a newline-delimited command protocol. The command reader
// stays live while prompt/compact/bash workers stream events in the
// background; session mutations still go through the runner's busy lock.
#local
fn run_rpc(ref<session.runner_t> runner, bool no_context_files, string system_prompt_override, [string] append_system_prompts, [string] model_scope_patterns): void! {
    var input = fs.stdin()
    var reader = new buf.reader<ref<fs.file_t>>(rd = input)
    var output_lock = mutex.mutex_t.new()
    runner.set_event_sink(fn(session_stream.event_t event) {
        string line = event_json.encode(event) catch error {return}
        rpc_write(output_lock, line)
    })
    for true {
        string line = reader.read_line() catch error {break}
        line = line.trim([' ', '\t', '\r', '\n'])
        var parsed = json_util.parse(line) catch error {
            rpc_write(output_lock, rpc_error('', 'parse', 'Failed to parse command: ' + error.msg()))
            continue
        }
        if !json_util.is_obj(parsed) {
            rpc_write(output_lock, rpc_error('', 'parse', 'Failed to parse command: RPC command must be a JSON object'))
            continue
        }
        var object = parsed as {string:any}
        string command = rpc_string(object, 'type')
        string id = rpc_string(object, 'id')
        if command == 'prompt' {
            string prompt_behavior = rpc_string(object, 'streamingBehavior')
            rpc_run_prompt(runner, id, rpc_string(object, 'message'), prompt_behavior, output_lock)
        } else if command == 'steer' {
            rpc_queue_message(runner, id, rpc_string(object, 'message'), true, output_lock)
        } else if command == 'follow_up' {
            rpc_queue_message(runner, id, rpc_string(object, 'message'), false, output_lock)
        } else if command == 'abort' {
            runner.abort_and_wait()
            rpc_write(output_lock, rpc_ok(id, 'abort'))
        } else if command == 'abort_retry' {
            // Pi's abortRetry only interrupts the session-level backoff;
            // the active provider/compaction stream remains untouched.
            runner.abort_retry()
            rpc_write(output_lock, rpc_ok(id, 'abort_retry'))
        } else if command == 'get_state' {
            rpc_write(output_lock, rpc_ok_data(id, 'get_state', rpc_state(runner)))
        } else if command == 'get_available_models' {
            rpc_write(output_lock, rpc_ok_data(id, 'get_available_models', rpc_models(runner)))
        } else if command == 'set_model' {
            rpc_set_model(runner, id, rpc_string(object, 'provider'), rpc_string(object, 'modelId'), output_lock)
        } else if command == 'cycle_model' {
            rpc_cycle_model(runner, id, model_scope_patterns, output_lock)
        } else if command == 'set_thinking_level' {
            runner.set_thinking_level(rpc_string(object, 'level')) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok(id, command))
        } else if command == 'cycle_thinking_level' {
            rpc_cycle_thinking(runner, id, output_lock)
        } else if command == 'get_available_thinking_levels' {
            rpc_write(output_lock, rpc_ok_data(id, command, rpc_thinking_levels(runner.agent_config.model)))
        } else if command == 'set_steering_mode' {
            rpc_set_queue_mode(runner, id, true, rpc_string(object, 'mode'), output_lock)
        } else if command == 'set_follow_up_mode' {
            rpc_set_queue_mode(runner, id, false, rpc_string(object, 'mode'), output_lock)
        } else if command == 'set_auto_compaction' {
            runner.set_auto_compaction(rpc_bool(object, 'enabled', true)) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok(id, command))
        } else if command == 'set_auto_retry' {
            runner.set_auto_retry(rpc_bool(object, 'enabled', true)) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok(id, command))
        } else if command == 'compact' {
            rpc_run_compaction(runner, id, rpc_string(object, 'customInstructions'), output_lock)
        } else if command == 'bash' {
            rpc_run_bash(runner, id, rpc_string(object, 'command'), rpc_bool(object, 'excludeFromContext', false), output_lock)
        } else if command == 'abort_bash' {
            runner.abort_bash()
            rpc_write(output_lock, rpc_ok(id, 'abort_bash'))
        } else if command == 'get_session_stats' {
            var stats = runner.repository.stats(runner.agent_config.model.context_window) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok_data(id, command, rpc_stats(stats, runner.repository)))
        } else if command == 'export_html' {
            rpc_export_html(runner, id, rpc_string(object, 'outputPath'), output_lock)
        } else if command == 'get_messages' {
            rpc_write(output_lock, rpc_ok_data(id, command, rpc_messages(runner.copy_active_messages())))
        } else if command == 'get_last_assistant_text' {
            rpc_write(output_lock, rpc_ok_data(id, command, rpc_text_data('text', last_assistant_text(runner.copy_active_messages()))))
        } else if command == 'get_commands' {
            rpc_write(output_lock, rpc_ok_data(id, command, rpc_commands(runner, runner.repository.cwd, runner.repository.cwd)))
        } else if command == 'set_session_name' {
            string name = rpc_string(object, 'name').trim([' ', '\t', '\n', '\r'])
            if name == '' {
                rpc_write(output_lock, rpc_error(id, command, 'Session name cannot be empty'))
                continue
            }
            runner.set_session_name(name) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok(id, command))
        } else if command == 'new_session' {
            runner.start_new_session_with_parent(rpc_string(object, 'parentSession')) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok_data(id, command, rpc_cancelled_data(false)))
        } else if command == 'switch_session' {
            rpc_switch_session(runner, id, rpc_string(object, 'sessionPath'), no_context_files, system_prompt_override, append_system_prompts, output_lock)
        } else if command == 'fork' {
            string fork_text = rpc_fork_message_text(runner.repository, rpc_string(object, 'entryId'))
            runner.fork_session(rpc_string(object, 'entryId')) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            {string:any} fork_data = {}
            fork_data['text'] = fork_text
            fork_data['cancelled'] = false
            rpc_write(output_lock, rpc_ok_data(id, command, fork_data))
        } else if command == 'clone' {
            runner.clone_session() catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok_data(id, command, rpc_cancelled_data(false)))
        } else if command == 'get_entries' {
            var entries_data = rpc_entries(runner.repository, rpc_string(object, 'since')) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok_data(id, command, entries_data))
        } else if command == 'get_tree' {
            var tree_data = rpc_tree(runner.repository) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok_data(id, command, tree_data))
        } else if command == 'get_fork_messages' {
            var fork_data = rpc_fork_messages(runner.repository) catch error {
                rpc_write(output_lock, rpc_error(id, command, error.msg()))
                continue
            }
            rpc_write(output_lock, rpc_ok_data(id, command, fork_data))
        } else {
            rpc_write(output_lock, rpc_error(id, command, 'Unknown command: ' + command))
        }
    }
    // A piped RPC client may close stdin immediately after sending a prompt.
    // Keep the process alive until the background operation has emitted its
    // terminal event and released the runner, otherwise the final response
    // would be lost at EOF.
    for runner.busy {
        co.sleep(5)
    }
    runner.wait_rpc_delivery()
}

#local
fn rpc_run_prompt(ref<session.runner_t> runner, string id, string prompt, string streaming_behavior, ref<mutex.mutex_t> output_lock): void! {
    // Pi lets clients use `prompt` as a convenience queue operation while an
    // assistant turn is already running.  Keep explicit steer/follow_up
    // commands equivalent, but accept the streamingBehavior spelling too.
    if streaming_behavior == 'steer' || streaming_behavior == 'followUp' {
        runner.lock.lock()
        bool active = runner.busy
        runner.lock.unlock()
        if active {
            rpc_queue_message(runner, id, prompt, streaming_behavior == 'steer', output_lock)
            return
        }
    }
    var stream = runner.prompt_rpc(prompt) catch error {
        rpc_write(output_lock, rpc_error(id, 'prompt', error.msg()))
        return
    }
    runner.require_rpc_delivery(stream)
    go rpc_prompt_worker(runner, stream, id, output_lock)
}

#local
fn rpc_prompt_worker(ref<session.runner_t> runner, ref<session_stream.stream_t> stream, string id, ref<mutex.mutex_t> output_lock): void! {
    rpc_write(output_lock, rpc_ok(id, 'prompt'))
    for true {
        var (event, received) = stream.try_recv() catch error {break}
        if !received {
            // Nature can leave a buffered terminal send behind a coroutine
            // handoff.  Once finish() has marked the stream terminal, the
            // worker can safely publish the canonical event itself instead
            // of waiting forever for that handoff.
            if stream.is_terminal() {
                rpc_write(output_lock, event_json.encode(session_stream.event_t {kind: session_stream.EVENT_SESSION_END,}))
                break
            }
            co.sleep(1)
            continue
        }
        rpc_write(output_lock, event_json.encode(event))
        if event.kind == session_stream.EVENT_SESSION_END {break}
    }
    stream.result() catch error {
        rpc_write(output_lock, rpc_error(id, 'prompt', error.msg()))
        runner.finish_rpc_delivery(stream)
        return
    }
    runner.finish_rpc_delivery(stream)
}

#local
fn rpc_queue_message(ref<session.runner_t> runner, string id, string text, bool steering, ref<mutex.mutex_t> output_lock): void! {
    var message = new ai_types.user_message_t(content = text, timestamp = time.now().ms_timestamp())
    if steering {
        runner.queue_steering(message)
    } else {
        runner.queue_follow_up(message)
    }
    rpc_write(output_lock, rpc_ok(id, steering ? 'steer' : 'follow_up'))
}

#local
fn rpc_cycle_model(ref<session.runner_t> runner, string id, [string] model_scope_patterns, ref<mutex.mutex_t> output_lock): void! {
    [ref<ai_types.model_t>] available = []
    [models.scoped_model_t] scoped = models.resolve_scope(model_scope_patterns)
    if scoped.len() > 0 {
        // Pi cycles the resolved scoped list in the exact order supplied by
        // --models, after dropping entries whose provider has no auth.
        for entry in scoped {
            ref<ai_types.model_t> model = entry.model
            if auth.effective(model.provider) != '' || (model.provider == runner.agent_config.model.provider && runner.agent_config.stream_options.api_key != '') {
                available.push(model)
            }
        }
    } else {
        // An empty resolved scope is equivalent to no scope in Pi.  This is
        // important for unmatched patterns and for an interactive startup
        // before credentials have been configured.
        for model in models.all() {
            if auth.effective(model.provider) != '' || (model.provider == runner.agent_config.model.provider && runner.agent_config.stream_options.api_key != '') {
                available.push(model)
            }
        }
    }
    if available.len() <= 1 {
        rpc_write(output_lock, rpc_ok_data(id, 'cycle_model', null))
        return
    }
    int current = 0
    for index, model in available {
        if model.provider == runner.agent_config.model.provider && model.id == runner.agent_config.model.id {
            current = index
            break
        }
    }
    var next = available[(current + 1) % available.len()]
    runner.set_model(next) catch error {
        rpc_write(output_lock, rpc_error(id, 'cycle_model', error.msg()))
        return
    }
    string scoped_thinking = models.thinking_for(next.provider + '/' + next.id, model_scope_patterns)
    if scoped_thinking != '' {
        runner.set_thinking_level(scoped_thinking) catch error {
            rpc_write(output_lock, rpc_error(id, 'cycle_model', error.msg()))
            return
        }
    }
    {string:any} result = {}
    result['model'] = rpc_model_data(next)
    result['thinkingLevel'] = runner.agent_config.stream_options.thinking_enabled ? runner.agent_config.stream_options.reasoning_effort : 'off'
    result['isScoped'] = scoped.len() > 0
    rpc_write(output_lock, rpc_ok_data(id, 'cycle_model', result))
}

#local
fn rpc_cycle_thinking(ref<session.runner_t> runner, string id, ref<mutex.mutex_t> output_lock): void! {
    if !runner.agent_config.model.reasoning {
        rpc_write(output_lock, rpc_ok_data(id, 'cycle_thinking_level', null))
        return
    }
    [string] levels = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']
    string current = runner.agent_config.stream_options.thinking_enabled ? runner.agent_config.stream_options.reasoning_effort : 'off'
    int index = 0
    for candidate, level in levels {
        if level == current {index = candidate; break}
    }
    string next = levels[(index + 1) % levels.len()]
    runner.set_thinking_level(next) catch error {
        rpc_write(output_lock, rpc_error(id, 'cycle_thinking_level', error.msg()))
        return
    }
    {string:any} result = {}
    string effective = runner.agent_config.stream_options.thinking_enabled ? runner.agent_config.stream_options.reasoning_effort : 'off'
    result['level'] = effective
    rpc_write(output_lock, rpc_ok_data(id, 'cycle_thinking_level', result))
}

#local
fn rpc_set_queue_mode(ref<session.runner_t> runner, string id, bool steering, string mode, ref<mutex.mutex_t> output_lock): void! {
    if mode != agent_types.QUEUE_ALL && mode != agent_types.QUEUE_ONE {
        rpc_write(output_lock, rpc_error(id, steering ? 'set_steering_mode' : 'set_follow_up_mode', 'mode must be all or one-at-a-time'))
        return
    }
    if steering {
        runner.set_steering_mode(mode) catch error {
            rpc_write(output_lock, rpc_error(id, 'set_steering_mode', error.msg()))
            return
        }
    } else {
        runner.set_follow_up_mode(mode) catch error {
            rpc_write(output_lock, rpc_error(id, 'set_follow_up_mode', error.msg()))
            return
        }
    }
    rpc_write(output_lock, rpc_ok(id, steering ? 'set_steering_mode' : 'set_follow_up_mode'))
}

#local
fn rpc_run_bash(ref<session.runner_t> runner, string id, string command_text, bool excluded, ref<mutex.mutex_t> output_lock): void! {
    if command_text == '' {
        rpc_write(output_lock, rpc_error(id, 'bash', 'command is required'))
        return
    }
    runner.begin_operation() catch error {
        rpc_write(output_lock, rpc_error(id, 'bash', error.msg()))
        return
    }
    var stream = session_stream.new()
    runner.attach_bash_stream(stream)
    go rpc_bash_worker(runner, stream, command_text, excluded, id, output_lock)
}

#local
fn rpc_bash_worker(ref<session.runner_t> runner, ref<session_stream.stream_t> stream, string command_text, bool excluded, string id, ref<mutex.mutex_t> output_lock): void! {
    // Keep callback state in a heap object.  Nature's process output reader
    // invokes the callback from a separate coroutine after the worker has
    // yielded; capturing a function parameter directly would lose the RPC id
    // on that boundary even though the final response still has it.
    var update_state = new rpc_bash_update_state_t(id = id, output_lock = output_lock)
    command.output_chunk_fn on_chunk = fn(string chunk) {
        // Pi emits bash_execution_update from AgentSession.executeBash before
        // returning the final RPC response.  Write each sanitized chunk under
        // the same output lock so a response can never split an event line or
        // overtake a chunk emitted by the child process.
        var event = session_stream.event_t {kind: session_stream.EVENT_BASH_EXECUTION_UPDATE, bash_id: update_state.id, bash_delta: chunk,}
        string line = event_json.encode(event) catch error {return}
        rpc_write(update_state.output_lock, line)
    }
    var result = shell_tools.execute_bash_stream(runner.repository.cwd, command_text, 0, stream.cancellation, on_chunk) catch error {
        rpc_write(output_lock, rpc_error(id, 'bash', error.msg()))
        runner.end_operation()
        return
    }
    runner.record_bash_during_operation(command_text, result.output, result.cancelled ? -1 : result.exit_code, result.cancelled, result.truncated, result.full_output_path, excluded) catch error {
        rpc_write(output_lock, rpc_error(id, 'bash', error.msg()))
        runner.end_operation()
        return
    }
    {string:any} data = {}
    data['output'] = result.output
    if !result.cancelled {data['exitCode'] = result.exit_code}
    data['cancelled'] = result.cancelled
    data['timedOut'] = result.timed_out
    data['truncated'] = result.truncated
    if result.full_output_path != '' {data['fullOutputPath'] = result.full_output_path}
    rpc_write(output_lock, rpc_ok_data(id, 'bash', data))
    runner.end_operation()
}

#local
fn rpc_export_html(ref<session.runner_t> runner, string id, string requested_path, ref<mutex.mutex_t> output_lock): void! {
    if !runner.repository.persisted {
        rpc_write(output_lock, rpc_error(id, 'export_html', 'Cannot export an in-memory session'))
        return
    }
    string target = requested_path
    if target == '' {
        target = runner.repository.get_session_file() + '.html'
    }
    if !target.to_lower().ends_with('.html') {
        target += '.html'
    }
    string absolute = write_export(runner.repository, target) catch error {
        rpc_write(output_lock, rpc_error(id, 'export_html', error.msg()))
        return
    }
    {string:any} data = {}
    data['path'] = absolute
    rpc_write(output_lock, rpc_ok_data(id, 'export_html', data))
}

#local
fn rpc_switch_session(ref<session.runner_t> runner, string id, string session_path, bool no_context_files, string system_prompt_override, [string] append_system_prompts, ref<mutex.mutex_t> output_lock): void! {
    if session_path == '' {
        rpc_write(output_lock, rpc_error(id, 'switch_session', 'sessionPath is required'))
        return
    }
    var next = repository.open(session_path) catch error {
        rpc_write(output_lock, rpc_error(id, 'switch_session', error.msg()))
        return
    }
    runner.replace_repository(next) catch error {
        rpc_write(output_lock, rpc_error(id, 'switch_session', error.msg()))
        return
    }
    rebind_rpc_context(runner, next.cwd, no_context_files, system_prompt_override, append_system_prompts) catch error {
        rpc_write(output_lock, rpc_error(id, 'switch_session', error.msg()))
        return
    }
    rpc_write(output_lock, rpc_ok_data(id, 'switch_session', rpc_cancelled_data(false)))
}

// Session switching changes the runtime cwd.  Pi rebuilds project-bound
// tools and the system prompt at that boundary; RPC must do the same as the
// interactive TUI instead of continuing to execute tools in the old project.
#local
fn rebind_rpc_context(ref<session.runner_t> runner, string cwd, bool no_context_files, string system_prompt_override, [string] append_system_prompts): void! {
    [string] tool_names = []
    for tool in runner.base_context.tools {
        tool_names.push(tool.name)
    }
    [ref<project.file_t>] context_files = []
    if !no_context_files {
        var loaded = project.load(cwd, '')
        context_files = loaded.files
    }
    [ref<agent_types.agent_tool_t>] tools = []
    if tool_names.len() > 0 {
        tools = builtins.select_tools(cwd, tool_names, [], false)
    }
    runner.base_context.tools = tools
    string resolved_system_prompt = system_prompt_override
    if resolved_system_prompt == '' {
        var discovered_system = project.system_prompt_file(cwd, '')
        if discovered_system is ref<project.file_t> system_file {
            resolved_system_prompt = system_file.content
        }
    }
    [string] resolved_append_prompts = append_system_prompts
    if resolved_append_prompts.len() == 0 {
        var discovered_append = project.append_system_prompt_file(cwd, '')
        if discovered_append is ref<project.file_t> append_file {
            resolved_append_prompts.push(append_file.content)
        }
    }
    string append_prompt = strings.join(resolved_append_prompts, '\n\n')
    runner.base_context.system_prompt = system_prompt.build_with_tools(cwd, context_files, resolved_system_prompt, append_prompt, tool_names)
}

#local
fn rpc_run_compaction(ref<session.runner_t> runner, string id, string instructions, ref<mutex.mutex_t> output_lock): void! {
    var stream = runner.compact_now(instructions) catch error {
        rpc_write(output_lock, rpc_error(id, 'compact', error.msg()))
        return
    }
    go rpc_compaction_worker(runner, stream, id, output_lock)
}

#local
fn rpc_compaction_worker(ref<session.runner_t> runner, ref<session_stream.stream_t> stream, string id, ref<mutex.mutex_t> output_lock): void! {
    string summary = ''
    int tokens_before = 0
    int estimated_after = 0
    string failure = ''
    for true {
        var event = stream.recv() catch error {break}
        rpc_write(output_lock, event_json.encode(event))
        if event.kind == session_stream.EVENT_COMPACTION_END {
            summary = event.summary
            tokens_before = event.tokens_before
            estimated_after = event.estimated_tokens_after
            if event.error_message != '' {failure = event.error_message}
        }
        if event.kind == session_stream.EVENT_SESSION_END {break}
    }
    stream.result() catch error {
        rpc_write(output_lock, rpc_error(id, 'compact', error.msg()))
        return
    }
    if failure != '' {
        rpc_write(output_lock, rpc_error(id, 'compact', failure))
        return
    }
    {string:any} data = {}
    data['summary'] = summary
    data['tokensBefore'] = tokens_before
    data['estimatedTokensAfter'] = estimated_after
    ref<session_types.entry_t>? latest = runner.repository.latest_compaction()
    if latest is ref<session_types.entry_t> entry {
        if entry.raw is {string:any} {
            var raw = entry.raw as {string:any}
            if raw.contains('firstKeptEntryId') && raw['firstKeptEntryId'] is string {
                data['firstKeptEntryId'] = raw['firstKeptEntryId'] as string
            }
        }
    }
    rpc_write(output_lock, rpc_ok_data(id, 'compact', data))
}

#local
fn rpc_set_model(ref<session.runner_t> runner, string id, string provider_name, string model_id, ref<mutex.mutex_t> output_lock): void! {
    ref<ai_types.model_t>? selected = models.find(provider_name + '/' + model_id)
    if !(selected is ref<ai_types.model_t>) {
        rpc_write(output_lock, rpc_error(id, 'set_model', 'Model not found: ' + provider_name + '/' + model_id))
        return
    }
    runner.set_model(selected as ref<ai_types.model_t>) catch error {
        rpc_write(output_lock, rpc_error(id, 'set_model', error.msg()))
        return
    }
    rpc_write(output_lock, rpc_ok_data(id, 'set_model', rpc_model_data(selected as ref<ai_types.model_t>)))
}

#local
fn rpc_state(ref<session.runner_t> runner): {string:any} {
    {string:any} object = {}
    object['model'] = rpc_model_data(runner.agent_config.model)
    object['thinkingLevel'] = runner.agent_config.stream_options.thinking_enabled ? runner.agent_config.stream_options.reasoning_effort : 'off'
    object['isStreaming'] = runner.busy
    object['isCompacting'] = runner.compacting
    object['steeringMode'] = runner.agent_config.queues.steering_mode
    object['followUpMode'] = runner.agent_config.queues.follow_up_mode
    string session_file = runner.repository.get_session_file()
    if session_file != '' {object['sessionFile'] = session_file}
    object['sessionId'] = runner.repository.get_session_id()
    string session_name = runner.repository.get_session_name() catch error {''}
    if session_name != '' {object['sessionName'] = session_name}
    object['autoCompactionEnabled'] = runner.compaction_settings.enabled
    object['messageCount'] = runner.active_messages.len()
    object['pendingMessageCount'] = runner.agent_config.queues.pending_count()
    return object
}

#local
fn rpc_models(ref<session.runner_t> runner): {string:any} {
    [any] values = []
    for model in models.all() {
        if auth.effective(model.provider) == '' && !(model.provider == runner.agent_config.model.provider && runner.agent_config.stream_options.api_key != '') {
            continue
        }
        values.push(rpc_model_data(model))
    }
    {string:any} result = {}
    result['models'] = values
    return result
}

#local
fn rpc_model_data(ref<ai_types.model_t> model): {string:any} {
    {string:any} object = {}
    object['provider'] = model.provider
    object['id'] = model.id
    object['name'] = model.id
    object['api'] = model.api
    object['baseUrl'] = model.base_url
    object['reasoning'] = model.reasoning
    [any] inputs = ['text']
    object['input'] = inputs
    object['contextWindow'] = model.context_window
    object['maxTokens'] = model.max_tokens
    {string:any} cost = {}
    cost['input'] = model.cost.input
    cost['output'] = model.cost.output
    cost['cacheRead'] = model.cost.cache_read
    cost['cacheWrite'] = model.cost.cache_write
    object['cost'] = cost
    return object
}

#local
fn rpc_thinking_levels(ref<ai_types.model_t> model): {string:any} {
    [any] values = []
    for level in models.available_thinking_levels(model) {
        values.push(level)
    }
    {string:any} result = {}
    result['levels'] = values
    return result
}

#local
fn rpc_messages([ai_types.message_t] messages): {string:any} {
    [any] values = []
    for message in messages {
        var encoded = message_json.encode(message) catch error {{}}
        values.push(encoded)
    }
    {string:any} result = {}
    result['messages'] = values
    return result
}

#local
fn rpc_entries(ref<repository.manager_t> repository, string since): {string:any}! {
    [any] values = []
    bool found_since = since == ''
    for entry in repository.get_entries() {
        if !found_since {
            if entry.id == since {
                found_since = true
            }
            continue
        }
        values.push(entry.raw)
    }
    if since != '' && !found_since {
        // Keep the helper errable so callers can surface the same explicit
        // error Pi returns for an unknown cursor.
        throw errorf('Entry not found: %s', since)
    }
    {string:any} result = {}
    result['entries'] = values
    result['leafId'] = rpc_nullable_string(repository.get_leaf_id())
    return result
}

#local
fn rpc_tree(ref<repository.manager_t> repository): {string:any} {
    [string] visited = []
    [any] roots = rpc_tree_nodes(repository, '', visited)
    {string:any} result = {}
    result['tree'] = roots
    result['leafId'] = rpc_nullable_string(repository.get_leaf_id())
    return result
}

#local
fn rpc_tree_nodes(ref<repository.manager_t> repository, string parent_id, [string] visited): [any] {
    [any] values = []
    for entry in repository.get_entries() {
        // An entry whose parent reference is missing, itself, or a descendant
        // (corrupt data) is surfaced as a root like Pi instead of being
        // dropped or recursing forever.
        bool dangling_parent = false
        if entry.has_parent && entry.parent_id != entry.id {
            bool parent_exists = false
            for candidate in repository.get_entries() {
                if candidate.id == entry.parent_id {parent_exists = true; break}
            }
            dangling_parent = !parent_exists
        }
        bool is_root = !entry.has_parent || entry.parent_id == entry.id || dangling_parent
        bool matches = parent_id == '' ? is_root : entry.has_parent && entry.parent_id == parent_id && entry.parent_id != entry.id
        if !matches {continue}
        bool seen = false
        for existing in visited {
            if existing == entry.id {seen = true; break}
        }
        // Corrupt session files can reference a parent that points back at
        // the entry (self-loops) or at a descendant (cycles).  Guard the
        // recursion so get_tree terminates and still returns every entry.
        if seen {continue}
        {string:any} node = {}
        node['entry'] = entry.raw
        [string] next_visited = visited
        next_visited.push(entry.id)
        node['children'] = rpc_tree_nodes(repository, entry.id, next_visited)
        string label = repository.get_label(entry.id)
        if label != '' {
            node['label'] = label
            string label_timestamp = repository.get_label_timestamp(entry.id)
            if label_timestamp != '' {
                node['labelTimestamp'] = label_timestamp
            }
        }
        values.push(node)
    }
    return values
}

#local
fn rpc_fork_messages(ref<repository.manager_t> repository): {string:any} {
    [any] values = []
    for entry in repository.get_entries() {
        if entry.kind != session_types.ENTRY_MESSAGE {continue}
        string text = rpc_fork_message_text(repository, entry.id)
        if text == '' {continue}
        {string:any} item = {}
        item['entryId'] = entry.id
        item['text'] = text
        values.push(item)
    }
    {string:any} result = {}
    result['messages'] = values
    return result
}

#local
fn rpc_fork_message_text(ref<repository.manager_t> repository, string entry_id): string {
    ref<session_types.entry_t>? possible = repository.get_entry(entry_id) catch error {return ''}
    if !(possible is ref<session_types.entry_t>) {return ''}
    var entry = possible as ref<session_types.entry_t>
    if entry.kind != session_types.ENTRY_MESSAGE {return ''}
    if !(entry.raw is {string:any}) {return ''}
    var object = entry.raw as {string:any}
    if !object.contains('message') || !(object['message'] is {string:any}) {return ''}
    var message = message_json.decode(object['message']) catch error {return ''}
    if message is ref<ai_types.user_message_t> user {return user.content}
    return ''
}

#local
fn rpc_nullable_string(string value): any {
    if value == '' {
        return null
    }
    return value
}

#local
fn rpc_cancelled_data(bool cancelled): {string:any} {
    {string:any} object = {}
    object['cancelled'] = cancelled
    return object
}

#local
fn rpc_commands(ref<session.runner_t> runner, string cwd, string session_cwd): {string:any} {
    // Pi's get_commands composes prompt templates and skills as dynamic
    // slash commands with source metadata.
    [any] values = []
    [string] no_extra = []
    var templates = prompt_templates.load_prompt_templates(session_cwd, config_paths.agent_dir(), no_extra, true)
    for info in slash_commands.prompt_commands(templates) {
        {string:any} object = {}
        object['name'] = info.name
        if info.description != '' {
            object['description'] = info.description
        }
        object['source'] = info.source
        values.push(object)
    }
    var skills_result = skills.load_skills(session_cwd, config_paths.agent_dir(), no_extra, true)
    for info in slash_commands.skill_commands(skills_result.skills) {
        {string:any} object = {}
        object['name'] = info.name
        if info.description != '' {
            object['description'] = info.description
        }
        object['source'] = info.source
        values.push(object)
    }
    {string:any} result = {}
    result['commands'] = values
    return result
}

#local
fn rpc_stats(repository.stats_t stats, ref<repository.manager_t> repository): {string:any} {
    {string:any} object = {}
    string session_file = repository.get_session_file()
    if session_file != '' {object['sessionFile'] = session_file}
    object['sessionId'] = repository.get_session_id()
    object['userMessages'] = stats.user_messages
    object['assistantMessages'] = stats.assistant_messages
    object['toolCalls'] = stats.tool_calls
    object['toolResults'] = stats.tool_results
    object['totalMessages'] = stats.total_messages
    {string:any} tokens = {}
    tokens['input'] = stats.usage.input
    tokens['output'] = stats.usage.output
    tokens['cacheRead'] = stats.usage.cache_read
    tokens['cacheWrite'] = stats.usage.cache_write
    tokens['total'] = stats.usage.total_tokens
    object['tokens'] = tokens
    object['cost'] = stats.usage.cost.total
    if stats.context_window > 0 && repository.context_usage_known() {
        {string:any} context_usage = {}
        context_usage['tokens'] = stats.context_tokens
        context_usage['contextWindow'] = stats.context_window
        context_usage['percent'] = stats.context_tokens as float * 100.0 / stats.context_window as float
        object['contextUsage'] = context_usage
    }
    return object
}

#local
fn rpc_text_data(string key, string value): {string:any} {
    {string:any} object = {}
    if value == '' {
        object[key] = null
    } else {
        object[key] = value
    }
    return object
}

#local
fn rpc_ok(string id, string command): string! {
    {string:any} object = {}
    if id != '' {object['id'] = id}
    object['type'] = 'response'
    object['command'] = command
    object['success'] = true
    return json.serialize(object)
}

#local
fn rpc_ok_data(string id, string command, any data): string! {
    {string:any} object = {}
    if id != '' {object['id'] = id}
    object['type'] = 'response'
    object['command'] = command
    object['success'] = true
    object['data'] = data
    return json.serialize(object)
}

#local
fn rpc_error(string id, string command, string message): string! {
    {string:any} object = {}
    if id != '' {object['id'] = id}
    object['type'] = 'response'
    object['command'] = command
    object['success'] = false
    object['error'] = message
    return json.serialize(object)
}

#local
fn rpc_write(ref<mutex.mutex_t> output_lock, string line) {
    output_lock.lock()
    var output = fs.stdout() catch error {
        output_lock.unlock()
        return
    }
    output.write((line + '\n') as [u8]) catch error {}
    output_lock.unlock()
}

#local
fn rpc_string({string:any} object, string key): string {
    if object.contains(key) && object[key] is string {return object[key] as string}
    return ''
}

#local
fn rpc_bool({string:any} object, string key, bool fallback): bool {
    if object.contains(key) && object[key] is bool {return object[key] as bool}
    return fallback
}

#local
fn last_assistant_text([ai_types.message_t] messages): string {
    for int index = messages.len() - 1; index >= 0; index -= 1 {
        if messages[index] is ref<ai_types.assistant_message_t> assistant {
            if assistant.stop_reason == ai_types.STOP_ABORTED && assistant.content.len() == 0 {
                continue
            }
            string text = ''
            for block in assistant.content {
                if block is ref<ai_types.text_content_t> content {
                    text += content.text
                }
            }
            return text.trim([' ', '\t', '\n', '\r'])
        }
    }
    return ''
}

#local
fn load_file_arguments([string] file_args, string cwd): string! {
    string result = ''
    for file_arg in file_args {
        string absolute = path_utils.resolve_to_cwd(file_arg, cwd)
        var input = fs.open(absolute, syscall.O_RDONLY, 0) catch error {
            throw errorf('Could not read @ file %s: %s', absolute, error.msg())
        }
        string content = input.content() catch error {
            input.close()
            throw errorf('Could not read @ file %s: %s', absolute, error.msg())
        }
        input.close()
        if content == '' {
            continue
        }
        result += '<file name="' + absolute + '">\n' + content + '\n</file>\n'
    }
    return result
}


#linkid adou_stdin_peek
fn stdin_peek(int fd): int

#local
fn read_piped_stdin(): string! {
    var input = fs.stdin()
    [u8] output = vec<u8>.new(0, 0)
    for true {
        // Poll before every read: under `/bin/sh` command substitution the
        // launcher keeps the process stdin pipe open with no writer closing
        // it, and a blocking read would wait for EOF forever.  A zero- or
        // negative-timeout poll tells us whether data is present or the peer
        // closed; when neither is true we must stop instead of blocking.
        int ready = stdin_peek(term.STDIN)
        if ready <= 0 {
            break
        }
        var buffer = vec<u8>.new(0, 4096)
        int count = input.read(buffer)
        if count <= 0 {
            break
        }
        var chunk = buffer.slice(0, count)
        // Treat a zero-filled read from an empty/closed descriptor as EOF.
        // This is defensive for the current Nature fs runtime, which can
        // report the destination length while leaving the bytes untouched.
        bool has_nonzero = false
        for byte in chunk {
            if byte != 0 {
                has_nonzero = true
                break
            }
        }
        if !has_nonzero {
            break
        }
        output.append(chunk)
    }
    // Some Nature runtime pipe reads include zero-filled capacity before the
    // bytes read from the descriptor.  Drop those runtime padding bytes before
    // applying Pi's whitespace trim to the actual stdin content.
    [u8] cleaned = vec<u8>.cap_of(output.len())
    for byte in output {
        if byte != 0 {
            cleaned.push(byte)
        }
    }
    return cleaned as string
}

// A non-TTY stdin is not necessarily a pipe.  The process launcher commonly
// gives CLI programs /dev/null when there is no redirected input; Nature's
// fs.read implementation may report a full zero-filled buffer for that
// character device instead of an EOF.  Pi treats that case as "no piped
// prompt".  Inspect the descriptor type before reading so a bare `adou`
// never manufactures a prompt containing NUL bytes, while regular-file and
// FIFO redirection continue to work.
#local
fn stdin_can_contain_prompt(): bool {
    var status = syscall.fstat(term.STDIN) catch error {
        return false
    }
    return syscall.stat_is_reg(status.mode) || syscall.stat_is_fifo(status.mode) || syscall.stat_is_sock(status.mode)
}
