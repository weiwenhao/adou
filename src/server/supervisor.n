import adou.src.agent.event_json
import adou.src.agent.session_stream
import adou.src.server.protocol
import adou.src.server.rpc_process
import adou.src.session.identity
import co.mutex

// Multi-instance supervisor backed by one real `adou --mode rpc` child per
// instance, matching Pi server's RpcProcessInstance isolation boundary.
pub const INSTANCE_STARTING = 'starting'
pub const INSTANCE_ONLINE = 'online'
pub const INSTANCE_EXITED = 'exited'
pub const INSTANCE_STOPPED = 'stopped'

pub type subscriber_t = struct {
    int id
    ref<mutex.mutex_t> lock
    fn(string line) write
}

pub type instance_t = struct {
    protocol.instance_summary_t summary
    ref<rpc_process.rpc_process_t>? process = null
    ref<mutex.mutex_t> subscriber_lock = mutex.mutex_t.new()
    [subscriber_t] subscribers
    int next_subscriber_id = 1
    ref<mutex.mutex_t> state_lock = mutex.mutex_t.new()
    string status = INSTANCE_STARTING
    string exit_reason
}

pub type supervisor_t = struct {
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    [ref<instance_t>] instances
    string executable
    bool offline
}

pub fn new(string executable, bool offline): ref<supervisor_t> {
    return new supervisor_t(instances = [], executable = executable, offline = offline)
}

// Preserve Adou's observable starting->online transition while changing the
// isolation mechanism underneath it.  Initialization performs the same
// get_state handshake Pi uses before declaring an instance online.
pub fn supervisor_t.spawn(&self, string cwd, string label): protocol.instance_summary_t! {
    string instance_id = identity.uuid_v7() catch error {
        throw error
    }
    var summary = protocol.instance_summary_t {id: instance_id, status: INSTANCE_STARTING, cwd: cwd, label: label, session_id: '', session_file: ''}
    var instance = new instance_t(summary = summary, subscribers = [], status = INSTANCE_STARTING)
    self.lock.lock()
    self.instances.push(instance)
    self.lock.unlock()
    go finish_spawn(self, instance, cwd)
    return summary
}

#local
fn finish_spawn(ref<supervisor_t> supervisor, ref<instance_t> instance, string cwd) {
    var child = rpc_process.start(supervisor.executable, cwd, fn(string line) {
        instance.emit_line(line)
    }, fn(string reason) {
        if instance.state_status() != INSTANCE_STOPPED {
            instance.set_state(INSTANCE_EXITED, reason)
        }
    }) catch error {
        instance.set_state(INSTANCE_EXITED, 'Failed to initialize RPC process: ' + error.msg())
        return
    }
    instance.set_process(child)
    if instance.state_status() == INSTANCE_STOPPED {
        child.dispose()
        return
    }
    sync_summary(instance, child) catch error {
        child.dispose()
        if instance.state_status() != INSTANCE_STOPPED {
            instance.set_state(INSTANCE_EXITED, 'Failed to initialize RPC process: ' + error.msg())
        }
        return
    }
    if instance.state_status() == INSTANCE_STARTING {
        instance.set_state(INSTANCE_ONLINE, '')
    }
}

pub fn supervisor_t.get(&self, string instance_id): ref<instance_t>? {
    self.lock.lock()
    ref<instance_t>? found = null
    for instance in self.instances {
        if instance.summary.id == instance_id {
            found = instance
            break
        }
    }
    self.lock.unlock()
    return found
}

pub fn supervisor_t.list(&self): [protocol.instance_summary_t] {
    self.lock.lock()
    [ref<instance_t>] current = self.instances
    self.lock.unlock()
    [protocol.instance_summary_t] result = []
    for instance in current {
        result.push(instance.snapshot())
    }
    return result
}

pub fn instance_t.snapshot(&self): protocol.instance_summary_t {
    self.state_lock.lock()
    var result = self.summary
    result.status = self.status
    result.exit_error = self.exit_reason
    self.state_lock.unlock()
    return result
}

pub fn instance_t.state_status(&self): string {
    self.state_lock.lock()
    string result = self.status
    self.state_lock.unlock()
    return result
}

pub fn instance_t.set_process(&self, ref<rpc_process.rpc_process_t> child) {
    self.state_lock.lock()
    self.process = child
    self.state_lock.unlock()
}

pub fn instance_t.get_process(&self): ref<rpc_process.rpc_process_t>? {
    self.state_lock.lock()
    var result = self.process
    self.state_lock.unlock()
    return result
}

pub fn instance_t.set_state(&self, string next_status, string reason) {
    self.state_lock.lock()
    string current = self.status
    if current == next_status {
        self.state_lock.unlock()
        return
    }
    self.status = next_status
    if reason != '' {
        self.exit_reason = reason
    }
    self.state_lock.unlock()
    var event = session_stream.event_t {kind: session_stream.EVENT_INSTANCE_STATUS, instance_id: self.summary.id, instance_status: next_status, instance_exit_reason: reason}
    string line = event_json.encode(event) catch error {
        return
    }
    self.emit_line(line)
}

pub fn instance_t.update_summary(&self, string session_id, string session_file) {
    self.state_lock.lock()
    self.summary.session_id = session_id
    self.summary.session_file = session_file
    self.state_lock.unlock()
}

// Send one command to the child and refresh persisted session identity after
// the same metadata-changing command set used by Pi's ServerSupervisor.
pub fn supervisor_t.rpc(&self, ref<instance_t> instance, {string:any} command): {string:any}! {
    var process_value = instance.get_process()
    if !(process_value is ref<rpc_process.rpc_process_t>) {
        throw errorf('Instance %s is not running', instance.summary.id)
    }
    var child = process_value as ref<rpc_process.rpc_process_t>
    var response = child.send(command)
    if refreshes_session(field_string(command, 'type')) {
        sync_summary(instance, child) catch error {}
    }
    return response
}

pub fn supervisor_t.stop(&self, string instance_id): bool {
    var found = self.get(instance_id)
    if !(found is ref<instance_t>) {
        return false
    }
    var live = found as ref<instance_t>
    live.set_state(INSTANCE_STOPPED, '')
    var child = live.get_process()
    if child is ref<rpc_process.rpc_process_t> process_value {
        process_value.dispose()
    }
    return true
}

pub fn supervisor_t.subscribe(&self, ref<instance_t> instance, ref<mutex.mutex_t> lock, fn(string line) write): int {
    instance.subscriber_lock.lock()
    int id = instance.next_subscriber_id
    instance.next_subscriber_id += 1
    instance.subscribers.push(subscriber_t {id: id, lock: lock, write: write})
    instance.subscriber_lock.unlock()
    return id
}

pub fn supervisor_t.unsubscribe(&self, ref<instance_t> instance, int subscriber_id) {
    instance.subscriber_lock.lock()
    [subscriber_t] remaining = []
    for subscriber in instance.subscribers {
        if subscriber.id != subscriber_id {
            remaining.push(subscriber)
        }
    }
    instance.subscribers = remaining
    instance.subscriber_lock.unlock()
}

pub fn instance_t.emit_line(&self, string line) {
    self.subscriber_lock.lock()
    [subscriber_t] current = self.subscribers
    self.subscriber_lock.unlock()
    for subscriber in current {
        subscriber.lock.lock()
        subscriber.write(line)
        subscriber.lock.unlock()
    }
}

pub fn supervisor_t.shutdown(&self) {
    self.lock.lock()
    [ref<instance_t>] current = self.instances
    self.instances = []
    self.lock.unlock()
    for instance in current {
        instance.set_state(INSTANCE_STOPPED, '')
        var child = instance.get_process()
        if child is ref<rpc_process.rpc_process_t> process_value {
            process_value.dispose()
        }
    }
}

#local
fn sync_summary(ref<instance_t> instance, ref<rpc_process.rpc_process_t> child): void! {
    {string:any} command = {}
    command['type'] = 'get_state'
    var response = child.send(command)
    if field_string(response, 'type') != 'response' || field_string(response, 'command') != 'get_state' || !field_bool(response, 'success') {
        throw errorf('get_state handshake failed')
    }
    if !response.contains('data') || !(response['data'] is {string:any}) {
        throw errorf('get_state response missing data')
    }
    var data = response['data'] as {string:any}
    string session_id = field_string(data, 'sessionId')
    if session_id == '' {
        throw errorf('get_state response missing sessionId')
    }
    instance.update_summary(session_id, field_string(data, 'sessionFile'))
}

#local
fn refreshes_session(string command): bool {
    return command == 'new_session' || command == 'switch_session' || command == 'fork' || command == 'clone' || command == 'set_session_name' || command == 'prompt'
}

#local
fn field_string({string:any} object, string key): string {
    if object.contains(key) && object[key] is string {
        return object[key] as string
    }
    return ''
}

#local
fn field_bool({string:any} object, string key): bool {
    if object.contains(key) && object[key] is bool {
        return object[key] as bool
    }
    return false
}
