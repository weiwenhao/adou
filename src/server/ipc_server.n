import co
import fmt
import net.tcp

// Phase 7.1: RPC-over-IPC server transport (upstream packages/server
// ipc/server.ts).  Line-delimited JSON over a localhost TCP socket with the
// upstream encodeMessage framing; the app-level handler owns the whole
// connection, which is what the upstream bidirectional rpc_stream protocol
// needs (rpc_ready then a continuing command/response loop until close).

pub type connection_handler_t = fn(ref<tcp.conn_t> conn): void

pub fn serve(string listen_host, int port, connection_handler_t handler): void! {
    var server = tcp.listen(fmt.sprintf('%s:%d', listen_host, port)) catch error {
        return
    }
    for true {
        var conn = server.accept() catch error {
            break
        }
        go handler(conn)
    }
}

// Line reader tolerant to split reads; returns '' at EOF/empty line.
pub fn read_line(ref<tcp.conn_t> conn): string! {
    [u8] collected = vec<u8>.new(0, 0)
    for true {
        var buffer = vec<u8>.new(0, 256)
        int count = conn.read(buffer) catch error {
            if collected.len() > 0 {
                return collected as string
            }
            throw errorf('ipc read failed')
        }
        if count <= 0 {
            return collected as string
        }
        var chunk = buffer.slice(0, count)
        for byte in chunk {
            if byte == 10 {
                return collected as string
            }
            collected.push(byte)
        }
    }
    return collected as string
}

// Write one framed line; on failure the connection is closed.  Used by the
// connection coroutine itself (never from worker coroutines, which use the
// app-level per-connection sink instead).
pub fn write_line(ref<tcp.conn_t> conn, string line) {
    var bytes = (line + '\n') as [u8]
    conn.write(bytes) catch error {
        conn.close()
        return
    }
}
