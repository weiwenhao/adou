import adou.src.ai.types
import adou.src.json_util
import adou.src.compaction.types as compaction_types
import adou.src.unicode.utf8
import json

pub fn calculate_context_tokens(types.usage_t usage): int {
    if usage.total_tokens != 0 {
        return usage.total_tokens
    }
    return usage.input + usage.output + usage.cache_read + usage.cache_write
}

pub fn estimate_tokens(types.message_t message): int! {
    int chars = 0
    if message is ref<types.user_message_t> user {
        chars = utf8.utf16_length(user.content)
    } else if message is ref<types.assistant_message_t> assistant {
        for block in assistant.content {
            if block is ref<types.text_content_t> text {
                chars += utf8.utf16_length(text.text)
            } else if block is ref<types.thinking_content_t> thinking {
                chars += utf8.utf16_length(thinking.thinking)
            } else if block is ref<types.tool_call_t> call {
                chars += utf8.utf16_length(call.name)
                chars += utf8.utf16_length(json_util.stringify(call.arguments))
            }
        }
    } else if message is ref<types.tool_result_message_t> tool {
        for block in tool.content {
            chars += utf8.utf16_length(block.text)
        }
    } else if message is ref<types.compaction_summary_message_t> summary {
        chars = utf8.utf16_length(summary.summary)
    } else if message is ref<types.branch_summary_message_t> summary {
        chars = utf8.utf16_length(summary.summary)
    } else if message is ref<types.custom_message_t> custom {
        chars = utf8.utf16_length(custom.content)
    } else if message is ref<types.bash_execution_message_t> bash {
        if !bash.exclude_from_context {
            chars = utf8.utf16_length(types.bash_execution_text(bash))
        }
    }
    return (chars + 3) / 4
}

pub fn estimate_context_tokens([types.message_t] messages): compaction_types.context_estimate_t! {
    // Pi's usageAppliesToPrefix check: a newer prefix message (e.g. a
    // compaction summary) invalidates an older assistant's usage for the
    // current prefix.  The timestamp accumulates forward over the messages
    // seen so far, so an assistant's own timestamp never disqualifies it.
    int latest_prefix_timestamp = -1
    int last_usage_index = -1
    types.usage_t last_usage = types.usage_t{}
    for int index = 0; index < messages.len(); index += 1 {
        if messages[index] is ref<types.assistant_message_t> assistant {
            int tokens = calculate_context_tokens(assistant.usage)
            if assistant.stop_reason != types.STOP_ABORTED && assistant.stop_reason != types.STOP_ERROR && tokens > 0 && assistant.timestamp >= latest_prefix_timestamp {
                last_usage_index = index
                last_usage = assistant.usage
            }
        }
        int message_timestamp = message_timestamp_of(messages[index])
        if message_timestamp > latest_prefix_timestamp {
            latest_prefix_timestamp = message_timestamp
        }
    }
    if last_usage_index < 0 {
        int estimated = 0
        for message in messages {
            estimated += estimate_tokens(message)
        }
        return compaction_types.context_estimate_t {tokens: estimated, trailing_tokens: estimated,}
    }
    int usage_tokens = calculate_context_tokens(last_usage)
    int trailing_tokens = 0
    for int index = last_usage_index + 1; index < messages.len(); index += 1 {
        trailing_tokens += estimate_tokens(messages[index])
    }
    return compaction_types.context_estimate_t {tokens: usage_tokens + trailing_tokens, usage_tokens: usage_tokens, trailing_tokens: trailing_tokens, last_usage_index: last_usage_index,}
}

fn message_timestamp_of(types.message_t message): int {
    if message is ref<types.user_message_t> user {
        return user.timestamp
    }
    if message is ref<types.assistant_message_t> assistant {
        return assistant.timestamp
    }
    if message is ref<types.tool_result_message_t> tool_result {
        return tool_result.timestamp
    }
    if message is ref<types.compaction_summary_message_t> summary {
        return summary.timestamp
    }
    if message is ref<types.branch_summary_message_t> branch {
        return branch.timestamp
    }
    if message is ref<types.custom_message_t> custom {
        return custom.timestamp
    }
    if message is ref<types.bash_execution_message_t> bash {
        return bash.timestamp
    }
    return -1
}

pub fn should_compact(int context_tokens, int context_window, compaction_types.settings_t settings): bool {
    if !settings.enabled || context_window <= 0 {
        return false
    }
    return context_tokens > context_window - settings.reserve_tokens
}
