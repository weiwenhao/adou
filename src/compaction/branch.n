import adou.src.ai.abort
import adou.src.ai.event_stream
import adou.src.ai.types as ai_types
import adou.src.agent.session_stream
import adou.src.compaction.compact
import adou.src.compaction.prepare
import adou.src.compaction.serialize
import adou.src.compaction.token_estimate
import adou.src.compaction.types
import adou.src.session.identity
import adou.src.session.message_json
import adou.src.session.types as session_types
import json
import time

const BRANCH_SUMMARY_PREAMBLE = 'The user explored a different conversation branch before returning here.\nSummary of that exploration:\n\n'
const BRANCH_SUMMARY_PROMPT = 'Create a structured summary of this conversation branch for context when returning later.\n\nUse this EXACT format:\n\n## Goal\n[What was the user trying to accomplish in this branch?]\n\n## Constraints & Preferences\n- [Any constraints, preferences, or requirements mentioned]\n- [Or "(none)" if none were mentioned]\n\n## Progress\n### Done\n- [x] [Completed tasks/changes]\n\n### In Progress\n- [ ] [Work that was started but not finished]\n\n### Blocked\n- [Issues preventing progress, if any]\n\n## Key Decisions\n- **[Decision]**: [Brief rationale]\n\n## Next Steps\n1. [What should happen next to continue this work]\n\nKeep each section concise. Preserve exact file paths, function names, and error messages.'

type preparation_t = struct {
    [ai_types.message_t] messages = []
    types.file_ops_t file_ops
    int total_tokens
}

fn prepare_entries([ref<session_types.entry_t>] entries, int token_budget): preparation_t! {
    var result = preparation_t{}
    for entry in entries {
        if entry.kind == session_types.ENTRY_BRANCH_SUMMARY {
            prepare.collect_previous_file_ops(entry, &result.file_ops)
        }
    }
    [ai_types.message_t] reversed = []
    for int index = entries.len() - 1; index >= 0; index -= 1 {
        var possible = entry_messages(entries[index])
        if possible.len() == 0 {
            continue
        }
        var message = possible[0]
        prepare.collect_message_file_ops(message, &result.file_ops)
        int tokens = token_estimate.estimate_tokens(message)
        if token_budget > 0 && result.total_tokens + tokens > token_budget {
            bool important_summary = entries[index].kind == session_types.ENTRY_COMPACTION || entries[index].kind == session_types.ENTRY_BRANCH_SUMMARY
            if important_summary && result.total_tokens < token_budget * 9 / 10 {
                reversed.push(message)
                result.total_tokens += tokens
            }
            break
        }
        reversed.push(message)
        result.total_tokens += tokens
    }
    for int index = reversed.len() - 1; index >= 0; index -= 1 {
        result.messages.push(reversed[index])
    }
    return result
}

fn run([ref<session_types.entry_t>] entries, ref<ai_types.model_t> model, ref<ai_types.stream_options_t> base_options, compact.stream_fn stream_function, ref<abort.abort_t> cancellation, string custom_instructions, string thinking_level, int reserve_tokens): types.summary_result_t! {
    int context_window = model.context_window > 0 ? model.context_window : 128000
    int token_budget = context_window - reserve_tokens
    if token_budget < 0 {token_budget = 0}
    var preparation = prepare_entries(entries, token_budget)
    if preparation.messages.len() == 0 {
        return types.summary_result_t {summary: 'No content to summarize',}
    }
    string instructions = BRANCH_SUMMARY_PROMPT
    if custom_instructions != '' {
        instructions += '\n\nAdditional focus: ' + custom_instructions
    }
    string prompt_text = '<conversation>\n' + serialize.conversation(preparation.messages) + '\n</conversation>\n\n' + instructions
    ai_types.message_t prompt = new ai_types.user_message_t(content = prompt_text, timestamp = time.now().ms_timestamp())
    var context = new ai_types.context_t(system_prompt = serialize.SUMMARIZATION_SYSTEM_PROMPT, messages = [prompt])
    var options = compact.copy_options(base_options)
    options.max_tokens = 2048
    if model.max_tokens > 0 && options.max_tokens > model.max_tokens {options.max_tokens = model.max_tokens}
    options.cache_retention = 'none'
    options.session_id = identity.uuid_v7()
    if model.reasoning && thinking_level != '' && thinking_level != 'off' {
        options.reasoning_effort = thinking_level
        options.thinking_enabled = true
    }
    var response = compact.complete_with_retry(model, context, options, stream_function, cancellation)
    if response.stop_reason == ai_types.STOP_ABORTED {
        throw errorf('Branch summarization aborted')
    }
    if response.stop_reason == ai_types.STOP_ERROR {
        throw errorf('Branch summarization failed: %s', response.error_message == '' ? 'Unknown error' : response.error_message)
    }
    var (read_files, modified_files) = prepare.file_lists(preparation.file_ops)
    string summary = BRANCH_SUMMARY_PREAMBLE + compact.content_text(response)
    summary += compact.format_file_operations(read_files, modified_files)
    return types.summary_result_t {summary: summary == '' ? 'No summary generated' : summary, usage: response.usage, read_files: read_files, modified_files: modified_files,}
}

fn run_with_events([ref<session_types.entry_t>] entries, ref<ai_types.model_t> model, ref<ai_types.stream_options_t> base_options, compact.stream_fn stream_function, ref<abort.abort_t> cancellation, string custom_instructions, string thinking_level, int reserve_tokens, compact.retry_policy_t policy, ref<session_stream.stream_t> output, string reason): types.summary_result_t! {
    int context_window = model.context_window > 0 ? model.context_window : 128000
    int token_budget = context_window - reserve_tokens
    if token_budget < 0 {token_budget = 0}
    var preparation = prepare_entries(entries, token_budget)
    if preparation.messages.len() == 0 {
        return types.summary_result_t {summary: 'No content to summarize',}
    }
    string instructions = BRANCH_SUMMARY_PROMPT
    if custom_instructions != '' {
        instructions += '\n\nAdditional focus: ' + custom_instructions
    }
    string prompt_text = '<conversation>\n' + serialize.conversation(preparation.messages) + '\n</conversation>\n\n' + instructions
    ai_types.message_t prompt = new ai_types.user_message_t(content = prompt_text, timestamp = time.now().ms_timestamp())
    var context = new ai_types.context_t(system_prompt = serialize.SUMMARIZATION_SYSTEM_PROMPT, messages = [prompt])
    var options = compact.copy_options(base_options)
    options.max_tokens = 2048
    if model.max_tokens > 0 && options.max_tokens > model.max_tokens {options.max_tokens = model.max_tokens}
    options.cache_retention = 'none'
    options.session_id = identity.uuid_v7()
    if model.reasoning && thinking_level != '' && thinking_level != 'off' {
        options.reasoning_effort = thinking_level
        options.thinking_enabled = true
    }
    var response = compact.complete_with_events(model, context, options, stream_function, cancellation, policy, output, 'branchSummary', reason)
    if response.stop_reason == ai_types.STOP_ABORTED {
        throw errorf('Branch summarization aborted')
    }
    if response.stop_reason == ai_types.STOP_ERROR {
        throw errorf('Branch summarization failed: %s', response.error_message == '' ? 'Unknown error' : response.error_message)
    }
    var (read_files, modified_files) = prepare.file_lists(preparation.file_ops)
    string summary = BRANCH_SUMMARY_PREAMBLE + compact.content_text(response)
    summary += compact.format_file_operations(read_files, modified_files)
    return types.summary_result_t {summary: summary == '' ? 'No summary generated' : summary, usage: response.usage, read_files: read_files, modified_files: modified_files,}
}

#local
fn entry_messages(ref<session_types.entry_t> entry): [ai_types.message_t]! {
    if entry.kind == session_types.ENTRY_MESSAGE {
        var object = entry.raw.as_object()
        if !object.contains('message') || object['message'].kind != json.VALUE_OBJECT {return []}
        var message = message_json.decode(object['message'])
        if message is ref<ai_types.tool_result_message_t> {return []}
        return [message]
    }
    if entry.kind == session_types.ENTRY_BRANCH_SUMMARY {
        var object = entry.raw.as_object()
        ai_types.message_t message = new ai_types.branch_summary_message_t(summary = object['summary'].as_string(), from_id = object['fromId'].as_string(), timestamp = 0)
        return [message]
    }
    if entry.kind == session_types.ENTRY_COMPACTION {
        var object = entry.raw.as_object()
        int tokens_before = object.contains('tokensBefore') ? object['tokensBefore'].as_number().to_float() as int : 0
        ai_types.message_t message = new ai_types.compaction_summary_message_t(summary = object['summary'].as_string(), tokens_before = tokens_before, timestamp = 0)
        return [message]
    }
    return []
}
