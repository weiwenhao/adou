import adou.src.ai.types as ai_types
import adou.src.json_util
import adou.src.compaction.cut_point
import adou.src.compaction.token_estimate
import adou.src.compaction.types
import adou.src.session.types as session_types
import json

pub fn prepare([ref<session_types.entry_t>] entries, [ai_types.message_t] context_messages, types.settings_t settings): ref<types.preparation_t>?! {
    if entries.len() == 0 || entries[entries.len() - 1].kind == session_types.ENTRY_COMPACTION {
        return null
    }
    int previous_compaction_index = -1
    for int index = entries.len() - 1; index >= 0; index -= 1 {
        if entries[index].kind == session_types.ENTRY_COMPACTION {
            previous_compaction_index = index
            break
        }
    }
    bool has_previous_summary = false
    string previous_summary = ''
    int boundary_start = 0
    if previous_compaction_index >= 0 {
        var previous_object = entries[previous_compaction_index].raw as {string:any}
        if previous_object.contains('summary') && previous_object['summary'] is string && previous_object['summary'] as string != '' {
            has_previous_summary = true
            previous_summary = previous_object['summary'] as string
        }
        string previous_first_kept = ''
        if previous_object.contains('firstKeptEntryId') && previous_object['firstKeptEntryId'] is string {
            previous_first_kept = previous_object['firstKeptEntryId'] as string
        }
        int kept_index = find_entry(entries, previous_first_kept)
        if kept_index >= 0 {
            boundary_start = kept_index
        } else {
            boundary_start = previous_compaction_index + 1
        }
    }
    int boundary_end = entries.len()
    int tokens_before = token_estimate.estimate_context_tokens(context_messages).tokens
    var cut = cut_point.find(entries, boundary_start, boundary_end, settings.keep_recent_tokens)
    if cut.first_kept_entry_index < 0 || cut.first_kept_entry_index >= entries.len() {
        return null
    }
    string first_kept_entry_id = entries[cut.first_kept_entry_index].id
    int history_end = cut.first_kept_entry_index
    if cut.is_split_turn {
        history_end = cut.turn_start_index
    }
    [ai_types.message_t] messages_to_summarize = []
    for int index = boundary_start; index < history_end; index += 1 {
        var messages = cut_point.entry_messages(entries[index])
        if messages.len() > 0 {
            messages_to_summarize.push(messages[0])
        }
    }
    [ai_types.message_t] turn_prefix_messages = []
    if cut.is_split_turn {
        for int index = cut.turn_start_index; index < cut.first_kept_entry_index; index += 1 {
            var messages = cut_point.entry_messages(entries[index])
            if messages.len() > 0 {
                turn_prefix_messages.push(messages[0])
            }
        }
    }
    [ai_types.message_t] retained_tail = []
    for int index = cut.first_kept_entry_index; index < boundary_end; index += 1 {
        var messages = cut_point.entry_messages(entries[index])
        if messages.len() > 0 {
            retained_tail.push(messages[0])
        }
    }
    if messages_to_summarize.len() == 0 && turn_prefix_messages.len() == 0 {
        return null
    }
    types.file_ops_t file_ops = types.file_ops_t{}
    if previous_compaction_index >= 0 {
        collect_previous_file_ops(entries[previous_compaction_index], &file_ops)
    }
    for message in messages_to_summarize {
        collect_message_file_ops(message, &file_ops)
    }
    for message in turn_prefix_messages {
        collect_message_file_ops(message, &file_ops)
    }
    return new types.preparation_t(first_kept_entry_id = first_kept_entry_id, messages_to_summarize = messages_to_summarize, turn_prefix_messages = turn_prefix_messages, retained_tail = retained_tail, is_split_turn = cut.is_split_turn, tokens_before = tokens_before, has_previous_summary = has_previous_summary, previous_summary = previous_summary, file_ops = file_ops, settings = settings)
}

pub fn file_lists(types.file_ops_t operations): ([string], [string]) {
    [string] modified = []
    for file in operations.edited {
        modified = add_unique(modified, file)
    }
    for file in operations.written {
        modified = add_unique(modified, file)
    }
    [string] read_only = []
    for file in operations.read {
        if !contains(modified, file) {
            read_only = add_unique(read_only, file)
        }
    }
    sort_strings(read_only)
    sort_strings(modified)
    return (read_only, modified)
}

pub fn collect_message_file_ops(ai_types.message_t message, ptr<types.file_ops_t> operations): void! {
    if message is ref<ai_types.assistant_message_t> assistant {
        for block in assistant.content {
            if block is ref<ai_types.tool_call_t> call {
                if !json_util.is_obj(call.arguments) {
                    continue
                }
                var arguments = call.arguments as {string:any}
                if !arguments.contains('path') || !(arguments['path'] is string) || arguments['path'] as string == '' {
                    continue
                }
                string file_path = arguments['path'] as string
                if call.name == 'read' {
                    operations.read = add_unique(operations.read, file_path)
                } else if call.name == 'write' {
                    operations.written = add_unique(operations.written, file_path)
                } else if call.name == 'edit' {
                    operations.edited = add_unique(operations.edited, file_path)
                }
            }
        }
    }
}

pub fn collect_previous_file_ops(ref<session_types.entry_t> entry, ptr<types.file_ops_t> operations): void! {
    var object = entry.raw as {string:any}
    if object.contains('fromHook') && object['fromHook'] is bool && object['fromHook'] as bool {
        return
    }
    if !object.contains('details') || !json_util.is_obj(object['details']) {
        return
    }
    var details = object['details'] as {string:any}
    if details.contains('readFiles') && details['readFiles'] is [any] {
        for file in details['readFiles'] as [any] {
            if file is string {
                operations.read = add_unique(operations.read, file as string)
            }
        }
    }
    if details.contains('modifiedFiles') && details['modifiedFiles'] is [any] {
        for file in details['modifiedFiles'] as [any] {
            if file is string {
                operations.edited = add_unique(operations.edited, file as string)
            }
        }
    }
}

fn find_entry([ref<session_types.entry_t>] entries, string id): int {
    for index, entry in entries {
        if entry.id == id {
            return index
        }
    }
    return -1
}

fn add_unique([string] values, string value): [string] {
    if !contains(values, value) {
        values.push(value)
    }
    return values
}

pub fn contains([string] values, string value): bool {
    for candidate in values {
        if candidate == value {
            return true
        }
    }
    return false
}

pub fn sort_strings([string] values) {
    for int end = values.len() - 1; end > 0; end -= 1 {
        for int index = 0; index < end; index += 1 {
            if values[index] > values[index + 1] {
                (values[index], values[index + 1]) = (values[index + 1], values[index])
            }
        }
    }
}
