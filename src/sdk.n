// Nature-native core SDK for embedding Adou's non-extension agent runtime.
// The API deliberately exposes the same session/runner primitives used by
// the CLI and RPC modes, while leaving terminal UI concerns to the caller.
import adou.src.agent.session
import adou.src.agent.session_stream as session_stream
import adou.src.agent.types as agent_types
import adou.src.ai.event_stream as ai_event_stream
import adou.src.config.models as models
import adou.src.config.auth
import adou.src.ai.provider
import adou.src.ai.types as ai_types
import adou.src.compaction.types as compaction_types
import adou.src.session.repository

pub type options_t = struct {
    string cwd = ''
    string session_dir = ''
    bool persisted
    ref<ai_types.model_t> model
    string api_key
    string system_prompt
    bool auto_compaction = true
    int reserve_tokens = 16384
    int keep_recent_tokens = 20000
    agent_types.stream_fn? stream_function = null
    [ref<agent_types.agent_tool_t>] tools = []
}

pub type session_t = struct {
    ref<session.runner_t> runner
    ref<repository.manager_t> repository
}

pub fn create(options_t options): ref<session_t>! {
    if options.cwd == '' {throw errorf('SDK session cwd is required')}
    var repository = options.persisted ? repository.create(options.cwd, options.session_dir) : repository.in_memory(options.cwd)
    ref<ai_types.model_t> model = options.model
    ref<ai_types.stream_options_t> stream_options = new ai_types.stream_options_t(api_key = options.api_key, max_tokens = model.max_tokens)
    var config = new agent_types.config_t(model = model, stream_options = stream_options)
    var context = new agent_types.context_t(system_prompt = options.system_prompt, tools = options.tools)
    var compaction = compaction_types.settings_t {enabled: options.auto_compaction, reserve_tokens: options.reserve_tokens, keep_recent_tokens: options.keep_recent_tokens,}
    agent_types.stream_fn selected_stream = fn(ref<ai_types.model_t> request_model, ref<ai_types.context_t> request_context, ref<ai_types.stream_options_t> request_options): ref<ai_event_stream.assistant_stream_t> {
        return provider.stream(request_model, request_context, request_options)
    }
    if options.stream_function is agent_types.stream_fn custom_stream {selected_stream = custom_stream}
    var runner = session.new(repository, context, config, selected_stream, compaction)
    return new session_t(runner = runner, repository = repository)
}

pub fn session_t.prompt(&self, string text): ref<session_stream.stream_t>! {
    return self.runner.prompt(text)
}

pub fn session_t.prompt_with_images(&self, string text, [ref<ai_types.image_attachment_t>] images): ref<session_stream.stream_t>! {
    return self.runner.prompt_with_images(text, images)
}

pub fn session_t.prompt_rpc(&self, string text): ref<session_stream.stream_t>! {
    return self.runner.prompt_rpc(text)
}

pub fn session_t.messages(&self): [ai_types.message_t] {
    return self.runner.copy_active_messages()
}

pub fn session_t.session_id(&self): string {return self.repository.get_session_id()}
pub fn session_t.session_file(&self): string {return self.repository.get_session_file()}
pub fn session_t.start_new_session(&self): void! {self.runner.start_new_session()}
pub fn session_t.append_message(&self, ai_types.message_t message): void! {
    self.repository.append_message(message) catch error {throw error}
    self.runner.append_active_message(message)
}

// B6: Pi SDK surface completions — model/thinking cycling, explicit level
// set, and a dispose alias that cancels any active stream.
pub fn session_t.set_model(&self, ref<ai_types.model_t> model): void! {
    self.runner.set_model(model)
}

pub fn session_t.cycle_model(&self, bool forward): string {
    // Pi cycleModel over the authenticated model list (no explicit scope in
    // the SDK surface): find the current entry and step forward/backward.
    [ref<ai_types.model_t>] available = []
    for model in models.all() {
        if auth.effective(model.provider) != '' || (model.provider == self.runner.agent_config.model.provider && self.runner.agent_config.stream_options.api_key != '') {
            available.push(model)
        }
    }
    if available.len() == 0 {
        return ''
    }
    int index = -1
    for int cursor = 0; cursor < available.len(); cursor += 1 {
        if available[cursor].id == self.runner.agent_config.model.id && available[cursor].provider == self.runner.agent_config.model.provider {
            index = cursor
            break
        }
    }
    int next = 0
    if forward {
        next = (index + 1) % available.len()
        if index < 0 {next = 0}
    } else {
        next = (index - 1 + available.len()) % available.len()
        if index < 0 {next = available.len() - 1}
    }
    self.runner.set_model(available[next]) catch error {return ''}
    return available[next].provider + '/' + available[next].id
}

pub fn session_t.set_thinking_level(&self, string level): void! {
    self.runner.set_thinking_level(level)
}

pub fn session_t.dispose(&self) {
    // In-memory sessions hold no OS resources; the alias exists so SDK
    // callers can express teardown symmetric with create().
}
