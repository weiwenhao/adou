import adou.src.tools.path_utils
import co.mutex

pub type entry_t = struct {
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    int users
}

pub type registry_t = struct {
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    map<string, ref<entry_t>> entries = {}
}

// Keep the singleton as a GC-visible reference.  Storing it as anyptr lets the
// collector reclaim the registry while a later tool call still uses it.
ref<registry_t>? global_registry = null

pub fn acquire(string file_path): (string, ref<entry_t>)! {
    string resolved = path_utils.clean(file_path)
    string key = path_utils.canonicalize_existing(resolved) catch e {
        resolved
    }
    var registry = get_registry()
    registry.lock.lock()
    ref<entry_t> entry = new entry_t(lock = mutex.mutex_t.new())
    if registry.entries.contains(key) {
        entry = registry.entries[key]
    } else {
        registry.entries[key] = entry
    }
    entry.users += 1
    registry.lock.unlock()
    entry.lock.lock()
    return (key, entry)
}

pub fn release(string key, ref<entry_t> entry) {
    entry.lock.unlock()
    var registry = get_registry()
    registry.lock.lock()
    entry.users -= 1
    if entry.users == 0 && registry.entries.contains(key) && registry.entries[key] == entry {
        registry.entries.del(key)
    }
    registry.lock.unlock()
}

#local
fn get_registry(): ref<registry_t> {
    ref<registry_t>? current = global_registry
    if current is ref<registry_t> value {
        return value
    }
    var registry = new registry_t(lock = mutex.mutex_t.new(), entries = {})
    global_registry = registry
    return registry
}
