import adou.src.ai.types
import json

type tool_result_t = struct {
    [ref<types.text_content_t>] content = []
    json.value_t details
    types.usage_t usage
    bool terminate
}

fn text_result(string text): tool_result_t {
    return tool_result_t {content: [new types.text_content_t(text = text)],}
}
