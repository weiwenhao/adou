import adou.src.ai.types
import json

pub type tool_result_t = struct {
    [ref<types.text_content_t>] content = []
    [ref<types.image_attachment_t>] images = []
    any details
    types.usage_t usage
    [string] added_tool_names = []
    bool terminate
}

pub fn text_result(string text): tool_result_t {
    return tool_result_t {content: [new types.text_content_t(text = text)],}
}
