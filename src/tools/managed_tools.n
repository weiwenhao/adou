import adou.src.config.paths
import adou.src.json_util
import adou.src.tools.command
import adou.src.tools.path_utils
import co.mutex
import os
import path
import syscall

pub type tool_result_t = struct {
    string name
    string path
    bool downloaded
}

ref<mutex.mutex_t>? tool_lock = null

pub fn directory(): string {
    string configured = syscall.get_env('ADOU_MANAGED_TOOLS_DIR')
    if configured != '' {return path_utils.expand_path(configured)}
    return path.join(paths.agent_dir(), 'bin')
}

pub fn find(string name): string {
    string local = path.join(directory(), name)
    if path_utils.exists(local) {return local}
    var probe = command.shell('', 'command -v ' + command.quote(name)) catch error {return ''}
    if probe.exit_code == 0 {return probe.stdout.trim([' ', '\t', '\n', '\r'])}
    if name == 'rg' {
        var alternate = command.shell('', 'command -v rg') catch error {return ''}
        if alternate.exit_code == 0 {return alternate.stdout.trim([' ', '\t', '\n', '\r'])}
    }
    if name == 'fd' {
        var alternate = command.shell('', 'command -v fdfind') catch error {return ''}
        if alternate.exit_code == 0 {return alternate.stdout.trim([' ', '\t', '\n', '\r'])}
    }
    return ''
}

pub fn ensure(string name): string! {
    string existing = find(name)
    if existing != '' {return existing}
    if syscall.get_env('ADOU_OFFLINE') == '1' {return ''}
    if tool_lock is null {
        tool_lock = mutex.mutex_t.new()
    }
    var lock = tool_lock as ref<mutex.mutex_t>
    lock.lock()
    existing = find(name)
    if existing != '' {
        lock.unlock()
        return existing
    }
    string result = download(name) catch error {
        lock.unlock()
        return ''
    }
    lock.unlock()
    return result
}

pub fn ensure_all(): [tool_result_t] {
    [tool_result_t] result = []
    for name in ['rg', 'fd'] {
        string resolved = ensure(name) catch error {''}
        result.push(tool_result_t {name: name, path: resolved, downloaded: false,})
    }
    return result
}

fn download(string name): string! {
    string repo = name == 'rg' ? 'BurntSushi/ripgrep' : 'sharkdp/fd'
    string tag_prefix = name == 'fd' ? 'v' : ''
    var latest = command.shell_timeout('', 'curl -fsSL --connect-timeout 10 --max-time 10 ' + command.quote('https://api.github.com/repos/' + repo + '/releases/latest'), 15000)
    if latest.exit_code != 0 {throw errorf('Could not query %s release: %s', name, latest.stderr)}
    var parsed = json_util.parse(latest.stdout) catch error {throw errorf('Invalid %s release response', name)}
    if !json_util.is_obj(parsed) {throw errorf('Invalid %s release response', name)}
    string tag = json_util.opt_string(parsed as {string:any}, 'tag_name')
    if tag == '' {throw errorf('Missing %s release tag', name)}
    string version = tag.starts_with(tag_prefix) ? tag.slice(tag_prefix.len(), tag.len()) : tag
    string platform = syscall.get_env('ADOU_TOOL_PLATFORM')
    if platform == '' {platform = 'darwin'}
    string arch = syscall.get_env('ADOU_TOOL_ARCH')
    if arch == '' {arch = 'arm64'}
    string asset = asset_name(name, version, platform, arch)
    if asset == '' {throw errorf('Unsupported platform for %s', name)}
    string root = directory()
    os.mkdirs(root, 0o700)
    string archive = path.join(root, '.' + name + '.download')
    string extract = path.join(root, '.' + name + '.extract')
    var fetched = command.shell_timeout('', 'curl -fsSL --connect-timeout 10 --max-time 120 -o ' + command.quote(archive) + ' ' + command.quote('https://github.com/' + repo + '/releases/download/' + tag + '/' + asset), 130000)
    if fetched.exit_code != 0 {os.remove(archive) catch cleanup {}; throw errorf('Could not download %s: %s', name, fetched.stderr)}
    os.rmdir(extract, true) catch cleanup {}
    os.mkdirs(extract, 0o700)
    string unpack = asset.ends_with('.zip') ? 'unzip -q ' + command.quote(archive) + ' -d ' + command.quote(extract) : 'tar -xzf ' + command.quote(archive) + ' -C ' + command.quote(extract)
    var extracted = command.shell_timeout('', unpack, 30000)
    if extracted.exit_code != 0 {os.remove(archive) catch cleanup {}; os.rmdir(extract, true) catch cleanup {}; throw errorf('Could not extract %s: %s', name, extracted.stderr)}
    var located = command.shell('', 'find ' + command.quote(extract) + ' -type f -name ' + command.quote(name) + ' -print -quit')
    string binary = located.stdout.trim([' ', '\t', '\n', '\r'])
    if binary == '' {os.remove(archive) catch cleanup {}; os.rmdir(extract, true) catch cleanup {}; throw errorf('Downloaded %s archive did not contain its binary', name)}
    string target = path.join(root, name)
    var installed = command.shell_timeout('', 'cp ' + command.quote(binary) + ' ' + command.quote(target) + ' && chmod 755 ' + command.quote(target), 10000)
    os.remove(archive) catch cleanup {}
    os.rmdir(extract, true) catch cleanup {}
    if installed.exit_code != 0 {throw errorf('Could not install %s: %s', name, installed.stderr)}
    return target
}

fn asset_name(string name, string version, string platform, string arch): string {
    string machine = arch == 'arm64' ? 'aarch64' : 'x86_64'
    if name == 'fd' {
        if platform == 'darwin' {return 'fd-v' + version + '-' + machine + '-apple-darwin.tar.gz'}
        if platform == 'linux' {return 'fd-v' + version + '-' + machine + '-unknown-linux-gnu.tar.gz'}
        if platform == 'win32' {return 'fd-v' + version + '-' + machine + '-pc-windows-msvc.zip'}
    }
    if platform == 'darwin' {return 'ripgrep-' + version + '-' + machine + '-apple-darwin.tar.gz'}
    if platform == 'linux' {return arch == 'arm64' ? 'ripgrep-' + version + '-aarch64-unknown-linux-gnu.tar.gz' : 'ripgrep-' + version + '-x86_64-unknown-linux-musl.tar.gz'}
    if platform == 'win32' {return 'ripgrep-' + version + '-' + machine + '-pc-windows-msvc.zip'}
    return ''
}
