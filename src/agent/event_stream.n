import adou.src.agent.types
import adou.src.ai.abort
import adou.src.ai.types as ai_types
import co.mutex

const DEFAULT_CAPACITY = 64

type stream_t = struct {
    chan<types.agent_event_t> events
    chan<u8> done
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    ref<abort.abort_t> cancellation = abort.new()
    [ai_types.message_t] final_messages = []
    bool terminal
    bool ended
    string failure
}

fn new(): ref<stream_t> {
    return new stream_t(events = chan<types.agent_event_t>.new(DEFAULT_CAPACITY), done = chan<u8>.new())
}

fn stream_t.push(&self, types.agent_event_t event): void! {
    self.lock.lock()
    if self.terminal || self.ended {
        self.lock.unlock()
        return
    }
    bool terminal = event.kind == types.EVENT_AGENT_END
    if terminal {
        self.terminal = true
        self.final_messages = event.messages
    }
    self.lock.unlock()
    self.events.send(event)
    if terminal {
        self.done.close()
    }
}

fn stream_t.recv(&self): types.agent_event_t! {
    return self.events.recv()
}

fn stream_t.result(&self): [ai_types.message_t]! {
    self.lock.lock()
    bool ready = self.terminal
    self.lock.unlock()
    if !ready {
        self.done.recv() catch e {0}
    }
    self.lock.lock()
    var result = self.final_messages
    ready = self.terminal
    self.lock.unlock()
    if !ready {
        if self.failure != '' {
            throw errorf('%s', self.failure)
        }
        throw errorf('agent stream ended without agent_end')
    }
    return result
}

fn stream_t.fail(&self, string message): void! {
    self.lock.lock()
    self.failure = message
    self.lock.unlock()
    self.end()
}

fn stream_t.abort(&self) {
    self.cancellation.abort()
}

fn stream_t.end(&self): void! {
    self.lock.lock()
    if self.ended {
        self.lock.unlock()
        return
    }
    self.ended = true
    bool terminal = self.terminal
    self.lock.unlock()
    self.events.close()
    if !terminal {
        self.done.close()
    }
}
