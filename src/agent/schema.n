import adou.src.json_util
import fmt
import strings

pub fn validate_and_coerce(string tool_name, any schema, any arguments): any! {
    var cloned = json_util.clone(arguments)
    cloned = coerce(schema, cloned)
    string problem = validate(schema, cloned, 'root')
    if problem != '' {
        throw errorf('Validation failed for tool "%s":\n  - %s\n\nReceived arguments:\n%s', tool_name, problem, json_util.stringify(arguments))
    }
    return cloned
}

fn coerce(any schema, any value): any! {
    if !json_util.is_obj(schema) {
        return value
    }
    var schema_object = schema as {string:any}
    if schema_object.contains('allOf') {
        var all_of = schema_object['allOf']
        if all_of is [any] {
            for item in all_of as [any] {
                value = coerce(item, value)
            }
        }
    }
    if schema_object.contains('anyOf') {
        var any_of = schema_object['anyOf']
        if any_of is [any] {
            value = coerce_union(any_of as [any], value)
        }
    }
    if schema_object.contains('oneOf') {
        var one_of = schema_object['oneOf']
        if one_of is [any] {
            value = coerce_union(one_of as [any], value)
        }
    }
    [string] types = schema_types(schema)
    bool matched_union = types.len() > 1 && matches_any_type(value, types)
    if types.len() > 0 && !matched_union {
        for expected in types {
            var converted = coerce_primitive(value, expected)
            if json_util.stringify(converted) != json_util.stringify(value) {
                value = converted
                break
            }
        }
    }
    if includes(types, 'object') && json_util.is_obj(value) && schema_object.contains('properties') {
        var value_object = value as {string:any}
        var properties_value = schema_object['properties']
        if properties_value is {string:any} {
            var properties = properties_value as {string:any}
            var output = value_object
            if schema_object.contains('additionalProperties') {
                var additional = schema_object['additionalProperties']
                for key, property_value in value_object {
                    if properties.contains(key) {
                        output[key] = coerce(properties[key], property_value)
                    } else if json_util.is_obj(additional) {
                        output[key] = coerce(additional, property_value)
                    } else {
                        output[key] = property_value
                    }
                }
            } else {
                for key, property_schema in properties {
                    if value_object.contains(key) {
                        var converted = coerce(property_schema, value_object[key])
                        output[key] = converted
                    }
                }
            }
            value = output
        }
    }
    if includes(types, 'array') && value is [any] && schema_object.contains('items') {
        var items = schema_object['items']
        var value_array = value as [any]
        [any] output = []
        if items is [any] {
            var item_schemas = items as [any]
            for int i = 0; i < value_array.len(); i += 1 {
                if i < item_schemas.len() {
                    output.push(coerce(item_schemas[i], value_array[i]))
                } else {
                    output.push(value_array[i])
                }
            }
        } else if json_util.is_obj(items) {
            for element in value_array {
                output.push(coerce(items, element))
            }
        }
        value = output
    }
    return value
}

fn coerce_union([any] schemas, any value): any! {
    for schema in schemas {
        var candidate = json_util.clone(value)
        candidate = coerce(schema, candidate)
        if validate(schema, candidate, 'root') == '' {
            return candidate
        }
    }
    return value
}

fn coerce_primitive(any value, string expected): any! {
    if expected == 'number' {
        if json_util.is_null(value) {
            return 0
        }
        if value is string && (value as string).trim([' ', '\t', '\n', '\r']) != '' {
            string token = normalized_number(value as string)
            if token != '' {
                return token.to_float() catch e {
                    return value
                }
            }
        }
        if value is bool {
            return value as bool ? 1 : 0
        }
    } else if expected == 'integer' {
        if json_util.is_null(value) {
            return 0
        }
        if value is string && (value as string).trim([' ', '\t', '\n', '\r']) != '' {
            string token = normalized_number(value as string)
            if token != '' && number_is_integer(token) {
                return token.to_float() catch e {
                    return value
                }
            }
        }
        if value is bool {
            return value as bool ? 1 : 0
        }
    } else if expected == 'boolean' {
        if json_util.is_null(value) {
            return false
        }
        if value is string && value as string == 'true' {
            return true
        }
        if value is string && value as string == 'false' {
            return false
        }
        if json_util.is_num(value) && json_util.num_token(value) == '1' {
            return true
        }
        if json_util.is_num(value) && json_util.num_token(value) == '0' {
            return false
        }
    } else if expected == 'string' {
        if json_util.is_null(value) {
            return ''
        }
        if json_util.is_num(value) {
            return json_util.num_token(value)
        }
        if value is bool {
            return value as bool ? 'true' : 'false'
        }
    } else if expected == 'null' {
        if value is string && value as string == '' {
            return null
        }
        if json_util.is_num(value) && json_util.num_token(value) == '0' {
            return null
        }
        if value is bool && !(value as bool) {
            return null
        }
    }
    return value
}

fn validate(any schema, any value, string current_path): string! {
    if !json_util.is_obj(schema) {
        return ''
    }
    var schema_object = schema as {string:any}
    [string] types = schema_types(schema)
    if types.len() > 0 && !matches_any_type(value, types) {
        return current_path + ': Expected ' + strings.join(types, ' or ')
    }
    if schema_object.contains('allOf') {
        var all_of = schema_object['allOf']
        if all_of is [any] {
            for nested in all_of as [any] {
                string problem = validate(nested, value, current_path)
                if problem != '' {
                    return problem
                }
            }
        }
    }
    if schema_object.contains('anyOf') {
        var any_of = schema_object['anyOf']
        if any_of is [any] {
            bool matched = false
            for nested in any_of as [any] {
                if validate(nested, value, current_path) == '' {
                    matched = true
                    break
                }
            }
            if !matched {
                return current_path + ': Expected a value matching anyOf'
            }
        }
    }
    if schema_object.contains('oneOf') {
        var one_of = schema_object['oneOf']
        if one_of is [any] {
            int matches = 0
            for nested in one_of as [any] {
                if validate(nested, value, current_path) == '' {
                    matches += 1
                }
            }
            if matches != 1 {
                return current_path + ': Expected a value matching exactly one oneOf schema'
            }
        }
    }
    if json_util.is_obj(value) {
        var value_object = value as {string:any}
        if schema_object.contains('required') {
            var required_value = schema_object['required']
            if required_value is [any] {
                for required_ref in required_value as [any] {
                    if required_ref is string && !value_object.contains(required_ref as string) {
                        return child_path(current_path, required_ref as string) + ': Expected required property'
                    }
                }
            }
        }
        any properties_value = null
        if schema_object.contains('properties') {
            properties_value = schema_object['properties']
            if properties_value is {string:any} {
                for key, property_schema in properties_value as {string:any} {
                    if value_object.contains(key) {
                        string problem = validate(property_schema, value_object[key], child_path(current_path, key))
                        if problem != '' {
                            return problem
                        }
                    }
                }
            }
        }
        if schema_object.contains('additionalProperties') {
            var additional = schema_object['additionalProperties']
            if additional is bool && !(additional as bool) {
                for key, property_value in value_object {
                    if !(properties_value is {string:any}) || !(properties_value as {string:any}).contains(key) {
                        return child_path(current_path, key) + ': Unexpected property'
                    }
                }
            }
        }
    }
    if value is [any] && schema_object.contains('items') {
        var items = schema_object['items']
        if json_util.is_obj(items) {
            var value_array = value as [any]
            for int i = 0; i < value_array.len(); i += 1 {
                string problem = validate(items, value_array[i], child_path(current_path, fmt.sprintf('%d', i)))
                if problem != '' {
                    return problem
                }
            }
        }
    }
    return ''
}

fn schema_types(any schema): [string] {
    [string] result = []
    if !json_util.is_obj(schema) {
        return result
    }
    var schema_object = schema as {string:any}
    if !schema_object.contains('type') {
        return result
    }
    var value = schema_object['type']
    if value is string {
        result.push(value as string)
    } else if value is [any] {
        for item in value as [any] {
            if item is string {
                result.push(item as string)
            }
        }
    }
    return result
}

fn matches_any_type(any value, [string] types): bool {
    for expected in types {
        if matches_type(value, expected) {
            return true
        }
    }
    return false
}

fn matches_type(any value, string expected): bool {
    if expected == 'number' {
        return json_util.is_num(value)
    }
    if expected == 'integer' {
        return json_util.is_num(value) && number_is_integer(json_util.num_token(value))
    }
    if expected == 'boolean' {
        return value is bool
    }
    if expected == 'string' {
        return value is string
    }
    if expected == 'null' {
        return json_util.is_null(value)
    }
    if expected == 'array' {
        return value is [any]
    }
    if expected == 'object' {
        return json_util.is_obj(value)
    }
    return false
}

fn number_is_integer(string token): bool {
    float value = token.to_float() catch e {return false}
    int integer = value as int
    return integer as float == value
}

fn normalized_number(string value): string {
    string token = value.trim([' ', '\t', '\n', '\r'])
    float parsed = token.to_float() catch e {
        return ''
    }
    return token
}

pub fn includes([string] values, string expected): bool {
    for value in values {
        if value == expected {
            return true
        }
    }
    return false
}

fn child_path(string parent, string child): string {
    if parent == 'root' {
        return child
    }
    return parent + '.' + child
}
