import adou.src.ai.abort
import adou.src.ai.event_stream
import adou.src.ai.types
import adou.src.json_util
import adou.src.tools.types as tool_types
import co.mutex
import json

pub const EVENT_AGENT_START = 'agent_start'
pub const EVENT_AGENT_END = 'agent_end'
pub const EVENT_TURN_START = 'turn_start'
pub const EVENT_TURN_END = 'turn_end'
pub const EVENT_MESSAGE_START = 'message_start'
pub const EVENT_MESSAGE_UPDATE = 'message_update'
pub const EVENT_MESSAGE_END = 'message_end'
pub const EVENT_TOOL_START = 'tool_execution_start'
pub const EVENT_TOOL_UPDATE = 'tool_execution_update'
pub const EVENT_TOOL_END = 'tool_execution_end'
pub const EXECUTION_PARALLEL = 'parallel'
pub const EXECUTION_SEQUENTIAL = 'sequential'
pub const QUEUE_ALL = 'all'
pub const QUEUE_ONE = 'one-at-a-time'

pub type tool_update_fn = fn(tool_types.tool_result_t)
pub type stream_fn = fn(ref<types.model_t>, ref<types.context_t>, ref<types.stream_options_t>): ref<event_stream.assistant_stream_t>
// Compatibility hook for tool calls persisted with an older argument shape.
// It runs before schema validation and may return a replacement JSON value.
pub type prepare_arguments_fn = fn(any): any!
pub type optional_prepare_arguments_fn = prepare_arguments_fn|null

pub type tool_executor_t = interface {
    fn execute(string, any, ref<abort.abort_t>, tool_update_fn): tool_types.tool_result_t!
}

pub type agent_tool_t = struct {
    string name
    string label
    string description
    any parameters
    // Stable ownership for a schema that otherwise lives in an indirect
    // `any` container. Provider turns and validation parse fresh maps from
    // this snapshot instead of retaining a GC-sensitive alias.
    string parameters_json
    optional_prepare_arguments_fn prepare_arguments = null
    string execution_mode = EXECUTION_PARALLEL
    tool_executor_t executor
    // Extension ToolDefinition surface: prompt hints and rendering metadata
    // are carried but only consumed by future extension tool renderers.
    string prompt_snippet
    [string] prompt_guidelines = []
    any constrained_sampling = false
    string render_shell = 'default'
    bool has_render_call
    bool has_render_result
}

// Nature stores JSON containers inside `any`.  Keep one serialized snapshot
// on every tool definition so provider turns never clone a schema graph that
// may have been traversed or collected by an earlier coroutine.
pub fn agent_tool_t.snapshot_schema(&self): void! {
    if self.parameters_json == '' {
        self.parameters_json = json_util.stringify(self.parameters)
    }
}

pub fn snapshot_tool_schemas([ref<agent_tool_t>] tools): void! {
    for tool in tools {
        tool.snapshot_schema()
    }
}

pub type context_t = struct {
    string system_prompt
    [types.message_t] messages = []
    [ref<agent_tool_t>] tools = []
}

pub type before_result_t = struct {
    bool block
    string reason
}

pub type after_result_t = struct {
    bool has_content
    [ref<types.text_content_t>] content = []
    bool has_details
    any details
    bool has_usage
    types.usage_t usage
    bool has_is_error
    bool is_error
    bool has_terminate
    bool terminate
}

pub type turn_update_t = struct {
    bool has_context
    ref<context_t>? context = null
    bool has_model
    ref<types.model_t>? model = null
    bool has_thinking_level
    string thinking_level
}

pub type before_tool_call_fn = fn(ref<types.assistant_message_t>, ref<types.tool_call_t>, any, ref<context_t>, ref<abort.abort_t>): before_result_t!
pub type after_tool_call_fn = fn(ref<types.assistant_message_t>, ref<types.tool_call_t>, any, tool_types.tool_result_t, bool, ref<context_t>, ref<abort.abort_t>): after_result_t!
pub type prepare_next_turn_fn = fn(ref<types.assistant_message_t>, [ref<types.tool_result_message_t>], ref<context_t>, [types.message_t]): turn_update_t!
pub type should_stop_after_turn_fn = fn(ref<types.assistant_message_t>, [ref<types.tool_result_message_t>], ref<context_t>, [types.message_t]): bool!
pub type optional_before_tool_call_fn = before_tool_call_fn|null
pub type optional_after_tool_call_fn = after_tool_call_fn|null
pub type optional_prepare_next_turn_fn = prepare_next_turn_fn|null
pub type optional_should_stop_after_turn_fn = should_stop_after_turn_fn|null

// Extension-facing provider hooks (Pi before_provider_request /
// after_provider_response).  The request hook may return modified stream
// options before the provider call; the response hook observes the finished
// assistant message.
pub type before_provider_request_fn = fn(ref<types.stream_options_t>, ref<types.context_t>): ref<types.stream_options_t>!
pub type after_provider_response_fn = fn(ref<types.assistant_message_t>)
pub type message_end_listener_fn = fn(types.message_t): void!
pub type optional_before_provider_request_fn = before_provider_request_fn|null
pub type optional_after_provider_response_fn = after_provider_response_fn|null
pub type optional_message_end_listener_fn = message_end_listener_fn|null

pub type queue_snapshot_t = struct {
    [string] steering = []
    [string] follow_up = []
}

pub type queue_t = struct {
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    [types.message_t] steering = []
    [types.message_t] follow_up = []
    // The agent loop drains message objects before it emits message_start.
    // Keep a separate text mirror so the session event can expose Pi's
    // visible pending queues until the corresponding user message starts.
    [string] visible_steering = []
    [string] visible_follow_up = []
    string steering_mode = QUEUE_ONE
    string follow_up_mode = QUEUE_ONE
}

pub fn queue_t.enqueue_steering(&self, types.message_t message) {
    self.lock.lock()
    self.steering.push(message)
    self.visible_steering.push(queue_text(message))
    self.lock.unlock()
}

pub fn queue_t.enqueue_follow_up(&self, types.message_t message) {
    self.lock.lock()
    self.follow_up.push(message)
    self.visible_follow_up.push(queue_text(message))
    self.lock.unlock()
}

pub fn queue_t.drain_steering(&self): [types.message_t] {
    self.lock.lock()
    var result = drain(&self.steering, self.steering_mode)
    self.lock.unlock()
    return result
}

pub fn queue_t.drain_follow_up(&self): [types.message_t] {
    self.lock.lock()
    var result = drain(&self.follow_up, self.follow_up_mode)
    self.lock.unlock()
    return result
}

pub fn queue_t.restore_all(&self): [types.message_t] {
    self.lock.lock()
    [types.message_t] result = self.steering.slice(0, self.steering.len())
    result.append(self.follow_up)
    self.steering = []
    self.follow_up = []
    self.visible_steering = []
    self.visible_follow_up = []
    self.lock.unlock()
    return result
}

pub fn queue_t.visible_snapshot(&self): queue_snapshot_t {
    self.lock.lock()
    var result = queue_snapshot_t {steering: self.visible_steering.slice(0, self.visible_steering.len()), follow_up: self.visible_follow_up.slice(0, self.visible_follow_up.len()),}
    self.lock.unlock()
    return result
}

// Remove the first visible queue entry matching a user message immediately
// before its message_start event is forwarded.  Pi uses first-match removal
// so duplicate queued text remains represented correctly.
pub fn queue_t.mark_delivered(&self, string text): bool {
    self.lock.lock()
    bool removed = remove_visible(&self.visible_steering, text)
    if !removed {
        removed = remove_visible(&self.visible_follow_up, text)
    }
    self.lock.unlock()
    return removed
}

pub fn queue_t.pending_count(&self): int {
    self.lock.lock()
    int count = self.steering.len() + self.follow_up.len()
    self.lock.unlock()
    return count
}

fn queue_text(types.message_t message): string {
    if message is ref<types.user_message_t> user {
        return user.content
    }
    if message is ref<types.custom_message_t> custom {
        return custom.content
    }
    return ''
}

fn remove_visible(ptr<[string]> messages, string text): bool {
    for index, pending in *messages {
        if pending == text {
            var remaining = (*messages).slice(0, index)
            remaining.append((*messages).slice(index + 1, (*messages).len()))
            *messages = remaining
            return true
        }
    }
    return false
}

fn drain(ptr<[types.message_t]> messages, string mode): [types.message_t] {
    var current = *messages
    if current.len() == 0 {
        return []
    }
    if mode == QUEUE_ONE {
        types.message_t first = current[0]
        *messages = current.slice(1, current.len())
        return [first]
    }
    var result = current
    *messages = []
    return result
}

pub type config_t = struct {
    ref<types.model_t> model
    ref<types.stream_options_t> stream_options
    string tool_execution = EXECUTION_PARALLEL
    ref<queue_t> queues = new queue_t()
    optional_before_tool_call_fn before_tool_call = null
    optional_after_tool_call_fn after_tool_call = null
    optional_prepare_next_turn_fn prepare_next_turn = null
    optional_should_stop_after_turn_fn should_stop_after_turn = null
    optional_before_provider_request_fn before_provider_request = null
    optional_after_provider_response_fn after_provider_response = null
    // Pi awaits its AgentSession event listener before the agent loop enters
    // tool execution or the next provider turn. Nature sessions use this
    // synchronous listener to preserve the same message_end boundary.
    optional_message_end_listener_fn message_end_listener = null
}

pub type agent_event_t = struct {
    string kind
    ref<types.user_message_t>? user_message = null
    ref<types.assistant_message_t>? assistant_message = null
    ref<types.tool_result_message_t>? tool_message = null
    types.assistant_event_t assistant_event
    [types.message_t] messages = []
    [ref<types.tool_result_message_t>] tool_results = []
    string tool_call_id
    string tool_name
    any args
    tool_types.tool_result_t tool_result
    bool is_error
}

pub fn agent_event_t.message(self): types.message_t! {
    if self.user_message is ref<types.user_message_t> user {
        types.message_t result = user
        return result
    }
    if self.assistant_message is ref<types.assistant_message_t> assistant_message {
        types.message_t result = assistant_message
        return result
    }
    if self.tool_message is ref<types.tool_result_message_t> tool {
        types.message_t result = tool
        return result
    }
    throw errorf('agent event %s has no message', self.kind)
}
