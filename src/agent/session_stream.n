import adou.src.agent.types as agent_types
import adou.src.ai.abort
import adou.src.ai.types as ai_types
import co
import co.mutex
import json

const EVENT_COMPACTION_START = 'compaction_start'
const EVENT_COMPACTION_END = 'compaction_end'
const EVENT_BRANCH_SUMMARY_START = 'branch_summary_start'
const EVENT_BRANCH_SUMMARY_END = 'branch_summary_end'
const EVENT_SESSION_END = 'session_end'
const EVENT_BASH_START = 'bash_start'
const EVENT_BASH_UPDATE = 'bash_update'
const EVENT_BASH_END = 'bash_end'
// Pi exposes streamed RPC/AgentSession bash output under this public event
// name.  The start/update/end events above remain internal to the interactive
// TUI, while this event carries one sanitized output delta at a time.
const EVENT_BASH_EXECUTION_UPDATE = 'bash_execution_update'
const EVENT_SESSION_INFO_CHANGED = 'session_info_changed'
const EVENT_THINKING_LEVEL_CHANGED = 'thinking_level_changed'
const EVENT_RETRY_START = 'auto_retry_start'
const EVENT_RETRY_END = 'auto_retry_end'
const EVENT_AGENT_SETTLED = 'agent_settled'
const EVENT_QUEUE_UPDATE = 'queue_update'
const EVENT_SUMMARIZATION_RETRY_SCHEDULED = 'summarization_retry_scheduled'
const EVENT_SUMMARIZATION_RETRY_ATTEMPT_START = 'summarization_retry_attempt_start'
const EVENT_SUMMARIZATION_RETRY_FINISHED = 'summarization_retry_finished'

type event_t = struct {
    string kind
    bool has_agent_event
    agent_types.agent_event_t agent_event
    string reason
    bool aborted
    bool will_retry
    string error_message
    string summary
    int tokens_before
    int estimated_tokens_after
    string bash_command
    string bash_output
    string bash_id
    string bash_delta
    string session_name
    string thinking_level
    int bash_exit_code = -1
    bool bash_cancelled
    bool bash_timed_out
    bool bash_truncated
    string bash_full_output_path
    bool bash_exclude_from_context
    bool compaction_has_result
    string compaction_first_kept_entry_id
    ai_types.usage_t compaction_usage
    json.value_t compaction_details
    int retry_attempt
    int retry_max_attempts
    int retry_delay_ms
    string retry_error_message
    bool retry_success
    string retry_final_error
    string retry_source
    string retry_reason
    [string] queue_steering = []
    [string] queue_follow_up = []
}

// Settings and session metadata can change while no operation stream exists.
// RPC installs this sink so those Pi AgentSession events remain observable in
// the same JSONL channel as prompt events.
type event_sink_fn = fn(event_t)
type optional_event_sink_fn = event_sink_fn|null

type stream_t = struct {
    chan<event_t> events
    chan<u8> done
    chan<u8> delivery_done
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    ref<abort.abort_t> cancellation = abort.new()
    [ai_types.message_t] final_context = []
    bool terminal
    bool ended
    string failure
    bool delivery_required
    bool delivery_marked
}

fn new(): ref<stream_t> {
    return new stream_t(events = chan<event_t>.new(128), done = chan<u8>.new(), delivery_done = chan<u8>.new())
}

fn stream_t.push(&self, event_t event): void! {
    self.lock.lock()
    if self.terminal || self.ended {
        self.lock.unlock()
        return
    }
    self.lock.unlock()
    // Nature's blocking channel send can remain parked when a receiver is
    // being rescheduled at the same time as a buffered stream transition.
    // Retry the non-blocking operation instead so lifecycle events cannot
    // strand the session coroutine between auto_retry_end and agent_settled.
    for true {
        bool delivered = self.events.try_send(event) catch error {return}
        if delivered {break}
        co.sleep(1)
    }
}

fn stream_t.finish(&self, [ai_types.message_t] context): void! {
    self.lock.lock()
    if self.terminal || self.ended {
        self.lock.unlock()
        return
    }
    self.final_context = context
    self.terminal = true
    bool wait_for_delivery = self.delivery_required
    self.lock.unlock()
    // RPC workers must serialize the terminal event before the channel is
    // closed.  Nature's blocking channel send can remain parked at a
    // coroutine handoff boundary even when the buffered channel has room;
    // retry the non-blocking operation just like push() so RPC clients never
    // stop at agent_settled without the required session_end.
    for true {
        bool delivered = self.events.try_send(event_t {kind: EVENT_SESSION_END,}) catch error {break}
        if delivered {break}
        co.sleep(1)
    }
    if wait_for_delivery {
        return
    }
    self.done.close()
    self.end()
}

fn stream_t.recv(&self): event_t! {
    return self.events.recv()
}

fn stream_t.result(&self): [ai_types.message_t]! {
    self.lock.lock()
    bool ready = self.terminal
    self.lock.unlock()
    if !ready {
        self.done.recv() catch error {0}
    }
    self.lock.lock()
    var result = self.final_context
    ready = self.terminal
    string failure = self.failure
    self.lock.unlock()
    if !ready {
        if failure != '' {
            throw errorf('%s', failure)
        }
        throw errorf('session stream ended without session_end')
    }
    return result
}

fn stream_t.abort(&self) {
    self.cancellation.abort()
}

// RPC prompt workers consume a session stream on a separate coroutine.  The
// runner may become idle just before that worker serializes the terminal event;
// this small acknowledgement lets RPC `abort` wait for the public event line,
// not merely the internal operation flag.
fn stream_t.require_delivery(&self) {
    self.lock.lock()
    self.delivery_required = true
    self.delivery_marked = false
    self.lock.unlock()
}

fn stream_t.mark_delivery_done(&self) {
    self.lock.lock()
    if self.delivery_marked {
        self.lock.unlock()
        return
    }
    self.delivery_marked = true
    bool required = self.delivery_required
    self.lock.unlock()
    if required {
        self.delivery_done.close() catch error {}
        self.end() catch error {}
    }
}

fn stream_t.wait_delivery(&self) {
    self.lock.lock()
    bool required = self.delivery_required
    bool marked = self.delivery_marked
    self.lock.unlock()
    if required && !marked {
        self.delivery_done.recv() catch error {0}
    }
}

fn stream_t.fail(&self, string message): void! {
    self.lock.lock()
    self.failure = message
    self.lock.unlock()
    self.end()
}

fn stream_t.end(&self): void! {
    self.lock.lock()
    if self.ended {
        self.lock.unlock()
        return
    }
    self.ended = true
    bool terminal = self.terminal
    self.lock.unlock()
    self.events.close()
    if !terminal {
        self.done.close()
    }
}
