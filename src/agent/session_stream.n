import adou.src.agent.types as agent_types
import adou.src.ai.abort
import adou.src.ai.types as ai_types
import co.mutex

const EVENT_COMPACTION_START = 'compaction_start'
const EVENT_COMPACTION_END = 'compaction_end'
const EVENT_BRANCH_SUMMARY_START = 'branch_summary_start'
const EVENT_BRANCH_SUMMARY_END = 'branch_summary_end'
const EVENT_SESSION_END = 'session_end'
const EVENT_BASH_START = 'bash_start'
const EVENT_BASH_UPDATE = 'bash_update'
const EVENT_BASH_END = 'bash_end'
const EVENT_RETRY_START = 'retry_start'
const EVENT_RETRY_END = 'retry_end'
const EVENT_AGENT_SETTLED = 'agent_settled'
const EVENT_SUMMARIZATION_RETRY_SCHEDULED = 'summarization_retry_scheduled'
const EVENT_SUMMARIZATION_RETRY_ATTEMPT_START = 'summarization_retry_attempt_start'
const EVENT_SUMMARIZATION_RETRY_FINISHED = 'summarization_retry_finished'

type event_t = struct {
    string kind
    bool has_agent_event
    agent_types.agent_event_t agent_event
    string reason
    bool aborted
    bool will_retry
    string error_message
    string summary
    int tokens_before
    int estimated_tokens_after
    string bash_command
    string bash_output
    int bash_exit_code = -1
    bool bash_cancelled
    bool bash_timed_out
    bool bash_truncated
    string bash_full_output_path
    bool bash_exclude_from_context
    int retry_attempt
    int retry_max_attempts
    int retry_delay_ms
    string retry_error_message
    bool retry_success
    string retry_final_error
    string retry_source
    string retry_reason
}

type stream_t = struct {
    chan<event_t> events
    chan<u8> done
    chan<u8> delivery_done
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    ref<abort.abort_t> cancellation = abort.new()
    [ai_types.message_t] final_context = []
    bool terminal
    bool ended
    string failure
    bool delivery_required
    bool delivery_marked
}

fn new(): ref<stream_t> {
    return new stream_t(events = chan<event_t>.new(128), done = chan<u8>.new(), delivery_done = chan<u8>.new())
}

fn stream_t.push(&self, event_t event): void! {
    self.lock.lock()
    if self.terminal || self.ended {
        self.lock.unlock()
        return
    }
    self.lock.unlock()
    self.events.send(event)
}

fn stream_t.finish(&self, [ai_types.message_t] context): void! {
    self.lock.lock()
    if self.terminal || self.ended {
        self.lock.unlock()
        return
    }
    self.final_context = context
    self.terminal = true
    self.lock.unlock()
    self.events.send(event_t {kind: EVENT_SESSION_END,})
    self.done.close()
    self.end()
}

fn stream_t.recv(&self): event_t! {
    return self.events.recv()
}

fn stream_t.result(&self): [ai_types.message_t]! {
    self.lock.lock()
    bool ready = self.terminal
    self.lock.unlock()
    if !ready {
        self.done.recv() catch error {0}
    }
    self.lock.lock()
    var result = self.final_context
    ready = self.terminal
    string failure = self.failure
    self.lock.unlock()
    if !ready {
        if failure != '' {
            throw errorf('%s', failure)
        }
        throw errorf('session stream ended without session_end')
    }
    return result
}

fn stream_t.abort(&self) {
    self.cancellation.abort()
}

// RPC prompt workers consume a session stream on a separate coroutine.  The
// runner may become idle just before that worker serializes the terminal event;
// this small acknowledgement lets RPC `abort` wait for the public event line,
// not merely the internal operation flag.
fn stream_t.require_delivery(&self) {
    self.lock.lock()
    self.delivery_required = true
    self.delivery_marked = false
    self.lock.unlock()
}

fn stream_t.mark_delivery_done(&self) {
    self.lock.lock()
    if self.delivery_marked {
        self.lock.unlock()
        return
    }
    self.delivery_marked = true
    bool required = self.delivery_required
    self.lock.unlock()
    if required {
        self.delivery_done.close() catch error {}
    }
}

fn stream_t.wait_delivery(&self) {
    self.lock.lock()
    bool required = self.delivery_required
    bool marked = self.delivery_marked
    self.lock.unlock()
    if required && !marked {
        self.delivery_done.recv() catch error {0}
    }
}

fn stream_t.fail(&self, string message): void! {
    self.lock.lock()
    self.failure = message
    self.lock.unlock()
    self.end()
}

fn stream_t.end(&self): void! {
    self.lock.lock()
    if self.ended {
        self.lock.unlock()
        return
    }
    self.ended = true
    bool terminal = self.terminal
    self.lock.unlock()
    self.events.close()
    if !terminal {
        self.done.close()
    }
}
