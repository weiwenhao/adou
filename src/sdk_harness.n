import adou.src.sdk
import adou.src.ai.types as ai_types
import adou.src.agent.session_stream as session_stream

pub const PHASE_IDLE = 'idle'
pub const PHASE_TURN = 'turn'
pub const PHASE_COMPACTION = 'compaction'
pub const PHASE_RETRY = 'retry'
pub const PHASE_BRANCH_SUMMARY = 'branch_summary'

pub type event_handler_fn = fn(string kind)
pub type event_detail_handler_fn = fn(session_stream.event_t event)

pub type harness_t = struct {
    ref<sdk.session_t> session
    string phase = PHASE_IDLE
    {string:event_handler_fn} handlers = {}
    {string:event_detail_handler_fn} detail_handlers = {}
    [string] active_tool_names = []
    {string:any} resources = {}
    {string:any} stream_options = {}
}

pub fn new(ref<sdk.session_t> session): ref<harness_t> {
    return new harness_t(session = session, active_tool_names = session.runner.active_tool_names.slice(0, session.runner.active_tool_names.len()))
}

pub fn harness_t.on(&self, string kind, event_handler_fn handler) {
    self.handlers[kind] = handler
}

pub fn harness_t.subscribe(&self, string kind, event_detail_handler_fn handler) {
    self.detail_handlers[kind] = handler
}

pub fn harness_t.current_phase(&self): string {return self.phase}

pub fn harness_t.prompt(&self, string text): ref<session_stream.stream_t>! {
    if self.phase != PHASE_IDLE {throw errorf('AgentHarness is busy')}
    self.phase = PHASE_TURN
    var source = self.session.prompt(text)
    var stream = session_stream.new()
    bridge(self, source, stream)
    return stream
}

pub fn harness_t.compact(&self, string instructions): ref<session_stream.stream_t>! {
    if self.phase != PHASE_IDLE {throw errorf('AgentHarness is busy')}
    self.phase = PHASE_COMPACTION
    var source = self.session.runner.compact_now(instructions)
    var stream = session_stream.new()
    bridge(self, source, stream)
    return stream
}

pub fn harness_t.navigate_tree(&self, string entry_id): string! {
    if self.phase != PHASE_IDLE {throw errorf('AgentHarness is busy')}
    return self.session.runner.navigate_tree(entry_id)
}

pub fn harness_t.navigate_tree_with_summary(&self, string entry_id, string instructions): ref<session_stream.stream_t>! {
    if self.phase != PHASE_IDLE {throw errorf('AgentHarness is busy')}
    self.phase = PHASE_BRANCH_SUMMARY
    var source = self.session.runner.navigate_tree_with_summary(entry_id, instructions)
    var stream = session_stream.new()
    bridge(self, source, stream)
    return stream
}

pub fn harness_t.set_model(&self, ref<ai_types.model_t> model): void! {self.session.runner.set_model(model)}
pub fn harness_t.set_thinking_level(&self, string level): void! {self.session.runner.set_thinking_level(level)}
pub fn harness_t.set_steering_mode(&self, string mode): void! {self.session.runner.set_steering_mode(mode)}
pub fn harness_t.set_follow_up_mode(&self, string mode): void! {self.session.runner.set_follow_up_mode(mode)}
pub fn harness_t.set_auto_compaction(&self, bool enabled): void! {self.session.runner.set_auto_compaction(enabled)}
pub fn harness_t.set_auto_retry(&self, bool enabled): void! {self.session.runner.set_auto_retry(enabled)}
pub fn harness_t.set_transport(&self, string transport) {self.session.runner.set_runtime_transport(transport)}
pub fn harness_t.set_http_idle_timeout(&self, int timeout_ms) {self.session.runner.set_runtime_http_idle_timeout_ms(timeout_ms)}

pub fn harness_t.steer(&self, string text): void! {
    if self.phase == PHASE_IDLE {throw errorf('Cannot steer while idle')}
    ai_types.message_t message = new ai_types.user_message_t(content = text, timestamp = 0)
    self.session.runner.queue_steering(message)
    emit(self, 'steer')
}

pub fn harness_t.next_turn(&self, string text): void! {
    ai_types.message_t message = new ai_types.user_message_t(content = text, timestamp = 0)
    self.session.runner.append_active_message(message)
    emit(self, 'next_turn')
}

pub fn harness_t.append_message(&self, ai_types.message_t message): void! {
    self.session.runner.append_active_message(message)
}

pub fn harness_t.set_active_tools(&self, [string] names): void! {
    self.session.runner.set_active_tools(names)
    self.active_tool_names = names
    emit(self, 'tools_update')
}

pub fn harness_t.active_tools(&self): [string] {return self.active_tool_names.slice(0, self.active_tool_names.len())}

pub fn harness_t.set_resources(&self, {string:any} value) {self.resources = value; emit(self, 'resources_update')}
pub fn harness_t.get_resources(&self): {string:any} {return self.resources}
pub fn harness_t.set_stream_options(&self, {string:any} value) {self.stream_options = value}
pub fn harness_t.get_stream_options(&self): {string:any} {return self.stream_options}

pub fn harness_t.follow_up(&self, string text): void! {
    if self.phase == PHASE_IDLE {throw errorf('Cannot follow up while idle')}
    ai_types.message_t message = new ai_types.user_message_t(content = text, timestamp = 0)
    self.session.runner.queue_follow_up(message)
    emit(self, 'follow_up')
}

pub fn harness_t.abort(&self) {
    self.session.runner.abort_active()
    emit(self, 'abort')
}

pub fn harness_t.wait_for_idle(&self) {
    self.session.runner.wait_rpc_delivery()
    self.phase = PHASE_IDLE
}

pub fn harness_t.is_idle(&self): bool {return self.phase == PHASE_IDLE}

pub fn harness_t.steering_mode(&self): string {return self.session.runner.agent_config.queues.steering_mode}
pub fn harness_t.follow_up_mode(&self): string {return self.session.runner.agent_config.queues.follow_up_mode}

pub fn harness_t.messages(&self): [ai_types.message_t] {return self.session.messages()}

fn emit(ref<harness_t> harness, string kind) {
    if harness.handlers.contains(kind) {harness.handlers[kind](kind)}
    if harness.handlers.contains('*') {harness.handlers['*'](kind)}
}

fn emit_event(ref<harness_t> harness, session_stream.event_t event) {
    if harness.detail_handlers.contains(event.kind) {harness.detail_handlers[event.kind](event)}
    if harness.detail_handlers.contains('*') {harness.detail_handlers['*'](event)}
}

fn bridge(ref<harness_t> harness, ref<session_stream.stream_t> source, ref<session_stream.stream_t> target) {
    go fn() {
        for true {
            var event = source.recv() catch error {
                target.fail('AgentHarness source stream ended unexpectedly') catch ignored {}
                break
            }
            if event.kind == session_stream.EVENT_COMPACTION_START {harness.phase = PHASE_COMPACTION}
            if event.kind == session_stream.EVENT_RETRY_START {harness.phase = PHASE_RETRY}
            if event.kind == session_stream.EVENT_BRANCH_SUMMARY_START {harness.phase = PHASE_BRANCH_SUMMARY}
            if event.kind == session_stream.EVENT_AGENT_SETTLED || event.kind == session_stream.EVENT_SESSION_END {
                harness.phase = PHASE_IDLE
            }
            emit(harness, event.kind)
            emit_event(harness, event)
            if event.kind == session_stream.EVENT_SESSION_END {
                var context = source.result() catch error {[]}
                target.finish(context) catch ignored {}
                break
            }
            target.push(event) catch ignored {}
        }
    }()
}
