import adou.src.ai.abort
import adou.src.ai.clone
import adou.src.ai.types
import adou.src.debug
import co.mutex
pub const DEFAULT_CAPACITY = 32
// assistant_stream_t preserves Pi's two related stream concepts: a bounded
// sequence of events and a separately awaitable final AssistantMessage.
pub type assistant_stream_t = struct {
    chan<types.assistant_event_t> events
    chan<u8> done
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    ref<abort.abort_t> cancellation = abort.new()
    ref<types.assistant_message_t> final_message = new types.assistant_message_t()
    bool terminal
    bool ended
    // Keep the cancellation edge serialized with push().  The provider may
    // still deliver one final normal-looking frame after its HTTP response
    // has been closed; once abort wins, that frame must not resurrect a live
    // assistant turn or append more text to the TUI.
    bool aborted
}
pub fn new(): ref<assistant_stream_t> {
    return with_capacity(DEFAULT_CAPACITY)
}
pub fn with_capacity(int capacity): ref<assistant_stream_t> {
    if capacity <= 0 {
        capacity = 1
    }
    return new assistant_stream_t(events = chan<types.assistant_event_t>.new(capacity), done = chan<u8>.new(),)
}
// push blocks when the bounded channel is full. This is intentional
// backpressure: provider input cannot outgrow a slow TUI without bound.
pub fn assistant_stream_t.push(&self, types.assistant_event_t event): void! {
    debug.log('ai-stream', 'push begin kind=' + event.kind)
    self.lock.lock()
    if self.terminal || self.ended {
        self.lock.unlock()
        return
    }
    bool was_aborted = self.aborted || self.cancellation.is_aborted()
    if was_aborted && event.kind != types.EVENT_DONE && event.kind != types.EVENT_ERROR {
        self.lock.unlock()
        return
    }
    // Provider processors keep one mutable `output` object and update it for
    // every SSE frame.  Never put that object on the channel directly: a
    // buffered send lets the provider continue mutating it before the agent,
    // TUI, or JSON encoder receives the event.  Apart from producing torn
    // snapshots, that race can make the runtime walk a concurrently resized
    // content vector and crash with SIGSEGV.  Snapshot while the producer is
    // still stopped inside push, then only publish the immutable copy.
    var snapshot = snapshot_event(event)
    debug.log('ai-stream', 'snapshot complete kind=' + snapshot.kind)
    bool is_terminal = snapshot.kind == types.EVENT_DONE || snapshot.kind == types.EVENT_ERROR
    if is_terminal {
        if was_aborted && snapshot.kind == types.EVENT_DONE {
            snapshot.reason = types.STOP_ABORTED
            if snapshot.message is ref<types.assistant_message_t> message {
                message.stop_reason = types.STOP_ABORTED
                message.error_message = 'Operation aborted'
            }
        }
        if snapshot.kind == types.EVENT_DONE {
            self.final_message = snapshot.message as ref<types.assistant_message_t>
        } else {
            self.final_message = snapshot.error as ref<types.assistant_message_t>
        }
        self.terminal = true
    }
    self.lock.unlock()
    self.events.send(snapshot)
    debug.log('ai-stream', 'event delivered kind=' + snapshot.kind)
}
pub fn assistant_stream_t.recv(&self): types.assistant_event_t! {
    return self.events.recv()
}
// result may be called before or after completion and may be called more than
// once.  Closing done acts as a broadcast; every waiter then reads
// final_message.  done is closed only by end() (the provider's final stream
// touch), never at the terminal event: the consumer must not proceed while
// the provider coroutine is still finishing its teardown, or the stream can
// be dropped while the provider still touches it (run_inner pushes the
// finish events after the terminal event and then calls stream.end()).
pub fn assistant_stream_t.result(&self): ref < types.assistant_message_t > ! {
    self.lock.lock()
    // A terminal event only publishes the final message.  The provider may
    // still be unwinding its decoder/HTTP state after that event is received,
    // and the agent can immediately start a tool-follow-up request.  Wait for
    // end() so those two provider turns never overlap over Nature-managed
    // object graphs.
    bool ended = self.ended
    self.lock.unlock()
    if !ended {
        self.done.recv() catch e {
            0
        }
    }
    self.lock.lock()
    var result = self.final_message
    bool ready = self.terminal
    self.lock.unlock()
    if!ready {
        throw errorf('assistant stream ended without a terminal event')
    }
    return result
}
pub fn assistant_stream_t.end(&self): void! {
    debug.log('ai-stream', 'end requested')
    self.lock.lock()
    if self.ended {
        self.lock.unlock()
        return
    }
    self.ended = true
    bool has_terminal = self.terminal
    self.lock.unlock()
    self.events.close()
    // done always closes here, terminal or not: end() is the provider's last
    // stream touch, so result() waiters wake only after full teardown.
    self.done.close()
    debug.log('ai-stream', 'end completed terminal=' + (has_terminal ? 'true' : 'false'))
}
pub fn assistant_stream_t.abort(&self) {
    self.lock.lock()
    self.aborted = true
    self.lock.unlock()
    self.cancellation.abort()
}
pub fn assistant_stream_t.is_aborted(&self): bool {
    self.lock.lock()
    bool result = self.aborted
    self.lock.unlock()
    return result || self.cancellation.is_aborted()
}

fn snapshot_event(types.assistant_event_t source): types.assistant_event_t {
    var result = types.assistant_event_t {kind: source.kind, content_index: source.content_index, delta: source.delta, content: source.content, reason: source.reason,}
    if source.partial is ref<types.assistant_message_t> partial {
        result.partial = clone.assistant(partial)
    }
    if source.message is ref<types.assistant_message_t> message {
        result.message = clone.assistant(message)
    }
    if source.error is ref<types.assistant_message_t> error_message {
        result.error = clone.assistant(error_message)
    }
    if source.tool_call is ref<types.tool_call_t> call {
        result.tool_call = new types.tool_call_t(id = call.id, name = call.name, arguments = call.arguments, partial_json = call.partial_json)
    }
    return result
}
