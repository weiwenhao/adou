import adou.src.ai.types
import adou.src.ai.providers.decorators
import adou.src.ai.ids
import adou.src.ai.providers.replay
import adou.src.ai.sanitize_unicode
import adou.src.json_util
import fmt
import json
import strings
import syscall
pub const MIN_OUTPUT_TOKENS = 16
pub const MAX_PROMPT_CACHE_KEY_CHARS = 64
pub fn build(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {
    {string:any} body = {}
    body['model'] = model.id
    body['input'] = convert_messages(model, context)
    body['stream'] = true
    body['store'] = false
    if options.temperature >= 0.0 {
        body['temperature'] = options.temperature
    }
    if options.tool_choice != '' {
        body['tool_choice'] = options.tool_choice
    }
    int max_tokens = options.max_tokens
    if max_tokens <= 0 {
        max_tokens = model.max_tokens
    }
    if max_tokens > 0 {
        if max_tokens < MIN_OUTPUT_TOKENS {
            max_tokens = MIN_OUTPUT_TOKENS
        }
        body['max_output_tokens'] = max_tokens
    }
    // Pi disables implicit prompt caching when retention is explicitly none.
    // Long retention is represented by OpenAI's 24h cache hint.
    if options.session_id != '' && options.cache_retention != 'none' {
        body['prompt_cache_key'] = clamp_cache_key(options.session_id)
    }
    if options.cache_retention == 'long' && model.supports_long_cache_retention {
        body['prompt_cache_retention'] = '24h'
    }
    if context.tools.len() > 0 {
        body['tools'] = convert_tools(context.tools)
    }
    if model.reasoning {
        {string:any} reasoning = {}
        if options.reasoning_effort != '' && options.reasoning_effort != 'off' {
            reasoning['effort'] = options.reasoning_effort
            reasoning['summary'] = options.reasoning_summary
            [any] include = []
            include.push('reasoning.encrypted_content')
            body['include'] = include
        } else {
            reasoning['effort'] = 'none'
        }
        body['reasoning'] = reasoning
    }
    return json.serialize(body)
}
pub fn endpoint(ref<types.model_t> model): string {
    if model.provider == 'azure-openai-responses' {
        return azure_endpoint(model)
    }
    string base = decorators.resolve_base_url(model)
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    return base + '/responses'
}

// Azure OpenAI Responses: https://<resource>.openai.azure.com/openai/deployments/<deployment>/responses?api-version=v1
// The base URL resolves from AZURE_OPENAI_BASE_URL, AZURE_OPENAI_RESOURCE_NAME,
// or the model's own base URL; the deployment defaults to the model id with
// an optional AZURE_OPENAI_DEPLOYMENT_NAME_MAP override (model=deployment, ...).
pub fn azure_endpoint(ref<types.model_t> model): string {
    string base = syscall.get_env('AZURE_OPENAI_BASE_URL')
    if base == '' {
        string resource = syscall.get_env('AZURE_OPENAI_RESOURCE_NAME')
        if resource != '' {
            base = 'https://' + resource + '.openai.azure.com/openai/v1'
        }
    }
    if base == '' {
        base = model.base_url
    }
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    string deployment = model.id
    string mapping = syscall.get_env('AZURE_OPENAI_DEPLOYMENT_NAME_MAP')
    if mapping != '' {
        for pair in mapping.split(',') {
            string trimmed = pair.trim([' ', '\t'])
            int separator = trimmed.find('=')
            if separator > 0 && trimmed.slice(0, separator).trim([' ', '\t']) == model.id {
                deployment = trimmed.slice(separator + 1, trimmed.len()).trim([' ', '\t'])
                break
            }
        }
    }
    string api_version = syscall.get_env('AZURE_OPENAI_API_VERSION')
    if api_version == '' {
        api_version = 'v1'
    }
    return base + '/deployments/' + deployment + '/responses?api-version=' + api_version
}
pub fn authorization(ref<types.stream_options_t> options): string! {
    if options.api_key == '' {
        throw errorf('No API key for provider: openai')
    }
    return 'Bearer ' + options.api_key
}
pub fn convert_messages(ref<types.model_t> model, ref<types.context_t> context): [any]! {
    [any] result = []
    if context.system_prompt != '' {
        {string:any} system = {}
        if model.reasoning {
            system['role'] = 'developer'
        } else {
            system['role'] = 'system'
        }
        system['content'] = context.system_prompt
        result.push(system)
    }
    var replay = replay.tracker()
    int message_index = 0
    for message in context.messages {
        bool counts_for_index = true
        if message is ref<types.user_message_t> user {
            for missing in replay.before_other() {
                result.push(tool_result_item(missing))
            }
            result.push(user_item(user))
        } else if message is ref<types.assistant_message_t> assistant {
            for missing in replay.before_assistant(assistant) {
                result.push(tool_result_item(missing))
            }
            // Pi never replays an incomplete assistant turn. Its reasoning
            // signature or partial tool call may not have a valid successor.
            if assistant.stop_reason == types.STOP_ERROR || assistant.stop_reason == types.STOP_ABORTED {
                continue
            }
            result.append(assistant_items(model, assistant, message_index))
        } else if message is ref<types.tool_result_message_t> tool_result {
            replay.observe_tool_result(tool_result.tool_call_id)
            result.push(tool_result_item(tool_result))
        } else if message is ref<types.compaction_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(missing))
            }
            result.push(summary_item(summary))
        } else if message is ref<types.branch_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(missing))
            }
            var user = new types.user_message_t(content = 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n' + summary.summary + '</summary>', timestamp = summary.timestamp)
            result.push(user_item(user))
        } else if message is ref<types.custom_message_t> custom {
            for missing in replay.before_other() {
                result.push(tool_result_item(missing))
            }
            var user = new types.user_message_t(content = custom.content, timestamp = custom.timestamp)
            result.push(user_item(user))
        } else if message is ref<types.bash_execution_message_t> bash {
            for missing in replay.before_other() {
                result.push(tool_result_item(missing))
            }
            if !bash.exclude_from_context {
                var user = new types.user_message_t(content = types.bash_execution_text(bash), timestamp = bash.timestamp)
                result.push(user_item(user))
            } else {
                // convertToLlm removes excluded bash records before Pi assigns
                // fallback Responses message indexes.
                counts_for_index = false
            }
        }
        if counts_for_index {
            message_index += 1
        }
    }
    for missing in replay.finish() {
        result.push(tool_result_item(missing))
    }
    return result
}
fn summary_item(ref<types.compaction_summary_message_t> message): any {
    var user = new types.user_message_t(content = 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n' + message.summary + '\n</summary>', timestamp = message.timestamp)
    return user_item(user)
}
fn user_item(ref<types.user_message_t> message): any {
    {string:any} text = {}
    text['type'] = 'input_text'
    text['text'] = sanitize_unicode.sanitize_surrogates(message.content)
    [any] content = []
    content.push(text)
    {string:any} item = {}
    item['role'] = 'user'
    item['content'] = content
    return item
}
fn assistant_items(ref<types.model_t> model, ref<types.assistant_message_t> message, int message_index): [any]! {
    [any] result = []
    int text_index = 0
    for block in message.content {
        if block is ref<types.thinking_content_t> thinking {
            if thinking.thinking_signature != '' {
                result.push(json_util.parse(thinking.thinking_signature))
            }
        } else if block is ref<types.text_content_t> text {
            result.push(assistant_text_item(text, message_index, text_index))
            text_index += 1
        } else if block is ref<types.tool_call_t> tool_call {
            result.push(assistant_tool_item(model, message, tool_call))
        }
    }
    return result
}
fn assistant_text_item(ref<types.text_content_t> text, int message_index, int text_index): any! {
    string fallback_id = fmt.sprintf('msg_pi_%d', message_index)
    if text_index > 0 {
        fallback_id += fmt.sprintf('_%d', text_index)
    }
    var (message_id, phase) = parse_text_signature(text.text_signature, fallback_id)
    if message_id.len() > 64 {
        message_id = 'msg_' + ids.short_hash(message_id)
    }
    {string:any} content = {}
    content['type'] = 'output_text'
    content['text'] = sanitize_unicode.sanitize_surrogates(text.text)
    [any] annotations = []
    content['annotations'] = annotations
    [any] content_items = []
    content_items.push(content)
    {string:any} item = {}
    item['type'] = 'message'
    item['role'] = 'assistant'
    item['content'] = content_items
    item['status'] = 'completed'
    item['id'] = message_id
    if phase != '' {
        item['phase'] = phase
    }
    return item
}
fn assistant_tool_item(ref<types.model_t> model, ref<types.assistant_message_t> assistant, ref<types.tool_call_t> tool_call): any! {
    string normalized_id = normalize_tool_call_id(model, assistant, tool_call.id)
    var parts = normalized_id.split('|')
    string call_id = normalized_id
    string item_id = ''
    if parts.len() > 0 {
        call_id = parts[0]
    }
    if parts.len() > 1 {
        item_id = parts[1]
    }
    {string:any} item = {}
    item['type'] = 'function_call'
    item['call_id'] = call_id
    bool different_model = assistant.model != '' && assistant.model != model.id && assistant.provider == model.provider && assistant.api == model.api
    if item_id != '' && !different_model {
        item['id'] = item_id
    }
    item['name'] = tool_call.name
    item['arguments'] = json.serialize(tool_call.arguments)
    return item
}
pub fn tool_result_item(ref<types.tool_result_message_t> message): any {
    string call_id = ids.normalize_id_part(message.tool_call_id)
    var parts = message.tool_call_id.split('|')
    if parts.len() > 0 {
        call_id = ids.normalize_id_part(parts[0])
    }
    [string] text = []
    for block in message.content {
        text.push(block.text)
    }
    string output = strings.join(text, '\n')
    if output == '' {
        output = '(no tool output)'
    }
    {string:any} item = {}
    item['type'] = 'function_call_output'
    item['call_id'] = call_id
    if message.images.len() == 0 {
        item['output'] = output
    } else {
        [any] content = []
        if output != '' {
            {string:any} text = {}
            text['type'] = 'input_text'
            text['text'] = output
            content.push(text)
        }
        for image in message.images {
            {string:any} image_item = {}
            image_item['type'] = 'input_image'
            image_item['detail'] = 'auto'
            image_item['image_url'] = 'data:' + image.mime_type + ';base64,' + image.data
            content.push(image_item)
        }
        item['output'] = content
    }
    return item
}
fn normalize_tool_call_id(ref<types.model_t> model, ref<types.assistant_message_t> assistant, string id): string {
    var parts = id.split('|')
    if parts.len() == 0 {
        return ids.normalize_id_part(id)
    }
    string call_id = ids.normalize_id_part(parts[0])
    if parts.len() < 2 {
        return call_id
    }
    bool foreign = assistant.provider != model.provider || assistant.api != model.api
    string item_id = foreign ? ids.foreign_responses_item_id(parts[1]) : ids.normalize_id_part(parts[1])
    if !item_id.starts_with('fc_') {
        item_id = ids.normalize_id_part('fc_' + item_id)
    }
    return call_id + '|' + item_id
}
pub fn convert_tools([ref<types.tool_t>] tools): [any]! {
    [any] result = []
    for tool in tools {
        {string:any} item = {}
        item['type'] = 'function'
        item['name'] = tool.name
        item['description'] = tool.description
        item['parameters'] = tool.parameters
        item['strict'] = false
        result.push(item)
    }
    return result
}
fn parse_text_signature(string signature, string fallback): (string, string)! {
    if signature == '' || !signature.starts_with('{') {
        if signature != '' {
            return (signature, '')
        }
        return (fallback, '')
    }
    var value = json_util.parse(signature) catch e {
        return (signature, '')
    }
    var object = value as {string:any}
    if !object.contains('v') || json_util.num_token(object['v']) != '1' || !object.contains('id') {
        return (fallback, '')
    }
    string phase = ''
    if object.contains('phase') {
        var candidate = object['phase'] as string
        if candidate == 'commentary' || candidate == 'final_answer' {
            phase = candidate
        }
    }
    // Intermediate locals: direct `(any as string)` expressions inside tuple
    // constructions corrupt the heap on the current Nature runtime.
    string message_id = object['id'] as string
    return (message_id, phase)
}
fn clamp_cache_key(string key): string {
    // Session IDs generated by Adou are ASCII UUID-like identifiers. Clamp by
    // bytes here; the session module guarantees this invariant at creation.
    if key.len() <= MAX_PROMPT_CACHE_KEY_CHARS {
        return key
    }
    return key.slice(0, MAX_PROMPT_CACHE_KEY_CHARS)
}
