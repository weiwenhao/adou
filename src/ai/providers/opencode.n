// Provider definition for OpenCode Zen.
// Metadata follows vendors/pi/packages/ai/src/providers/opencode.ts.
import adou.src.ai.providers.opencode_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'opencode', name: 'OpenCode Zen', api: 'openai-completions', base_url: 'https://opencode.ai/zen', env_vars: ['OPENCODE_API_KEY'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return opencode_models.models()
}
