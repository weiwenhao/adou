// Provider definition for Hugging Face.
// Metadata follows vendors/pi/packages/ai/src/providers/huggingface.ts.
import adou.src.ai.providers.huggingface_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'huggingface', name: 'Hugging Face', api: 'openai-completions', base_url: 'https://router.huggingface.co/v1', env_vars: ['HF_TOKEN'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return huggingface_models.models()
}
