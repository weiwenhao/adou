// Provider definition for OpenRouter.
// Metadata follows vendors/pi/packages/ai/src/providers/openrouter.ts.
import adou.src.ai.providers.openrouter_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'openrouter', name: 'OpenRouter', api: 'openai-completions', base_url: 'https://openrouter.ai/api/v1', env_vars: ['OPENROUTER_API_KEY'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return openrouter_models.models()
}
