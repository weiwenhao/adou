import adou.src.ai.abort
import adou.src.ai.attribution
import adou.src.ai.diagnostics
import adou.src.ai.event_stream
import adou.src.ai.provider_retry
import adou.src.ai.providers.decorators
import adou.src.ai.providers.openai_request
import adou.src.ai.providers.openai_responses
import adou.src.ai.sse
import adou.src.ai.request_headers
import adou.src.ai.types
import adou.src.debug
import fmt
import http.client
import time
pub const ERROR_BODY_LIMIT = 64 * 1024
pub type run_state_t = struct {
    ref<event_stream.assistant_stream_t> stream
    ref<types.model_t> model
    ref<types.context_t> context
    ref<types.stream_options_t> options
    ref<openai_responses.processor_t> processor
    string body
    ref<client.response_t>? response = null
}
pub fn stream(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): ref<event_stream.assistant_stream_t> {
    var result = event_stream.new()
    go run(result, model, context, options)
    return result
}
pub fn run(ref<event_stream.assistant_stream_t> stream, ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): void! {
    debug.log('provider', 'openai-responses stream start model=' + model.id)
    var processor = openai_responses.processor(model, time.now().ms_timestamp())
    var state = new run_state_t(stream = stream, model = model, context = context, options = options, processor = processor,)
    run_inner(stream, state) catch e {
        debug.log('provider', 'openai-responses stream failure: ' + e.msg())
        fail(stream, state, e.msg())
        return
    }
}
pub fn run_inner(ref<event_stream.assistant_stream_t> stream, ref<run_state_t> state): void! {
    if stream.is_aborted() {
        throw errorf('Operation aborted')
    }
    state.body = openai_request.build(state.model, state.context, state.options)
    var current = send_with_retry(state, 0)
    debug.log('provider', 'openai-responses response status=' + fmt.sprintf('%d', current.status))
    stream.push(state.processor.start())
    var decoder = sse.parser()
    [u8] scratch = vec<u8>.new(0, 8192)
    bool terminal = false
    for!terminal {
        debug.log('provider', 'openai-responses read begin')
        int n = current.read(scratch) catch e {
            if provider_retry.is_clean_eof(e.msg()) {
                break
            }
            throw e
        }
        debug.log('provider', 'openai-responses read bytes=' + fmt.sprintf('%d', n))
        var frames = decoder.feed(scratch.slice(0, n))
        for frame in frames {
            var events = state.processor.feed(frame)
            for event in events {
                stream.push(event)
                if event.kind == types.EVENT_DONE || event.kind == types.EVENT_ERROR {
                    debug.log('provider', 'openai-responses terminal event=' + event.kind)
                    terminal = true
                    break
                }
            }
            if terminal {
                break
            }
        }
    }
    // OpenAI Responses occasionally closes an SSE body without the final
    // blank line.  Pi dispatches the pending data-bearing event at EOF, so do
    // the same instead of silently dropping the terminal response.
    if !terminal {
        var pending = decoder.finish_pending()
        for frame in pending {
            var events = state.processor.feed(frame)
            for event in events {
                stream.push(event)
            }
        }
    }
    state.processor.finish()
    debug.log('provider', 'openai-responses stream end')
    stream.end()
}
pub fn send_with_retry(ref<run_state_t> state, int retry_index): ref < client.response_t > ! {
    var stream = state.stream
    if stream.is_aborted() {
        throw errorf('Request aborted')
    }
    var current = send_once(state) catch e {
        debug.log('provider', 'openai-responses request attempt failed: ' + e.msg())
        if stream.is_aborted() || retry_index >= state.options.max_retries {
            throw e
        }
        provider_retry.sleep(stream.cancellation, provider_retry.exponential_delay_ms(retry_index))
        return send_with_retry(state, retry_index + 1)
    }
    state.response = current
    abort.abort_callback_t close_response = fn () {
        current.close()
    }
    stream.cancellation.on_abort(close_response)
    if stream.is_aborted() {
        current.close()
        throw errorf('Request aborted')
    }
    if current.status >= 200 && current.status < 300 {
        debug.log('provider', 'openai-responses request accepted status=' + fmt.sprintf('%d', current.status))
        return current
    }
    int status = current.status
    string status_message = current.message
    var headers = response_headers(current)
    string error_body = read_error_body(current)
    string provider_error = format_http_error(status, status_message, error_body)
    if retry_index >= state.options.max_retries || !provider_retry.should_retry(status, headers) {
        throw errorf('%s', provider_error)
    }
    int delay = provider_retry.delay_ms(headers, retry_index, state.options.max_retry_delay_ms, provider_error)
    provider_retry.sleep(stream.cancellation, delay)
    return send_with_retry(state, retry_index + 1)
}
pub fn send_once(ref<run_state_t> state): ref < client.response_t > ! {
    debug.log('provider', 'openai-responses sending request')
    var request = client.new()
    .post(openai_request.endpoint(state.model))
    .timeout(state.options.timeout_ms)
    .header('Content-Type', 'application/json')
    .header('Accept', 'text/event-stream')
    .content(state.body)
    if decorators.is_cloudflare_gateway(state.model) {
        request.header(decorators.cloudflare_gateway_auth_header(state.options.api_key).name, decorators.cloudflare_gateway_auth_header(state.options.api_key).value)
    } else if state.model.provider == 'azure-openai-responses' {
        // Azure OpenAI authenticates with the api-key header, not Bearer.
        request.header('api-key', state.options.api_key)
    } else {
        request.header('Authorization', openai_request.authorization(state.options))
    }
    var headers = decorators.copilot_headers(state.context)
    for header in headers {
        request.header(header.name, header.value)
    }
    var attribution_headers = attribution.provider_attribution_headers(state.model, state.options.session_id)
    for header in attribution_headers {
        request.header(header.name, header.value)
    }
    if state.options.session_id != '' {
        request.header('session_id', state.options.session_id)
        request.header('x-client-request-id', state.options.session_id)
    }
    request_headers.apply(request, state.model)
    return request.send()
}
pub fn response_headers(ref<client.response_t> response): [provider_retry.header_t]{
    [provider_retry.header_t] result = []
    for name, value in response.headers {
        var item = provider_retry.header_t {
            name: name, value: value,
        }
        result.push(item)
    }
    return result
}
pub fn format_http_error(int status, string message, string body): string {
    return fmt.sprintf('OpenAI API error: HTTP %d %s: %s', status, message, provider_retry.truncate_error_text(body, provider_retry.MAX_PROVIDER_ERROR_BODY_CHARS))
}
pub fn fail(ref<event_stream.assistant_stream_t> stream, ref<run_state_t> state, string message) {
    debug.log('provider', 'openai-responses terminal failure: ' + message)
    // The failed read owns transport cleanup. Re-dispatching close through
    // Nature's connable interface here can corrupt the receiver on a TTY
    // coroutine schedule and raise SIGBUS.
    state.processor.output.stop_reason = types.STOP_ERROR
    if stream.is_aborted() {
        state.processor.output.stop_reason = types.STOP_ABORTED
    }
    state.processor.output.error_message = message
    if !stream.is_aborted() {
        {string:any} details = {}
        details['provider'] = state.model.provider
        details['model'] = state.model.id
        var diagnostic = diagnostics.create_assistant_message_diagnostic('openai-responses_response_failure', errorf('%s', message), details)
        diagnostics.append_assistant_message_diagnostic(state.processor.output, diagnostic)
    }
    clear_streaming_scratch(state.processor.output)
    var event = types.assistant_event_t {
        kind: types.EVENT_ERROR, reason: state.processor.output.stop_reason, error: state.processor.output,
    }
    stream.push(event) catch push_error {}
    stream.end() catch end_error {}
}
pub fn read_error_body(ref<client.response_t> response): string! {
    [u8] result = []
    [u8] scratch = vec<u8>.new(0, 4096)
    for result.len() < ERROR_BODY_LIMIT {
        int n = response.read(scratch) catch e {
            if provider_retry.is_clean_eof(e.msg()) {
                break
            }
            throw e
        }
        int allowed = ERROR_BODY_LIMIT - result.len()
        if n > allowed {
            n = allowed
        }
        result.append(scratch.slice(0, n))
    }
    response.close()
    return result as string
}
pub fn clear_streaming_scratch(ref<types.assistant_message_t> message) {
    for block in message.content {
        if block is ref<types.tool_call_t> tool_call {
            tool_call.partial_json = ''
        }
    }
}
