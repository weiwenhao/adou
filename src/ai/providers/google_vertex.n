// Provider definition for Google Vertex.
// Metadata follows vendors/pi/packages/ai/src/providers/google-vertex.ts.
// Vertex has no env var list yet still supports API-key login in the
// product surface (B1-R2-04): the capability is explicit, never inferred
// from env_vars length.
import adou.src.ai.providers.google_vertex_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    // Canonical name matches vendored Pi 0.82.1 ("Google Vertex AI",
    // B1-R3-09): /login sorting, description and search text depend on it.
    return types.provider_def_t {id: 'google-vertex', name: 'Google Vertex AI', api: 'google-vertex', base_url: 'https://{location}-aiplatform.googleapis.com', env_vars: [], headers: {}, supports_api_key_login: true,}
}

pub fn models(): [ref<types.model_t>] {
    return google_vertex_models.models()
}
