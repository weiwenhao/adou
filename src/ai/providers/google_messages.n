import adou.src.ai.providers.decorators
import adou.src.ai.providers.replay
import adou.src.ai.types
import adou.src.json_util
import json
import strings
import syscall

pub fn endpoint(ref<types.model_t> model): string {
    if model.provider == 'google-vertex' {
        return vertex_endpoint(model)
    }
    string base = decorators.resolve_base_url(model)
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    return base + '/models/' + model.id + ':streamGenerateContent?alt=sse'
}

pub fn query_key(ref<types.stream_options_t> options): string {
    return '&key=' + options.api_key
}

// Vertex AI: https://{location}-aiplatform.googleapis.com/v1beta1/projects/{project}/locations/{location}/publishers/google/models/{model}:streamGenerateContent
// The location and project resolve from the environment with Pi-compatible
// defaults; the stream protocol and chunk shape match Google Generative AI.
pub fn vertex_endpoint(ref<types.model_t> model): string {
    string location = syscall.get_env('VERTEX_LOCATION')
    if location == '' {
        location = syscall.get_env('GOOGLE_VERTEX_LOCATION')
    }
    if location == '' {
        location = 'us-central1'
    }
    string project = syscall.get_env('GOOGLE_CLOUD_PROJECT')
    if project == '' {
        project = syscall.get_env('VERTEX_PROJECT')
    }
    if project == '' {
        project = syscall.get_env('GOOGLE_VERTEX_PROJECT')
    }
    string base = model.base_url
    if base == '' {
        base = 'https://' + location + '-aiplatform.googleapis.com/v1beta1'
    }
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    if model.base_url != '' {
        // Custom base URLs (tests, proxies) carry the full location path.
        return base + '/models/' + model.id + ':streamGenerateContent?alt=sse'
    }
    return base + '/projects/' + project + '/locations/' + location + '/publishers/google/models/' + model.id + ':streamGenerateContent?alt=sse'
}

// Vertex authenticates either with a bearer access token (ADC/OAuth flow,
// provided through GOOGLE_VERTEX_ACCESS_TOKEN) or with a Vertex API key
// passed as the query key like the Generative AI API.
pub fn vertex_auth_header(ref<types.stream_options_t> options): string! {
    if options.api_key != '' {
        return ''
    }
    string token = syscall.get_env('GOOGLE_VERTEX_ACCESS_TOKEN')
    if token == '' {
        throw errorf('No API key for provider: google-vertex. Set a Vertex API key or GOOGLE_VERTEX_ACCESS_TOKEN.')
    }
    return 'Bearer ' + token
}

pub fn build(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {
    {string:any} body = {}
    [any] contents = convert_contents(context)
    body['contents'] = contents
    if context.system_prompt != '' {
        {string:any} system = {}
        [any] parts = []
        {string:any} text_part = {}
        text_part['text'] = context.system_prompt
        parts.push(text_part)
        system['parts'] = parts
        body['systemInstruction'] = system
    }
    if context.tools.len() > 0 {
        body['tools'] = convert_tools(context.tools)
    }
    {string:any} generation_config = {}
    int max_tokens = options.max_tokens
    if max_tokens <= 0 {
        max_tokens = model.max_tokens
    }
    if max_tokens > 0 {
        generation_config['maxOutputTokens'] = max_tokens
    }
    var thinking_config = google_thinking_config(model, options)
    if thinking_config.len() > 0 {
        generation_config['thinkingConfig'] = thinking_config
    }
    body['generationConfig'] = generation_config
    return json.serialize(body)
}

// Pi google-generative-ai thinking mapping: Gemini 3 Pro/Flash and Gemma 4
// use native thinkingLevel values, older Gemini 2.5 models use token budgets.
fn google_thinking_config(ref<types.model_t> model, ref<types.stream_options_t> options): {string:any} {
    {string:any} config = {}
    if !model.reasoning {
        return config
    }
    if options.thinking_enabled {
        config['includeThoughts'] = true
        string effort = options.reasoning_effort
        if effort == '' || effort == 'off' {
            effort = 'high'
        }
        if is_gemini3_pro(model) || is_gemini3_flash(model) || is_gemma4(model) {
            config['thinkingLevel'] = google_thinking_level(effort, model)
        } else {
            config['thinkingBudget'] = google_thinking_budget(model, effort)
        }
        return config
    }
    // Thinking disabled: Gemini 3 cannot turn thinking fully off, so Pi asks
    // for the lowest level with hidden thinking.
    if is_gemini3_pro(model) {
        config['thinkingLevel'] = 'LOW'
    } else if is_gemini3_flash(model) || is_gemma4(model) {
        config['thinkingLevel'] = 'MINIMAL'
    }
    return config
}

fn google_thinking_level(string effort, ref<types.model_t> model): string {
    if is_gemini3_pro(model) {
        if effort == 'minimal' || effort == 'low' {
            return 'LOW'
        }
        return 'HIGH'
    }
    if is_gemma4(model) {
        if effort == 'minimal' || effort == 'low' {
            return 'MINIMAL'
        }
        return 'HIGH'
    }
    if effort == 'minimal' {
        return 'MINIMAL'
    }
    if effort == 'low' {
        return 'LOW'
    }
    if effort == 'medium' {
        return 'MEDIUM'
    }
    return 'HIGH'
}

fn google_thinking_budget(ref<types.model_t> model, string effort): int {
    if model.id.contains('2.5-pro') {
        return budget_for(effort, 128, 2048, 8192, 32768)
    }
    if model.id.contains('2.5-flash-lite') {
        return budget_for(effort, 512, 2048, 8192, 24576)
    }
    if model.id.contains('2.5-flash') {
        return budget_for(effort, 128, 2048, 8192, 24576)
    }
    return budget_for(effort, 1024, 2048, 8192, 16384)
}

fn budget_for(string effort, int minimal, int low, int medium, int high): int {
    if effort == 'minimal' {
        return minimal
    }
    if effort == 'low' {
        return low
    }
    if effort == 'medium' {
        return medium
    }
    return high
}

fn is_gemini3_pro(ref<types.model_t> model): bool {
    string id = model.id.to_lower()
    return id.contains('gemini-3') && id.contains('-pro')
}

fn is_gemini3_flash(ref<types.model_t> model): bool {
    string id = model.id.to_lower()
    return (id.contains('gemini-3') && id.contains('-flash')) || id == 'gemini-flash-latest' || id == 'gemini-flash-lite-latest'
}

fn is_gemma4(ref<types.model_t> model): bool {
    string id = model.id.to_lower()
    return id.contains('gemma-4') || id.contains('gemma4')
}

#local
fn convert_contents(ref<types.context_t> context): [any] {
    [any] result = []
    var replay = replay.tracker()
    for message in context.messages {
        if message is ref<types.user_message_t> user {
            for missing in replay.before_other() {
                result.push(tool_result_content(missing))
            }
            result.push(user_content(user.content))
        } else if message is ref<types.assistant_message_t> assistant {
            for missing in replay.before_assistant(assistant) {
                result.push(tool_result_content(missing))
            }
            if assistant.stop_reason == types.STOP_ERROR || assistant.stop_reason == types.STOP_ABORTED {
                continue
            }
            var content = model_content(assistant)
            if !json_util.is_null(content) {
                result.push(content)
            }
        } else if message is ref<types.tool_result_message_t> tool_result {
            replay.observe_tool_result(tool_result.tool_call_id)
            result.push(tool_result_content(tool_result))
        } else if message is ref<types.compaction_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_content(missing))
            }
            result.push(user_content('The conversation history before this point was compacted into the following summary:\n\n<summary>\n' + summary.summary + '\n</summary>'))
        } else if message is ref<types.branch_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_content(missing))
            }
            result.push(user_content('The following is a summary of a branch that this conversation came back from:\n\n<summary>\n' + summary.summary + '</summary>'))
        } else if message is ref<types.custom_message_t> custom {
            for missing in replay.before_other() {
                result.push(tool_result_content(missing))
            }
            result.push(user_content(custom.content))
        } else if message is ref<types.bash_execution_message_t> bash {
            for missing in replay.before_other() {
                result.push(tool_result_content(missing))
            }
            if !bash.exclude_from_context {
                result.push(user_content(types.bash_execution_text(bash)))
            }
        }
    }
    for missing in replay.finish() {
        result.push(tool_result_content(missing))
    }
    return result
}

#local
fn user_content(string text): any {
    {string:any} content = {}
    content['role'] = 'user'
    [any] parts = []
    {string:any} part = {}
    part['text'] = text
    parts.push(part)
    content['parts'] = parts
    return content
}

#local
fn model_content(ref<types.assistant_message_t> message): any {
    [any] parts = []
    for block in message.content {
        if block is ref<types.text_content_t> text_block {
            {string:any} part = {}
            part['text'] = text_block.text
            parts.push(part)
        } else if block is ref<types.thinking_content_t> thinking_block {
            {string:any} part = {}
            part['text'] = thinking_block.thinking
            part['thought'] = true
            parts.push(part)
        } else if block is ref<types.tool_call_t> tool_call {
            {string:any} function_call = {}
            function_call['name'] = tool_call.name
            function_call['args'] = tool_call.arguments
            if tool_call.id != '' {
                function_call['id'] = tool_call.id
            }
            {string:any} part = {}
            part['functionCall'] = function_call
            parts.push(part)
        }
    }
    if parts.len() == 0 {
        return null
    }
    {string:any} content = {}
    content['role'] = 'model'
    content['parts'] = parts
    return content
}

#local
fn tool_result_content(ref<types.tool_result_message_t> message): any {
    [string] lines = []
    for block in message.content {
        lines.push(block.text)
    }
    string text = strings.join(lines, '\n')
    if text == '' {
        text = '(no tool output)'
    }
    {string:any} function_response = {}
    function_response['name'] = message.tool_name
    {string:any} response = {}
    response['result'] = text
    function_response['response'] = response
    {string:any} part = {}
    part['functionResponse'] = function_response
    {string:any} content = {}
    content['role'] = 'user'
    [any] parts = []
    parts.push(part)
    content['parts'] = parts
    return content
}

pub fn convert_tools([ref<types.tool_t>] tools): [any]! {
    [any] result = []
    for tool in tools {
        {string:any} declaration = {}
        declaration['name'] = tool.name
        declaration['description'] = tool.description
        declaration['parameters'] = tool.parameters
        [any] declarations = []
        declarations.push(declaration)
        {string:any} tool_group = {}
        tool_group['functionDeclarations'] = declarations
        result.push(tool_group)
    }
    return result
}
