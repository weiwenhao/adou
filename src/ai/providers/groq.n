// Provider definition for Groq.
// Metadata follows vendors/pi/packages/ai/src/providers/groq.ts.
import adou.src.ai.providers.groq_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'groq', name: 'Groq', api: 'openai-completions', base_url: 'https://api.groq.com/openai/v1', env_vars: ['GROQ_API_KEY'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return groq_models.models()
}
