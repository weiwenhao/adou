import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'anthropic', name: 'Anthropic', api: 'anthropic-messages', base_url: 'https://api.anthropic.com', env_vars: ['ANTHROPIC_API_KEY'], headers: {}, supports_oauth: true,}
}

pub fn models(): [ref<types.model_t>] {
    return anthropic_models.models()
}
