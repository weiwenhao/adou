import adou.src.ai.abort
import adou.src.ai.attribution
import adou.src.ai.diagnostics
import adou.src.ai.event_stream
import adou.src.ai.provider_retry
import adou.src.ai.providers.decorators
import adou.src.ai.providers.openai_completions_request
import adou.src.ai.providers.pi_messages
import adou.src.ai.sse
import adou.src.ai.request_headers
import adou.src.ai.types
import adou.src.json_util
import adou.src.session.message_json
import adou.src.debug
import fmt
import http.client
import json
import time

pub const ERROR_BODY_LIMIT = 64 * 1024

pub type run_state_t = struct {
    ref<event_stream.assistant_stream_t> stream
    ref<types.model_t> model
    ref<types.context_t> context
    ref<types.stream_options_t> options
    ref<pi_messages.processor_t> processor
    string body
    ref<client.response_t>? response = null
}

pub fn stream(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): ref<event_stream.assistant_stream_t> {
    var result = event_stream.new()
    go run(result, model, context, options)
    return result
}

pub fn run(ref<event_stream.assistant_stream_t> stream, ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): void! {
    debug.log('provider', 'pi-messages stream start model=' + model.id)
    var processor = pi_messages.processor(model, time.now().ms_timestamp())
    var state = new run_state_t(stream = stream, model = model, context = context, options = options, processor = processor,)
    run_inner(stream, state) catch error {
        debug.log('provider', 'pi-messages stream failure: ' + error.msg())
        fail(stream, state, error.msg())
    }
}

pub fn run_inner(ref<event_stream.assistant_stream_t> stream, ref<run_state_t> state): void! {
    if stream.is_aborted() {
        throw errorf('Operation aborted')
    }
    state.body = build_payload(state.model, state.context, state.options)
    var current = send_with_retry(state, 0)
    debug.log('provider', 'pi-messages response status=' + fmt.sprintf('%d', current.status))
    stream.push(state.processor.start())
    var decoder = sse.parser()
    [u8] scratch = vec<u8>.new(0, 8192)
    bool saw_terminal = false
    for true {
        debug.log('provider', 'pi-messages read begin')
        int n = current.read(scratch) catch error {
            if provider_retry.is_clean_eof(error.msg()) {
                break
            }
            throw error
        }
        debug.log('provider', 'pi-messages read bytes=' + fmt.sprintf('%d', n))
        var frames = decoder.feed(scratch.slice(0, n))
        saw_terminal = push_frames(stream, state.processor, frames)
        if saw_terminal {
            break
        }
    }
    if !saw_terminal {
        var pending = decoder.finish_pending()
        push_frames(stream, state.processor, pending)
    }
    var done = state.processor.finish()
    for event in done {
        stream.push(event)
    }
    debug.log('provider', 'pi-messages stream end')
    stream.end()
}

pub fn push_frames(ref<event_stream.assistant_stream_t> stream, ref<pi_messages.processor_t> processor, [sse.event_t] frames): bool! {
    bool saw_terminal = false
    for frame in frames {
        var events = processor.feed(frame)
        for event in events {
            stream.push(event)
            if event.kind == types.EVENT_DONE || event.kind == types.EVENT_ERROR {
                saw_terminal = true
            }
        }
    }
    return saw_terminal
}

pub fn send_with_retry(ref<run_state_t> state, int retry_index): ref<client.response_t>! {
    var stream = state.stream
    if stream.is_aborted() {
        throw errorf('Request aborted')
    }
    var current = send_once(state) catch error {
        debug.log('provider', 'pi-messages request attempt failed: ' + error.msg())
        if stream.is_aborted() || retry_index >= state.options.max_retries {
            throw error
        }
        provider_retry.sleep(stream.cancellation, provider_retry.exponential_delay_ms(retry_index))
        return send_with_retry(state, retry_index + 1)
    }
    state.response = current
    abort.abort_callback_t close_response = fn () {
        current.close()
    }
    stream.cancellation.on_abort(close_response)
    if stream.is_aborted() {
        current.close()
        throw errorf('Request aborted')
    }
    if current.status >= 200 && current.status < 300 {
        debug.log('provider', 'pi-messages request accepted status=' + fmt.sprintf('%d', current.status))
        return current
    }
    int status = current.status
    string status_message = current.message
    var headers = response_headers(current)
    string error_body = read_error_body(current)
    string provider_error = fmt.sprintf('%s API error: HTTP %d %s: %s', state.model.provider, status, status_message, error_body)
    if retry_index >= state.options.max_retries || !provider_retry.should_retry(status, headers) {
        throw errorf('%s', provider_error)
    }
    int delay = provider_retry.delay_ms(headers, retry_index, state.options.max_retry_delay_ms, provider_error)
    provider_retry.sleep(stream.cancellation, delay)
    return send_with_retry(state, retry_index + 1)
}

pub fn send_once(ref<run_state_t> state): ref<client.response_t>! {
    debug.log('provider', 'pi-messages sending request')
    var request = client.new().post(endpoint(state.model)).timeout(state.options.timeout_ms).header('Content-Type', 'application/json').header('Accept', 'text/event-stream')
    if state.options.api_key == '' {
        throw errorf('No API key provided for provider "%s"', state.model.provider)
    }
    request.header('Authorization', 'Bearer ' + state.options.api_key)
    var headers = decorators.copilot_headers(state.context)
    for header in headers {
        request.header(header.name, header.value)
    }
    var attribution_headers = attribution.provider_attribution_headers(state.model, state.options.session_id)
    for header in attribution_headers {
        request.header(header.name, header.value)
    }
    request.content(state.body)
    request_headers.apply(request, state.model)
    return request.send()
}

pub fn endpoint(ref<types.model_t> model): string {
    string base = model.base_url
    for base.len() > 0 && base[base.len() - 1] == '/'.char() {
        base = base.slice(0, base.len() - 1)
    }
    return base + '/messages'
}

pub fn build_payload(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {
    {string:any} options_object = {}
    if options.max_tokens > 0 {
        options_object['maxTokens'] = options.max_tokens
    }
    if options.thinking_enabled && options.reasoning_effort != '' {
        options_object['reasoning'] = options.reasoning_effort
    } else if options.thinking_enabled {
        options_object['reasoning'] = 'high'
    }
    if options.cache_retention == 'long' {
        options_object['cacheRetention'] = 'long'
    }
    if options.session_id != '' {
        options_object['sessionId'] = options.session_id
    }
    {string:any} context_object = {}
    if context.system_prompt != '' {
        context_object['systemPrompt'] = context.system_prompt
    }
    [any] messages = []
    for message in context.messages {
        messages.push(message_json.encode(message))
    }
    context_object['messages'] = messages
    if context.tools.len() > 0 {
        // pi-messages has no strict/grammar surface; plain function tools.
        context_object['tools'] = openai_completions_request.convert_tools(context.tools, {}, false, false)
    }
    {string:any} payload = {}
    payload['model'] = model.id
    payload['context'] = context_object
    payload['options'] = options_object
    return json.serialize(payload)
}

pub fn response_headers(ref<client.response_t> response): [provider_retry.header_t] {
    [provider_retry.header_t] result = []
    for name, value in response.headers {
        result.push(provider_retry.header_t {name: name, value: value,})
    }
    return result
}

pub fn fail(ref<event_stream.assistant_stream_t> stream, ref<run_state_t> state, string message) {
    debug.log('provider', 'pi-messages terminal failure: ' + message)
    state.processor.output.stop_reason = stream.is_aborted() ? types.STOP_ABORTED : types.STOP_ERROR
    state.processor.output.error_message = message
    if !stream.is_aborted() {
        {string:any} details = {}
        details['provider'] = state.model.provider
        details['model'] = state.model.id
        details['url'] = endpoint(state.model)
        var diagnostic = diagnostics.create_assistant_message_diagnostic('pi_messages_response_failure', errorf('%s', message), details)
        diagnostics.append_assistant_message_diagnostic(state.processor.output, diagnostic)
    }
    var event = types.assistant_event_t {kind: types.EVENT_ERROR, reason: state.processor.output.stop_reason, error: state.processor.output,}
    stream.push(event) catch error {}
    stream.end() catch error {}
}

pub fn read_error_body(ref<client.response_t> response): string! {
    [u8] result = []
    [u8] scratch = vec<u8>.new(0, 4096)
    for result.len() < ERROR_BODY_LIMIT {
        int n = response.read(scratch) catch error {
            if provider_retry.is_clean_eof(error.msg()) {
                break
            }
            throw error
        }
        int allowed = ERROR_BODY_LIMIT - result.len()
        if n > allowed {
            n = allowed
        }
        result.append(scratch.slice(0, n))
    }
    response.close()
    return result as string
}
