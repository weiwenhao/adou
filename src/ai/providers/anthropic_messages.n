import adou.src.ai.models
import adou.src.ai.sse
import adou.src.ai.streaming_json
import adou.src.ai.types
import json

const SLOT_TEXT = 'text'
const SLOT_THINKING = 'thinking'
const SLOT_TOOL_CALL = 'toolCall'
type slot_t = struct {
    string kind
    int content_index
    ref<types.text_content_t> text = new types.text_content_t()
    ref<types.thinking_content_t> thinking = new types.thinking_content_t()
    ref<types.tool_call_t> tool_call = new types.tool_call_t()
}
type slot_map_t = map<int, slot_t>
type processor_t = struct {
    ref<types.model_t> model
    ref<types.assistant_message_t> output
    slot_map_t slots = {}
    bool started
    bool saw_message_start
    bool saw_message_stop
}

fn processor(ref<types.model_t> model, int timestamp): ref<processor_t> {
    var output = new types.assistant_message_t(api = model.api, provider = model.provider, model = model.id, timestamp = timestamp,)
    return new processor_t(model = model, output = output)
}

fn processor_t.start(&self): types.assistant_event_t! {
    if self.started {
        throw errorf('Anthropic Messages stream already started')
    }
    self.started = true
    return types.assistant_event_t {kind: types.EVENT_START, partial: self.output,}
}

fn processor_t.feed(&self, sse.event_t frame): [types.assistant_event_t]! {
    if !self.started {
        throw errorf('Anthropic Messages stream has not started')
    }
    if self.saw_message_stop {
        if frame.event == 'ping' {
            return []
        }
        throw errorf('Anthropic Messages stream received data after message_stop')
    }
    if frame.event == 'ping' {
        return []
    }
    if frame.event == 'error' {
        throw errorf('%s', stream_error(frame.data))
    }
    if !is_message_event(frame.event) {
        return []
    }
    var root = json.box_value(json.parse(frame.data))
    string event_type = required_string(root, 'type')
    [types.assistant_event_t] events = []
    if event_type == 'message_start' {
        self.saw_message_start = true
        var message = root.get('message')
        self.output.response_id = optional_string(message, 'id', '')
        var object = message.as_object()
        if object.contains('usage') && !object['usage'].is_null() {
            self.update_usage(object['usage'], true)
        }
    } else if event_type == 'content_block_start' {
        events = self.start_block(required_int(root, 'index'), root.get('content_block'), events)
    } else if event_type == 'content_block_delta' {
        events = self.update_block(required_int(root, 'index'), root.get('delta'), events)
    } else if event_type == 'content_block_stop' {
        events = self.stop_block(required_int(root, 'index'), events)
    } else if event_type == 'message_delta' {
        var delta = root.get('delta')
        string stop_reason = optional_string(delta, 'stop_reason', '')
        if stop_reason != '' {
            self.apply_stop_reason(stop_reason, delta)
        }
        var object = root.as_object()
        if object.contains('usage') && !object['usage'].is_null() {
            self.update_usage(object['usage'], false)
        }
    } else if event_type == 'message_stop' {
        self.saw_message_stop = true
    }
    return events
}

fn processor_t.finish(&self): types.assistant_event_t! {
    if self.saw_message_start && !self.saw_message_stop {
        throw errorf('Anthropic stream ended before message_stop')
    }
    if self.output.stop_reason == types.STOP_PENDING {
        throw errorf('Anthropic stream ended without a stop reason')
    }
    if self.output.stop_reason == types.STOP_ERROR {
        string message = self.output.error_message
        if message == '' {
            message = 'An unknown error occurred'
        }
        throw errorf('%s', message)
    }
    return types.assistant_event_t {kind: types.EVENT_DONE, reason: self.output.stop_reason, message: self.output,}
}

#local
fn processor_t.start_block(&self, int provider_index, ref<json.value_t> block, [types.assistant_event_t] events): [types.assistant_event_t]! {
    if self.slots.contains(provider_index) {
        throw errorf('Anthropic content block index %d already exists', provider_index)
    }
    var block_object = block.as_object()
    string block_type = required_string(block, 'type')
    if block_type == 'text' {
        var content = new types.text_content_t(text = optional_string(block, 'text', ''))
        types.content_t item = content
        self.output.content.push(item)
        int content_index = self.output.content.len() - 1
        self.slots[provider_index] = slot_t {kind: SLOT_TEXT, content_index: content_index, text: content,}
        events.push(update_event(types.EVENT_TEXT_START, content_index, '', '', self.output))
    } else if block_type == 'thinking' {
        var content = new types.thinking_content_t(thinking = optional_string(block, 'thinking', ''), thinking_signature = optional_string(block, 'signature', ''),)
        types.content_t item = content
        self.output.content.push(item)
        int content_index = self.output.content.len() - 1
        self.slots[provider_index] = slot_t {kind: SLOT_THINKING, content_index: content_index, thinking: content,}
        events.push(update_event(types.EVENT_THINKING_START, content_index, '', '', self.output))
    } else if block_type == 'redacted_thinking' {
        var content = new types.thinking_content_t(thinking = '[Reasoning redacted]', thinking_signature = required_string(block, 'data'), redacted = true,)
        types.content_t item = content
        self.output.content.push(item)
        int content_index = self.output.content.len() - 1
        self.slots[provider_index] = slot_t {kind: SLOT_THINKING, content_index: content_index, thinking: content,}
        events.push(update_event(types.EVENT_THINKING_START, content_index, '', '', self.output))
    } else if block_type == 'tool_use' {
        var content = new types.tool_call_t(id = required_string(block, 'id'), name = required_string(block, 'name'), partial_json = '',)
        // Anthropic includes an initial input object on tool_use blocks. Pi
        // keeps it on the tool call until input_json_delta events arrive.
        // Clone the value so the streamed output owns its arguments rather
        // than retaining a reference into the parsed SSE frame.
        if block_object.contains('input') && !block_object['input'].is_null() {
            content.arguments = json.parse(json.stringify(*block_object['input']))
        } else {
            content.arguments = json.parse('{}')
        }
        types.content_t item = content
        self.output.content.push(item)
        int content_index = self.output.content.len() - 1
        self.slots[provider_index] = slot_t {kind: SLOT_TOOL_CALL, content_index: content_index, tool_call: content,}
        events.push(update_event(types.EVENT_TOOLCALL_START, content_index, '', '', self.output))
    }
    return events
}

#local
fn processor_t.update_block(&self, int provider_index, ref<json.value_t> delta, [types.assistant_event_t] events): [types.assistant_event_t]! {
    if !self.slots.contains(provider_index) {
        return events
    }
    var slot = self.slots[provider_index]
    string delta_type = required_string(delta, 'type')
    if delta_type == 'text_delta' && slot.kind == SLOT_TEXT {
        string value = required_string(delta, 'text')
        slot.text.text += value
        events.push(update_event(types.EVENT_TEXT_DELTA, slot.content_index, value, '', self.output))
    } else if delta_type == 'thinking_delta' && slot.kind == SLOT_THINKING {
        string value = required_string(delta, 'thinking')
        slot.thinking.thinking += value
        events.push(update_event(types.EVENT_THINKING_DELTA, slot.content_index, value, '', self.output))
    } else if delta_type == 'signature_delta' && slot.kind == SLOT_THINKING {
        slot.thinking.thinking_signature += required_string(delta, 'signature')
    } else if delta_type == 'input_json_delta' && slot.kind == SLOT_TOOL_CALL {
        string value = required_string(delta, 'partial_json')
        slot.tool_call.partial_json += value
        slot.tool_call.arguments = streaming_json.parse(slot.tool_call.partial_json)
        events.push(update_event(types.EVENT_TOOLCALL_DELTA, slot.content_index, value, '', self.output))
    }
    return events
}

#local
fn processor_t.stop_block(&self, int provider_index, [types.assistant_event_t] events): [types.assistant_event_t]! {
    if !self.slots.contains(provider_index) {
        return events
    }
    var slot = self.slots[provider_index]
    if slot.kind == SLOT_TEXT {
        events.push(update_event(types.EVENT_TEXT_END, slot.content_index, '', slot.text.text, self.output))
    } else if slot.kind == SLOT_THINKING {
        events.push(update_event(types.EVENT_THINKING_END, slot.content_index, '', slot.thinking.thinking, self.output))
    } else if slot.kind == SLOT_TOOL_CALL {
        string arguments = slot.tool_call.partial_json
        if arguments == '' {
            arguments = '{}'
        }
        // The final input_json payload can still be incomplete. Pi repairs it
        // with the same incremental parser used for each input delta.
        slot.tool_call.arguments = streaming_json.parse(arguments)
        slot.tool_call.partial_json = ''
        var event = update_event(types.EVENT_TOOLCALL_END, slot.content_index, '', '', self.output)
        event.tool_call = slot.tool_call
        events.push(event)
    }
    self.slots.del(provider_index)
    return events
}

#local
fn processor_t.update_usage(&self, ref<json.value_t> usage, bool initial): void! {
    var object = usage.as_object()
    if object.contains('input_tokens') && !object['input_tokens'].is_null() {
        self.output.usage.input = object['input_tokens'].as_number().to_int()
    }
    if object.contains('output_tokens') && !object['output_tokens'].is_null() {
        self.output.usage.output = object['output_tokens'].as_number().to_int()
    }
    if object.contains('cache_read_input_tokens') && !object['cache_read_input_tokens'].is_null() {
        self.output.usage.cache_read = object['cache_read_input_tokens'].as_number().to_int()
    }
    if object.contains('cache_creation_input_tokens') && !object['cache_creation_input_tokens'].is_null() {
        self.output.usage.cache_write = object['cache_creation_input_tokens'].as_number().to_int()
    }
    if initial && object.contains('cache_creation') && !object['cache_creation'].is_null() {
        self.output.usage.cache_write_1h = optional_int(object['cache_creation'], 'ephemeral_1h_input_tokens', 0)
    }
    if object.contains('output_tokens_details') && !object['output_tokens_details'].is_null() {
        self.output.usage.reasoning = optional_int(object['output_tokens_details'], 'thinking_tokens', self.output.usage.reasoning)
    }
    self.output.usage.total_tokens = self.output.usage.input + self.output.usage.output + self.output.usage.cache_read + self.output.usage.cache_write
    self.output.usage = models.calculate_cost(self.model, self.output.usage)
}

#local
fn processor_t.apply_stop_reason(&self, string reason, ref<json.value_t> delta): void! {
    if reason == 'end_turn' || reason == 'pause_turn' || reason == 'stop_sequence' {
        self.output.stop_reason = types.STOP_STOP
    } else if reason == 'max_tokens' {
        self.output.stop_reason = types.STOP_LENGTH
    } else if reason == 'tool_use' {
        self.output.stop_reason = types.STOP_TOOL_USE
    } else if reason == 'refusal' {
        self.output.stop_reason = types.STOP_ERROR
        var object = delta.as_object()
        if object.contains('stop_details') && !object['stop_details'].is_null() {
            self.output.error_message = optional_string(object['stop_details'], 'explanation', 'The model refused to complete the request')
        } else {
            self.output.error_message = 'The model refused to complete the request'
        }
    } else if reason == 'sensitive' {
        self.output.stop_reason = types.STOP_ERROR
        self.output.error_message = 'Anthropic stopped because content was marked sensitive'
    } else {
        throw errorf('Unhandled stop reason: %s', reason)
    }
}

#local
fn update_event(string event_type, int content_index, string delta, string content, ref<types.assistant_message_t> partial): types.assistant_event_t {
    return types.assistant_event_t {kind: event_type, content_index: content_index, delta: delta, content: content, partial: partial,}
}

#local
fn is_message_event(string event): bool {
    return event == 'message_start' || event == 'message_delta' || event == 'message_stop' || event == 'content_block_start' || event == 'content_block_delta' || event == 'content_block_stop'
}

#local
fn stream_error(string data): string {
    var root = json.box_value(json.parse(data)) catch e {
        return data
    }
    var object = root.as_object() catch e {
        return data
    }
    if object.contains('error') && !object['error'].is_null() {
        var detail = object['error']
        string error_type = optional_string(detail, 'type', 'error') catch e {
            'error'
        }
        string message = optional_string(detail, 'message', data) catch e {
            data
        }
        return error_type + ': ' + message
    }
    return data
}

#local
fn required_string(ref<json.value_t> value, string key): string! {
    return value.get(key).as_string()
}

#local
fn optional_string(ref<json.value_t> value, string key, string fallback): string! {
    var object = value.as_object()
    if !object.contains(key) || object[key].is_null() {
        return fallback
    }
    return object[key].as_string()
}

#local
fn required_int(ref<json.value_t> value, string key): int! {
    return value.get(key).as_number().to_int()
}

#local
fn optional_int(ref<json.value_t> value, string key, int fallback): int! {
    var object = value.as_object()
    if !object.contains(key) || object[key].is_null() {
        return fallback
    }
    return object[key].as_number().to_int()
}
