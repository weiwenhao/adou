import adou.src.ai.deferred_tools
import adou.src.ai.constrained_sampling
import adou.src.ai.types
import adou.src.ai.providers.decorators
import adou.src.ai.ids
import adou.src.json_util
import adou.src.ai.providers.replay
import fmt
import json
import strings
import syscall


pub fn build(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {

    // B3: Pi createGrammarToolInputProperties — grammar-constrained tools
    // switch to OpenAI custom tool wire format for requests and replay.
    {string:string} grammar_props = {}
    if syscall.get_env('ADOU_GRAMMAR_TOOLS') == '1' {
        grammar_props = constrained_sampling.create_grammar_tool_input_properties(context.tools, model.compat.supports_openai_grammar_tools) catch e {{}}
    }
    {string:any} body = {}
    body['model'] = model.id
    body['messages'] = convert_messages(model, context, grammar_props)
    body['stream'] = true
    if options.temperature >= 0.0 {
        body['temperature'] = options.temperature
    }
    {string:any} stream_options = {}
    stream_options['include_usage'] = true
    body['stream_options'] = stream_options
    int output_tokens = options.max_tokens > 0 ? options.max_tokens : model.max_tokens
    if output_tokens > 0 {
        string max_tokens_field = model.compat.max_tokens_field
        if max_tokens_field == '' {
            max_tokens_field = 'max_completion_tokens'
        }
        body[max_tokens_field] = output_tokens
    }
    if context.tools.len() > 0 {
        // Kimi's deferredToolsMode keeps tools announced by addedToolNames
        // out of the request until their first tool result activates them.
        [ref<types.tool_t>] request_tools = context.tools
        if model.provider == 'kimi-coding' {
            request_tools = deferred_tools.filter_deferred_tools(context.tools, deferred_tools.deferred_tool_names(context.messages))
        }
        body['tools'] = convert_tools(request_tools, grammar_props, model.compat.supports_strict_mode, model.compat.supports_openai_grammar_tools)
    } else if has_tool_history(context) {
        // Pi keeps an explicit empty tools array when replaying tool history.
        // Some OpenAI-compatible gateways reject tool-call messages unless
        // the tools field is present, even when no tools are currently active.
        [any] empty_tools = []
        body['tools'] = empty_tools
    }
    if model.reasoning {
        // Nature maps are value-copied into function arguments; merge the
        // returned thinking fields here.
        var thinking_fields = thinking_fields_for(model, options)
        for key, value in thinking_fields {
            body[key] = value
        }
    }
    return json.serialize(body)
}

// Pi's openai-completions compat thinkingFormat variants: each provider
// family expects its own thinking shape, and the catalog thinkingLevelMap
// translates pi levels to provider values.  The format is detected at
// runtime (model_compat) and carried per model.
fn thinking_fields_for(ref<types.model_t> model, ref<types.stream_options_t> options): {string:any} {
    {string:any} fields = {}
    string format = model.compat.thinking_format
    if format == '' {
        format = 'openai'
    }
    if format == 'zai' {
        {string:any} thinking = {}
        if options.thinking_enabled && options.reasoning_effort != '' {
            thinking['type'] = 'enabled'
            thinking['clear_thinking'] = false
        } else {
            thinking['type'] = 'disabled'
        }
        fields['thinking'] = thinking
        if options.thinking_enabled && options.reasoning_effort != '' {
            fields['reasoning_effort'] = mapped_effort(model, options.reasoning_effort)
        }
    } else if format == 'qwen' {
        fields['enable_thinking'] = options.thinking_enabled && options.reasoning_effort != ''
    } else if format == 'deepseek' {
        {string:any} thinking = {}
        if options.thinking_enabled && options.reasoning_effort != '' {
            thinking['type'] = 'enabled'
            fields['reasoning_effort'] = mapped_effort(model, options.reasoning_effort)
        } else {
            thinking['type'] = 'disabled'
        }
        fields['thinking'] = thinking
    } else if format == 'openrouter' {
        {string:any} reasoning = {}
        if options.thinking_enabled && options.reasoning_effort != '' {
            reasoning['effort'] = mapped_effort(model, options.reasoning_effort)
        } else {
            string off_value = 'none'
            if model.thinking_level_map.contains('off') && model.thinking_level_map['off'] != '' {
                off_value = model.thinking_level_map['off']
            }
            reasoning['effort'] = off_value
        }
        fields['reasoning'] = reasoning
    } else if format == 'together' {
        {string:any} reasoning = {}
        reasoning['enabled'] = options.thinking_enabled && options.reasoning_effort != ''
        fields['reasoning'] = reasoning
        if options.thinking_enabled && options.reasoning_effort != '' {
            fields['reasoning_effort'] = mapped_effort(model, options.reasoning_effort)
        }
    } else if format == 'ant-ling' {
        if options.thinking_enabled && options.reasoning_effort != '' {
            {string:any} reasoning = {}
            reasoning['effort'] = mapped_effort(model, options.reasoning_effort)
            fields['reasoning'] = reasoning
        }
    } else {
        if options.thinking_enabled && options.reasoning_effort != '' {
            fields['reasoning_effort'] = mapped_effort(model, options.reasoning_effort)
        }
    }
    return fields
}

fn mapped_effort(ref<types.model_t> model, string level): string {
    if model.thinking_level_map.contains(level) {
        string mapped = model.thinking_level_map[level]
        if mapped != '' {
            return mapped
        }
    }
    return level
}

pub fn endpoint(ref<types.model_t> model): string {
    string base = decorators.resolve_base_url(model)
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    return base + '/chat/completions'
}

pub fn authorization(ref<types.stream_options_t> options): string! {
    if options.api_key == '' {
        throw errorf('No API key for provider: deepseek')
    }
    return 'Bearer ' + options.api_key
}

pub fn convert_messages(ref<types.model_t> model, ref<types.context_t> context, {string:string} grammar_props): [any]! {
    [any] result = []
    if context.system_prompt != '' {
        {string:any} system = {}
        system['role'] = 'system'
        system['content'] = context.system_prompt
        result.push(system)
    }
    var replay = replay.tracker()
    for message in context.messages {
        if message is ref<types.user_message_t> user {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(user_item(user))
        } else if message is ref<types.assistant_message_t> assistant {
            for missing in replay.before_assistant(assistant) {
                result.push(tool_result_item(model, missing))
            }
            // Pi's message transform removes failed/aborted turns before
            // constructing a new request.
            if assistant.stop_reason == types.STOP_ERROR || assistant.stop_reason == types.STOP_ABORTED {
                continue
            }
            var item = assistant_item(model, assistant, grammar_props)
            if !json_util.is_null(item) {
                result.push(item)
            }
        } else if message is ref<types.tool_result_message_t> tool_result {
            replay.observe_tool_result(tool_result.tool_call_id)
            result.push(tool_result_item(model, tool_result))
        } else if message is ref<types.compaction_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n' + summary.summary + '\n</summary>'))
        } else if message is ref<types.branch_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n' + summary.summary + '</summary>'))
        } else if message is ref<types.custom_message_t> custom {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', custom.content))
        } else if message is ref<types.bash_execution_message_t> bash {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            if !bash.exclude_from_context {
                result.push(message_item('user', types.bash_execution_text(bash)))
            }
        }
    }
    for missing in replay.finish() {
        result.push(tool_result_item(model, missing))
    }
    return result
}

pub fn message_item(string role, string content): any {
    {string:any} item = {}
    item['role'] = role
    item['content'] = content
    return item
}

fn user_item(ref<types.user_message_t> message): any {
    if message.images.len() == 0 {return message_item('user', message.content)}
    [any] blocks = []
    if message.content != '' {
        {string:any} text = {}
        text['type'] = 'text'
        text['text'] = message.content
        blocks.push(text)
    }
    for image in message.images {
        {string:any} image_url = {}
        image_url['url'] = 'data:' + image.mime_type + ';base64,' + image.data
        {string:any} block = {}
        block['type'] = 'image_url'
        block['image_url'] = image_url
        blocks.push(block)
    }
    {string:any} item = {}
    item['role'] = 'user'
    item['content'] = blocks
    return item
}

pub fn assistant_item(ref<types.model_t> model, ref<types.assistant_message_t> message, {string:string} grammar_props): any {
    string text = ''
    string reasoning = ''
    [any] calls = []
    for block in message.content {
        if block is ref<types.text_content_t> text_block {
            text += text_block.text
        } else if block is ref<types.thinking_content_t> thinking_block {
            reasoning += thinking_block.thinking
        } else if block is ref<types.tool_call_t> tool_call {
            calls.push(tool_call_item(model, tool_call, grammar_props) catch e {
                {string:any} empty = {}
                empty
            })
        }
    }
    if text == '' && reasoning == '' && calls.len() == 0 {
        return null
    }
    {string:any} item = {}
    item['role'] = 'assistant'
    if text != '' {
        item['content'] = text
    } else {
        item['content'] = null
    }
    if model.compat.requires_reasoning_content_on_assistant_messages {
        item['reasoning_content'] = reasoning
    }
    if calls.len() > 0 {
        item['tool_calls'] = calls
    }
    return item
}

fn tool_call_item(ref<types.model_t> model, ref<types.tool_call_t> call, {string:string} grammar_props): any! {
    // B3: grammar-constrained tools replay as OpenAI custom tool calls.
    if grammar_props.contains(call.name) {
        string property = grammar_props[call.name]
        var call_arguments = call.arguments as {string:any}
        string fallback_input = ''
        string input = constrained_sampling.get_grammar_tool_input(call.name, call_arguments, property) catch error {fallback_input}
        {string:any} custom = {}
        custom['name'] = call.name
        custom['input'] = input
        {string:any} item = {}
        item['id'] = normalize_tool_id(model, call.id)
        item['type'] = 'custom'
        item['custom'] = custom
        return item
    }
    {string:any} function = {}
    function['name'] = call.name
    function['arguments'] = json.serialize(call.arguments)
    {string:any} item = {}
    item['id'] = normalize_tool_id(model, call.id)
    item['type'] = 'function'
    item['function'] = function
    return item
}

pub fn tool_result_item(ref<types.model_t> model, ref<types.tool_result_message_t> message): any {
    [string] lines = []
    for block in message.content {
        lines.push(block.text)
    }
    string content = strings.join(lines, '\n')
    if content == '' {
        content = '(no tool output)'
    }
    {string:any} item = {}
    item['role'] = 'tool'
    item['tool_call_id'] = normalize_tool_id(model, message.tool_call_id)
    if message.images.len() == 0 {
        item['content'] = content
    } else {
        [any] blocks = []
        if content != '' {
            {string:any} text_block = {}
            text_block['type'] = 'text'
            text_block['text'] = content
            blocks.push(text_block)
        }
        for image in message.images {
            {string:any} image_url = {}
            image_url['url'] = 'data:' + image.mime_type + ';base64,' + image.data
            {string:any} image_block = {}
            image_block['type'] = 'image_url'
            image_block['image_url'] = image_url
            blocks.push(image_block)
        }
        item['content'] = blocks
    }
    return item
}

pub fn convert_tools([ref<types.tool_t>] tools, {string:string} grammar_props, bool supports_strict_mode, bool supports_grammar): [any]! {
    [any] result = []
    for tool in tools {
        // B3: Pi resolveGrammarConstrainedSampling — grammar variants become
        // custom tools with a lark/regex format definition.
        var parameter_object = tool.parameters as {string:any}
        ref<constrained_sampling.grammar_sampling_t>? none_value = null
        ref<constrained_sampling.grammar_sampling_t>? grammar = none_value
        if tool.constrained_sampling is {string:any} config {
            if syscall.get_env('ADOU_GSKIP') != '' {
                continue
            }
            grammar = constrained_sampling.resolve_grammar_sampling(tool.name, parameter_object, config, supports_grammar) catch error {none_value}
        }
        if grammar is ref<constrained_sampling.grammar_sampling_t> grammar_value {
            // B3: Pi resolveGrammarConstrainedSampling — grammar variants
            // become custom tools with a lark/regex format definition.
            {string:any} format = {}
            format['type'] = 'grammar'
            {string:any} grammar_body = {}
            grammar_body['syntax'] = grammar_value.format
            grammar_body['definition'] = grammar_value.definition
            format['grammar'] = grammar_body
            {string:any} custom = {}
            custom['name'] = tool.name
            custom['description'] = tool.description
            custom['format'] = format
            {string:any} item = {}
            item['type'] = 'custom'
            item['custom'] = custom
            result.push(item)
            continue
        }
        bool strict = false
        if tool.constrained_sampling is {string:any} strict_cfg {
            if strict_cfg.contains('type') && strict_cfg['type'] is string && (strict_cfg['type'] as string) == 'json_schema' {
                // Pi resolveJsonSchemaStrictSampling: strict on when the model
                // supports it; require without support throws.
                if supports_strict_mode {
                    strict = true
                } else if strict_cfg.contains('strict') && strict_cfg['strict'] is string && (strict_cfg['strict'] as string) == 'require' {
                    throw errorf('Tool "%s" requires JSON-schema constrained sampling, but strict tools are unsupported.', tool.name)
                }
            }
        }
        {string:any} function = {}
        function['name'] = tool.name
        function['description'] = tool.description
        function['parameters'] = tool.parameters
        function['strict'] = strict
        {string:any} item = {}
        item['type'] = 'function'
        item['function'] = function
        result.push(item)
    }
    return result
}

fn has_tool_history(ref<types.context_t> context): bool {
    for message in context.messages {
        if message is ref<types.tool_result_message_t> {
            return true
        }
        if message is ref<types.assistant_message_t> assistant {
            for block in assistant.content {
                if block is ref<types.tool_call_t> {
                    return true
                }
            }
        }
    }
    return false
}

pub fn normalize_tool_id(ref<types.model_t> model, string id): string {
    // Responses tool ids use `{call_id}|{item_id}` and may contain hundreds of
    // bytes. Chat Completions accepts at most 40 characters; retain item-level
    // uniqueness with a deterministic suffix when sanitizing would overflow.
    int separator = id.find('|')
    if separator >= 0 {
        string call_id = sanitize_tool_id(id.slice(0, separator))
        string item_id = sanitize_tool_id(id.slice(separator + 1, id.len()))
        string combined = item_id != '' ? call_id + '_' + item_id : call_id
        if combined.len() <= 40 {
            return combined
        }
        string hash = ids.short_hash(id)
        if hash.len() > 8 {
            hash = hash.slice(0, 8)
        }
        int prefix_length = 40 - hash.len() - 1
        if prefix_length < 1 {
            prefix_length = 1
        }
        if call_id.len() > prefix_length {
            call_id = call_id.slice(0, prefix_length)
        }
        return call_id + '_' + hash
    }
    // DeepSeek and other OpenAI-compatible providers accept their native IDs;
    // Pi only applies the 40-character Chat Completions cap to OpenAI IDs.
    if model.provider != 'openai' {
        return id
    }
    [u8] result = []
    for byte in id as [u8] {
        if result.len() >= 40 {
            break
        }
        bool allowed = byte >= 'a'.char() && byte <= 'z'.char()
        allowed = allowed || byte >= 'A'.char() && byte <= 'Z'.char()
        allowed = allowed || byte >= '0'.char() && byte <= '9'.char()
        allowed = allowed || byte == '_'.char() || byte == '-'.char()
        result.push(allowed ? byte : '_'.char())
    }
    return result as string
}

fn sanitize_tool_id(string id): string {
    [u8] result = []
    for byte in id as [u8] {
        bool allowed = byte >= 'a'.char() && byte <= 'z'.char()
        allowed = allowed || byte >= 'A'.char() && byte <= 'Z'.char()
        allowed = allowed || byte >= '0'.char() && byte <= '9'.char()
        allowed = allowed || byte == '_'.char() || byte == '-'.char()
        result.push(allowed ? byte : '_'.char())
    }
    return result as string
}
