import adou.src.ai.types
import adou.src.ai.providers.decorators
import adou.src.ai.ids
import adou.src.json_util
import adou.src.ai.providers.replay
import fmt
import json
import strings


fn build(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {
    {string:any} body = {}
    body['model'] = model.id
    body['messages'] = convert_messages(model, context)
    body['stream'] = true
    {string:any} stream_options = {}
    stream_options['include_usage'] = true
    body['stream_options'] = stream_options
    int output_tokens = options.max_tokens > 0 ? options.max_tokens : model.max_tokens
    if output_tokens > 0 {
        body['max_tokens'] = output_tokens
    }
    if context.tools.len() > 0 {
        body['tools'] = convert_tools(context.tools)
    } else if has_tool_history(context) {
        // Pi keeps an explicit empty tools array when replaying tool history.
        // Some OpenAI-compatible gateways reject tool-call messages unless
        // the tools field is present, even when no tools are currently active.
        [any] empty_tools = []
        body['tools'] = empty_tools
    }
    if model.reasoning {
        {string:any} thinking = {}
        thinking['type'] = options.thinking_enabled ? 'enabled' : 'disabled'
        body['thinking'] = thinking
        if options.thinking_enabled && options.reasoning_effort != '' {
            body['reasoning_effort'] = options.reasoning_effort
        }
    }
    return json.serialize(body)
}

fn endpoint(ref<types.model_t> model): string {
    string base = decorators.resolve_base_url(model)
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    return base + '/chat/completions'
}

fn authorization(ref<types.stream_options_t> options): string! {
    if options.api_key == '' {
        throw errorf('No API key for provider: deepseek')
    }
    return 'Bearer ' + options.api_key
}

#local
fn convert_messages(ref<types.model_t> model, ref<types.context_t> context): [any]! {
    [any] result = []
    if context.system_prompt != '' {
        {string:any} system = {}
        system['role'] = 'system'
        system['content'] = context.system_prompt
        result.push(system)
    }
    var replay = replay.tracker()
    for message in context.messages {
        if message is ref<types.user_message_t> user {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', user.content))
        } else if message is ref<types.assistant_message_t> assistant {
            for missing in replay.before_assistant(assistant) {
                result.push(tool_result_item(model, missing))
            }
            // Pi's message transform removes failed/aborted turns before
            // constructing a new request.
            if assistant.stop_reason == types.STOP_ERROR || assistant.stop_reason == types.STOP_ABORTED {
                continue
            }
            var item = assistant_item(model, assistant)
            if !json_util.is_null(item) {
                result.push(item)
            }
        } else if message is ref<types.tool_result_message_t> tool_result {
            replay.observe_tool_result(tool_result.tool_call_id)
            result.push(tool_result_item(model, tool_result))
        } else if message is ref<types.compaction_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n' + summary.summary + '\n</summary>'))
        } else if message is ref<types.branch_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n' + summary.summary + '</summary>'))
        } else if message is ref<types.custom_message_t> custom {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', custom.content))
        } else if message is ref<types.bash_execution_message_t> bash {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            if !bash.exclude_from_context {
                result.push(message_item('user', types.bash_execution_text(bash)))
            }
        }
    }
    for missing in replay.finish() {
        result.push(tool_result_item(model, missing))
    }
    return result
}

#local
fn message_item(string role, string content): any {
    {string:any} item = {}
    item['role'] = role
    item['content'] = content
    return item
}

#local
fn assistant_item(ref<types.model_t> model, ref<types.assistant_message_t> message): any {
    string text = ''
    string reasoning = ''
    [any] calls = []
    for block in message.content {
        if block is ref<types.text_content_t> text_block {
            text += text_block.text
        } else if block is ref<types.thinking_content_t> thinking_block {
            reasoning += thinking_block.thinking
        } else if block is ref<types.tool_call_t> tool_call {
            calls.push(tool_call_item(model, tool_call) catch e {
                {string:any} empty = {}
                empty
            })
        }
    }
    if text == '' && reasoning == '' && calls.len() == 0 {
        return null
    }
    {string:any} item = {}
    item['role'] = 'assistant'
    if text != '' {
        item['content'] = text
    } else {
        item['content'] = null
    }
    if model.reasoning {
        item['reasoning_content'] = reasoning
    }
    if calls.len() > 0 {
        item['tool_calls'] = calls
    }
    return item
}

#local
fn tool_call_item(ref<types.model_t> model, ref<types.tool_call_t> call): any! {
    {string:any} function = {}
    function['name'] = call.name
    function['arguments'] = json.serialize(call.arguments)
    {string:any} item = {}
    item['id'] = normalize_tool_id(model, call.id)
    item['type'] = 'function'
    item['function'] = function
    return item
}

#local
fn tool_result_item(ref<types.model_t> model, ref<types.tool_result_message_t> message): any {
    [string] lines = []
    for block in message.content {
        lines.push(block.text)
    }
    string content = strings.join(lines, '\n')
    if content == '' {
        content = '(no tool output)'
    }
    {string:any} item = {}
    item['role'] = 'tool'
    item['tool_call_id'] = normalize_tool_id(model, message.tool_call_id)
    item['content'] = content
    return item
}

#local
fn convert_tools([ref<types.tool_t>] tools): [any]! {
    [any] result = []
    for tool in tools {
        {string:any} function = {}
        function['name'] = tool.name
        function['description'] = tool.description
        function['parameters'] = tool.parameters
        function['strict'] = false
        {string:any} item = {}
        item['type'] = 'function'
        item['function'] = function
        result.push(item)
    }
    return result
}

#local
fn has_tool_history(ref<types.context_t> context): bool {
    for message in context.messages {
        if message is ref<types.tool_result_message_t> {
            return true
        }
        if message is ref<types.assistant_message_t> assistant {
            for block in assistant.content {
                if block is ref<types.tool_call_t> {
                    return true
                }
            }
        }
    }
    return false
}

#local
fn normalize_tool_id(ref<types.model_t> model, string id): string {
    // Responses tool ids use `{call_id}|{item_id}` and may contain hundreds of
    // bytes. Chat Completions accepts at most 40 characters; retain item-level
    // uniqueness with a deterministic suffix when sanitizing would overflow.
    int separator = id.find('|')
    if separator >= 0 {
        string call_id = sanitize_tool_id(id.slice(0, separator))
        string item_id = sanitize_tool_id(id.slice(separator + 1, id.len()))
        string combined = item_id != '' ? call_id + '_' + item_id : call_id
        if combined.len() <= 40 {
            return combined
        }
        string hash = ids.short_hash(id)
        if hash.len() > 8 {
            hash = hash.slice(0, 8)
        }
        int prefix_length = 40 - hash.len() - 1
        if prefix_length < 1 {
            prefix_length = 1
        }
        if call_id.len() > prefix_length {
            call_id = call_id.slice(0, prefix_length)
        }
        return call_id + '_' + hash
    }
    // DeepSeek and other OpenAI-compatible providers accept their native IDs;
    // Pi only applies the 40-character Chat Completions cap to OpenAI IDs.
    if model.provider != 'openai' {
        return id
    }
    [u8] result = []
    for byte in id as [u8] {
        if result.len() >= 40 {
            break
        }
        bool allowed = byte >= 'a'.char() && byte <= 'z'.char()
        allowed = allowed || byte >= 'A'.char() && byte <= 'Z'.char()
        allowed = allowed || byte >= '0'.char() && byte <= '9'.char()
        allowed = allowed || byte == '_'.char() || byte == '-'.char()
        result.push(allowed ? byte : '_'.char())
    }
    return result as string
}

#local
fn sanitize_tool_id(string id): string {
    [u8] result = []
    for byte in id as [u8] {
        bool allowed = byte >= 'a'.char() && byte <= 'z'.char()
        allowed = allowed || byte >= 'A'.char() && byte <= 'Z'.char()
        allowed = allowed || byte >= '0'.char() && byte <= '9'.char()
        allowed = allowed || byte == '_'.char() || byte == '-'.char()
        result.push(allowed ? byte : '_'.char())
    }
    return result as string
}
