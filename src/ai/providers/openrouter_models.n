    result.push(model_builder.build('~x-ai/grok-latest', 'xAI: Grok Latest', 'openai-completions', 'openrouter', 'https://openrouter.ai/api/v1', true, 500000, 4096, 2.0, 6.0, 0.3, 0.0, []))
    return result
}
