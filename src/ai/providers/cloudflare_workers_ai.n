// Provider definition for Cloudflare Workers AI.
// Metadata follows vendors/pi/packages/ai/src/providers/cloudflare-workers-ai.ts.
import adou.src.ai.providers.cloudflare_workers_ai_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'cloudflare-workers-ai', name: 'Cloudflare Workers AI', api: 'openai-completions', base_url: 'https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1', env_vars: ['CLOUDFLARE_API_KEY', 'CLOUDFLARE_ACCOUNT_ID'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return cloudflare_workers_ai_models.models()
}
