import adou.src.ai.models
import adou.src.ai.sse
import adou.src.ai.streaming_json
import adou.src.ai.types
import adou.src.json_util
import strings

pub const SLOT_TEXT = 'text'
pub const SLOT_THINKING = 'thinking'
pub const SLOT_TOOL_CALL = 'toolCall'

pub type slot_t = struct {
    string kind
    int content_index
    ref<types.text_content_t> text = new types.text_content_t()
    ref<types.thinking_content_t> thinking = new types.thinking_content_t()
    ref<types.tool_call_t> tool_call = new types.tool_call_t()
}

// Mistral chat stream processor: CompletionChunk events arrive over the same
// SSE framing as OpenAI completions, but delta.content may be a string, an
// array of content chunks, or include {type:"thinking", thinking:[{text}]}
// blocks, and tool calls carry index-keyed ids.
pub type processor_t = struct {
    ref<types.model_t> model
    ref<types.assistant_message_t> output
    map<int, slot_t> slots = {}
    int text_index = -1
    int thinking_index = -1
    bool started
    bool saw_finish_reason
    bool saw_terminal
}

pub fn processor(ref<types.model_t> model, int timestamp): ref<processor_t> {
    var output = new types.assistant_message_t(api = 'mistral-conversations', provider = model.provider, model = model.id, timestamp = timestamp,)
    return new processor_t(model = model, output = output)
}

pub fn processor_t.start(&self): types.assistant_event_t! {
    if self.started {
        throw errorf('Mistral stream already started')
    }
    self.started = true
    return types.assistant_event_t {kind: types.EVENT_START, partial: self.output,}
}

pub fn processor_t.feed(&self, sse.event_t frame): [types.assistant_event_t]! {
    if !self.started {
        throw errorf('Mistral stream has not started')
    }
    if self.saw_terminal {
        throw errorf('Mistral stream received data after terminal event')
    }
    if frame.data == '[DONE]' {
        return []
    }
    var root = json_util.parse(frame.data)
    if !json_util.is_obj(root) {
        return []
    }
    var root_object = root as {string:any}
    [types.assistant_event_t] events = []
    if root_object.contains('id') && !json_util.is_null(root_object['id']) {
        string id = root_object['id'] as string
        self.output.response_id = id
    }
    if root_object.contains('usage') && !json_util.is_null(root_object['usage']) {
        self.update_usage(root_object['usage'])
    }
    if !root_object.contains('choices') || json_util.is_null(root_object['choices']) {
        return events
    }
    var choices = root_object['choices'] as [any]
    if choices.len() == 0 {
        return events
    }
    var choice = choices[0]
    var choice_object = choice as {string:any}
    if choice_object.contains('finish_reason') && !json_util.is_null(choice_object['finish_reason']) {
        self.apply_finish_reason(choice_object['finish_reason'] as string)
    }
    if !choice_object.contains('delta') || json_util.is_null(choice_object['delta']) {
        return events
    }
    var delta = choice_object['delta']
    var delta_object = delta as {string:any}
    if delta_object.contains('content') && !json_util.is_null(delta_object['content']) {
        if delta_object['content'] is string {
            string text = delta_object['content'] as string
            if text != '' {
                events = self.append_text(text, events)
            }
        } else if delta_object['content'] is [any] {
            for item in delta_object['content'] as [any] {
                if item is string {
                    string text = item as string
                    if text != '' {
                        events = self.append_text(text, events)
                    }
                } else if item is {string:any} {
                    var block = item as {string:any}
                    string block_type = opt_string(block, 'type')
                    if block_type == 'thinking' {
                        string thinking_text = extract_thinking(block)
                        if thinking_text != '' {
                            events = self.append_thinking(thinking_text, events)
                        }
                    } else if block_type == 'text' {
                        string text = opt_string(block, 'text')
                        if text != '' {
                            events = self.append_text(text, events)
                        }
                    }
                }
            }
        }
    }
    if delta_object.contains('tool_calls') && !json_util.is_null(delta_object['tool_calls']) {
        for call in delta_object['tool_calls'] as [any] {
            events = self.append_tool_call(call, events)
        }
    }
    return events
}

pub fn processor_t.finish(&self): [types.assistant_event_t]! {
    if self.saw_terminal {
        throw errorf('Mistral stream already finished')
    }
    if !self.saw_finish_reason {
        throw errorf('Mistral stream ended without finish_reason')
    }
    [types.assistant_event_t] events = []
    for content_index, block in self.output.content {
        if block is ref<types.text_content_t> text {
            events.push(update_event(types.EVENT_TEXT_END, content_index, '', text.text, self.output))
        } else if block is ref<types.thinking_content_t> thinking {
            events.push(update_event(types.EVENT_THINKING_END, content_index, '', thinking.thinking, self.output))
        } else if block is ref<types.tool_call_t> {
            int slot_index = self.slot_for_content_index(content_index)
            if slot_index >= 0 {
                events = self.finish_slot(slot_index, events)
            }
        }
    }
    self.saw_terminal = true
    if self.output.stop_reason == types.STOP_STOP && self.has_tool_call() {
        self.output.stop_reason = types.STOP_TOOL_USE
    }
    self.output.usage = models.calculate_cost(self.model, self.output.usage)
    events.push(types.assistant_event_t {kind: types.EVENT_DONE, reason: self.output.stop_reason, message: self.output,})
    return events
}

pub fn processor_t.append_text(&self, string value, [types.assistant_event_t] events): [types.assistant_event_t] {
    ref<types.text_content_t>? text = self.find_text()
    int index = -1
    if text is ref<types.text_content_t> existing {
        index = self.content_index(existing)
        existing.text += value
    } else {
        var block = new types.text_content_t(text = value)
        types.content_t content = block
        self.output.content.push(content)
        index = self.output.content.len() - 1
        self.text_index = index
        events.push(update_event(types.EVENT_TEXT_START, index, '', '', self.output))
    }
    events.push(update_event(types.EVENT_TEXT_DELTA, index, value, '', self.output))
    return events
}

pub fn processor_t.append_thinking(&self, string value, [types.assistant_event_t] events): [types.assistant_event_t] {
    ref<types.thinking_content_t>? thinking = self.find_thinking()
    int index = -1
    if thinking is ref<types.thinking_content_t> existing {
        index = self.content_index_thinking(existing)
        existing.thinking += value
    } else {
        var block = new types.thinking_content_t(thinking_signature = 'thinking', thinking = value)
        types.content_t content = block
        self.output.content.push(content)
        index = self.output.content.len() - 1
        self.thinking_index = index
        events.push(update_event(types.EVENT_THINKING_START, index, '', '', self.output))
    }
    events.push(update_event(types.EVENT_THINKING_DELTA, index, value, '', self.output))
    return events
}

pub fn processor_t.append_tool_call(&self, any call, [types.assistant_event_t] events): [types.assistant_event_t]! {
    var call_object = call as {string:any}
    int index = -1
    if call_object.contains('index') && !json_util.is_null(call_object['index']) {
        if call_object['index'] is int {
            index = call_object['index'] as int
        } else {
            index = (call_object['index'] as f64) as int
        }
    } else {
        index = 0
    }
    ref<types.tool_call_t>? existing = null
    if self.slots.contains(index) {
        var slot = self.slots[index]
        if slot.kind == SLOT_TOOL_CALL {
            existing = slot.tool_call
        }
    }
    if !(existing is ref<types.tool_call_t>) {
        var block = new types.tool_call_t()
        types.content_t content = block
        self.output.content.push(content)
        int content_index = self.output.content.len() - 1
        self.slots[index] = slot_t {kind: SLOT_TOOL_CALL, content_index: content_index, tool_call: block,}
        events.push(update_event(types.EVENT_TOOLCALL_START, content_index, '', '', self.output))
        existing = block
    }
    var slot = self.slots[index]
    if call_object.contains('id') && !json_util.is_null(call_object['id']) {
        string id = call_object['id'] as string
        if id != 'null' {
            slot.tool_call.id = id
        }
    }
    if call_object.contains('function') && !json_util.is_null(call_object['function']) {
        var function = call_object['function'] as {string:any}
        if function.contains('name') && !json_util.is_null(function['name']) {
            string name = function['name'] as string
            slot.tool_call.name = name
        }
        if function.contains('arguments') && !json_util.is_null(function['arguments']) {
            string delta = function['arguments'] as string
            slot.tool_call.partial_json += delta
            slot.tool_call.arguments = streaming_json.parse(slot.tool_call.partial_json)
            events.push(update_event(types.EVENT_TOOLCALL_DELTA, slot.content_index, delta, '', self.output))
        }
    }
    return events
}

pub fn processor_t.finish_slot(&self, int index, [types.assistant_event_t] events): [types.assistant_event_t]! {
    var slot = self.slots[index]
    if slot.kind == SLOT_TEXT {
        events.push(update_event(types.EVENT_TEXT_END, slot.content_index, '', slot.text.text, self.output))
    } else if slot.kind == SLOT_THINKING {
        events.push(update_event(types.EVENT_THINKING_END, slot.content_index, '', slot.thinking.thinking, self.output))
    } else if slot.kind == SLOT_TOOL_CALL {
        var event = update_event(types.EVENT_TOOLCALL_END, slot.content_index, '', '', self.output)
        event.tool_call = slot.tool_call
        events.push(event)
    }
    return events
}

pub fn processor_t.slot_for_content_index(&self, int content_index): int {
    for index, slot in self.slots {
        if slot.content_index == content_index {
            return index
        }
    }
    return -1
}

pub fn processor_t.update_usage(&self, any value): void! {
    var object = value as {string:any}
    int input = optional_int(object, 'prompt_tokens', 0)
    int output = optional_int(object, 'completion_tokens', 0)
    int cache_read = cached_tokens(object, input)
    int uncached = input - cache_read
    if uncached < 0 {
        uncached = 0
    }
    self.output.usage.input = uncached
    self.output.usage.output = output
    self.output.usage.cache_read = cache_read
    self.output.usage.cache_write = 0
    int total = optional_int(object, 'total_tokens', 0)
    if total <= 0 {
        total = uncached + cache_read + output
    }
    self.output.usage.total_tokens = total
}

pub fn processor_t.apply_finish_reason(&self, string reason): void! {
    self.saw_finish_reason = true
    if reason == 'stop' {
        self.output.stop_reason = types.STOP_STOP
    } else if reason == 'length' || reason == 'model_length' {
        self.output.stop_reason = types.STOP_LENGTH
    } else if reason == 'tool_calls' {
        self.output.stop_reason = types.STOP_TOOL_USE
    } else if reason == 'error' {
        self.output.stop_reason = types.STOP_ERROR
        self.output.error_message = 'Mistral finish_reason: ' + reason
    } else {
        self.output.stop_reason = types.STOP_STOP
    }
}

pub fn processor_t.has_tool_call(&self): bool {
    for block in self.output.content {
        if block is ref<types.tool_call_t> {
            return true
        }
    }
    return false
}

pub fn processor_t.find_text(&self): ref<types.text_content_t>? {
    for block in self.output.content {
        if block is ref<types.text_content_t> text {
            return text
        }
    }
    return null
}

pub fn processor_t.find_thinking(&self): ref<types.thinking_content_t>? {
    for block in self.output.content {
        if block is ref<types.thinking_content_t> thinking {
            return thinking
        }
    }
    return null
}

pub fn processor_t.content_index(&self, ref<types.text_content_t> target): int {
    for index, block in self.output.content {
        if block is ref<types.text_content_t> {
            return index
        }
    }
    return -1
}

pub fn processor_t.content_index_thinking(&self, ref<types.thinking_content_t> target): int {
    for index, block in self.output.content {
        if block is ref<types.thinking_content_t> {
            return index
        }
    }
    return -1
}

#local
fn extract_thinking({string:any} block): string {
    if !block.contains('thinking') || json_util.is_null(block['thinking']) {
        return ''
    }
    string result = ''
    if block['thinking'] is [any] {
        for part in block['thinking'] as [any] {
            if part is {string:any} {
                var part_object = part as {string:any}
                if part_object.contains('text') && part_object['text'] is string {
                    result += part_object['text'] as string
                }
            }
        }
    } else if block['thinking'] is string {
        result = block['thinking'] as string
    }
    return result
}

pub fn cached_tokens({string:any} object, int prompt_tokens): int {
    [string] keys = ['promptTokensDetails', 'prompt_tokens_details', 'promptTokenDetails', 'prompt_token_details', 'numCachedTokens', 'num_cached_tokens']
    for key in keys {
        if object.contains(key) && !json_util.is_null(object[key]) {
            if object[key] is {string:any} {
                var details = object[key] as {string:any}
                int found = optional_int(details, 'cachedTokens', -1)
                if found < 0 {
                    found = optional_int(details, 'cached_tokens', -1)
                }
                if found >= 0 {
                    if found > prompt_tokens {
                        found = prompt_tokens
                    }
                    return found
                }
            } else {
                int found = optional_int(object, key, 0)
                if found > prompt_tokens {
                    found = prompt_tokens
                }
                return found
            }
        }
    }
    return 0
}

pub fn optional_int({string:any} object, string key, int fallback): int {
    if !object.contains(key) || json_util.is_null(object[key]) {
        return fallback
    }
    if object[key] is int {
        return object[key] as int
    }
    return (object[key] as f64) as int
}

pub fn opt_string({string:any} object, string key): string {
    if object.contains(key) && object[key] is string {
        return object[key] as string
    }
    return ''
}

pub fn update_event(string kind, int content_index, string delta, string content, ref<types.assistant_message_t> partial): types.assistant_event_t {
    return types.assistant_event_t {kind: kind, content_index: content_index, delta: delta, content: content, partial: partial,}
}
