// Provider definition for Z.AI.
// Metadata follows vendors/pi/packages/ai/src/providers/zai.ts.
import adou.src.ai.providers.zai_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'zai', name: 'Z.AI', api: 'openai-completions', base_url: 'https://api.z.ai/api/coding/paas/v4', env_vars: ['ZAI_API_KEY'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return zai_models.models()
}
