// Provider definition for Moonshot AI.
// Metadata follows vendors/pi/packages/ai/src/providers/moonshotai.ts.
import adou.src.ai.providers.moonshotai_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'moonshotai', name: 'Moonshot AI', api: 'openai-completions', base_url: 'https://api.moonshot.ai/v1', env_vars: ['MOONSHOT_API_KEY'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return moonshotai_models.models()
}
