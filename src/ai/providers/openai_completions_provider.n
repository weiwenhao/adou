import adou.src.ai.abort
import adou.src.ai.attribution
import adou.src.ai.event_stream
import adou.src.ai.provider_retry
import adou.src.ai.providers.decorators
import adou.src.ai.providers.openai_completions
import adou.src.ai.providers.openai_completions_request
import adou.src.ai.sse
import adou.src.ai.types
import adou.src.debug
import fmt
import http.client
import time

pub const ERROR_BODY_LIMIT = 64 * 1024

pub type run_state_t = struct {
    ref<event_stream.assistant_stream_t> stream
    ref<types.model_t> model
    ref<types.context_t> context
    ref<types.stream_options_t> options
    ref<openai_completions.processor_t> processor
    string body
    ref<client.response_t>? response = null
}

pub fn stream(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): ref<event_stream.assistant_stream_t> {
    var result = event_stream.new()
    go run(result, model, context, options)
    return result
}

pub fn run(ref<event_stream.assistant_stream_t> stream, ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): void! {
    debug.log('provider', 'openai-completions stream start model=' + model.id)
    var processor = openai_completions.processor(model, time.now().ms_timestamp())
    var state = new run_state_t(stream = stream, model = model, context = context, options = options, processor = processor,)
    run_inner(stream, state) catch error {
        debug.log('provider', 'openai-completions stream failure: ' + error.msg())
        fail(stream, state, error.msg())
    }
}

pub fn run_inner(ref<event_stream.assistant_stream_t> stream, ref<run_state_t> state): void! {
    if stream.is_aborted() {
        throw errorf('Operation aborted')
    }
    state.body = openai_completions_request.build(state.model, state.context, state.options)
    var current = send_with_retry(state, 0)
    debug.log('provider', 'openai-completions response status=' + fmt.sprintf('%d', current.status))
    stream.push(state.processor.start())
    var decoder = sse.parser()
    [u8] scratch = vec<u8>.new(0, 8192)
    bool saw_done = false
    for true {
        debug.log('provider', 'openai-completions read begin')
        int n = current.read(scratch) catch error {
            if provider_retry.is_clean_eof(error.msg()) {
                break
            }
            throw error
        }
        debug.log('provider', 'openai-completions read bytes=' + fmt.sprintf('%d', n))
        var frames = decoder.feed(scratch.slice(0, n))
        saw_done = push_frames(stream, state.processor, frames)
        // OpenAI-compatible SSE streams are complete at the protocol-level
        // `[DONE]` record. Do not perform another transport read: on some
        // Nature HTTP connection implementations the peer close that follows
        // `[DONE]` can race the coroutine and corrupt an interface dispatch.
        if saw_done {
            debug.log('provider', 'openai-completions received [DONE]')
            break
        }
    }
    if !saw_done {
        var pending = decoder.finish_pending()
        push_frames(stream, state.processor, pending)
    }
    var done = state.processor.finish()
    for event in done {
        stream.push(event)
    }
    stream.end()
    debug.log('provider', 'openai-completions stream end')
}

pub fn push_frames(ref<event_stream.assistant_stream_t> stream, ref<openai_completions.processor_t> processor, [sse.event_t] frames): bool! {
    bool saw_done = false
    for frame in frames {
        if frame.data == '[DONE]' {
            saw_done = true
        }
        var events = processor.feed(frame)
        for event in events {
            stream.push(event)
        }
    }
    return saw_done
}

pub fn send_with_retry(ref<run_state_t> state, int retry_index): ref<client.response_t>! {
    var stream = state.stream
    if stream.is_aborted() {
        throw errorf('Request aborted')
    }
    var current = send_once(state) catch error {
        debug.log('provider', 'openai-completions request attempt failed: ' + error.msg())
        if stream.is_aborted() || retry_index >= state.options.max_retries {
            throw error
        }
        provider_retry.sleep(stream.cancellation, provider_retry.exponential_delay_ms(retry_index))
        return send_with_retry(state, retry_index + 1)
    }
    state.response = current
    abort.abort_callback_t close_response = fn () {
        current.close()
    }
    stream.cancellation.on_abort(close_response)
    if stream.is_aborted() {
        current.close()
        throw errorf('Request aborted')
    }
    if current.status >= 200 && current.status < 300 {
        debug.log('provider', 'openai-completions request accepted status=' + fmt.sprintf('%d', current.status))
        return current
    }
    int status = current.status
    string status_message = current.message
    var headers = response_headers(current)
    string error_body = read_error_body(current)
    string provider_error = fmt.sprintf('%s API error: HTTP %d %s: %s', state.model.provider, status, status_message, provider_retry.truncate_error_text(error_body, provider_retry.MAX_PROVIDER_ERROR_BODY_CHARS))
    if retry_index >= state.options.max_retries || !provider_retry.should_retry(status, headers) {
        throw errorf('%s', provider_error)
    }
    int delay = provider_retry.delay_ms(headers, retry_index, state.options.max_retry_delay_ms, provider_error)
    provider_retry.sleep(stream.cancellation, delay)
    return send_with_retry(state, retry_index + 1)
}

pub fn send_once(ref<run_state_t> state): ref<client.response_t>! {
    debug.log('provider', 'openai-completions sending request')
    var request = client.new().post(openai_completions_request.endpoint(state.model)).timeout(state.options.timeout_ms).header('Content-Type', 'application/json').header('Accept', 'text/event-stream')
    if decorators.is_cloudflare_gateway(state.model) {
        request.header(decorators.cloudflare_gateway_auth_header(state.options.api_key).name, decorators.cloudflare_gateway_auth_header(state.options.api_key).value)
    } else {
        request.header('Authorization', openai_completions_request.authorization(state.options))
    }
    var headers = decorators.copilot_headers(state.context)
    for header in headers {
        request.header(header.name, header.value)
    }
    var attribution = attribution.provider_attribution_headers(state.model, state.options.session_id)
    for header in attribution {
        request.header(header.name, header.value)
    }
    request.content(state.body)
    return request.send()
}

pub fn response_headers(ref<client.response_t> response): [provider_retry.header_t] {
    [provider_retry.header_t] result = []
    for name, value in response.headers {
        result.push(provider_retry.header_t {name: name, value: value,})
    }
    return result
}

pub fn fail(ref<event_stream.assistant_stream_t> stream, ref<run_state_t> state, string message) {
    debug.log('provider', 'openai-completions terminal failure: ' + message)
    // A failed streaming read has already transitioned Nature's HTTP
    // response/connection into its terminal state. Calling response.close()
    // again can dispatch through a corrupted connable interface on the
    // runtime and raise SIGBUS; the read failure owns transport cleanup.
    state.processor.output.stop_reason = stream.is_aborted() ? types.STOP_ABORTED : types.STOP_ERROR
    state.processor.output.error_message = message
    clear_streaming_scratch(state.processor.output)
    var event = types.assistant_event_t {kind: types.EVENT_ERROR, reason: state.processor.output.stop_reason, error: state.processor.output,}
    stream.push(event) catch error {}
    stream.end() catch error {}
}

pub fn read_error_body(ref<client.response_t> response): string! {
    [u8] result = []
    [u8] scratch = vec<u8>.new(0, 4096)
    for result.len() < ERROR_BODY_LIMIT {
        int n = response.read(scratch) catch error {
            if provider_retry.is_clean_eof(error.msg()) {
                break
            }
            throw error
        }
        int allowed = ERROR_BODY_LIMIT - result.len()
        if n > allowed {
            n = allowed
        }
        result.append(scratch.slice(0, n))
    }
    response.close()
    return result as string
}

pub fn clear_streaming_scratch(ref<types.assistant_message_t> message) {
    for block in message.content {
        if block is ref<types.tool_call_t> tool_call {
            tool_call.partial_json = ''
        }
    }
}
