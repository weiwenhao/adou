import adou.src.ai.types
import adou.src.ai.providers.decorators
import adou.src.ai.providers.replay
import adou.src.json_util
import fmt
import json
import strings
pub const ANTHROPIC_VERSION = '2023-06-01'
pub const INTERLEAVED_THINKING_BETA = 'interleaved-thinking-2025-05-14'
pub const FINE_GRAINED_TOOL_STREAMING_BETA = 'fine-grained-tool-streaming-2025-05-14'

pub fn build(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {
    {string:any} body = {}
    body['model'] = model.id
    body['messages'] = convert_messages(context.messages, cache_control(model, options))
    body['max_tokens'] = max_tokens(model, options)
    body['stream'] = true
    var cache = cache_control(model, options)
    if context.system_prompt != '' {
        {string:any} block = {}
        block['type'] = 'text'
        block['text'] = context.system_prompt
        block = attach_cache(block, cache)
        [any] system = []
        system.push(block)
        body['system'] = system
    }
    if context.tools.len() > 0 {
        body['tools'] = convert_tools(context.tools, cache, model.supports_eager_tool_streaming)
    }
    if model.reasoning {
        {string:any} thinking = {}
        if options.thinking_enabled {
            if model.adaptive_thinking {
                thinking['type'] = 'adaptive'
                thinking['display'] = options.thinking_display
                if options.reasoning_effort != '' {
                    {string:any} output_config = {}
                    output_config['effort'] = options.reasoning_effort
                    body['output_config'] = output_config
                }
            } else {
                thinking['type'] = 'enabled'
                thinking['budget_tokens'] = thinking_budget(options)
                thinking['display'] = options.thinking_display
            }
        } else {
            thinking['type'] = 'disabled'
        }
        body['thinking'] = thinking
    }
    return json.serialize(body)
}

pub fn endpoint(ref<types.model_t> model): string {
    string base = decorators.resolve_base_url(model)
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    return base + '/messages'
}

pub fn api_key(ref<types.stream_options_t> options): string! {
    if options.api_key == '' {
        throw errorf('No API key for provider: anthropic')
    }
    return options.api_key
}

pub fn beta_header(ref<types.model_t> model, ref<types.context_t> context): string {
    [string] features = []
    if model.reasoning && !model.adaptive_thinking {
        features.push(INTERLEAVED_THINKING_BETA)
    }
    if context.tools.len() > 0 && !model.supports_eager_tool_streaming {
        features.push(FINE_GRAINED_TOOL_STREAMING_BETA)
    }
    return strings.join(features, ',')
}

pub fn max_tokens(ref<types.model_t> model, ref<types.stream_options_t> options): int {
    if options.max_tokens > 0 {
        return options.max_tokens
    }
    return model.max_tokens
}

#local
fn thinking_budget(ref<types.stream_options_t> options): int {
    if options.thinking_budget_tokens > 0 {
        return options.thinking_budget_tokens
    }
    return 1024
}

#local
fn cache_control(ref<types.model_t> model, ref<types.stream_options_t> options): any {
    if options.cache_retention == 'none' {
        return null
    }
    {string:any} cache = {}
    cache['type'] = 'ephemeral'
    if options.cache_retention == 'long' && model.supports_long_cache_retention {
        cache['ttl'] = '1h'
    }
    return cache
}

#local
fn attach_cache({string:any} target, any cache): {string:any} {
    if !json_util.is_null(cache) {
        target['cache_control'] = cache
    }
    return target
}

pub fn convert_messages([types.message_t] messages, any cache): [any]! {
    [any] result = []
    [any] pending_tool_results = []
    var replay = replay.tracker()
    for message in messages {
        if message is ref<types.tool_result_message_t> tool_result {
            replay.observe_tool_result(tool_result.tool_call_id)
            pending_tool_results.push(tool_result_block(tool_result))
            continue
        }
        [ref<types.tool_result_message_t>] missing = []
        if message is ref<types.assistant_message_t> assistant_for_replay {
            missing = replay.before_assistant(assistant_for_replay)
        } else {
            missing = replay.before_other()
        }
        for item in missing {
            pending_tool_results.push(tool_result_block(item))
        }
        if pending_tool_results.len() > 0 {
            result.push(message_item('user', pending_tool_results))
            pending_tool_results = []
        }
        if message is ref<types.user_message_t> user {
            if user.content != '' {
                {string:any} text = {}
                text['type'] = 'text'
                text['text'] = user.content
                [any] content = []
                content.push(text)
                result.push(message_item('user', content))
            }
        } else if message is ref<types.assistant_message_t> assistant {
            // Pi drops failed/aborted assistant turns before provider-specific
            // message conversion so incomplete thinking/tool blocks are not
            // replayed into the next request.
            if assistant.stop_reason == types.STOP_ERROR || assistant.stop_reason == types.STOP_ABORTED {
                continue
            }
            var blocks = assistant_blocks(assistant)
            if blocks.len() > 0 {
                result.push(message_item('assistant', blocks))
            }
        } else if message is ref<types.compaction_summary_message_t> summary {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n' + summary.summary + '\n</summary>'
            [any] content = []
            content.push(text)
            result.push(message_item('user', content))
        } else if message is ref<types.branch_summary_message_t> summary {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n' + summary.summary + '</summary>'
            [any] content = []
            content.push(text)
            result.push(message_item('user', content))
        } else if message is ref<types.custom_message_t> custom {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = custom.content
            [any] content = []
            content.push(text)
            result.push(message_item('user', content))
        } else if message is ref<types.bash_execution_message_t> bash {
            if !bash.exclude_from_context {
                {string:any} text = {}
                text['type'] = 'text'
                text['text'] = types.bash_execution_text(bash)
                [any] content = []
                content.push(text)
                result.push(message_item('user', content))
            }
        }
    }
    for item in replay.finish() {
        pending_tool_results.push(tool_result_block(item))
    }
    if pending_tool_results.len() > 0 {
        result.push(message_item('user', pending_tool_results))
    }
    attach_cache_to_last_user(result, cache)
    return result
}

#local
fn assistant_blocks(ref<types.assistant_message_t> message): [any]! {
    [any] result = []
    for content in message.content {
        if content is ref<types.text_content_t> text {
            if text.text != '' {
                {string:any} block = {}
                block['type'] = 'text'
                block['text'] = text.text
                result.push(block)
            }
        } else if content is ref<types.thinking_content_t> thinking {
            if thinking.redacted {
                {string:any} block = {}
                block['type'] = 'redacted_thinking'
                block['data'] = thinking.thinking_signature
                result.push(block)
            } else if thinking.thinking_signature != '' {
                {string:any} block = {}
                block['type'] = 'thinking'
                block['thinking'] = thinking.thinking
                block['signature'] = thinking.thinking_signature
                result.push(block)
            } else if thinking.thinking != '' {
                {string:any} block = {}
                block['type'] = 'text'
                block['text'] = thinking.thinking
                result.push(block)
            }
        } else if content is ref<types.tool_call_t> tool_call {
            {string:any} block = {}
            block['type'] = 'tool_use'
            block['id'] = normalize_tool_id(tool_call.id)
            block['name'] = tool_call.name
            block['input'] = tool_call.arguments
            result.push(block)
        }
    }
    return result
}

#local
fn tool_result_block(ref<types.tool_result_message_t> message): any {
    [string] text = []
    for block in message.content {
        text.push(block.text)
    }
    string output = strings.join(text, '\n')
    if output == '' {
        output = '(no tool output)'
    }
    {string:any} block = {}
    block['type'] = 'tool_result'
    block['tool_use_id'] = normalize_tool_id(message.tool_call_id)
    block['content'] = output
    block['is_error'] = message.is_error
    return block
}

pub fn message_item(string role, [any] content): any {
    {string:any} item = {}
    item['role'] = role
    item['content'] = content
    return item
}

#local
fn attach_cache_to_last_user([any] messages, any cache): void! {
    if messages.len() == 0 || json_util.is_null(cache) {
        return
    }
    var item = messages[messages.len() - 1]
    var object = item as {string:any}
    if object['role'] as string != 'user' {
        return
    }
    var content = object['content'] as [any]
    if content.len() == 0 {
        return
    }
    var block = content[content.len() - 1] as {string:any}
    block['cache_control'] = cache
    content[content.len() - 1] = block
    object['content'] = content
    messages[messages.len() - 1] = object
}

pub fn convert_tools([ref<types.tool_t>] tools, any cache, bool eager_input_streaming): [any]! {
    [any] result = []
    for index, tool in tools {
        {string:any} schema = {}
        schema['type'] = 'object'
        var parameters = tool.parameters as {string:any}
        if parameters.contains('properties') {
            schema['properties'] = parameters['properties']
        } else {
            {string:any} empty_properties = {}
            schema['properties'] = empty_properties
        }
        if parameters.contains('required') {
            schema['required'] = parameters['required']
        } else {
            [any] empty_required = []
            schema['required'] = empty_required
        }
        {string:any} item = {}
        item['name'] = tool.name
        item['description'] = tool.description
        item['input_schema'] = schema
        if eager_input_streaming {
            item['eager_input_streaming'] = true
        }
        if index == tools.len() - 1 {
            item = attach_cache(item, cache)
        }
        result.push(item)
    }
    return result
}

pub fn normalize_tool_id(string id): string {
    [u8] result = []
    for byte in id as [u8] {
        if result.len() >= 64 {
            break
        }
        bool allowed = byte >= 'a'.char() && byte <= 'z'.char()
        allowed = allowed || byte >= 'A'.char() && byte <= 'Z'.char()
        allowed = allowed || byte >= '0'.char() && byte <= '9'.char()
        allowed = allowed || byte == '_'.char() || byte == '-'.char()
        if allowed {
            result.push(byte)
        } else {
            result.push('_'.char())
        }
    }
    return result as string
}
