import syscall
import adou.src.ai.deferred_tools
import adou.src.ai.types
import adou.src.ai.providers.decorators
import adou.src.ai.providers.replay
import adou.src.json_util
import fmt
import json
import strings
pub const ANTHROPIC_VERSION = '2023-06-01'
pub const INTERLEAVED_THINKING_BETA = 'interleaved-thinking-2025-05-14'
pub const FINE_GRAINED_TOOL_STREAMING_BETA = 'fine-grained-tool-streaming-2025-05-14'

// Pi anthropic-messages claudeCodeTools: when the request authenticates with
// a Claude Code OAuth token (sk-ant-oat), tool names are normalized to the
// canonical Claude Code casing on the way out and mapped back to the
// context's exact names on the way in.
// Pi defaultSupportsToolReferences: first-party Anthropic Opus/Sonnet/Fable
// 4.5+ except Haiku and pre-tool-search models.
pub fn default_supports_tool_references(ref<types.model_t> model): bool {
    if model.provider != 'anthropic' || model.id.contains('haiku') {
        return false
    }
    string probe = model.id.to_lower()
    [string] families = ['claude-opus-', 'claude-sonnet-', 'claude-fable-']
    for int f = 0; f < families.len(); f += 1 {
        if !probe.starts_with(families[f]) {
            continue
        }
        string rest = probe.slice(families[f].len(), probe.len())
        string major_digits = ''
        for int i = 0; i < rest.len(); i += 1 {
            u8 c = rest[i]
            if c >= '0'.char() && c <= '9'.char() {
                major_digits += rest.slice(i, i + 1)
                continue
            }
            break
        }
        if major_digits == '' {
            return false
        }
        int major = 0
        for int i = 0; i < major_digits.len(); i += 1 {
            major = major * 10 + (major_digits[i] as int - '0'.char() as int)
        }
        int minor = 0
        if rest.len() > major_digits.len() && rest[major_digits.len()] == '-'.char() {
            string tail = rest.slice(major_digits.len() + 1, rest.len())
            string minor_digits = ''
            for int i = 0; i < tail.len(); i += 1 {
                u8 c = tail[i]
                if c >= '0'.char() && c <= '9'.char() {
                    minor_digits += tail.slice(i, i + 1)
                    continue
                }
                break
            }
            if minor_digits != '' && minor_digits.len() < 8 {
                for int i = 0; i < minor_digits.len(); i += 1 {
                    minor = minor * 10 + (minor_digits[i] as int - '0'.char() as int)
                }
            }
        }
        return major > 4 || (major == 4 && minor >= 5)
    }
    return false
}

fn claude_code_tools(): [string] {
    return [
        'Read',
        'Write',
        'Edit',
        'Bash',
        'Grep',
        'Glob',
        'AskUserQuestion',
        'EnterPlanMode',
        'ExitPlanMode',
        'KillShell',
        'NotebookEdit',
        'Skill',
        'Task',
        'TaskOutput',
        'TodoWrite',
        'WebFetch',
        'WebSearch',
    ]
}

pub fn is_oauth_token(string api_key): bool {
    return api_key.contains('sk-ant-oat')
}

pub fn to_claude_code_name(string name): string {
    string lower = name.to_lower()
    for candidate in claude_code_tools() {
        if candidate.to_lower() == lower {
            return candidate
        }
    }
    return name
}

pub fn from_claude_code_name(string name, [ref<types.tool_t>] tools): string {
    if tools.len() > 0 {
        string lower = name.to_lower()
        for tool in tools {
            if tool.name.to_lower() == lower {
                return tool.name
            }
        }
    }
    return name
}

pub fn build(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {
    {string:any} body = {}
    body['model'] = model.id
    // B3: Pi normalizeToolName — Claude Code OAuth (sk-ant-oat) renames
    // tools to canonical CC casing outbound.
    if syscall.get_env('ADOU_PUI_DEBUG') != '' {println('PUI ' + 'S1')}
    bool oauth_names = is_oauth_token(options.api_key)
    // B3: Pi computes splitDeferredTools before converting messages — the
    // deferred names drive tool_reference blocks inside those messages.
    if syscall.get_env('ADOU_PUI_DEBUG') != '' {println('PUI ' + 'S0')}
    // Zero-tool contexts short-circuit: upstream's split over an empty tool
    // set is trivially empty, and the runtime helper trips a #302-family
    // segfault when iterated over image-only message lists.
    [ref<types.tool_t>] immediate_tools = []
    {string:ref<types.tool_t>} deferred_map = {}
    if context.tools.len() > 0 {
        var placement = deferred_tools.split_deferred_tools(context, model.compat.supports_tool_references || default_supports_tool_references(model))
        immediate_tools = placement.immediate
        deferred_map = placement.deferred
    }
    if immediate_tools.len() == 0 && deferred_map.len() > 0 {
        for _name, tool in deferred_map {
            immediate_tools.push(tool)
        }
        deferred_map = {}
    }
    [string] deferred_names_list = []
    // Zero-value maps trip the #302-family segfault when iterated; guard.
    if deferred_map.len() > 0 {
        for name, tool in deferred_map {
            deferred_names_list.push(name)
        }
    }
    {string:bool} deferred_tool_names = {}
    if deferred_names_list.len() > 0 {
        for name in deferred_names_list {
            deferred_tool_names[name] = true
        }
    }
    if syscall.get_env('ADOU_PUI_DEBUG') != '' {println('PUI ' + 'S2')}
    body['messages'] = convert_messages(context.messages, cache_control(model, options), oauth_names, deferred_tool_names)
    if syscall.get_env('ADOU_PUI_DEBUG') != '' {println('PUI ' + 'S3')}
    body['max_tokens'] = max_tokens(model, options)
    body['stream'] = true
    if options.temperature >= 0.0 {
        body['temperature'] = options.temperature
    }
    if options.tool_choice != '' {
        body['tool_choice'] = parse_tool_choice(options.tool_choice)
    }
    var cache = cache_control(model, options)
    if context.system_prompt != '' {
        {string:any} block = {}
        block['type'] = 'text'
        block['text'] = context.system_prompt
        block = attach_cache(block, cache)
        [any] system = []
        system.push(block)
        body['system'] = system
    }
    if context.tools.len() > 0 {
        // B3: re-admit deferred tools with defer_loading after the immediate set.
        [any] tool_items = convert_tools(immediate_tools, cache, model.supports_eager_tool_streaming, oauth_names, false)
        [ref<types.tool_t>] deferred_values = []
        for name in deferred_names_list {
            deferred_values.push(deferred_map[name])
        }
        for item in convert_tools(deferred_values, cache, model.supports_eager_tool_streaming, oauth_names, true) {
            tool_items.push(item)
        }
        body['tools'] = tool_items
    }
    if model.reasoning {
        {string:any} thinking = {}
        if options.thinking_enabled {
            if model.adaptive_thinking {
                thinking['type'] = 'adaptive'
                thinking['display'] = options.thinking_display
                if options.reasoning_effort != '' {
                    {string:any} output_config = {}
                    output_config['effort'] = options.reasoning_effort
                    body['output_config'] = output_config
                }
            } else {
                thinking['type'] = 'enabled'
                thinking['budget_tokens'] = thinking_budget(options)
                thinking['display'] = options.thinking_display
            }
        } else {
            thinking['type'] = 'disabled'
        }
        body['thinking'] = thinking
    }
    return json.serialize(body)
}

pub fn endpoint(ref<types.model_t> model): string {
    string base = decorators.resolve_base_url(model)
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    return base + '/messages'
}

pub fn api_key(ref<types.stream_options_t> options): string! {
    if options.api_key == '' {
        throw errorf('No API key for provider: anthropic')
    }
    return options.api_key
}

pub fn beta_header(ref<types.model_t> model, ref<types.context_t> context): string {
    [string] features = []
    if model.reasoning && !model.adaptive_thinking {
        features.push(INTERLEAVED_THINKING_BETA)
    }
    if context.tools.len() > 0 && !model.supports_eager_tool_streaming {
        features.push(FINE_GRAINED_TOOL_STREAMING_BETA)
    }
    return strings.join(features, ',')
}

pub fn max_tokens(ref<types.model_t> model, ref<types.stream_options_t> options): int {
    if options.max_tokens > 0 {
        return options.max_tokens
    }
    return model.max_tokens
}

// Pi maps the tool_choice string ('auto'|'none'|'required' or
// 'tool:name') to the Anthropic shape.
fn parse_tool_choice(string value): any {
    if value == 'none' {
        {string:any} none = {}
        none['type'] = 'none'
        return none
    }
    if value == 'required' {
        {string:any} required = {}
        required['type'] = 'any'
        return required
    }
    if value.starts_with('tool:') {
        {string:any} tool = {}
        tool['type'] = 'tool'
        {string:any} inner = {}
        inner['name'] = value.slice(5, value.len())
        tool['name'] = inner
        return tool
    }
    {string:any} auto = {}
    auto['type'] = 'auto'
    return auto
}

fn thinking_budget(ref<types.stream_options_t> options): int {
    if options.thinking_budget_tokens > 0 {
        return options.thinking_budget_tokens
    }
    return 1024
}

fn cache_control(ref<types.model_t> model, ref<types.stream_options_t> options): any {
    if options.cache_retention == 'none' {
        return null
    }
    {string:any} cache = {}
    cache['type'] = 'ephemeral'
    if options.cache_retention == 'long' && model.supports_long_cache_retention {
        cache['ttl'] = '1h'
    }
    return cache
}

fn attach_cache({string:any} target, any cache): {string:any} {
    if !json_util.is_null(cache) {
        target['cache_control'] = cache
    }
    return target
}

pub fn convert_messages([types.message_t] messages, any cache, bool oauth_names, {string:bool} deferred_tool_names): [any]! {
    [any] result = []
    [any] pending_tool_results = []
    [any] pending_siblings = []
    {string:bool} loaded_tools = {}
    var replay = replay.tracker()
    for message in messages {
        if message is ref<types.tool_result_message_t> tool_result {
            replay.observe_tool_result(tool_result.tool_call_id)
            // B3: Pi convertToolResult — the first occurrence of each deferred
            // addedToolName becomes an Anthropic tool_reference block; the
            // ordinary content moves into sibling blocks after the results.
            var parts = tool_result_parts(tool_result, deferred_tool_names, loaded_tools, oauth_names)
            pending_tool_results.push(parts[0])
            for sibling in parts[1] as [any] {
                pending_siblings.push(sibling)
            }
            continue
        }
        [ref<types.tool_result_message_t>] missing = []
        if message is ref<types.assistant_message_t> assistant_for_replay {
            missing = replay.before_assistant(assistant_for_replay)
        } else {
            missing = replay.before_other()
        }
        for item in missing {
            pending_tool_results.push(tool_result_block(item))
        }
        if pending_tool_results.len() > 0 {
            [any] combined = []
            for block in pending_tool_results {
                combined.push(block)
            }
            for sibling in pending_siblings {
                combined.push(sibling)
            }
            result.push(message_item('user', combined))
            pending_tool_results = []
            pending_siblings = []
        }
        if message is ref<types.user_message_t> user {
            if syscall.get_env('ADOU_PUI_DEBUG') != '' {println('PUI U0')}
            if user.content != '' || user.images.len() > 0 {
                [any] content = []
                if syscall.get_env('ADOU_PUI_DEBUG') != '' {println('PUI U1')}
                for image in user.images {
                    {string:any} source = {}
                    source['type'] = 'base64'
                    source['media_type'] = image.mime_type
                    source['data'] = image.data
                    {string:any} image_block = {}
                    image_block['type'] = 'image'
                    image_block['source'] = source
                    content.push(image_block)
                }
                if user.content != '' {
                    {string:any} text = {}
                    text['type'] = 'text'
                    text['text'] = user.content
                    content.push(text)
                }
                result.push(message_item('user', content))
                if syscall.get_env('ADOU_PUI_DEBUG') != '' {println('PUI U2')}
            }
        } else if message is ref<types.assistant_message_t> assistant {
            // Pi drops failed/aborted assistant turns before provider-specific
            // message conversion so incomplete thinking/tool blocks are not
            // replayed into the next request.
            if assistant.stop_reason == types.STOP_ERROR || assistant.stop_reason == types.STOP_ABORTED {
                continue
            }
            var blocks = assistant_blocks(assistant, oauth_names)
            if blocks.len() > 0 {
                result.push(message_item('assistant', blocks))
            }
        } else if message is ref<types.compaction_summary_message_t> summary {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n' + summary.summary + '\n</summary>'
            [any] content = []
            content.push(text)
            result.push(message_item('user', content))
        } else if message is ref<types.branch_summary_message_t> summary {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n' + summary.summary + '</summary>'
            [any] content = []
            content.push(text)
            result.push(message_item('user', content))
        } else if message is ref<types.custom_message_t> custom {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = custom.content
            [any] content = []
            content.push(text)
            result.push(message_item('user', content))
        } else if message is ref<types.bash_execution_message_t> bash {
            if !bash.exclude_from_context {
                {string:any} text = {}
                text['type'] = 'text'
                text['text'] = types.bash_execution_text(bash)
                [any] content = []
                content.push(text)
                result.push(message_item('user', content))
            }
        }
    }
    for item in replay.finish() {
        pending_tool_results.push(tool_result_block(item))
    }
    if pending_tool_results.len() > 0 || pending_siblings.len() > 0 {
        [any] combined = []
        for block in pending_tool_results {
            combined.push(block)
        }
        for sibling in pending_siblings {
            combined.push(sibling)
        }
        result.push(message_item('user', combined))
    }
    attach_cache_to_last_user(result, cache)
    return result
}

fn assistant_blocks(ref<types.assistant_message_t> message, bool oauth_names): [any]! {
    [any] result = []
    for content in message.content {
        if content is ref<types.text_content_t> text {
            if text.text != '' {
                {string:any} block = {}
                block['type'] = 'text'
                block['text'] = text.text
                result.push(block)
            }
        } else if content is ref<types.thinking_content_t> thinking {
            if thinking.redacted {
                {string:any} block = {}
                block['type'] = 'redacted_thinking'
                block['data'] = thinking.thinking_signature
                result.push(block)
            } else if thinking.thinking_signature != '' {
                {string:any} block = {}
                block['type'] = 'thinking'
                block['thinking'] = thinking.thinking
                block['signature'] = thinking.thinking_signature
                result.push(block)
            } else if thinking.thinking != '' {
                {string:any} block = {}
                block['type'] = 'text'
                block['text'] = thinking.thinking
                result.push(block)
            }
        } else if content is ref<types.tool_call_t> tool_call {
            {string:any} block = {}
            block['type'] = 'tool_use'
            block['id'] = normalize_tool_id(tool_call.id)
            // Claude Code OAuth: outbound tool_use names use CC casing.
            block['name'] = oauth_names ? to_claude_code_name(tool_call.name) : tool_call.name
            block['input'] = tool_call.arguments
            result.push(block)
        }
    }
    return result
}

// B3: Pi convertToolResult — deferred addedToolNames become a single
// tool_result block whose content is the tool_reference list (first
// occurrence only); the ordinary text content moves into sibling blocks so
// Anthropic never mixes references with regular content.
fn tool_result_parts(ref<types.tool_result_message_t> message, {string:bool} deferred_tool_names, {string:bool} loaded_tools, bool oauth_names): [any]! {
    [any] converted_content = []
    [string] text = []
    for block in message.content {
        text.push(block.text)
    }
    string output = strings.join(text, '\n')
    if output == '' {
        output = '(no tool output)'
    }
    // Same content shape as tool_result_block: optional leading text plus
    // any base64 image blocks.
    if output != '' {
        {string:any} text_block = {}
        text_block['type'] = 'text'
        text_block['text'] = output
        converted_content.push(text_block)
    }
    for image in message.images {
        {string:any} source = {}
        source['type'] = 'base64'
        source['media_type'] = image.mime_type
        source['data'] = image.data
        {string:any} image_block = {}
        image_block['type'] = 'image'
        image_block['source'] = source
        converted_content.push(image_block)
    }
    [any] references = []
    for name in message.added_tool_names {
        if !deferred_tool_names.contains(name) || loaded_tools.contains(name) {
            continue
        }
        loaded_tools[name] = true
        {string:any} reference = {}
        reference['type'] = 'tool_reference'
        reference['tool_name'] = oauth_names ? to_claude_code_name(name) : name
        references.push(reference)
    }
    {string:any} block = {}
    block['type'] = 'tool_result'
    block['tool_use_id'] = normalize_tool_id(message.tool_call_id)
    block['is_error'] = message.is_error
    if references.len() > 0 {
        block['content'] = references
    } else if message.images.len() == 0 {
        block['content'] = output
    } else {
        block['content'] = converted_content
    }
    [any] parts = []
    parts.push(block)
    [any] siblings = []
    if references.len() > 0 {
        for sibling in converted_content {
            siblings.push(sibling)
        }
    }
    parts.push(siblings)
    return parts
}

fn tool_result_block(ref<types.tool_result_message_t> message): any {
    [string] text = []
    for block in message.content {
        text.push(block.text)
    }
    string output = strings.join(text, '\n')
    if output == '' {
        output = '(no tool output)'
    }
    {string:any} block = {}
    block['type'] = 'tool_result'
    block['tool_use_id'] = normalize_tool_id(message.tool_call_id)
    if message.images.len() == 0 {
        block['content'] = output
    } else {
        [any] content = []
        if output != '' {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = output
            content.push(text)
        }
        for image in message.images {
            {string:any} source = {}
            source['type'] = 'base64'
            source['media_type'] = image.mime_type
            source['data'] = image.data
            {string:any} image_block = {}
            image_block['type'] = 'image'
            image_block['source'] = source
            content.push(image_block)
        }
        block['content'] = content
    }
    block['is_error'] = message.is_error
    return block
}

pub fn message_item(string role, [any] content): any {
    {string:any} item = {}
    item['role'] = role
    item['content'] = content
    return item
}

fn attach_cache_to_last_user([any] messages, any cache): void! {
    if messages.len() == 0 || json_util.is_null(cache) {
        return
    }
    var item = messages[messages.len() - 1]
    var object = item as {string:any}
    if object['role'] as string != 'user' {
        return
    }
    var content = object['content'] as [any]
    if content.len() == 0 {
        return
    }
    var block = content[content.len() - 1] as {string:any}
    block['cache_control'] = cache
    content[content.len() - 1] = block
    object['content'] = content
    messages[messages.len() - 1] = object
}

pub fn convert_tools([ref<types.tool_t>] tools, any cache, bool eager_input_streaming, bool oauth_names, bool defer_loading): [any]! {
    [any] result = []
    for index, tool in tools {
        {string:any} schema = {}
        schema['type'] = 'object'
        var parameters = tool.parameters as {string:any}
        if parameters.contains('properties') {
            schema['properties'] = parameters['properties']
        } else {
            {string:any} empty_properties = {}
            schema['properties'] = empty_properties
        }
        if parameters.contains('required') {
            schema['required'] = parameters['required']
        } else {
            [any] empty_required = []
            schema['required'] = empty_required
        }
        {string:any} item = {}
        item['name'] = oauth_names ? to_claude_code_name(tool.name) : tool.name
        item['description'] = tool.description
        if defer_loading {
            // Pi convertTools(deferLoading): marks the entry as loaded on demand.
            item['defer_loading'] = true
        }
        item['input_schema'] = schema
        if eager_input_streaming {
            item['eager_input_streaming'] = true
        }
        if index == tools.len() - 1 {
            item = attach_cache(item, cache)
        }
        result.push(item)
    }
    return result
}

pub fn normalize_tool_id(string id): string {
    [u8] result = []
    for byte in id as [u8] {
        if result.len() >= 64 {
            break
        }
        bool allowed = byte >= 'a'.char() && byte <= 'z'.char()
        allowed = allowed || byte >= 'A'.char() && byte <= 'Z'.char()
        allowed = allowed || byte >= '0'.char() && byte <= '9'.char()
        allowed = allowed || byte == '_'.char() || byte == '-'.char()
        if allowed {
            result.push(byte)
        } else {
            result.push('_'.char())
        }
    }
    return result as string
}
