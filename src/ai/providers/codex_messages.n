import adou.src.ai.providers.decorators
import adou.src.ai.providers.replay
import adou.src.ai.types
import adou.src.json_util
import base64
import json
import strings

pub fn endpoint(ref<types.model_t> model): string {
    string base = decorators.resolve_base_url(model)
    for base.ends_with('/') {
        base = base.slice(0, base.len() - 1)
    }
    if base.ends_with('/codex/responses') {
        return base
    }
    if base.ends_with('/codex') {
        return base + '/responses'
    }
    return base + '/codex/responses'
}

pub fn build(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): string! {
    {string:any} body = {}
    body['model'] = model.id
    body['store'] = false
    body['stream'] = true
    string instructions = context.system_prompt
    if instructions == '' {
        instructions = 'You are a helpful assistant.'
    }
    body['instructions'] = instructions
    body['input'] = convert_messages(model, context)
    {string:any} text_config = {}
    text_config['verbosity'] = 'low'
    body['text'] = text_config
    [any] include = []
    include.push('reasoning.encrypted_content')
    body['include'] = include
    if options.session_id != '' {
        body['prompt_cache_key'] = clamp_cache_key(options.session_id)
    }
    body['tool_choice'] = 'auto'
    body['parallel_tool_calls'] = true
    if context.tools.len() > 0 {
        body['tools'] = convert_tools(context.tools)
    }
    // The ChatGPT Codex Responses backend rejects max_output_tokens on both
    // its SSE and WebSocket transports. Pi intentionally omits it here.
    if options.reasoning_effort != '' && options.reasoning_effort != 'off' {
        {string:any} reasoning = {}
        reasoning['effort'] = options.reasoning_effort
        reasoning['summary'] = options.reasoning_summary
        body['reasoning'] = reasoning
    }
    return json.serialize(body)
}

// The Codex backend requires the ChatGPT account id, extracted from the
// access token JWT payload claim chatgpt_account_id.
pub fn account_id(string token): string! {
    [string] parts = token.split('.')
    if parts.len() != 3 {
        throw errorf('Invalid Codex access token')
    }
    string payload = parts[1]
    payload = payload.replace('-', '+')
    payload = payload.replace('_', '/')
    int padding_needed = payload.len()
    padding_needed = padding_needed % 4
    if padding_needed > 0 {
        padding_needed = 4 - padding_needed
    }
    for padding_needed > 0 {
        payload += '='
        padding_needed = padding_needed - 1
    }
    var decoded = base64.decode(payload as [u8]) catch error {
        throw errorf('Failed to decode Codex token payload')
    }
    var root = json_util.parse(decoded as string)
    if !json_util.is_obj(root) {
        throw errorf('Failed to parse Codex token payload')
    }
    var object = root as {string:any}
    if !object.contains('https://api.openai.com/auth') {
        throw errorf('Codex token has no account claim')
    }
    var claim = object['https://api.openai.com/auth']
    if !(claim is {string:any}) {
        throw errorf('Codex token has no account claim')
    }
    var claim_object = claim as {string:any}
    if !claim_object.contains('chatgpt_account_id') || !(claim_object['chatgpt_account_id'] is string) {
        throw errorf('Codex token has no account id')
    }
    return claim_object['chatgpt_account_id'] as string
}

fn convert_messages(ref<types.model_t> model, ref<types.context_t> context): [any]! {
    [any] result = []
    var replay = replay.tracker()
    for message in context.messages {
        if message is ref<types.user_message_t> user {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', user.content))
        } else if message is ref<types.assistant_message_t> assistant {
            for missing in replay.before_assistant(assistant) {
                result.push(tool_result_item(model, missing))
            }
            if assistant.stop_reason == types.STOP_ERROR || assistant.stop_reason == types.STOP_ABORTED {
                continue
            }
            var item = assistant_item(model, assistant)
            if !json_util.is_null(item) {
                result.push(item)
            }
        } else if message is ref<types.tool_result_message_t> tool_result {
            replay.observe_tool_result(tool_result.tool_call_id)
            result.push(tool_result_item(model, tool_result))
        } else if message is ref<types.compaction_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n' + summary.summary + '\n</summary>'))
        } else if message is ref<types.branch_summary_message_t> summary {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n' + summary.summary + '</summary>'))
        } else if message is ref<types.custom_message_t> custom {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            result.push(message_item('user', custom.content))
        } else if message is ref<types.bash_execution_message_t> bash {
            for missing in replay.before_other() {
                result.push(tool_result_item(model, missing))
            }
            if !bash.exclude_from_context {
                result.push(message_item('user', types.bash_execution_text(bash)))
            }
        }
    }
    for missing in replay.finish() {
        result.push(tool_result_item(model, missing))
    }
    return result
}

fn message_item(string role, string content): any {
    {string:any} item = {}
    item['role'] = role
    item['content'] = content
    return item
}

fn assistant_item(ref<types.model_t> model, ref<types.assistant_message_t> message): any! {
    string text = ''
    [any] calls = []
    for block in message.content {
        if block is ref<types.text_content_t> text_block {
            text += text_block.text
        } else if block is ref<types.tool_call_t> tool_call {
            {string:any} function = {}
            function['name'] = tool_call.name
            var serialized = json.serialize(tool_call.arguments) catch error {
                '{}'
            }
            function['arguments'] = serialized
            {string:any} call = {}
            call['id'] = tool_call.id
            call['type'] = 'function'
            call['function'] = function
            calls.push(call)
        }
    }
    if text == '' && calls.len() == 0 {
        return null
    }
    {string:any} item = {}
    item['role'] = 'assistant'
    if text != '' {
        item['content'] = text
    } else {
        item['content'] = null
    }
    if calls.len() > 0 {
        item['tool_calls'] = calls
    }
    return item
}

fn tool_result_item(ref<types.model_t> model, ref<types.tool_result_message_t> message): any {
    [string] lines = []
    for block in message.content {
        lines.push(block.text)
    }
    string content = strings.join(lines, '\n')
    if content == '' {
        content = '(no tool output)'
    }
    {string:any} item = {}
    item['role'] = 'tool'
    item['tool_call_id'] = message.tool_call_id
    item['content'] = content
    return item
}

fn convert_tools([ref<types.tool_t>] tools): [any]! {
    [any] result = []
    for tool in tools {
        {string:any} function = {}
        function['name'] = tool.name
        function['description'] = tool.description
        function['parameters'] = tool.parameters
        function['strict'] = false
        {string:any} item = {}
        item['type'] = 'function'
        item['function'] = function
        result.push(item)
    }
    return result
}

fn clamp_cache_key(string value): string {
    if value.len() > 64 {
        return value.slice(0, 64)
    }
    return value
}
