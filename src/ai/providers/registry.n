pub fn find_model(string provider, string id): ref<types.model_t>? {
    for model in models_for(provider) {
        if model.id == id {
            return model
        }
    }
    return null
}

pub fn apis(): [string] {
    [string] result = []
    for model in all_models() {
        bool seen = false
        for api in result {
            if api == model.api {
                seen = true
                break
            }
        }
        if !seen {
            result.push(model.api)
        }
    }
    return result
}
