pub fn defs(): [types.provider_def_t] {
    [types.provider_def_t] result = []
    result.push(amazon_bedrock.def())
    result.push(ant_ling.def())
    result.push(anthropic.def())
    result.push(azure_openai_responses.def())
    result.push(cerebras.def())
    result.push(cloudflare_ai_gateway.def())
    result.push(cloudflare_workers_ai.def())
    result.push(deepseek.def())
    result.push(fireworks.def())
    result.push(github_copilot.def())
    result.push(google.def())
    result.push(google_vertex.def())
    result.push(groq.def())
    result.push(huggingface.def())
    result.push(kimi_coding.def())
    result.push(minimax.def())
    result.push(minimax_cn.def())
    result.push(mistral.def())
    result.push(moonshotai.def())
    result.push(moonshotai_cn.def())
    result.push(nvidia.def())
    result.push(openai.def())
    result.push(openai_codex.def())
    result.push(opencode.def())
    result.push(opencode_go.def())
    result.push(openrouter.def())
    result.push(qwen_token_plan.def())
    result.push(qwen_token_plan_cn.def())
    result.push(radius.def())
    result.push(together.def())
    result.push(vercel_ai_gateway.def())
    result.push(xai.def())
    result.push(xiaomi.def())
    result.push(xiaomi_token_plan_ams.def())
    result.push(xiaomi_token_plan_cn.def())
    result.push(xiaomi_token_plan_sgp.def())
    result.push(zai.def())
    result.push(zai_coding_cn.def())
    return result
}

pub fn find_def(string id): types.provider_def_t? {
    // Runtime-registered providers (extensions) win over the built-ins.
    if runtime_defs.contains(id) {
        var runtime = runtime_defs[id]
        return runtime
    }
    for def in defs() {
        if def.id == id {
            return def
        }
    }
    return null
}

// Pi ModelRegistry registration surface: extensions register providers at
// runtime with a name/baseUrl/api/apiKey shape.
pub fn register_provider(types.provider_def_t def) {
    runtime_defs[def.id] = def
}

pub fn unregister_provider(string id) {
    if runtime_defs.contains(id) {
        runtime_defs.del(id)
    }
}

pub fn registered_provider_ids(): [string] {
    [string] result = []
    for id, def in runtime_defs {
        result.push(id)
    }
    return result
}

{string:types.provider_def_t} runtime_defs = {}

pub fn all_models(): [ref<types.model_t>] {
    [ref<types.model_t>] result = []
    for def in defs() {
        var models = models_for(def.id)
        for model in models {
            result.push(model)
        }
    }
    return result
}

