// Provider definition for Xiaomi.
// Metadata follows vendors/pi/packages/ai/src/providers/xiaomi.ts.
import adou.src.ai.providers.xiaomi_models
import adou.src.ai.types

pub fn def(): types.provider_def_t {
    return types.provider_def_t {id: 'xiaomi', name: 'Xiaomi', api: 'openai-completions', base_url: 'https://api.xiaomimimo.com/v1', env_vars: ['XIAOMI_API_KEY'], headers: {},}
}

pub fn models(): [ref<types.model_t>] {
    return xiaomi_models.models()
}
