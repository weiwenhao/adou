import adou.src.ai.types
import adou.src.config.auth
import syscall

// Provider-specific request decoration shared by the completions, responses
// and anthropic-messages send paths. Pi spreads this logic across the API
// layers and cloudflare-auth/stream helpers; Nature keeps it in one place.

pub type header_t = struct {
    string name
    string value
}

// Cloudflare account/gateway endpoints carry {CLOUDFLARE_ACCOUNT_ID} and
// {CLOUDFLARE_GATEWAY_ID} placeholders that materialize from the resolved
// provider environment before dispatch.
pub fn resolve_base_url(ref<types.model_t> model): string {
    string base = model.base_url
    if model.provider == 'github-copilot' {
        var stored = auth.read_credential('github-copilot')
        if stored is ref<auth.oauth_credential_t> {
            var oauth = stored as ref<auth.oauth_credential_t>
            if oauth.base_url != '' {
                base = oauth.base_url
            }
        }
    }
    base = base.replace('{CLOUDFLARE_ACCOUNT_ID}', syscall.get_env('CLOUDFLARE_ACCOUNT_ID'))
    base = base.replace('{CLOUDFLARE_GATEWAY_ID}', syscall.get_env('CLOUDFLARE_GATEWAY_ID'))
    return base
}

// Cloudflare AI Gateway authenticates with cf-aig-authorization instead of
// the standard Authorization / x-api-key headers.
pub fn is_cloudflare_gateway(ref<types.model_t> model): bool {
    return model.provider == 'cloudflare-ai-gateway' || model.base_url.contains('gateway.ai.cloudflare.com')
}

// Pi's gateway auth removes Authorization and x-api-key entirely; callers
// must skip the standard bearer header when this returns true.
pub fn cloudflare_gateway_auth_header(string api_key): header_t {
    return header_t {name: 'cf-aig-authorization', value: 'Bearer ' + api_key,}
}

// GitHub Copilot requires X-Initiator (user- or agent-initiated) and
// Openai-Intent; Copilot-Vision-Request is added when an image is present.
pub fn copilot_headers(ref<types.context_t> context): [header_t] {
    [header_t] result = []
    string initiator = 'user'
    if context.messages.len() > 0 {
        var last = context.messages[context.messages.len() - 1]
        if last is ref<types.user_message_t> {
            initiator = 'user'
        } else {
            initiator = 'agent'
        }
    }
    result.push(header_t {name: 'X-Initiator', value: initiator,})
    result.push(header_t {name: 'Openai-Intent', value: 'conversation-edits',})
    return result
}
