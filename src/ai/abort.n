import co.mutex
// abort_t is a cooperative cancellation token. Providers register response
// closers so abort wakes a coroutine blocked in network I/O instead of merely
// setting a flag that will not be observed until the next chunk.
pub type abort_callback_t = fn (): void
pub type abort_t = struct {
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    bool aborted
    [abort_callback_t] callbacks = []
}
pub fn new(): ref<abort_t> {
    return new abort_t()
}
pub fn abort_t.is_aborted(&self): bool {
    self.lock.lock()
    bool result = self.aborted
    self.lock.unlock()
    return result
}
pub fn abort_t.on_abort(&self, abort_callback_t callback) {
    self.lock.lock()
    if self.aborted {
        self.lock.unlock()
        callback()
        return
    }
    self.callbacks.push(callback)
    self.lock.unlock()
}
pub fn abort_t.abort(&self) {
    self.lock.lock()
    if self.aborted {
        self.lock.unlock()
        return
    }
    self.aborted = true
    var callbacks = self.callbacks
    self.callbacks = []
    self.lock.unlock()
    for callback in callbacks {
        callback()
    }
}
