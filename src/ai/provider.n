import adou.src.ai.event_stream
import adou.src.ai.providers.anthropic_provider
import adou.src.ai.providers.bedrock_provider
import adou.src.ai.providers.codex_provider
import adou.src.ai.providers.google_provider
import adou.src.ai.providers.mistral_provider
import adou.src.ai.providers.openai_completions_provider
import adou.src.ai.providers.openai_provider
import adou.src.ai.providers.pi_messages_provider
import adou.src.ai.types

// Pi compat.registerApiProvider surface: extensions register a stream
// implementation for an api id at runtime; runtime implementations win over
// the built-in dispatch.
pub type api_provider_stream_fn = fn(ref<types.model_t>, ref<types.context_t>, ref<types.stream_options_t>): ref<event_stream.assistant_stream_t>

pub type api_provider_t = struct {
    string api
    api_provider_stream_fn stream
}

pub fn register_api_provider(string api, api_provider_stream_fn stream_fn) {
    runtime_api_providers[api] = api_provider_t {api: api, stream: stream_fn}
}

pub fn unregister_api_providers([string] source_apis) {
    for api in source_apis {
        if runtime_api_providers.contains(api) {
            runtime_api_providers.del(api)
        }
    }
}

pub fn get_api_provider(string api): ref<api_provider_t>? {
    if runtime_api_providers.contains(api) {
        var provider = runtime_api_providers[api]
        return new api_provider_t(api = provider.api, stream = provider.stream)
    }
    return null
}

{string:api_provider_t} runtime_api_providers = {}

pub fn stream(ref<types.model_t> model, ref<types.context_t> context, ref<types.stream_options_t> options): ref<event_stream.assistant_stream_t> {
    var runtime = get_api_provider(model.api)
    if runtime is ref<api_provider_t> runtime_provider {
        return runtime_provider.stream(model, context, options)
    }
    if model.api == 'openai-responses' {
        return openai_provider.stream(model, context, options)
    }
    if model.api == 'openai-completions' {
        return openai_completions_provider.stream(model, context, options)
    }
    if model.api == 'anthropic-messages' {
        return anthropic_provider.stream(model, context, options)
    }
    if model.api == 'mistral-conversations' {
        return mistral_provider.stream(model, context, options)
    }
    if model.api == 'google-generative-ai' || model.api == 'google-vertex' {
        return google_provider.stream(model, context, options)
    }
    if model.api == 'openai-codex-responses' {
        return codex_provider.stream(model, context, options)
    }
    if model.api == 'bedrock-converse-stream' {
        return bedrock_provider.stream(model, context, options)
    }
    if model.api == 'pi-messages' {
        return pi_messages_provider.stream(model, context, options)
    }
    var result = event_stream.new()
    var message = new types.assistant_message_t(api = model.api, provider = model.provider, model = model.id, stop_reason = types.STOP_ERROR, error_message = 'Unsupported provider API: ' + model.api)
    var event = types.assistant_event_t {kind: types.EVENT_ERROR, reason: types.STOP_ERROR, error: message,}
    result.push(event) catch e {}
    result.end() catch e {}
    return result
}
