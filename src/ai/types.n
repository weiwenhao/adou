import fmt
import json
pub const EVENT_START = 'start'
pub const EVENT_TEXT_START = 'text_start'
pub const EVENT_TEXT_DELTA = 'text_delta'
pub const EVENT_TEXT_END = 'text_end'
pub const EVENT_THINKING_START = 'thinking_start'
pub const EVENT_THINKING_DELTA = 'thinking_delta'
pub const EVENT_THINKING_END = 'thinking_end'
pub const EVENT_TOOLCALL_START = 'toolcall_start'
pub const EVENT_TOOLCALL_DELTA = 'toolcall_delta'
pub const EVENT_TOOLCALL_END = 'toolcall_end'
pub const EVENT_DONE = 'done'
pub const EVENT_ERROR = 'error'
pub const STOP_PENDING = 'pending'
pub const STOP_STOP = 'stop'
pub const STOP_LENGTH = 'length'
pub const STOP_TOOL_USE = 'toolUse'
pub const STOP_ERROR = 'error'
pub const STOP_ABORTED = 'aborted'
pub type cost_tier_t = struct {
    int input_tokens_above
    float input
    float output
    float cache_read
    float cache_write
}
pub type cost_t = struct {
    float input
    float output
    float cache_read
    float cache_write
    float total
    [cost_tier_t] tiers = []
}
pub type usage_t = struct {
    int input
    int output
    int cache_read
    int cache_write
    int cache_write_1h
    int reasoning
    int total_tokens
    cost_t cost
}
pub type text_content_t = struct {
    string text
    string text_signature
}
pub type thinking_content_t = struct {
    string thinking
    string thinking_signature
    bool redacted
}
pub type tool_call_t = struct {
    string id
    string name
    any arguments
    string partial_json
    // Nature's dynamic JSON strings can outlive the SSE object that produced
    // them. Providers retain the completed raw argument JSON here so final
    // message snapshots can rebuild an independently owned value.
    string arguments_json
    // Google thought signatures ride on functionCall parts and must replay
    // verbatim on later turns (google-shared.ts).
    string thought_signature
}
pub type image_attachment_t = struct {
    string mime_type
    string data
}
pub type content_t = ref<text_content_t>| ref<thinking_content_t>| ref<tool_call_t>
pub type assistant_message_t = struct {
    string role = 'assistant'
    [content_t] content = []
    string api
    string provider
    string model
    string response_id
    // Pi-ai AssistantMessage.responseModel: the concrete chunk.model when it
    // differs from the requested model (e.g. OpenRouter 'auto').
    string response_model
    usage_t usage
    string stop_reason = STOP_PENDING
    string error_message
    [any] diagnostics = []
    int timestamp
}
pub type user_message_t = struct {
    string role = 'user'
    string content
    [ref<image_attachment_t>] images = []
    int timestamp
}
pub type tool_result_message_t = struct {
    string role = 'toolResult'
    string tool_call_id
    string tool_name
    [ref<text_content_t>] content = []
    [ref<image_attachment_t>] images = []
    any details
    usage_t usage
    [string] added_tool_names = []
    bool is_error
    int timestamp
}
pub type compaction_summary_message_t = struct {
    string role = 'compactionSummary'
    string summary
    int tokens_before
    int timestamp
}
pub type branch_summary_message_t = struct {
    string role = 'branchSummary'
    string summary
    string from_id
    int timestamp
}
pub type custom_message_t = struct {
    string role = 'custom'
    string custom_type
    string content
    bool display
    any details
    int timestamp
}
pub type bash_execution_message_t = struct {
    string role = 'bashExecution'
    string command
    string output
    int exit_code = -1
    bool cancelled
    bool truncated
    string full_output_path
    bool exclude_from_context
    int timestamp
    // TUI-only render caches. They are intentionally not serialized or sent
    // to providers; completed Bash output is immutable after it enters the
    // transcript, so caching avoids rebuilding the same visual tail on every
    // redraw of a long session.
    [string] collapsed_render_rows = []
    int collapsed_render_width
    int collapsed_render_skipped
    string collapsed_render_theme
    [string] expanded_render_rows = []
    int expanded_render_width
    string expanded_render_theme
}
pub type message_t = ref<user_message_t>| ref<assistant_message_t>| ref<tool_result_message_t>| ref<compaction_summary_message_t>| ref<branch_summary_message_t>| ref<custom_message_t>| ref<bash_execution_message_t>
pub type tool_t = struct {
    string name
    string description
    any parameters
    bool sequential
    any constrained_sampling = false
}
pub type context_t = struct {
    string system_prompt
    [message_t] messages = []
    [ref<tool_t>] tools = []
    bool block_images
}
// Pi's per-model compat flags (compat.ts OpenAICompletionsCompat family).
// The request builders consume the fields that change request shape; the
// rest is carried for catalog parity.
pub type compat_t = struct {
    bool supports_store
    bool supports_developer_role
    bool supports_reasoning_effort
    bool supports_usage_in_streaming
    string max_tokens_field
    bool requires_tool_result_name
    bool requires_assistant_after_tool_result
    bool requires_thinking_as_text
    bool requires_reasoning_content_on_assistant_messages
    string thinking_format
    bool zai_tool_stream
    bool supports_strict_mode
    bool supports_openai_grammar_tools
    // Anthropic tool_reference blocks (Pi supportsToolReferences): first-party
    // Claude Opus/Sonnet/Fable 4.5+ except Haiku.
    bool supports_tool_references
    bool send_session_affinity_headers
    string cache_control_format
}
pub type model_t = struct {
    string id
    string name
    string api
    string provider
    string base_url
    bool reasoning
    bool adaptive_thinking
    bool supports_long_cache_retention = true
    bool supports_eager_tool_streaming = true
    int context_window
    int max_tokens
    cost_t cost
    // Pi thinkingLevelMap: pi level -> provider value; an empty value marks a
    // level the model does not support (Pi's null).
    {string:string} thinking_level_map = {}
    {string:string} headers = {}
    compat_t compat
}

// A registered provider. The openai-completions / anthropic-messages /
// openai-responses families share one stream implementation per api, so a
// provider definition only needs identity, endpoint and auth env vars.
//
// supports_api_key_login is an explicit auth capability (B1-R2-04): it
// decides whether the provider may appear in the /login API-key completion
// and login surface.  It must never be inferred from env_vars length --
// Bedrock/Vertex carry no env var yet are API-key login providers, while
// openai-codex is OAuth-only (false).  Runtime-registered providers default
// to true and are governed by the same field.
pub type provider_def_t = struct {
    string id
    string name
    string api
    string base_url
    [string] env_vars = []
    {string:string} headers = {}
    bool supports_api_key_login = true
    bool supports_oauth
}
pub type stream_options_t = struct {
    string api_key = ''
    int timeout_ms = 120000
    int max_tokens
    int max_retries = 2
    int max_retry_delay_ms = 60000
    string session_id
    string reasoning_effort
    string reasoning_summary = 'auto'
    bool thinking_enabled
    int thinking_budget_tokens = 1024
    string thinking_display = 'summarized'
    string cache_retention = 'short'
    float temperature = -1.0
    string tool_choice
    // Pi StreamOptions.metadata passthrough; Anthropic emits
    // metadata.user_id when present.  Nature #318 (nil map data) is fixed
    // in v0.7.4 build 2026-08-23 (PR #319).
    {string:string} metadata = {}
    // OpenAI Responses service_tier ('auto'|'default'|'flex'|...); empty
    // leaves the key unset like upstream's undefined.
    string service_tier
    bool block_images
    // Pi's transport option for the Codex Responses provider: 'auto'
    // (default), 'sse', 'websocket' or 'websocket-cached'.  'websocket-cached'
    // reuses a provider websocket and sends previous_response_id continuation
    // deltas when the provider supports the cached Codex transport.
    string transport = 'auto'
}
// assistant_event_t mirrors Pi's AssistantMessageEvent protocol. Only fields
// meaningful for a particular event type are populated.
pub type assistant_event_t = struct {
    string kind
    int content_index = -1
    string delta
    string content
    string reason
    ref<assistant_message_t>? partial = null
    ref<assistant_message_t>? message = null
    ref<assistant_message_t>? error = null
    ref<tool_call_t>? tool_call = null
}

pub fn bash_execution_text(ref<bash_execution_message_t> message): string {
    string text = 'Ran `' + message.command + '`\n'
    if message.output != '' {
        text += '```\n' + message.output + '\n```'
    } else {
        text += '(no output)'
    }
    if message.cancelled {
        text += '\n\n(command cancelled)'
    } else if message.exit_code >= 0 && message.exit_code != 0 {
        text += '\n\nCommand exited with code ' + fmt.sprintf('%d', message.exit_code)
    }
    if message.truncated && message.full_output_path != '' {
        text += '\n\n[Output truncated. Full output: ' + message.full_output_path + ']'
    }
    return text
}
