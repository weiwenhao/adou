// Pi uses a small, deterministic 32-bit hash when an upstream provider gives
// OpenAI Responses an item id that cannot be replayed verbatim. Keep the
// implementation here instead of relying on a platform hash: persisted
// sessions must produce the same id on every run and architecture.
pub fn short_hash(string value): string {
    u32 h1 = 0xdeadbeef
    u32 h2 = 0x41c6ce57
    [u8] bytes = value as [u8]
    for byte in bytes {
        u32 ch = byte as u32
        h1 = (h1 ^ ch) * 2654435761
        h2 = (h2 ^ ch) * 1597334677
    }
    h1 = ((h1 ^ (h1 >> 16)) * 2246822507) ^ ((h2 ^ (h2 >> 13)) * 3266489909)
    h2 = ((h2 ^ (h2 >> 16)) * 2246822507) ^ ((h1 ^ (h1 >> 13)) * 3266489909)
    return base36(h2) + base36(h1)
}

// OpenAI accepts only a restricted, bounded id alphabet for Responses items.
pub fn normalize_id_part(string value): string {
    [u8] source = value as [u8]
    [u8] result = []
    for byte in source {
        if result.len() >= 64 {
            break
        }
        bool allowed = (byte >= 'a'.char() && byte <= 'z'.char()) || (byte >= 'A'.char() && byte <= 'Z'.char()) || (byte >= '0'.char() && byte <= '9'.char()) || byte == '_'.char() || byte == '-'.char()
        result.push(allowed ? byte : '_'.char())
    }
    for result.len() > 0 {
        int last = result.len() - 1
        if result[last] != '_'.char() {
            break
        }
        result = result.slice(0, last)
    }
    return result as string
}

pub fn foreign_responses_item_id(string item_id): string {
    string normalized = 'fc_' + short_hash(item_id)
    if normalized.len() > 64 {
        return normalized.slice(0, 64)
    }
    return normalized
}

fn base36(u32 value): string {
    const ALPHABET = '0123456789abcdefghijklmnopqrstuvwxyz'
    if value == 0 {
        return '0'
    }
    [u8] digits = []
    for value > 0 {
        u32 remainder = value % 36
        digits.push((ALPHABET as [u8])[remainder as int])
        value /= 36
    }
    return (digits as string).reverse()
}
