pub const SQLITE_OPEN_WAL = 0x00080000           // WAL
pub const SQLITE_OPEN_NOFOLLOW = 0x01000000      // No follow
pub const SQLITE_OPEN_EXRESCODE = 0x02000000     // Extended result code

