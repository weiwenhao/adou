pub const SQLITE_OPEN_TEMP_JOURNAL = 0x00001000  // Temporary journal
pub const SQLITE_OPEN_SUBJOURNAL = 0x00002000    // Sub journal
pub const SQLITE_OPEN_SUPER_JOURNAL = 0x00004000 // Super journal
pub const SQLITE_OPEN_NOMUTEX = 0x00008000       // No mutex
pub const SQLITE_OPEN_FULLMUTEX = 0x00010000     // Full mutex
pub const SQLITE_OPEN_SHAREDCACHE = 0x00020000   // Shared cache
