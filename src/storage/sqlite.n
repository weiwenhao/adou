// SQLite type definitions
pub type sqlite3_t = struct{}                    // SQLite database connection
pub type sqlite3_stmt_t = struct{}               // SQLite prepared statement
pub type sqlite3_value_t = struct{}              // SQLite value
type sqlite3_context_t = struct{}            // SQLite context
pub type sqlite3_int64_t = i64                   // SQLite 64-bit integer
pub type sqlite3_uint64_t = u64                  // SQLite 64-bit unsigned integer
type sqlite3_filename_t = anyptr             // SQLite filename
type sqlite3_mutex_t = struct{}              // SQLite mutex
type sqlite3_file_t = struct{}               // SQLite file
type sqlite3_vfs_t = struct{}                // SQLite virtual file system
type sqlite3_backup_t = struct{}             // SQLite backup
type sqlite3_blob_t = struct{}               // SQLite BLOB
type sqlite3_str_t = struct{}                // SQLite string builder

// SQLite callback function types
type sqlite3_callback_t = fn(anyptr, i32, ptr<anyptr>, ptr<anyptr>):i32
type sqlite3_destructor_type_t = fn(anyptr)

// SQLite memory methods structure
type sqlite3_mem_methods_t = struct{
    anyptr x_malloc_func      // malloc function pointer
    anyptr x_free_func        // free function pointer
    anyptr x_realloc_func     // realloc function pointer
    anyptr x_size_func        // size function pointer
    anyptr x_roundup_func     // roundup function pointer
    anyptr x_init_func        // init function pointer
    anyptr x_shutdown_func    // shutdown function pointer
    anyptr p_app_data         // application data
}

