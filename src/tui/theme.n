pub fn syntax_punctuation(): string {return themed_fg('syntax_punctuation', TEXT, '\x1b[38;2;0;0;0m')}

fn thinking_border_color(string thinking): string {
    if thinking == 'minimal' {return themed_fg('thinking_minimal', THINKING_MINIMAL, '\x1b[38;2;118;118;118m')}
    if thinking == 'low' {return themed_fg('thinking_low', THINKING_LOW, '\x1b[38;2;84;125;167m')}
    if thinking == 'medium' {return themed_fg('thinking_medium', THINKING_MEDIUM, '\x1b[38;2;90;128;128m')}
    if thinking == 'high' {return themed_fg('thinking_high', THINKING_HIGH, '\x1b[38;2;135;95;135m')}
    if thinking == 'xhigh' {return themed_fg('thinking_xhigh', THINKING_XHIGH, '\x1b[38;2;139;0;139m')}
    if thinking == 'max' {return themed_fg('thinking_max', THINKING_MAX, '\x1b[38;2;175;0;95m')}
    return themed_fg('thinking_off', THINKING_OFF, '\x1b[38;2;176;176;176m')
}

pub fn fg(string color, string value): string {
    // Restore only the foreground so an enclosing row background survives.
    return color + value + '\x1b[39m'
}

pub fn bg(string color, string value): string {
    return color + value + '\x1b[49m'
}

pub fn bold(string value): string {
    return BOLD + value + '\x1b[22m'
}

pub fn dim(string value): string {
    return dim_color() + value + '\x1b[39m'
}

pub fn muted(string value): string {
    return muted_color() + value + '\x1b[39m'
}

pub fn italic(string value): string {
    return ITALIC + value + '\x1b[23m'
}

pub fn underline(string value): string {
    return UNDERLINE + value + '\x1b[24m'
}

pub fn strikethrough(string value): string {
    return STRIKETHROUGH + value + '\x1b[29m'
}

pub fn cursor(string value): string {
    return INVERSE + value + '\x1b[27m'
}

// Pi exposes inverse independently from cursor styling; diff rendering uses
// it to highlight changed tokens without changing their foreground color.
pub fn inverse(string value): string {
    return INVERSE + value + '\x1b[27m'
}

pub fn border_line(int width): string {
    return fg(border(), repeat('─', width))
}

pub fn editor_border_line(string thinking, bool in_bash_mode, int width): string {
    string color = thinking_border_color(thinking)
    if in_bash_mode {
        color = bash_mode()
    }
    return fg(color, repeat('─', width))
}

pub fn background_line(string color, string value, int width): string {
    int remaining = width - visible_width(value)
    if remaining < 0 {
        remaining = 0
    }
    return color + value + repeat(' ', remaining) + RESET
}

pub fn visible_width(string value): int {
    return text_utils.visible_width(value) catch error {
        return 0
    }
}

fn repeat(string value, int count): string {
    string result = ''
    for int index = 0; index < count; index += 1 {
        result += value
    }
    return result
}
