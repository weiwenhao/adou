import adou.src.tui.text_utils

// Theme variants.  The dark theme is the default; light overrides the
// readability-critical colors (text, muted, surfaces) so a light terminal
// background stays legible.  theme-selector previews by switching variants.
string theme_variant = ''

pub fn set_variant(string name) {
    theme_variant = name == 'light' ? 'light' : 'dark'
}

pub fn variant(): string {
    if theme_variant == '' {
        return 'dark'
    }
    return theme_variant
}

pub fn text(): string {
    return variant() == 'light' ? '\x1b[38;2;50;50;60m' : TEXT_DARK
}

pub fn muted_color(): string {
    return variant() == 'light' ? '\x1b[38;2;110;110;115m' : MUTED_DARK
}

pub fn dim_color(): string {
    return variant() == 'light' ? '\x1b[38;2;140;140;145m' : DIM_COLOR_DARK
}

pub fn accent(): string {
    return variant() == 'light' ? '\x1b[38;2;30;130;120m' : ACCENT_DARK
}

pub fn user_bg(): string {
    return variant() == 'light' ? '\x1b[48;2;235;235;240m' : USER_BG_DARK
}

pub fn selected_bg(): string {
    return variant() == 'light' ? '\x1b[48;2;225;225;230m' : SELECTED_BG_DARK
}

pub fn border(): string {
    return variant() == 'light' ? '\x1b[38;2;70;100;200m' : BORDER_DARK
}

// Pi's built-in dark theme, kept as terminal-native ANSI styling.
pub const RESET = '\x1b[0m'
pub const BOLD = '\x1b[1m'
pub const DIM = '\x1b[2m'
pub const ITALIC = '\x1b[3m'
pub const UNDERLINE = '\x1b[4m'
pub const STRIKETHROUGH = '\x1b[9m'
pub const INVERSE = '\x1b[7m'

const ACCENT_DARK = '\x1b[38;2;138;190;183m'
pub const ACCENT = '\x1b[38;2;138;190;183m'
const BORDER_DARK = '\x1b[38;2;95;135;255m'
pub const BORDER = '\x1b[38;2;95;135;255m'
pub const BORDER_ACCENT = '\x1b[38;2;0;215;255m'
pub const SUCCESS = '\x1b[38;2;181;189;104m'
pub const ERROR = '\x1b[38;2;204;102;102m'
pub const WARNING = '\x1b[38;2;255;255;0m'
const MUTED_DARK = '\x1b[38;2;128;128;128m'
pub const MUTED = '\x1b[38;2;128;128;128m'
const DIM_COLOR_DARK = '\x1b[38;2;102;102;102m'
pub const DIM_COLOR = '\x1b[38;2;102;102;102m'
const TEXT_DARK = '\x1b[38;2;212;212;212m'
pub const TEXT = '\x1b[38;2;212;212;212m'
pub const THINKING = '\x1b[38;2;128;128;128m'
pub const HEADING = '\x1b[38;2;240;198;116m'
pub const LINK = '\x1b[38;2;129;162;190m'
pub const CODE = '\x1b[38;2;138;190;183m'
pub const CODE_BLOCK = '\x1b[38;2;181;189;104m'
pub const CODE_BLOCK_BORDER = '\x1b[38;2;102;102;102m'
const USER_BG_DARK = '\x1b[48;2;52;53;65m'
pub const USER_BG = '\x1b[48;2;52;53;65m'
const SELECTED_BG_DARK = '\x1b[48;2;58;58;74m'
pub const SELECTED_BG = '\x1b[48;2;58;58;74m'
pub const TOOL_PENDING_BG = '\x1b[48;2;40;40;50m'
pub const TOOL_SUCCESS_BG = '\x1b[48;2;40;50;40m'
pub const TOOL_ERROR_BG = '\x1b[48;2;60;40;40m'
pub const THINKING_OFF = '\x1b[38;2;80;80;80m'
pub const THINKING_MINIMAL = '\x1b[38;2;110;110;110m'
pub const THINKING_LOW = '\x1b[38;2;95;135;175m'
pub const THINKING_MEDIUM = '\x1b[38;2;129;162;190m'
pub const THINKING_HIGH = '\x1b[38;2;178;148;187m'
pub const THINKING_XHIGH = '\x1b[38;2;209;131;232m'
pub const THINKING_MAX = '\x1b[38;2;255;95;255m'

pub fn fg(string color, string value): string {
    // Restore only the foreground so an enclosing row background survives.
    return color + value + '\x1b[39m'
}

pub fn bg(string color, string value): string {
    return color + value + '\x1b[49m'
}

pub fn bold(string value): string {
    return BOLD + value + '\x1b[22m'
}

pub fn dim(string value): string {
    return DIM_COLOR + value + '\x1b[39m'
}

pub fn muted(string value): string {
    return MUTED + value + '\x1b[39m'
}

pub fn italic(string value): string {
    return ITALIC + value + '\x1b[23m'
}

pub fn underline(string value): string {
    return UNDERLINE + value + '\x1b[24m'
}

pub fn strikethrough(string value): string {
    return STRIKETHROUGH + value + '\x1b[29m'
}

pub fn cursor(string value): string {
    return INVERSE + value + '\x1b[27m'
}

pub fn border_line(int width): string {
    return fg(BORDER, repeat('─', width))
}

pub fn editor_border_line(string thinking, bool bash_mode, int width): string {
    string color = THINKING_OFF
    if bash_mode {
        color = SUCCESS
    } else if thinking == 'minimal' {
        color = THINKING_MINIMAL
    } else if thinking == 'low' {
        color = THINKING_LOW
    } else if thinking == 'medium' {
        color = THINKING_MEDIUM
    } else if thinking == 'high' {
        color = THINKING_HIGH
    } else if thinking == 'xhigh' {
        color = THINKING_XHIGH
    } else if thinking == 'max' {
        color = THINKING_MAX
    }
    return fg(color, repeat('─', width))
}

pub fn background_line(string color, string value, int width): string {
    int remaining = width - visible_width(value)
    if remaining < 0 {
        remaining = 0
    }
    return color + value + repeat(' ', remaining) + RESET
}

pub fn visible_width(string value): int {
    return text_utils.visible_width(value) catch error {
        return 0
    }
}

#local
fn repeat(string value, int count): string {
    string result = ''
    for int index = 0; index < count; index += 1 {
        result += value
    }
    return result
}
