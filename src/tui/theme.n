pub fn code_block(): string {return themed_fg('md_code_block', CODE_BLOCK, '\x1b[38;2;88;132;88m')}
pub fn code_block_border(): string {return themed_fg('md_code_block_border', MUTED, '\x1b[38;2;108;108;108m')}
