pub fn tool_diff_context(): string {return themed_fg('tool_diff_context', MUTED, '\x1b[38;2;108;108;108m')}
pub fn md_quote(): string {return themed_fg('md_quote', MUTED, '\x1b[38;2;108;108;108m')}
pub fn md_hr(): string {return themed_fg('md_hr', MUTED, '\x1b[38;2;108;108;108m')}
