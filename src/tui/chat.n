import adou.src.agent.session_stream
import adou.src.agent.types as agent_types
import adou.src.ai.types as ai_types
import adou.src.compaction.token_estimate
import adou.src.session.cache_stats
import adou.src.tools.types as tool_types
import adou.src.tui.markdown
import adou.src.tui.keybindings
import adou.src.tui.terminal_image
import adou.src.tui.text_utils
import adou.src.tui.theme
import adou.src.tui.unicode
import fmt
import strings
import syscall
import time

pub type tool_view_t = struct {
    string id
    string name
    string detail
    bool done
    bool is_error
}

pub type chat_t = struct {
    [ai_types.message_t] messages = []
    ref<ai_types.assistant_message_t>? streaming_assistant = null
    [ref<tool_view_t>] active_tools = []
    string model
    string provider
    bool show_provider = true
    string cwd
    string git_branch
    string session_name
    string status
    string error_message
    int compaction_count
    string thinking = 'off'
    int context_window
    bool running
    bool auto_compaction = true
    bool tool_output_expanded
    bool thinking_visible = true
    ref<ai_types.bash_execution_message_t>? active_bash = null
    int spinner_index
    i64 spinner_last_ms
    i64 retry_started_ms = 0
    int retry_delay_ms = 0
    int retry_attempt = 0
    int retry_max_attempts = 0
    int total_input_tokens
    int total_output_tokens
    int total_cache_read
    int total_cache_write
    float total_cost
    float latest_cache_hit_rate = -1.0
    bool context_known = true
    // Pi settings.outputPad: horizontal padding for user messages, assistant
    // messages and thinking (0 or 1, default 1).
    int output_pad = 1
    bool show_images = true
    int image_width_cells = 60
    bool auto_resize_images = true
    // Pi settings.showCacheMissNotices: emit a transcript notice for
    // significant prompt-cache misses after a response.
    bool show_cache_miss_notices
    ref<cache_stats.previous_request_t>? cache_previous = null
    string cache_miss_notice
}

pub fn new(string model, string cwd): ref<chat_t> {
    return new chat_t(model = model, cwd = cwd, active_tools = vec<ref<tool_view_t>>.cap_of(4))
}

pub fn chat_t.configure(&self, int context_window, string thinking) {
    self.context_window = context_window
    self.thinking = thinking == '' ? 'off' : thinking
}

pub fn chat_t.set_auto_compaction(&self, bool enabled) {
    self.auto_compaction = enabled
}

pub fn chat_t.toggle_tool_output(&self): bool {
    self.tool_output_expanded = !self.tool_output_expanded
    return self.tool_output_expanded
}

pub fn chat_t.toggle_thinking_visibility(&self): bool {
    self.thinking_visible = !self.thinking_visible
    return self.thinking_visible
}

pub fn chat_t.load_messages(&self, [ai_types.message_t] messages) {
    self.messages = messages.slice(0, messages.len())
}

pub fn chat_t.set_usage_totals(&self, ai_types.usage_t usage) {
    self.total_input_tokens = usage.input
    self.total_output_tokens = usage.output
    self.total_cache_read = usage.cache_read
    self.total_cache_write = usage.cache_write
    self.total_cost = usage.cost.total
}

pub fn chat_t.set_latest_cache_hit_rate(&self, float rate) {
    self.latest_cache_hit_rate = rate
}

pub fn chat_t.set_context_known(&self, bool known) {
    self.context_known = known
}

pub fn chat_t.set_provider_visibility(&self, bool visible) {
    self.show_provider = visible
}

pub fn chat_t.set_output_pad(&self, int pad) {
    self.output_pad = pad == 0 ? 0 : 1
}

pub fn chat_t.set_image_preferences(&self, bool show, int width_cells, bool auto_resize) {
    self.show_images = show
    self.image_width_cells = width_cells > 0 ? width_cells : 60
    self.auto_resize_images = auto_resize
}

pub fn chat_t.set_show_cache_miss_notices(&self, bool enabled) {
    self.show_cache_miss_notices = enabled
}

pub fn chat_t.apply(&self, session_stream.event_t event): void! {
    if event.kind == session_stream.EVENT_BASH_START {
        self.active_bash = new ai_types.bash_execution_message_t(command = event.bash_command, exclude_from_context = event.bash_exclude_from_context)
        self.running = true
        self.status = 'Running bash...'
        self.error_message = ''
        return
    }
    if event.kind == session_stream.EVENT_BASH_UPDATE {
        if self.active_bash is ref<ai_types.bash_execution_message_t> bash {
            bash.output += event.bash_output
        }
        self.running = true
        self.status = 'Running bash...'
        return
    }
    if event.kind == session_stream.EVENT_BASH_END {
        var bash = new ai_types.bash_execution_message_t(command = event.bash_command, output = event.bash_output, exit_code = event.bash_exit_code, cancelled = event.bash_cancelled, truncated = event.bash_truncated, full_output_path = event.bash_full_output_path, exclude_from_context = event.bash_exclude_from_context)
        ai_types.message_t message = bash
        self.messages.push(message)
        self.active_bash = null
        // Pi keeps the exit status on the bash message itself; the global
        // status row returns to idle so the footer does not echo the code.
        if bash.cancelled {
            self.status = ''
        } else if event.bash_timed_out {
            self.status = ''
        } else if bash.exit_code >= 0 && bash.exit_code != 0 {
            self.status = ''
        } else {
            self.status = ''
        }
        self.running = false
        return
    }
    if event.kind == session_stream.EVENT_COMPACTION_START {
        self.running = true
        self.status = 'Compacting context...'
        return
    }
    if event.kind == session_stream.EVENT_COMPACTION_END {
        if event.error_message != '' {
            self.error_message = event.error_message
            self.status = 'Compaction failed'
        } else if !event.aborted {
            self.compaction_count += 1
            self.status = fmt.sprintf('Context compacted: %d -> %d tokens', event.tokens_before, event.estimated_tokens_after)
        }
        return
    }
    if event.kind == session_stream.EVENT_RETRY_START {
        self.running = true
        self.retry_started_ms = time.now().ms_timestamp()
        self.retry_delay_ms = event.retry_delay_ms
        self.retry_attempt = event.retry_attempt
        self.retry_max_attempts = event.retry_max_attempts
        self.status = fmt.sprintf('Retrying request (%d/%d) in %.1fs...', event.retry_attempt, event.retry_max_attempts, event.retry_delay_ms as float / 1000.0)
        self.error_message = ''
        return
    }
    if event.kind == session_stream.EVENT_RETRY_END {
        self.retry_started_ms = 0
        self.retry_delay_ms = 0
        self.retry_attempt = 0
        self.retry_max_attempts = 0
        if event.retry_success {
            self.status = 'Retrying request...'
        } else {
            self.error_message = event.retry_final_error
            self.status = event.retry_final_error == 'Retry cancelled' ? 'Retry cancelled' : 'Retry failed'
        }
        return
    }
    if event.kind == session_stream.EVENT_SUMMARIZATION_RETRY_SCHEDULED {
        self.running = true
        self.error_message = event.retry_error_message
        self.status = fmt.sprintf('Retrying summary (%d/%d) in %.1fs...', event.retry_attempt, event.retry_max_attempts, event.retry_delay_ms as float / 1000.0)
        return
    }
    if event.kind == session_stream.EVENT_SUMMARIZATION_RETRY_ATTEMPT_START {
        self.running = true
        self.error_message = ''
        self.status = event.retry_source == 'branchSummary' ? 'Summarizing branch...' : 'Compacting context...'
        return
    }
    if event.kind == session_stream.EVENT_SUMMARIZATION_RETRY_FINISHED {
        return
    }
    if event.kind == session_stream.EVENT_BRANCH_SUMMARY_START {
        self.running = true
        self.status = 'Summarizing branch...'
        self.error_message = ''
        return
    }
    if event.kind == session_stream.EVENT_BRANCH_SUMMARY_END {
        if event.error_message != '' {
            self.error_message = event.error_message
            self.status = 'Branch summarization failed'
        } else if event.aborted {
            self.status = 'Branch summarization cancelled'
        } else {
            self.status = 'Branch summarized'
        }
        return
    }
    if event.kind == session_stream.EVENT_SESSION_END {
        self.running = false
        self.status = ''
        return
    }
    if !event.has_agent_event {
        return
    }
    var agent_event = event.agent_event
    if agent_event.kind == agent_types.EVENT_AGENT_START || agent_event.kind == agent_types.EVENT_TURN_START {
        self.running = true
        self.status = 'Thinking...'
        self.error_message = ''
        self.cache_miss_notice = ''
        return
    }
    if agent_event.kind == agent_types.EVENT_AGENT_END {
        self.running = false
        self.status = ''
        return
    }
    if agent_event.kind == agent_types.EVENT_MESSAGE_START {
        if agent_event.user_message is ref<ai_types.user_message_t> user {
            ai_types.message_t message = user
            self.messages.push(message)
        }
        return
    }
    if agent_event.kind == agent_types.EVENT_MESSAGE_UPDATE {
        if agent_event.assistant_message is ref<ai_types.assistant_message_t> assistant {
            self.streaming_assistant = assistant
        }
        return
    }
    if agent_event.kind == agent_types.EVENT_MESSAGE_END {
        if agent_event.assistant_message is ref<ai_types.assistant_message_t> assistant {
            ai_types.message_t message = assistant
            self.messages.push(message)
            self.streaming_assistant = null
            self.status = assistant.stop_reason == ai_types.STOP_ERROR ? 'Model error' : 'Thinking...'
            self.update_cache_miss_notice(assistant)
        } else if agent_event.tool_message is ref<ai_types.tool_result_message_t> tool {
            ai_types.message_t message = tool
            self.messages.push(message)
            self.remove_tool(tool.tool_call_id)
        }
        return
    }
    if agent_event.kind == agent_types.EVENT_TOOL_START {
        self.active_tools.push(new tool_view_t(id = agent_event.tool_call_id, name = agent_event.tool_name))
        self.status = 'Running ' + agent_event.tool_name + '...'
        return
    }
    if agent_event.kind == agent_types.EVENT_TOOL_UPDATE {
        ref<tool_view_t>? active = self.find_tool(agent_event.tool_call_id)
        if active is ref<tool_view_t> tool {
            tool.detail = tool_result_text(agent_event.tool_result)
        }
        return
    }
    if agent_event.kind == agent_types.EVENT_TOOL_END {
        ref<tool_view_t>? active = self.find_tool(agent_event.tool_call_id)
        if active is ref<tool_view_t> tool {
            tool.detail = tool_result_text(agent_event.tool_result)
            tool.done = true
            tool.is_error = agent_event.is_error
        }
        return
    }
    if agent_event.kind == agent_types.EVENT_TURN_END {
        self.status = 'Thinking...'
    }
}

// Pi maybeShowCacheMissNotice: after a completed assistant message, state
// only observable facts (the miss, a model switch, or an idle gap past the
// cache TTL).  The threshold mirrors Pi's addCacheMissNotice.
pub fn chat_t.update_cache_miss_notice(&self, ref<ai_types.assistant_message_t> assistant) {
    if !self.show_cache_miss_notices {
        self.cache_miss_notice = ''
        return
    }
    var miss = cache_stats.detect_miss(self.cache_previous, assistant)
    if miss is ref<cache_stats.cache_miss_t> miss_value {
        if miss_value.missed_tokens >= 20000 || miss_value.missed_cost >= 0.1 {
            string label = 'Cache miss'
            if miss_value.model_changed {
                label = 'Cache miss after model switch'
            } else if miss_value.idle_ms >= cache_stats.CACHE_TTL_MS {
                label = fmt.sprintf('Cache miss after %dm idle', miss_value.idle_ms / 60000)
            }
            string cost = miss_value.missed_cost >= 0.01 ? fmt.sprintf(' (~$%.2f)', miss_value.missed_cost) : ''
            self.cache_miss_notice = fmt.sprintf('%s: %d tokens re-billed%s', label, miss_value.missed_tokens, cost)
        } else {
            self.cache_miss_notice = ''
        }
    } else {
        self.cache_miss_notice = ''
    }
    self.cache_previous = cache_stats.as_previous_request(assistant, miss is ref<cache_stats.cache_miss_t>)
}

pub fn chat_t.render(&self, int width): [string]! {
    if width <= 0 {
        throw errorf('chat width must be positive')
    }
    [string] result = vec<string>.cap_of(64)
    for message in self.messages {
        result.append(render_message_lines(message, width, self.tool_output_expanded, self.thinking_visible, self.output_pad, self.show_images, self.image_width_cells))
    }
    if self.streaming_assistant is ref<ai_types.assistant_message_t> assistant {
        result.append(render_assistant_lines(assistant, width, true, self.thinking_visible, self.output_pad))
    }
    if self.active_bash is ref<ai_types.bash_execution_message_t> bash {
        result.append(render_active_bash_lines(bash, width, self.spinner_index))
    }
    for tool in self.active_tools {
        string marker = tool.done ? '✓ ' : spinner_frame(self.spinner_index) + ' '
        string color = tool.is_error ? theme.error_color() : tool.done ? theme.success() : theme.accent()
        string line = color + marker + theme.fg(theme.tool_title(), theme.bold(tool.name))
        if tool.detail != '' {
            // A renderer line must never contain a physical newline.  Pi's
            // tool component owns multiline output as separate rows; the
            // collapsed preview remains one row so cursor accounting stays
            // synchronized with the terminal during streaming updates.
            string preview = tool.detail.replace('\r\n', ' ').replace('\r', ' ').replace('\n', ' ')
            int detail_width = width - text_utils.visible_width(line) - 1
            if detail_width < 1 {detail_width = 1}
            line += ' ' + theme.fg(theme.tool_output(), text_utils.truncate_to_width(preview, detail_width, '...', false))
        }
        string background = tool.is_error ? theme.tool_error_bg() : tool.done ? theme.tool_success_bg() : theme.tool_pending_bg()
        result.push(colored_row(background, line, width))
        if self.tool_output_expanded && tool.detail != '' {
            result.append(render_tool_body(tool.detail, width))
        }
    }
    if self.error_message != '' {
        result.append(wrapped_lines(theme.fg(theme.error_color(), 'Error: ' + self.error_message), width))
    }
    if self.cache_miss_notice != '' {
        result.append(wrapped_lines(theme.fg(theme.warning(), self.cache_miss_notice), width))
    }
    if self.status != '' {
        // Pi's countdown timer: the retry status re-renders the remaining
        // seconds on every frame while the retry backoff is pending.
        if self.retry_started_ms > 0 && self.retry_delay_ms > 0 {
            i64 now = time.now().ms_timestamp()
            int elapsed = (now - self.retry_started_ms) as int
            int remaining = self.retry_delay_ms - elapsed
            if remaining < 0 {
                remaining = 0
            }
            self.status = fmt.sprintf('Retrying request (%d/%d) in %.1fs...', self.retry_attempt, self.retry_max_attempts, remaining as float / 1000.0)
        }
        result.append(render_status_lines(self.status, self.running, width, self.spinner_index))
        if self.running {
            i64 now = time.now().ms_timestamp()
            if self.spinner_last_ms == 0 || now - self.spinner_last_ms >= 80 {
                self.spinner_index = (self.spinner_index + 1) % 10
                self.spinner_last_ms = now
            }
        }
    }
    return result
}

// The footer is a sibling of the editor in Pi, not part of the transcript.
// Keeping it separate lets the session view preserve Pi's vertical order:
// transcript/status, spacer, editor, then cwd and usage/model metadata.
pub fn chat_t.render_footer(&self, int width): [string]! {
    if width <= 0 {
        throw errorf('footer width must be positive')
    }
    [string] result = []
    if self.model == '' && self.cwd == '' {
        return result
    }
    string cwd_display = shorten_cwd(self.cwd)
    if self.git_branch != '' {
        cwd_display += ' (' + self.git_branch + ')'
    }
    if self.session_name != '' {
        cwd_display += ' • ' + self.session_name
    }
    string cwd_line = theme.fg(theme.dim_color(), text_utils.truncate_to_width(cwd_display, width, '...', false))
    result.append(wrapped_lines(cwd_line, width))
    [string] stats = []
    if self.total_input_tokens > 0 {stats.push('↑' + format_tokens(self.total_input_tokens))}
    if self.total_output_tokens > 0 {stats.push('↓' + format_tokens(self.total_output_tokens))}
    if self.total_cache_read > 0 {stats.push('R' + format_tokens(self.total_cache_read))}
    if self.total_cache_write > 0 {stats.push('W' + format_tokens(self.total_cache_write))}
    if (self.total_cache_read > 0 || self.total_cache_write > 0) && self.latest_cache_hit_rate >= 0.0 {
        stats.push(fmt.sprintf('CH%.1f%%', self.latest_cache_hit_rate))
    }
    if self.total_cost > 0.0 {stats.push(fmt.sprintf('$%.3f', self.total_cost))}
    if self.context_window > 0 {
        string context_display = ''
        if !self.context_known {
            context_display = '?/' + format_tokens(self.context_window) + (self.auto_compaction ? ' (auto)' : '')
        } else {
            var estimate = token_estimate.estimate_context_tokens(self.messages)
            float percent_value = estimate.tokens as float * 100.0 / self.context_window as float
            context_display = format_percent(estimate.tokens, self.context_window) + '/' + format_tokens(self.context_window) + (self.auto_compaction ? ' (auto)' : '')
            if percent_value > 90.0 {
                context_display = theme.fg(theme.error_color(), context_display)
            } else if percent_value > 70.0 {
                context_display = theme.fg(theme.warning(), context_display)
            }
        }
        stats.push(context_display)
    }
    string left = strings.join(stats, ' ')
    string right = self.model != '' ? self.model : 'no-model'
    right += self.thinking == 'off' ? ' • thinking off' : ' • ' + self.thinking
    if self.provider != '' && self.show_provider {
        right = '(' + self.provider + ') ' + right
    }
    int left_width = text_utils.visible_width(left)
    int right_width = text_utils.visible_width(right)
    string footer = left
    if left_width + 2 + right_width <= width {
        footer += repeat_spaces(width - left_width - right_width) + right
    } else if left == '' && right_width <= width {
        footer = repeat_spaces(width - right_width) + right
    } else if left_width < width {
        int available = width - left_width - 2
        string fitted = available > 0 ? text_utils.truncate_to_width(right, available, '', false) : ''
        footer += repeat_spaces(width - left_width - text_utils.visible_width(fitted)) + fitted
    }
    result.push(theme.fg(theme.dim_color(), text_utils.truncate_to_width(footer, width, '...', false)))
    return result
}

pub fn chat_t.clear(&self) {
    self.messages = []
    self.streaming_assistant = null
    self.active_bash = null
    self.active_tools = vec<ref<tool_view_t>>.cap_of(4)
    self.status = ''
    self.error_message = ''
    self.compaction_count = 0
    self.running = false
    self.spinner_index = 0
    self.spinner_last_ms = 0
    self.total_input_tokens = 0
    self.total_output_tokens = 0
    self.total_cache_read = 0
    self.total_cache_write = 0
    self.total_cost = 0.0
    self.latest_cache_hit_rate = -1.0
    self.context_known = true
}

// Pi parseSkillBlock: detect a /skill expansion user message and extract
// the invoked skill name for the collapsed invocation display.
fn skill_invocation_name(string content): string {
    if !content.starts_with('<skill name="') {
        return ''
    }
    // find() has no start offset; scan for the closing quote manually.
    int end_quote = -1
    for int cursor = 13; cursor < content.len(); cursor += 1 {
        if content[cursor] == '"'.char() {
            end_quote = cursor
            break
        }
    }
    if end_quote < 13 {
        return ''
    }
    if !content.slice(end_quote, content.len()).starts_with('" location="') || content.find('\n</skill>') < 0 {
        return ''
    }
    return content.slice(13, end_quote)
}

fn skill_block_content(string content): string {
    int opening = content.find('>\n')
    int closing = content.find('\n</skill>')
    if opening < 0 || closing <= opening {return ''}
    return content.slice(opening + 2, closing)
}

fn skill_block_user_message(string content): string {
    int closing = content.find('\n</skill>')
    if closing < 0 {return ''}
    int after = closing + 9
    if after + 2 > content.len() || content.slice(after, after + 2) != '\n\n' {return ''}
    return content.slice(after + 2, content.len()).trim([' ', '\t', '\n', '\r'])
}

fn render_custom_markdown_box(string content, int width, string background): [string]! {
    return render_markdown_rows(content, width, background, theme.custom_message_text(), 1)
}

fn render_summary_box(string kind, string summary, int tokens_before, bool expanded, int width): [string]! {
    [string] result = []
    string background = theme.custom_message_bg()
    result.push('')
    result.push(colored_row(background, '', width))
    result.push(colored_row(background, ' ' + theme.fg(theme.custom_message_label(), theme.bold('[' + kind + ']')), width))
    result.push(colored_row(background, '', width))
    if expanded {
        string header = kind == 'compaction' ? '**Compacted from ' + grouped_integer(tokens_before) + ' tokens**' : '**Branch Summary**'
        result.append(render_custom_markdown_box(header + '\n\n' + summary, width, background))
    } else {
        string expand_key = keybindings.key_text(keybindings.current(), keybindings.APP_TOOLS_EXPAND)
        string text = kind == 'compaction' ? 'Compacted from ' + grouped_integer(tokens_before) + ' tokens (' : 'Branch summary ('
        string line = theme.fg(theme.custom_message_text(), text) + theme.fg(theme.dim_color(), expand_key) + theme.fg(theme.custom_message_text(), ' to expand)')
        result.push(colored_row(background, ' ' + line, width))
    }
    result.push(colored_row(background, '', width))
    return result
}

fn grouped_integer(int value): string {
    string digits = fmt.sprintf('%d', value)
    string result = ''
    int first = digits.len() % 3
    if first == 0 {first = 3}
    for int index = 0; index < digits.len(); index += 1 {
        if index > 0 && (index - first) % 3 == 0 {result += ','}
        result += digits.slice(index, index + 1)
    }
    return result
}

fn render_message_lines(ai_types.message_t message, int width, bool tool_output_expanded, bool thinking_visible, int output_pad, bool show_images, int image_width_cells): [string]! {
    [string] result = vec<string>.cap_of(8)
    if message is ref<ai_types.user_message_t> user {
        // B5: Pi SkillInvocationMessage collapsed view — a user message that
        // is a /skill expansion renders as a compact [skill] name row on the
        // custom-message background instead of flooding the transcript with
        // the full skill block (which still goes to the model verbatim).
        string skill_name = skill_invocation_name(user.content)
        if skill_name != '' {
            string skill_bg = theme.custom_message_bg()
            result.push('')
            result.push(colored_row(skill_bg, '', width) catch e {''})
            string label = theme.fg(theme.custom_message_label(), theme.bold('[skill]'))
            string expand_key = keybindings.key_text(keybindings.current(), keybindings.APP_TOOLS_EXPAND)
            if tool_output_expanded {
                result.push(colored_row(skill_bg, ' ' + label, width) catch e {''})
                string expanded = '**' + skill_name + '**\n\n' + skill_block_content(user.content)
                result.append(render_custom_markdown_box(expanded, width, skill_bg))
            } else {
                string line = label + ' ' + theme.fg(theme.custom_message_text(), skill_name) + theme.fg(theme.dim_color(), ' (' + expand_key + ' to expand)')
                result.push(colored_row(skill_bg, ' ' + line, width) catch e {''})
            }
            result.push(colored_row(skill_bg, '', width) catch e {''})
            string trailing_user_message = skill_block_user_message(user.content)
            if trailing_user_message != '' {
                result.push('')
                result.push(colored_row(theme.user_bg(), '', width))
                result.append(render_markdown_rows(trailing_user_message, width, theme.user_bg(), theme.user_text(), output_pad))
                result.push(colored_row(theme.user_bg(), '', width))
            }
            return result
        }
        // Pi renders user messages through Markdown inside a Box with one
        // column of horizontal and one row of vertical padding. Keep the
        // complete row on the user background (including blank lines).
        result.push(colored_row(theme.user_bg(), '', width))
        result.append(render_markdown_rows(user.content, width, theme.user_bg(), theme.user_text(), output_pad))
        result.push(colored_row(theme.user_bg(), '', width))
    } else if message is ref<ai_types.assistant_message_t> assistant {
        result.append(render_assistant_lines(assistant, width, false, thinking_visible, output_pad))
    } else if message is ref<ai_types.tool_result_message_t> tool {
        string color = tool.is_error ? theme.error_color() : theme.success()
        string prefix = color + (tool.is_error ? '✗ ' : '✓ ') + theme.fg(theme.tool_title(), theme.bold(tool.tool_name))
        string body = tool_message_text(*tool)
        string preview = body.replace('\r\n', '\n').replace('\r', '\n').replace('\n', ' ')
        string line = prefix + (preview != '' ? ' ' + theme.fg(theme.tool_output(), preview) : '')
        string background = tool.is_error ? theme.tool_error_bg() : theme.tool_success_bg()
        result.push(colored_row(background, line, width))
        if body != '' && tool_output_expanded {
            result.append(render_tool_body(body, width))
        }
        result.append(render_tool_images(*tool, width, show_images, image_width_cells))
    } else if message is ref<ai_types.compaction_summary_message_t> summary {
        result.append(render_summary_box('compaction', summary.summary, summary.tokens_before, tool_output_expanded, width))
    } else if message is ref<ai_types.branch_summary_message_t> summary {
        result.append(render_summary_box('branch', summary.summary, 0, tool_output_expanded, width))
    } else if message is ref<ai_types.custom_message_t> custom {
        if custom.display {
            string custom_bg = theme.custom_message_bg()
            result.push('')
            result.push(colored_row(custom_bg, '', width))
            result.push(colored_row(custom_bg, ' ' + theme.fg(theme.custom_message_label(), theme.bold('[' + custom.custom_type + ']')), width))
            result.push(colored_row(custom_bg, '', width))
            result.append(render_custom_markdown_box(custom.content, width, custom_bg))
            result.push(colored_row(custom_bg, '', width))
        }
    } else if message is ref<ai_types.bash_execution_message_t> bash {
        result.append(render_bash_lines(bash, width, tool_output_expanded))
    }
    return result
}

// Render image attachments produced by read/vision tools.  Image escape
// sequences occupy terminal rows themselves; blank rows reserve that space so
// the diff renderer keeps its cursor accounting aligned with the emulator.
fn render_tool_images(ai_types.tool_result_message_t tool, int width, bool show_images, int image_width_cells): [string]! {
    [string] result = []
    for image in tool.images {
        if !show_images {
            result.push(theme.fg(theme.dim_color(), '[Image hidden by settings]'))
            continue
        }
        var dimensions = terminal_image.get_image_dimensions(image.data, image.mime_type)
        if dimensions is terminal_image.image_dimensions_t known {
            var rendered = terminal_image.render_image(image.data, known, image_width_cells < width ? image_width_cells : width, 0, terminal_image.image_id_for(image.data), true)
            if rendered is terminal_image.image_render_result_t image_result {
                result.push(image_result.sequence)
                for int row = 1; row < image_result.rows; row += 1 {
                    result.push('')
                }
                continue
            }
            result.push(theme.fg(theme.dim_color(), terminal_image.image_fallback(image.mime_type, known, '')))
        } else {
            result.push(theme.fg(theme.dim_color(), terminal_image.image_fallback(image.mime_type, null, '')))
        }
    }
    return result
}

// Pi's bash-execution rendering: collapsed state shows the last few visual
// lines with an expand hint, the truncated flag surfaces the full output
// path, and the exit status is a short inline footer.
const BASH_PREVIEW_VISUAL_LINES = 20
// Expanded tool output is still a viewport aid, not a second file viewer.
// Keep rendering bounded while preserving both edges so read continuation
// hints and command tails remain visible. The full result stays in context.
const TOOL_BODY_MAX_PHYSICAL_LINES = 200

fn render_bash_lines(ref<ai_types.bash_execution_message_t> bash, int width, bool expanded): [string]! {
    [string] result = vec<string>.cap_of(8)
    string color = bash.exclude_from_context ? theme.dim_color() : theme.bash_mode()
    result.push('')
    result.push(theme.fg(color, text_utils.truncate_to_width('$ ' + bash.command, width, '...', false)))
    string body = bash.output.replace('\r\n', '\n').replace('\r', '\n')
    if body != '' {
        string theme_variant = theme.variant()
        if !expanded {
            int skipped = bash.collapsed_render_skipped
            [string] body_rows = bash.collapsed_render_rows
            if bash.collapsed_render_width != width || bash.collapsed_render_theme != theme_variant || body_rows.len() == 0 {
                var truncated = text_utils.truncate_visual_lines(body, width, BASH_PREVIEW_VISUAL_LINES)
                skipped = truncated[1]
                body_rows = []
                for line in truncated[0].split('\n') {
                    body_rows.append(wrapped_lines(theme.fg(theme.tool_output(), line), width))
                }
                bash.collapsed_render_rows = body_rows
                bash.collapsed_render_width = width
                bash.collapsed_render_skipped = skipped
                bash.collapsed_render_theme = theme_variant
            }
            if skipped > 0 {
                result.push(theme.fg(theme.dim_color(), fmt.sprintf('... (%d more lines, press Ctrl+O to expand)', skipped)))
            }
            result.append(body_rows)
        } else {
            [string] body_rows = bash.expanded_render_rows
            if bash.expanded_render_width != width || bash.expanded_render_theme != theme_variant || body_rows.len() == 0 {
                body_rows = render_bounded_bash_body(body, width)
                bash.expanded_render_rows = body_rows
                bash.expanded_render_width = width
                bash.expanded_render_theme = theme_variant
            }
            result.append(body_rows)
        }
    } else {
        result.push(theme.fg(theme.tool_output(), '(no output)'))
    }
    if bash.truncated && bash.full_output_path != '' {
        result.append(wrapped_lines(theme.fg(theme.dim_color(), 'Output truncated. Full output: ' + bash.full_output_path), width))
    }
    string footer = ''
    if bash.cancelled {
        footer = '(cancelled)'
    } else if bash.exit_code >= 0 && bash.exit_code != 0 {
        footer = fmt.sprintf('(exit %d)', bash.exit_code)
    }
    if footer != '' {
        result.append(wrapped_lines(theme.fg(theme.error_color(), footer), width))
    }
    return result
}

fn render_bounded_bash_body(string body, int width): [string]! {
    [string] lines = body.split('\n')
    int head_limit = TOOL_BODY_MAX_PHYSICAL_LINES / 2
    int tail_limit = TOOL_BODY_MAX_PHYSICAL_LINES - head_limit
    [string] head_rows = vec<string>.cap_of(head_limit)
    [string] tail_rows = vec<string>.cap_of(tail_limit)
    int total_rows = 0
    for line in lines {
        var wrapped = wrapped_lines(theme.fg(theme.tool_output(), line), width)
        for row in wrapped {
            if total_rows < head_limit {
                head_rows.push(row)
            } else {
                tail_rows.push(row)
                if tail_rows.len() > tail_limit {
                    tail_rows = tail_rows.slice(1, tail_rows.len())
                }
            }
            total_rows += 1
        }
    }
    return finish_bounded_rows(head_rows, tail_rows, total_rows, TOOL_BODY_MAX_PHYSICAL_LINES)
}

fn render_active_bash_lines(ref<ai_types.bash_execution_message_t> bash, int width, int spinner_index): [string]! {
    [string] result = vec<string>.cap_of(24)
    string color = bash.exclude_from_context ? theme.dim_color() : theme.bash_mode()
    result.push('')
    result.push(theme.fg(color, text_utils.truncate_to_width('$ ' + bash.command, width, '...', false)))
    string normalized = bash.output.replace('\r\n', '\n').replace('\r', '\n')
    if normalized != '' {
        var truncated = text_utils.truncate_visual_lines(normalized, width, BASH_PREVIEW_VISUAL_LINES)
        int skipped = truncated[1]
        if skipped > 0 {
            result.push(theme.fg(theme.dim_color(), fmt.sprintf('... (%d earlier lines)', skipped)))
        }
        for line in truncated[0].split('\n') {
            result.append(wrapped_lines(theme.fg(theme.tool_output(), line), width))
        }
    }
    result.append(wrapped_lines(theme.fg(color, spinner_frame(spinner_index) + ' Running... (escape to cancel)'), width))
    return result
}

fn render_assistant_lines(ref<ai_types.assistant_message_t> assistant, int width, bool streaming, bool thinking_visible, int output_pad): [string]! {
    [string] result = vec<string>.cap_of(16)
    bool had_content = false
    bool had_tool_calls = false
    bool has_visible_content = false
    for block in assistant.content {
        if block is ref<ai_types.text_content_t> text {
            if text.text.trim([' ', '\t', '\n', '\r']) != '' {
                has_visible_content = true
            }
        } else if block is ref<ai_types.thinking_content_t> thinking {
            if thinking.thinking.trim([' ', '\t', '\n', '\r']) != '' {
                has_visible_content = true
            }
        } else if block is ref<ai_types.tool_call_t> {
            had_tool_calls = true
        }
    }
    // Pi gives assistant output one blank line of breathing room.  Tool calls
    // are rendered by the tool execution component, so they do not create an
    // extra assistant block of their own.
    if has_visible_content {
        result.push('')
    }
    int index = 0
    for index < assistant.content.len() {
        var block = assistant.content[index]
        if block is ref<ai_types.text_content_t> text {
            string value = text.text.trim([' ', '\t', '\n', '\r'])
            if value != '' {
                result.append(render_markdown_rows(value, width, '', theme.text(), output_pad))
                had_content = true
            }
            index += 1
            continue
        }
        if block is ref<ai_types.thinking_content_t> {
            [string] thinking_blocks = []
            for index < assistant.content.len() {
                var next = assistant.content[index]
                if !(next is ref<ai_types.thinking_content_t>) {
                    break
                }
                var thinking_block = next as ref<ai_types.thinking_content_t>
                string value = thinking_block.thinking.trim([' ', '\t', '\n', '\r'])
                if value != '' {
                    thinking_blocks.push(value)
                }
                index += 1
            }
            if thinking_blocks.len() > 0 {
                string value = thinking_visible ? strings.join(thinking_blocks, '\n\n') : 'Thinking...'
                result.append(render_padded_text(theme.italic(theme.fg(theme.thinking_text(), value)), width, output_pad))
                had_content = true
                bool has_visible_after = false
                for int after = index; after < assistant.content.len(); after += 1 {
                    var after_block = assistant.content[after]
                    if after_block is ref<ai_types.text_content_t> after_text {
                        if after_text.text.trim([' ', '\t', '\n', '\r']) != '' {
                            has_visible_after = true
                            break
                        }
                    }
                    if after_block is ref<ai_types.thinking_content_t> after_thinking {
                        if after_thinking.thinking.trim([' ', '\t', '\n', '\r']) != '' {
                            has_visible_after = true
                            break
                        }
                    }
                }
                if has_visible_after {
                    result.push('')
                }
            }
            continue
        }
        // Tool calls are intentionally consumed without an assistant text row;
        // the active/done tool rows below carry their name and result.
        index += 1
    }
    // Pi surfaces terminal failures after any partial text.  Tool calls own
    // their errors in the tool-result component, so avoid duplicating those
    // messages here.
    if !streaming {
        if assistant.stop_reason == ai_types.STOP_LENGTH {
            result.push('')
            result.append(render_padded_text(theme.fg(theme.error_color(), 'Error: Model stopped because it reached the maximum output token limit. The response may be incomplete.'), width, output_pad))
        } else if !had_tool_calls && assistant.stop_reason == ai_types.STOP_ABORTED {
            string message = assistant.error_message
            if message == '' || message == 'Request was aborted' {
                message = 'Operation aborted'
            }
            result.push('')
            result.append(render_padded_text(theme.fg(theme.error_color(), message), width, output_pad))
        } else if !had_tool_calls && assistant.stop_reason == ai_types.STOP_ERROR {
            string message = assistant.error_message == '' ? 'Unknown error' : 'Error: ' + assistant.error_message
            result.push('')
            result.append(render_padded_text(theme.fg(theme.error_color(), message), width, output_pad))
        } else if !had_content && assistant.error_message != '' {
            result.append(render_padded_text(theme.fg(theme.error_color(), assistant.error_message), width, output_pad))
        }
    }
    if streaming && had_content {
        result.push(theme.fg(theme.accent(), '▌'))
    }
    return result
}

fn render_markdown_rows(string value, int width, string background, string foreground, int output_pad): [string]! {
    int content_width = width - 2 * output_pad
    if content_width < 1 {
        content_width = 1
    }
    var markdown_lines = markdown.render_with_default(value, content_width, foreground)
    [string] result = vec<string>.cap_of(markdown_lines.len())
    for line in markdown_lines {
        string padded = pad_terminal_line(pad_sides(line, output_pad), width)
        result.push(background == '' ? padded : theme.background_line(background, padded, width))
    }
    return result
}

fn render_padded_text(string value, int width, int output_pad): [string]! {
    int content_width = width - 2 * output_pad
    if content_width < 1 {
        content_width = 1
    }
    var wrapped = text_utils.wrap_text_with_ansi(value, content_width)
    [string] result = vec<string>.cap_of(wrapped.len())
    for line in wrapped {
        result.push(pad_terminal_line(pad_sides(line, output_pad), width))
    }
    return result
}

// Pi outputPad: one column of horizontal padding (1, default) or none (0).
fn pad_sides(string value, int output_pad): string {
    return output_pad == 0 ? value : ' ' + value + ' '
}

fn pad_terminal_line(string value, int width): string! {
    string fitted = value
    if text_utils.visible_width(fitted) > width {
        fitted = text_utils.truncate_to_width(fitted, width, '...', false)
    }
    int remaining = width - text_utils.visible_width(fitted)
    return fitted + repeat_spaces(remaining > 0 ? remaining : 0)
}

fn render_status_lines(string status, bool running, int width, int spinner_index): [string]! {
    string prefix = running ? theme.fg(theme.accent(), spinner_frame(spinner_index) + ' ') : ''
    return wrapped_lines(prefix + theme.fg(theme.muted_color(), status), width)
}

fn spinner_frame(int index): string {
    [string] frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    int normalized = index % frames.len()
    if normalized < 0 {normalized += frames.len()}
    return frames[normalized]
}

fn colored_row(string background, string line, int width): string! {
    string fitted = line
    if text_utils.visible_width(fitted) > width {
        fitted = text_utils.truncate_to_width(fitted, width, '...', false)
    }
    return theme.background_line(background, fitted, width)
}

fn shorten_cwd(string cwd): string {
    string home = syscall.get_env('HOME')
    if home != '' && cwd == home {
        return '~'
    }
    if home != '' && cwd.starts_with(home + '/') {
        return '~' + cwd.slice(home.len(), cwd.len())
    }
    return cwd
}

fn format_tokens(int count): string {
    if count < 1000 {return fmt.sprintf('%d', count)}
    if count < 10000 {return fmt.sprintf('%.1fk', count as float / 1000.0)}
    if count < 1000000 {return fmt.sprintf('%dk', (count + 500) / 1000)}
    if count < 10000000 {return fmt.sprintf('%.1fM', count as float / 1000000.0)}
    return fmt.sprintf('%dM', (count + 500000) / 1000000)
}

fn format_percent(int tokens, int context_window): string {
    int tenths = context_window > 0 ? tokens * 1000 / context_window : 0
    return fmt.sprintf('%d.%d%%', tenths / 10, tenths % 10)
}

fn repeat_spaces(int count): string {
    string result = ''
    for int index = 0; index < count; index += 1 {
        result += ' '
    }
    return result
}

fn wrapped_lines(string text, int width): [string]! {
    return text_utils.wrap_text_with_ansi(text, width)
}

fn tool_result_text(tool_types.tool_result_t result): string {
    string text = ''
    for content in result.content {
        if text != '' {
            text += '\n'
        }
        text += content.text
    }
    return text
}

// Pi's tool result diff rendering: context is muted, additions/removals are
// colored, and a single removed/added pair highlights changed words using
// inverse video.
fn render_tool_body(string body, int width): [string]! {
    [string] lines = body.replace('\r\n', '\n').replace('\r', '\n').split('\n')
    bool is_diff = looks_like_diff(lines)
    [string] display_lines = is_diff ? render_diff_lines(lines) : []
    if !is_diff {
        for line in lines {
            display_lines.push(theme.fg(theme.tool_output(), line))
        }
    }
    int head_limit = TOOL_BODY_MAX_PHYSICAL_LINES / 2
    int tail_limit = TOOL_BODY_MAX_PHYSICAL_LINES - head_limit
    [string] head_rows = vec<string>.cap_of(head_limit)
    [string] tail_rows = vec<string>.cap_of(tail_limit)
    int total_rows = 0
    for line in display_lines {
        string styled_line = '  ' + line
        var wrapped = wrapped_lines(styled_line, width)
        for row in wrapped {
            if total_rows < head_limit {
                head_rows.push(row)
            } else {
                tail_rows.push(row)
                if tail_rows.len() > tail_limit {
                    tail_rows = tail_rows.slice(1, tail_rows.len())
                }
            }
            total_rows += 1
        }
    }
    return finish_bounded_rows(head_rows, tail_rows, total_rows, TOOL_BODY_MAX_PHYSICAL_LINES)
}

fn finish_bounded_rows([string] head_rows, [string] tail_rows, int total_rows, int limit): [string]! {
    [string] result = vec<string>.cap_of(limit + 1)
    result.append(head_rows)
    if total_rows > limit {
        result.push(theme.fg(theme.muted_color(), fmt.sprintf('... (%d physical lines omitted from display)', total_rows - limit)))
    }
    result.append(tail_rows)
    return result
}

fn looks_like_diff([string] lines): bool {
    int markers = 0
    for line in lines {
        if line.starts_with('+') || line.starts_with('-') || line.starts_with('@@') {
            markers += 1
            if markers >= 2 {
                return true
            }
        }
    }
    return false
}

type parsed_diff_line_t = struct {
    bool valid
    string prefix
    string line_number
    string content
}

type diff_token_t = struct {
    string value
    int kind
}

pub fn render_diff_lines([string] lines): [string] {
    [string] result = []
    int index = 0
    for index < lines.len() {
        var parsed = parse_diff_line(lines[index])
        if !parsed.valid {
            result.push(diff_line_color(lines[index]))
            index += 1
            continue
        }
        if parsed.prefix == '-' {
            [parsed_diff_line_t] removed = []
            for index < lines.len() {
                var candidate = parse_diff_line(lines[index])
                if !candidate.valid || candidate.prefix != '-' {break}
                removed.push(candidate)
                index += 1
            }
            [parsed_diff_line_t] added = []
            for index < lines.len() {
                var candidate = parse_diff_line(lines[index])
                if !candidate.valid || candidate.prefix != '+' {break}
                added.push(candidate)
                index += 1
            }
            if removed.len() == 1 && added.len() == 1 {
                var (removed_text, added_text) = render_intra_line_diff(replace_diff_tabs(removed[0].content), replace_diff_tabs(added[0].content))
                result.push(theme.fg(theme.tool_diff_removed(), '-' + removed[0].line_number + ' ' + removed_text))
                result.push(theme.fg(theme.tool_diff_added(), '+' + added[0].line_number + ' ' + added_text))
            } else {
                for line in removed {
                    result.push(theme.fg(theme.tool_diff_removed(), rebuild_diff_line(line)))
                }
                for line in added {
                    result.push(theme.fg(theme.tool_diff_added(), rebuild_diff_line(line)))
                }
            }
            continue
        }
        string rebuilt = rebuild_diff_line(parsed)
        if parsed.prefix == '+' {
            result.push(theme.fg(theme.tool_diff_added(), rebuilt))
        } else {
            result.push(theme.fg(theme.tool_diff_context(), rebuilt))
        }
        index += 1
    }
    return result
}

fn parse_diff_line(string line): parsed_diff_line_t {
    var invalid = parsed_diff_line_t {}
    if line.len() < 2 {return invalid}
    u8 first = line[0]
    if first != '+'.char() && first != '-'.char() && first != ' '.char() && first != '\t'.char() {return invalid}
    int cursor = 1
    for cursor < line.len() {
        if line[cursor] != ' '.char() && line[cursor] != '\t'.char() {break}
        cursor += 1
    }
    int digits_start = cursor
    for cursor < line.len() {
        if line[cursor] < '0'.char() || line[cursor] > '9'.char() {break}
        cursor += 1
    }
    int separator = cursor
    if digits_start == cursor {
        // /^([+-\s])(\s*\d*)\s(.*)$/ backtracks one whitespace when no
        // line number is present (the compact "     ..." gap row).
        if cursor <= 1 {return invalid}
        separator = cursor - 1
    } else if cursor >= line.len() || (line[cursor] != ' '.char() && line[cursor] != '\t'.char()) {
        return invalid
    }
    if separator >= line.len() {return invalid}
    return parsed_diff_line_t {valid: true, prefix: line.slice(0, 1), line_number: line.slice(1, separator), content: line.slice(separator + 1, line.len()),}
}

fn rebuild_diff_line(parsed_diff_line_t line): string {
    return line.prefix + line.line_number + ' ' + replace_diff_tabs(line.content)
}

fn replace_diff_tabs(string value): string {return value.replace('\t', '   ')}

fn render_intra_line_diff(string old_content, string new_content): (string, string) {
    var old_tokens = diff_tokens(old_content)
    var new_tokens = diff_tokens(new_content)
    int columns = new_tokens.len() + 1
    [int] lcs = vec<int>.cap_of((old_tokens.len() + 1) * columns)
    int cell_count = (old_tokens.len() + 1) * columns
    for int index = 0; index < cell_count; index += 1 {
        lcs.push(0)
    }
    for int old_index = old_tokens.len() - 1; old_index >= 0; old_index -= 1 {
        for int new_index = new_tokens.len() - 1; new_index >= 0; new_index -= 1 {
            int cell = old_index * columns + new_index
            if diff_tokens_equal(old_tokens[old_index], new_tokens[new_index]) {
                lcs[cell] = 1 + lcs[(old_index + 1) * columns + new_index + 1]
            } else {
                int skip_old = lcs[(old_index + 1) * columns + new_index]
                int skip_new = lcs[old_index * columns + new_index + 1]
                lcs[cell] = skip_old > skip_new ? skip_old : skip_new
            }
        }
    }
    [bool] old_changed = []
    [bool] new_changed = []
    [string] old_render_values = []
    [string] new_render_values = []
    for token in old_tokens {
        old_changed.push(true)
        old_render_values.push(token.value)
    }
    for token in new_tokens {
        new_changed.push(true)
        new_render_values.push(token.value)
    }
    int old_index = 0
    int new_index = 0
    for old_index < old_tokens.len() {
        if new_index >= new_tokens.len() {break}
        if diff_tokens_equal(old_tokens[old_index], new_tokens[new_index]) {
            old_changed[old_index] = false
            new_changed[new_index] = false
            // diffWords ignores whitespace-only changes and renders the new
            // whitespace on both sides of a common component.
            if old_tokens[old_index].kind == 1 {
                old_render_values[old_index] = new_tokens[new_index].value
            }
            old_index += 1
            new_index += 1
        } else if lcs[(old_index + 1) * columns + new_index] >= lcs[old_index * columns + new_index + 1] {
            old_index += 1
        } else {
            new_index += 1
        }
    }
    return (
        render_diff_token_side(old_tokens, old_changed, old_render_values),
        render_diff_token_side(new_tokens, new_changed, new_render_values),
    )
}

// diffWords returns a changed word together with its trailing whitespace as
// one component. Emit one inverse span for the entire component so the ANSI
// stream as well as the visible cells matches Pi.
fn render_diff_token_side([diff_token_t] tokens, [bool] changed, [string] values): string {
    string result = ''
    int index = 0
    for index < tokens.len() {
        if !diff_token_highlighted(tokens, changed, index) {
            result += values[index]
            index += 1
            continue
        }
        string run = ''
        for index < tokens.len() && diff_token_highlighted(tokens, changed, index) {
            run += values[index]
            index += 1
        }
        result += theme.inverse(run)
    }
    return result
}

fn diff_token_highlighted([diff_token_t] tokens, [bool] changed, int index): bool {
    if !changed[index] {return false}
    if tokens[index].kind != 1 {return true}
    return index > 0 && changed[index - 1] && tokens[index - 1].kind != 1
}

fn diff_tokens_equal(diff_token_t left, diff_token_t right): bool {
    return left.value == right.value || (left.kind == 1 && right.kind == 1)
}

fn diff_tokens(string value): [diff_token_t] {
    [diff_token_t] result = []
    var graphemes = unicode.graphemes(value) catch error {[]}
    string current = ''
    int current_kind = -1
    for grapheme in graphemes {
        string part = value.slice(grapheme.start, grapheme.end)
        int kind = diff_token_kind(part)
        if current != '' && kind != current_kind {
            result.push(diff_token_t {value: current, kind: current_kind,})
            current = ''
        }
        current += part
        current_kind = kind
    }
    if current != '' {result.push(diff_token_t {value: current, kind: current_kind,})}
    return result
}

fn diff_token_kind(string value): int {
    if value == ' ' || value == '\t' {return 1}
    u8 first = value[0]
    if first >= 128 || first >= 'a'.char() && first <= 'z'.char() || first >= 'A'.char() && first <= 'Z'.char() || first >= '0'.char() && first <= '9'.char() || first == '_'.char() {return 2}
    return 3
}

fn diff_line_color(string line): string {
    if line.starts_with('@@') {return theme.fg(theme.warning(), line)}
    if line.starts_with('+++') || line.starts_with('---') {return theme.fg(theme.tool_diff_context(), line)}
    if line.starts_with('+') {return theme.fg(theme.tool_diff_added(), line)}
    if line.starts_with('-') {return theme.fg(theme.tool_diff_removed(), line)}
    return theme.fg(theme.tool_diff_context(), line)
}

fn tool_message_text(ai_types.tool_result_message_t tool): string {
    string text = ''
    for content in tool.content {
        if text != '' {
            text += '\n'
        }
        text += content.text
    }
    return text
}

pub fn chat_t.find_tool(&self, string id): ref<tool_view_t>? {
    for tool in self.active_tools {
        if tool.id == id {
            return tool
        }
    }
    return null
}

pub fn chat_t.remove_tool(&self, string id) {
    [ref<tool_view_t>] remaining = vec<ref<tool_view_t>>.cap_of(self.active_tools.len())
    for tool in self.active_tools {
        if tool.id != id {
            remaining.push(tool)
        }
    }
    self.active_tools = remaining
}
