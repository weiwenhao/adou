import adou.src.json_util
import adou.src.tools.path_utils
import fs
import json
import os
import path
import syscall

// Pi's keybindings surface: a named registry over TUI (editor/input/select)
// and app actions.  Every action has default keys and a description; user
// mappings come from <agent_dir>/keybindings.json (string or array per
// action, legacy names migrated).  The registry resolves each key to ONE
// action, detects conflicts (two actions claiming the same key), and feeds
// every hint surface so behavior and displayed keys can never diverge.

pub type keybinding_def_t = struct {
    [string] keys = []
    string description
}

pub type conflict_t = struct {
    string key
    [string] actions = []
}

pub type keybindings_t = struct {
    {string:keybinding_def_t} definitions = {}
    // Stable display order for /hotkeys (Nature maps do not keep insertion
    // order).
    [string] action_order = []
    {string:[string]} user_bindings = {}
    {string:[string]} resolved = {}
    [conflict_t] conflicts = []
}

