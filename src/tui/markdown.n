import adou.src.tui.syntax
import adou.src.tui.text_utils
import adou.src.tui.unicode
import adou.src.tui.theme
import strings

pub fn render(string markdown, int width): [string]! {
    [string] result = vec<string>.cap_of(16)
    var lines = split_lines(markdown)
    bool fenced = false
    string fence_language = ''
    bool highlighted_fence = false
    int index = 0
    for index < lines.len() {
        string raw = lines[index]
        if raw.starts_with('```') || raw.starts_with('~~~') {
            string fence = raw.slice(0, 3)
            if !fenced {
                fenced = true
                fence_language = raw.slice(3, raw.len()).trim([' '])
                highlighted_fence = syntax.supports(fence_language)
                result.push(theme.fg(theme.CODE_BLOCK_BORDER, raw))
            } else {
                result.push(theme.fg(theme.CODE_BLOCK_BORDER, fence))
                fenced = false
                highlighted_fence = false
                fence_language = ''
                result.push('')
            }
            index += 1
            continue
        }
        if fenced {
            // B4: supported languages get keyword/string/comment coloring.
            string code_text = highlighted_fence ? syntax.highlight_line(raw, fence_language) : raw
            var code_line = text_utils.wrap_text_with_ansi(theme.fg(theme.CODE_BLOCK, '  ' + code_text), width > 0 ? width : 1)
            result.append(code_line)
            index += 1
            continue
        }
        // A table starts with a header row whose next line is a delimiter
        // row (---); render the whole block before continuing.
        if table_delimiter_next(lines, index) {
            var table_lines = render_table(lines, index, width)
            result.append(table_lines)
            index += table_block_height(lines, index)
            result.push('')
            continue
        }
        if is_horizontal_rule(raw) {
            int rule_width = width > 80 ? 80 : width
            result.push(theme.fg(theme.muted_color(), repeat_string('─', rule_width)))
            result.push('')
            index += 1
            continue
        }
        // B4: setext headings — a non-empty text line followed by a === or
        // --- underline renders as a level-1/2 heading (both lines consumed).
        if setext_underline(lines, index) > 0 {
            result.append(text_utils.wrap_text_with_ansi(theme.bold(theme.fg(theme.HEADING, inline(raw))), width > 0 ? width : 1))
            result.push('')
            index += 2
            continue
        }
        // B4: paragraph soft-line joining — consecutive plain text lines are
        // one paragraph: joined with spaces, processed by inline(), and
        // re-wrapped as a unit (Pi/marked paragraph semantics).
        int run_end = paragraph_run_end(lines, index)
        if run_end > index {
            // A run closed by a setext underline renders as a heading; the
            // underline line itself never becomes visible text.
            bool run_is_heading = run_end - 1 > index && is_setext_underline_line(lines[run_end - 1].trim([' ', '\t']))
            int text_end = run_is_heading ? run_end - 1 : run_end
            [string] run_parts = []
            for int cursor = index; cursor < text_end; cursor += 1 {
                run_parts.push(lines[cursor].trim([' ', '\t']))
            }
            string joined_paragraph = strings.join(run_parts, ' ')
            string paragraph_styled = run_is_heading ? theme.bold(theme.fg(theme.HEADING, inline(joined_paragraph))) : inline(joined_paragraph)
            result.append(text_utils.wrap_text_with_ansi(paragraph_styled, width > 0 ? width : 1))
            result.push('')
            index = run_end
            continue
        }
        int indent = leading_spaces(raw)
        string content = indent > 0 ? raw.slice(indent, raw.len()) : raw
        string indent_text = repeat_string(' ', indent)
        string styled = raw
        int heading = heading_prefix_end(content)
        if heading > 0 {
            styled = indent_text + theme.bold(theme.fg(theme.HEADING, content.slice(0, heading))) + inline(content.slice(heading, content.len()))
        } else if quote_depth(content) > 0 {
            // Nested blockquotes render one gutter per depth level.
            int depth = quote_depth(content)
            string quote_content = strip_quote_prefix(content, depth)
            string gutter = repeat_string('│ ', depth)
            styled = indent_text + theme.fg(theme.muted_color(), gutter) + inline(quote_content)
        } else if unordered_prefix_end(content) > 0 {
            // B4: GFM task lists — "[ ] "/"[x] " after the bullet joins the
            // accent-styled marker like Pi's bullet + taskMarker.
            int marker_end = unordered_prefix_end(content)
            if content.len() >= marker_end + 4 && content.slice(marker_end, marker_end + 4) == '[ ] ' {
                marker_end += 4
            } else if content.len() >= marker_end + 4 && content.slice(marker_end, marker_end + 4) == '[x] ' {
                marker_end += 4
            }
            styled = indent_text + theme.fg(theme.accent(), content.slice(0, marker_end)) + inline(content.slice(marker_end, content.len()))
        } else {
            int ordered = ordered_prefix_end(content)
            styled = ordered > 0 ? indent_text + theme.fg(theme.accent(), content.slice(0, ordered)) + inline(content.slice(ordered, content.len())) : inline(raw)
        }
        var wrapped = text_utils.wrap_text_with_ansi(styled, width > 0 ? width : 1)
        for line in wrapped {
            result.push(line)
        }
        index += 1
    }
    return result
}

// True when the next line is a table delimiter row (| --- | --- |).
fn table_delimiter_next([string] lines, int index): bool {
    if index + 1 >= lines.len() {
        return false
    }
    string current = lines[index]
    if !current.contains('|') {
        return false
    }
    string next = lines[index + 1].trim([' ', '\t'])
    if !next.starts_with('|') {
        next = '|' + next
    }
    if !next.contains('|') {
        return false
    }
    // Every comma-free cell must be dashes (with optional colons).
    var cells = split_cells(next)
    if cells.len() < 2 {
        return false
    }
    for cell in cells {
        string value = cell.trim([' ', '\t'])
        if value == '' {
            return false
        }
        for int cursor = 0; cursor < value.len(); cursor += 1 {
            u8 byte = value[cursor]
            bool allowed = byte == '-'.char() || byte == ':'.char()
            if !allowed {
                return false
            }
        }
    }
    return true
}

fn table_block_height([string] lines, int index): int {
    int height = 0
    for int cursor = index; cursor < lines.len(); cursor += 1 {
        if lines[cursor].contains('|') {
            height += 1
        } else {
            break
        }
    }
    return height
}

fn split_cells(string line): [string] {
    string value = line.trim([' ', '\t'])
    if value.starts_with('|') {
        value = value.slice(1, value.len())
    }
    if value.ends_with('|') && !value.ends_with('\\|') {
        value = value.slice(0, value.len() - 1)
    }
    [string] cells = []
    int start = 0
    bool escaped = false
    for int cursor = 0; cursor <= value.len(); cursor += 1 {
        if cursor == value.len() || (value[cursor] == '|'.char() && !escaped) {
            cells.push(value.slice(start, cursor).trim([' ', '\t']))
            start = cursor + 1
            escaped = false
        } else if value[cursor] == '\\'.char() && !escaped {
            escaped = true
        } else {
            escaped = false
        }
    }
    return cells
}

// Render a markdown table with aligned columns; the header row is bold and
// a divider line separates it from the body.
fn render_table([string] lines, int index, int width): [string]! {
    var header_cells = split_cells(lines[index])
    [any] body = []
    int height = table_block_height(lines, index)
    for int cursor = index + 2; cursor < index + height; cursor += 1 {
        body.push(split_cells(lines[cursor]))
    }
    int column_count = header_cells.len()
    for row in body {
        if (row as [string]).len() > column_count {
            column_count = (row as [string]).len()
        }
    }
    [int] widths = []
    for int column = 0; column < column_count; column += 1 {
        int cell_width = column < header_cells.len() ? text_utils.visible_width(header_cells[column]) : 0
        for row in body {
            var cells = row as [string]
            if column < cells.len() {
                int value_width = text_utils.visible_width(cells[column])
                if value_width > cell_width {
                    cell_width = value_width
                }
            }
        }
        widths.push(cell_width)
    }
    // Shrink the widest columns when the table exceeds the terminal width.
    // Each column contributes its width plus a 3-char separator; the row
    // starts with a 2-char gutter.
    int total = 2 + 3 * column_count
    for column_width in widths {
        total += column_width
    }
    if width > 0 && total > width {
        int excess = total - width
        for int pass = 0; pass < column_count && excess > 0; pass += 1 {
            int widest = 0
            for int column = 1; column < column_count; column += 1 {
                if widths[column] > widths[widest] {
                    widest = column
                }
            }
            int reduction = widths[widest] - excess
            if reduction < 3 {
                reduction = 3
            }
            excess -= widths[widest] - reduction
            widths[widest] = reduction
        }
    }
    [string] result = []
    // B4: the header keeps its bold marker through inline processing so
    // emphasis inside cells survives width measurement and wrapping.
    result.append(table_rows(header_cells, widths, true))
    result.push(table_divider(widths))
    for row in body {
        result.append(table_rows(row as [string], widths, false))
    }
    return result
}

// B4: Pi markdown.ts table rendering — overflowing cells wrap into extra
// physical rows instead of truncating, and cell content keeps its inline
// formatting (emphasis/code/strike) while staying ANSI-width aligned.
fn table_rows([string] cells, [int] widths, bool header): [string]! {
    int column_count = widths.len()
    [[any]] segments = []
    int max_rows = 1
    for int column = 0; column < column_count; column += 1 {
        string cell = column < cells.len() ? cells[column] : ''
        string styled = header ? theme.bold(inline(cell)) : inline(cell)
        var wrapped = text_utils.wrap_text_with_ansi(styled, widths[column] > 0 ? widths[column] : 1)
        if wrapped.len() == 0 {
            wrapped.push('')
        }
        if wrapped.len() > max_rows {
            max_rows = wrapped.len()
        }
        [any] wrapped_any = []
        for segment_line in wrapped {
            wrapped_any.push(segment_line)
        }
        segments.push(wrapped_any)
    }
    [string] result = []
    for int line_index = 0; line_index < max_rows; line_index += 1 {
        string line = '│ '
        for int column = 0; column < column_count; column += 1 {
            var wrapped_any = segments[column]
            [any] wrapped = []
            for wrapped_item in wrapped_any {
                wrapped.push(wrapped_item)
            }
            string segment = line_index < wrapped.len() ? wrapped[line_index] as string : ''
            int segment_width = text_utils.visible_width(segment)
            int padding = widths[column] - segment_width
            if padding < 0 {
                padding = 0
            }
            line += segment + repeat_string(' ', padding) + ' │ '
        }
        result.push(line)
    }
    return result
}

fn table_divider([int] widths): string {
    string line = '├'
    for index, column_width in widths {
        line += repeat_string('─', column_width + 2) + '┼'
    }
    // Drop the trailing multi-byte separator entirely, then close the row.
    line = line.slice(0, line.len() - 3) + '┤'
    return theme.fg(theme.muted_color(), line)
}

fn quote_depth(string content): int {
    int depth = 0
    for depth < content.len() && content[depth] == '>'.char() {
        depth += 1
    }
    return depth
}

fn strip_quote_prefix(string content, int depth): string {
    int cursor = depth
    for cursor < content.len() && content[cursor] == ' '.char() {
        cursor += 1
    }
    return content.slice(cursor, content.len())
}

// CommonMark flanking boundaries must use Unicode word classification,
// not a byte-level approximation: ICU word segmentation (unicode.words)
// marks CJK ideographs, emoji and combining sequences as word-like, so
// 中文_变量_名 and 你_好 keep their underscores literal exactly like
// foo_bar_baz.  The segmentation is computed at most once per inline
// line and shared by every delimiter flanking check; re-segmenting the
// whole line for each underscore would turn long identifiers into O(n^2)
// ICU walks (a 4k-byte line of intraword underscores costs ~1ms per
// segment call instead of one shared pass).
fn word_at([unicode.segment_t] segments, int pos): bool {
    if pos < 0 {
        return false
    }
    for segment in segments {
        if segment.word_like && segment.start <= pos && pos < segment.end {
            return true
        }
    }
    return false
}

fn inline(string text): string {
    // Most streamed assistant/tool rows are ordinary text.  Returning the
    // original slice avoids rebuilding a growing line one byte at a time on
    // every redraw; markdown markers still take the parser below.
    if text.find('*') < 0 && text.find('_') < 0 && text.find('~') < 0 && text.find('`') < 0 && text.find('[') < 0 {
        return text
    }
    // Only lines that actually contain an underscore need word boundaries.
    [unicode.segment_t] segments = []
    if text.find('_') >= 0 {
        segments = unicode.words(text) catch error {
            []
        }
    }
    [string] parts = vec<string>.cap_of(16)
    int cursor = 0
    for cursor < text.len() {
        // Keep ordinary spans contiguous once a marker is present. This
        // avoids rebuilding long literal identifiers one byte at a time.
        if !is_inline_marker(text[cursor]) {
            int end = cursor + 1
            for end < text.len() && !is_inline_marker(text[end]) {
                end += 1
            }
            parts.push(text.slice(cursor, end))
            cursor = end
            continue
        }
        if cursor + 2 <= text.len() && text.slice(cursor, cursor + 2) == '**' {
            string delimiter = text.slice(cursor, cursor + 2)
            int end = text.find_after(delimiter, cursor + 2)
            if end >= 0 {
                parts.push(theme.bold(text.slice(cursor + 2, end)))
                cursor = end + 2
                continue
            }
        }
        // Double underscore needs flanking like single underscore:
        // foo__bar__baz keeps its underscores literal.
        if cursor + 2 <= text.len() && text.slice(cursor, cursor + 2) == '__' {
            bool can_open = cursor == 0 || !word_at(segments, cursor - 1)
            int end = text.find_after('__', cursor + 2)
            bool can_close = end > cursor + 2 && (end + 2 >= text.len() || !word_at(segments, end + 2))
            if can_open && can_close {
                parts.push(theme.bold(text.slice(cursor + 2, end)))
                cursor = end + 2
                continue
            }
        }
        if cursor + 2 <= text.len() && text.slice(cursor, cursor + 2) == '~~' {
            int end = text.find_after('~~', cursor + 2)
            if end > cursor + 2 {
                parts.push(theme.strikethrough(text.slice(cursor + 2, end)))
                cursor = end + 2
                continue
            }
        }
        if text[cursor] == '`'.char() {
            int end = text.find_after('`', cursor + 1)
            if end >= 0 {
                parts.push(theme.INVERSE + theme.CODE + text.slice(cursor + 1, end) + '\x1b[27m\x1b[39m')
                cursor = end + 1
                continue
            }
        }
        if text[cursor] == '*'.char() {
            string delimiter = text.slice(cursor, cursor + 1)
            if cursor + 1 < text.len() && text[cursor + 1] == text[cursor] {
                parts.push(text.slice(cursor, cursor + 1))
                cursor += 1
                continue
            }
            int end = text.find_after(delimiter, cursor + 1)
            if end > cursor + 1 {
                parts.push(theme.italic(text.slice(cursor + 1, end)))
                cursor = end + 1
                continue
            }
        }
        // CommonMark underscore emphasis requires flanking delimiters:
        // an intraword underscore (foo_bar_baz, PARITY_TOOL_OK) must stay
        // literal.  Opening needs a non-alphanumeric left neighbour;
        // closing needs a non-alphanumeric right neighbour (or EOL).
        if text[cursor] == '_'.char() {
            if cursor + 1 < text.len() && text[cursor + 1] == '_'.char() {
                parts.push('__')
                cursor += 2
                continue
            }
            bool can_open = cursor == 0 || !word_at(segments, cursor - 1)
            int end = text.find_after('_', cursor + 1)
            bool can_close = end > cursor + 1 && (end + 1 >= text.len() || !word_at(segments, end + 1))
            if can_open && can_close {
                parts.push(theme.italic(text.slice(cursor + 1, end)))
                cursor = end + 1
                continue
            }
            parts.push('_')
            cursor += 1
            continue
        }
        if text[cursor] == '['.char() {
            int label_end = text.find_after(']', cursor + 1)
            if label_end >= 0 && label_end + 1 < text.len() && text[label_end + 1] == '('.char() {
                int url_end = text.find_after(')', label_end + 2)
                if url_end >= 0 {
                    string label = text.slice(cursor + 1, label_end)
                    string url = text.slice(label_end + 2, url_end)
                    parts.push('\x1b]8;;' + url + '\x1b\\' + theme.fg(theme.LINK, label) + '\x1b]8;;\x1b\\')
                    cursor = url_end + 1
                    continue
                }
            }
        }
        parts.push(text.slice(cursor, cursor + 1))
        cursor += 1
    }
    return strings.join(parts, '')
}

fn is_inline_marker(u8 value): bool {
    return value == '*'.char() || value == '_'.char() || value == '~'.char() || value == '`'.char() || value == '['.char()
}

fn ordered_prefix_end(string text): int {
    int cursor = 0
    for cursor < text.len() && text[cursor] >= '0'.char() && text[cursor] <= '9'.char() {
        cursor += 1
    }
    return cursor > 0 && cursor + 1 < text.len() && text[cursor] == '.'.char() && text[cursor + 1] == ' '.char() ? cursor + 2 : 0
}

fn unordered_prefix_end(string text): int {
    return text.len() >= 2 && (text[0] == '-'.char() || text[0] == '*'.char() || text[0] == '+'.char()) && text[1] == ' '.char() ? 2 : 0
}

fn heading_prefix_end(string text): int {
    int cursor = 0
    for cursor < text.len() && text[cursor] == '#'.char() && cursor < 6 {
        cursor += 1
    }
    return cursor > 0 && cursor < text.len() && text[cursor] == ' '.char() ? cursor + 1 : 0
}

fn leading_spaces(string text): int {
    int count = 0
    for count < text.len() && text[count] == ' '.char() {
        count += 1
    }
    return count
}

fn is_horizontal_rule(string text): bool {
    string value = text.trim([' ', '\t'])
    if value.len() < 3 {
        return false
    }
    u8 marker = value[0]
    if marker != '-'.char() && marker != '*'.char() && marker != '_'.char() {
        return false
    }
    int count = 0
    for byte in value {
        if byte == marker {
            count += 1
        } else if byte != ' '.char() && byte != '\t'.char() {
            return false
        }
    }
    return count >= 3
}

pub fn split_lines(string text): [string] {
    [string] result = vec<string>.cap_of(8)
    int start = 0
    for int cursor = 0; cursor <= text.len(); cursor += 1 {
        if cursor == text.len() || text[cursor] == '\n'.char() {
            result.push(text.slice(start, cursor))
            start = cursor + 1
        }
    }
    return result
}

fn repeat_string(string value, int count): string {
    string result = ''
    for int index = 0; index < count; index += 1 {
        result += value
    }
    return result
}


// B4: setext underline detector — returns the underline length (>0) when
// line[index] is plain text and line[index+1] is a ===/--- underline.
// True when the line itself is a ===/--- setext underline.
fn is_setext_underline_line(string line): bool {
    if line.len() < 2 {
        return false
    }
    bool all_equals = true
    bool all_dashes = true
    for int i = 0; i < line.len(); i += 1 {
        u8 c = line[i]
        if c == ' '.char() {
            continue
        }
        if c == '='.char() {
            all_dashes = false
            continue
        }
        if c == '-'.char() {
            all_equals = false
            continue
        }
        return false
    }
    return all_equals || all_dashes
}

fn setext_underline([string] lines, int index): int {
    if index + 1 >= lines.len() {
        return 0
    }
    string current = lines[index]
    if current.trim([' ', '\t']) == '' {
        return 0
    }
    // Lists/quotes/fences and table rows never form setext headings.
    if current.starts_with('```') || current.starts_with('~~~') || table_delimiter_next(lines, index) {
        return 0
    }
    if quote_depth(current.trim([' ', '\t'])) > 0 || unordered_prefix_end(current.trim([' ', '\t'])) > 0 || ordered_prefix_end(current.trim([' ', '\t'])) > 0 {
        return 0
    }
    string underline = lines[index + 1]
    if underline.len() < 2 {
        return 0
    }
    bool all_equals = true
    bool all_dashes = true
    for int i = 0; i < underline.len(); i += 1 {
        u8 c = underline[i]
        if c == ' '.char() {
            continue
        }
        if c == '='.char() {
            all_dashes = false
            continue
        }
        if c == '-'.char() {
            all_equals = false
            continue
        }
        return 0
    }
    if all_equals {
        return underline.len()
    }
    if all_dashes {
        return underline.len()
    }
    return 0
}


// B4: paragraph run scanner — returns the exclusive end index of the run of
// consecutive plain text lines starting at `index`.  Block starters (fences,
// tables, rules, headings, lists, quotes) and setext underlines terminate
// the run; an underline terminating the run upgrades it to a setext heading
// so "a\nb\n===" renders as one heading like CommonMark.
fn paragraph_run_end([string] lines, int index): int {
    if setext_underline(lines, index) > 0 {
        return index
    }
    string first = lines[index]
    if first.trim([' ', '\t']) == '' {
        return index
    }
    if is_block_start(first) {
        return index
    }
    int end = index + 1
    for end < lines.len() {
        string candidate = lines[end]
        if candidate.trim([' ', '\t']) == '' {
            break
        }
        if is_block_start(candidate) {
            break
        }
        if is_setext_underline_line(candidate.trim([' ', '\t'])) {
            // The run closes with its own setext underline.
            return end + 1
        }
        end += 1
    }
    return end
}

fn is_block_start(string line): bool {
    string trimmed = line.trim([' ', '\t'])
    if trimmed == '' {
        return true
    }
    if trimmed.starts_with('```') || trimmed.starts_with('~~~') {
        return true
    }
    if trimmed.starts_with('#') {
        return true
    }
    if quote_depth(trimmed) > 0 {
        return true
    }
    if unordered_prefix_end(trimmed) > 0 || ordered_prefix_end(trimmed) > 0 {
        return true
    }
    if is_horizontal_rule(trimmed) {
        return true
    }
    return false
}
