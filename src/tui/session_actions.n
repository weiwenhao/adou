import adou.src.session.backend

// Session deletion used by the resume picker: delegate to the Phase 7
// backend helper (trash CLI first, permanent unlink fallback) so the TUI
// and the repository backends share one file-level implementation.  The
// return value is (deleted, message) where message distinguishes the
// method used.
pub fn delete_session_file(string file_path, string cwd): (bool, string) {
    return backend.delete_session_file(file_path, cwd)
}
