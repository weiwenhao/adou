pub type overlay_t = struct {
    int kind
    string title
    string provider
    [string] options = []
    int selected
    string query
    string oauth_verifier
    string oauth_state
    string oauth_device_code
    string oauth_device_uri
    string oauth_device_user_code
    int oauth_device_interval
    int oauth_device_expires
    string oauth_method
    string auth_method
    bool confirming_delete
    string delete_path
    bool show_paths
    bool named_only
    int sort_mode
    // Pi's scope: 0 = current folder, 1 = all projects.  The options list
    // holds the merged set; filtered_options narrows it by scope.
    int scope
    // Tree selector: Pi's five filter modes (default/no-tools/user-only/
    // labeled-only/all) and the collapsed entry ids.
    int tree_filter = 0
    [string] collapsed_ids = []
    ref<model_selector.state_t>? model_state = null
    ref<scoped_models.state_t>? scoped_models_state = null
    // Batch 3 theme submenu state: the theme setting value captured when the
    // submenu opened (cancel restores it), the automatic pair under edit,
    // and the target ('light'|'dark') of the pair-select overlay.
    string theme_original
    string theme_light = 'light'
    string theme_dark = 'dark'
    string theme_select_target
    // Pi FirstTimeSetupComponent state. The setup is a two-step selector;
    // changing the theme selection previews it immediately.
    string setup_step = 'theme'
    string setup_theme = 'dark'
    // Pi app.tree.toggleLabelTimestamp: show each entry's timestamp next
    // to its label in the tree rows.
    bool label_timestamps
    // Pi's startup trust prompt (formatProjectTrustPrompt): the overlay was
    // opened automatically for an unresolved 'ask' project, so it renders
    // the consequence description instead of the saved-source lines.
    bool trust_prompt = false
    // Config selector state.  scope 0 is global/user resources; scope 1 is
    // project-local resources.  The query is kept on the overlay so Esc can
    // clear a search before closing, matching Pi's selector behavior.
    int config_scope
    [trust.trust_option_t] trust_options = []
}

pub type view_t = struct {
    ref<term.terminal_t> terminal
    ref<session.runner_t> runner
    ref<chat.chat_t> chat
    ref<editor.editor_t> editor
    ref<input_buffer.buffer_t> input_buffer
    ref<renderer.renderer_t> renderer
    chan<input_t> input_events
    chan<signal.sig_t> signals
    ref<session_stream.stream_t>? active_stream
    ref<overlay_t>? overlay
    // The frame after a selector or autocomplete menu closes still owns its
    // deleted terminal rows. Keep one bit of render history so that transition
    // also uses the transient-UI shrink policy.
    bool transient_ui_rendered
    // Unified autocomplete state (Batch 1, IP-001/002/004/006): the
    // selection is bound to the query generation that produced the candidate
    // set, so a stale index can never complete a different command.
    ref<autocomplete.autocomplete_state_t> autocomplete
    bool kitty_protocol
    bool quitting
    int cached_auth_provider_count = 0
    // Authentication is a provider-level property. Keep the resolved
    // result alongside the count so model selector, scoped-models and
    // /model argument completion can reuse one snapshot instead of calling
    // auth.effective once per model entry.
    map<string, bool> cached_authenticated_providers = {}
    // --resume opens the selector before the normal prompt. Escape/cancel
    // exits that startup flow instead of silently continuing a session.
    bool startup_session_picker
    // Pi settings autocompleteMaxVisible (3-20, default 5) resolved once
    // from the current cwd's global+project merge (B1-R1-10) and stored on
    // the view; ordinary key presses never re-read the settings files.
    int autocomplete_max_visible = autocomplete.DEFAULT_MAX_VISIBLE
    // Pi settings.editorPaddingX (0-3): cached like autocompleteMaxVisible;
    // render_editor reads it on every frame without touching the settings
    // files.
    int editor_padding_x
    // B1-R1-09: /model argument candidates and the authenticated-provider
    // scan are recomputed only at explicit change points (init, /reload,
    // /login, /logout, scope change).  The scope patterns cached alongside
    // are the invalidation condition: a changed scope set re-derives.
    [autocomplete.autocomplete_item_t] cached_model_argument_items = []
    [string] cached_model_scope_patterns = []
    bool model_argument_cache_valid
    // Pi sends initialMessage and every remaining CLI message sequentially.
    // Keep the not-yet-sent startup prompts separate from the normal steering
    // and follow-up queues so they cannot be merged into one turn.
    [string] pending_initial_messages = []
    [ref<ai_types.image_attachment_t>] pending_initial_images = []
    bool pending_tree_navigation
    string pending_tree_editor_text
    string pending_tree_target_id
    i64 last_escape_time
    i64 last_sigint_time
    // CLI --models patterns limit Ctrl+P cycling and the model selector for
    // this session.  Settings-backed /scoped-models remains a separate,
    // persistent selector and is applied when no CLI scope is present.
    [string] model_scope_patterns = []
    // B1-R3-05: whether the CLI --models scope is explicit.  Explicit scopes
    // persist across rebinds; otherwise refresh_resource_snapshot refreshes
    // the scope AND the /scoped-models backing from the trust-aware
    // enabledModels before rebuilding the model candidates.
    bool model_scope_explicit
    [string] scoped_model_ids = []
    // Pi distinguishes an unset scope (all models) from a session scope that
    // currently contains no enabled models.  The latter is useful while the
    // selector is being edited and is persisted as the default/all state.
    bool scoped_models_active
    bool scoped_models_dirty
    int model_refresh_generation
    ref<mutex.mutex_t> model_refresh_lock = mutex.mutex_t.new()
    int oauth_generation
    bool oauth_cancelled
    ref<mutex.mutex_t> oauth_lock = mutex.mutex_t.new()
    ref<oauth.browser_auth_t>? oauth_browser = null
    ref<oauth_cancellation_t>? oauth_cancel_state = null
    // Keep CLI system-prompt overrides available for `/reload`; Pi reloads
    // project context without silently dropping those session-wide options.
    string system_prompt_override
    [string] append_system_prompts = []
    [ref<prompt_templates.prompt_template_t>] prompt_templates = []
    [ref<prompt_templates.prompt_template_t>] available_prompt_templates = []
    // B1-R2-06/07/08: one trust-aware resource snapshot refreshed together
    // at init, /reload and session rebind.  settings_snapshot is the merged
    // global+project settings (global-only for untrusted cwds); dynamic_commands
    // is the completion-menu resource assembly built from the SAME filtered
    // templates/skills that drive execution; cached_skills feeds the system
    // prompt and the /reload skills text.  Ordinary typing never re-reads
    // settings or resources.
    config_settings.settings_t settings_snapshot = config_settings.settings_t{}
    [slash_commands.slash_command_info_t] dynamic_commands = []
    [ref<skills.skill_t>] cached_skills = []
    [ref<skills.skill_t>] available_skills = []
    bool no_context_files
    // CLI skills options survive /reload and session rebinds: explicit
    // --skill paths keep loading, --no-skills keeps gating default discovery,
    // and the trust decision is re-resolved against each project cwd
    // (explicit --approve/--no-approve still wins) so a /open, /import or
    // --session rebind to another project uses that project's decision.
    [string] skill_paths = []
    bool no_skills
    // B6: Pi resource-discovery flags (--prompt-template/--no-prompt-templates).
    [string] prompt_template_paths = []
    bool no_prompt_templates
    bool no_themes
    bool trust_override
    bool trust_override_explicit
    // A trust choice made for this TUI session must not mutate CLI override
    // state or the persistent trust store.  It is scoped to the current cwd
    // and is re-evaluated on session rebind.
    bool session_trust_override_set
    bool session_trust_override
    string session_trust_cwd
    // Pi caches the startup trust resolution per cwd (projectTrustByCwd):
    // the selector opens once per project until the decision changes, and a
    // dismissed prompt counts as the resolution (untrusted) for that cwd.
    string trust_prompted_cwd = ''
    // Pi main.ts autoTrustOnReloadCwd: when the launch cwd hosted no
    // trust-requiring resources and no explicit override was given, a later
    // /reload that observes resources appearing mid-session persists an
    // implicit trusted decision (maybeSaveImplicitProjectTrustAfterReload).
    string auto_trust_on_reload_cwd = ''
    // Pi inserts a warning Text into the chat when the resolved project is
    // untrusted; Adou keeps an equivalent banner line under the header.
    bool show_untrusted_banner = false
    // B4: live terminal theme answer from OSC 11 / CSI 997 responses; empty
    // until a report arrives (env fallback stays authoritative before that).
    string live_theme_report = ''
    // B4: keyboard negotiation results (Pi terminal.ts).  kitty_negotiated
    // means the terminal answered the flags query with a non-zero mask;
    // modify_other_keys_active mirrors _modifyOtherKeysActive for teardown.
    bool kitty_negotiated
    bool modify_other_keys_active
    // Serialize state mutation and terminal rendering across the input loop
    // and file-watch/signal coroutines.
    ref<mutex.mutex_t> render_lock = mutex.mutex_t.new()
    // Coalesce SIGWINCH notifications before the input loop performs a
    // render request.
    ref<mutex.mutex_t> redraw_lock = mutex.mutex_t.new()
    bool resize_pending
    bool suppress_quit_render
    bool defer_redraw
    bool redraw_deferred
    // Pi reads already-decoded session entries in its footer. Adou's
    // repository stores JSON-shaped `any` maps, so decoding the whole log on
    // every 16 ms streaming frame creates avoidable allocation pressure and
    // can expose Nature GC/map corruption. Refresh these values only after a
    // repository-changing event or session rebind.
    bool repository_footer_dirty = true
    // Batch 4: one keybinding registry shared by the app dispatch, the
    // editor and every hint surface (Pi setKeybindings/getKeybindings).
    ref<keybindings.keybindings_t> keybindings = keybindings.current()
}

pub fn new(ref<term.terminal_t> terminal, ref<session.runner_t> runner, string model, string cwd, [string] skill_paths, bool no_skills, bool trust_override, bool trust_override_explicit, [string] initial_model_scope_patterns, bool model_scope_explicit, string system_prompt_override, [string] append_system_prompts, bool no_context_files, [string] prompt_template_paths, bool no_prompt_templates, bool no_themes): ref<view_t> {
    // CLI options land on the view BEFORE the first resource snapshot so
    // the initial model-candidate cache and the menu already honor them
    // (B1-R2-06 scope timing: no naked post-construction assignments in
    // app.n).
    // Batch 4: keybindings.json + defaults become the process registry
    // before the view is built so the editor resolves the same instance.
    var keybinding_registry = keybindings.create(paths.agent_dir())
    keybindings.set_current(keybinding_registry)
    var view = new view_t(terminal = terminal, runner = runner, chat = chat.new(model, cwd), editor = editor.new(), input_buffer = input_buffer.new(), renderer = renderer.new(), input_events = chan<input_t>.new(64), signals = chan<signal.sig_t>.new(8), active_stream = null, overlay = null, autocomplete = new autocomplete.autocomplete_state_t (), kitty_protocol = true, skill_paths = skill_paths, no_skills = no_skills, prompt_template_paths = prompt_template_paths, no_prompt_templates = no_prompt_templates, no_themes = no_themes, trust_override = trust_override, trust_override_explicit = trust_override_explicit, session_trust_override_set = false, session_trust_override = false, session_trust_cwd = cwd, model_scope_patterns = initial_model_scope_patterns, model_scope_explicit = model_scope_explicit, system_prompt_override = system_prompt_override, append_system_prompts = append_system_prompts, no_context_files = no_context_files, keybindings = keybinding_registry)
    string thinking = runner.agent_config.stream_options.reasoning_effort
    if !runner.agent_config.stream_options.thinking_enabled {
        thinking = 'off'
    } else if thinking == '' {
        thinking = 'on'
    }
    view.chat.configure(runner.agent_config.model.context_window, thinking)
    view.chat.set_auto_compaction(runner.compaction_settings.enabled)
    view.chat.git_branch = detect_git_branch(cwd)
    start_file_watchers(view, cwd)
    view.chat.load_messages(runner.active_messages)
    // Single trust-aware snapshot pass at init (B1-R2-06/08): trust-aware
    // settings, filtered prompt/skill resources, dynamic menu, autocomplete
    // max, the model scope/selector backing (B1-R3-05: when the CLI --models
    // scope is not explicit) and the model candidate cache all derive from
    // one refresh.
    view.refresh_resource_snapshot(cwd, false)
    // Pi main.ts: the implicit-trust-on-reload window only opens when the
    // launch cwd had no trust-requiring resources and no override was given.
    view.auto_trust_on_reload_cwd = !trust_override_explicit && !trust.has_trust_requiring_resources(cwd) ? cwd : ''
    // B1.1 (docs/porting-plan-100): Pi opens the trust selector at startup
    // when the project hosts trust-requiring resources, no explicit
    // override applies, no decision is saved and defaultProjectTrust is
    // 'ask'.  Dismissing leaves the project untrusted; headless modes
    // resolve the same state to untrusted without a prompt.
    if trust.needs_prompt(trust_override_explicit, trust_override, cwd, view.settings_snapshot.default_project_trust) {
        view.trust_prompted_cwd = cwd
        view.show_trust_startup_prompt()
    }
    view.update_untrusted_banner(cwd)
    var stored_settings = view.settings_snapshot
    view.activate_theme_setting(stored_settings.theme)
    string theme_file = syscall.get_env('ADOU_THEME_FILE')
    if theme_file != '' {theme.load_json(theme_file)}
    // Pi quietStartup suppresses the startup status lines; Adou's startup
    // surface is the recovery warning and the model/thinking status.
    if !stored_settings.quiet_startup && runner.repository.get_warnings().len() > 0 {
        view.chat.status = 'Session recovered: ' + runner.repository.get_warnings()[0]
    }
    if stored_settings.show_hardware_cursor {
        // term.open hides the cursor on entry; showHardwareCursor keeps it
        // visible while the renderer still positions it.
        view.terminal.set_hardware_cursor(true) catch error {}
    }
    return view
}

// Pi theme values: 'light', 'dark' or an automatic 'lightTheme/darkTheme'
// pair. Use COLORFGBG as the non-interactive fallback when no live OSC/997
// terminal report is available.
fn active_theme_variant(string setting, string live_report): string {
    if setting == 'light' {return 'light'}
    if setting.contains('/') {
        int slash = setting.find('/')
        string light_name = setting.slice(0, slash)
        string dark_name = setting.slice(slash + 1, setting.len())
        if live_report != '' {
            return live_report == 'light' ? light_name : dark_name
        }
        return terminal_colors.detect_terminal_theme_from_env() == 'light' ? light_name : dark_name
    }
    return setting == '' ? 'dark' : setting
}

fn view_t.activate_theme_setting(&self, string setting) {
    string active = active_theme_variant(setting, self.live_theme_report)
    if !self.no_themes {
        theme.ensure_named_loaded(self.runner.repository.cwd, active)
    }
    theme.set_variant(active)
    self.chat.invalidate_transcript_cache()
}

fn view_t.available_theme_names(&self): [string] {
    if self.no_themes {return ['dark', 'light']}
    return theme.available_names(self.runner.repository.cwd)
}

// B1-R2-06/07/08: one trust-aware resource snapshot refresh shared by init,
// /reload and session rebind.  The trust decision is resolved once; the
// trust-aware settings, the user + trust-gated project prompt templates and
// skills, the filtered execution lists, the completion-menu dynamic
// commands, the autocomplete max and (when reload_auth) the credential and
// model candidate caches all derive from that single pass.  Ordinary
// typing never re-reads settings or resources.
pub fn view_t.refresh_resource_snapshot(&self, string cwd, bool reload_auth) {
    bool trusted = self.trusted_for(cwd)
    self.settings_snapshot = config_settings.load_trusted_for(cwd, trusted)
    [string] no_extra = []
    var template_extras = self.prompt_template_paths
    var templates = prompt_templates.load_prompt_templates(cwd, paths.agent_dir(), template_extras, !self.no_prompt_templates, trusted)
    var skills_result = skills.load_skills(cwd, paths.agent_dir(), self.skill_paths, !self.no_skills, trusted) catch error {
        skills.load_skills_result_t {}
    }
    // Shared production filters (slash_commands.filter_*): the same rule as
    // the app/RPC assembly paths.
    self.available_prompt_templates = templates
    self.available_skills = skills_result.skills
    self.prompt_templates = slash_commands.filter_prompt_templates_configured(self.available_prompt_templates, self.settings_snapshot.enabled_prompt_names, self.settings_snapshot.enabled_prompts_configured)
    self.cached_skills = slash_commands.filter_skills_configured(self.available_skills, self.settings_snapshot.enabled_skill_names, self.settings_snapshot.enabled_skills_configured)
    self.dynamic_commands = slash_commands.compose_resource_commands(self.prompt_templates, self.cached_skills, self.settings_snapshot.enable_skill_commands)
    self.autocomplete_max_visible = autocomplete.clamp_max_visible(self.settings_snapshot.autocomplete_max_visible)
    self.editor_padding_x = self.settings_snapshot.editor_padding_x
    // Batch 3 runtime effects: render/chat/theme mirrors follow the merged
    // settings snapshot on every refresh boundary (init, /reload, rebind).
    self.chat.set_output_pad(self.settings_snapshot.output_pad)
    self.chat.set_image_preferences(self.settings_snapshot.show_images, self.settings_snapshot.image_width_cells, self.settings_snapshot.auto_resize_images)
    self.chat.set_show_cache_miss_notices(self.settings_snapshot.show_cache_miss_notices)
    self.renderer.set_clear_on_shrink(self.settings_snapshot.terminal_clear_on_shrink)
    self.activate_theme_setting(self.settings_snapshot.theme)
    self.runner.apply_preferences_snapshot(self.settings_snapshot)
    self.rebuild_read_tool_options(self.settings_snapshot.auto_resize_images)
    // B1-R3-05: the /scoped-models settings backing ALWAYS follows the
    // trust-aware enabledModels snapshot — an explicit CLI scope must not
    // wipe the settings-backed selector to an empty default.  The CLI scope
    // itself persists across rebinds when explicit and otherwise also
    // derives from the snapshot.  Both are refreshed BEFORE the model
    // candidates are rebuilt (refresh_model_argument_cache below), so a
    // rebind never re-scans with the old project's scope.  The legacy
    // Batch-2 selector global stays in sync until that selector drops it.
    self.scoped_model_ids = []
    self.scoped_models_dirty = false
    for model_id in self.settings_snapshot.enabled_model_ids {
        self.scoped_model_ids.push(model_id)
    }
    self.scoped_models_active = self.settings_snapshot.enabled_models_configured
    if !self.model_scope_explicit {
        self.model_scope_patterns = []
        for model_id in self.settings_snapshot.enabled_model_ids {
            self.model_scope_patterns.push(model_id)
        }
    }
    bool model_scope_changed = !self.model_argument_cache_valid || !same_scope_patterns(self.model_scope_patterns, self.cached_model_scope_patterns)
    if reload_auth {
        auth.reload()
    }
    if reload_auth || model_scope_changed {
        refresh_auth_provider_count(self)
        self.refresh_model_argument_cache()
    }
}

pub fn view_t.run(&self): void! {
    debug.log('tui', 'run loop start')
    signal.notify(self.signals, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP, syscall.SIGWINCH)
    var terminal_input = chan<terminal_input_t>.new(64)
    go read_terminal(self, terminal_input)
    go read_input(self, terminal_input, self.input_events)
    go read_signals(self)
    self.run_loop() catch error {
        self.stop_signals()
        throw error
    }
    self.stop_signals()
    // B1-R5-01: normal run-loop exit marker.  Together with the term.n
    // restore event it distinguishes a genuine /quit shutdown from a
    // suspend (Ctrl+Z) restore and from an EOF/EINTR-exhaustion induced
    // clean exit (which additionally logs 'eof'/'eintr-exhausted').
    debug.log_tui_io(term.TUI_IO_QUIT, 'run loop exited')
    debug.log('tui', 'run loop end')
}

pub fn view_t.run_loop(&self): void! {
    self.render()
    for !self.quitting {
        if self.active_stream is ref<session_stream.stream_t> stream {
            bool finished = self.consume_stream(stream)
            if finished {
                self.active_stream = null
                self.active_stream = self.start_next_initial_prompt()
            }
            continue
        }
        var incoming = self.input_events.recv() catch e {
            self.quitting = true
            break
        }
        // Resize notifications are lower priority than already-buffered
        // keyboard input.  Drain one queued event first so a resize burst
        // cannot delay /quit or another editing command behind a full frame.
        if incoming.resize {
            for true {
                var (queued, has_queued) = self.input_events.try_recv() catch error {
                    self.quitting = true
                    break
                }
                if !has_queued {break}
                self.redraw_lock.lock()
                self.resize_pending = false
                self.redraw_lock.unlock()
                if queued.resize {continue}
                incoming = queued
                break
            }
        }
        self.defer_redraw = true
        self.redraw_deferred = false
        ref<session_stream.stream_t>? next = self.handle_idle_input(incoming)
        if next is ref<session_stream.stream_t> stream {
            self.active_stream = stream
        }
        // Terminal readers commonly deliver a pasted/PTY-fed line as many
        // input events in one scheduler turn. Handle the queued suffix before
        // rendering so a full line never causes one terminal write per byte.
        for true {
            var (queued, has_queued) = self.input_events.try_recv() catch error {
                self.quitting = true
                break
            }
            if !has_queued {break}
            if queued.resize {
                self.redraw_lock.lock()
                self.resize_pending = false
                self.redraw_lock.unlock()
                self.render_lock.lock()
                self.renderer.invalidate()
                self.render_lock.unlock()
                continue
            }
            if self.active_stream is ref<session_stream.stream_t> stream {
                self.handle_stream_input(stream, queued)
            } else {
                var queued_stream = self.handle_idle_input(queued)
                if queued_stream is ref<session_stream.stream_t> stream {
                    self.active_stream = stream
                }
            }
        }
        self.defer_redraw = false
        bool should_redraw = self.redraw_deferred && !self.quitting
        self.redraw_deferred = false
        if should_redraw {
            self.redraw()
        }
    }
}

pub fn view_t.consume_stream(&self, ref<session_stream.stream_t> stream): bool! {
    debug.log('tui', 'consume stream start')
    if self.settings_snapshot.terminal_progress {
        self.terminal.set_progress(true) catch error {}
    }
    bool branch_aborted = false
    string branch_error = ''
    bool stream_failed = false
    bool render_pending = false
    i64 last_render_ms = 0
    for true {
        var (incoming, input_received) = self.input_events.try_recv() catch error {
            self.quitting = true
            stream.abort()
            break
        }
        if input_received {
            self.handle_stream_input(stream, incoming)
        } else if self.input_events.is_closed() {
            self.quitting = true
            stream.abort()
            break
        }
        var (event, event_received) = stream.events.try_recv() catch error {
            self.chat.error_message = error.msg()
            self.chat.status = 'Request failed'
            self.redraw()
            break
        }
        if event_received {
            debug.log('tui', 'session event=' + event.kind)
            if event.kind == session_stream.EVENT_BRANCH_SUMMARY_END {
                branch_aborted = event.aborted
                branch_error = event.error_message
            }
            self.apply_stream_event(event)
            render_pending = true
            if event.kind == session_stream.EVENT_SESSION_END {
                self.redraw()
                break
            }
        }
        i64 now = time.now().ms_timestamp()
        if self.advance_stream_spinner(now) {
            render_pending = true
        }
        if render_pending && (last_render_ms == 0 || now - last_render_ms >= 16) {
            self.redraw()
            render_pending = false
            last_render_ms = now
        }
        if event_received {
            continue
        }
        if stream.events.is_closed() {
            debug.log('tui', 'stream channel closed before session_end')
            break
        }
        co.sleep(8)
    }
    var final_messages = stream.result() catch error {
        debug.log('tui', 'stream result failed: ' + error.msg())
        stream_failed = true
        self.chat.error_message = error.msg()
        self.chat.status = 'Request failed'
        self.redraw()
        []
    }
    // The terminal event carries the canonical active branch.  Reload it
    // after every operation so compaction, tree navigation, retry cleanup,
    // and cancellation cannot leave stale messages rendered in the TUI.
    if !stream_failed {
        self.reload_chat_messages(final_messages)
    }
    if self.pending_tree_navigation {
        string target_id = self.pending_tree_target_id
        if !stream_failed && !branch_aborted && branch_error == '' {
            self.reload_chat_messages(self.runner.active_messages)
            if self.pending_tree_editor_text != '' && self.editor.get_text().trim([' ', '\t', '\n', '\r']) == '' {
                self.editor.set_text(self.pending_tree_editor_text)
            }
            self.chat.status = 'Navigated to selected point'
            self.chat.error_message = ''
        } else if branch_aborted {
            self.chat.status = 'Branch summarization cancelled'
            self.restore_tree_overlay(target_id)
        }
        self.pending_tree_navigation = false
        self.pending_tree_editor_text = ''
        self.pending_tree_target_id = ''
        self.redraw()
    }
    if self.settings_snapshot.terminal_progress {
        self.terminal.set_progress(false) catch error {}
    }
    return true
}

// Stream events mutate chat-owned state while rendering can also be requested
// by file-watch and signal coroutines. Applying events under the render lock
// keeps vector replacement and terminal rendering serialized.
fn view_t.apply_stream_event(&self, session_stream.event_t event): void! {
    self.render_lock.lock()
    self.chat.apply(event) catch error {
        self.render_lock.unlock()
        throw error
    }
    if event.kind == agent_types.EVENT_MESSAGE_END || event.kind == session_stream.EVENT_COMPACTION_END || event.kind == session_stream.EVENT_BRANCH_SUMMARY_END || event.kind == session_stream.EVENT_SESSION_INFO_CHANGED {
        self.repository_footer_dirty = true
    }
    self.render_lock.unlock()
}

fn view_t.advance_stream_spinner(&self, i64 now): bool {
    self.render_lock.lock()
    bool changed = self.chat.advance_spinner(now)
    self.render_lock.unlock()
    return changed
}

// Same serialization for transcript replacement (stream completion, session
// switches, tree navigation): the message vector is swapped under the render
// lock so an in-flight frame never iterates a half-replaced list.
fn view_t.reload_chat_messages(&self, [ai_types.message_t] messages) {
    self.render_lock.lock()
    self.chat.load_messages(messages)
    self.repository_footer_dirty = true
    self.render_lock.unlock()
    self.redraw()
}

fn view_t.clear_chat(&self) {
    self.render_lock.lock()
    self.chat.clear()
    self.repository_footer_dirty = true
    self.render_lock.unlock()
    self.redraw()
}

pub fn view_t.handle_idle_input(&self, input_t input): ref<session_stream.stream_t>? {
    if input.resize {
        self.redraw_lock.lock()
        self.resize_pending = false
        self.redraw_lock.unlock()
        // A resize invalidates differential history. Defer the actual full
        // repaint until the next state-changing input so a SIGWINCH burst
        // cannot fill a PTY output buffer while the user is still typing.
        self.render_lock.lock()
        self.renderer.invalidate()
        self.render_lock.unlock()
        return null
    }
    if input.oauth_ready || input.oauth_done || input.oauth_failed {
        self.handle_oauth_event(input)
        return null
    }
    if input.model_refresh_done {
        self.apply_model_refresh(input.model_refresh_generation, input.model_refresh_failures)
        return null
    }
    if input.version_check_done {
        self.apply_version_notice(input.version_notice)
        return null
    }
    if self.overlay is ref<overlay_t> active_overlay {
        self.handle_overlay_input(active_overlay, input)
        return null
    }
    if input.paste {
        // Pi handlePaste: paste cancels autocomplete and never re-triggers it
        // (a pasted "/" must not open the slash menu, B1-R1-05).
        self.autocomplete.cancel()
        self.editor.handle_paste(input.data)
        self.redraw()
        return null
    }
    string key = keys.parse_key(input.data)
    // Pi editor.ts autocomplete key contract: Esc cancels; Up/Down move with
    // wrap; Tab applies the completion without submitting; Enter applies and,
    // for a "/" prefix, falls through to submit the completed command line.
    // PageUp/PageDown leave the candidates, selection and pager untouched
    // (B1-R1-06): they must never re-derive the query.
    if self.autocomplete.active {
        if key == 'escape' {
            self.autocomplete.cancel()
            self.invalidate_transient_renderer()
            self.redraw()
            return null
        }
        if key == 'up' {
            self.autocomplete.move_up()
            self.redraw()
            return null
        }
        if key == 'down' {
            self.autocomplete.move_down()
            self.redraw()
            return null
        }
        if key == 'tab' {
            self.apply_autocomplete(false)
            self.redraw()
            return null
        }
        if key == 'enter' {
            return self.apply_autocomplete(true)
        }
    }
    if self.keybindings.matches(key, keybindings.APP_INTERRUPT) {
        if self.editor.get_text().trim([' ', '\t', '\n', '\r']) == '' {
            i64 now = time.now().ms_timestamp()
            if now - self.last_escape_time < 500 {
                self.last_escape_time = 0
                // Pi settings.doubleEscapeAction: 'tree' (default), 'fork' or
                // 'none' (double escape disabled entirely).
                string action = self.settings_snapshot.double_escape_action
                if action == 'tree' {
                    self.show_tree_overlay()
                } else if action == 'fork' {
                    self.show_fork_overlay()
                }
                self.redraw()
            } else {
                self.last_escape_time = now
            }
        }
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_CLEAR) {
        i64 now = time.now().ms_timestamp()
        if now - self.last_sigint_time < 500 {
            self.quitting = true
        } else {
            self.editor.clear()
            // Pi setText('') cancels autocomplete; the cleared editor must
            // never leave a stale menu active (B1-R1-05).
            self.autocomplete.cancel()
            self.invalidate_transient_renderer()
            self.last_sigint_time = now
            self.redraw()
        }
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_EXIT) && self.editor.get_text() == '' {
        self.quitting = true
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_SUSPEND) {
        self.suspend_terminal()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_EDITOR_EXTERNAL) {
        self.open_external_editor()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_CLIPBOARD_PASTE_IMAGE) {
        self.paste_clipboard()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_THINKING_CYCLE) {
        self.cycle_thinking_level()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_MODEL_CYCLE_FORWARD) {
        self.cycle_model(1)
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_MODEL_CYCLE_BACKWARD) {
        self.cycle_model(-1)
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_MODEL_SELECT) {
        self.show_model_overlay('')
        self.redraw()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_TOOLS_EXPAND) {
        bool expanded = self.chat.toggle_tool_output()
        self.chat.status = 'Tool output: ' + (expanded ? 'expanded' : 'collapsed')
        self.redraw()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_THINKING_TOGGLE) {
        bool visible = self.chat.toggle_thinking_visibility()
        self.chat.status = 'Thinking blocks: ' + (visible ? 'visible' : 'hidden')
        self.save_preferences()
        self.redraw()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_MESSAGE_COPY) {
        self.copy_last_response()
        return null
    }
    if self.keybindings.matches(key, keybindings.APP_MESSAGE_FOLLOW_UP) {
        var submitted = self.editor.submit()
        if submitted.text != '' {
            self.editor.add_history(submitted.text)
            return self.start_prompt(submitted.text)
        }
        return null
    }
    var result = self.editor.handle_key(input.data, self.kitty_protocol) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    self.apply_editor_action(result)
    if result.action == editor.ACTION_TAB {
        self.handle_tab_completion()
        return null
    }
    if result.submitted {
        if result.text == '' {
            self.redraw()
            return null
        }
        self.autocomplete.cancel()
        self.editor.add_history(result.text)
        return self.start_prompt(result.text)
    }
    // B1-R1-06: page keys move the cursor but must not re-derive the
    // autocomplete query; candidates, selection and pager stay untouched.
    // Only keys that change the query/cursor text re-run the state machine.
    if result.action == editor.ACTION_SCROLL_UP || result.action == editor.ACTION_SCROLL_DOWN {
        self.redraw()
        return null
    }
    self.update_autocomplete_state()
    // /quit and /exit are terminal lifecycle commands. Once their prefix is
    // recognized, avoid repainting for every remaining character while the
    // PTY may still contain a large overlay frame.
    string pending_command = self.editor.get_text()
    if self.suppress_quit_render {
        if pending_command == '/' || pending_command.starts_with('/quit') || pending_command.starts_with('/exit') {
            return null
        }
        self.suppress_quit_render = false
    }
    if pending_command.starts_with('/quit') || pending_command.starts_with('/exit') {
        return null
    }
    self.redraw()
    return null
}

pub fn view_t.handle_stream_input(&self, ref<session_stream.stream_t> stream, input_t input) {
    if input.resize {
        self.redraw_lock.lock()
        self.resize_pending = false
        self.redraw_lock.unlock()
        self.redraw()
        return
    }
    if input.oauth_ready || input.oauth_done || input.oauth_failed {
        self.handle_oauth_event(input)
        return
    }
    if input.model_refresh_done {
        self.apply_model_refresh(input.model_refresh_generation, input.model_refresh_failures)
        return
    }
    if input.version_check_done {
        self.apply_version_notice(input.version_notice)
        return
    }
    if input.paste {
        self.editor.handle_paste(input.data)
        self.redraw()
        return
    }
    string key = keys.parse_key(input.data)
    // Adou aborts on escape (app.interrupt) and ctrl+c (app.clear) while
    // streaming; both resolve through the registry.
    if self.keybindings.matches(key, keybindings.APP_INTERRUPT) || self.keybindings.matches(key, keybindings.APP_CLEAR) {
        debug.log('tui', 'stream cancel requested key=' + key)
        stream.abort()
        self.chat.status = 'Cancelling...'
        self.redraw()
        return
    }
    if self.keybindings.matches(key, keybindings.APP_SUSPEND) {
        self.suspend_terminal()
        return
    }
    if self.keybindings.matches(key, keybindings.APP_CLIPBOARD_PASTE_IMAGE) {
        self.paste_clipboard()
        return
    }
    if self.keybindings.matches(key, keybindings.APP_TOOLS_EXPAND) {
        bool expanded = self.chat.toggle_tool_output()
        self.chat.status = 'Tool output: ' + (expanded ? 'expanded' : 'collapsed')
        self.redraw()
        return
    }
    if self.keybindings.matches(key, keybindings.APP_THINKING_TOGGLE) {
        bool visible = self.chat.toggle_thinking_visibility()
        self.chat.status = 'Thinking blocks: ' + (visible ? 'visible' : 'hidden')
        self.save_preferences()
        self.redraw()
        return
    }
    if self.keybindings.matches(key, keybindings.APP_MESSAGE_DEQUEUE) {
        self.restore_queued_messages()
        return
    }
    if self.keybindings.matches(key, keybindings.APP_MESSAGE_FOLLOW_UP) {
        var submitted = self.editor.submit()
        if submitted.text != '' {
            var message = new ai_types.user_message_t(content = submitted.text, timestamp = time.now().ms_timestamp())
            self.runner.queue_follow_up(message)
        }
        self.redraw()
        return
    }
    var result = self.editor.handle_key(input.data, self.kitty_protocol) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.apply_editor_action(result)
    if result.submitted && result.text != '' {
        var message = new ai_types.user_message_t(content = result.text, timestamp = time.now().ms_timestamp())
        self.runner.queue_steering(message)
    }
    self.redraw()
}

pub fn view_t.start_version_check(&self, string current_version, bool offline) {
    if offline || syscall.get_env('ADOU_SKIP_VERSION_CHECK') != '' {return}
    go version_check_worker(self, current_version)
}

fn version_check_worker(ref<view_t> view, string current_version): void! {
    var latest = version_check.latest(current_version)
    if latest is ref<version_check.release_t> release {
        view.input_events.try_send(input_t {version_check_done: true, version_notice: 'New Adou version available: ' + release.version,}) catch error {}
    }
}

fn view_t.apply_version_notice(&self, string notice) {
    if notice == '' || self.quitting {return}
    if self.chat.status == '' {
        self.chat.status = notice
        self.redraw()
    }
}

fn view_t.apply_editor_action(&self, editor.key_result_t result) {
    if result.action != editor.ACTION_SCROLL_UP && result.action != editor.ACTION_SCROLL_DOWN {
        return
    }
    var size = self.terminal.size() catch error {term.size_t {rows: 24, columns: 80,}}
    int page_size = size.rows * 30 / 100
    if page_size < 5 {
        page_size = 5
    }
    int direction = result.action == editor.ACTION_SCROLL_UP ? -1 : 1
    self.editor.move_page(direction, page_size) catch error {}
}

// Tab completion follows Pi's editor: a slash command without an argument
// opens the command menu, otherwise the token before the cursor completes
// as a file path.  Pi force+explicitTab semantics (B1-R4-03): a SINGLE
// candidate applies directly; several open the shared SelectList; NONE
// leaves the editor untouched — a failed completion is never disguised as
// an indentation.
fn view_t.handle_tab_completion(&self) {
    var cursor = self.editor.get_cursor()
    var lines = self.editor.get_lines()
    string before = ''
    if cursor.line < lines.len() {
        int column = cursor.column
        if column < 0 {
            column = 0
        }
        if column > lines[cursor.line].len() {
    // B5: Pi live-refilters an open path menu as the query grows.  A Tab-
    // opened PATH menu previously cancelled on the next keystroke because no
    // branch re-derived its candidates; keep it alive while the anchor holds.
    if self.autocomplete.active && self.autocomplete.mode == autocomplete.autocomplete_mode_t.PATH {
        if cursor.line == self.autocomplete.anchor_line && column >= self.autocomplete.anchor_column {
            int start_col = self.autocomplete.anchor_column
            if start_col > lines[cursor.line].len() {start_col = lines[cursor.line].len()}
            string prefix = lines[cursor.line].slice(start_col, column)
            string home = syscall.get_env('HOME')
            var items = path_completion.get_file_suggestions(prefix, self.runner.repository.cwd, home)
            [autocomplete.autocomplete_item_t] mapped = []
            for item in items {
                mapped.push(self.path_item(item))
            }
            if mapped.len() > 0 {
                self.autocomplete.begin(autocomplete.autocomplete_mode_t.PATH, generation_next(self), prefix, prefix, mapped, self.resolved_max_visible())
                self.autocomplete.anchor_line = cursor.line
                self.autocomplete.anchor_column = column
                return
            }
        }
        self.autocomplete.cancel()
        return
    }
            column = lines[cursor.line].len()
        }
        before = lines[cursor.line].slice(0, column)
    }
    if before.starts_with('/') && !before.contains(' ') {
        // Pi handleTabCompletion -> handleSlashCommandCompletion (B1-R2-01):
        // Tab with no active menu only re-requests and shows the candidates;
        // it must never apply within the same keypress (Pi 0.82.1 oracle:
        // /mo, Esc, Tab reopens model/scoped-models/import with the editor
        // still "/mo").  Only an already-active menu applies the current
        // item; in the normal dispatch the active menu consumes Tab in the
        // autocomplete branch first, so this branch sees was_active=false,
        // but the apply path stays reachable and defensive.
        bool was_active = self.autocomplete.active
        if !was_active {
            self.update_autocomplete_state()
            self.redraw()
            return
        }
        self.apply_autocomplete(false)
        self.redraw()
        return
    }
    string home = syscall.get_env('HOME')
    string at_prefix = path_completion.extract_at_prefix(before)
    if at_prefix != '' {
        var items = self.at_items(at_prefix)
        if items.len() == 1 {
            self.apply_path_item(items[0], autocomplete.autocomplete_mode_t.AT, at_prefix)
        } else if items.len() > 1 {
            self.begin_path_menu(autocomplete.autocomplete_mode_t.AT, at_prefix, items)
        }
        self.redraw()
        return
    }
    // B1-R4-03: an empty prefix is a valid root listing (Pi: blank Tab with
    // a single root candidate applies it; none leaves the editor alone).
    string prefix = path_completion.extract_path_prefix(before, true)
    var items = path_completion.get_file_suggestions(prefix, self.runner.repository.cwd, home)
    if items.len() == 0 {
        self.redraw()
        return
    }
    if items.len() == 1 {
        var mapped = self.path_item(items[0])
        self.apply_path_item(mapped, autocomplete.autocomplete_mode_t.PATH, prefix)
        self.redraw()
        return
    }
    [autocomplete.autocomplete_item_t] mapped = []
    for item in items {
        mapped.push(self.path_item(item))
    }
    self.begin_path_menu(autocomplete.autocomplete_mode_t.PATH, prefix, mapped)
    self.redraw()
}

// Open the shared SelectList for path/@ candidates (B1-R4-02), exactly like
// slash/argument modes: same state, same wrap/max-visible/render lifecycle.
fn view_t.begin_path_menu(&self, autocomplete.autocomplete_mode_t mode, string prefix, [autocomplete.autocomplete_item_t] items) {
    int generation = self.autocomplete.generation + 1
    self.autocomplete.begin(mode, generation, prefix, prefix, items, self.resolved_max_visible())
    var cursor = self.editor.get_cursor()
    var lines = self.editor.get_lines()
    self.autocomplete.anchor_line = cursor.line
    int column = cursor.column
    if cursor.line >= 0 && cursor.line < lines.len() && column > lines[cursor.line].len() {
        column = lines[cursor.line].len()
    }
    if column < 0 {
        column = 0
    }
    self.autocomplete.anchor_column = column
}

// Map a path_completion candidate onto the shared autocomplete item.
fn view_t.path_item(&self, path_completion.completion_item_t item): autocomplete.autocomplete_item_t {
    return autocomplete.autocomplete_item_t {value: item.value, label: item.label, description: item.description, kind: autocomplete.item_kind_t.PATH}
}

// The @ attachment candidates from the fuzzy tree walk (B1-R4-04/05), using
// the shared extract_at_prefix boundary parser; quoted @"prefix forms keep
// their quotes in the inserted value.
fn view_t.at_items(&self, string at_prefix): [autocomplete.autocomplete_item_t] {
    string home = syscall.get_env('HOME')
    bool quoted = at_prefix.starts_with('@"')
    string query = quoted ? at_prefix.slice(2, at_prefix.len()) : at_prefix.slice(1, at_prefix.len())
    var items = path_completion.get_fuzzy_file_suggestions(query, self.runner.repository.cwd, home)
    [autocomplete.autocomplete_item_t] result = []
    for item in items {
        string value = item.value
        if quoted {
            value = path_completion.quoted_at_completion_value(item.value)
        }
        result.push(autocomplete.autocomplete_item_t {value: value, label: item.label, description: item.description, kind: autocomplete.item_kind_t.PATH})
    }
    return result
}

// Pi CombinedAutocompleteProvider.applyCompletion for file/@ attachments
// (B1-R4-12): the byte range [cursorCol - prefix.length, cursorCol) of ONE
// line is replaced atomically (B1-R3-01).  Other logical lines, the paste
// registry and the kill ring survive, and the whole replacement is one undo
// step — never editor.set_text_at(), which rebuilds the buffer and drops
// pastes/paste_counter.  The shared completion_range computes the range,
// the @-attachment space suffix (@file -> ' ', @dir/ -> none) and the
// quoted cursor adjustments.
fn view_t.apply_path_item(&self, autocomplete.autocomplete_item_t item, autocomplete.autocomplete_mode_t mode, string prefix) {
    var cursor = self.editor.get_cursor()
    var lines = self.editor.get_lines()
    if cursor.line >= lines.len() {
        return
    }
    string line = lines[cursor.line]
    if cursor.column > line.len() {
        return
    }
    var range = path_completion.completion_range(cursor.column, line, prefix, path_completion.completion_item_t {value: item.value, label: item.label, description: item.description}, mode == autocomplete.autocomplete_mode_t.AT)
    self.editor.apply_completion_at(cursor.line, range[0], range[1], range[2], range[3])
}

// Pi restores the terminal before sending SIGTSTP and re-enters raw mode when
// the foreground job is continued. Keep that lifecycle here as well so
// Ctrl+Z does not leave the shell in raw mode or turn into editor undo.
fn view_t.suspend_terminal(&self) {
    self.restore_terminal() catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    syscall.kill(0, syscall.SIGTSTP) catch error {
        self.chat.error_message = error.msg()
    }
    self.reenter_terminal() catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.chat.error_message = ''
    self.redraw()
}

fn view_t.reenter_terminal(&self): void! {
    // Restore/reenter and render frames share the same stdout; run both
    // under the render lock so the terminal can never observe an interleaved
    // frame while raw mode is being toggled.  terminal.restore() only sets
    // restored/active after writing its sequences, so flag-based guards
    // alone cannot close the window.  Any failure still releases the lock
    // before propagating.
    self.render_lock.lock()
    term.enter_raw(self.terminal.input_fd) catch error {
        self.render_lock.unlock()
        throw error
    }
    // The shell or editor rewrote the screen while we were suspended, even
    // when no deferred render happened to be in flight; the diff state is
    // stale either way.  Invalidate under the lock so the first frame after
    // reenter is a cleared full repaint instead of a no-op diff.
    self.renderer.invalidate()
    self.terminal.restored = false
    self.terminal.active = true
    self.terminal.write(term.BRACKETED_PASTE_ON + (self.settings_snapshot.show_hardware_cursor ? '' : term.CURSOR_HIDE) + term.KEYBOARD_NEGOTIATION_QUERY + terminal_colors.background_query_sequence() + terminal_colors.color_scheme_query_sequence() + terminal_image.cell_size_query_sequence()) catch error {
        self.render_lock.unlock()
        throw error
    }
    self.render_lock.unlock()
}

fn view_t.restore_terminal(&self): void! {
    self.render_lock.lock()
    bool was_active = !self.terminal.restored
    self.terminal.restore() catch error {
        self.render_lock.unlock()
        throw error
    }
    self.render_lock.unlock()
    if was_active {
        debug.log_terminal_output(term.KEYBOARD_PROTOCOL_OFF + term.BRACKETED_PASTE_OFF + term.CURSOR_SHOW)
    }
}

// Shutdown entry point for the app after the run loop exits. Restore failures
// propagate like the previous direct terminal.restore() calls; the app
// decides whether to ignore them (error-exit path) or surface them.
pub fn view_t.restore_terminal_sync(&self): void! {
    // B4: remove kitty placements so no image artifacts survive exit.
    string kitty_clear = terminal_image.clear_kitty_placements()
    if kitty_clear != '' {
        self.terminal.write(kitty_clear) catch error {}
    }
    if self.modify_other_keys_active {
        self.modify_other_keys_active = false
        self.terminal.write(term.MODIFY_OTHER_KEYS_OFF) catch error {}
    }
    self.render_lock.lock()
    self.terminal.restore() catch error {
        self.render_lock.unlock()
        throw error
    }
    self.render_lock.unlock()
}

// Ctrl+G follows Pi's external-editor action. The TUI is restored while the
// user's editor owns the terminal, then the edited file is read back into the
// multiline prompt and raw mode is enabled again.
fn view_t.open_external_editor(&self) {
    // Pi: the externalEditor setting takes precedence over VISUAL/EDITOR.
    string editor_command = self.settings_snapshot.external_editor
    if editor_command == '' {
        editor_command = syscall.get_env('VISUAL')
    }
    if editor_command == '' {
        editor_command = syscall.get_env('EDITOR')
    }
    if editor_command == '' {
        editor_command = 'vi'
    }
    int pid = syscall.getpid() catch error {0}
    string temp_path = '/tmp/adou-editor-' + fmt.sprintf('%d', pid) + '.txt'
    var file = fs.open(temp_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o600) catch error {
        self.chat.error_message = 'Could not create editor buffer: ' + error.msg()
        self.redraw()
        return
    }
    file.write(self.editor.get_expanded_text() as [u8]) catch error {
        file.close()
        self.chat.error_message = 'Could not write editor buffer: ' + error.msg()
        self.redraw()
        return
    }
    file.close()
    self.restore_terminal() catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    var stdin_file = fs.stdin() catch error {
        self.reenter_terminal() catch reenter_error {}
        self.chat.error_message = 'Could not open terminal input: ' + error.msg()
        self.redraw()
        return
    }
    var stdout_file = fs.stdout() catch error {
        self.reenter_terminal() catch reenter_error {}
        self.chat.error_message = 'Could not open terminal output: ' + error.msg()
        self.redraw()
        return
    }
    var stderr_file = fs.stderr() catch error {
        self.reenter_terminal() catch reenter_error {}
        self.chat.error_message = 'Could not open terminal error output: ' + error.msg()
        self.redraw()
        return
    }
    var command = new process.command_t(name = '/bin/sh', args = ['-c', editor_command + ' "$1"', 'adou-editor', temp_path], cwd = '', env = [], stdin = stdin_file, stdout = stdout_file, stderr = stderr_file)
    var child = command.spawn() catch error {
        self.reenter_terminal() catch reenter_error {}
        self.chat.error_message = 'Could not launch editor: ' + error.msg()
        self.redraw()
        return
    }
    child.wait() catch error {
        self.chat.error_message = 'External editor failed: ' + error.msg()
    }
    self.reenter_terminal() catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    var edited = fs.open(temp_path, syscall.O_RDONLY, 0) catch error {
        os.remove(temp_path) catch remove_error {}
        self.chat.error_message = 'Could not read editor buffer: ' + error.msg()
        self.redraw()
        return
    }
    string content = edited.content() catch error {
        edited.close()
        os.remove(temp_path) catch remove_error {}
        self.chat.error_message = 'Could not read editor buffer: ' + error.msg()
        self.redraw()
        return
    }
    edited.close()
    os.remove(temp_path) catch remove_error {}
    self.editor.set_text(content)
    self.chat.status = 'Loaded text from external editor'
    self.chat.error_message = ''
    self.redraw()
}

pub fn view_t.start_prompt(&self, string text): ref<session_stream.stream_t>? {
    self.autocomplete.cancel()
    self.overlay = null
    if text.starts_with('!') {
        bool excluded = text.starts_with('!!')
        string command = excluded ? text.slice(2, text.len()).trim([' ', '\t']) : text.slice(1, text.len()).trim([' ', '\t'])
        if command == '' {
            self.chat.status = 'Usage: !<command>'
            self.redraw()
            return null
        }
        self.runner.begin_operation() catch error {
            self.chat.error_message = error.msg()
            self.chat.status = 'Request failed'
            self.redraw()
            return null
        }
        var stream = session_stream.new()
        self.runner.attach_stream(stream)
        go run_interactive_bash(self.runner, stream, command, excluded)
        return stream
    }
    if text.starts_with('/') {
        var skill_expanded = self.expand_skill_command(text)
        var expanded = prompt_templates.expand_prompt_template(skill_expanded, self.prompt_templates)
        if expanded != skill_expanded {
            self.editor.clear()
            return self.start_prompt(expanded)
        }
        if skill_expanded != text {
            self.editor.clear()
            return self.start_prompt(skill_expanded)
        }
        var command_stream = self.run_command(text)
        // Selecting a slash-command from completion does not go through
        // editor.submit(), so clear the command line here just like Pi does.
        self.editor.clear()
        return command_stream
    }
    var stream = self.runner.prompt(text) catch error {
        debug.log('tui', 'prompt rejected: ' + error.msg())
        self.chat.error_message = error.msg()
        self.chat.status = 'Request failed'
        self.redraw()
        return null
    }
    debug.log('tui', 'prompt submitted chars=' + fmt.sprintf('%d', text.len()))
    return stream
}

pub fn view_t.start_next_initial_prompt(&self): ref<session_stream.stream_t>? {
    for self.pending_initial_messages.len() > 0 {
        string text = self.pending_initial_messages[0]
        self.pending_initial_messages = self.pending_initial_messages.slice(1, self.pending_initial_messages.len())
        [ref<ai_types.image_attachment_t>] images = self.pending_initial_images
        self.pending_initial_images = []
        var stream = images.len() > 0 ? self.runner.prompt_with_images(text, images) : self.runner.prompt(text) catch error {
            debug.log('tui', 'initial prompt rejected: ' + error.msg())
            self.chat.error_message = error.msg()
            self.chat.status = 'Request failed'
            self.redraw()
            continue
        }
        debug.log('tui', 'initial prompt submitted chars=' + fmt.sprintf('%d', text.len()))
        return stream
    }
    return null
}

pub fn view_t.run_command(&self, string text): ref<session_stream.stream_t>? {
    var parts = command_tokens(text)
    if parts.len() == 0 {
        return null
    }
    string command = parts[0]
    debug.log('tui', 'slash command=' + command + ' args=' + fmt.sprintf('%d', parts.len() - 1))
    if command == '/quit' || command == '/exit' {
        self.quitting = true
        return null
    }
    if command == '/new' {
        self.runner.start_new_session() catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.clear_chat()
        self.editor.clear()
        self.chat.status = 'Started new session'
        self.redraw()
        return null
    }
    if command == '/config' {
        self.show_config_overlay()
        return null
    }
    if command == '/help' {
        self.show_help_overlay()
        self.redraw()
        return null
    }
    if command == '/skill' {
        self.show_skills(text, parts)
        self.redraw()
        return null
    }
    if command == '/session' {
        var stats = self.runner.repository.stats(self.runner.agent_config.model.context_window) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.show_session_info_overlay(stats)
        self.redraw()
        return null
    }
    if command == '/hotkeys' {
        self.show_hotkeys_overlay()
        self.redraw()
        return null
    }
    if command == '/debug' {
        self.handle_debug_command()
        return null
    }
    if command == '/scoped-models' {
        self.show_scoped_models_overlay()
        self.redraw()
        return null
    }
    if command == '/resume' {
        if parts.len() > 1 {
            return self.open_session(parts[1])
        }
        self.show_session_overlay()
        self.redraw()
        return null
    }
    if command == '/reload' {
        string cwd = self.runner.repository.cwd
        // Pi maybeSaveImplicitProjectTrustAfterReload: when the launch cwd
        // had no trust-requiring resources (auto-trust window open) and a
        // reload observes them appearing mid-session, persist an implicit
        // trusted decision so this and future runtimes keep loading them.
        bool saved_implicit_project_trust = false
        if self.auto_trust_on_reload_cwd == cwd {
            self.auto_trust_on_reload_cwd = ''
            if trust.has_trust_requiring_resources(cwd) && trust.decision(cwd) is null {
                trust.save(cwd, true) catch error {
                    self.chat.error_message = 'Could not save project trust after reload: ' + error.msg()
                }
                saved_implicit_project_trust = self.chat.error_message == ''
            }
        }
        bool trusted = self.trusted_for(cwd)
        if theme.loaded_path() != '' {theme.reload()}
        string theme_file = syscall.get_env('ADOU_THEME_FILE')
        if theme_file != '' && theme.loaded_path() == '' {theme.load_json(theme_file)}
        // B1-R2-08: one trust-aware snapshot pass BEFORE the system prompt
        // is rebuilt — trust-aware settings, filtered prompt execution
        // list, dynamic command menu, filtered skills, autocomplete max and
        // (reload_auth=true) the credential snapshot + provider count +
        // model candidates all refresh together from the same resources.
        // No separate settings re-read and no legacy global cache.
        self.refresh_resource_snapshot(cwd, true)
        [ref<project.file_t>] context_files = []
        [string] warnings = []
        if !self.no_context_files && trusted {
            var loaded = project.load(cwd, '') catch error {
                self.chat.error_message = error.msg()
                self.redraw()
                return null
            }
            context_files = loaded.files
            warnings = loaded.warnings
        }
        [string] tool_names = []
        for tool in self.runner.base_context.tools {
            tool_names.push(tool.name)
        }
        string resolved_system_prompt = self.system_prompt_override
        if resolved_system_prompt == '' && trusted {
            var discovered_system = project.system_prompt_file(cwd, '')
            if discovered_system is ref<project.file_t> system_file {
                resolved_system_prompt = system_file.content
            }
        }
        [string] resolved_append_prompts = self.append_system_prompts
        if resolved_append_prompts.len() == 0 && trusted {
            var discovered_append = project.append_system_prompt_file(cwd, '')
            if discovered_append is ref<project.file_t> append_file {
                resolved_append_prompts.push(append_file.content)
            }
        }
        string append_prompt = strings.join(resolved_append_prompts, '\n\n')
        // The skills prompt uses the SAME snapshot-filtered skill list that
        // produced the dynamic menu (B1-R2-08), so execution and menu can
        // never diverge.
        if has_tool_name(tool_names, 'read') {
            string skills_prompt = skills.format_skills_for_prompt(self.cached_skills)
            if skills_prompt != '' {
                if append_prompt != '' {
                    append_prompt += '\n\n'
                }
                append_prompt += skills_prompt
            }
        }
        self.runner.base_context.system_prompt = system_prompt.build_with_tools(cwd, context_files, resolved_system_prompt, append_prompt, tool_names)
        // Batch 4: /reload re-reads keybindings.json and reports conflicts
        // (Pi KeybindingsManager.reload + getConflicts).
        self.keybindings.reload(paths.agent_dir())
        keybindings.set_current(self.keybindings)
        string reload_status = warnings.len() > 0 ? 'Project instructions reloaded with warnings' : 'Project instructions reloaded'
        if saved_implicit_project_trust {
            reload_status = 'Reloaded keybindings, skills, prompts, and context files; saved project trust'
        }
        var keybinding_conflicts = self.keybindings.get_conflicts()
        if keybinding_conflicts.len() > 0 {
            [string] conflict_texts = []
            for conflict in keybinding_conflicts {
                conflict_texts.push(keybindings.format_key_text(conflict.key) + ' -> ' + strings.join(conflict.actions, ', '))
            }
            reload_status += '\nKeybinding conflicts: ' + strings.join(conflict_texts, '; ')
        }
        self.chat.status = reload_status
        self.redraw()
        return null
    }
    if command == '/changelog' {
        var entries = changelog.parse(changelog.default_path())
        if entries.len() == 0 {
            self.chat.status = 'No changelog entries found'
        } else {
            [string] lines = []
            int shown = entries.len() > 5 ? 5 : entries.len()
            for int index = 0; index < shown; index += 1 {
                var entry = entries[index]
                lines.push(fmt.sprintf('%d.%d.%d\n%s', entry.major, entry.minor, entry.patch, entry.content))
            }
            self.chat.status = strings.join(lines, '\n\n')
        }
        self.redraw()
        return null
    }
    if command == '/copy' {
        self.copy_last_response()
        return null
    }
    if command == '/import' {
        if parts.len() == 1 {
            self.show_session_overlay()
            self.redraw()
            return null
        }
        string import_path = command_path_argument(text, '/import')
        if import_path == '' {
            self.chat.status = 'Usage: /import <session.jsonl>'
            self.redraw()
            return null
        }
        return self.import_session(import_path)
    }
    if command == '/export' {
        return self.export_session(text, parts)
    }
    if command == '/name' {
        if parts.len() > 1 {
            return self.set_session_name(text.slice(text.find(' ') + 1, text.len()).trim([' ', '\t']))
        }
        self.show_name_overlay()
        self.redraw()
        return null
    }
    if command == '/tree' {
        self.show_tree_overlay()
        self.redraw()
        return null
    }
    if command == '/fork' {
        self.show_fork_overlay()
        self.redraw()
        return null
    }
    if command == '/clone' {
        self.runner.clone_session() catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.chat.model = self.runner.agent_config.model.id
        self.reload_chat_messages(self.runner.active_messages)
        self.chat.status = 'Cloned session ' + self.runner.repository.get_session_id()
        self.redraw()
        return null
    }
    if command == '/trust' {
        if parts.len() == 1 {
            self.show_trust_overlay()
            self.redraw()
            return null
        }
        string target = ''
        if parts.len() > 1 {
            target = parts[1]
        }
        if target == 'no' {
            trust.save(self.runner.repository.cwd, false) catch error {
                self.chat.error_message = error.msg()
                self.redraw()
                return null
            }
            self.session_trust_override_set = false
            self.refresh_resource_snapshot(self.runner.repository.cwd, false)
            self.chat.status = 'Saved project trust decision: not trusted.'
            self.redraw()
            return null
        }
        if target == 'parent' {
            string parent_path = trust.trust_parent_path(self.runner.repository.cwd)
            if parent_path == '' {
                self.chat.status = 'No parent folder to trust.'
                self.redraw()
                return null
            }
            [trust.trust_update_t] updates = []
            updates.push(trust.trust_update_t {trust_path: parent_path, decision: true, remove: false})
            updates.push(trust.trust_update_t {trust_path: self.runner.repository.cwd, decision: false, remove: true})
            trust.set_many(updates) catch error {
                self.chat.error_message = error.msg()
                self.redraw()
                return null
            }
            self.session_trust_override_set = false
            self.refresh_resource_snapshot(self.runner.repository.cwd, false)
            self.chat.status = 'Saved project trust decision: trusted via parent folder.'
            self.redraw()
            return null
        }
        trust.save(self.runner.repository.cwd, true) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.session_trust_override_set = false
        self.refresh_resource_snapshot(self.runner.repository.cwd, false)
        self.chat.status = 'Saved project trust decision: trusted.'
        self.redraw()
        return null
    }
    if command == '/share' {
        if !self.runner.repository.persisted {
            self.chat.status = 'Cannot share an in-memory session; start a persisted session first.'
            self.redraw()
            return null
        }
        self.create_github_share()
        self.redraw()
        return null
    }
    if command == '/settings' {
        self.show_settings_overlay()
        self.redraw()
        return null
    }
    if command == '/model' {
        if parts.len() == 1 {
            self.show_model_overlay('')
            self.redraw()
            return null
        }
        if parts.len() != 2 {
            self.chat.error_message = 'Usage: /model <provider/model>'
            self.redraw()
            return null
        }
        ref<ai_types.model_t>? selected = models.find(parts[1])
        if selected is ref<ai_types.model_t> model {
            self.runner.set_model(model) catch error {
                self.chat.error_message = error.msg()
                self.redraw()
                return null
            }
            self.apply_scoped_thinking(model)
    self.chat.model = model.id
    self.chat.configure(model.context_window, self.chat.thinking)
    self.save_default_model()
    self.chat.error_message = ''
            self.chat.status = 'Model: ' + model.provider + '/' + model.id
            self.redraw()
            return null
        }
        // Pi treats a non-exact /model argument as the selector's initial
        // search query, so users can type a partial provider or model id.
        self.show_model_overlay(parts[1])
        self.redraw()
        return null
    }
    if command == '/login' {
        string provider = ''
        if parts.len() >= 2 {
            provider = parts[1]
        }
        if provider != '' && !registry.supports_api_key_login(provider) && !registry.supports_oauth(provider) {
            self.chat.error_message = 'Unsupported provider: ' + provider
            self.redraw()
            return null
        }
        string key = parts.len() >= 3 ? parts[2] : ''
        if key == '' {
            self.show_auth_overlay(provider)
            self.redraw()
            return null
        }
        auth.save(provider, key) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.runner.refresh_auth() catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.chat.error_message = ''
        self.chat.status = 'Logged in to ' + provider
        refresh_auth_provider_count(self)
        self.refresh_model_argument_cache()
        self.redraw()
        return null
    }
    if command == '/logout' {
        string provider = self.runner.agent_config.model.provider
        if parts.len() >= 2 {
            provider = parts[1]
        }
        if !registry.supports_api_key_login(provider) || registry.supports_oauth(provider) {
            self.chat.error_message = 'Unsupported provider: ' + provider
            self.redraw()
            return null
        }
        if parts.len() == 1 {
            self.show_logout_overlay()
            self.redraw()
            return null
        }
        auth.remove(provider) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.runner.refresh_auth() catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
        self.chat.error_message = ''
        self.chat.status = 'Logged out of ' + provider
        refresh_auth_provider_count(self)
        self.refresh_model_argument_cache()
        self.redraw()
        return null
    }
    if command == '/compact' {
        string instructions = parts.len() > 1 ? text.slice(text.find(' ') + 1, text.len()).trim([' ', '\t']) : ''
        var stream = self.runner.compact_now(instructions) catch error {
            self.chat.error_message = error.msg()
            self.chat.status = 'Compaction failed'
            self.redraw()
            return null
        }
        return stream
    }
    self.chat.error_message = 'Unknown command: ' + text
    self.redraw()
    return null
}

pub fn view_t.open_session(&self, string file_path): ref<session_stream.stream_t>? {
    var next = repository.open_reference(self.runner.repository.cwd, self.runner.repository.session_dir, file_path) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    return self.finish_session_switch(next)
}

pub fn view_t.import_session(&self, string file_path): ref<session_stream.stream_t>? {
    var next = self.runner.repository.import_file(file_path) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    return self.finish_session_switch(next)
}

fn view_t.finish_session_switch(&self, ref<repository.manager_t> next): ref<session_stream.stream_t>? {
    self.startup_session_picker = false
    self.runner.replace_repository(next) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    // Session-only trust is scoped to the project that was selected; a
    // resume/import into another cwd must not carry it across projects.
    if trust.normalize(next.cwd) != trust.normalize(self.session_trust_cwd) {
        self.session_trust_override_set = false
    }
    self.rebind_project_context(next.cwd) catch error {
        self.chat.status = 'Session resumed; could not rebuild project tools'
    }
    // B1-R3-04: the trust-aware settings snapshot (global-only for
    // untrusted, merged for trusted) drives the core queue/compaction/retry
    // preferences at this boundary; core never reads project settings.
    self.runner.apply_preferences_snapshot(self.settings_snapshot)
    self.chat.model = self.runner.agent_config.model.id
    self.chat.cwd = next.cwd
    self.chat.git_branch = detect_git_branch(next.cwd)
    string thinking = self.runner.agent_config.stream_options.reasoning_effort
    if !self.runner.agent_config.stream_options.thinking_enabled {thinking = 'off'}
    self.chat.configure(self.runner.agent_config.model.context_window, thinking)
    self.reload_chat_messages(self.runner.active_messages)
    self.chat.error_message = ''
    self.chat.status = 'Resumed session ' + self.runner.repository.get_session_id()
    self.overlay = null
    self.redraw()
    return null
}

// Session replacement can move to a different project cwd (for example
// `/import` or an explicit --session path).  Pi recreates its runtime-bound
// resources in that case; rebuild the Nature tool executors and system prompt
// while keeping the current tool selection and CLI prompt overrides.  Skills
// and the /skill:* command menu are rebuilt for the new cwd with the same
// CLI options, and the project trust decision is re-resolved against the new
// cwd (explicit --approve/--no-approve still wins), so a rebound session
// behaves like one started there.
fn view_t.rebind_project_context(&self, string cwd): void! {
    bool trusted = self.trusted_for(cwd)
    // B1-R2-08: the trust-aware resource snapshot (settings, prompt
    // execution list, dynamic menu, filtered skills, autocomplete max,
    // auth + model candidates) refreshes atomically for the new cwd before
    // the system prompt is rebuilt; the menu and expand use the same
    // self.prompt_templates afterwards.
    self.refresh_resource_snapshot(cwd, true)
    // B1.1: a rebind to a project the startup resolution has not covered
    // yet opens Pi's trust selector for an unresolved 'ask' project; a cwd
    // already resolved (including dismissed) never re-prompts.
    if self.trust_prompted_cwd != cwd && trust.needs_prompt(self.trust_override_explicit, self.trust_override, cwd, self.settings_snapshot.default_project_trust) {
        self.trust_prompted_cwd = cwd
        self.show_trust_startup_prompt()
    }
    self.update_untrusted_banner(cwd)
    [string] tool_names = []
    for tool in self.runner.base_context.tools {
        tool_names.push(tool.name)
    }
    [ref<project.file_t>] context_files = []
    if !self.no_context_files && trusted {
        var loaded = project.load(cwd, '') catch error {
            self.chat.status = 'Session resumed; project instructions unavailable'
            project.load_result_t{}
        }
        context_files = loaded.files
    }
    // B1-R3-02: same trust-gated system/append resolution as startup and
    // /reload — CLI overrides win, otherwise a trusted target cwd's
    // .adou/SYSTEM.md and .adou/APPEND_SYSTEM.md are discovered and applied.
    string resolved_system_prompt = self.system_prompt_override
    if resolved_system_prompt == '' && trusted {
        var discovered_system = project.system_prompt_file(cwd, '')
        if discovered_system is ref<project.file_t> system_file {
            resolved_system_prompt = system_file.content
        }
    }
    [string] resolved_append_prompts = self.append_system_prompts
    if resolved_append_prompts.len() == 0 && trusted {
        var discovered_append = project.append_system_prompt_file(cwd, '')
        if discovered_append is ref<project.file_t> append_file {
            resolved_append_prompts.push(append_file.content)
        }
    }
    var tools = tool_names.len() > 0 ? builtins.select_tools_with_options(cwd, tool_names, [], false, self.settings_snapshot.auto_resize_images) : []
    self.runner.base_context.tools = tools
    string append_prompt = strings.join(resolved_append_prompts, '\n\n')
    if has_tool_name(tool_names, 'read') {
        string skills_prompt = skills.format_skills_for_prompt(self.cached_skills)
        if skills_prompt != '' {
            if append_prompt != '' {
                append_prompt += '\n\n'
            }
            append_prompt += skills_prompt
        }
    }
    self.runner.base_context.system_prompt = system_prompt.build_with_tools(cwd, context_files, resolved_system_prompt, append_prompt, tool_names)
}

// The trust decision for a project cwd, re-resolved on every session rebind:
// an explicit --approve/--no-approve wins, otherwise the stored decision
// applies when the project hosts trust-requiring resources, and the global
// settings.defaultProjectTrust supplies the fallback.
fn view_t.trusted_for(&self, string cwd): bool {
    if self.session_trust_override_set && trust.normalize(cwd) == trust.normalize(self.session_trust_cwd) {
        return self.session_trust_override
    }
    return trust.resolve_trust(self.trust_override_explicit, self.trust_override, cwd, self.settings_snapshot.default_project_trust)
}

pub fn view_t.set_session_name(&self, string name): ref<session_stream.stream_t>? {
    self.runner.set_session_name(name) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    self.chat.status = name.trim([' ', '\t', '\n', '\r']) == '' ? 'Session name cleared' : 'Session named ' + name.trim([' ', '\t', '\n', '\r'])
    self.overlay = null
    self.redraw()
    return null
}

pub fn view_t.export_session(&self, string command_text, [string] parts): ref<session_stream.stream_t>? {
    if !self.runner.repository.persisted {
        self.chat.status = 'Cannot export an in-memory session'
        self.redraw()
        return null
    }
    string target = command_path_argument(command_text, '/export')
    if target == '' {
        target = self.runner.repository.get_session_file() + '.html'
    }
    var source = fs.open(self.runner.repository.get_session_file(), syscall.O_RDONLY, 0) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    string content = source.content() catch error {
        source.close()
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    source.close()
    // Pi defaults `/export` to HTML and only writes raw JSONL when the path
    // explicitly ends in `.jsonl`.
    string output = content
    if !target.to_lower().ends_with('.jsonl') {
        output = session_export.render(self.runner.repository) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return null
        }
    }
    os.mkdirs(path.dir(path_utils.resolve_to_cwd(target, self.runner.repository.cwd)), 0o755) catch error {}
    string absolute_target = path_utils.resolve_to_cwd(target, self.runner.repository.cwd)
    var destination = fs.open(absolute_target, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    destination.write(output as [u8]) catch error {
        destination.close()
        self.chat.error_message = error.msg()
        self.redraw()
        return null
    }
    destination.close()
    self.chat.status = 'Exported session to ' + target
    self.redraw()
    return null
}

// Pi's /share publishes the rendered HTML as a secret GitHub gist and returns
// both the raw gist URL and the configured viewer URL.  The gh CLI owns the
// user's GitHub authentication; no token is copied into Adou settings.
pub fn view_t.create_github_share(&self) {
    string cwd = self.runner.repository.cwd
    var auth_result = command.argv(cwd, 'gh', ['auth', 'status']) catch error {
        self.chat.error_message = 'GitHub CLI (gh) is not installed. Install it from https://cli.github.com/'
        return
    }
    if auth_result.exit_code != 0 {
        self.chat.error_message = 'GitHub CLI is not logged in. Run `gh auth login` first.'
        return
    }
    string temporary_dir = temp.create_temp_dir('adou-share-') catch error {
        self.chat.error_message = 'Failed to create a temporary share directory: ' + error.msg()
        return
    }
    string target = path.join(temporary_dir, 'session.html')
    self.export_session('/export ' + target, ['/export', target])
    if !path_utils.exists(target) {
        os.rmdir(temporary_dir, true) catch cleanup_error {}
        self.chat.error_message = 'Failed to export the session for sharing.'
        return
    }
    var result = command.argv(cwd, 'gh', ['gist', 'create', '--public=false', target]) catch error {
        os.rmdir(temporary_dir, true) catch cleanup_error {}
        self.chat.error_message = 'Failed to create gist: ' + error.msg()
        return
    }
    os.rmdir(temporary_dir, true) catch cleanup_error {}
    if result.exit_code != 0 {
        string detail = result.stderr.trim([' ', '\t', '\n', '\r'])
        self.chat.error_message = detail == '' ? 'Failed to create gist' : 'Failed to create gist: ' + detail
        return
    }
    string gist_url = result.stdout.trim([' ', '\t', '\n', '\r'])
    if gist_url == '' {
        self.chat.error_message = 'Failed to parse gist URL from gh output'
        return
    }
    string gist_id = gist_url
    int slash = gist_id.find('/')
    for slash >= 0 {
        gist_id = gist_id.slice(slash + 1, gist_id.len())
        slash = gist_id.find('/')
    }
    self.chat.error_message = ''
    self.chat.status = 'Share URL: ' + share.viewer_url(gist_id) + '\nGist: ' + gist_url
}

pub fn view_t.show_session_overlay(&self) {
    if self.runner.repository.session_dir == '' {
        self.chat.status = 'No persisted sessions are available'
        if self.startup_session_picker {
            self.startup_session_picker = false
            self.quitting = true
        }
        return
    }
    // Phase 7: the file-level scan lives in the backend helper (same
    // .jsonl filter and mtime-newest ordering).  A failed scan is surfaced
    // explicitly instead of masquerading as an empty store.
    var listed = backend.list_session_paths(self.runner.repository.session_dir) catch error {
        self.chat.error_message = 'Could not list sessions: ' + error.msg()
        self.chat.status = 'Request failed'
        self.redraw()
        return
    }
    [string] options = listed
    // Pi's resume picker can broaden from the current project to all
    // projects. Include the default shared store here as well; explicit
    // --session-dir remains intentionally scoped to that directory.
    string shared_root = paths.sessions_dir()
    if shared_root != '' && path.dir(self.runner.repository.session_dir) == shared_root {
        var project_dirs = os.listdir(shared_root) catch error {[]}
        for project_name in project_dirs {
            string project_dir = path.join(shared_root, project_name)
            var project_entries = os.listdir(project_dir) catch error {[]}
            for session_name in project_entries {
                if !session_name.ends_with('.jsonl') {continue}
                string candidate = path.join(project_dir, session_name)
                bool duplicate = false
                for existing in options {
                    if existing == candidate {
                        duplicate = true
                        break
                    }
                }
                if !duplicate {options.push(candidate)}
            }
        }
    }
    options = sort_session_paths(options)
    if options.len() == 0 {
        self.chat.status = 'No persisted sessions are available'
        if self.startup_session_picker {
            self.startup_session_picker = false
            self.quitting = true
        }
        return
    }
    self.overlay = new overlay_t(kind = OVERLAY_SESSION, title = 'Resume session:', options = options, sort_mode = 0, scope = 0)
}

fn sort_session_paths([string] values): [string] {
    [string] remaining = values.slice(0, values.len())
    [string] result = vec<string>.cap_of(values.len())
    for remaining.len() > 0 {
        int newest = 0
        i64 newest_sec = 0
        i64 newest_nsec = 0
        for index, value in remaining {
            var stat = syscall.stat(value) catch error {continue}
            if index == 0 || stat.mtim.sec > newest_sec || (stat.mtim.sec == newest_sec && stat.mtim.nsec > newest_nsec) {
                newest = index
                newest_sec = stat.mtim.sec
                newest_nsec = stat.mtim.nsec
            }
        }
        result.push(remaining[newest])
        [string] next = vec<string>.cap_of(remaining.len() - 1)
        for index, value in remaining {
            if index != newest {next.push(value)}
        }
        remaining = next
    }
    return result
}

fn sort_session_paths_alpha([string] values): [string] {
    [string] result = values.slice(0, values.len())
    for int outer = 0; outer < result.len(); outer += 1 {
        for int inner = outer + 1; inner < result.len(); inner += 1 {
            string left = session_option_display(result[outer], false).to_lower()
            string right = session_option_display(result[inner], false).to_lower()
            if right < left {
                string swap = result[outer]
                result[outer] = result[inner]
                result[inner] = swap
            }
        }
    }
    return result
}

// Pi tree filter modes in the overlay's cycle order.
fn tree_filter_index(string mode): int {
    if mode == 'no-tools' {return 1}
    if mode == 'user-only' {return 2}
    if mode == 'labeled-only' {return 3}
    if mode == 'all' {return 4}
    return 0
}

pub fn view_t.show_tree_overlay(&self) {
    var options = tree_rows(self.runner, false)
    if options.len() == 0 {
        self.chat.status = 'Session tree is empty'
        return
    }
    self.overlay = new overlay_t(kind = OVERLAY_TREE, title = 'Session tree:', options = options)
    var active = self.overlay as ref<overlay_t>
    // Pi settings.treeFilterMode seeds the default filter when opening /tree.
    active.tree_filter = tree_filter_index(self.settings_snapshot.tree_filter_mode)
    string leaf = self.runner.repository.get_leaf_id()
    var active_entries = self.runner.repository.active_entries()
    for int index = active_entries.len() - 1; index >= 0; index -= 1 {
        if active_entries[index].kind != session_types.ENTRY_LABEL {
            leaf = active_entries[index].id
            break
        }
    }
    for index, option in active.options {
        if option.starts_with(leaf + ' ') {
            active.selected = index
            break
        }
    }
}

// Tree rows: '<id> [<label>] <kind>' with an optional relative timestamp
// suffix when app.tree.toggleLabelTimestamp is on.
fn tree_rows(ref<session.runner_t> runner, bool label_timestamps): [string] {
    [string] options = []
    for entry in runner.repository.get_entries() {
        if entry.kind == session_types.ENTRY_LABEL {
            continue
        }
        string label = runner.repository.get_label(entry.id)
        string row = entry.id + (label == '' ? '' : ' [' + label + ']') + ' ' + entry.kind
        if label_timestamps {
            string relative = relative_time(entry.timestamp)
            if relative != '' {
                row += '  ' + relative
            }
        }
        options.push(row)
    }
    return options
}

// A short relative timestamp for tree rows ('2m ago', '3h ago', '2d ago').
fn relative_time(string timestamp): string {
    i64 then = iso_timestamp_ms(timestamp)
    if then <= 0 {
        return ''
    }
    i64 elapsed = time.now().ms_timestamp() - then
    if elapsed < 0 {
        elapsed = 0
    }
    int minutes = (elapsed / 60000) as int
    if minutes < 1 {
        return 'just now'
    }
    if minutes < 60 {
        return fmt.sprintf('%dm ago', minutes)
    }
    int hours = minutes / 60
    if hours < 24 {
        return fmt.sprintf('%dh ago', hours)
    }
    return fmt.sprintf('%dd ago', hours / 24)
}

fn iso_timestamp_ms(string timestamp): i64 {
    // Reuse the repository's libc/timegm parser so relative labels use the
    // same epoch as the rest of session handling.
    return repository.timestamp_ms(timestamp) as i64
}

pub fn view_t.restore_tree_overlay(&self, string entry_id) {
    self.show_tree_overlay()
    if self.overlay is ref<overlay_t> tree {
        for index, option in tree.options {
            if option_entry_id(option) == entry_id {
                tree.selected = index
                break
            }
        }
    }
}

pub fn view_t.show_branch_summary_overlay(&self, string entry_id) {
    self.overlay = new overlay_t(kind = OVERLAY_BRANCH_SUMMARY, title = 'Summarize branch?', provider = entry_id, options = ['No summary', 'Summarize', 'Summarize with custom prompt'])
}

pub fn view_t.show_fork_overlay(&self) {
    [string] options = []
    for entry in self.runner.repository.get_entries() {
        if entry.kind != session_types.ENTRY_MESSAGE {
            continue
        }
        if !json_util.is_obj(entry.raw) {continue}
        var object = entry.raw as {string:any}
        if !object.contains('message') || !(object['message'] is {string:any}) {
            continue
        }
        var message = message_json.decode(object['message']) catch error {continue}
        if message is ref<ai_types.user_message_t> user {
            string preview = user.content.replace('\n', ' ')
            if preview.len() > 72 {
                preview = preview.slice(0, 72) + '...'
            }
            options.push(entry.id + ' ' + preview)
        }
    }
    if options.len() == 0 {
        self.chat.status = 'No messages to fork from'
        return
    }
    self.overlay = new overlay_t(kind = OVERLAY_FORK, title = 'Fork from user message:', options = options)
}

pub fn view_t.fork_message_text(&self, string entry_id): string {
    for entry in self.runner.repository.get_entries() {
        if entry.id != entry_id || entry.kind != session_types.ENTRY_MESSAGE {
            continue
        }
        if !json_util.is_obj(entry.raw) {return ''}
        var object = entry.raw as {string:any}
        if !object.contains('message') || !(object['message'] is {string:any}) {
            return ''
        }
        var message = message_json.decode(object['message']) catch error {return ''}
        if message is ref<ai_types.user_message_t> user {
            return user.content
        }
        return ''
    }
    return ''
}

pub fn view_t.show_name_overlay(&self) {
    string name = self.runner.repository.get_session_name() catch error {''}
    self.overlay = new overlay_t(kind = OVERLAY_NAME, title = 'Session name:', query = name)
}

pub fn view_t.show_session_info_overlay(&self, repository.stats_t stats) {
    string file = self.runner.repository.persisted ? self.runner.repository.get_session_file() : 'In-memory'
    [string] options = [
        'Session Info',
        '',
        'File: ' + file,
        'ID: ' + self.runner.repository.get_session_id(),
        '',
        'Messages',
        'Total: ' + fmt.sprintf('%d', stats.total_messages),
        'User: ' + fmt.sprintf('%d', stats.user_messages),
        'Assistant: ' + fmt.sprintf('%d', stats.assistant_messages),
        'Tools: ' + fmt.sprintf('%d calls, %d results', stats.tool_calls, stats.tool_results),
        '',
        'Tokens',
        'Input: ' + fmt.sprintf('%d', stats.usage.input + stats.usage.cache_read + stats.usage.cache_write),
        'Output: ' + fmt.sprintf('%d', stats.usage.output),
        'Total: ' + fmt.sprintf('%d', stats.usage.total_tokens),
    ]
    if stats.usage.cost.total > 0.0 {
        options.append(['', 'Cost', 'Total: ' + fmt.sprintf('$%.3f', stats.usage.cost.total)])
    }
    var cache_waste = cache_stats.compute_cache_waste(self.runner.repository.get_entries())
    if cache_waste.missed_tokens > 0 {
        string miss_label = cache_waste.miss_count == 1 ? '1 miss' : fmt.sprintf('%d misses', cache_waste.miss_count)
        string detail = fmt.sprintf('%d tokens, %s', cache_waste.missed_tokens, miss_label)
        if cache_waste.missed_cost >= 0.0001 {
            options.append(['', 'Cache Re-billed: ' + fmt.sprintf('$%.3f', cache_waste.missed_cost) + ' (' + detail + ')'])
        } else {
            options.append(['', 'Cache Re-billed: ' + detail])
        }
    }
    if stats.context_window > 0 {
        options.append(['', 'Context', fmt.sprintf('Current: %d / %d', stats.context_tokens, stats.context_window)])
    }
    self.overlay = new overlay_t(kind = OVERLAY_SESSION_INFO, title = 'Session Info', options = options)
}

pub fn html_escape(string value): string {
    return value.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')
}

fn run_interactive_bash(ref<session.runner_t> runner, ref<session_stream.stream_t> output, string script, bool excluded): void! {
    run_interactive_bash_inner(runner, output, script, excluded) catch error {
        output.fail(error.msg()) catch stream_error {}
    }
    runner.end_operation()
}

fn run_interactive_bash_inner(ref<session.runner_t> runner, ref<session_stream.stream_t> output, string script, bool excluded): void! {
    output.push(session_stream.event_t {kind: session_stream.EVENT_BASH_START, bash_command: script, bash_exclude_from_context: excluded,})
    var state = new interactive_bash_state_t(lock = mutex.mutex_t.new(), relay_done = chan<u8>.new(1))
    go relay_interactive_bash(state, output, script, excluded)
    var result = shell_tools.execute_bash_stream(runner.repository.cwd, script, 0, output.cancellation, fn(string chunk) {
        state.lock.lock()
        state.output_chunks.push(chunk)
        state.lock.unlock()
    }) catch error {
        state.lock.lock()
        state.done = true
        string partial = strings.join(state.output_chunks, '')
        state.lock.unlock()
        state.relay_done.recv() catch relay_error {}
        // An aborted or failed subprocess can finish before producing the
        // normal result object. Still close the visible bash component and
        // persist the partial command entry, matching Pi's cancellation
        // semantics instead of leaving the TUI in a permanently running
        // state.
        bool cancelled = output.cancellation.is_aborted()
        runner.record_bash_during_operation(script, partial, -1, cancelled, false, '', excluded) catch record_error {
            output.push(session_stream.event_t {kind: session_stream.EVENT_BASH_END, bash_command: script, bash_output: partial, bash_exit_code: -1, bash_cancelled: cancelled, bash_exclude_from_context: excluded,}) catch push_error {}
            output.fail(record_error.msg()) catch stream_error {}
            return
        }
        output.push(session_stream.event_t {kind: session_stream.EVENT_BASH_END, bash_command: script, bash_output: partial, bash_exit_code: -1, bash_cancelled: cancelled, bash_exclude_from_context: excluded,}) catch push_error {}
        output.fail(error.msg()) catch stream_error {}
        return
    }
    state.lock.lock()
    state.done = true
    state.lock.unlock()
    state.relay_done.recv() catch relay_error {}
    int exit_code = result.cancelled ? -1 : result.exit_code
    runner.record_bash_during_operation(script, result.output, exit_code, result.cancelled, result.truncated, result.full_output_path, excluded) catch error {
        output.fail(error.msg()) catch stream_error {}
        return
    }
    output.push(session_stream.event_t {kind: session_stream.EVENT_BASH_END, bash_command: script, bash_output: result.output, bash_exit_code: exit_code, bash_cancelled: result.cancelled, bash_timed_out: result.timed_out, bash_truncated: result.truncated, bash_full_output_path: result.full_output_path, bash_exclude_from_context: excluded,})
    output.finish(runner.copy_active_messages())
}

fn relay_interactive_bash(ref<interactive_bash_state_t> state, ref<session_stream.stream_t> output, string script, bool excluded): void! {
    for true {
        state.lock.lock()
        bool done = state.done
        int available = state.output_chunks.len() - state.sent_chunks
        [string] pending = available > 0 ? state.output_chunks.slice(state.sent_chunks, state.output_chunks.len()) : []
        state.sent_chunks = state.output_chunks.len()
        state.lock.unlock()
        string chunk = pending.len() > 0 ? strings.join(pending, '') : ''
        if chunk != '' {
            output.push(session_stream.event_t {kind: session_stream.EVENT_BASH_UPDATE, bash_command: script, bash_output: chunk, bash_exclude_from_context: excluded,}) catch error {}
        }
        if done {
            state.relay_done.close()
            return
        }
        co.sleep(50)
    }
}

fn command_tokens(string text): [string] {
    [string] result = []
    for token in text.trim([' ', '\t']).split(' ') {
        if token != '' {
            result.push(token)
        }
    }
    return result
}


// /export and /import accept the same quoted path convention as Pi.  The
// other slash commands intentionally keep their free-form remainder parsing.
fn command_path_argument(string text, string command): string {
    if text == command || !text.starts_with(command + ' ') {
        return ''
    }
    string remainder = text.slice(command.len() + 1, text.len()).trim([' ', '\t', '\n', '\r'])
    if remainder == '' {
        return ''
    }
    string first = remainder.slice(0, 1)
    if first == '"' || first == "'" {
        int closing = remainder.slice(1, remainder.len()).find(first)
        if closing < 0 {
            return ''
        }
        return remainder.slice(1, closing + 1)
    }
    int space = remainder.find(' ')
    int tab = remainder.find('\t')
    int split = space
    if split < 0 || (tab >= 0 && tab < split) {
        split = tab
    }
    return split < 0 ? remainder : remainder.slice(0, split)
}

fn env_name(string provider): string {
    if provider == 'deepseek' {
        return 'DEEPSEEK_API_KEY'
    }
    if provider == 'anthropic' {
        return 'ANTHROPIC_API_KEY'
    }
    return 'OPENAI_API_KEY'
}

pub fn view_t.render_lines(&self, int width, int height): [string]! {
    self.chat.model = self.runner.agent_config.model.id
    self.chat.provider = self.runner.agent_config.model.provider
    // Hot path: read the cached count only.  Authentication I/O and the
    // model table scan happen in refresh_auth_provider_count, which runs
    // at view init and after every auth change.
    self.chat.set_provider_visibility(self.cached_auth_provider_count > 1)
    if self.repository_footer_dirty {
        self.chat.session_name = self.runner.repository.get_session_name() catch error {''}
        self.chat.set_usage_totals(self.runner.repository.usage_totals())
        self.chat.set_latest_cache_hit_rate(self.runner.repository.latest_cache_hit_rate())
        self.chat.set_context_known(self.runner.repository.context_usage_known())
        self.repository_footer_dirty = false
    }
    [string] transcript_lines = self.chat.render(width)
    // Pi's built-in header: the compact keybinding hint line derived from
    // the registry, silenced by quietStartup.  It wraps to the terminal
    // width (the renderer forbids over-wide rows).
    if !self.settings_snapshot.quiet_startup {
        [string] with_header = []
        var header_lines = text_utils.wrap_text_with_ansi(theme.fg(theme.dim_color(), header_hint_line(self.keybindings)), width)
        for line in header_lines {
            with_header.push(line)
        }
        for line in transcript_lines {
            with_header.push(line)
        }
        transcript_lines = with_header
    }
    // B1.1: Pi inserts an untrusted warning when the resolved project is
    // untrusted; Adou renders the equivalent banner under the header.
    if self.show_untrusted_banner {
        [string] with_banner = []
        var banner_lines = text_utils.wrap_text_with_ansi(theme.fg(theme.warning(), 'This project is not trusted. Project .adou resources and .agents skills are ignored. Use /trust to save a trust decision.'), width)
        for line in banner_lines {
            with_banner.push(line)
        }
        for line in transcript_lines {
            with_banner.push(line)
        }
        transcript_lines = with_banner
    }
    [string] editor_lines = []
    if self.overlay is ref<overlay_t> active_overlay {
        editor_lines = render_overlay(active_overlay, width, self.runner.repository.session_dir, self.runner.agent_config.model.provider + '/' + self.runner.agent_config.model.id, self.runner)
    } else {
        editor_lines = render_editor(self.editor, width, self.autocomplete, self.chat.thinking, height, self.editor_padding_x)
    }
    [string] footer_lines = self.chat.render_footer(width)
    return layout.compose_interactive(transcript_lines, editor_lines, footer_lines)
}

pub fn view_t.render(&self): void! {
    var size = self.terminal.size()
    var lines = self.render_lines(size.columns, size.rows)
    // B4: Pi extractCursorPosition — resolve the focused editor's marker to
    // a hardware cursor position (IME) before painting the frame.
    // Pi always extracts and positions CURSOR_MARKER, even while the
    // hardware cursor is hidden. macOS/terminal IMEs use that hidden cursor
    // location to place and paint their preedit text over the software
    // cursor cell. showHardwareCursor controls visibility only.
    var hit = text_utils.find_cursor_marker(lines, size.rows) catch e {
        text_utils.cursor_hit_t {row: -1, col: -1}
    }
    bool has_overlay = self.overlay is ref<overlay_t>
    bool has_transient_ui = has_overlay || self.autocomplete.active
    renderer.result_t result = renderer.result_t {}
    if has_transient_ui || self.transient_ui_rendered {
        result = self.renderer.render_transient_frame(lines, size.columns, size.rows)
    } else {
        result = self.renderer.render(lines, size.columns, size.rows)
    }
    // Position from the renderer's committed post-frame row and update that
    // row for the next differential redraw.  An absolute cursor suffix here
    // would move the terminal without updating renderer state, causing the
    // next edit to repaint from the wrong row and duplicate the input area.
    string position_suffix = self.renderer.position_hardware_cursor(hit.row, hit.col, lines.len())
    if hit.row >= 0 && self.settings_snapshot.show_hardware_cursor {
        position_suffix += term.CURSOR_SHOW
    } else if hit.row < 0 && self.settings_snapshot.show_hardware_cursor {
        // Pi hides a visible hardware cursor whenever the focused component
        // does not publish a cursor marker (for example, a selector overlay).
        position_suffix = term.CURSOR_HIDE
    }
    self.write_terminal(result.output + position_suffix)
    self.transient_ui_rendered = has_transient_ui
}

pub fn view_t.handle_debug_command(&self) {
    var size = self.terminal.size() catch error {
        self.chat.error_message = 'Could not read terminal size: ' + error.msg()
        self.redraw()
        return
    }
    var all_lines = self.render_lines(size.columns, size.rows) catch error {
        self.chat.error_message = 'Could not render debug output: ' + error.msg()
        self.redraw()
        return
    }
    string timestamp = identity.iso_now() catch error {fmt.sprintf('%d', time.now().ms_timestamp())}
    string debug_data = 'Debug output at ' + timestamp + '\n'
    debug_data += fmt.sprintf('Terminal: %dx%d\n', size.columns, size.rows)
    debug_data += fmt.sprintf('Total lines: %d\n\n', all_lines.len())
    debug_data += '=== All rendered lines with visible widths ===\n'
    for index, line in all_lines {
        string escaped = json.serialize(line) catch error {'<line encode error>'}
        int line_width = text_utils.visible_width(line) catch error {0}
        debug_data += fmt.sprintf('[%d] (w=%d) %s\n', index, line_width, escaped)
    }
    debug_data += '\n=== Agent messages (JSONL) ===\n'
    for message in self.runner.copy_active_messages() {
        var encoded = message_json.encode(message) catch error {
            debug_data += fmt.sprintf('<message encode error: %s>\n', error.msg())
            continue
        }
        string encoded_line = json_util.stringify(encoded) catch error {
            debug_data += fmt.sprintf('<message stringify error: %s>\n', error.msg())
            continue
        }
        debug_data += encoded_line + '\n'
    }
    string target = debug.write_debug_file(debug_data) catch error {
        self.chat.error_message = 'Could not write debug log: ' + error.msg()
        self.redraw()
        return
    }
    self.chat.error_message = ''
    self.chat.status = 'Debug log written\n' + target
    self.redraw()
}

fn view_t.write_terminal(&self, string output): void! {
    // Suppress writes after /quit so terminal.restore()'s sequences remain
    // the last output on screen instead of flashing a stale frame.
    if self.quitting {
        return
    }
    // Redundant defense only: terminal.restore() sets restored/active AFTER
    // it has already written its control sequences, so these flags cannot by
    // themselves close the suspension window.  The actual exclusion comes
    // from restore_terminal/reenter_terminal taking the render lock, which
    // makes the lifecycle switch and every frame write mutually exclusive.
    // The renderer state is invalidated under the same lock so the first
    // frame after reenter is a cleared full repaint instead of a no-op diff
    // over a screen the shell/editor may have replaced.
    if self.terminal.restored || !self.terminal.active {
        self.renderer.invalidate()
        return
    }
    self.terminal.write(output)
    debug.log_terminal_output(output)
}

// Authentication visibility is a provider-level property, not a per-model
// one: models.all() has ~1200 entries, and auth.effective() opens and
// parses auth.json on every call.  Deduplicate providers first so the
// whole scan performs one auth read per provider, and cache the result on
// the view (refreshed at init and after /login // /logout) so the render
// hot path never re-scans the model table or the credential file.
// Recompute and cache the authenticated-provider count.  Called exactly
// once at view initialization and from every auth.save/auth.remove success
// path (/login, /logout, API-key overlay, logout overlay).  The render hot
// path must never call this: it scans models.all() (~1200 entries) and
// reads auth.json once per provider.
fn refresh_auth_provider_count(ref<view_t> view) {
    view.cached_authenticated_providers = {}
    [string] seen = []
    for model in models.all() {
        bool already_seen = false
        for provider in seen {
            if provider == model.provider {
                already_seen = true
                break
            }
        }
        if !already_seen {
            seen.push(model.provider)
        }
    }
    int count = 0
    for provider in seen {
        bool configured = auth.effective(provider) != ''
        if view.runner.agent_config.model.provider == provider && view.runner.agent_config.stream_options.api_key != '' {
            configured = true
        }
        view.cached_authenticated_providers[provider] = configured
        if configured {
            count += 1
        }
    }
    view.cached_auth_provider_count = count
}

fn detect_git_branch(string cwd): string {
    // Prefer the CLI-free metadata walk (Pi findGitPaths + HEAD parsing);
    // fall back to git branch --show-current when git is available.
    var paths = git_paths.find_git_paths(cwd)
    if paths is ref<git_paths.git_paths_t> found {
        string branch = git_paths.read_head_branch(found.head_path)
        if branch != '' {
            return branch
        }
    }
    var result = command.argv(cwd, '/usr/bin/git', ['branch', '--show-current']) catch error {return ''}
    if result.exit_code != 0 {
        return ''
    }
    return result.stdout.trim([' ', '\t', '\n', '\r'])
}

fn start_file_watchers(ref<view_t> view, string cwd) {
    var found = git_paths.find_git_paths(cwd)
    if found is ref<git_paths.git_paths_t> paths && git_paths.watcher_available() {
        go fn() {
            for !view.quitting {
                if git_paths.wait_for_change(paths.head_path, 1500) {
                    string branch = git_paths.read_head_branch(paths.head_path)
                    if branch == '' {branch = detect_git_branch(cwd)}
                    view.chat.git_branch = branch
                    view.redraw()
                }
            }
        }()
    }
    if theme.loaded_path() != '' && git_paths.watcher_available() {
        string theme_path = theme.loaded_path()
        go fn() {
            for !view.quitting {
                if git_paths.wait_for_change(theme_path, 1500) {
                    theme.reload()
                    view.chat.invalidate_transcript_cache()
                    view.redraw()
                }
            }
        }()
    }
}

// Closing a transient menu must erase every row it occupied.  Resetting the
// differential renderer here avoids a stale candidate row when an Esc frame
// races with a preceding autocomplete update.
fn view_t.invalidate_transient_renderer(&self) {
    self.render_lock.lock()
    self.renderer.invalidate()
    self.render_lock.unlock()
    self.transient_ui_rendered = false
}

pub fn view_t.redraw(&self) {
    if self.quitting {
        return
    }
    if self.defer_redraw {
        self.redraw_deferred = true
        return
    }
    self.render_lock.lock()
    self.render() catch error {
        self.chat.error_message = error.msg()
        self.chat.status = 'Render failed'
        self.renderer.invalidate()
    }
    self.render_lock.unlock()
}

fn read_signals(ref<view_t> view): void! {
    for true {
        var received = view.signals.recv() catch error {
            return
        }
        if received == syscall.SIGWINCH as signal.sig_t {
            view.redraw_lock.lock()
            bool pending = view.resize_pending
            if !pending {
                view.resize_pending = true
                view.input_events.try_send(input_t {resize: true,}) catch error {view.resize_pending = false}
            }
            view.redraw_lock.unlock()
            continue
        }
        if received == syscall.SIGINT as signal.sig_t {
            if view.active_stream is ref<session_stream.stream_t> stream {
                debug.log('tui', 'SIGINT cancel requested while streaming')
                stream.abort()
                view.chat.status = 'Cancelling...'
                view.redraw()
                continue
            }
            view.input_events.try_send(input_t {data: '\x03',}) catch error {}
            continue
        }
        view.quitting = true
        if view.active_stream is ref<session_stream.stream_t> stream {
            stream.abort()
        }
        view.input_events.try_send(input_t {data: '\x1b',}) catch error {}
    }
}

fn view_t.stop_signals(&self) {
    signal.stop(self.signals)
    self.signals.close() catch error {}
}

fn read_terminal(ref<view_t> view, chan<terminal_input_t> output): void! {
    // Nature's terminal reader is backed by fs/libuv. Keep the blocking read
    // in its own coroutine so the parser can handle escape timeouts without
    // changing the descriptor flags or polling an idle terminal.
    for !view.quitting {
        var bytes = view.terminal.read() catch error {
            debug.log('tui', 'terminal input failed: ' + error.msg())
            output.send(terminal_input_t {kind: TERMINAL_INPUT_EOF,}) catch send_error {}
            output.close() catch close_error {}
            return
        }
        if bytes.len() == 0 {
            output.send(terminal_input_t {kind: TERMINAL_INPUT_EOF,}) catch send_error {}
            output.close() catch close_error {}
            return
        }
        output.send(terminal_input_t {kind: TERMINAL_INPUT_BYTES, data: bytes,}) catch error {
            output.close() catch close_error {}
            return
        }
    }
    output.close() catch error {}
}

fn input_timeout(chan<terminal_input_t> output, i64 timeout_id) {
    co.sleep(10)
    output.try_send(terminal_input_t {kind: TERMINAL_INPUT_TIMEOUT, timeout_id: timeout_id,}) catch error {}
}

fn read_input(ref<view_t> view, chan<terminal_input_t> input, chan<input_t> output): void! {
    // Pi gives an escape sequence a short window to receive its remaining
    // bytes. A timer coroutine provides that window while the terminal reader
    // continues accepting bytes through the Nature channel.  50 ms matches
    // xterm's own escape timeout and keeps PTY-fed (split) sequences from
    // collapsing into a bare escape when the 10 ms window was too tight.
    const ESCAPE_SEQUENCE_TIMEOUT_MS = 50
    bool pending_timeout = false
    i64 pending_since = 0
    i64 timeout_id = 0
    for true {
        var event = input.recv() catch error {
            var flushed = view.input_buffer.flush()
            for sequence in flushed {
                output.send(input_t {data: sequence,}) catch send_error {}
            }
            output.close() catch close_error {}
            return
        }
        if event.kind == TERMINAL_INPUT_EOF {
            var flushed = view.input_buffer.flush()
            for sequence in flushed {
                output.send(input_t {data: sequence,}) catch send_error {}
            }
            output.close()
            return
        }
        if event.kind == TERMINAL_INPUT_TIMEOUT {
            if pending_timeout && event.timeout_id == timeout_id {
                var flushed = view.input_buffer.flush()
                for sequence in flushed {
                    output.send(input_t {data: sequence,}) catch send_error {}
                }
                pending_timeout = false
                pending_since = 0
            }
            continue
        }
        if pending_timeout {
            i64 now = time.now().ms_timestamp()
            if pending_since > 0 && now - pending_since >= ESCAPE_SEQUENCE_TIMEOUT_MS {
                var flushed = view.input_buffer.flush()
                for sequence in flushed {
                    output.send(input_t {data: sequence,}) catch send_error {}
                }
                pending_timeout = false
                pending_since = 0
            }
        }
        var processed = view.input_buffer.process(event.data)
        pending_timeout = processed.needs_timeout
        pending_since = pending_timeout ? time.now().ms_timestamp() : 0
        if pending_timeout {
            timeout_id += 1
            go input_timeout(input, timeout_id)
        }
        for sequence in processed.sequences {
            // B5: Apple Terminal CR to Shift+Enter normalization (Pi forwardInputSequence).
            string normalized_sequence = native_modifiers.normalize_enter(sequence)
            // B4: keyboard negotiation answers never reach the key path.
            if normalized_sequence.starts_with('\x1b[?') && normalized_sequence.ends_with('u') {
                // Kitty flags response: ESC [ ? <flags> u.
                string body = sequence.slice(3, sequence.len() - 1)
                int flags = 0
                for int i = 0; i < body.len(); i += 1 {
                    u8 c = body[i]
                    if c >= '0'.char() && c <= '9'.char() {
                        flags = flags * 10 + (c as int - '0'.char() as int)
                        continue
                    }
                    break
                }
                if flags != 0 {
                    view.kitty_negotiated = true
                    if view.modify_other_keys_active {
                        view.terminal.write(term.MODIFY_OTHER_KEYS_OFF) catch send_error {}
                        view.modify_other_keys_active = false
                    }
                } else if !view.modify_other_keys_active {
                    view.terminal.write(term.MODIFY_OTHER_KEYS_ON) catch send_error {}
                    view.modify_other_keys_active = true
                }
                continue
            }
            if normalized_sequence.starts_with('\x1b[?') && normalized_sequence.ends_with('c') && !view.kitty_negotiated {
                // DA sentinel arrived before any kitty answer: fall back.
                view.terminal.write(term.MODIFY_OTHER_KEYS_ON) catch send_error {}
                view.modify_other_keys_active = true
                continue
            }
            // B4: consume terminal theme reports before key interpretation.
            string report = terminal_colors.theme_from_terminal_response(normalized_sequence)
            if report != '' {
                view.live_theme_report = report
                view.apply_live_theme()
                continue
            }
            var cell_size = terminal_image.parse_csi_16t_cell_size(normalized_sequence)
            if cell_size is terminal_image.cell_dimensions_t dimensions {
                terminal_image.set_cell_dimensions(dimensions)
                view.redraw()
                continue
            }
            output.send(input_t {data: normalized_sequence,}) catch send_error {}
        }
        for paste in processed.pastes {
            output.send(input_t {data: paste, paste: true,}) catch send_error {}
        }
    }
}

pub fn view_t.oauth_task_cancelled(&self, int generation): bool {
    self.oauth_lock.lock()
    bool result = self.oauth_cancelled || self.oauth_generation != generation || self.quitting
    self.oauth_lock.unlock()
    return result
}

pub fn oauth_login_worker(ref<view_t> view, string provider, int generation, string method, ref<oauth_cancellation_t> cancel_state): void! {
    if method == 'device_code' {
        var device = oauth.start_device(provider) catch error {
            view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: error.msg(),}) catch send_error {}
            return
        }
        view.input_events.try_send(input_t {oauth_ready: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_device_code: device.device_code, oauth_device_uri: device.verification_uri, oauth_device_user_code: device.user_code, oauth_device_interval: device.interval_seconds, oauth_device_expires: device.expires_seconds,}) catch send_error {}
        oauth.cancel_fn cancelled = fn(): bool {
            cancel_state.lock.lock()
            bool result = cancel_state.cancelled
            cancel_state.lock.unlock()
            return result
        }
        var token = oauth.poll_device_with_cancel(provider, device, cancelled) catch error {
            if !view.oauth_task_cancelled(generation) {
                view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: error.msg(),}) catch send_error {}
            }
            return
        }
        if view.oauth_task_cancelled(generation) {return}
        oauth.save_token(provider, token) catch error {
            view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: error.msg(),}) catch send_error {}
            return
        }
        view.input_events.try_send(input_t {oauth_done: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method,}) catch send_error {}
        return
    }
    var attempt = oauth.start_browser(provider) catch error {
        view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: error.msg(),}) catch send_error {}
        return
    }
    view.oauth_lock.lock()
    view.oauth_browser = attempt
    view.oauth_lock.unlock()
    view.input_events.try_send(input_t {oauth_ready: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_authorize_url: attempt.authorize_url, oauth_verifier: attempt.verifier, oauth_state: attempt.state,}) catch send_error {}
    if !(attempt.callback is ref<oauth_callback.callback_server_t>) {
        view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: 'OAuth callback listener was not created',}) catch send_error {}
        return
    }
    var listener = attempt.callback as ref<oauth_callback.callback_server_t>
    var result = listener.wait() catch error {
        if !view.oauth_task_cancelled(generation) {
            view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: error.msg(),}) catch send_error {}
        }
        return
    }
    if view.oauth_task_cancelled(generation) {return}
    var token = oauth.exchange_browser(attempt, result.code) catch error {
        view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: error.msg(),}) catch send_error {}
        return
    }
    oauth.save_token(provider, token) catch error {
        view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method, oauth_error: error.msg(),}) catch send_error {}
        return
    }
    view.input_events.try_send(input_t {oauth_done: true, oauth_generation: generation, oauth_provider: provider, oauth_method: method,}) catch send_error {}
}

pub fn oauth_manual_exchange_worker(ref<view_t> view, string provider, int generation, ref<oauth.browser_auth_t> attempt, string input): void! {
    var token = oauth.exchange_browser(attempt, input) catch error {
        view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: 'browser', oauth_error: error.msg(),}) catch send_error {}
        return
    }
    oauth.save_token(provider, token) catch error {
        view.input_events.try_send(input_t {oauth_failed: true, oauth_generation: generation, oauth_provider: provider, oauth_method: 'browser', oauth_error: error.msg(),}) catch send_error {}
        return
    }
    view.input_events.try_send(input_t {oauth_done: true, oauth_generation: generation, oauth_provider: provider, oauth_method: 'browser',}) catch send_error {}
}

pub fn view_t.handle_oauth_event(&self, input_t input) {
    self.oauth_lock.lock()
    bool current = input.oauth_generation == self.oauth_generation
    self.oauth_lock.unlock()
    if !current {return}
    if input.oauth_failed {
        self.oauth_lock.lock()
        self.oauth_browser = null
        self.oauth_cancel_state = null
        self.oauth_cancelled = false
        self.oauth_lock.unlock()
        self.chat.error_message = input.oauth_error
        self.chat.status = 'Account login failed'
        self.overlay = null
        self.redraw()
        return
    }
    if input.oauth_ready {
        if input.oauth_method == 'device_code' {
            if self.overlay is ref<overlay_t> overlay {
                overlay.title = 'Complete device login for ' + input.oauth_provider + ' and press Enter:'
                overlay.oauth_device_code = input.oauth_device_code
                overlay.oauth_device_uri = input.oauth_device_uri
                overlay.oauth_device_user_code = input.oauth_device_user_code
                overlay.oauth_device_interval = input.oauth_device_interval
                overlay.oauth_device_expires = input.oauth_device_expires
            }
            self.chat.status = 'Open ' + input.oauth_device_uri + ' and enter code ' + input.oauth_device_user_code + ' in the browser.'
        } else {
            if self.overlay is ref<overlay_t> overlay {
                overlay.title = 'Waiting for OAuth callback for ' + input.oauth_provider + ' (paste a callback to finish):'
                overlay.oauth_verifier = input.oauth_verifier
                overlay.oauth_state = input.oauth_state
                overlay.oauth_method = input.oauth_method
                self.chat.status = 'Open this URL in a browser: ' + input.oauth_authorize_url
            }
        }
        self.redraw()
        return
    }
    self.oauth_lock.lock()
    self.oauth_browser = null
    self.oauth_cancel_state = null
    self.oauth_cancelled = false
    self.oauth_lock.unlock()
    self.runner.refresh_auth() catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.chat.error_message = ''
    self.chat.status = 'Signed in with an account for ' + input.oauth_provider
    refresh_auth_provider_count(self)
    self.refresh_model_argument_cache()
    self.overlay = null
    self.redraw()
}

// UTF-8 code point boundary around `offset` in `value`.  Walks back over
// continuation bytes (0x80..0xBF) to the leading byte and forward to the
// next leading byte; guarantees a slice that never splits a code point,
// even if offset lands mid-codepoint.
fn codepoint_boundary(string value, int offset): (int, int) {
    int length = value.len()
    if offset >= length {
        // Never index value[length]; an offset at/behind EOL has no
        // codepoint to wrap.
        return (length, length)
    }
    int start = offset
    for start > 0 {
        u8 byte = value[start] as u8
        if byte >= 0x80 && byte <= 0xBF {
            start -= 1
        } else {
            break
        }
    }
    int end = start + 1
    for end < length {
        u8 byte = value[end] as u8
        if byte >= 0x80 && byte <= 0xBF {
            end += 1
        } else {
            break
        }
    }
    return (start, end)
}

fn render_editor(ref<editor.editor_t> editor, int width, ref<autocomplete.autocomplete_state_t> autocomplete_state, string thinking, int terminal_rows, int padding_x): [string]! {
    [string] result = vec<string>.cap_of(16)
    bool bash_mode = editor.get_text().starts_with('!')
    result.push(theme.editor_border_line(thinking, bash_mode, width))
    editor.width = width
    // Pi editorPaddingX: extra horizontal padding for the input editor rows.
    string padding = repeat_spaces(1 + padding_x)
    var visual_lines = editor.visual_lines()
    var cursor = editor.visual_cursor() catch error {
        editor.visual_cursor_t {}
    }
    int visible_lines = terminal_rows * 30 / 100
    if visible_lines < 5 {
        visible_lines = 5
    }
    int first_line = 0
    if visual_lines.len() > visible_lines && cursor.visual_index >= visible_lines {
        first_line = cursor.visual_index - visible_lines + 1
    }
    int last_line = first_line + visible_lines
    if last_line > visual_lines.len() {
        last_line = visual_lines.len()
    }
    if first_line > 0 {
        result.push(padding + theme.fg(theme.dim_color(), fmt.sprintf('↑ %d more', first_line)))
    }
    for int index = first_line; index < last_line; index += 1 {
        var visual = visual_lines[index]
        string value = visual.text
        string display = value
        if index == cursor.visual_index {
            // The cursor must be inserted on a UTF-8 grapheme boundary:
            // visual_col is a display column and would slice into
            // multi-byte code points (CJK/combining/emoji/ZWJ).  Use the
            // byte offset carried by the cursor and extend it over the
            // full grapheme under the caret.
            int cursor_offset = cursor.byte_offset
            if cursor_offset > value.len() {
                cursor_offset = value.len()
            }
            int glyph_start = cursor_offset
            int glyph_end = cursor_offset
            if cursor_offset < value.len() {
                var segments = unicode.graphemes(value) catch error {[]}
                bool found = false
                for segment in segments {
                    if segment.start <= cursor_offset && cursor_offset < segment.end {
                        glyph_start = segment.start
                        glyph_end = segment.end
                        found = true
                        break
                    }
                }
                if !found {
                    // Fail-safe: never fall back to a single-byte slice.
                    // Use explicit UTF-8 code point boundaries instead.
                    var (safe_start, safe_end) = codepoint_boundary(value, cursor_offset)
                    glyph_start = safe_start
                    glyph_end = safe_end
                }
                // Pi emits the zero-width IME marker immediately before the
                // inverse-video software cursor; neither replaces the other.
                display = value.slice(0, glyph_start) + text_utils.CURSOR_MARKER + theme.cursor(value.slice(glyph_start, glyph_end)) + value.slice(glyph_end, value.len())
            } else {
                // Cursor at EOL: marker plus a software cursor space. The
                // hidden terminal cursor is positioned on the same cell.
                display += text_utils.CURSOR_MARKER + theme.cursor(' ')
            }
        }
        string line = padding + display
        if text_utils.visible_width(line) > width {
            line = text_utils.truncate_to_width(line, width, '...', false)
        }
        result.push(line)
    }
    int remaining = visual_lines.len() - last_line
    if remaining > 0 {
        result.push(padding + theme.fg(theme.dim_color(), fmt.sprintf('↓ %d more', remaining)))
    }
    result.push(theme.editor_border_line(thinking, bash_mode, width))
    if autocomplete_state.active {
        result.append(render_command_menu(autocomplete_state, width))
    }
    return result
}

// Re-derive the autocomplete state after every editor edit/move (Pi editor.ts
// updateAutocomplete): the state re-queries from the text before the cursor;
// movement out of the completable context cancels it. The selection is bound
// to the query generation, so a stale index never survives a query change
// (IP-001).  B1-R4-02/04: @ attachments join the same state machine on ANY
// line; Pi checks extractAtPrefix before the slash context, and a natural
// (non-explicit) request opens the SelectList even with a single candidate.
fn generation_next(ref<view_t> view): int {
    return view.autocomplete.generation + 1
}

fn column_still_anchored(ref<view_t> view, int column): bool {
    return column >= view.autocomplete.anchor_column
}

pub fn view_t.update_autocomplete_state(&self) {
    var cursor = self.editor.get_cursor()
    var lines = self.editor.get_lines()
    if cursor.line >= lines.len() {
        self.autocomplete.cancel()
        return
    }
    int column = cursor.column
    if column < 0 {
        column = 0
    }
    if column > lines[cursor.line].len() {
        column = lines[cursor.line].len()
    }
    // B5: Pi live-refilters an open path menu as the query grows.  A Tab-
    // opened PATH menu previously cancelled on the next keystroke because no
    // branch re-derived its candidates; keep it alive while the anchor holds.
    if self.autocomplete.active && self.autocomplete.mode == autocomplete.autocomplete_mode_t.PATH {
        if cursor.line == self.autocomplete.anchor_line && column >= self.autocomplete.anchor_column {
            int start_col = self.autocomplete.anchor_column
            if start_col > lines[cursor.line].len() {start_col = lines[cursor.line].len()}
            string prefix = lines[cursor.line].slice(start_col, column)
            string home = syscall.get_env('HOME')
            var items = path_completion.get_file_suggestions(prefix, self.runner.repository.cwd, home)
            [autocomplete.autocomplete_item_t] mapped = []
            for item in items {
                mapped.push(self.path_item(item))
            }
            if mapped.len() > 0 {
                self.autocomplete.begin(autocomplete.autocomplete_mode_t.PATH, generation_next(self), prefix, prefix, mapped, self.resolved_max_visible())
                self.autocomplete.anchor_line = cursor.line
                self.autocomplete.anchor_column = column
                return
            }
        }
        self.autocomplete.cancel()
        return
    }
    string before = lines[cursor.line].slice(0, column)
    int generation = self.autocomplete.generation + 1
    int max_visible = self.resolved_max_visible()
    // @ attachment prefix at a token boundary (shared extract_at_prefix):
    // me@domain stays plain text and never triggers completion (B1-R4-04).
    string at_prefix = path_completion.extract_at_prefix(before)
    if at_prefix != '' {
        var items = self.at_items(at_prefix)
        if items.len() > 0 {
            self.autocomplete.begin(autocomplete.autocomplete_mode_t.AT, generation, at_prefix, at_prefix, items, max_visible)
            self.autocomplete.anchor_line = cursor.line
            self.autocomplete.anchor_column = column
        } else {
            self.autocomplete.cancel()
        }
        return
    }
    // Pi isSlashMenuAllowed: the slash menu only exists on the first editor
    // line (B1-R1-04); a "/" on any other line is plain text.
    if cursor.line != 0 {
        self.autocomplete.cancel()
        return
    }
    if before.starts_with('/') {
        int space = before.find(' ')
        if space < 0 {
            // Command-name completion ("/model"): Pi's suggestions.prefix is
            // the whole text before the cursor, e.g. "/mo".
            string query = before.slice(1, before.len())
            self.autocomplete.begin(autocomplete.autocomplete_mode_t.COMMAND, generation, before, query, self.command_items(), max_visible)
            self.autocomplete.anchor_line = cursor.line
            self.autocomplete.anchor_column = column
            return
        }
        string command = before.slice(0, space)
        // B1-R1-02: the argument prefix is ONLY the text after the space
        // (Pi suggestions.prefix = argumentText), never the whole "/model
        // deep" before-text; both the replacement range and best-match use
        // it.
        string argument = before.slice(space + 1, before.len())
        if command == '/model' {
            var items = self.model_argument_items()
            if items.len() > 0 {
                self.autocomplete.begin(autocomplete.autocomplete_mode_t.MODEL_ARGUMENT, generation, argument, argument, items, max_visible)
                self.autocomplete.anchor_line = cursor.line
                self.autocomplete.anchor_column = column
            } else {
                self.autocomplete.cancel()
            }
            return
        }
        if command == '/login' {
            var items = self.login_argument_items()
            if items.len() > 0 {
                self.autocomplete.begin(autocomplete.autocomplete_mode_t.LOGIN_ARGUMENT, generation, argument, argument, items, max_visible)
                self.autocomplete.anchor_line = cursor.line
                self.autocomplete.anchor_column = column
            } else {
                self.autocomplete.cancel()
            }
            return
        }
        self.autocomplete.cancel()
        return
    }
    self.autocomplete.cancel()
}

// Apply the selected item (B1-R1-01..03).  submit=true follows Pi's Enter
// contract: a "/" command completion applies to the editor lines first, then
// the REPLACED full editor text is submitted through editor.submit() (single
// source of truth for history/execution); argument completions apply without
// submitting.  submit=false (Tab) always applies without submitting.
pub fn view_t.apply_autocomplete(&self, bool submit): ref<session_stream.stream_t>? {
    if !self.autocomplete.active || self.autocomplete.selected_index < 0 || self.autocomplete.selected_index >= self.autocomplete.filtered.len() {
        self.autocomplete.cancel()
        return null
    }
    var selected = self.autocomplete.filtered[self.autocomplete.selected_index]
    var cursor = self.editor.get_cursor()
    var lines = self.editor.get_lines()
    if cursor.line >= lines.len() {
        self.autocomplete.cancel()
        return null
    }
    string text = lines[cursor.line]
    int cursor_col = cursor.column
    string prefix = self.autocomplete.prefix
    if cursor_col > text.len() {
        self.autocomplete.cancel()
        self.redraw()
        return null
    }
    if self.autocomplete.anchor_line != cursor.line || self.autocomplete.anchor_column != cursor_col {
        self.autocomplete.cancel()
        self.redraw()
        return null
    }
    int replace_start = cursor_col - prefix.len()
    if replace_start < 0 {
        self.autocomplete.cancel()
        self.redraw()
        return null
    }
    if text.slice(replace_start, cursor_col) != prefix {
        self.autocomplete.cancel()
        self.redraw()
        return null
    }
    if self.autocomplete.mode == autocomplete.autocomplete_mode_t.COMMAND {
        // Pi: beforePrefix + '/' + value + ' ' + afterCursor, cursor after
        // the trailing space; only the typed command prefix is replaced.
        self.editor.apply_completion(cursor.line, replace_start, cursor_col, '/' + selected.value + ' ')
        self.autocomplete.cancel()
        if !submit {
            return null
        }
        // Pi Enter falls through to submit: the completed line (including
        // any cursor suffix and other editor lines) is submitted verbatim.
        var submitted = self.editor.submit()
        if submitted.text == '' {
            self.redraw()
            return null
        }
        self.editor.add_history(submitted.text)
        return self.start_prompt(submitted.text)
    }
    if self.autocomplete.mode == autocomplete.autocomplete_mode_t.PATH || self.autocomplete.mode == autocomplete.autocomplete_mode_t.AT {
        // B1-R4-02/12: file/@ completion shares the atomic range apply;
        // the shared completion_range adds the @file trailing space and
        // keeps the quoted/cursor/undo semantics.  Enter and Tab both
        // apply without submitting.
        self.apply_path_item(selected, self.autocomplete.mode, prefix)
        self.autocomplete.cancel()
        self.redraw()
        return null
    }
    // Argument completion: only the argument prefix is replaced by the
    // value; no trailing space; Enter and Tab both apply without submitting.
    // The applied text and the closed menu must be repainted immediately:
    // the caller returns here without another redraw (Pi's onChange ->
    // requestRender on the same input).
    self.editor.apply_completion(cursor.line, replace_start, cursor_col, selected.value)
    self.autocomplete.cancel()
    self.redraw()
    return null
}

// B1-R1-10: the merged settings value is cached on the view at init and
// reload; ordinary key presses never re-read the settings files.
pub fn view_t.resolved_max_visible(&self): int {
    return self.autocomplete_max_visible
}

pub fn view_t.show_auth_overlay(&self, string provider) {
    [string] options = []
    if provider == '' || registry.supports_oauth(provider) {
        options.push('Sign in with an account')
    }
    if provider == '' || registry.supports_api_key_login(provider) {
        options.push('Sign in with an API key')
    }
    string title = provider == '' ? 'Select authentication method:' : 'Select authentication method for ' + provider + ':'
    self.overlay = new overlay_t(kind = OVERLAY_AUTH_METHOD, title = title, provider = provider, options = options)
}

// Interactive project-trust selector.  Persistent choices use the same
// atomic set_many path as `/trust trust|no|parent`; session-only choices stay
// on the view and are deliberately absent from the trust store.
// Pi formatProjectTrustPrompt + TrustSelectorComponent: the startup selector
// for an unresolved 'ask' project.  Lists getProjectTrustOptions with
// session-only variants; dismissing leaves the project untrusted.
fn view_t.show_trust_startup_prompt(&self) {
    string cwd = self.runner.repository.cwd
    [trust.trust_option_t] choices = trust.get_project_trust_options(cwd, true)
    [string] labels = []
    for choice in choices {
        labels.push(choice.label)
    }
    self.overlay = new overlay_t(kind = OVERLAY_TRUST, title = 'Trust project folder?', provider = cwd, options = labels, trust_options = choices, trust_prompt = true)
    self.chat.status = ''
}

// Adou shows an untrusted warning whenever the resolved project is untrusted:
// "This project is not trusted. Project .adou resources and .agents skills
// are ignored. Use /trust to save a trust decision."
// B4: a live OSC 11 / CSI 997 answer overrides the env fallback for the
// automatic light/dark pair and repaints once.
fn view_t.apply_live_theme(&self) {
    if !self.settings_snapshot.theme.contains('/') {
        return
    }
    self.activate_theme_setting(self.settings_snapshot.theme)
    self.redraw()
}

fn view_t.update_untrusted_banner(&self, string cwd) {
    self.show_untrusted_banner = !self.trusted_for(cwd) && trust.has_trust_requiring_resources(cwd)
}

pub fn view_t.show_trust_overlay(&self) {
    string cwd = self.runner.repository.cwd
    bool trusted = self.trusted_for(cwd)
    [trust.trust_option_t] choices = trust.get_project_trust_options(cwd, true)
    [string] labels = []
    for choice in choices {
        labels.push(choice.label)
    }
    string source = trust.decision_source(cwd)
    string title = 'Project trust: ' + (trusted ? 'trusted' : 'untrusted')
    self.overlay = new overlay_t(kind = OVERLAY_TRUST, title = title, provider = cwd, options = labels, trust_options = choices)
    if source != '' {
        self.chat.status = 'Saved trust source: ' + source
    } else {
        self.chat.status = 'No saved trust decision for ' + cwd
    }
}

fn view_t.apply_trust_option(&self, ref<overlay_t> overlay) {
    if overlay.selected < 0 || overlay.selected >= overlay.trust_options.len() {
        return
    }
    var choice = overlay.trust_options[overlay.selected]
    bool session_only = choice.label.contains('(this session only)')
    if session_only {
        self.session_trust_override_set = true
        self.session_trust_override = choice.trusted
        self.session_trust_cwd = overlay.provider
    } else {
        trust.set_many(choice.updates) catch error {
            self.chat.error_message = 'Could not save project trust: ' + error.msg()
            self.redraw()
            return
        }
        self.session_trust_override_set = false
        self.session_trust_cwd = overlay.provider
    }
    bool trusted = self.trusted_for(overlay.provider)
    self.refresh_resource_snapshot(overlay.provider, false)
    self.update_untrusted_banner(overlay.provider)
    self.chat.status = (trusted ? 'Project trusted' : 'Project not trusted') + (session_only ? ' for this session' : ' and saved')
    self.chat.error_message = ''
    self.overlay = null
    // Pi resolves trust before interactive mode starts, so the first-time
    // setup welcome follows the startup trust decision.
    if overlay.trust_prompt {
        string marker = path.join(paths.agent_dir(), '.adou-setup')
        if !path_utils.exists(marker) && self.pending_initial_messages.len() == 0 {
            self.show_setup_overlay()
            return
        }
    }
    self.redraw()
}

pub fn view_t.show_model_overlay(&self, string query) {
    debug.log('tui', 'model selector begin query_chars=' + fmt.sprintf('%d', query.len()) + ' scope_patterns=' + fmt.sprintf('%d', self.model_scope_patterns.len()))
    [ref<ai_types.model_t>] available = []
    for model in models.all() {
        if !self.model_is_authenticated(model) {
            continue
        }
        available.push(model)
    }
    [ref<ai_types.model_t>] scoped = []
    for entry in models.resolve_scope(self.model_scope_patterns) {
        if self.model_is_authenticated(entry.model) {
            scoped.push(entry.model)
        }
    }
    debug.log('tui', 'model selector candidates available=' + fmt.sprintf('%d', available.len()) + ' scoped=' + fmt.sprintf('%d', scoped.len()))
    string current = self.runner.agent_config.model.provider + '/' + self.runner.agent_config.model.id
    var state = model_selector.new(available, scoped, current, query)
    self.model_refresh_generation += 1
    state.refresh_generation = self.model_refresh_generation
    self.overlay = new overlay_t(kind = OVERLAY_MODEL, title = 'Select model:', model_state = state)
    // The cached catalog is rendered immediately. A generation-tagged
    // background refresh can never block input or update a later selector.
    if syscall.get_env('ADOU_CATALOG_NETWORK') != '' && syscall.get_env('ADOU_OFFLINE') == '' {
        state.refresh_status = 'Refreshing model catalogs...'
        go refresh_model_catalog(self, state.refresh_generation)
    }
    debug.log('tui', 'model selector ready refresh=' + (state.refresh_status != '' ? 'pending' : 'disabled'))
}

pub fn view_t.show_scoped_models_overlay(&self) {
    [ref<ai_types.model_t>] available = []
    for model in models.all() {
        if self.model_is_authenticated(model) {
            available.push(model)
        }
    }
    [string] enabled_ids = []
    bool all_enabled = !self.scoped_models_active
    if self.model_scope_explicit && self.model_scope_patterns.len() > 0 {
        all_enabled = false
        for entry in models.resolve_scope(self.model_scope_patterns) {
            enabled_ids.push(entry.model.provider + '/' + entry.model.id)
        }
    } else {
        for id in self.scoped_model_ids {
            enabled_ids.push(id)
        }
    }
    var state = scoped_models.new(available, enabled_ids, all_enabled)
    state.dirty = self.scoped_models_dirty
    self.overlay = new overlay_t(kind = OVERLAY_SCOPED_MODELS, title = 'Model Configuration', scoped_models_state = state)
    var active = self.overlay as ref<overlay_t>
    string current = self.runner.agent_config.model.provider + '/' + self.runner.agent_config.model.id
    for index, item in state.filtered {
        if item.full_id == current {
            state.selected = index
            break
        }
    }
}

fn refresh_model_catalog(ref<view_t> view, int generation): void! {
    view.model_refresh_lock.lock()
    int failures = models.refresh_remote_catalogs_with_status()
    view.model_refresh_lock.unlock()
    view.input_events.try_send(input_t {model_refresh_done: true, model_refresh_generation: generation, model_refresh_failures: failures}) catch error {}
}

fn view_t.apply_model_refresh(&self, int generation, int failures) {
    if !(self.overlay is ref<overlay_t>) {
        return
    }
    var overlay = self.overlay as ref<overlay_t>
    if overlay.kind != OVERLAY_MODEL || !(overlay.model_state is ref<model_selector.state_t>) {
        return
    }
    var state = overlay.model_state as ref<model_selector.state_t>
    if state.refresh_generation != generation {
        return
    }
    [ref<ai_types.model_t>] available = []
    for model in models.all() {
        if self.model_is_authenticated(model) {available.push(model)}
    }
    [ref<ai_types.model_t>] scoped = []
    for entry in models.resolve_scope(self.model_scope_patterns) {
        if self.model_is_authenticated(entry.model) {scoped.push(entry.model)}
    }
    state.replace_models(available, scoped)
    if failures == 1 {
        state.error_message = 'Could not refresh one model catalog; showing cached models.'
        state.refresh_status = ''
    } else if failures > 1 {
        state.error_message = fmt.sprintf('Could not refresh %d model catalogs; showing cached models.', failures)
        state.refresh_status = ''
    } else {
        state.error_message = ''
        state.refresh_status = 'Model catalogs refreshed.'
    }
    self.redraw()
}

pub fn view_t.show_logout_overlay(&self) {
    [string] options = logout_provider_options()
    if options.len() == 0 {
        self.chat.status = 'No stored credentials to remove'
        self.redraw()
        return
    }
    self.overlay = new overlay_t(kind = OVERLAY_LOGOUT, title = 'Select provider to logout:', options = options)
}

fn login_provider_options(): [string] {
    [string] result = []
    for item in registry.login_completion_options() {
        // Keep the provider id in the value while carrying the display name
        // and search text for the selector.
        result.push(item.id + ' [' + item.name + ']')
    }
    return result
}

fn oauth_login_provider_options(): [string] {
    [string] result = []
    for item in registry.oauth_login_options() {
        result.push(item.id + ' [' + item.name + ']')
    }
    return result
}

fn logout_provider_options(): [string] {
    [string] result = []
    for credential in auth.list_credentials() {
        string name = credential.provider_id
        var definition = registry.find_def(credential.provider_id)
        if definition is ai_types.provider_def_t found {
            if found.name != '' {
                name = found.name
            }
        }
        result.push(credential.provider_id + ' [' + name + ' · ' + credential.credential_type + ']')
    }
    for int outer = 0; outer < result.len(); outer += 1 {
        for int inner = outer + 1; inner < result.len(); inner += 1 {
            if result[inner].to_lower() < result[outer].to_lower() {
                string swap = result[outer]
                result[outer] = result[inner]
                result[inner] = swap
            }
        }
    }
    return result
}

fn provider_id_from_option(string option): string {
    int separator = option.find(' [')
    return separator >= 0 ? option.slice(0, separator) : option
}

fn provider_name_from_option(string option): string {
    int separator = option.find(' [')
    if separator < 0 {return option}
    int end = option.len() - 1
    if end > separator && option[end] == ']'.char() {
        return option.slice(separator + 2, end)
    }
    return option.slice(separator + 2, option.len())
}

// Batch 3: Pi's settings list order (settings-selector.ts).  Value items
// cycle on Enter (Pi SettingsList behavior); submenu items open their
// submenu. Pi only exposes terminal-rendering controls when an inline image
// protocol is available; model-facing resize/block controls are always shown.
pub fn view_t.show_settings_overlay(&self) {
    var s = self.settings_snapshot
    var image_capabilities = terminal_image.detect_capabilities()
    bool images_available = image_capabilities[0] != ''
    int selected = 0
    if self.overlay is ref<overlay_t> previous {
        if previous.kind == OVERLAY_SETTINGS {
            selected = previous.selected
        }
    }
    [string] options = ['Auto-compact: ' + onoff(s.auto_compaction)]
    if images_available {
        options.push('Show images: ' + onoff(s.show_images))
        options.push('Image width: ' + int_string(s.image_width_cells))
    }
    options.push('Auto-resize images: ' + onoff(s.auto_resize_images))
    options.push('Block images: ' + onoff(s.block_images))
    [string] remaining = [
        'Skill commands: ' + onoff(s.enable_skill_commands),
        'Show hardware cursor: ' + onoff(s.show_hardware_cursor),
        'Editor padding: ' + int_string(s.editor_padding_x),
        'Output padding: ' + int_string(s.output_pad),
        'Autocomplete max items: ' + int_string(s.autocomplete_max_visible),
        'Clear on shrink: ' + onoff(s.terminal_clear_on_shrink),
        'Terminal progress: ' + onoff(s.terminal_progress),
        'Steering mode: ' + s.steering_mode,
        'Follow-up mode: ' + s.follow_up_mode,
        'Transport: ' + s.transport,
        'HTTP idle timeout: ' + timeout_label(s.http_idle_timeout_ms),
        'Hide thinking: ' + onoff(s.hide_thinking),
        'Cache miss notices: ' + onoff(s.show_cache_miss_notices),
        'Collapse changelog: ' + onoff(s.collapse_changelog),
        'Quiet startup: ' + onoff(s.quiet_startup),
        'Install telemetry: ' + onoff(s.enable_install_telemetry),
        'Default project trust: ' + trust_label(s.default_project_trust),
        'Double-escape action: ' + s.double_escape_action,
        'Tree filter mode: ' + s.tree_filter_mode,
        'Warnings: configure                  (enter: warnings submenu)',
        'Thinking level: ' + self.chat.thinking + '           (enter: level submenu)',
        'Theme: ' + theme_label(s.theme) + '                 (enter: theme submenu)',
    ]
    for option in remaining {
        options.push(option)
    }
    self.overlay = new overlay_t(kind = OVERLAY_SETTINGS, title = 'Settings', options = options)
    var active = self.overlay as ref<overlay_t>
    if selected < options.len() {
        active.selected = selected
    }
}

// Enter on a value row cycles to the next value and applies the runtime
// effect immediately (Pi SettingsList Enter/Space behavior); submenu rows
// open their submenu.
fn view_t.handle_settings_option(&self, ref<overlay_t> overlay, string option) {
    var s = self.settings_snapshot
    if option.starts_with('Warnings:') {
        self.show_warnings_overlay(overlay)
        return
    }
    if option.starts_with('Thinking level:') {
        self.show_thinking_submenu(overlay)
        return
    }
    if option.starts_with('Theme:') {
        self.show_theme_overlay(overlay)
        return
    }
    bool images_available = terminal_image.detect_capabilities()[0] != ''
    if option.starts_with('Auto-compact:') {
        s.auto_compaction = !s.auto_compaction
        self.runner.set_auto_compaction(s.auto_compaction) catch error {}
        self.chat.set_auto_compaction(s.auto_compaction)
        self.chat.status = 'Auto-compaction ' + (s.auto_compaction ? 'enabled' : 'disabled')
    } else if option.starts_with('Show images:') {
        if !images_available {return}
        s.show_images = !s.show_images
    } else if option.starts_with('Image width:') {
        if !images_available {return}
        s.image_width_cells = cycle_int(s.image_width_cells, [60, 80, 120])
    } else if option.starts_with('Auto-resize images:') {
        s.auto_resize_images = !s.auto_resize_images
        self.rebuild_read_tool_options(s.auto_resize_images)
    } else if option.starts_with('Block images:') {
        s.block_images = !s.block_images
        self.runner.apply_preferences_snapshot(s)
    } else if option.starts_with('Skill commands:') {
        s.enable_skill_commands = !s.enable_skill_commands
        self.settings_snapshot = s
        self.dynamic_commands = slash_commands.compose_resource_commands(self.prompt_templates, self.cached_skills, s.enable_skill_commands)
        self.chat.status = 'Skill commands ' + (s.enable_skill_commands ? 'enabled' : 'disabled')
    } else if option.starts_with('Show hardware cursor:') {
        s.show_hardware_cursor = !s.show_hardware_cursor
        self.terminal.set_hardware_cursor(s.show_hardware_cursor) catch error {}
        self.chat.status = 'Hardware cursor ' + (s.show_hardware_cursor ? 'shown' : 'hidden')
    } else if option.starts_with('Editor padding:') {
        s.editor_padding_x = cycle_int(s.editor_padding_x, [0, 1, 2, 3])
        self.editor_padding_x = s.editor_padding_x
    } else if option.starts_with('Output padding:') {
        s.output_pad = cycle_int(s.output_pad, [0, 1])
        self.chat.set_output_pad(s.output_pad)
    } else if option.starts_with('Autocomplete max items:') {
        s.autocomplete_max_visible = cycle_int(s.autocomplete_max_visible, [3, 5, 7, 10, 15, 20])
        self.autocomplete_max_visible = s.autocomplete_max_visible
    } else if option.starts_with('Clear on shrink:') {
        s.terminal_clear_on_shrink = !s.terminal_clear_on_shrink
        self.renderer.set_clear_on_shrink(s.terminal_clear_on_shrink)
    } else if option.starts_with('Terminal progress:') {
        s.terminal_progress = !s.terminal_progress
    } else if option.starts_with('Steering mode:') {
        s.steering_mode = cycle_value(s.steering_mode, ['one-at-a-time', 'all'])
        self.runner.set_steering_mode(s.steering_mode) catch error {}
        self.chat.status = 'Steering mode: ' + s.steering_mode
    } else if option.starts_with('Follow-up mode:') {
        s.follow_up_mode = cycle_value(s.follow_up_mode, ['one-at-a-time', 'all'])
        self.runner.set_follow_up_mode(s.follow_up_mode) catch error {}
        self.chat.status = 'Follow-up mode: ' + s.follow_up_mode
    } else if option.starts_with('Transport:') {
        s.transport = cycle_value(s.transport, ['auto', 'sse', 'websocket', 'websocket-cached'])
        self.runner.set_runtime_transport(s.transport)
        self.chat.status = 'Transport: ' + s.transport
    } else if option.starts_with('HTTP idle timeout:') {
        int next_ms = cycle_timeout(s.http_idle_timeout_ms)
        s.http_idle_timeout_ms = next_ms
        self.runner.set_runtime_http_idle_timeout_ms(next_ms)
        self.chat.status = 'HTTP idle timeout: ' + timeout_label(next_ms)
    } else if option.starts_with('Hide thinking:') {
        bool visible = self.chat.toggle_thinking_visibility()
        s.hide_thinking = !visible
        self.chat.status = 'Thinking blocks: ' + (visible ? 'visible' : 'hidden')
    } else if option.starts_with('Cache miss notices:') {
        s.show_cache_miss_notices = !s.show_cache_miss_notices
        self.chat.set_show_cache_miss_notices(s.show_cache_miss_notices)
    } else if option.starts_with('Collapse changelog:') {
        s.collapse_changelog = !s.collapse_changelog
    } else if option.starts_with('Quiet startup:') {
        s.quiet_startup = !s.quiet_startup
    } else if option.starts_with('Install telemetry:') {
        s.enable_install_telemetry = !s.enable_install_telemetry
    } else if option.starts_with('Default project trust:') {
        s.default_project_trust = cycle_value(s.default_project_trust, ['ask', 'always', 'never'])
    } else if option.starts_with('Double-escape action:') {
        s.double_escape_action = cycle_value(s.double_escape_action, ['tree', 'fork', 'none'])
    } else if option.starts_with('Tree filter mode:') {
        s.tree_filter_mode = cycle_value(s.tree_filter_mode, ['default', 'no-tools', 'user-only', 'labeled-only', 'all'])
    }
    self.settings_snapshot = s
    self.save_preferences()
    self.show_settings_overlay()
    self.redraw()
}

// `read` owns image normalization, so rebuilding the existing built-in tool
// selection is the runtime boundary for the persisted auto-resize setting.
fn view_t.rebuild_read_tool_options(&self, bool auto_resize_images) {
    if self.runner.base_context.tools.len() == 0 {
        return
    }
    [string] tool_names = []
    for tool in self.runner.base_context.tools {
        tool_names.push(tool.name)
    }
    var rebuilt = builtins.select_tools_with_options(self.runner.repository.cwd, tool_names, [], false, auto_resize_images) catch error {
        self.chat.error_message = 'Could not apply image settings: ' + error.msg()
        return
    }
    agent_types.snapshot_tool_schemas(rebuilt) catch error {
        self.chat.error_message = 'Could not snapshot tool schemas: ' + error.msg()
        return
    }
    self.runner.base_context.tools = rebuilt
}

// Pi's Warnings submenu: one warning toggle.
fn view_t.show_warnings_overlay(&self, ref<overlay_t> overlay) {
    overlay.kind = OVERLAY_SETTINGS_WARNINGS
    overlay.title = 'Warnings'
    overlay.options = ['Anthropic extra usage: ' + onoff(self.settings_snapshot.warnings_anthropic_extra_usage)]
    overlay.selected = 0
    self.redraw()
}

fn view_t.handle_warnings_toggle(&self, ref<overlay_t> overlay) {
    var s = self.settings_snapshot
    s.warnings_anthropic_extra_usage = !s.warnings_anthropic_extra_usage
    self.settings_snapshot = s
    self.save_preferences()
    overlay.options[0] = 'Anthropic extra usage: ' + onoff(s.warnings_anthropic_extra_usage)
    self.redraw()
}

// Pi's Theme submenu: single mode ([Automatic, ...available themes], live
// preview, Enter applies, Esc restores) and automatic mode (light/dark pair
// editing).
fn view_t.show_theme_overlay(&self, ref<overlay_t> overlay) {
    string stored = self.settings_snapshot.theme
    [string] available = self.available_theme_names()
    overlay.kind = OVERLAY_THEME
    overlay.title = 'Theme'
    overlay.theme_original = stored
    if stored.contains('/') {
        var (light_value, dark_value) = split_theme_pair(stored)
        overlay.theme_light = light_value
        overlay.theme_dark = dark_value
        overlay.options = ['Automatic: ' + stored + '   (enter: edit pair)']
        overlay.selected = 0
    } else {
        // Pi defaultAutomaticThemes: a fixed current theme seeds both slots.
        string single = theme_list_contains(available, stored) ? stored : 'dark'
        overlay.theme_light = single
        overlay.theme_dark = single
        overlay.options = ['Automatic   (follow terminal appearance)']
        for name in available {
            overlay.options.push(name)
        }
        // Pi's SelectSubmenu pre-selects the current value; Enter on the
        // submenu starts on the active theme instead of always Automatic.
        overlay.selected = 0
        for index, name in overlay.options {
            if name == single {
                overlay.selected = index
                break
            }
        }
    }
    self.redraw()
}

// Pi's Thinking Level submenu: seven levels with the current one marked.
pub fn view_t.show_thinking_submenu(&self, ref<overlay_t> overlay) {
    overlay.kind = OVERLAY_SETTINGS_SUBMENU
    overlay.title = 'Thinking Level'
    overlay.options = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']
    overlay.query = self.chat.thinking
    overlay.selected = 0
    for index, level in overlay.options {
        if level == self.chat.thinking {
            overlay.selected = index
            break
        }
    }
    self.redraw()
}

fn view_t.handle_settings_submenu(&self, ref<overlay_t> overlay) {
    string level = overlay.options[overlay.selected]
    self.runner.set_thinking_level(level) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.chat.thinking = level
    self.chat.status = 'Thinking: ' + level
    // Keep the trust-aware snapshot aligned with the persisted preference.
    self.settings_snapshot.default_thinking_level = level
    // Rebuild the full settings list; the submenu replaced the option set.
    self.save_preferences()
    self.show_settings_overlay()
    self.redraw()
}

fn view_t.handle_theme_input(&self, ref<overlay_t> overlay, string key) {
    if key == 'up' {
        overlay.selected = overlay.selected == 0 ? overlay.options.len() - 1 : overlay.selected - 1
        self.preview_theme_option(overlay)
        self.redraw()
        return
    }
    if key == 'down' {
        overlay.selected = overlay.selected == overlay.options.len() - 1 ? 0 : overlay.selected + 1
        self.preview_theme_option(overlay)
        self.redraw()
        return
    }
    if key == 'enter' {
        self.apply_theme_option(overlay)
        return
    }
    if key == 'escape' || key == 'ctrl+c' {
        self.cancel_theme_overlay(overlay)
        return
    }
}

fn view_t.preview_theme_option(&self, ref<overlay_t> overlay) {
    if overlay.options.len() <= 1 {
        // Automatic pair row: preview the active variant (dark fallback).
        self.activate_theme_setting(overlay.theme_light + '/' + overlay.theme_dark)
        return
    }
    if overlay.selected == 0 {
        self.activate_theme_setting(overlay.theme_light + '/' + overlay.theme_dark)
        return
    }
    string name = overlay.options[overlay.selected]
    self.activate_theme_setting(name)
}

fn view_t.apply_theme_option(&self, ref<overlay_t> overlay) {
    var s = self.settings_snapshot
    if overlay.options.len() <= 1 {
        // Automatic pair row: edit the pair.
        self.show_theme_auto_overlay(overlay)
        return
    }
    if overlay.selected == 0 {
        // Automatic: keep the edited pair (default light/dark).
        s.theme = overlay.theme_light + '/' + overlay.theme_dark
    } else {
        s.theme = overlay.options[overlay.selected]
    }
    self.settings_snapshot = s
    self.save_preferences()
    self.activate_theme_setting(s.theme)
    self.show_settings_overlay()
    self.redraw()
}

fn view_t.cancel_theme_overlay(&self, ref<overlay_t> overlay) {
    var s = self.settings_snapshot
    s.theme = overlay.theme_original
    self.settings_snapshot = s
    self.activate_theme_setting(overlay.theme_original)
    self.show_settings_overlay()
    self.redraw()
}

fn view_t.show_theme_auto_overlay(&self, ref<overlay_t> overlay) {
    overlay.kind = OVERLAY_THEME_AUTO
    overlay.title = 'Automatic Theme'
    overlay.options = ['Light theme: ' + overlay.theme_light, 'Dark theme: ' + overlay.theme_dark, 'Apply (save and go back)', 'Change mode (switch to single theme)']
    overlay.selected = 0
    self.redraw()
}

fn view_t.handle_theme_auto_input(&self, ref<overlay_t> overlay, string key) {
    if key == 'up' {
        overlay.selected = overlay.selected == 0 ? overlay.options.len() - 1 : overlay.selected - 1
        self.redraw()
        return
    }
    if key == 'down' {
        overlay.selected = overlay.selected == overlay.options.len() - 1 ? 0 : overlay.selected + 1
        self.redraw()
        return
    }
    if key == 'enter' {
        if overlay.selected == 0 || overlay.selected == 1 {
            self.show_theme_select_overlay(overlay, overlay.selected == 0 ? 'light' : 'dark')
        } else if overlay.selected == 2 {
            var s = self.settings_snapshot
            s.theme = overlay.theme_light + '/' + overlay.theme_dark
            self.settings_snapshot = s
            self.save_preferences()
            self.activate_theme_setting(s.theme)
            self.show_settings_overlay()
            self.redraw()
        } else {
            self.show_theme_overlay(overlay)
        }
        return
    }
    if key == 'escape' || key == 'ctrl+c' {
        self.cancel_theme_overlay(overlay)
        return
    }
}

fn view_t.show_theme_select_overlay(&self, ref<overlay_t> overlay, string target) {
    overlay.kind = OVERLAY_THEME_SELECT
    overlay.theme_select_target = target
    overlay.title = target == 'light' ? 'Light Theme' : 'Dark Theme'
    overlay.options = self.available_theme_names()
    string current = target == 'light' ? overlay.theme_light : overlay.theme_dark
    overlay.selected = 0
    for index, name in overlay.options {
        if name == current {
            overlay.selected = index
            break
        }
    }
    self.preview_theme_pair(overlay, current)
    self.redraw()
}

fn view_t.handle_theme_select_input(&self, ref<overlay_t> overlay, string key) {
    if key == 'up' {
        overlay.selected = overlay.selected == 0 ? overlay.options.len() - 1 : overlay.selected - 1
        self.preview_theme_pair(overlay, overlay.options[overlay.selected])
        self.redraw()
        return
    }
    if key == 'down' {
        overlay.selected = overlay.selected == overlay.options.len() - 1 ? 0 : overlay.selected + 1
        self.preview_theme_pair(overlay, overlay.options[overlay.selected])
        self.redraw()
        return
    }
    if key == 'enter' {
        string name = overlay.options[overlay.selected]
        if overlay.theme_select_target == 'light' {
            overlay.theme_light = name
        } else {
            overlay.theme_dark = name
        }
        self.show_theme_auto_overlay(overlay)
        return
    }
    if key == 'escape' || key == 'ctrl+c' {
        self.show_theme_auto_overlay(overlay)
        return
    }
}

fn view_t.preview_theme_pair(&self, ref<overlay_t> overlay, string picked) {
    string light_value = overlay.theme_select_target == 'light' ? picked : overlay.theme_light
    string dark_value = overlay.theme_select_target == 'dark' ? picked : overlay.theme_dark
    self.activate_theme_setting(light_value + '/' + dark_value)
}

fn split_theme_pair(string value): (string, string) {
    int separator = value.find('/')
    if separator < 0 {
        return ('light', 'dark')
    }
    return (value.slice(0, separator), value.slice(separator + 1, value.len()))
}

fn theme_list_contains([string] values, string candidate): bool {
    for value in values {
        if value == candidate {return true}
    }
    return false
}

fn onoff(bool value): string {
    return value ? 'on' : 'off'
}

fn int_string(int value): string {
    return fmt.sprintf('%d', value)
}

fn cycle_value(string current, [string] values): string {
    for index, value in values {
        if value == current {
            return values[(index + 1) % values.len()]
        }
    }
    return values[0]
}

fn cycle_int(int current, [int] values): int {
    for index, value in values {
        if value == current {
            return values[(index + 1) % values.len()]
        }
    }
    return values[0]
}

// Pi HTTP_IDLE_TIMEOUT_CHOICES: 30 sec / 1 min / 2 min / 5 min / disabled.
fn timeout_label(int ms): string {
    if ms == 0 {return 'disabled'}
    if ms == 30000 {return '30 sec'}
    if ms == 60000 {return '1 min'}
    if ms == 120000 {return '2 min'}
    if ms == 300000 {return '5 min'}
    return fmt.sprintf('%d sec', ms / 1000)
}

fn cycle_timeout(int current): int {
    [int] values = [30000, 60000, 120000, 300000, 0]
    for index, value in values {
        if value == current {
            return values[(index + 1) % values.len()]
        }
    }
    return values[0]
}

// Pi DEFAULT_PROJECT_TRUST_LABELS.
fn trust_label(string mode): string {
    if mode == 'always' {return 'Always trust'}
    if mode == 'never' {return 'Never trust'}
    return 'Ask'
}

fn theme_label(string setting): string {
    if setting.contains('/') {
        return setting + ' (automatic)'
    }
    return setting
}

// Pi's first-time setup: a two-step welcome (theme + analytics opt-in)
// that completes by writing a marker file below the agent directory.
// Pi's config-selector manages package resources; adou's equivalent lists
// the skills and prompt templates with per-resource enable toggles.
// B1-R2-06/07: the list comes from the trust-aware snapshot
// (the trust-gated available resource lists / self.settings_snapshot), so
// an untrusted cwd never displays project resources and no disk read
// happens on open.
pub fn view_t.show_config_overlay(&self) {
    var active = new overlay_t(kind = OVERLAY_CONFIG, title = 'Resources', config_scope = 0)
    active.options = self.config_resource_options(active.config_scope)
    active.selected = config_move_selection(active.options, 0, 1, 1)
    self.overlay = active
    self.redraw()
}

fn view_t.config_resource_options(&self, int scope): [string] {
    [string] options = []
    options.push('Skills')
    // Global scope reflects the user file alone; project scope uses the
    // trust-aware merged snapshot already resolved for the active cwd.
    var settings = scope == 0 ? config_settings.load() : self.settings_snapshot
    bool any_skill = false
    for skill in self.available_skills {
        // Project mode includes inherited user resources, just as Pi does;
        // global mode only lists user/temporary resources.
        if scope == 0 && skill.source_info.scope == 'project' {continue}
        any_skill = true
        string source = skill.source_info.scope == '' ? 'user' : skill.source_info.scope
        options.push('  [' + source + '] ' + skill.name + ': ' + (resource_enabled(settings.enabled_skill_names, settings.enabled_skills_configured, skill.name) ? 'enabled' : 'disabled'))
    }
    if !any_skill {options.push('  (none)')}
    options.push('Prompts')
    bool any_prompt = false
    for template in self.available_prompt_templates {
        if scope == 0 && template.source_info.scope == 'project' {continue}
        any_prompt = true
        string source = template.source_info.scope == '' ? 'user' : template.source_info.scope
        options.push('  [' + source + '] ' + template.name + ': ' + (resource_enabled(settings.enabled_prompt_names, settings.enabled_prompts_configured, template.name) ? 'enabled' : 'disabled'))
    }
    if !any_prompt {options.push('  (none)')}
    return options
}

fn resource_enabled([string] enabled, bool configured, string name): bool {
    if !configured {
        return true
    }
    for candidate in enabled {
        if candidate == name {
            return true
        }
    }
    return false
}

fn view_t.toggle_resource(&self, string option, bool is_skill, int scope, string query) {
    int separator = option.find(':')
    if separator < 0 {
        return
    }
    int name_start = option.find('] ')
    name_start = name_start >= 0 ? name_start + 2 : 2
    string name = option.slice(name_start, separator).trim([' ', '\t'])
    var settings = scope == 1 ? config_settings.load_for(self.runner.repository.cwd) : config_settings.load()
    [string] all_names = []
    if is_skill {
        for skill in self.available_skills {
            if scope == 0 && skill.source_info.scope == 'project' {continue}
            all_names.push(skill.name)
        }
    } else {
        for template in self.available_prompt_templates {
            if scope == 0 && template.source_info.scope == 'project' {continue}
            all_names.push(template.name)
        }
    }
    bool was_enabled = is_skill ? resource_enabled(settings.enabled_skill_names, settings.enabled_skills_configured, name) : resource_enabled(settings.enabled_prompt_names, settings.enabled_prompts_configured, name)
    if is_skill {
        settings.enabled_skills_configured = true
        settings.enabled_skill_names = toggle_resource_list(settings.enabled_skill_names, all_names, name, was_enabled)
    } else {
        settings.enabled_prompts_configured = true
        settings.enabled_prompt_names = toggle_resource_list(settings.enabled_prompt_names, all_names, name, was_enabled)
    }
    if scope == 1 {
        config_settings.save_project(self.runner.repository.cwd, settings) catch error {
            self.chat.error_message = 'Could not save project config: ' + error.msg()
            self.redraw()
            return
        }
    } else {
        config_settings.save(settings) catch error {
            self.chat.error_message = 'Could not save config: ' + error.msg()
            self.redraw()
            return
        }
    }
    bool enabled_now = is_skill ? resource_enabled(settings.enabled_skill_names, settings.enabled_skills_configured, name) : resource_enabled(settings.enabled_prompt_names, settings.enabled_prompts_configured, name)
    self.chat.status = (is_skill ? 'Skill ' : 'Prompt ') + name + ' ' + (enabled_now ? 'enabled' : 'disabled')
    // The snapshot must reflect the persisted toggle before the overlay
    // re-renders (B1-R2-07); the menu/execution lists follow it.
    self.refresh_resource_snapshot(self.runner.repository.cwd, false)
    var replacement = new overlay_t(kind = OVERLAY_CONFIG, title = 'Resources', config_scope = scope, query = query)
    replacement.options = self.config_resource_options(scope)
    replacement.selected = config_move_selection(config_filtered_options(replacement), 0, 1, 1)
    self.overlay = replacement
    self.redraw()
}

fn toggle_resource_list([string] enabled, [string] all_names, string name, bool was_enabled): [string] {
    [string] result = []
    if was_enabled {
        // An empty list means "all".  To disable one item, materialize the
        // allow-list with that item removed.
        if enabled.len() == 0 {
            for candidate in all_names {
                if candidate != name {result.push(candidate)}
            }
            return result
        }
        for candidate in enabled {
            if candidate != name {result.push(candidate)}
        }
        return result
    }
    for candidate in enabled {
        result.push(candidate)
    }
    result.push(name)
    return result
}

fn config_option_is_item(string option): bool {
    return option.starts_with('  [') && !option.contains('(none)')
}

fn config_option_is_skill([string] options, int index): bool {
    if index < 0 || index >= options.len() {return false}
    for int cursor = index - 1; cursor >= 0; cursor -= 1 {
        if options[cursor] == 'Prompts' {return false}
        if options[cursor] == 'Skills' {return true}
    }
    return false
}

// Config rows contain non-selectable scope and section headers.  Keep those
// headers in a filtered result only when a matching resource remains, so the
// selected index always refers to the rows rendered on screen.
fn config_filtered_options(ref<overlay_t> overlay): [string] {
    if overlay.query == '' {
        [string] all = []
        for option in overlay.options {
            all.push(option)
        }
        return all
    }
    bool skill_match = false
    bool prompt_match = false
    string query = overlay.query.to_lower()
    for index, option in overlay.options {
        if !config_option_is_item(option) {continue}
        if fuzzy_match(option.to_lower(), query) {
            if config_option_is_skill(overlay.options, index) {
                skill_match = true
            } else {
                prompt_match = true
            }
        }
    }
    [string] result = []
    for index, option in overlay.options {
        if option == 'Skills' {
            if skill_match {result.push(option)}
            continue
        }
        if option == 'Prompts' {
            if prompt_match {result.push(option)}
            continue
        }
        if config_option_is_item(option) && fuzzy_match(option.to_lower(), query) {
            result.push(option)
        }
    }
    return result
}

fn config_move_selection([string] options, int current, int direction, int distance): int {
    if options.len() == 0 {return 0}
    int selected = current
    if selected < 0 || selected >= options.len() {selected = direction > 0 ? 0 : options.len() - 1}
    int moves = distance < 1 ? 1 : distance
    for int step = 0; step < moves; step += 1 {
        int next = selected
        bool found = false
        for int attempt = 0; attempt < options.len(); attempt += 1 {
            next += direction
            if next < 0 {next = options.len() - 1}
            if next >= options.len() {next = 0}
            if config_option_is_item(options[next]) {
                found = true
                break
            }
        }
        if found {selected = next}
    }
    return selected
}

// Apply the enable lists from the trust-aware settings snapshot (B1-R2-07).
// Thin proxies over the shared production filters; the snapshot is refreshed
// at init/reload/rebind, so this never reads settings from disk.
pub fn view_t.filter_enabled_skills(&self, [ref<skills.skill_t>] loaded): [ref<skills.skill_t>] {
    return slash_commands.filter_skills_configured(loaded, self.settings_snapshot.enabled_skill_names, self.settings_snapshot.enabled_skills_configured)
}

pub fn view_t.filter_enabled_prompts(&self, [ref<prompt_templates.prompt_template_t>] loaded): [ref<prompt_templates.prompt_template_t>] {
    return slash_commands.filter_prompt_templates_configured(loaded, self.settings_snapshot.enabled_prompt_names, self.settings_snapshot.enabled_prompts_configured)
}

pub fn view_t.show_setup_overlay(&self) {
    string detected = theme.variant() == 'light' ? 'light' : 'dark'
    int selected = detected == 'light' ? 1 : 0
    self.overlay = new overlay_t(
        kind = OVERLAY_SETUP,
        title = 'Welcome to Adou, the minimal coding agent.',
        provider = detected,
        options = ['Dark', 'Light'],
        selected = selected,
        setup_step = 'theme',
        setup_theme = detected,
    )
    self.redraw()
}

fn view_t.complete_setup(&self, ref<overlay_t> overlay) {
    bool share_analytics = overlay.selected == 0
    self.settings_snapshot.theme = overlay.setup_theme
    self.settings_snapshot.enable_analytics = share_analytics
    if share_analytics && self.settings_snapshot.tracking_id == '' {
        self.settings_snapshot.tracking_id = identity.uuid_v7() catch error {''}
    }
    self.activate_theme_setting(overlay.setup_theme)
    self.save_preferences()
    string marker = path.join(paths.agent_dir(), '.adou-setup')
    os.mkdirs(paths.agent_dir(), 0o700) catch error {
        self.chat.error_message = 'Could not save setup: ' + error.msg()
        self.redraw()
        return
    }
    var file = fs.open(marker, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o600) catch error {
        self.chat.error_message = 'Could not save setup: ' + error.msg()
        self.redraw()
        return
    }
    file.write(('theme=' + overlay.setup_theme + '\nanalytics=' + (share_analytics ? 'on' : 'off') + '\n') as [u8]) catch error {
        file.close()
        self.chat.error_message = 'Could not save setup: ' + error.msg()
        self.redraw()
        return
    }
    file.close()
    self.overlay = null
    self.chat.status = 'Setup complete. Welcome to Adou!'
    self.redraw()
}

pub fn setup_marker_path(): string {
    return path.join(paths.agent_dir(), '.adou-setup')
}

fn view_t.show_help_overlay(&self) {
    [string] options = [
        '/model        Select model',
        '/scoped-models Select from all configured models',
        '/login        Configure provider authentication',
        '/logout       Remove stored provider authentication',
        '/compact      Compact the session context',
        '/new          Start a new session',
        '/session      Show session info and token statistics',
        '/resume       Resume a saved session',
        '/import       Import a Pi v3 JSONL session',
        '/export       Export session JSONL or HTML',
        '/name         Set the session name',
        '/tree         Browse session entries',
        '/fork         Branch from a user message',
        '/clone        Clone the current leaf',
        '/copy         Copy the last response',
        '/settings     Open settings',
        '/hotkeys      Show keyboard commands',
        '/skill        List skills or show one skill',
        '/reload       Reload project instructions and skills',
        '/share        Create a shareable local session artifact',
        '/trust        Choose project trust (or trust|no|parent)',
        '/quit         Exit Adou',
    ]
    self.overlay = new overlay_t(kind = OVERLAY_HELP, title = 'Commands', options = options)
}

// Pi's /skill:name command expands to the skill body wrapped in a skill
// block with its location and relative-path guidance.
// B1-R2-08: only self.cached_skills (the trust-aware snapshot filtered by
// the same settings that built the menu) is consulted — never a fresh
// load_skills on the hot path; /reload and rebind refresh the snapshot.
pub fn view_t.expand_skill_command(&self, string text): string {
    return skills.expand_command(text, self.cached_skills)
}

pub fn view_t.show_skills(&self, string text, [string] parts) {
    // B1-R2-08: the snapshot-filtered skill list only; no fresh load_skills
    // (the menu, execution and this display share the same resources).
    var filtered_skills = self.cached_skills
    if filtered_skills.len() == 0 {
        self.chat.status = 'No skills found in user or project skills directories'
        return
    }
    if parts.len() == 1 {
        [string] lines = []
        for skill in filtered_skills {
            string marker = skill.disable_model_invocation ? ' (manual only)' : ''
            lines.push(skill.name + marker + ' - ' + skill.description)
        }
        self.overlay = new overlay_t(kind = OVERLAY_HELP, title = 'Skills', options = lines)
        return
    }
    string requested = parts[1]
    for skill in filtered_skills {
        if skill.name == requested {
            self.chat.status = skill.name + ' - ' + skill.description + '\n' + skill.file_path + '\n\nUse the read tool to load the skill file when the task matches.'
            return
        }
    }
    self.chat.status = 'Skill not found: ' + requested
}

pub fn view_t.show_hotkeys_overlay(&self) {
    self.overlay = new overlay_t(kind = OVERLAY_HELP, title = 'Keyboard shortcuts', options = hotkeys_options(self.keybindings))
}

// Batch 4: /hotkeys rows derive from the SAME registry that dispatches
// keys, so a user remap changes behavior and this list together (Pi
// /hotkeys, Navigation/Editing/Other grouping).
fn hotkeys_options(ref<keybindings.keybindings_t> registry): [string] {
    [string] options = []
    options.push('Navigation')
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_UP) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_UP))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_DOWN) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_DOWN))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_LEFT) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_LEFT))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_RIGHT) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_RIGHT))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_WORD_LEFT) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_WORD_LEFT))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_WORD_RIGHT) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_WORD_RIGHT))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_LINE_START) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_LINE_START))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_CURSOR_LINE_END) + '  ' + registry.describe(keybindings.EDITOR_CURSOR_LINE_END))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_JUMP_FORWARD) + '  ' + registry.describe(keybindings.EDITOR_JUMP_FORWARD))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_JUMP_BACKWARD) + '  ' + registry.describe(keybindings.EDITOR_JUMP_BACKWARD))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_PAGE_UP) + '  ' + registry.describe(keybindings.EDITOR_PAGE_UP))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_PAGE_DOWN) + '  ' + registry.describe(keybindings.EDITOR_PAGE_DOWN))
    options.push('Editing')
    options.push(keybindings.key_text(registry, keybindings.INPUT_SUBMIT) + '  ' + registry.describe(keybindings.INPUT_SUBMIT))
    options.push(keybindings.key_text(registry, keybindings.INPUT_NEWLINE) + '  ' + registry.describe(keybindings.INPUT_NEWLINE))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_DELETE_CHAR_BACKWARD) + '  ' + registry.describe(keybindings.EDITOR_DELETE_CHAR_BACKWARD))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_DELETE_CHAR_FORWARD) + '  ' + registry.describe(keybindings.EDITOR_DELETE_CHAR_FORWARD))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_DELETE_WORD_BACKWARD) + '  ' + registry.describe(keybindings.EDITOR_DELETE_WORD_BACKWARD))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_DELETE_WORD_FORWARD) + '  ' + registry.describe(keybindings.EDITOR_DELETE_WORD_FORWARD))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_DELETE_TO_LINE_START) + '  ' + registry.describe(keybindings.EDITOR_DELETE_TO_LINE_START))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_DELETE_TO_LINE_END) + '  ' + registry.describe(keybindings.EDITOR_DELETE_TO_LINE_END))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_YANK) + '  ' + registry.describe(keybindings.EDITOR_YANK))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_YANK_POP) + '  ' + registry.describe(keybindings.EDITOR_YANK_POP))
    options.push(keybindings.key_text(registry, keybindings.EDITOR_UNDO) + '  ' + registry.describe(keybindings.EDITOR_UNDO))
    options.push('Other')
    options.push(keybindings.key_text(registry, keybindings.INPUT_TAB) + '  ' + registry.describe(keybindings.INPUT_TAB))
    options.push(keybindings.key_text(registry, keybindings.APP_INTERRUPT) + '  ' + registry.describe(keybindings.APP_INTERRUPT))
    options.push(keybindings.key_text(registry, keybindings.APP_CLEAR) + '  ' + registry.describe(keybindings.APP_CLEAR))
    options.push(keybindings.key_text(registry, keybindings.APP_EXIT) + '  ' + registry.describe(keybindings.APP_EXIT))
    options.push(keybindings.key_text(registry, keybindings.APP_SUSPEND) + '  ' + registry.describe(keybindings.APP_SUSPEND))
    options.push(keybindings.key_text(registry, keybindings.APP_THINKING_CYCLE) + '  ' + registry.describe(keybindings.APP_THINKING_CYCLE))
    options.push(keybindings.key_text(registry, keybindings.APP_MODEL_CYCLE_FORWARD) + '  ' + registry.describe(keybindings.APP_MODEL_CYCLE_FORWARD))
    options.push(keybindings.key_text(registry, keybindings.APP_MODEL_CYCLE_BACKWARD) + '  ' + registry.describe(keybindings.APP_MODEL_CYCLE_BACKWARD))
    options.push(keybindings.key_text(registry, keybindings.APP_MODEL_SELECT) + '  ' + registry.describe(keybindings.APP_MODEL_SELECT))
    options.push(keybindings.key_text(registry, keybindings.APP_TOOLS_EXPAND) + '  ' + registry.describe(keybindings.APP_TOOLS_EXPAND))
    options.push(keybindings.key_text(registry, keybindings.APP_THINKING_TOGGLE) + '  ' + registry.describe(keybindings.APP_THINKING_TOGGLE))
    options.push(keybindings.key_text(registry, keybindings.APP_EDITOR_EXTERNAL) + '  ' + registry.describe(keybindings.APP_EDITOR_EXTERNAL))
    options.push(keybindings.key_text(registry, keybindings.APP_MESSAGE_COPY) + '  ' + registry.describe(keybindings.APP_MESSAGE_COPY))
    options.push(keybindings.key_text(registry, keybindings.APP_MESSAGE_FOLLOW_UP) + '  ' + registry.describe(keybindings.APP_MESSAGE_FOLLOW_UP))
    options.push(keybindings.key_text(registry, keybindings.APP_MESSAGE_DEQUEUE) + '  ' + registry.describe(keybindings.APP_MESSAGE_DEQUEUE))
    options.push(keybindings.key_text(registry, keybindings.APP_CLIPBOARD_PASTE_IMAGE) + '  ' + registry.describe(keybindings.APP_CLIPBOARD_PASTE_IMAGE))
    options.push(keybindings.key_text(registry, keybindings.APP_TREE_FILTER_CYCLE_FORWARD) + '  ' + registry.describe(keybindings.APP_TREE_FILTER_CYCLE_FORWARD))
    options.push(keybindings.key_text(registry, keybindings.APP_TREE_FOLD_OR_UP) + '  ' + registry.describe(keybindings.APP_TREE_FOLD_OR_UP))
    options.push(keybindings.key_text(registry, keybindings.APP_TREE_UNFOLD_OR_DOWN) + '  ' + registry.describe(keybindings.APP_TREE_UNFOLD_OR_DOWN))
    options.push(keybindings.key_text(registry, keybindings.APP_TREE_EDIT_LABEL) + '  ' + registry.describe(keybindings.APP_TREE_EDIT_LABEL))
    options.push('/            Slash commands')
    options.push('!            Run bash command')
    options.push('!!           Run bash command (excluded from context)')
    return options
}

// Pi's compact startup instructions line, resolved from the registry.
fn header_hint_line(ref<keybindings.keybindings_t> registry): string {
    return keybindings.key_text(registry, keybindings.APP_INTERRUPT) + ' interrupt · ' + keybindings.key_text(registry, keybindings.APP_CLEAR) + '/' + keybindings.key_text(registry, keybindings.APP_EXIT) + ' clear/exit · / commands · ! bash · ' + keybindings.key_text(registry, keybindings.APP_TOOLS_EXPAND) + ' more'
}

pub fn view_t.handle_overlay_input(&self, ref<overlay_t> overlay, input_t input) {
    if overlay.kind == OVERLAY_TRUST && !input.paste {
        string key = keys.parse_key(input.data)
        if key == 'up' || key == 'k' {
            if overlay.selected > 0 {overlay.selected -= 1}
            self.redraw()
            return
        }
        if key == 'down' || key == 'j' {
            if overlay.selected + 1 < overlay.options.len() {overlay.selected += 1}
            self.redraw()
            return
        }
        if key == 'enter' {
            self.select_overlay_option(overlay)
            return
        }
        if key == 'escape' || key == 'ctrl+c' {
            if overlay.trust_prompt {
                // Pi's resolveProjectTrusted returns false when the selector
                // is dismissed; cache the resolution for this cwd so a
                // session rebind does not re-open the prompt.
                self.trust_prompted_cwd = overlay.provider
                self.update_untrusted_banner(overlay.provider)
                self.overlay = null
                string marker = path.join(paths.agent_dir(), '.adou-setup')
                if !path_utils.exists(marker) && self.pending_initial_messages.len() == 0 {
                    self.show_setup_overlay()
                    return
                }
            }
            self.overlay = null
            self.redraw()
            return
        }
        return
    }
    if overlay.kind == OVERLAY_CONFIG {
        if input.paste {
            overlay.query += input.data
            overlay.selected = config_move_selection(config_filtered_options(overlay), 0, 1, 1)
            self.redraw()
            return
        }
        string key = keys.parse_key(input.data)
        var options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
        if key == 'escape' || key == 'ctrl+c' {
            if overlay.query != '' {
                overlay.query = ''
                overlay.selected = config_move_selection(overlay.options, 0, 1, 1)
                self.redraw()
                return
            }
            self.overlay = null
            self.suppress_quit_render = true
            self.redraw()
            return
        }
        if key == 'tab' {
            overlay.config_scope = overlay.config_scope == 0 ? 1 : 0
            overlay.options = self.config_resource_options(overlay.config_scope)
            overlay.query = ''
            overlay.selected = config_move_selection(overlay.options, 0, 1, 1)
            self.redraw()
            return
        }
        if key == 'up' || key == 'k' {
            overlay.selected = config_move_selection(options, overlay.selected, -1, 1)
            self.redraw()
            return
        }
        if key == 'down' || key == 'j' {
            overlay.selected = config_move_selection(options, overlay.selected, 1, 1)
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.SELECT_PAGE_UP) {
            overlay.selected = config_move_selection(options, overlay.selected, -1, OVERLAY_VISIBLE_OPTIONS)
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.SELECT_PAGE_DOWN) {
            overlay.selected = config_move_selection(options, overlay.selected, 1, OVERLAY_VISIBLE_OPTIONS)
            self.redraw()
            return
        }
        if key == 'enter' || key == 'space' {
            if overlay.selected >= 0 && overlay.selected < options.len() {
                string option = options[overlay.selected]
                if config_option_is_item(option) {
                    bool is_skill = config_option_is_skill(options, overlay.selected)
                    self.toggle_resource(option, is_skill, overlay.config_scope, overlay.query)
                }
            }
            return
        }
        if key == 'backspace' || key == 'ctrl+h' {
            if overlay.query.len() > 0 {
                overlay.query = overlay.query.slice(0, overlay.query.len() - 1)
                overlay.selected = config_move_selection(config_filtered_options(overlay), 0, 1, 1)
            }
            self.redraw()
            return
        }
        string printable = keys.decode_printable(input.data)
        if printable == '' && input.data != '' && input.data[0] >= 32 && input.data[0] != 0x1b {
            printable = input.data
        }
        if printable != '' {
            overlay.query += printable
            overlay.selected = config_move_selection(config_filtered_options(overlay), 0, 1, 1)
            self.redraw()
        }
        return
    }
    if overlay.kind == OVERLAY_SETUP && !input.paste {
        string key = keys.parse_key(input.data)
        if self.keybindings.matches(key, keybindings.SELECT_UP) || key == 'k' {
            if overlay.selected > 0 {overlay.selected -= 1}
            if overlay.setup_step == 'theme' {
                overlay.setup_theme = overlay.selected == 0 ? 'dark' : 'light'
                self.activate_theme_setting(overlay.setup_theme)
            }
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.SELECT_DOWN) || key == 'j' {
            if overlay.selected + 1 < overlay.options.len() {overlay.selected += 1}
            if overlay.setup_step == 'theme' {
                overlay.setup_theme = overlay.selected == 0 ? 'dark' : 'light'
                self.activate_theme_setting(overlay.setup_theme)
            }
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.SELECT_CONFIRM) || key == 'enter' {
            if overlay.setup_step == 'theme' {
                overlay.setup_step = 'analytics'
                overlay.options = ['Share anonymous usage data', "Don't share"]
                overlay.selected = 0
                self.redraw()
            } else {
                self.complete_setup(overlay)
            }
            return
        }
        if self.keybindings.matches(key, keybindings.SELECT_CANCEL) || key == 'escape' || key == 'ctrl+c' {
            self.activate_theme_setting(self.settings_snapshot.theme)
            self.overlay = null
            self.redraw()
            return
        }
        return
    }
    if overlay.kind == OVERLAY_SETTINGS_SUBMENU && !input.paste {
        string key = keys.parse_key(input.data)
        if key == 'enter' {
            self.handle_settings_submenu(overlay)
            return
        }
        if key == 'escape' || key == 'ctrl+c' {
            self.show_settings_overlay()
            self.redraw()
            return
        }
        if key == 'up' {
            overlay.selected = overlay.selected == 0 ? overlay.options.len() - 1 : overlay.selected - 1
            self.redraw()
            return
        }
        if key == 'down' {
            overlay.selected = overlay.selected == overlay.options.len() - 1 ? 0 : overlay.selected + 1
            self.redraw()
            return
        }
        return
    }
    if overlay.kind == OVERLAY_MODEL {
        self.handle_model_selector_input(overlay, input)
        return
    }
    if overlay.kind == OVERLAY_SETTINGS_WARNINGS && !input.paste {
        string key = keys.parse_key(input.data)
        if key == 'enter' {
            self.handle_warnings_toggle(overlay)
            return
        }
        if key == 'escape' || key == 'ctrl+c' {
            self.show_settings_overlay()
            self.redraw()
        }
        return
    }
    if overlay.kind == OVERLAY_THEME && !input.paste {
        self.handle_theme_input(overlay, keys.parse_key(input.data))
        return
    }
    if overlay.kind == OVERLAY_THEME_AUTO && !input.paste {
        self.handle_theme_auto_input(overlay, keys.parse_key(input.data))
        return
    }
    if overlay.kind == OVERLAY_THEME_SELECT && !input.paste {
        self.handle_theme_select_input(overlay, keys.parse_key(input.data))
        return
    }
    if overlay.kind == OVERLAY_SCOPED_MODELS {
        self.handle_scoped_models_input(overlay, input)
        return
    }
    if input.paste {
        overlay.query += input.data
        overlay.selected = 0
        self.redraw()
        return
    }
    string key = keys.parse_key(input.data)
    if overlay.kind == OVERLAY_SESSION && overlay.confirming_delete {
        if key == 'enter' {
            self.confirm_delete_session(overlay)
        } else if key == 'escape' || key == 'ctrl+c' {
            overlay.confirming_delete = false
            overlay.delete_path = ''
            self.redraw()
        }
        return
    }
    if (key == 'escape' || key == 'ctrl+c') && overlay.query != '' && (overlay.kind == OVERLAY_SESSION || overlay.kind == OVERLAY_TREE || overlay.kind == OVERLAY_FORK || overlay.kind == OVERLAY_PROVIDER || overlay.kind == OVERLAY_LOGOUT) {
        overlay.query = ''
        overlay.selected = 0
        self.redraw()
        return
    }
    if key == 'escape' || key == 'ctrl+c' {
        if overlay.kind == OVERLAY_API_KEY && overlay.auth_method == 'account' {
            self.oauth_lock.lock()
            self.oauth_cancelled = true
            if self.oauth_cancel_state is ref<oauth_cancellation_t> cancel_state {
                cancel_state.cancel()
            }
            self.oauth_generation += 1
            if self.oauth_browser is ref<oauth.browser_auth_t> browser {
                if browser.callback is ref<oauth_callback.callback_server_t> listener {
                    listener.close()
                }
            }
            self.oauth_browser = null
            self.oauth_lock.unlock()
            self.overlay = null
            self.chat.status = 'Account login cancelled'
            self.redraw()
            return
        }
        if overlay.kind == OVERLAY_BRANCH_SUMMARY {
            self.restore_tree_overlay(overlay.provider)
            self.redraw()
            return
        }
        if overlay.kind == OVERLAY_BRANCH_CUSTOM {
            self.show_branch_summary_overlay(overlay.provider)
            self.redraw()
            return
        }
        if overlay.kind == OVERLAY_NAME && overlay.provider != '' {
            self.show_session_overlay()
            self.redraw()
            return
        }
        if self.startup_session_picker {
            self.startup_session_picker = false
            self.overlay = null
            self.quitting = true
            return
        }
        self.overlay = null
        self.redraw()
        return
    }
    if overlay.kind == OVERLAY_SESSION_INFO {
        if key == 'enter' {
            self.overlay = null
            self.redraw()
        }
        return
    }
    if overlay.kind == OVERLAY_SESSION {
        if key == 'tab' {
            overlay.scope = overlay.scope == 0 ? 1 : 0
            overlay.selected = 0
            overlay.title = overlay.scope == 0 ? 'Resume Session (Current Folder)' : 'Resume Session (All)'
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_SESSION_TOGGLE_PATH) {
            overlay.show_paths = !overlay.show_paths
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_SESSION_TOGGLE_SORT) {
            // Pi cycles recent → relevance → threaded.  Re-normalize the
            // backing list before each mode so changing modes never leaves an
            // earlier ordering baked into the next search.
            overlay.sort_mode = (overlay.sort_mode + 1) % 3
            overlay.options = sort_session_paths(overlay.options)
            overlay.selected = 0
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_SESSION_TOGGLE_NAMED_FILTER) {
            overlay.named_only = !overlay.named_only
            overlay.selected = 0
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_SESSION_DELETE) || (self.keybindings.matches(key, keybindings.APP_SESSION_DELETE_NONINVASIVE) && overlay.query == '') {
            self.begin_delete_session(overlay)
            return
        }
        if self.keybindings.matches(key, keybindings.APP_SESSION_RENAME) {
            self.begin_rename_session(overlay)
            return
        }
        if self.keybindings.matches(key, keybindings.SELECT_PAGE_UP) {
            int count = filtered_options(self.runner.repository.session_dir, overlay, self.runner).len()
            overlay.selected -= OVERLAY_VISIBLE_OPTIONS
            if overlay.selected < 0 {overlay.selected = 0}
            if count > 0 && overlay.selected >= count {overlay.selected = count - 1}
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.SELECT_PAGE_DOWN) {
            int count = filtered_options(self.runner.repository.session_dir, overlay, self.runner).len()
            overlay.selected += OVERLAY_VISIBLE_OPTIONS
            if count > 0 && overlay.selected >= count {overlay.selected = count - 1}
            self.redraw()
            return
        }
    }
    if overlay.kind == OVERLAY_TREE {
        if self.keybindings.matches(key, keybindings.SELECT_PAGE_UP) || self.keybindings.matches(key, keybindings.SELECT_PAGE_DOWN) {
            var page_options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
            int direction = self.keybindings.matches(key, keybindings.SELECT_PAGE_UP) ? -1 : 1
            overlay.selected += direction * OVERLAY_VISIBLE_OPTIONS
            if overlay.selected < 0 {overlay.selected = 0}
            if page_options.len() > 0 && overlay.selected >= page_options.len() {overlay.selected = page_options.len() - 1}
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_MESSAGE_COPY) {
            var copy_options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
            if copy_options.len() > 0 && overlay.selected >= 0 && overlay.selected < copy_options.len() {
                string entry_id = option_entry_id(copy_options[overlay.selected])
                string copied = session_search.entry_content_preview(self.runner.repository, entry_id)
                if copied == '' {copied = copy_options[overlay.selected]}
                self.copy_overlay_text(copied, 'Copied tree entry to clipboard')
            }
            return
        }
        // Pi's seven tree filter actions: five direct modes plus the
        // forward/backward cycles.
        int filter_target = -1
        if self.keybindings.matches(key, keybindings.APP_TREE_FILTER_DEFAULT) {
            filter_target = 0
        } else if self.keybindings.matches(key, keybindings.APP_TREE_FILTER_NO_TOOLS) {
            filter_target = 1
        } else if self.keybindings.matches(key, keybindings.APP_TREE_FILTER_USER_ONLY) {
            filter_target = 2
        } else if self.keybindings.matches(key, keybindings.APP_TREE_FILTER_LABELED_ONLY) {
            filter_target = 3
        } else if self.keybindings.matches(key, keybindings.APP_TREE_FILTER_ALL) {
            filter_target = 4
        } else if self.keybindings.matches(key, keybindings.APP_TREE_FILTER_CYCLE_FORWARD) {
            filter_target = (overlay.tree_filter + 1) % 5
        } else if self.keybindings.matches(key, keybindings.APP_TREE_FILTER_CYCLE_BACKWARD) {
            filter_target = (overlay.tree_filter + 4) % 5
        }
        if filter_target >= 0 {
            overlay.tree_filter = filter_target
            overlay.selected = 0
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_TREE_FOLD_OR_UP) {
            var options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
            if options.len() > 0 && overlay.selected < options.len() {
                string target_id = option_entry_id(options[overlay.selected])
                if tree_has_children(self.runner.repository, target_id) {
                    if !list_in(overlay.collapsed_ids, target_id) {
                        overlay.collapsed_ids.push(target_id)
                    }
                } else if overlay.selected > 0 {
                    overlay.selected -= 1
                }
            }
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_TREE_UNFOLD_OR_DOWN) {
            var options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
            if options.len() > 0 && overlay.selected < options.len() {
                string expanded_id = option_entry_id(options[overlay.selected])
                bool removed = false
                [string] remaining = []
                for collapsed in overlay.collapsed_ids {
                    if collapsed != expanded_id {
                        remaining.push(collapsed)
                    } else {
                        removed = true
                    }
                }
                overlay.collapsed_ids = remaining
                if !removed && overlay.selected + 1 < options.len() {
                    overlay.selected += 1
                }
            }
            self.redraw()
            return
        }
    }
    if overlay.kind == OVERLAY_TREE && self.keybindings.matches(key, keybindings.APP_TREE_TOGGLE_LABEL_TIMESTAMP) {
        // Pi toggles relative timestamps next to tree labels; the row set
        // rebuilds while the selection, collapse set and filter stay.
        int selected = overlay.selected
        int filter = overlay.tree_filter
        [string] collapsed = []
        for entry in overlay.collapsed_ids {
            collapsed.push(entry)
        }
        overlay.label_timestamps = !overlay.label_timestamps
        overlay.options = tree_rows(self.runner, overlay.label_timestamps)
        overlay.selected = selected
        overlay.tree_filter = filter
        overlay.collapsed_ids = collapsed
        self.redraw()
        return
    }
    if overlay.kind == OVERLAY_FORK {
        if self.keybindings.matches(key, keybindings.SELECT_PAGE_UP) || self.keybindings.matches(key, keybindings.SELECT_PAGE_DOWN) {
            var page_options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
            int direction = self.keybindings.matches(key, keybindings.SELECT_PAGE_UP) ? -1 : 1
            overlay.selected += direction * OVERLAY_VISIBLE_OPTIONS
            if overlay.selected < 0 {overlay.selected = 0}
            if page_options.len() > 0 && overlay.selected >= page_options.len() {overlay.selected = page_options.len() - 1}
            self.redraw()
            return
        }
        if self.keybindings.matches(key, keybindings.APP_MESSAGE_COPY) {
            var copy_options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
            if copy_options.len() > 0 && overlay.selected >= 0 && overlay.selected < copy_options.len() {
                string entry_id = option_entry_id(copy_options[overlay.selected])
                self.copy_overlay_text(self.fork_message_text(entry_id), 'Copied fork message to clipboard')
            }
            return
        }
    }
    if overlay.kind == OVERLAY_TREE && self.keybindings.matches(key, keybindings.APP_TREE_EDIT_LABEL) {
        var options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
        if options.len() > 0 && overlay.selected >= 0 && overlay.selected < options.len() {
            string entry_id = option_entry_id(options[overlay.selected])
            overlay.kind = OVERLAY_LABEL
            overlay.title = 'Label (empty to remove):'
            overlay.provider = entry_id
            overlay.options = []
            overlay.query = self.runner.repository.get_label(entry_id)
            overlay.selected = 0
        }
        self.redraw()
        return
    }
    if overlay.kind == OVERLAY_API_KEY || overlay.kind == OVERLAY_NAME || overlay.kind == OVERLAY_LABEL || overlay.kind == OVERLAY_BRANCH_CUSTOM {
        if key == 'enter' {
            if overlay.kind == OVERLAY_NAME {
                if overlay.provider != '' {
                    self.rename_session(overlay.provider, overlay.query)
                } else {
                    self.set_session_name(overlay.query)
                }
            } else if overlay.kind == OVERLAY_LABEL {
                self.complete_label(overlay)
            } else if overlay.kind == OVERLAY_BRANCH_CUSTOM {
                self.start_tree_summary(overlay.provider, overlay.query)
            } else {
                self.complete_api_key_login(overlay)
            }
            return
        }
        if key == 'backspace' || key == 'ctrl+h' {
            if overlay.query.len() > 0 {
                overlay.query = overlay.query.slice(0, overlay.query.len() - 1)
            }
            self.redraw()
            return
        }
        string printable = keys.decode_printable(input.data)
        if printable == '' && input.data != '' && input.data[0] >= 32 && input.data[0] != 0x1b {
            printable = input.data
        }
        if printable != '' {
            overlay.query += printable
            self.redraw()
        }
        return
    }
    if key == 'up' {
        int count = filtered_options(self.runner.repository.session_dir, overlay, self.runner).len()
        if count == 0 {return}
        overlay.selected = overlay.selected == 0 ? count - 1 : overlay.selected - 1
        self.redraw()
        return
    }
    if key == 'down' {
        int count = filtered_options(self.runner.repository.session_dir, overlay, self.runner).len()
        if count == 0 {return}
        overlay.selected = overlay.selected == count - 1 ? 0 : overlay.selected + 1
        self.redraw()
        return
    }
    if key == 'backspace' || key == 'ctrl+h' {
        if overlay.query.len() > 0 {
            overlay.query = overlay.query.slice(0, overlay.query.len() - 1)
            overlay.selected = 0
        }
        self.redraw()
        return
    }
    if key == 'enter' {
        self.select_overlay_option(overlay)
        return
    }
    string printable = keys.decode_printable(input.data)
    if printable == '' && input.data != '' && input.data[0] >= 32 && input.data[0] != 0x1b {
        printable = input.data
    }
    if printable != '' {
        overlay.query += printable
        overlay.selected = 0
        self.redraw()
    }
}

fn view_t.handle_model_selector_input(&self, ref<overlay_t> overlay, input_t input) {
    if !(overlay.model_state is ref<model_selector.state_t>) {return}
    var state = overlay.model_state as ref<model_selector.state_t>
    if input.paste {
        state.append_query(input.data)
        self.redraw()
        return
    }
    string key = keys.parse_key(input.data)
    if key == 'tab' {
        state.toggle_scope()
        self.redraw()
        return
    }
    if key == 'up' || key == 'down' {
        state.move(key == 'up' ? -1 : 1)
        self.redraw()
        return
    }
    if key == 'enter' {
        self.select_model_reference(state.selected_reference())
        return
    }
    if key == 'escape' || key == 'ctrl+c' {
        self.model_refresh_generation += 1
        self.overlay = null
        self.redraw()
        return
    }
    if key == 'backspace' || key == 'ctrl+h' {
        state.backspace()
        self.redraw()
        return
    }
    string printable = keys.decode_printable(input.data)
    if printable == '' && input.data != '' && input.data[0] >= 32 && input.data[0] != 0x1b {
        printable = input.data
    }
    if printable != '' {
        state.append_query(printable)
        self.redraw()
    }
}

fn view_t.select_model_reference(&self, string reference) {
    if reference == '' {return}
    ref<ai_types.model_t>? model = models.find(reference)
    if !(model is ref<ai_types.model_t>) {return}
    var next_model = model as ref<ai_types.model_t>
    self.runner.set_model(next_model) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.apply_scoped_thinking(next_model)
    self.chat.model = next_model.id
    self.chat.configure(next_model.context_window, self.chat.thinking)
    self.save_default_model()
    self.chat.status = 'Model: ' + reference
    self.chat.error_message = ''
    self.model_refresh_generation += 1
    self.overlay = null
    self.redraw()
}

fn view_t.handle_scoped_models_input(&self, ref<overlay_t> overlay, input_t input) {
    if !(overlay.scoped_models_state is ref<scoped_models.state_t>) {return}
    var state = overlay.scoped_models_state as ref<scoped_models.state_t>
    if input.paste {
        state.append_query(input.data)
        self.redraw()
        return
    }
    string key = keys.parse_key(input.data)
    bool changed = false
    if self.keybindings.matches(key, keybindings.SELECT_UP) || self.keybindings.matches(key, keybindings.SELECT_DOWN) {
        state.move_selection(self.keybindings.matches(key, keybindings.SELECT_UP) ? -1 : 1)
        self.redraw()
        return
    } else if self.keybindings.matches(key, keybindings.SELECT_CONFIRM) {
        state.toggle_selected()
        changed = true
    } else if self.keybindings.matches(key, keybindings.APP_MODELS_ENABLE_ALL) {
        state.enable_all()
        changed = true
    } else if self.keybindings.matches(key, keybindings.APP_MODELS_CLEAR_ALL) {
        state.clear_all()
        changed = true
    } else if self.keybindings.matches(key, keybindings.APP_MODELS_TOGGLE_PROVIDER) {
        state.toggle_selected_provider()
        changed = true
    } else if self.keybindings.matches(key, keybindings.APP_MODELS_REORDER_UP) || self.keybindings.matches(key, keybindings.APP_MODELS_REORDER_DOWN) {
        state.reorder_selected(self.keybindings.matches(key, keybindings.APP_MODELS_REORDER_UP) ? -1 : 1)
        changed = true
    } else if self.keybindings.matches(key, keybindings.APP_MODELS_SAVE) {
        config_settings.set_enabled_models(state.enabled_ids, !state.all_enabled) catch error {
            self.chat.error_message = 'Could not save model selection: ' + error.msg()
            self.redraw()
            return
        }
        self.settings_snapshot.enabled_model_ids = state.enabled_ids
        self.settings_snapshot.enabled_models_configured = !state.all_enabled
        state.dirty = false
        self.scoped_models_dirty = false
        self.chat.status = 'Model selection saved to settings'
        self.redraw()
        return
    } else if key == 'ctrl+c' {
        if state.query != '' {
            state.set_query('')
        } else {
            self.overlay = null
        }
        self.redraw()
        return
    } else if key == 'escape' {
        self.overlay = null
        self.redraw()
        return
    } else if key == 'backspace' || key == 'ctrl+h' {
        state.backspace()
        self.redraw()
        return
    } else {
        string printable = keys.decode_printable(input.data)
        if printable == '' && input.data != '' && input.data[0] >= 32 && input.data[0] != 0x1b {
            printable = input.data
        }
        if printable != '' {
            state.append_query(printable)
            self.redraw()
        }
        return
    }
    if changed {
        self.apply_scoped_models_state(state)
        self.chat.status = 'Model scope changed (Ctrl+S to save)'
        self.redraw()
    }
}

fn view_t.apply_scoped_models_state(&self, ref<scoped_models.state_t> state) {
    self.model_scope_explicit = false
    self.scoped_models_dirty = true
    self.scoped_models_active = !state.all_enabled
    self.scoped_model_ids = []
    for id in state.enabled_ids {
        self.scoped_model_ids.push(id)
    }
    self.model_scope_patterns = []
    int enabled_available = state.enabled_available_count()
    if !state.all_enabled && enabled_available > 0 && enabled_available < state.catalog.len() {
        for id in state.enabled_ids {
            self.model_scope_patterns.push(id)
        }
    }
    self.refresh_model_argument_cache()
}

fn view_t.begin_delete_session(&self, ref<overlay_t> overlay) {
    var options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
    if options.len() == 0 || overlay.selected < 0 || overlay.selected >= options.len() {
        return
    }
    string target = options[overlay.selected]
    string current = self.runner.repository.get_session_file()
    if current != '' && path_utils.resolve_to_cwd(target, self.runner.repository.cwd) == path_utils.resolve_to_cwd(current, self.runner.repository.cwd) {
        self.chat.status = 'Cannot delete the currently active session'
        self.redraw()
        return
    }
    overlay.confirming_delete = true
    overlay.delete_path = target
    self.redraw()
}

fn view_t.confirm_delete_session(&self, ref<overlay_t> overlay) {
    string target = overlay.delete_path
    if target == '' {
        overlay.confirming_delete = false
        self.redraw()
        return
    }
    // Pi tries the `trash` CLI first and falls back to a permanent unlink;
    // the status message reflects which method actually ran.
    var result = session_actions.delete_session_file(target, self.runner.repository.cwd)
    if !result[0] {
        overlay.confirming_delete = false
        overlay.delete_path = ''
        self.chat.error_message = result[1]
        self.redraw()
        return
    }
    string message = result[1]
    [string] remaining = vec<string>.cap_of(overlay.options.len())
    for option in overlay.options {
        if option != target {remaining.push(option)}
    }
    overlay.options = remaining
    overlay.confirming_delete = false
    overlay.delete_path = ''
    overlay.selected = 0
    self.chat.status = message
    if overlay.options.len() == 0 {
        self.overlay = null
        if self.startup_session_picker {
            self.startup_session_picker = false
            self.quitting = true
        }
    }
    self.redraw()
}

fn view_t.begin_rename_session(&self, ref<overlay_t> overlay) {
    var options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
    if options.len() == 0 || overlay.selected < 0 || overlay.selected >= options.len() {
        return
    }
    string target = options[overlay.selected]
    var selected = repository.open(target) catch error {
        self.chat.error_message = 'Could not open session: ' + error.msg()
        self.redraw()
        return
    }
    string name = selected.get_session_name() catch error {''}
    self.overlay = new overlay_t(kind = OVERLAY_NAME, title = 'Rename session:', provider = target, query = name)
    self.redraw()
}

fn view_t.rename_session(&self, string file_path, string name) {
    string value = name.trim([' ', '\t', '\n', '\r'])
    if value == '' {
        self.chat.error_message = 'Session name cannot be empty'
        self.redraw()
        return
    }
    var selected = repository.open(file_path) catch error {
        self.chat.error_message = 'Could not open session: ' + error.msg()
        self.redraw()
        return
    }
    selected.append_session_info(value) catch error {
        self.chat.error_message = 'Could not rename session: ' + error.msg()
        self.redraw()
        return
    }
    self.chat.status = 'Renamed session to ' + value
    self.show_session_overlay()
    self.redraw()
}

pub fn view_t.complete_label(&self, ref<overlay_t> overlay) {
    string entry_id = overlay.provider
    self.runner.repository.append_label_change(entry_id, overlay.query) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    string value = overlay.query.trim([' ', '\t', '\n', '\r'])
    self.chat.status = value == '' ? 'Label removed' : 'Label saved'
    self.show_tree_overlay()
    if self.overlay is ref<overlay_t> tree {
        for index, option in tree.options {
            if option_entry_id(option) == entry_id {
                tree.selected = index
                break
            }
        }
    }
    self.redraw()
}

pub fn view_t.complete_api_key_login(&self, ref<overlay_t> overlay) {
    if overlay.oauth_device_code != '' {
        if overlay.auth_method == 'account' && overlay.oauth_method == 'device_code' {
            self.chat.status = 'Waiting for account authorization...'
            self.redraw()
            return
        }
        var device = oauth.device_auth_t {device_code: overlay.oauth_device_code, user_code: overlay.oauth_device_user_code, verification_uri: overlay.oauth_device_uri, interval_seconds: overlay.oauth_device_interval, expires_seconds: overlay.oauth_device_expires,}
        var token = oauth.poll_device(overlay.provider, device) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        oauth.save_token(overlay.provider, token) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.runner.refresh_auth() catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.chat.error_message = ''
        self.chat.status = 'Signed in with an account for ' + overlay.provider
        refresh_auth_provider_count(self)
        self.refresh_model_argument_cache()
        self.overlay = null
        self.redraw()
        return
    }
    if overlay.oauth_verifier != '' {
        if overlay.auth_method == 'account' && overlay.oauth_method == 'browser' {
            ref<oauth.browser_auth_t>? attempt = null
            self.oauth_lock.lock()
            if self.oauth_browser is ref<oauth.browser_auth_t> browser {
                attempt = browser
                if browser.callback is ref<oauth_callback.callback_server_t> listener {
                    listener.close()
                }
            }
            self.oauth_cancelled = true
            if self.oauth_cancel_state is ref<oauth_cancellation_t> cancel_state {
                cancel_state.cancel()
            }
            self.oauth_browser = null
            self.oauth_generation += 1
            int generation = self.oauth_generation
            self.oauth_lock.unlock()
            if attempt is ref<oauth.browser_auth_t> browser_attempt {
                self.chat.status = 'Exchanging OAuth callback...'
                go oauth_manual_exchange_worker(self, overlay.provider, generation, browser_attempt, overlay.query)
                self.redraw()
                return
            }
            self.chat.error_message = 'OAuth login is still starting; try again when the callback URL appears.'
            self.redraw()
            return
        }
        string code = oauth.authorization_code(overlay.query, overlay.oauth_state) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        var token = oauth.exchange(overlay.provider, code, overlay.oauth_verifier, overlay.oauth_state) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.oauth_lock.lock()
        if self.oauth_browser is ref<oauth.browser_auth_t> browser {
            if browser.callback is ref<oauth_callback.callback_server_t> listener {
                listener.close()
            }
        }
        self.oauth_cancelled = true
        if self.oauth_cancel_state is ref<oauth_cancellation_t> cancel_state {
            cancel_state.cancel()
        }
        self.oauth_browser = null
        self.oauth_lock.unlock()
        oauth.save_token(overlay.provider, token) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.runner.refresh_auth() catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.chat.error_message = ''
        self.chat.status = 'Signed in with an account for ' + overlay.provider
        refresh_auth_provider_count(self)
        self.refresh_model_argument_cache()
        self.overlay = null
        self.redraw()
        return
    }
    string key = overlay.query
    if key == '' {
        key = auth.effective(overlay.provider)
    }
    if key == '' {
        self.chat.error_message = 'API key is required. Set ' + env_name(overlay.provider) + ' or type it here.'
        self.redraw()
        return
    }
    auth.save(overlay.provider, key) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.runner.refresh_auth() catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.chat.error_message = ''
    self.chat.status = 'Saved API key for ' + overlay.provider
    refresh_auth_provider_count(self)
    self.refresh_model_argument_cache()
    self.overlay = null
    self.redraw()
}

pub fn view_t.begin_oauth_login(&self, string provider) {
    [string] methods = oauth.login_methods(provider)
    string method = methods.len() > 0 ? methods[0] : 'browser'
    self.begin_oauth_login_method(provider, method)
}

pub fn view_t.begin_oauth_login_method(&self, string provider, string method) {
    var cancel_state = new oauth_cancellation_t()
    self.oauth_lock.lock()
    self.oauth_generation += 1
    int generation = self.oauth_generation
    self.oauth_cancelled = false
    self.oauth_browser = null
    self.oauth_cancel_state = cancel_state
    self.oauth_lock.unlock()
    self.overlay = new overlay_t(kind = OVERLAY_API_KEY, title = 'Starting account login for ' + provider + '...', provider = provider, auth_method = 'account', oauth_method = method)
    self.chat.error_message = ''
    self.chat.status = 'Starting ' + method + ' login for ' + provider + '...'
    go oauth_login_worker(self, provider, generation, method, cancel_state)
    self.redraw()
}

pub fn view_t.select_overlay_option(&self, ref<overlay_t> overlay) {
    var options = filtered_options(self.runner.repository.session_dir, overlay, self.runner)
    if overlay.kind == OVERLAY_TRUST {
        self.apply_trust_option(overlay)
        return
    }
    if overlay.kind == OVERLAY_AUTH_METHOD {
        string selected_method = overlay.options.len() > 0 && overlay.selected < overlay.options.len() ? overlay.options[overlay.selected] : ''
        string method = selected_method.contains('account') ? 'account' : 'api_key'
        overlay.auth_method = method
        if overlay.provider == '' {
            overlay.kind = OVERLAY_PROVIDER
            overlay.title = 'Select provider:'
            overlay.options = method == 'account' ? oauth_login_provider_options() : login_provider_options()
            overlay.provider = method
            overlay.query = ''
            overlay.selected = 0
            self.redraw()
            return
        }
        if method == 'account' {
            [string] methods = oauth.login_methods(overlay.provider)
            if methods.len() > 1 {
                overlay.kind = OVERLAY_OAUTH_METHOD
                overlay.title = 'Choose account login method for ' + overlay.provider + ':'
                overlay.options = methods
                overlay.selected = 0
                self.redraw()
            } else {
                self.begin_oauth_login(overlay.provider)
            }
        } else {
            overlay.kind = OVERLAY_API_KEY
            overlay.title = 'Login to ' + overlay.provider
            overlay.options = []
            overlay.query = ''
            overlay.selected = 0
            self.redraw()
        }
        return
    }
    if overlay.kind == OVERLAY_PROVIDER {
        if options.len() == 0 || overlay.selected < 0 || overlay.selected >= options.len() {
            return
        }
        string provider = provider_id_from_option(options[overlay.selected])
        if overlay.provider == 'account' {
            [string] methods = oauth.login_methods(provider)
            if methods.len() > 1 {
                overlay.kind = OVERLAY_OAUTH_METHOD
                overlay.title = 'Choose account login method for ' + provider + ':'
                overlay.provider = provider
                overlay.options = methods
                overlay.selected = 0
                self.redraw()
            } else {
                self.begin_oauth_login(provider)
            }
            return
        }
        overlay.kind = OVERLAY_API_KEY
        overlay.title = 'Login to ' + provider
        overlay.provider = provider
        overlay.options = []
        overlay.query = ''
        overlay.selected = 0
        self.redraw()
        return
    }
    if overlay.kind == OVERLAY_OAUTH_METHOD {
        if overlay.options.len() == 0 || overlay.selected < 0 || overlay.selected >= overlay.options.len() {
            return
        }
        self.begin_oauth_login_method(overlay.provider, overlay.options[overlay.selected])
        return
    }
    if options.len() == 0 || overlay.selected < 0 || overlay.selected >= options.len() {
        return
    }
    string selected = options[overlay.selected]
    if overlay.kind == OVERLAY_SESSION {
        self.open_session(selected)
        return
    }
    if overlay.kind == OVERLAY_TREE {
        string entry_id = selected
        int separator = selected.find(' ')
        if separator >= 0 {
            entry_id = selected.slice(0, separator)
        }
        if entry_id == self.runner.repository.get_leaf_id() {
            self.chat.status = 'Already at this point'
            self.overlay = null
            self.redraw()
            return
        }
        self.show_branch_summary_overlay(entry_id)
        self.redraw()
        return
    }
    if overlay.kind == OVERLAY_BRANCH_SUMMARY {
        string entry_id = overlay.provider
        if selected == 'No summary' {
            self.complete_tree_navigation(entry_id)
        } else if selected == 'Summarize' {
            self.start_tree_summary(entry_id, '')
        } else {
            self.overlay = new overlay_t(kind = OVERLAY_BRANCH_CUSTOM, title = 'Custom summarization instructions', provider = entry_id)
            self.redraw()
        }
        return
    }
    if overlay.kind == OVERLAY_FORK {
        string entry_id = selected
        int separator = selected.find(' ')
        if separator >= 0 {
            entry_id = selected.slice(0, separator)
        }
        string selected_text = self.fork_message_text(entry_id)
        self.runner.fork_session(entry_id) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.reload_chat_messages(self.runner.active_messages)
        self.editor.set_text(selected_text)
        self.chat.status = 'Forked to new session'
        self.overlay = null
        self.redraw()
        return
    }
    if overlay.kind == OVERLAY_LOGOUT {
        string provider = provider_id_from_option(selected)
        auth.remove(provider) catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.runner.refresh_auth() catch error {
            self.chat.error_message = error.msg()
            self.redraw()
            return
        }
        self.chat.status = 'Removed stored credential for ' + provider
        refresh_auth_provider_count(self)
        self.refresh_model_argument_cache()
        self.overlay = null
        self.redraw()
        return
    }
    if overlay.kind == OVERLAY_SETTINGS {
        string selected_option = options.len() > 0 && overlay.selected < options.len() ? options[overlay.selected] : ''
        self.handle_settings_option(overlay, selected_option)
        return
    }
    if overlay.kind == OVERLAY_SETTINGS_WARNINGS {
        self.handle_warnings_toggle(overlay)
        return
    }
    if overlay.kind == OVERLAY_THEME {
        self.apply_theme_option(overlay)
        return
    }
    if overlay.kind == OVERLAY_THEME_AUTO {
        // Enter on the pair rows opens a select; Apply and Change mode are
        // handled here for the enter path while handle_overlay_input owns
        // the up/down navigation.
        if overlay.selected == 0 || overlay.selected == 1 {
            self.show_theme_select_overlay(overlay, overlay.selected == 0 ? 'light' : 'dark')
        } else if overlay.selected == 2 {
            var s = self.settings_snapshot
            s.theme = overlay.theme_light + '/' + overlay.theme_dark
            self.settings_snapshot = s
            self.save_preferences()
            self.activate_theme_setting(s.theme)
            self.show_settings_overlay()
            self.redraw()
        } else {
            self.show_theme_overlay(overlay)
        }
        return
    }
    if overlay.kind == OVERLAY_THEME_SELECT {
        string name = overlay.options[overlay.selected]
        if overlay.theme_select_target == 'light' {
            overlay.theme_light = name
        } else {
            overlay.theme_dark = name
        }
        self.show_theme_auto_overlay(overlay)
        return
    }
    if overlay.kind == OVERLAY_HELP {
        self.overlay = null
        self.redraw()
    }
}

pub fn view_t.complete_tree_navigation(&self, string entry_id) {
    string editor_text = self.runner.navigate_tree(entry_id) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.reload_chat_messages(self.runner.active_messages)
    if editor_text != '' && self.editor.get_text().trim([' ', '\t', '\n', '\r']) == '' {
        self.editor.set_text(editor_text)
    }
    self.chat.status = 'Navigated to selected point'
    self.chat.error_message = ''
    self.overlay = null
    self.redraw()
}

pub fn view_t.start_tree_summary(&self, string entry_id, string instructions) {
    var target = self.runner.inspect_tree_target(entry_id) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    ref<session_stream.stream_t> stream = self.runner.navigate_tree_with_summary(entry_id, instructions) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.pending_tree_navigation = true
    self.pending_tree_editor_text = target.editor_text
    self.pending_tree_target_id = entry_id
    self.overlay = null
    self.active_stream = stream
    self.redraw()
}

pub fn view_t.toggle_thinking(&self) {
    string next = self.chat.thinking == 'off' ? 'medium' : 'off'
    self.runner.set_thinking_level(next) catch error {
        self.chat.error_message = error.msg()
        return
    }
    self.chat.thinking = next
    self.chat.status = next == 'off' ? 'Thinking disabled' : 'Thinking set to ' + next
    self.save_preferences()
}

pub fn view_t.cycle_thinking_level(&self) {
    if !self.runner.agent_config.model.reasoning {
        self.chat.status = 'Current model does not support thinking'
        self.redraw()
        return
    }
    [string] levels = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']
    int current = 0
    for index, level in levels {
        if level == self.chat.thinking {current = index; break}
    }
    string next = levels[(current + 1) % levels.len()]
    self.runner.set_thinking_level(next) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    // set_thinking_level clamps a requested level to the active model's
    // capabilities.  Reflect the effective value in the editor/footer rather
    // than the requested value (important when a model has no reasoning).
    string effective = self.runner.agent_config.stream_options.thinking_enabled ? self.runner.agent_config.stream_options.reasoning_effort : 'off'
    self.chat.thinking = effective
    self.chat.status = 'Thinking level: ' + effective
    self.chat.error_message = ''
    self.save_preferences()
    self.redraw()
}

pub fn view_t.cycle_model(&self, int direction) {
    var available = self.available_cycle_models()
    if available.len() == 0 {
        self.chat.status = 'No authenticated model available'
        self.redraw()
        return
    }
    if available.len() < 2 {
        self.chat.status = 'Only one model available'
        self.redraw()
        return
    }
    int current = 0
    for index, model in available {
        if model.provider == self.runner.agent_config.model.provider && model.id == self.runner.agent_config.model.id {
            current = index
            break
        }
    }
    int next_index = (current + direction + available.len()) % available.len()
    var next = available[next_index]
    self.runner.set_model(next) catch error {
        self.chat.error_message = error.msg()
        self.redraw()
        return
    }
    self.apply_scoped_thinking(next)
    self.chat.model = next.id
    self.chat.configure(next.context_window, self.chat.thinking)
    self.save_default_model()
    self.chat.status = 'Switched to ' + next.id + (next.reasoning && self.chat.thinking != 'off' ? ' (thinking: ' + self.chat.thinking + ')' : '')
    self.chat.error_message = ''
    self.redraw()
}

fn view_t.apply_scoped_thinking(&self, ref<ai_types.model_t> model) {
    string level = models.thinking_for(model.provider + '/' + model.id, self.model_scope_patterns)
    if level == '' {
        return
    }
    self.runner.set_thinking_level(level) catch error {
        self.chat.error_message = error.msg()
        return
    }
    self.chat.thinking = self.runner.agent_config.stream_options.thinking_enabled ? self.runner.agent_config.stream_options.reasoning_effort : 'off'
}

pub fn view_t.restore_queued_messages(&self) {
    var queued = self.runner.restore_queued_messages()
    [string] texts = []
    for message in queued {
        if message is ref<ai_types.user_message_t> user {
            texts.push(user.content)
        } else if message is ref<ai_types.custom_message_t> custom {
            texts.push(custom.content)
        }
    }
    if texts.len() == 0 {
        self.chat.status = 'No queued messages to restore'
        self.redraw()
        return
    }
    string restored = strings.join(texts, '\n')
    string existing = self.editor.get_text()
    self.editor.set_text(restored + (existing == '' ? '' : '\n' + existing))
    self.chat.status = fmt.sprintf('Restored %d queued message%s to editor', texts.len(), texts.len() == 1 ? '' : 's')
    self.redraw()
}

pub fn view_t.save_preferences(&self) {
    // Persist from the trust-aware snapshot so every Batch 3 settings key
    // survives; only the session-mutable fields are overlaid from runtime
    // state.
    var preferences = self.settings_snapshot
    preferences.default_thinking_level = self.chat.thinking
    preferences.auto_compaction = self.runner.compaction_settings.enabled
    preferences.steering_mode = self.runner.agent_config.queues.steering_mode
    preferences.follow_up_mode = self.runner.agent_config.queues.follow_up_mode
    preferences.hide_thinking = !self.chat.thinking_visible
    preferences.retry_enabled = self.runner.retry_enabled
    preferences.enabled_model_ids = self.scoped_model_ids
    preferences.enabled_models_configured = self.scoped_models_active
    config_settings.save(preferences) catch error {
        self.chat.error_message = 'Could not save settings: ' + error.msg()
    }
}

fn view_t.save_default_model(&self) {
    var preferences = config_settings.load()
    preferences.default_provider = self.runner.agent_config.model.provider
    preferences.default_model = self.runner.agent_config.model.id
    config_settings.save(preferences) catch error {
        self.chat.error_message = 'Could not save model preference: ' + error.msg()
    }
}

fn view_t.copy_overlay_text(&self, string text, string status) {
    if text == '' {
        self.chat.status = 'Nothing to copy'
        self.redraw()
        return
    }
    string encoded = base64.encode(text as [u8]) as string
    string clipboard_output = '\x1b]52;c;' + encoded + '\x07'
    self.render_lock.lock()
    self.terminal.write(clipboard_output) catch error {
        self.render_lock.unlock()
        self.chat.error_message = 'Clipboard copy failed: ' + error.msg()
        self.redraw()
        return
    }
    self.render_lock.unlock()
    debug.log_terminal_output(clipboard_output)
    self.chat.status = status
    self.redraw()
}

fn view_t.paste_clipboard(&self) {
    var image = clipboard_image.read()
    if image is clipboard_image.clipboard_image_t captured {
        self.autocomplete.cancel()
        self.editor.insert_text(captured.path)
        self.chat.status = 'Pasted clipboard image'
        self.redraw()
        return
    }
    string text = clipboard_image.read_text()
    if text != '' {
        self.autocomplete.cancel()
        self.editor.handle_paste(text)
        self.chat.status = 'Pasted clipboard text'
    } else {
        self.chat.status = 'Clipboard has no image or text'
    }
    self.redraw()
}

pub fn view_t.copy_last_response(&self) {
    string text = ''
    for int index = self.chat.messages.len() - 1; index >= 0; index -= 1 {
        if self.chat.messages[index] is ref<ai_types.assistant_message_t> assistant {
            for block in assistant.content {
                if block is ref<ai_types.text_content_t> content {
                    if text != '' {text += '\n'}
                    text += content.text
                }
            }
            break
        }
    }
    if text == '' {
        self.chat.status = 'No assistant response to copy'
        self.redraw()
        return
    }
    self.copy_overlay_text(text, 'Copied last assistant response to clipboard')
}

fn render_model_selector(ref<overlay_t> overlay, ref<model_selector.state_t> state, int width): [string]! {
    [string] result = []
    result.push(theme.border_line(width))
    result.push('')
    result.push(' ' + theme.bold(theme.fg(theme.accent(), overlay.title)))
    result.push('')
    if state.has_scoped() {
        string all_text = state.scope == model_selector.SCOPE_ALL ? theme.fg(theme.accent(), 'all') : theme.fg(theme.muted_color(), 'all')
        string scoped_text = state.scope == model_selector.SCOPE_SCOPED ? theme.fg(theme.accent(), 'scoped') : theme.fg(theme.muted_color(), 'scoped')
        result.push(' ' + theme.fg(theme.muted_color(), 'Scope: ') + all_text + theme.fg(theme.muted_color(), ' | ') + scoped_text)
        result.push(' ' + theme.fg(theme.muted_color(), 'Tab scope (all/scoped)'))
    } else {
        result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.warning(), 'Only showing models from configured providers. Use /login to add providers.'), width))
    }
    result.push('')
    result.push(' > ' + theme.fg(theme.text(), state.query))
    result.push('')
    int start = state.selected - model_selector.MAX_VISIBLE / 2
    if start < 0 {start = 0}
    int max_start = state.filtered.len() - model_selector.MAX_VISIBLE
    if max_start < 0 {max_start = 0}
    if start > max_start {start = max_start}
    int finish = start + model_selector.MAX_VISIBLE
    if finish > state.filtered.len() {finish = state.filtered.len()}
    for int index = start; index < finish; index += 1 {
        var item = state.filtered[index]
        bool selected = index == state.selected
        string prefix = selected ? theme.fg(theme.accent(), '-> ') : '   '
        string model_text = selected ? theme.fg(theme.accent(), item.id) : theme.fg(theme.text(), item.id)
        string badge = theme.fg(theme.muted_color(), ' [' + item.provider + ']')
        string check = item.reference == state.current_reference ? theme.fg(theme.success(), ' ✓') : ''
        string line = prefix + model_text + badge + check
        result.push(' ' + text_utils.truncate_to_width(line, width - 2, '...', true))
    }
    if start > 0 || finish < state.filtered.len() {
        result.push('  ' + theme.fg(theme.muted_color(), fmt.sprintf('(%d/%d)', state.selected + 1, state.filtered.len())))
    }
    if state.error_message != '' {
        result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.error_color(), state.error_message), width))
    } else if state.filtered.len() == 0 {
        result.push('  ' + theme.fg(theme.muted_color(), 'No matching models'))
    } else {
        var selected = state.filtered[state.selected]
        result.push('')
        result.push('  ' + theme.fg(theme.muted_color(), 'Model Name: ' + selected.name))
    }
    if state.refresh_status != '' {
        result.push('')
        result.push('  ' + theme.fg(theme.muted_color(), state.refresh_status))
    }
    result.push('')
    result.push(theme.border_line(width))
    return result
}

fn render_scoped_models(ref<overlay_t> overlay, ref<scoped_models.state_t> state, int width): [string]! {
    [string] result = []
    result.push(theme.border_line(width))
    result.push('')
    result.push(' ' + theme.bold(theme.fg(theme.accent(), overlay.title)))
    result.push(' ' + theme.fg(theme.muted_color(), 'Session-only. Ctrl+S to save to settings.'))
    result.push('')
    result.push(' > ' + theme.fg(theme.text(), state.query))
    result.push('')
    int start = state.selected - scoped_models.MAX_VISIBLE / 2
    if start < 0 {start = 0}
    int max_start = state.filtered.len() - scoped_models.MAX_VISIBLE
    if max_start < 0 {max_start = 0}
    if start > max_start {start = max_start}
    int finish = start + scoped_models.MAX_VISIBLE
    if finish > state.filtered.len() {finish = state.filtered.len()}
    for int index = start; index < finish; index += 1 {
        var item = state.filtered[index]
        bool selected = index == state.selected
        string prefix = selected ? theme.fg(theme.accent(), '-> ') : '   '
        string id = item.id
        string badge = ''
        string status = ''
        if item.model is ref<ai_types.model_t> {
            badge = theme.fg(theme.muted_color(), ' [' + item.provider + ']')
            if !state.all_enabled {
                status = state.is_enabled(item.full_id) ? theme.fg(theme.success(), ' ✓') : theme.fg(theme.dim_color(), ' ✗')
            }
        } else {
            id = item.full_id
            badge = theme.fg(theme.muted_color(), ' [unavailable]')
            status = theme.fg(theme.dim_color(), ' ✗')
        }
        string model_text = selected ? theme.fg(theme.accent(), id) : theme.fg(theme.text(), id)
        result.push(' ' + text_utils.truncate_to_width(prefix + model_text + badge + status, width - 2, '...', true))
    }
    if start > 0 || finish < state.filtered.len() {
        result.push('  ' + theme.fg(theme.muted_color(), fmt.sprintf('(%d/%d)', state.selected + 1, state.filtered.len())))
    }
    if state.filtered.len() == 0 {
        result.push('  ' + theme.fg(theme.muted_color(), 'No matching models'))
    } else {
        var selected = state.filtered[state.selected]
        result.push('')
        result.push('  ' + theme.fg(theme.muted_color(), selected.model is ref<ai_types.model_t> ? 'Model Name: ' + selected.name : 'Model unavailable'))
    }
    string count = state.all_enabled ? 'all enabled' : fmt.sprintf('%d/%d enabled', state.enabled_available_count(), state.catalog.len())
    int unavailable = state.unavailable_count()
    if unavailable > 0 {count += fmt.sprintf(' · %d unavailable', unavailable)}
    string help = 'enter toggle · ctrl+a all · ctrl+x clear · ctrl+p provider · alt+up/down reorder · ctrl+s save · ' + count
    if state.dirty {help += ' (unsaved)'}
    result.push('')
    result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.dim_color(), help), width))
    result.push(theme.border_line(width))
    return result
}

pub fn render_overlay(ref<overlay_t> overlay, int width, string session_dir, string current_model_reference, ref<session.runner_t> runner): [string]! {
    if overlay.kind == OVERLAY_MODEL && overlay.model_state is ref<model_selector.state_t> {
        return render_model_selector(overlay, overlay.model_state as ref<model_selector.state_t>, width)
    }
    if overlay.kind == OVERLAY_SCOPED_MODELS && overlay.scoped_models_state is ref<scoped_models.state_t> {
        return render_scoped_models(overlay, overlay.scoped_models_state as ref<scoped_models.state_t>, width)
    }
    if overlay.kind == OVERLAY_SETUP {
        [string] setup = vec<string>.cap_of(24)
        setup.push(theme.border_line(width))
        setup.push('')
        for logo_line in ['██████', '██  ██', '████  ██', '██    ██'] {
            setup.push(' ' + theme.fg(theme.accent(), logo_line))
        }
        setup.push('')
        setup.push(' ' + theme.bold(theme.fg(theme.accent(), overlay.title)))
        setup.push('')
        if overlay.setup_step == 'theme' {
            setup.push(' ' + theme.fg(theme.text(), 'Pick a theme.'))
            setup.push(' ' + theme.fg(theme.muted_color(), 'Detected system appearance: ' + overlay.provider))
            setup.push('')
        } else {
            setup.push(' ' + theme.fg(theme.text(), 'Opt-in to anonymous usage data sharing?'))
            for line in [
                'Opting in stores a tracking identifier in settings.json and enables anonymous',
                'usage analytics. This helps us to better debug, reproduce, and resolve issues',
                'and bugs within Adou. You can observe what is shared using /privacy and make',
                'changes anytime in settings.json.',
            ] {
                setup.push(' ' + theme.fg(theme.muted_color(), line))
            }
            setup.push('')
        }
        for index, option in overlay.options {
            bool selected = index == overlay.selected
            string prefix = selected ? theme.fg(theme.accent(), '→ ') : '  '
            string label = selected ? theme.fg(theme.accent(), option) : theme.fg(theme.text(), option)
            setup.push(' ' + prefix + label)
        }
        setup.push('')
        var setup_registry = keybindings.current()
        string action = overlay.setup_step == 'theme' ? 'continue' : 'finish'
        string hint = '↑↓ navigate  ' + keybindings.key_text(setup_registry, keybindings.SELECT_CONFIRM) + ' ' + action + '  ' + keybindings.key_text(setup_registry, keybindings.SELECT_CANCEL) + ' skip setup'
        setup.append(text_utils.wrap_text_with_ansi(' ' + theme.fg(theme.dim_color(), hint), width))
        setup.push('')
        setup.push(theme.border_line(width))
        return setup
    }
    [string] result = vec<string>.cap_of(24)
    result.push(theme.border_line(width))
    result.push('')
    int title_width = width - 2
    if title_width < 1 {title_width = 1}
    result.push(' ' + theme.bold(theme.fg(theme.accent(), text_utils.truncate_to_width(overlay.title, title_width, '...', false))))
    result.push('')
    if overlay.kind == OVERLAY_SESSION_INFO {
        for line in overlay.options {
            if line == '' {
                result.push('')
            } else if line == 'Session Info' || line == 'Messages' || line == 'Tokens' || line == 'Cost' || line == 'Context' {
                result.append(text_utils.wrap_text_with_ansi(' ' + theme.bold(theme.fg(theme.accent(), line)), width))
            } else {
                int available = width - 2
                if available < 1 {available = 1}
                result.append(text_utils.wrap_text_with_ansi(' ' + theme.fg(theme.text(), text_utils.truncate_to_width(line, available, '...', false)), width))
            }
        }
        result.push('')
        result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.dim_color(), 'enter/escape close'), width))
        result.push(theme.border_line(width))
        return result
    }
    if overlay.kind == OVERLAY_TRUST {
        if overlay.trust_prompt {
            result.append(text_utils.wrap_text_with_ansi(' ' + theme.fg(theme.muted_color(), 'Project: ' + overlay.provider), width))
            result.push('')
            result.append(text_utils.wrap_text_with_ansi(' ' + theme.fg(theme.text(), 'This allows Adou to load .adou resources and project .agents skills.'), width))
            result.push('')
        } else {
            string source = trust.decision_source(overlay.provider)
            string source_text = source == '' ? 'none' : source
            result.append(text_utils.wrap_text_with_ansi(' ' + theme.fg(theme.muted_color(), 'Project: ' + overlay.provider), width))
            result.append(text_utils.wrap_text_with_ansi(' ' + theme.fg(theme.muted_color(), 'Saved source: ' + source_text), width))
            result.push('')
        }
        int trust_last = overlay.options.len()
        for int index = 0; index < trust_last; index += 1 {
            string option = overlay.options[index]
            bool selected = index == overlay.selected
            string prefix = selected ? theme.fg(theme.accent(), '→ ') : '  '
            string fitted = text_utils.truncate_to_width(option, width - 4, '...', false)
            result.push(' ' + prefix + (selected ? theme.fg(theme.accent(), fitted) : theme.fg(theme.text(), fitted)))
        }
        result.push('')
        result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.dim_color(), 'j/k or ↑/↓ navigate   enter save   escape cancel'), width))
        result.push(theme.border_line(width))
        return result
    }
    if overlay.kind == OVERLAY_CONFIG {
        string scope_text = overlay.config_scope == 0 ? 'global resources' : 'project resources'
        result.push(' ' + theme.fg(theme.muted_color(), 'Scope: ') + theme.fg(theme.accent(), scope_text) + theme.fg(theme.muted_color(), '  (Tab to switch)'))
        result.push(' ' + theme.fg(theme.muted_color(), 'Search: ') + theme.fg(theme.text(), overlay.query))
        result.push('')
        var options = filtered_options(session_dir, overlay, runner)
        if options.len() == 0 {
            result.push('  ' + theme.fg(theme.muted_color(), 'No matching resources'))
        } else {
            if overlay.selected >= options.len() {overlay.selected = options.len() - 1}
            int first = 0
            if overlay.selected >= OVERLAY_VISIBLE_OPTIONS {
                first = overlay.selected - OVERLAY_VISIBLE_OPTIONS + 1
            }
            int last = first + OVERLAY_VISIBLE_OPTIONS
            if last > options.len() {last = options.len()}
            for int index = first; index < last; index += 1 {
                string option = options[index]
                if option == 'Skills' || option == 'Prompts' || option.starts_with('Scope:') {
                    result.push(' ' + theme.bold(theme.fg(theme.accent(), option)))
                    continue
                }
                bool selected = index == overlay.selected
                string prefix = selected ? theme.fg(theme.accent(), '→ ') : '  '
                string fitted = text_utils.truncate_to_width(option, width - 4, '...', false)
                result.push(' ' + prefix + (selected ? theme.fg(theme.accent(), fitted) : theme.fg(theme.text(), fitted)))
            }
            if first > 0 {result.push('  ' + theme.fg(theme.dim_color(), '...'))}
            if last < options.len() {result.push('  ' + theme.fg(theme.dim_color(), '...'))}
        }
        result.push('')
        result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.dim_color(), 'j/k navigate   space/enter toggle   tab scope   page up/down   escape cancel'), width))
        result.push(theme.border_line(width))
        return result
    }
    if overlay.kind == OVERLAY_API_KEY || overlay.kind == OVERLAY_NAME || overlay.kind == OVERLAY_LABEL || overlay.kind == OVERLAY_BRANCH_CUSTOM {
        string field = overlay.kind == OVERLAY_NAME ? 'Session name' : overlay.kind == OVERLAY_LABEL ? 'Label' : overlay.kind == OVERLAY_BRANCH_CUSTOM ? 'Instructions' : 'API key'
        result.push(' ' + theme.fg(theme.muted_color(), field))
        result.push(' > ' + theme.fg(theme.text(), overlay.query))
        result.push('')
    } else {
        if overlay.kind == OVERLAY_SESSION && overlay.confirming_delete {
            result.push(' ' + theme.fg(theme.error_color(), 'Delete this session?'))
            result.push(' ' + theme.fg(theme.text(), shorten_overlay_path(overlay.delete_path)))
            result.push('')
            result.push(' ' + theme.fg(theme.dim_color(), 'enter confirm   escape cancel'))
            result.push(theme.border_line(width))
            return result
        }
        if overlay.kind == OVERLAY_MODEL {
            // Pi's scope header (all / scoped) plus the auth hint.
            string scope_text = overlay.scope == 1 ? 'Scoped' : 'All'
            result.push(' ' + theme.fg(theme.muted_color(), 'Scope: ') + theme.fg(theme.accent(), scope_text) + theme.fg(theme.muted_color(), '  (Tab to switch)'))
            result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.warning(), 'Only showing models from configured providers. Use /login to add providers.'), width))
            result.push('')
            if overlay.query != '' {
                result.push(' ' + theme.fg(theme.muted_color(), 'Search: ') + theme.fg(theme.text(), overlay.query))
                result.push('')
            }
        }
        if overlay.kind == OVERLAY_SESSION {
            string scope_text = overlay.scope == 0 ? 'current folder' : 'all projects'
            string sort_text = overlay.sort_mode == 0 ? 'recent' : overlay.sort_mode == 1 ? 'relevance' : 'threaded'
            result.push(' ' + theme.fg(theme.muted_color(), 'Scope: ') + theme.fg(theme.accent(), scope_text) + theme.fg(theme.muted_color(), '  (Tab to switch)'))
            result.push(' ' + theme.fg(theme.muted_color(), 'Sort: ') + theme.fg(theme.accent(), sort_text) + theme.fg(theme.muted_color(), '  (Ctrl+S to cycle)'))
            if overlay.query != '' {
                result.push(' ' + theme.fg(theme.muted_color(), 'Search: ') + theme.fg(theme.text(), overlay.query))
            }
            result.push('')
        }
        var options = filtered_options(session_dir, overlay, runner)
        int first = 0
        if overlay.selected >= OVERLAY_VISIBLE_OPTIONS {
            first = overlay.selected - OVERLAY_VISIBLE_OPTIONS + 1
        }
        int last = first + OVERLAY_VISIBLE_OPTIONS
        if last > options.len() {
            last = options.len()
            first = last > OVERLAY_VISIBLE_OPTIONS ? last - OVERLAY_VISIBLE_OPTIONS : 0
        }
        if first > 0 {
            result.push('  ' + theme.fg(theme.dim_color(), '...'))
        }
        string live_session_file = overlay.kind == OVERLAY_SESSION ? runner.repository.get_session_file() : ''
        for int index = first; index < last; index += 1 {
            string option = options[index]
            bool selected = index == overlay.selected
            bool is_current = overlay.kind == OVERLAY_SESSION && live_session_file != '' && option == live_session_file
            string current_mark = is_current ? theme.fg(theme.accent(), '● ') : ''
            string prefix = (selected ? theme.fg(theme.accent(), '→ ') : '  ') + current_mark
            int option_width = width - 4 - (is_current ? 2 : 0)
            if option_width < 1 {option_width = 1}
            string display_option = overlay.kind == OVERLAY_SESSION ? session_option_display(option, overlay.show_paths) : option
            if overlay.kind == OVERLAY_MODEL {
                display_option = model_option_display(option, current_model_reference)
            } else if overlay.kind == OVERLAY_PROVIDER || overlay.kind == OVERLAY_LOGOUT {
                display_option = provider_name_from_option(option) + ' [' + provider_id_from_option(option) + ']'
            } else if overlay.kind == OVERLAY_TREE {
                display_option = tree_option_display(runner.repository, option, overlay.collapsed_ids)
            }
            if overlay.kind == OVERLAY_SESSION && overlay.sort_mode == 2 {
                display_option = session_tree_prefix(options, index) + display_option
            }
            string fitted = text_utils.truncate_to_width(display_option, option_width, '...', false)
            string text = selected ? theme.fg(theme.accent(), fitted) : theme.fg(theme.text(), fitted)
            result.push(' ' + prefix + text)
        }
        if last < options.len() {
            result.push('  ' + theme.fg(theme.dim_color(), '...'))
        }
        if overlay.kind == OVERLAY_MODEL && options.len() > 0 && overlay.selected < options.len() {
            string name_line = 'Model Name: ' + options[overlay.selected]
            var selected_model = models.find(options[overlay.selected])
            if selected_model is ref<ai_types.model_t> selected_ref {
                if selected_ref.name != '' {
                    name_line = 'Model Name: ' + selected_ref.name
                }
            }
            result.push(' ' + theme.fg(theme.accent(), name_line))
        }
        if options.len() == 0 {
            if overlay.kind == OVERLAY_MODEL {
                result.push('  ' + theme.fg(theme.muted_color(), 'No matching models'))
            } else if overlay.kind == OVERLAY_SESSION {
                if overlay.named_only {
                    if overlay.scope == 1 {
                        result.push('  ' + theme.fg(theme.muted_color(), 'No named sessions found. Press Ctrl+N to show all.'))
                    } else {
                        result.push('  ' + theme.fg(theme.muted_color(), 'No named sessions in current folder. Press Ctrl+N to show all, or Tab to view all.'))
                    }
                } else if overlay.scope == 1 {
                    result.push('  ' + theme.fg(theme.muted_color(), 'No sessions found'))
                } else {
                    result.push('  ' + theme.fg(theme.muted_color(), 'No sessions in current folder. Press Tab to view all.'))
                }
            } else {
                result.push('  ' + theme.fg(theme.muted_color(), 'No matching options'))
            }
        }
    }
    result.push('')
    // Batch 4: overlay hints derive from the registry, so a user remap
    // updates the displayed keys together with the dispatch.
    var registry = keybindings.current()
    string navigate = keybindings.key_text(registry, keybindings.SELECT_UP) + '/' + keybindings.key_text(registry, keybindings.SELECT_DOWN) + ' navigate   ' + keybindings.key_text(registry, keybindings.SELECT_CONFIRM) + ' select   ' + keybindings.key_text(registry, keybindings.SELECT_CANCEL) + ' cancel'
    string help = navigate
    if overlay.kind == OVERLAY_TREE {
        help = navigate + '   ' + keybindings.key_text(registry, keybindings.APP_TREE_FILTER_CYCLE_FORWARD) + ' filter   ' + keybindings.key_text(registry, keybindings.APP_TREE_FOLD_OR_UP) + '/' + keybindings.key_text(registry, keybindings.APP_TREE_UNFOLD_OR_DOWN) + ' fold/unfold   ' + keybindings.key_text(registry, keybindings.APP_TREE_EDIT_LABEL) + ' label   ' + keybindings.key_text(registry, keybindings.APP_TREE_TOGGLE_LABEL_TIMESTAMP) + ' timestamps'
    } else if overlay.kind == OVERLAY_SCOPED_MODELS {
        help = navigate + '   ' + keybindings.key_text(registry, keybindings.APP_MODELS_ENABLE_ALL) + ' all   ' + keybindings.key_text(registry, keybindings.APP_MODELS_CLEAR_ALL) + ' clear   ' + keybindings.key_text(registry, keybindings.APP_MODELS_TOGGLE_PROVIDER) + ' provider   ' + keybindings.key_text(registry, keybindings.APP_MODELS_REORDER_UP) + '/' + keybindings.key_text(registry, keybindings.APP_MODELS_REORDER_DOWN) + ' reorder   ' + keybindings.key_text(registry, keybindings.APP_MODELS_SAVE) + ' save'
    } else if overlay.kind == OVERLAY_SESSION {
        help = navigate + '   ' + keybindings.key_text(registry, keybindings.SELECT_PAGE_UP) + '/' + keybindings.key_text(registry, keybindings.SELECT_PAGE_DOWN) + ' page   ' + keybindings.key_text(registry, keybindings.APP_SESSION_TOGGLE_PATH) + ' path   ' + keybindings.key_text(registry, keybindings.APP_SESSION_TOGGLE_SORT) + ' sort   ' + keybindings.key_text(registry, keybindings.APP_SESSION_TOGGLE_NAMED_FILTER) + ' named   ' + keybindings.key_text(registry, keybindings.APP_SESSION_RENAME) + ' rename   ' + keybindings.key_text(registry, keybindings.APP_SESSION_DELETE) + ' delete'
    }
    result.append(text_utils.wrap_text_with_ansi(theme.fg(theme.dim_color(), help), width))
    result.push(theme.border_line(width))
    return result
}

fn filtered_options(string session_dir, ref<overlay_t> overlay, ref<session.runner_t> runner): [string] {
    if overlay.kind == OVERLAY_CONFIG {
        return config_filtered_options(overlay)
    }
    if overlay.kind == OVERLAY_MODEL {
        [string] result = []
        if overlay.model_state is ref<model_selector.state_t> {
            var state = overlay.model_state as ref<model_selector.state_t>
            for item in state.filtered {
                result.push(item.reference)
            }
        }
        return result
    }
    if overlay.kind == OVERLAY_SCOPED_MODELS {
        [string] result = []
        if overlay.scoped_models_state is ref<scoped_models.state_t> {
            var state = overlay.scoped_models_state as ref<scoped_models.state_t>
            for item in state.filtered {
                result.push(item.full_id)
            }
        }
        return result
    }
    if overlay.kind == OVERLAY_SESSION {
        // Pi's session search: id + name + every message text + cwd, with
        // `re:` regex, quoted phrases and fuzzy tokens; sort_mode 1 ranks
        // by relevance, while sort_mode 2 renders threaded parent/child
        // order.  Scope narrows the merged option list to this folder.
        [string] scoped = []
        if overlay.scope == 0 {
            for option in overlay.options {
                if path.dir(option) == session_dir {
                    scoped.push(option)
                }
            }
        } else {
            scoped = overlay.options
        }
        if overlay.sort_mode == 2 {
            return session_search.filter_and_sort_sessions_threaded(scoped, overlay.query, overlay.named_only)
        }
        return session_search.filter_and_sort_sessions(scoped, overlay.query, overlay.sort_mode, overlay.named_only)
    }
    if overlay.kind == OVERLAY_TREE {
        [string] result = vec<string>.cap_of(overlay.options.len())
        string query = overlay.query.to_lower()
        for option in overlay.options {
            string entry_id = option_entry_id(option)
            if tree_hidden_by_collapse(runner.repository, entry_id, overlay.collapsed_ids) {
                continue
            }
            if !session_search.entry_matches_tree_filter(runner.repository, entry_id, overlay.tree_filter) {
                continue
            }
            if query == '' || fuzzy_match((option + ' ' + session_search.entry_content_preview(runner.repository, entry_id)).to_lower(), query) {
                result.push(option)
            }
        }
        return result
    }
    [string] result = vec<string>.cap_of(overlay.options.len())
    string query = overlay.query.to_lower()
    for option in overlay.options {
        if overlay.kind == OVERLAY_SESSION && overlay.named_only && session_name_for_path(option) == '' {
            continue
        }
        string searchable = overlay.kind == OVERLAY_SESSION ? session_option_display(option, false) + ' ' + option : option
        if query == '' || fuzzy_match(searchable.to_lower(), query) {
            result.push(option)
        }
    }
    return result
}

type session_meta_t = struct {
    string name
    string first_message
    int message_count
    i64 modified_ms
}

// Load once and reuse across the display helpers: name, first message,
// message count and the file modification time Pi shows as session age.
fn session_metadata(string file_path): session_meta_t {
    session_meta_t meta = session_meta_t {}
    var stat = syscall.stat(file_path) catch error {
        return meta
    }
    meta.modified_ms = stat.mtim.sec * 1000
    var selected = repository.open(file_path) catch error {
        return meta
    }
    meta.name = selected.get_session_name() catch error {''}
    var active = selected.active_entries()
    for entry in active {
        if entry.kind != session_types.ENTRY_MESSAGE {
            continue
        }
        meta.message_count += 1
        if meta.first_message == '' {
            var object = entry.raw as {string:any}
            if !object.contains('message') || !(object['message'] is {string:any}) {
                continue
            }
            var message = message_json.decode(object['message']) catch error {continue}
            if message is ref<ai_types.user_message_t> user {
                meta.first_message = user.content.replace('\n', ' ').trim([' ', '\t'])
            }
        }
    }
    return meta
}

// Pi's formatSessionDate: now / 5m / 3h / 2d / 1w / 2mo / 1y.
fn format_session_date(int modified_ms): string {
    int now_ms = time.now().ms_timestamp() as int
    int diff_ms = now_ms - modified_ms
    if diff_ms < 0 {
        diff_ms = 0
    }
    int minutes = diff_ms / 60000
    int hours = diff_ms / 3600000
    int days = diff_ms / 86400000
    if minutes < 1 {
        return 'now'
    }
    if minutes < 60 {
        return fmt.sprintf('%dm', minutes)
    }
    if hours < 24 {
        return fmt.sprintf('%dh', hours)
    }
    if days < 7 {
        return fmt.sprintf('%dd', days)
    }
    if days < 30 {
        return fmt.sprintf('%dw', days / 7)
    }
    if days < 365 {
        return fmt.sprintf('%dmo', days / 30)
    }
    return fmt.sprintf('%dy', days / 365)
}

fn session_name_for_path(string file_path): string {
    var selected = repository.open(file_path) catch error {return ''}
    return selected.get_session_name() catch error {''}
}

// Pi's session row: display name (or first message) with a right-aligned
// metadata column "{msgCount} {age}" and the working directory when the
// path column is enabled.
fn session_option_display(string file_path, bool show_path): string {
    var meta = session_metadata(file_path)
    string body = meta.name != '' ? meta.name : meta.first_message
    if body == '' {
        body = path.base(file_path)
    }
    string right = fmt.sprintf('%d %s', meta.message_count, format_session_date(meta.modified_ms as int))
    if show_path {
        right = shorten_overlay_path(file_path) + '  ' + right
    }
    return body + '  ' + theme.fg(theme.dim_color(), right)
}

// Pi's threaded tree prefix: │/├─/└─ indentation derived from the sorted
// option list, where children follow their parent and siblings are adjacent.
fn session_tree_prefix([string] options, int index): string {
    if index == 0 {
        return ''
    }
    // Resolve the parent via the header; the option list itself is tree
    // ordered, so a parent always precedes its children.
    var selected = repository.open(options[index]) catch error {
        return ''
    }
    string parent = selected.header.parent_session
    [string] ancestors = []
    string cursor_path = parent
    for ancestors.len() < 16 && cursor_path != '' {
        int parent_index = session_option_index(options, cursor_path, index)
        if parent_index < 0 {break}
        ancestors.push(cursor_path)
        var parent_manager = repository.open(cursor_path) catch error {break}
        cursor_path = parent_manager.header.parent_session
    }
    string result = ''
    // Pi reserves one three-column gutter for every ancestor. The virtual
    // root gutter is blank; deeper gutters continue with │ only while that
    // ancestor has a later sibling in the flattened thread.
    for int position = ancestors.len() - 1; position >= 0; position -= 1 {
        if position == ancestors.len() - 1 {
            result += '   '
            continue
        }
        string ancestor = ancestors[position]
        int ancestor_index = session_option_index(options, ancestor, index)
        string ancestor_parent = session_parent_path(ancestor)
        result += session_has_later_sibling(options, ancestor_index, ancestor_parent) ? '│  ' : '   '
    }
    result += session_has_later_sibling(options, index, parent) ? '├─ ' : '└─ '
    return theme.fg(theme.muted_color(), result)
}

fn session_parent_path(string file_path): string {
    var manager = repository.open(file_path) catch error {return ''}
    return manager.header.parent_session
}

fn session_option_index([string] options, string file_path, int before): int {
    int limit = before < options.len() ? before : options.len()
    for int index = 0; index < limit; index += 1 {
        if options[index] == file_path {return index}
    }
    return -1
}

fn session_has_later_sibling([string] options, int index, string parent): bool {
    if index < 0 {return false}
    for int candidate = index + 1; candidate < options.len(); candidate += 1 {
        var manager = repository.open(options[candidate]) catch error {continue}
        if manager.header.parent_session == parent {return true}
    }
    return false
}

// Pi's model row: id with a [provider] badge and a ✓ mark on the current
// model.
fn model_option_display(string reference, string current_reference): string {
    int separator = reference.find('/')
    string provider = separator >= 0 ? reference.slice(0, separator) : ''
    string id = separator >= 0 ? reference.slice(separator + 1, reference.len()) : reference
    string line = id + ' ' + theme.fg(theme.muted_color(), '[' + provider + ']')
    if reference == current_reference {
        line += theme.fg(theme.success(), ' ✓')
    }
    return line
}

fn list_in([string] values, string target): bool {
    for value in values {
        if value == target {
            return true
        }
    }
    return false
}

fn tree_has_children(ref<repository.manager_t> manager, string entry_id): bool {
    for entry in manager.get_entries() {
        if entry.parent_id == entry_id {
            return true
        }
    }
    return false
}

fn tree_hidden_by_collapse(ref<repository.manager_t> manager, string entry_id, [string] collapsed): bool {
    var raw = manager.get_entry(entry_id) catch error {return false}
    if !(raw is ref<session_types.entry_t>) {return false}
    var entry = raw as ref<session_types.entry_t>
    string parent = entry.parent_id
    int guard = 0
    for parent != '' && guard < 128 {
        if list_in(collapsed, parent) {
            return true
        }
        var parent_raw = manager.get_entry(parent) catch error {break}
        if !(parent_raw is ref<session_types.entry_t>) {break}
        var parent_entry = parent_raw as ref<session_types.entry_t>
        parent = parent_entry.parent_id
        guard += 1
    }
    return false
}

fn tree_option_display(ref<repository.manager_t> manager, string option, [string] collapsed): string {
    string entry_id = option_entry_id(option)
    var raw = manager.get_entry(entry_id) catch error {return option}
    if !(raw is ref<session_types.entry_t>) {return option}
    var entry = raw as ref<session_types.entry_t>
    int depth = 0
    string parent = entry.parent_id
    int guard = 0
    for parent != '' && guard < 128 {
        depth += 1
        var parent_raw = manager.get_entry(parent) catch error {break}
        if !(parent_raw is ref<session_types.entry_t>) {break}
        var parent_entry = parent_raw as ref<session_types.entry_t>
        parent = parent_entry.parent_id
        guard += 1
    }
    string prefix = ''
    for int level = 0; level < depth; level += 1 {
        prefix += '  '
    }
    string branch = tree_has_children(manager, entry_id) ? (list_in(collapsed, entry_id) ? '+ ' : '- ') : '  '
    return prefix + branch + option
}

fn shorten_overlay_path(string value): string {
    string home = syscall.get_env('HOME')
    if home != '' && value.starts_with(home + '/') {
        return '~' + value.slice(home.len(), value.len())
    }
    return value
}

fn fuzzy_match(string value, string query): bool {
    int cursor = 0
    for int index = 0; index < query.len(); index += 1 {
        int found = -1
        for int candidate = cursor; candidate < value.len(); candidate += 1 {
            if value[candidate] == query[index] {
                found = candidate
                break
            }
        }
        if found < 0 {
            return false
        }
        cursor = found + 1
    }
    return true
}

fn option_entry_id(string option): string {
    int separator = option.find(' ')
    return separator < 0 ? option : option.slice(0, separator)
}

fn next_queue_mode(string value): string {
    return value == agent_types.QUEUE_ALL ? agent_types.QUEUE_ONE : agent_types.QUEUE_ALL
}

fn view_t.available_cycle_models(&self): [ref<ai_types.model_t>] {
    if self.model_scope_patterns.len() > 0 {
        [ref<ai_types.model_t>] scoped = []
        [models.scoped_model_t] resolved = models.resolve_scope(self.model_scope_patterns)
        for entry in resolved {
            if self.model_is_authenticated(entry.model) {
                scoped.push(entry.model)
            }
        }
        if scoped.len() > 0 {
            return scoped
        }
        // Pi falls back to every available model when --models resolves to
        // nothing (for example before a provider has been authenticated).
    }
    [ref<ai_types.model_t>] available = []
    for model in models.all() {
        if self.model_is_authenticated(model) {
            available.push(model)
        }
    }
    return available
}

pub fn view_t.model_is_authenticated(&self, ref<ai_types.model_t> model): bool {
    if self.cached_authenticated_providers.contains(model.provider) {
        return self.cached_authenticated_providers[model.provider]
    }
    // The view is normally initialized with a provider snapshot. This
    // fallback keeps the method safe during construction and after a scope
    // refresh that introduces a provider not present in the catalog scan.
    bool configured = auth.effective(model.provider) != ''
    if self.runner.agent_config.model.provider == model.provider && self.runner.agent_config.stream_options.api_key != '' {
        configured = true
    }
    self.cached_authenticated_providers[model.provider] = configured
    return configured
}

fn builtin_command_names(): [string] {
    // Pi BUILTIN_SLASH_COMMANDS order (slash-commands.ts). `/help` remains
    // accepted by run_command as a convenience, but is not advertised as a
    // Pi built-in command.
    return ['/settings', '/model', '/scoped-models', '/export', '/import', '/share', '/copy', '/name', '/session', '/changelog', '/hotkeys', '/fork', '/clone', '/tree', '/trust', '/login', '/logout', '/new', '/compact', '/resume', '/reload', '/quit']
}

// Pi BUILTIN_SLASH_COMMANDS (slash-commands.ts) raw descriptions and
// argument hints.  The display description "hint — [tag] description" is
// composed at render time (B1-R1-07), so the raw fields stay separate.
fn builtin_command_description(string command): string {
    if command == '/settings' {return 'Open settings menu'}
    if command == '/model' {return 'Select model (opens selector UI)'}
    if command == '/scoped-models' {return 'Enable/disable models for Ctrl+P cycling'}
    if command == '/export' {return 'Export session (HTML default, or specify path: .html/.jsonl)'}
    if command == '/import' {return 'Import and resume a session from a JSONL file'}
    if command == '/share' {return 'Share session as a secret GitHub gist'}
    if command == '/copy' {return 'Copy last agent message to clipboard'}
    if command == '/name' {return 'Set session display name'}
    if command == '/session' {return 'Show session info and stats'}
    if command == '/changelog' {return 'Show changelog entries'}
    if command == '/hotkeys' {return 'Show all keyboard shortcuts'}
    if command == '/fork' {return 'Create a new fork from a previous user message'}
    if command == '/clone' {return 'Duplicate the current session at the current position'}
    if command == '/tree' {return 'Navigate session tree (switch branches)'}
    if command == '/trust' {return 'Save project trust decision for future sessions'}
    if command == '/login' {return 'Configure provider authentication'}
    if command == '/logout' {return 'Remove provider authentication'}
    if command == '/new' {return 'Start a new session'}
    if command == '/compact' {return 'Manually compact the session context'}
    if command == '/resume' {return 'Resume a different session'}
    if command == '/reload' {return 'Reload keybindings, extensions, skills, prompts, themes, and context files'}
    if command == '/quit' {return 'Quit pi'}
    return ''
}

fn builtin_command_argument_hint(string command): string {
    if command == '/model' {return '<provider/model>'}
    if command == '/login' {return '<provider>'}
    return ''
}

// Prompt template and skill commands join the built-ins in the completion
// menu (Pi order: builtins, prompts, skills).  The dynamic part comes from
// self.dynamic_commands, assembled by refresh_resource_snapshot from the
// same filtered resources that drive execution (B1-R2-07/08); there is no
// process-global dynamic cache anymore.
fn list_contains([string] values, string target): bool {
    for value in values {
        if value == target {
            return true
        }
    }
    return false
}

fn has_tool_name([string] tool_names, string wanted): bool {
    for name in tool_names {
        if name == wanted {
            return true
        }
    }
    return false
}

// Pi interactive-mode.ts getAutocompleteSourceTag lives in
// adou.src.context.git_source (B1-R3-07): scope mapping, npm: sources and
// the full parseGitUrl git tag are extracted there as the testable
// production parser, and command_items() below calls it.

// The full slash-command item set (builtins, prompts, skills) with Pi's
// display descriptions.  Dynamic items keep their real description and a
// source tag; unknown dynamic descriptions stay empty, never a fallback.
// Raw fields stay separate (B1-R1-07): description/argument_hint/source_tag
// are composed into the display string only at render time, exactly like
// Pi's prefixAutocompleteDescription + `hint — description` composition.
pub fn view_t.command_items(&self): [autocomplete.autocomplete_item_t] {
    [autocomplete.autocomplete_item_t] result = []
    for command in builtin_command_names() {
        string name = command.slice(1, command.len())
        result.push(autocomplete.autocomplete_item_t {
            value: name,
            label: name,
            description: builtin_command_description(command),
            argument_hint: builtin_command_argument_hint(command),
            kind: autocomplete.item_kind_t.BUILTIN,
        })
    }
    for info in self.dynamic_commands {
        string tag = git_source.source_tag(info.source_info)
        autocomplete.item_kind_t kind = info.source == 'prompt' ? autocomplete.item_kind_t.PROMPT : autocomplete.item_kind_t.SKILL
        result.push(autocomplete.autocomplete_item_t {
            value: info.name,
            label: info.name,
            description: info.description,
            argument_hint: info.argument_hint,
            source_tag: tag,
            kind: kind,
        })
    }
    return result
}

// Pi interactive-mode.ts /model argument completion: models from the
// configured providers (scoped set / runtime getAvailable), value
// provider/id, label id, description provider, ranking text mirrors
// getModelSearchText.  Batch 2 owns the selector itself.
//
// B1-R1-09: the candidate list is computed once and cached on the view.
// Refresh happens only at explicit change points (init, /reload, /login,
// /logout) or when the scope patterns changed; ordinary typing never scans
// ~1200 models or reads the credential file per keystroke.
pub fn view_t.refresh_model_argument_cache(&self) {
    [string] scope_copy = []
    for pattern in self.model_scope_patterns {
        scope_copy.push(pattern)
    }
    self.cached_model_scope_patterns = scope_copy
    self.cached_model_argument_items = self.build_model_argument_items()
    self.model_argument_cache_valid = true
}

fn view_t.build_model_argument_items(&self): [autocomplete.autocomplete_item_t] {
    [autocomplete.autocomplete_item_t] result = []
    [string] seen = []
    for model in models.all() {
        string reference = model.provider + '/' + model.id
        if !models.allowed(reference, self.model_scope_patterns) {
            continue
        }
        if !self.model_is_authenticated(model) {
            continue
        }
        if list_contains(seen, reference) {
            continue
        }
        seen.push(reference)
        string search = model.id + ' ' + model.provider + ' ' + reference + ' ' + model.provider + ' ' + model.id + ' ' + model.name
        result.push(autocomplete.autocomplete_item_t {
            value: reference,
            label: model.id,
            description: model.provider,
            search_text: search,
            kind: autocomplete.item_kind_t.MODEL_ARGUMENT,
        })
    }
    return result
}

fn same_scope_patterns([string] left, [string] right): bool {
    if left.len() != right.len() {
        return false
    }
    for int index = 0; index < left.len(); index += 1 {
        if left[index] != right[index] {
            return false
        }
    }
    return true
}

pub fn view_t.model_argument_items(&self): [autocomplete.autocomplete_item_t] {
    if !self.model_argument_cache_valid || !same_scope_patterns(self.model_scope_patterns, self.cached_model_scope_patterns) {
        self.refresh_model_argument_cache()
    }
    [autocomplete.autocomplete_item_t] copy = []
    for item in self.cached_model_argument_items {
        copy.push(item)
    }
    return copy
}

// Pi interactive-mode.ts /login argument completion: the login provider
// list, deduplicated by id and sorted by provider NAME, with the api_key
// auth type. OAuth/subscription providers use the account-login selector and
// are not disguised as API-key auth. Runtime-registered providers are not silently dropped
// (B1-R1-11) and override same-id builtins (B1-R2-03).  The candidate
// assembly (merge, capability filter, name sort, description/search text)
// lives in registry.login_completion_options() so the tests exercise the
// exact list the TUI renders; this function only maps it onto the
// autocomplete item contract (B1-R2-04: OAuth-only providers such as
// openai-codex never appear).
pub fn view_t.login_argument_items(&self): [autocomplete.autocomplete_item_t] {
    [autocomplete.autocomplete_item_t] result = []
    for option in registry.login_completion_options() {
        result.push(autocomplete.autocomplete_item_t {
            value: option.id,
            label: option.id,
            description: option.description,
            search_text: option.search_text,
            kind: autocomplete.item_kind_t.LOGIN_ARGUMENT,
        })
    }
    return result
}

fn repeat_spaces(int count): string {
    string result = ''
    for int index = 0; index < count; index += 1 {
        result += ' '
    }
    return result
}

// Pi select-list.ts renderItem: two-column label + description with the
// layout primary column width, value/description truncation and the
// selection marker.  B1-R1-07: the description column is composed at render
// time (`hint — [tag] description`, see autocomplete.display_description).
// B1-R1-08: the selected row's prefix, value, spacing and description all
// carry the accent (Pi selectedText(accent)); only the unselected
// description is muted (theme.description).
fn render_autocomplete_item(autocomplete.autocomplete_item_t item, bool is_selected, int width, int primary): string {
    string prefix = is_selected ? '→ ' : '  '
    string display = item.label != '' ? item.label : item.value
    string description = autocomplete.normalize_single_line(autocomplete.display_description(item))
    if description != '' && width > 40 {
        int effective = primary
        int bound = width - 2 - 4
        if effective > bound {
            effective = bound
        }
        if effective < 1 {
            effective = 1
        }
        int max_primary = effective - autocomplete.PRIMARY_COLUMN_GAP
        if max_primary < 1 {
            max_primary = 1
        }
        string truncated_value = text_utils.truncate_to_width(display, max_primary, '', false) catch error {display}
        int value_width = text_utils.visible_width(truncated_value) catch error {truncated_value.len()}
        int spacing = effective - value_width
        if spacing < 1 {
            spacing = 1
        }
        int description_start = 2 + value_width + spacing
        int remaining = width - description_start - 2
        if remaining > autocomplete.MIN_DESCRIPTION_WIDTH {
            string truncated_desc = text_utils.truncate_to_width(description, remaining, '', false) catch error {description}
            string row = prefix + truncated_value + repeat_spaces(spacing) + truncated_desc
            if is_selected {
                return theme.fg(theme.accent(), row)
            }
            return prefix + truncated_value + repeat_spaces(spacing) + theme.fg(theme.muted_color(), truncated_desc)
        }
    }
    int max_width = width - 2 - 2
    string value = text_utils.truncate_to_width(display, max_width, '', false) catch error {display}
    if is_selected {
        return theme.fg(theme.accent(), prefix + value)
    }
    return prefix + value
}

fn render_command_menu(ref<autocomplete.autocomplete_state_t> state, int width): [string]! {
    [string] result = vec<string>.cap_of(state.max_visible + 1)
    if !state.active || state.filtered.len() == 0 {
        return result
    }
    int primary = autocomplete.primary_column_width(state.filtered, state.mode)
    int start = autocomplete.window_start(state.selected_index, state.filtered.len(), state.max_visible)
    int end = autocomplete.window_end(start, state.filtered.len(), state.max_visible)
    for int index = start; index < end; index += 1 {
        var item = state.filtered[index]
        bool is_selected = index == state.selected_index
        result.push(render_autocomplete_item(item, is_selected, width, primary))
    }
    if autocomplete.should_show_pager(start, end, state.filtered.len()) {
        string scroll = autocomplete.pager_text(state.selected_index, state.filtered.len())
        result.push(theme.fg(theme.dim_color(), text_utils.truncate_to_width(scroll, width - 2, '', false) catch error {scroll}))
    }
    return result
}
