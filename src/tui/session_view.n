pub type input_t = struct {
    string data
    bool paste
    bool resize
    bool model_refresh_done
    int model_refresh_generation
    int model_refresh_failures
    bool version_check_done
    string version_notice
    bool oauth_ready
    bool oauth_done
    bool oauth_failed
    int oauth_generation
    string oauth_provider
    string oauth_method
    string oauth_authorize_url
    string oauth_verifier
    string oauth_state
    string oauth_device_code
    string oauth_device_uri
    string oauth_device_user_code
    int oauth_device_interval
    int oauth_device_expires
    string oauth_error
}

pub const TERMINAL_INPUT_BYTES = 1
pub const TERMINAL_INPUT_EOF = 2
pub const TERMINAL_INPUT_TIMEOUT = 3

pub type terminal_input_t = struct {
    int kind
    [u8] data = []
    i64 timeout_id
}

pub type interactive_bash_state_t = struct {
    ref<mutex.mutex_t> lock
    [string] output_chunks = []
    int sent_chunks
    bool done
    chan<u8> relay_done
}

pub type oauth_cancellation_t = struct {
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    bool cancelled
}

pub fn oauth_cancellation_t.cancel(&self) {
    self.lock.lock()
    self.cancelled = true
    self.lock.unlock()
}

