import syscall

// Keyboard decoding shared by the TUI.  The parser accepts the legacy VT
// forms used by xterm/tmux and Kitty's CSI-u forms without depending on a
// terminal-specific runtime.
pub const MOD_SHIFT = 1
pub const MOD_ALT = 2
pub const MOD_CTRL = 4
pub const MOD_SUPER = 8
pub const LOCK_MASK = 192

pub const CODE_ESCAPE = 27
pub const CODE_TAB = 9
pub const CODE_ENTER = 13
pub const CODE_SPACE = 32
pub const CODE_BACKSPACE = 127
pub const CODE_KP_ENTER = 57414
pub const CODE_UP = -1
pub const CODE_DOWN = -2
pub const CODE_RIGHT = -3
pub const CODE_LEFT = -4
pub const CODE_DELETE = -10
pub const CODE_INSERT = -11
pub const CODE_PAGE_UP = -12
pub const CODE_PAGE_DOWN = -13
pub const CODE_HOME = -14
pub const CODE_END = -15

var kitty_protocol_active = false

pub type parsed_t = struct {
    bool valid
    int codepoint
    int modifier
    int shifted_key = -1
    int base_layout_key = -1
}

pub fn set_kitty_protocol(bool active) {
    kitty_protocol_active = active
}

pub fn is_kitty_protocol_active(): bool {
    return kitty_protocol_active
}

pub fn parse_key(string data): string {
    var sequence = parse_kitty(data)
    if sequence.valid {
        return format_codepoint_with_base(sequence.codepoint, sequence.modifier, sequence.base_layout_key)
    }
    var modify = parse_modify_other_keys(data)
    if modify.valid {
        return format_codepoint(modify.codepoint, modify.modifier)
    }
    if kitty_protocol_active && (data == '\x1b\r' || data == '\n') {
        return 'shift+enter'
    }
    string legacy = parse_legacy(data)
    if legacy != '' {
        return legacy
    }
    return ''
}

pub fn matches(string data, string key_id): bool {
    string expected = canonical_key(key_id)
    // Raw BS is also the legacy Ctrl+H byte even when the terminal treats it
    // as Backspace (or Ctrl+Backspace in a local Windows Terminal session).
    if data == '\x08' && expected == 'ctrl+h' {
        return true
    }
    // Several legacy Ctrl+symbol bindings share bytes with named terminal
    // keys. Pi's matchesKey resolves those against the requested binding even
    // though parseKey must choose one canonical display name.
    if expected == 'ctrl+[' && data == '\x1b' {return true}
    if expected == 'ctrl+\\' && data == '\x1c' {return true}
    if expected == 'ctrl+]' && data == '\x1d' {return true}
    if expected == 'ctrl+-' && data == '\x1f' {return true}
    // Legacy terminals encode Shift+letter as the uppercase printable byte,
    // while parse_key intentionally returns that byte verbatim.
    if data.len() == 1 && data[0] >= 'A'.char() && data[0] <= 'Z'.char() {
        string shifted = 'shift+' + ascii_char(data[0] as int + 32)
        if expected == shifted {return true}
    }
    string actual = parse_key(data)
    if actual == '' {
        return false
    }
    return actual == expected
}

pub fn is_key_release(string data): bool {
    if data.contains('\x1b[200~') {return false}
    return data.contains(':3u') || data.contains(':3~') || data.contains(':3A') || data.contains(':3B') || data.contains(':3C') || data.contains(':3D') || data.contains(':3H') || data.contains(':3F')
}

pub fn is_key_repeat(string data): bool {
    if data.contains('\x1b[200~') {return false}
    return data.contains(':2u') || data.contains(':2~') || data.contains(':2A') || data.contains(':2B') || data.contains(':2C') || data.contains(':2D') || data.contains(':2H') || data.contains(':2F')
}

pub fn decode_printable(string data): string {
    var sequence = parse_kitty(data)
    if !sequence.valid {
        var modify = parse_modify_other_keys(data)
        if modify.valid {
            sequence = modify
        } else {
            return ''
        }
    }
    int modifier = sequence.modifier & ~LOCK_MASK
    if modifier != 0 && modifier != MOD_SHIFT {
        return ''
    }
    int codepoint = sequence.codepoint
    if (modifier & MOD_SHIFT) != 0 && sequence.shifted_key >= 0 {
        codepoint = sequence.shifted_key
    }
    codepoint = normalize_kitty_codepoint(codepoint)
    if codepoint < 32 || codepoint < 0 {
        return ''
    }
    return encode_codepoint(codepoint)
}

fn parse_kitty(string data): parsed_t {
    var invalid = parsed_t {}
    if data.len() < 4 || data[0] != 0x1b || data[1] != '['.char() {
        return invalid
    }
    int final_index = data.len() - 1
    u8 command = data[final_index]
    if command != 'u'.char() && command != 'A'.char() && command != 'B'.char() && command != 'C'.char() && command != 'D'.char() && command != 'H'.char() && command != 'F'.char() && command != '~'.char() {
        return invalid
    }
    int body_start = 2
    int semicolon = find_byte(data, ';'.char(), body_start, final_index)
    int code_group_end = semicolon >= 0 ? semicolon : final_index
    int first_colon = find_byte(data, ':'.char(), body_start, code_group_end)
    int first_end = first_colon >= 0 ? first_colon : code_group_end
    int first = parse_number(data, body_start, first_end)
    if first < 0 {
        return invalid
    }
    int modifier = modifier_from_body(data, body_start, final_index)
    int codepoint = first
    int shifted_key = -1
    int base_layout_key = -1
    if command == 'u'.char() && first_colon >= 0 {
        int second_colon = find_byte(data, ':'.char(), first_colon + 1, code_group_end)
        int shifted_end = second_colon >= 0 ? second_colon : code_group_end
        if first_colon + 1 < shifted_end {
            shifted_key = parse_number(data, first_colon + 1, shifted_end)
        }
        if second_colon >= 0 && second_colon + 1 < code_group_end {
            base_layout_key = parse_number(data, second_colon + 1, code_group_end)
        }
    }
    if command == 'A'.char() {
        codepoint = CODE_UP
    } else if command == 'B'.char() {
        codepoint = CODE_DOWN
    } else if command == 'C'.char() {
        codepoint = CODE_RIGHT
    } else if command == 'D'.char() {
        codepoint = CODE_LEFT
    } else if command == 'H'.char() {
        codepoint = CODE_HOME
    } else if command == 'F'.char() {
        codepoint = CODE_END
    } else if command == '~'.char() {
        codepoint = functional_codepoint(first)
        if codepoint == 0 {
            return invalid
        }
    }
    if command == 'u'.char() {
        codepoint = first
    }
    return parsed_t {valid: true, codepoint: codepoint, modifier: modifier, shifted_key: shifted_key, base_layout_key: base_layout_key,}
}

fn parse_modify_other_keys(string data): parsed_t {
    var invalid = parsed_t {}
    if data.len() < 8 || data[0] != 0x1b || data[1] != '['.char() || data[data.len() - 1] != '~'.char() {
        return invalid
    }
    int first_end = data.find(';')
    if first_end < 0 || data.slice(2, first_end) != '27' {
        return invalid
    }
    int second_end = data.find_after(';', first_end + 1)
    if second_end < 0 {
        return invalid
    }
    int modifier_value = parse_number(data, first_end + 1, second_end)
    int codepoint = parse_number(data, second_end + 1, data.len() - 1)
    if modifier_value < 1 || codepoint < 0 {
        return invalid
    }
    return parsed_t {valid: true, codepoint: codepoint, modifier: modifier_value - 1, shifted_key: -1, base_layout_key: -1,}
}

fn parse_legacy(string data): string {
    if data == '\x1b' {return 'escape'}
    if data == '\x1b[A' || data == '\x1bOA' {return 'up'}
    if data == '\x1b[B' || data == '\x1bOB' {return 'down'}
    if data == '\x1b[C' || data == '\x1bOC' {return 'right'}
    if data == '\x1b[D' || data == '\x1bOD' {return 'left'}
    if data == '\x1b[H' || data == '\x1bOH' || data == '\x1b[1~' || data == '\x1b[7~' {return 'home'}
    if data == '\x1b[F' || data == '\x1bOF' || data == '\x1b[4~' || data == '\x1b[8~' {return 'end'}
    if data == '\x1b[2~' {return 'insert'}
    if data == '\x1b[3~' {return 'delete'}
    if data == '\x1b[5~' || data == '\x1b[[5~' {return 'pageUp'}
    if data == '\x1b[6~' || data == '\x1b[[6~' {return 'pageDown'}
    if data == '\x1b[E' || data == '\x1bOE' {return 'clear'}
    if data == '\x1b[Z' {return 'shift+tab'}
    if data == '\x1b[a' {return 'shift+up'}
    if data == '\x1b[b' {return 'shift+down'}
    if data == '\x1b[c' {return 'shift+right'}
    if data == '\x1b[d' {return 'shift+left'}
    if data == '\x1b[e' {return 'shift+clear'}
    if data == '\x1b[2$' {return 'shift+insert'}
    if data == '\x1b[3$' {return 'shift+delete'}
    if data == '\x1b[5$' {return 'shift+pageUp'}
    if data == '\x1b[6$' {return 'shift+pageDown'}
    if data == '\x1b[7$' {return 'shift+home'}
    if data == '\x1b[8$' {return 'shift+end'}
    if data == '\x1bOe' {return 'ctrl+clear'}
    if data == '\x1b[2^' {return 'ctrl+insert'}
    if data == '\x1b[3^' {return 'ctrl+delete'}
    if data == '\x1b[5^' {return 'ctrl+pageUp'}
    if data == '\x1b[6^' {return 'ctrl+pageDown'}
    if data == '\x1b[7^' {return 'ctrl+home'}
    if data == '\x1b[8^' {return 'ctrl+end'}
    if data == '\x1bOP' || data == '\x1b[11~' || data == '\x1b[[A' {return 'f1'}
    if data == '\x1bOQ' || data == '\x1b[12~' || data == '\x1b[[B' {return 'f2'}
    if data == '\x1bOR' || data == '\x1b[13~' || data == '\x1b[[C' {return 'f3'}
    if data == '\x1bOS' || data == '\x1b[14~' || data == '\x1b[[D' {return 'f4'}
    if data == '\x1b[15~' || data == '\x1b[[E' {return 'f5'}
    if data == '\x1b[17~' {return 'f6'}
    if data == '\x1b[18~' {return 'f7'}
    if data == '\x1b[19~' {return 'f8'}
    if data == '\x1b[20~' {return 'f9'}
    if data == '\x1b[21~' {return 'f10'}
    if data == '\x1b[23~' {return 'f11'}
    if data == '\x1b[24~' {return 'f12'}
    if data == '\x1bb' {return 'alt+left'}
    if data == '\x1bf' {return 'alt+right'}
    if data == '\x1bp' {return 'alt+up'}
    if data == '\x1bn' {return 'alt+down'}
    if data == '\x1b[1;3D' || (!kitty_protocol_active && data == '\x1bB') {return 'alt+left'}
    if data == '\x1b[1;3C' || (!kitty_protocol_active && data == '\x1bF') {return 'alt+right'}
    if data == '\x1b[1;5D' || data == '\x1bOd' {return 'ctrl+left'}
    if data == '\x1b[1;5C' || data == '\x1bOc' {return 'ctrl+right'}
    if data == '\x1b[1;5A' || data == '\x1bOa' {return 'ctrl+up'}
    if data == '\x1b[1;5B' || data == '\x1bOb' {return 'ctrl+down'}
    if !kitty_protocol_active && data == '\x1b\r' {return 'alt+enter'}
    if !kitty_protocol_active && data == '\x1b ' {return 'alt+space'}
    if data == '\x1b\x7f' || data == '\x1b\b' {return 'alt+backspace'}
    if data == '\r' || (!kitty_protocol_active && data == '\n') || data == '\x1bOM' {return 'enter'}
    if data == '\t' {return 'tab'}
    if data == ' ' {return 'space'}
    if data == '\x7f' {return 'backspace'}
    if data == '\x08' {return is_windows_terminal_session() ? 'ctrl+backspace' : 'backspace'}
    if data == '\x00' {return 'ctrl+space'}
    if data == '\x1c' {return 'ctrl+\\'}
    if data == '\x1d' {return 'ctrl+]'}
    if data == '\x1f' {return 'ctrl+-'}
    if data == '\x1b\x1c' {return 'ctrl+alt+\\'}
    if data == '\x1b\x1d' {return 'ctrl+alt+]'}
    if data == '\x1b\x1f' {return 'ctrl+alt+-'}
    if data == '\x1b\x1b' {return 'ctrl+alt+['}
    if data.len() == 1 {
        int code = data[0] as int
        if code >= 1 && code <= 26 {
            int letter = code + 'a'.char() as int - 1
            return 'ctrl+' + ascii_char(letter)
        }
        if code >= 32 && code <= 126 {
            return data
        }
    }
    if !kitty_protocol_active && data.len() == 2 && data[0] == 0x1b {
        int code = data[1] as int
        if code >= 1 && code <= 26 {
            int letter = code + 'a'.char() as int - 1
            return 'ctrl+alt+' + ascii_char(letter)
        }
        bool lower = code >= 'a'.char() as int && code <= 'z'.char() as int
        bool digit = code >= '0'.char() as int && code <= '9'.char() as int
        if lower || digit || is_known_symbol(code) {
            return 'alt+' + data.slice(1, 2)
        }
    }
    return ''
}

fn canonical_key(string key_id): string {
    string key = key_id.to_lower()
    if key == 'esc' {return 'escape'}
    if key == 'return' {return 'enter'}
    if key == 'pageup' {return 'pageUp'}
    if key == 'pagedown' {return 'pageDown'}
    if key == 'ctrl+esc' {return 'ctrl+escape'}
    if key.contains('+') {
        int last = key.find_after('+', 0)
        for int cursor = 0; cursor < key.len(); cursor += 1 {
            if key[cursor] == '+'.char() {last = cursor}
        }
        string base = key.slice(last + 1, key.len())
        if base == 'esc' {base = 'escape'}
        if base == 'return' {base = 'enter'}
        if base == 'pageup' {base = 'pageUp'}
        if base == 'pagedown' {base = 'pageDown'}
        if base == '_' {base = '-'}
        string result = ''
        if key.contains('shift+') {result += 'shift+'}
        if key.contains('ctrl+') {result += 'ctrl+'}
        if key.contains('alt+') {result += 'alt+'}
        if key.contains('super+') {result += 'super+'}
        return result + base
    }
    return key
}

fn separator_at(string data, int start, int end): int {
    for int index = start; index < end; index += 1 {
        if data[index] == ';'.char() || data[index] == ':'.char() {
            return index
        }
    }
    return -1
}

fn find_byte(string data, u8 value, int start, int end): int {
    for int index = start; index < end; index += 1 {
        if data[index] == value {return index}
    }
    return -1
}

fn modifier_from_body(string data, int start, int end): int {
    int separator = -1
    for int index = start; index < end; index += 1 {
        if data[index] == ';'.char() {
            separator = index
            break
        }
    }
    if separator < 0 {
        return 0
    }
    int modifier_end = end
    for int index = separator + 1; index < end; index += 1 {
        if data[index] == ':'.char() {
            modifier_end = index
            break
        }
    }
    int value = parse_number(data, separator + 1, modifier_end)
    return value > 0 ? value - 1 : 0
}

fn parse_number(string data, int start, int end): int {
    if start >= end {
        return -1
    }
    int value = 0
    for int index = start; index < end; index += 1 {
        u8 byte = data[index]
        if byte < '0'.char() || byte > '9'.char() {
            return -1
        }
        int digit = byte as int - '0'.char() as int
        value = value * 10 + digit
    }
    return value
}

fn functional_codepoint(int value): int {
    if value == 2 {return CODE_INSERT}
    if value == 3 {return CODE_DELETE}
    if value == 5 {return CODE_PAGE_UP}
    if value == 6 {return CODE_PAGE_DOWN}
    if value == 7 {return CODE_HOME}
    if value == 8 {return CODE_END}
    return 0
}

fn normalize_kitty_codepoint(int codepoint): int {
    if codepoint >= 57399 && codepoint <= 57408 {return '0'.char() as int + codepoint - 57399}
    if codepoint == 57409 {return '.'.char() as int}
    if codepoint == 57410 {return '/'.char() as int}
    if codepoint == 57411 {return '*'.char() as int}
    if codepoint == 57412 {return '-'.char() as int}
    if codepoint == 57413 {return '+'.char() as int}
    if codepoint == 57415 {return '='.char() as int}
    if codepoint == 57416 {return ','.char() as int}
    if codepoint == 57417 {return CODE_LEFT}
    if codepoint == 57418 {return CODE_RIGHT}
    if codepoint == 57419 {return CODE_UP}
    if codepoint == 57420 {return CODE_DOWN}
    if codepoint == 57421 {return CODE_PAGE_UP}
    if codepoint == 57422 {return CODE_PAGE_DOWN}
    if codepoint == 57423 {return CODE_HOME}
    if codepoint == 57424 {return CODE_END}
    if codepoint == 57425 {return CODE_INSERT}
    if codepoint == 57426 {return CODE_DELETE}
    return codepoint
}

fn is_known_symbol(int codepoint): bool {
    string symbols = "`-=[]\\;',./!@#$%^&*()_+|~{}:<>?"
    return codepoint >= 0 && codepoint <= 127 && symbols.contains(ascii_char(codepoint))
}

fn format_codepoint_with_base(int codepoint, int modifier, int base_layout_key): string {
    int normalized = normalize_kitty_codepoint(codepoint)
    int identity = normalized
    int locks_removed = modifier & ~LOCK_MASK
    if (locks_removed & MOD_SHIFT) != 0 && identity >= 65 && identity <= 90 {
        identity += 32
    }
    bool authoritative = (identity >= 97 && identity <= 122) || (identity >= 48 && identity <= 57) || is_known_symbol(identity)
    int effective = authoritative || base_layout_key < 0 ? identity : base_layout_key
    return format_codepoint(effective, modifier)
}

fn format_codepoint(int codepoint, int modifier): string {
    int effective = normalize_kitty_codepoint(codepoint)
    int locks_removed = modifier & ~LOCK_MASK
    if (locks_removed & ~(MOD_SHIFT | MOD_ALT | MOD_CTRL | MOD_SUPER)) != 0 {
        return ''
    }
    if (locks_removed & MOD_SHIFT) != 0 && effective >= 65 && effective <= 90 {
        effective += 32
    }
    string key = ''
    if effective == CODE_ESCAPE {key = 'escape'} else if effective == CODE_TAB {key = 'tab'} else if effective == CODE_ENTER || effective == CODE_KP_ENTER {key = 'enter'} else if effective == CODE_SPACE {key = 'space'} else if effective == CODE_BACKSPACE {key = 'backspace'} else if effective == CODE_UP {key = 'up'} else if effective == CODE_DOWN {key = 'down'} else if effective == CODE_LEFT {key = 'left'} else if effective == CODE_RIGHT {key = 'right'} else if effective == CODE_DELETE {key = 'delete'} else if effective == CODE_INSERT {key = 'insert'} else if effective == CODE_PAGE_UP {key = 'pageUp'} else if effective == CODE_PAGE_DOWN {key = 'pageDown'} else if effective == CODE_HOME {key = 'home'} else if effective == CODE_END {key = 'end'} else if effective >= 97 && effective <= 122 {key = ascii_char(effective)} else if effective >= 48 && effective <= 57 {key = ascii_char(effective)} else if is_known_symbol(effective) {key = ascii_char(effective)}
    if key == '' {
        return ''
    }
    string result = ''
    if (locks_removed & MOD_SHIFT) != 0 {result += 'shift+'}
    if (locks_removed & MOD_CTRL) != 0 {result += 'ctrl+'}
    if (locks_removed & MOD_ALT) != 0 {result += 'alt+'}
    if (locks_removed & MOD_SUPER) != 0 {result += 'super+'}
    return result + key
}

fn is_windows_terminal_session(): bool {
    return syscall.get_env('WT_SESSION') != '' && syscall.get_env('SSH_CONNECTION') == '' && syscall.get_env('SSH_CLIENT') == '' && syscall.get_env('SSH_TTY') == ''
}

fn plain_printable(string data): string {
    if data == '' || data[0] == 0x1b {
        return ''
    }
    if data.len() > 0 && data[0] >= 32 {
        return data
    }
    return ''
}

fn ascii_char(int value): string {
    [u8] bytes = vec<u8>.cap_of(1)
    bytes.push(value as u8)
    return bytes as string
}

fn encode_codepoint(int codepoint): string {
    [u8] result = vec<u8>.cap_of(4)
    if codepoint <= 0x7f {
        result.push(codepoint as u8)
    } else if codepoint <= 0x7ff {
        result.push((0xc0 | (codepoint >> 6)) as u8)
        result.push((0x80 | (codepoint & 0x3f)) as u8)
    } else if codepoint <= 0xffff {
        result.push((0xe0 | (codepoint >> 12)) as u8)
        result.push((0x80 | ((codepoint >> 6) & 0x3f)) as u8)
        result.push((0x80 | (codepoint & 0x3f)) as u8)
    } else if codepoint <= 0x10ffff {
        result.push((0xf0 | (codepoint >> 18)) as u8)
        result.push((0x80 | ((codepoint >> 12) & 0x3f)) as u8)
        result.push((0x80 | ((codepoint >> 6) & 0x3f)) as u8)
        result.push((0x80 | (codepoint & 0x3f)) as u8)
    }
    return result as string
}
