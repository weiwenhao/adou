import adou.src.tui.unicode
import strings

pub type ansi_t = struct {
    bool found
    string code
    int length
}

pub type slice_t = struct {
    string text
    int width
}

pub type tracker_t = struct {
    string sgr_history
    bool underline
    string hyperlink
    string hyperlink_terminator
}

pub fn extract_ansi(string text, int position): ansi_t {
    if position < 0 || position >= text.len() || text[position] != 0x1b || position + 1 >= text.len() {
        return ansi_t{}
    }
    u8 family = text[position + 1]
    if family == '['.char() {
        for int cursor = position + 2; cursor < text.len(); cursor += 1 {
            u8 value = text[cursor]
            if value >= 0x40 && value <= 0x7e {
                return ansi_t {found: true, code: text.slice(position, cursor + 1), length: cursor + 1 - position,}
            }
        }
        return ansi_t{}
    }
    if family == ']'.char() || family == 'P'.char() || family == '_'.char() {
        for int cursor = position + 2; cursor < text.len(); cursor += 1 {
            if text[cursor] == 0x07 {
                return ansi_t {found: true, code: text.slice(position, cursor + 1), length: cursor + 1 - position,}
            }
            if text[cursor] == 0x1b && cursor + 1 < text.len() && text[cursor + 1] == '\\'.char() {
                return ansi_t {found: true, code: text.slice(position, cursor + 2), length: cursor + 2 - position,}
            }
        }
        return ansi_t{}
    }
    if family == 'O'.char() && position + 2 < text.len() {
        return ansi_t {found: true, code: text.slice(position, position + 3), length: 3,}
    }
    return ansi_t {found: true, code: text.slice(position, position + 2), length: 2,}
}

pub fn visible_width(string text): int! {
    if text == '' {
        return 0
    }
    // Most transcript rows are plain UTF-8. Avoid rebuilding those rows one
    // byte at a time before handing them to ICU; large tool results can
    // otherwise turn one width check into tens of thousands of allocations.
    if text.find('\x1b') < 0 && text.find('\t') < 0 {
        return unicode.visible_width(text)
    }
    [string] clean_parts = vec<string>.cap_of(8)
    int cursor = 0
    int plain_start = 0
    for cursor < text.len() {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            if plain_start < cursor {
                clean_parts.push(text.slice(plain_start, cursor))
            }
            cursor += ansi.length
            plain_start = cursor
            continue
        }
        if text[cursor] == '\t'.char() {
            if plain_start < cursor {
                clean_parts.push(text.slice(plain_start, cursor))
            }
            clean_parts.push('   ')
            cursor += 1
            plain_start = cursor
            continue
        }
        cursor += 1
    }
    if plain_start < text.len() {
        clean_parts.push(text.slice(plain_start, text.len()))
    }
    return unicode.visible_width(strings.join(clean_parts, ''))
}

pub fn normalize_terminal_output(string text): string {
    if text.find('\x1b') < 0 && text.find('\t') < 0 && text.find('ำ') < 0 && text.find('ຳ') < 0 {
        return text
    }
    [string] parts = vec<string>.cap_of(8)
    int cursor = 0
    int plain_start = 0
    for cursor < text.len() {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            if plain_start < cursor {
                parts.push(text.slice(plain_start, cursor))
            }
            parts.push(ansi.code)
            cursor += ansi.length
            plain_start = cursor
            continue
        }
        if cursor + 3 <= text.len() && text.slice(cursor, cursor + 3) == 'ำ' {
            if plain_start < cursor {
                parts.push(text.slice(plain_start, cursor))
            }
            parts.push('ํา')
            cursor += 3
            plain_start = cursor
            continue
        }
        if cursor + 3 <= text.len() && text.slice(cursor, cursor + 3) == 'ຳ' {
            if plain_start < cursor {
                parts.push(text.slice(plain_start, cursor))
            }
            parts.push('ໍາ')
            cursor += 3
            plain_start = cursor
            continue
        }
        if text[cursor] == '\t'.char() {
            if plain_start < cursor {
                parts.push(text.slice(plain_start, cursor))
            }
            parts.push('   ')
            cursor += 1
            plain_start = cursor
            continue
        }
        cursor += 1
    }
    if plain_start < text.len() {
        parts.push(text.slice(plain_start, text.len()))
    }
    return strings.join(parts, '')
}

pub fn truncate_to_width(string text, int maximum, string ellipsis, bool pad): string! {
    if maximum <= 0 {
        return ''
    }
    int text_width = visible_width(text)
    if text_width <= maximum {
        return pad ? text + spaces(maximum - text_width) : text
    }
    int ellipsis_width = visible_width(ellipsis)
    if ellipsis_width >= maximum {
        var clipped = fragment_to_width(ellipsis, maximum)
        return pad ? clipped.text + spaces(maximum - clipped.width) : clipped.text
    }
    var prefix = fragment_to_width(text, maximum - ellipsis_width)
    string result = prefix.text + '\x1b[0m' + ellipsis + '\x1b[0m'
    return pad ? result + spaces(maximum - prefix.width - ellipsis_width) : result
}

pub fn slice_with_width(string text, int start_column, int length, bool strict): slice_t! {
    if length <= 0 {
        return slice_t{}
    }
    int end_column = start_column + length
    int current_column = 0
    int cursor = 0
    string pending_ansi = ''
    string result = ''
    int result_width = 0
    for cursor < text.len() && current_column < end_column {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            if current_column >= start_column && current_column < end_column {result += ansi.code} else if current_column < start_column {pending_ansi += ansi.code}
            cursor += ansi.length
            continue
        }
        int end = next_ansi_or_end(text, cursor)
        var graphemes = unicode.graphemes(text.slice(cursor, end))
        for grapheme in graphemes {
            string value = text.slice(cursor + grapheme.start, cursor + grapheme.end)
            int width = unicode.grapheme_width(value)
            bool in_range = current_column >= start_column && current_column < end_column
            bool fits = !strict || current_column + width <= end_column
            if in_range && fits {
                if pending_ansi != '' {
                    result += pending_ansi
                    pending_ansi = ''
                }
                result += value
                result_width += width
            }
            current_column += width
            if current_column >= end_column {
                break
            }
        }
        cursor = end
    }
    return slice_t {text: result, width: result_width,}
}

pub fn wrap_text_with_ansi(string text, int width): [string]! {
    if text == '' {
        return ['']
    }
    if width <= 0 {
        return ['']
    }
    [string] result = vec<string>.cap_of(8)
    var input_lines = split_lines(text)
    var tracker = new tracker_t()
    for input_line in input_lines {
        string prefix = ''
        if result.len() > 0 {
            prefix = tracker.active_codes()
        }
        var wrapped = wrap_single_line(prefix + input_line, width)
        for line in wrapped {
            result.push(line)
        }
        tracker.update(input_line)
    }
    return result.len() > 0 ? result : ['']
}

fn fragment_to_width(string text, int maximum): slice_t! {
    if maximum <= 0 || text == '' {
        return slice_t{}
    }
    string result = ''
    string pending_ansi = ''
    int width = 0
    int cursor = 0
    for cursor < text.len() {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            pending_ansi += ansi.code
            cursor += ansi.length
            continue
        }
        if text[cursor] == '\t'.char() {
            if width + 3 > maximum {
                break
            }
            result += pending_ansi + '\t'
            pending_ansi = ''
            width += 3
            cursor += 1
            continue
        }
        int end = next_ansi_or_tab_or_end(text, cursor)
        var graphemes = unicode.graphemes(text.slice(cursor, end))
        bool stopped = false
        for grapheme in graphemes {
            string value = text.slice(cursor + grapheme.start, cursor + grapheme.end)
            int grapheme_width = unicode.grapheme_width(value)
            if width + grapheme_width > maximum {
                stopped = true
                break
            }
            result += pending_ansi + value
            pending_ansi = ''
            width += grapheme_width
        }
        if stopped {
            break
        }
        cursor = end
    }
    return slice_t {text: result, width: width,}
}

fn wrap_single_line(string line, int width): [string]! {
    if line == '' {
        return ['']
    }
    if visible_width(line) <= width {
        return [line]
    }
    // A long unbroken UTF-8 word is common while an assistant streams a
    // token at a time.  The general tokenizer appends every grapheme to a
    // growing string, which makes each redraw increasingly expensive.  Slice
    // the original string at grapheme boundaries instead.
    if line.find('\x1b') < 0 && line.find('\t') < 0 && line.find(' ') < 0 {
        return break_plain_word(line, width)
    }
    if line.find('\x1b') >= 0 && line.find('\t') < 0 && line.find(' ') < 0 {
        return break_long_word(line, width, '', false, '', '')
    }
    var tokens = split_tokens(line)
    [string] result = vec<string>.cap_of(8)
    var tracker = new tracker_t()
    string current = ''
    int current_width = 0
    for token in tokens {
        int token_width = visible_width(token)
        bool whitespace = visible_text_is_spaces(token)
        if token_width > width && !whitespace {
            if current != '' {
                result.push(trim_spaces_end(current) + tracker.line_end_reset())
                current = ''
                current_width = 0
            }
            var broken = break_long_word(token, width, tracker.sgr_history, tracker.underline, tracker.hyperlink, tracker.hyperlink_terminator)
            for int index = 0; index < broken.len() - 1; index += 1 {
                result.push(broken[index])
            }
            current = broken[broken.len() - 1]
            current_width = visible_width(current)
            tracker.update(token)
            continue
        }
        if current_width + token_width > width && current_width > 0 {
            result.push(trim_spaces_end(current) + tracker.line_end_reset())
            if whitespace {
                current = tracker.active_codes()
                current_width = 0
            } else {
                current = tracker.active_codes() + token
                current_width = token_width
            }
        } else {
            current += token
            current_width += token_width
        }
        tracker.update(token)
    }
    if current != '' {
        result.push(current)
    }
    if result.len() == 0 {
        result.push('')
    }
    for int index = 0; index < result.len(); index += 1 {
        result[index] = trim_spaces_end(result[index])
    }
    return result
}

fn break_plain_word(string word, int width): [string]! {
    if is_ascii_text(word) {
        [string] lines = vec<string>.cap_of((word.len() + width - 1) / width)
        for int start = 0; start < word.len(); start += width {
            int end = start + width
            if end > word.len() {
                end = word.len()
            }
            lines.push(word.slice(start, end))
        }
        return lines.len() > 0 ? lines : ['']
    }
    [string] lines = vec<string>.cap_of(8)
    int segment_start = 0
    int cursor = 0
    int current_width = 0
    var graphemes = unicode.graphemes(word)
    for grapheme in graphemes {
        string value = word.slice(grapheme.start, grapheme.end)
        int value_width = unicode.grapheme_width(value)
        if current_width + value_width > width && current_width > 0 {
            lines.push(word.slice(segment_start, cursor))
            segment_start = cursor
            current_width = 0
        }
        cursor = grapheme.end
        current_width += value_width
    }
    if segment_start < word.len() {
        lines.push(word.slice(segment_start, word.len()))
    }
    return lines.len() > 0 ? lines : ['']
}

fn split_tokens(string text): [string]! {
    if text.find('\x1b') < 0 && text.find('\t') < 0 {
        return split_plain_tokens(text)
    }
    [string] tokens = vec<string>.cap_of(16)
    [string] current_parts = vec<string>.cap_of(16)
    string pending_ansi = ''
    int current_kind = 0
    int cursor = 0
    for cursor < text.len() {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            pending_ansi += ansi.code
            cursor += ansi.length
            continue
        }
        int end = next_ansi_or_end(text, cursor)
        var graphemes = unicode.graphemes(text.slice(cursor, end))
        for grapheme in graphemes {
            string value = text.slice(cursor + grapheme.start, cursor + grapheme.end)
            bool space = value == ' '
            if !space && unicode.is_cjk_break(value) {
                if current_parts.len() > 0 {
                    tokens.push(strings.join(current_parts, ''))
                    current_parts = vec<string>.cap_of(16)
                    current_kind = 0
                }
                tokens.push(pending_ansi + value)
                pending_ansi = ''
                continue
            }
            int kind = space ? 1 : 2
            if current_parts.len() > 0 && current_kind != kind {
                tokens.push(strings.join(current_parts, ''))
                current_parts = vec<string>.cap_of(16)
            }
            current_parts.push(pending_ansi + value)
            pending_ansi = ''
            current_kind = kind
        }
        cursor = end
    }
    if pending_ansi != '' {
        if current_parts.len() > 0 {current_parts.push(pending_ansi)} else if tokens.len() > 0 {tokens[tokens.len() - 1] += pending_ansi} else {current_parts.push(pending_ansi)}
    }
    if current_parts.len() > 0 {
        tokens.push(strings.join(current_parts, ''))
    }
    return tokens
}

fn split_plain_tokens(string text): [string]! {
    if is_ascii_text(text) {
        return split_ascii_tokens(text)
    }
    [string] tokens = vec<string>.cap_of(16)
    int start = -1
    int kind = 0
    var graphemes = unicode.graphemes(text)
    for grapheme in graphemes {
        string value = text.slice(grapheme.start, grapheme.end)
        bool space = value == ' '
        if !space && unicode.is_cjk_break(value) {
            if start >= 0 {
                tokens.push(text.slice(start, grapheme.start))
                start = -1
                kind = 0
            }
            tokens.push(value)
            continue
        }
        int next_kind = space ? 1 : 2
        if start >= 0 && kind != next_kind {
            tokens.push(text.slice(start, grapheme.start))
            start = grapheme.start
        } else if start < 0 {
            start = grapheme.start
        }
        kind = next_kind
    }
    if start >= 0 {
        tokens.push(text.slice(start, text.len()))
    }
    return tokens
}

fn split_ascii_tokens(string text): [string]! {
    [string] tokens = vec<string>.cap_of(16)
    int start = -1
    int kind = 0
    for int cursor = 0; cursor <= text.len(); cursor += 1 {
        if cursor == text.len() {
            if start >= 0 {
                tokens.push(text.slice(start, cursor))
            }
            break
        }
        bool space = text[cursor] == ' '.char()
        int next_kind = space ? 1 : 2
        if start >= 0 && kind != next_kind {
            tokens.push(text.slice(start, cursor))
            start = cursor
        } else if start < 0 {
            start = cursor
        }
        kind = next_kind
    }
    return tokens
}

fn break_long_word(string word, int width, string sgr_history, bool underline, string hyperlink, string hyperlink_terminator): [string]! {
    if is_ascii_text(word) {
        return break_ascii_ansi_word(word, width, sgr_history, underline, hyperlink, hyperlink_terminator)
    }
    [string] lines = vec<string>.cap_of(8)
    var tracker = new tracker_t(sgr_history = sgr_history, underline = underline, hyperlink = hyperlink, hyperlink_terminator = hyperlink_terminator)
    [string] current_parts = vec<string>.cap_of(16)
    current_parts.push(tracker.active_codes())
    int current_width = 0
    int cursor = 0
    for cursor < word.len() {
        var ansi = extract_ansi(word, cursor)
        if ansi.found {
            current_parts.push(ansi.code)
            tracker.process(ansi.code)
            cursor += ansi.length
            continue
        }
        int end = next_ansi_or_end(word, cursor)
        var graphemes = unicode.graphemes(word.slice(cursor, end))
        for grapheme in graphemes {
            string value = word.slice(cursor + grapheme.start, cursor + grapheme.end)
            int grapheme_width = unicode.grapheme_width(value)
            if current_width + grapheme_width > width && current_width > 0 {
                lines.push(strings.join(current_parts, '') + tracker.line_end_reset())
                current_parts = vec<string>.cap_of(16)
                current_parts.push(tracker.active_codes())
                current_width = 0
            }
            current_parts.push(value)
            current_width += grapheme_width
        }
        cursor = end
    }
    if current_parts.len() > 0 {
        lines.push(strings.join(current_parts, ''))
    }
    return lines.len() > 0 ? lines : ['']
}

fn break_ascii_ansi_word(string word, int width, string sgr_history, bool underline, string hyperlink, string hyperlink_terminator): [string]! {
    [string] lines = vec<string>.cap_of(8)
    var tracker = new tracker_t(sgr_history = sgr_history, underline = underline, hyperlink = hyperlink, hyperlink_terminator = hyperlink_terminator)
    [string] current_parts = vec<string>.cap_of(8)
    int current_width = 0
    int remaining_visible = ascii_visible_length(word)
    int cursor = 0
    for cursor < word.len() {
        var ansi = extract_ansi(word, cursor)
        if ansi.found {
            if current_width >= width && remaining_visible > 0 {
                lines.push(strings.join(current_parts, '') + tracker.line_end_reset())
                current_parts = vec<string>.cap_of(8)
                current_width = 0
                current_parts.push(tracker.active_codes())
            }
            current_parts.push(ansi.code)
            tracker.process(ansi.code)
            cursor += ansi.length
            continue
        }
        int end = next_ansi_or_end(word, cursor)
        int plain_cursor = cursor
        for plain_cursor < end {
            int available = width - current_width
            if available <= 0 {
                lines.push(strings.join(current_parts, '') + tracker.line_end_reset())
                current_parts = vec<string>.cap_of(8)
                current_width = 0
                current_parts.push(tracker.active_codes())
                available = width
            }
            int remaining = end - plain_cursor
            int take = remaining < available ? remaining : available
            current_parts.push(word.slice(plain_cursor, plain_cursor + take))
            current_width += take
            remaining_visible -= take
            plain_cursor += take
        }
        cursor = end
    }
    if current_parts.len() > 0 {
        lines.push(strings.join(current_parts, ''))
    }
    return lines.len() > 0 ? lines : ['']
}

fn ascii_visible_length(string text): int {
    int visible = 0
    int cursor = 0
    for cursor < text.len() {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            cursor += ansi.length
            continue
        }
        int end = next_ansi_or_end(text, cursor)
        visible += end - cursor
        cursor = end
    }
    return visible
}

fn is_ascii_text(string text): bool {
    for int cursor = 0; cursor < text.len(); cursor += 1 {
        if text[cursor] >= 0x80 {
            return false
        }
    }
    return true
}

pub fn tracker_t.update(&self, string text) {
    int cursor = 0
    for cursor < text.len() {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            self.process(ansi.code)
            cursor += ansi.length
        } else {
            cursor += 1
        }
    }
}

pub fn tracker_t.process(&self, string code) {
    if code.contains('\x1b]8;') {
        bool close = code.contains('\x1b]8;;\x07') || code.contains('\x1b]8;;\x1b\\')
        if close {
            self.hyperlink = ''
            self.hyperlink_terminator = ''
        } else {
            self.hyperlink = code
            self.hyperlink_terminator = code.len() > 0 && code[code.len() - 1] == 0x07 ? '\x07' : '\x1b\\'
        }
        return
    }
    if code.len() < 3 || code[1] != '['.char() || code[code.len() - 1] != 'm'.char() {
        return
    }
    string parameters = code.slice(2, code.len() - 1)
    bool full_reset = parameters == ''
    var parts = parameters.split(';')
    for part in parts {
        int value = parse_sgr_value(part)
        if value == 0 {
            full_reset = true
            self.underline = false
        } else if value == 4 {
            self.underline = true
        } else if value == 24 {
            self.underline = false
        }
    }
    self.sgr_history = full_reset ? code : self.sgr_history + code
}

pub fn tracker_t.active_codes(&self): string {
    return self.sgr_history + self.hyperlink
}

pub fn tracker_t.line_end_reset(&self): string {
    string result = self.underline ? '\x1b[24m' : ''
    if self.hyperlink != '' {
        result += '\x1b]8;;' + self.hyperlink_terminator
    }
    return result
}

pub fn split_lines(string text): [string] {
    [string] result = vec<string>.cap_of(8)
    int start = 0
    int cursor = 0
    for cursor < text.len() {
        if text[cursor] == '\r'.char() || text[cursor] == '\n'.char() {
            result.push(text.slice(start, cursor))
            if text[cursor] == '\r'.char() && cursor + 1 < text.len() && text[cursor + 1] == '\n'.char() {
                cursor += 1
            }
            start = cursor + 1
        }
        cursor += 1
    }
    result.push(text.slice(start, text.len()))
    return result
}

fn next_ansi_or_end(string text, int start): int {
    int cursor = start
    for cursor < text.len() {
        if text[cursor] == 0x1b {
            break
        }
        cursor += 1
    }
    return cursor
}

fn next_ansi_or_tab_or_end(string text, int start): int {
    int cursor = start
    for cursor < text.len() {
        if text[cursor] == 0x1b || text[cursor] == '\t'.char() {
            break
        }
        cursor += 1
    }
    return cursor
}

fn visible_text_is_spaces(string text): bool {
    int cursor = 0
    bool saw = false
    for cursor < text.len() {
        var ansi = extract_ansi(text, cursor)
        if ansi.found {
            cursor += ansi.length
            continue
        }
        saw = true
        if text[cursor] != ' '.char() && text[cursor] != '\t'.char() {
            return false
        }
        cursor += 1
    }
    return saw
}

fn trim_spaces_end(string text): string {
    int end = text.len()
    for end > 0 && (text[end - 1] == ' '.char() || text[end - 1] == '\t'.char()) {
        end -= 1
    }
    return text.slice(0, end)
}

pub fn spaces(int count): string {
    string result = ''
    for int index = 0; index < count; index += 1 {
        result += ' '
    }
    return result
}

fn parse_sgr_value(string value): int {
    if value == '' {
        return 0
    }
    return value.to_int() catch e {
        return -1
    }
}

// Pi's visual-truncate.ts truncateToVisualLines: keep the last N *visual*
// lines (after width wrapping) of a multi-line text and report how many
// were skipped.  Returns (truncated text, skipped visual lines).
pub fn truncate_visual_lines(string text, int width, int max_visual_lines): (string, int)! {
    if text == '' {
        return ('', 0)
    }
    if max_visual_lines <= 0 {
        return ('', 0)
    }
    // Keep only the tail window while wrapping. The old implementation built
    // every visual row before slicing the last few, so a growing streamed
    // line caused each redraw to retain an unnecessary full row vector.
    [string] tail = vec<string>.cap_of(max_visual_lines)
    var tracker = new tracker_t()
    int total = 0
    for input_line in split_lines(text) {
        string prefix = total > 0 ? tracker.active_codes() : ''
        var wrapped = wrap_single_line(prefix + input_line, width)
        for line in wrapped {
            if tail.len() >= max_visual_lines {
                tail = tail.slice(1, tail.len())
            }
            tail.push(line)
            total += 1
        }
        tracker.update(input_line)
    }
    if total <= max_visual_lines {
        return (text, 0)
    }
    return (strings.join(tail, '\n'), total - max_visual_lines)
}


// Pi tui.ts CURSOR_MARKER: a focused component embeds this sentinel where
// the hardware cursor belongs; the renderer locates it, converts the prefix
// width to a visual column, and strips it before painting.
pub const CURSOR_MARKER = '\x1b_pi:c\x07'

pub type cursor_hit_t = struct {
    int row
    int col
}

// Scan the visible viewport (bottom `height` lines of `lines`) from the
// bottom up for the marker; return its row and visual column with the
// marker stripped out of `lines`.  Returns an empty hit when absent.
pub fn find_cursor_marker([string] lines, int height): cursor_hit_t! {
    cursor_hit_t miss = cursor_hit_t {row: -1, col: -1}
    if height <= 0 || lines.len() == 0 {
        return miss
    }
    int viewport_top = 0
    if lines.len() > height {
        viewport_top = lines.len() - height
    }
    for int row = lines.len() - 1; row >= viewport_top; row -= 1 {
        int index = lines[row].find(CURSOR_MARKER)
        if index < 0 {
            continue
        }
        var hit = cursor_hit_t {row: row, col: visible_width(lines[row].slice(0, index))}
        lines[row] = lines[row].slice(0, index) + lines[row].slice(index + CURSOR_MARKER.len(), lines[row].len())
        return hit
    }
    return miss
}
