import adou.src.tools.command
import adou.src.tools.image_detect
import base64
import fmt
import libc
import strings
import syscall
import time

// Port of vendors/pi/packages/tui/src/terminal-image.ts: terminal capability
// detection, Kitty/iTerm2 encoding and image dimension parsing. Session view
// integration renders attachments through this module with a text fallback.

pub type image_dimensions_t = struct {
    int width_px
    int height_px
}

pub type cell_dimensions_t = struct {
    int width_px
    int height_px
}

// Capabilities are probed once per process (Pi caches them too); tests can
// reset or override the cached result.
pub fn detect_capabilities(): (string, bool, bool) {
    if capabilities_cached {
        return (cached_images, cached_true_color, cached_hyperlinks)
    }
    var detected = probe_capabilities()
    cached_images = detected[0]
    cached_true_color = detected[1]
    cached_hyperlinks = detected[2]
    capabilities_cached = true
    return detected
}

pub fn reset_capabilities_cache() {
    capabilities_cached = false
}

pub fn set_capabilities(string images, bool true_color, bool hyperlinks) {
    cached_images = images
    cached_true_color = true_color
    cached_hyperlinks = hyperlinks
    capabilities_cached = true
}

string cached_images = ''
bool cached_true_color = false
bool cached_hyperlinks = false
bool capabilities_cached = false

fn probe_capabilities(): (string, bool, bool) {
    string term_program = syscall.get_env('TERM_PROGRAM').to_lower()
    string terminal_emulator = syscall.get_env('TERMINAL_EMULATOR').to_lower()
    string term = syscall.get_env('TERM').to_lower()
    string color_term = syscall.get_env('COLORTERM').to_lower()
    bool has_true_color = color_term == 'truecolor' || color_term == '24bit'
    string tmux = syscall.get_env('TMUX')
    if tmux != '' || term.starts_with('tmux') {
        return ('', has_true_color, probe_tmux_hyperlinks())
    }
    if term.starts_with('screen') {
        return ('', has_true_color, false)
    }
    if syscall.get_env('KITTY_WINDOW_ID') != '' || term_program == 'kitty' {
        return ('kitty', true, true)
    }
    if term_program == 'ghostty' || term.contains('ghostty') || syscall.get_env('GHOSTTY_RESOURCES_DIR') != '' {
        return ('kitty', true, true)
    }
    if syscall.get_env('WEZTERM_PANE') != '' || term_program == 'wezterm' {
        return ('kitty', true, true)
    }
    if term_program == 'warpterminal' || syscall.get_env('WARP_SESSION_ID') != '' || syscall.get_env('WARP_TERMINAL_SESSION_UUID') != '' {
        return ('kitty', true, true)
    }
    if syscall.get_env('ITERM_SESSION_ID') != '' || term_program == 'iterm.app' {
        return ('iterm2', true, true)
    }
    if syscall.get_env('WT_SESSION') != '' {
        return ('', true, true)
    }
    if term_program == 'vscode' {
        return ('', true, true)
    }
    if term_program == 'alacritty' {
        return ('', true, true)
    }
    if terminal_emulator == 'jetbrains-jediterm' {
        return ('', true, false)
    }
    return ('', has_true_color, false)
}

pub fn probe_tmux_hyperlinks(): bool {
    var result = command.argv(syscall.get_env('HOME'), 'tmux', ['display-message', '-p', '#{client_termfeatures}']) catch error {
        return false
    }
    if result.exit_code != 0 {
        return false
    }
    for feature in result.stdout.split(',') {
        if feature.trim([' ', '\t', '\n', '\r']) == 'hyperlinks' {
            return true
        }
    }
    return false
}

pub fn allocate_image_id(): int {
    // Pi uses a random id to avoid collisions between module instances.
    i32 random_value = libc.rand()
    int random = random_value as int
    if random < 0 {
        random = -random
    }
    return (random % 0xfffffffe) + 1
}

cell_dimensions_t cell_dimensions_value = cell_dimensions_t {width_px: 9, height_px: 18}

pub fn get_cell_dimensions(): cell_dimensions_t {
    return cell_dimensions_value
}

pub fn set_cell_dimensions(cell_dimensions_t dimensions) {
    cell_dimensions_value = dimensions
}

// Pi's calculateImageRows: rows for a width-constrained render that keeps
// the aspect ratio (no height cap).
pub fn calculate_image_rows(image_dimensions_t image, int target_width_cells, cell_dimensions_t cell): int {
    var size = calculate_image_cell_size(image, target_width_cells, 0, cell)
    return size[1]
}

// An image line starts with (or contains) a kitty or iTerm2 sequence.
pub fn is_image_line(string line): bool {
    return line.starts_with('\x1b_G') || line.starts_with('\x1b]1337;File=') || line.contains('\x1b_G') || line.contains('\x1b]1337;File=')
}

// Pi's hyperlink(): OSC 8 clickable link.
pub fn hyperlink(string text, string url): string {
    return '\x1b]8;;' + url + '\x1b\\' + text + '\x1b]8;;\x1b\\'
}

// Pi's imageFallback(): "[Image: ~/path [mime] WxH]" with the path linked
// via file:// when hyperlinks are supported.
pub fn image_fallback(string mime_type, image_dimensions_t? dimensions, string filename): string {
    [string] parts = []
    if filename != '' {
        string display = shorten_home_path(filename)
        var caps = detect_capabilities()
        if caps[2] && filename.starts_with('/') {
            parts.push(hyperlink(display, 'file://' + filename))
        } else {
            parts.push(display)
        }
    }
    parts.push('[' + mime_type + ']')
    if dimensions is image_dimensions_t known {
        parts.push(fmt.sprintf('%dx%d', known.width_px, known.height_px))
    }
    return '[Image: ' + strings.join(parts, ' ') + ']'
}

fn shorten_home_path(string filename): string {
    string home = syscall.get_env('HOME')
    if home != '' && (filename == home || filename.starts_with(home + '/')) {
        return '~' + filename.slice(home.len(), filename.len())
    }
    return filename
}

// Pi's renderImage(): dispatch to kitty or iTerm2 encoding with the size
// computed from the cell dimensions; null when the terminal has no images.
pub type image_render_result_t = struct {
    string sequence
    int rows
    int image_id
}

pub fn render_image(string base64_data, image_dimensions_t image, int max_width_cells, int max_height_cells, int image_id, bool move_cursor): image_render_result_t? {
    var caps = detect_capabilities()
    if caps[0] == '' {
        return null
    }
    var cell = get_cell_dimensions()
    var size = calculate_image_cell_size(image, max_width_cells, max_height_cells, cell)
    if caps[0] == 'kitty' {
        int id = image_id > 0 ? image_id : allocate_image_id()
        record_kitty_placement(id)
        return image_render_result_t {sequence: encode_kitty(base64_data, size[0], size[1], id, move_cursor), rows: size[1], image_id: id,}
    }
    if caps[0] == 'iterm2' {
        return image_render_result_t {sequence: encode_iterm2(base64_data, fmt.sprintf('%d', size[0]), 'auto', '', true), rows: size[1], image_id: 0,}
    }
    return null
}

pub fn encode_kitty(string base64_data, int columns, int rows, int image_id, bool move_cursor): string {
    [string] params = ['a=T', 'f=100', 'q=2']
    if !move_cursor {
        params.push('C=1')
    }
    if columns > 0 {
        params.push('c=' + fmt_int(columns))
    }
    if rows > 0 {
        params.push('r=' + fmt_int(rows))
    }
    if image_id > 0 {
        params.push('i=' + fmt_int(image_id))
    }
    if base64_data.len() <= 4096 {
        return '\x1b_G' + strings.join(params, ',') + ';' + base64_data + '\x1b\\'
    }
    string result = ''
    int offset = 0
    bool first = true
    for offset < base64_data.len() {
        int end = offset + 4096
        if end > base64_data.len() {
            end = base64_data.len()
        }
        string chunk = base64_data.slice(offset, end)
        bool is_last = end >= base64_data.len()
        if first {
            result += '\x1b_G' + strings.join(params, ',') + ',m=1;' + chunk + '\x1b\\'
            first = false
        } else if is_last {
            result += '\x1b_Gm=0;' + chunk + '\x1b\\'
        } else {
            result += '\x1b_Gm=1;' + chunk + '\x1b\\'
        }
        offset = end
    }
    return result
}

pub fn delete_kitty_image(int image_id): string {
    return '\x1b_Ga=d,d=I,i=' + fmt_int(image_id) + ',q=2\x1b\\'
}

pub fn delete_all_kitty_images(): string {
    return '\x1b_Ga=d,d=A,q=2\x1b\\'
}

pub fn encode_iterm2(string base64_data, string width, string height, string name, bool preserve_aspect_ratio): string {
    [string] params = []
    params.push('inline=1')
    if width != '' {
        params.push('width=' + width)
    }
    if height != '' {
        params.push('height=' + height)
    }
    if name != '' {
        var encoded = base64.encode(name as [u8]) catch error {
            return ''
        }
        params.push('name=' + encoded as string)
    }
    if !preserve_aspect_ratio {
        params.push('preserveAspectRatio=0')
    }
    return '\x1b]1337;File=' + strings.join(params, ';') + ':' + base64_data + '\x07'
}

pub fn calculate_image_cell_size(image_dimensions_t image, int max_width_cells, int max_height_cells, cell_dimensions_t cell): (int, int) {
    int max_width = max_width_cells > 1 ? max_width_cells : 1
    int image_width = image.width_px > 1 ? image.width_px : 1
    int image_height = image.height_px > 1 ? image.height_px : 1
    float width_scale = (max_width * cell.width_px) as float / (image_width as float)
    // Pi keeps the aspect ratio when no height cap is given (maxHeightCells
    // undefined); a positive cap constrains both axes.
    float height_scale = width_scale
    if max_height_cells > 1 {
        height_scale = (max_height_cells * cell.height_px) as float / (image_height as float)
    }
    float scale = width_scale < height_scale ? width_scale : height_scale
    float scaled_width = (image_width as float) * scale
    float scaled_height = (image_height as float) * scale
    int columns = ceil_div(scaled_width, cell.width_px as float)
    int rows = ceil_div(scaled_height, cell.height_px as float)
    if columns > max_width {
        columns = max_width
    }
    if max_height_cells > 1 && rows > max_height_cells {
        rows = max_height_cells
    }
    if columns < 1 {
        columns = 1
    }
    if rows < 1 {
        rows = 1
    }
    return (columns, rows)
}

fn ceil_div(float value, float divisor): int {
    int result = (value / divisor) as int
    if (value / divisor) > (result as float) {
        result += 1
    }
    return result
}

pub fn get_image_dimensions(string base64_data, string mime_type): image_dimensions_t? {
    if mime_type == 'image/png' {
        return get_png_dimensions(base64_data)
    }
    if mime_type == 'image/jpeg' {
        return get_jpeg_dimensions(base64_data)
    }
    if mime_type == 'image/gif' {
        return get_gif_dimensions(base64_data)
    }
    if mime_type == 'image/webp' {
        return get_webp_dimensions(base64_data)
    }
    return null
}

pub fn get_png_dimensions(string base64_data): image_dimensions_t? {
    var bytes = base64.decode(base64_data as [u8]) catch error {
        return null
    }
    if bytes.len() < 24 {
        return null
    }
    if bytes[0] != 0x89 || bytes[1] != 0x50 || bytes[2] != 0x4e || bytes[3] != 0x47 {
        return null
    }
    int width = read_uint32_be(bytes, 16)
    int height = read_uint32_be(bytes, 20)
    return image_dimensions_t {width_px: width, height_px: height}
}

pub fn get_jpeg_dimensions(string base64_data): image_dimensions_t? {
    var bytes = base64.decode(base64_data as [u8]) catch error {
        return null
    }
    if bytes.len() < 2 || bytes[0] != 0xff || bytes[1] != 0xd8 {
        return null
    }
    int offset = 2
    for offset < bytes.len() - 9 {
        if bytes[offset] != 0xff {
            offset += 1
            continue
        }
        if bytes[offset + 1] == 0xff {
            offset += 1
            continue
        }
        int marker = bytes[offset + 1] as int
        if marker >= 0xd0 && marker <= 0xd9 {
            offset += 2
            continue
        }
        if marker == 0x01 {
            offset += 2
            continue
        }
        if offset + 4 > bytes.len() {
            return null
        }
        int length = read_uint16_be(bytes, offset + 2)
        if marker >= 0xc0 && marker <= 0xc3 || marker >= 0xc5 && marker <= 0xc7 || marker >= 0xc9 && marker <= 0xcb || marker >= 0xcd && marker <= 0xcf {
            if offset + 9 > bytes.len() {
                return null
            }
            int height = read_uint16_be(bytes, offset + 5)
            int width = read_uint16_be(bytes, offset + 7)
            return image_dimensions_t {width_px: width, height_px: height}
        }
        if length < 2 {
            return null
        }
        offset += 2 + length
    }
    return null
}

pub fn get_gif_dimensions(string base64_data): image_dimensions_t? {
    var bytes = base64.decode(base64_data as [u8]) catch error {
        return null
    }
    if bytes.len() < 10 {
        return null
    }
    // Pi validates the GIF87a / GIF89a signature before reading the size.
    string signature = bytes.slice(0, 6) as string
    if signature != 'GIF87a' && signature != 'GIF89a' {
        return null
    }
    int width = read_uint16_le(bytes, 6)
    int height = read_uint16_le(bytes, 8)
    return image_dimensions_t {width_px: width, height_px: height}
}

pub fn get_webp_dimensions(string base64_data): image_dimensions_t? {
    var bytes = base64.decode(base64_data as [u8]) catch error {
        return null
    }
    if bytes.len() < 30 {
        return null
    }
    // RIFF....WEBP container validation (Pi checks the header too).
    if (bytes.slice(0, 4) as string) != 'RIFF' || (bytes.slice(8, 12) as string) != 'WEBP' {
        return null
    }
    string chunk = bytes.slice(12, 16) as string
    if chunk == 'VP8 ' {
        // Lossy VP8: frame tag at offset 20, then a 14-bit little-endian size.
        if bytes.len() < 26 {
            return null
        }
        int width = read_uint16_le(bytes, 26) & 0x3fff
        int height = read_uint16_le(bytes, 28) & 0x3fff
        return image_dimensions_t {width_px: width, height_px: height}
    }
    if chunk == 'VP8L' {
        // Lossless VP8L: a 14-bit size packed in four bytes after the tag.
        if bytes.len() < 25 {
            return null
        }
        int bits = (bytes[21] as int) | ((bytes[22] as int) << 8) | ((bytes[23] as int) << 16) | ((bytes[24] as int) << 24)
        int width = (bits & 0x3fff) + 1
        int height = ((bits >> 14) & 0x3fff) + 1
        return image_dimensions_t {width_px: width, height_px: height}
    }
    // VP8X extended: 24-bit canvas sizes in bytes 24..29 (Pi reads them
    // directly, adding 1 for the zero-based canvas convention).
    if bytes.len() < 30 {
        return null
    }
    int width = ((bytes[24] as int) | ((bytes[25] as int) << 8) | ((bytes[26] as int) << 16)) + 1
    int height = ((bytes[27] as int) | ((bytes[28] as int) << 8) | ((bytes[29] as int) << 16)) + 1
    return image_dimensions_t {width_px: width, height_px: height}
}

fn read_uint16_be([u8] bytes, int offset): int {
    return ((bytes[offset] as int) << 8) + (bytes[offset + 1] as int)
}

fn read_uint16_le([u8] bytes, int offset): int {
    return (bytes[offset] as int) + ((bytes[offset + 1] as int) << 8)
}

fn read_uint32_be([u8] bytes, int offset): int {
    return ((bytes[offset] as int) * 0x1000000) + ((bytes[offset + 1] as int) << 16) + ((bytes[offset + 2] as int) << 8) + (bytes[offset + 3] as int)
}

fn fmt_int(int value): string {
    return fmt.sprintf('%d', value)
}


// Pi tui.ts consumeCellSizeResponse: ESC [ 6 ; height ; width t reports the
// cell size in pixels after a CSI 16 t query.
pub fn parse_csi_16t_cell_size(string data): cell_dimensions_t? {
    if !data.starts_with('\x1b[6;') || !data.ends_with('t') {
        return null
    }
    string payload = data.slice(4, data.len() - 1)
    int sep = payload.find(';')
    if sep < 0 {
        return null
    }
    string height_text = payload.slice(0, sep)
    string width_text = payload.slice(sep + 1, payload.len())
    if height_text.len() == 0 || width_text.len() == 0 {
        return null
    }
    int height = 0
    for int i = 0; i < height_text.len(); i += 1 {
        u8 c = height_text[i]
        if c < '0'.char() || c > '9'.char() {
            return null
        }
        height = height * 10 + (c as int - '0'.char() as int)
    }
    int width = 0
    for int i = 0; i < width_text.len(); i += 1 {
        u8 c = width_text[i]
        if c < '0'.char() || c > '9'.char() {
            return null
        }
        width = width * 10 + (c as int - '0'.char() as int)
    }
    if height <= 0 || width <= 0 {
        return null
    }
    return cell_dimensions_t {width_px: width, height_px: height}
}

pub fn cell_size_query_sequence(): string {
    return '\x1b[16t'
}


// B4: stable kitty image ids.  Deriving the placement id from the payload
// keeps redraws from reallocating a new placement for identical content,
// which is what upstream's placed-image tracking guarantees.
pub fn image_id_for(string base64_data): int {
    u32 hash = 2166136261
    for byte in base64_data as [u8] {
        hash ^= byte as u32
        hash *= 16777619
    }
    int id = hash as int
    if id < 0 {
        id = -id
    }
    if id == 0 {
        id = 1
    }
    return id
}

// Live-placement registry: every kitty placement records its id here;
// restore/teardown clears the screen's placements explicitly.
{int:bool} live_kitty_placements = {}

pub fn record_kitty_placement(int image_id) {
    if image_id > 0 {
        live_kitty_placements[image_id] = true
    }
}

pub fn kitty_placement_count(): int {
    return live_kitty_placements.len()
}

// Pi deleteChangedKittyImages teardown half: remove every recorded
// placement from the terminal (used on restore/quit boundaries).
pub fn clear_kitty_placements(): string {
    string out = ''
    for id, present in live_kitty_placements {
        if present {
            out += delete_kitty_image(id)
        }
    }
    live_kitty_placements = {}
    return out
}
