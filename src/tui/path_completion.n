import adou.src.tools.path_utils
import os
import path
import strings
import syscall

// Port of the file-path completion from
// vendors/pi/packages/tui/src/autocomplete.ts (CombinedAutocompleteProvider's
// extractPathPrefix/getFileSuggestions/applyCompletion/buildCompletionValue).
// The fd-based fuzzy file search stays optional: directory listing works
// without the fd binary.

pub const PATH_DELIMITERS = ' \t"\'='

pub type completion_item_t = struct {
    string value
    string label
    string description
}

pub type path_prefix_t = struct {
    string raw_prefix
    bool is_at_prefix
    bool is_quoted_prefix
}

fn is_delimiter(u8 byte): bool {
    return byte == ' '.char() || byte == '\t'.char() || byte == '"'.char() || byte == "'".char() || byte == '='.char()
}

pub fn find_last_delimiter(string text): int {
    for int index = text.len() - 1; index >= 0; index -= 1 {
        if is_delimiter(text[index]) {
            return index
        }
    }
    return -1
}

fn is_token_start(string text, int index): bool {
    return index == 0 || is_delimiter(text[index - 1])
}

pub fn find_unclosed_quote_start(string text): int {
    bool in_quotes = false
    int quote_start = -1
    for int index = 0; index < text.len(); index += 1 {
        if text[index] == '"'.char() {
            in_quotes = !in_quotes
            if in_quotes {
                quote_start = index
            }
        }
    }
    if in_quotes {
        return quote_start
    }
    return -1
}

pub fn extract_quoted_prefix(string text): string {
    int quote_start = find_unclosed_quote_start(text)
    if quote_start < 0 {
        return ''
    }
    if quote_start > 0 && text[quote_start - 1] == '@'.char() {
        if !is_token_start(text, quote_start - 1) {
            return ''
        }
        return text.slice(quote_start - 1, text.len())
    }
    if !is_token_start(text, quote_start) {
        return ''
    }
    return text.slice(quote_start, text.len())
}

pub fn parse_path_prefix(string prefix): path_prefix_t {
    if prefix.starts_with('@"') {
        return path_prefix_t {raw_prefix: prefix.slice(2, prefix.len()), is_at_prefix: true, is_quoted_prefix: true}
    }
    if prefix.starts_with('"') {
        return path_prefix_t {raw_prefix: prefix.slice(1, prefix.len()), is_at_prefix: false, is_quoted_prefix: true}
    }
    if prefix.starts_with('@') {
        return path_prefix_t {raw_prefix: prefix.slice(1, prefix.len()), is_at_prefix: true, is_quoted_prefix: false}
    }
    return path_prefix_t {raw_prefix: prefix, is_at_prefix: false, is_quoted_prefix: false}
}

pub fn extract_path_prefix(string text, bool force_extract): string {
    string quoted = extract_quoted_prefix(text)
    if quoted != '' {
        return quoted
    }
    int last_delimiter = find_last_delimiter(text)
    string path_prefix = last_delimiter < 0 ? text : text.slice(last_delimiter + 1, text.len())
    if force_extract {
        return path_prefix
    }
    if path_prefix.contains('/') || path_prefix.starts_with('.') || path_prefix.starts_with('~/') {
        return path_prefix
    }
    if path_prefix == '' && text.ends_with(' ') {
        return path_prefix
    }
    return ''
}

pub fn extract_at_prefix(string text): string {
    string quoted = extract_quoted_prefix(text)
    if quoted.starts_with('@"') {
        return quoted
    }
    int last_delimiter = find_last_delimiter(text)
    int token_start = last_delimiter < 0 ? 0 : last_delimiter + 1
    if token_start < text.len() && text[token_start] == '@'.char() {
        return text.slice(token_start, text.len())
    }
    return ''
}

pub fn build_completion_value(string completion_path, bool is_directory, bool is_at_prefix, bool is_quoted_prefix): string {
    bool needs_quotes = is_quoted_prefix || completion_path.contains(' ')
    string prefix = is_at_prefix ? '@' : ''
    if !needs_quotes {
        return prefix + completion_path
    }
    return prefix + '"' + completion_path + '"'
}

// Keep an attachment completion quoted exactly once. Fuzzy attachment
// candidates already include quotes when their path contains spaces.
pub fn quoted_at_completion_value(string value): string {
    if value.starts_with('@"') {
        return value
    }
    if value.starts_with('@') {
        return '@"' + value.slice(1, value.len()) + '"'
    }
    return '@"' + value + '"'
}

fn expand_home_path(string input_path, string home): string {
    if input_path.starts_with('~/') {
        string expanded = home + input_path.slice(1, input_path.len())
        if input_path.ends_with('/') && !expanded.ends_with('/') {
            return expanded + '/'
        }
        return expanded
    }
    if input_path == '~' {
        return home
    }
    return input_path
}

pub fn get_file_suggestions(string prefix, string base_path, string home): [completion_item_t] {
    [completion_item_t] suggestions = []
    var parsed = parse_path_prefix(prefix)
    string raw_prefix = parsed.raw_prefix
    string expanded_prefix = expand_home_path(raw_prefix, home)
    string search_dir = ''
    string search_prefix = ''
    bool is_root = raw_prefix == '' || raw_prefix == './' || raw_prefix == '../' || raw_prefix == '~' || raw_prefix == '~/' || raw_prefix == '/' || (parsed.is_at_prefix && raw_prefix == '')
    if is_root {
        if raw_prefix.starts_with('~') || expanded_prefix.starts_with('/') {
            search_dir = expanded_prefix
        } else {
            search_dir = path.join(base_path, expanded_prefix)
        }
        search_prefix = ''
    } else if raw_prefix.ends_with('/') {
        if raw_prefix.starts_with('~') || expanded_prefix.starts_with('/') {
            search_dir = expanded_prefix
        } else {
            search_dir = path.join(base_path, expanded_prefix)
        }
        search_prefix = ''
    } else {
        string dir = path.dir(expanded_prefix)
        string file = path.base(expanded_prefix)
        if raw_prefix.starts_with('~') || expanded_prefix.starts_with('/') {
            search_dir = dir
        } else if dir == '.' {
            // path.join(dst, '.') indexes past a single-char argument in the
            // current toolchain; keep the base directory as-is.
            search_dir = base_path
        } else {
            search_dir = path.join(base_path, dir)
        }
        search_prefix = file
    }
    [string] names = os.listdir(search_dir) catch error {
        return suggestions
    }
    string lower_prefix = search_prefix.to_lower()
    for name in names {
        if !name.to_lower().starts_with(lower_prefix) {
            continue
        }
        string full_path = path.join(search_dir, name)
        bool is_directory = is_directory_path(full_path)
        string relative_path = build_relative_path(raw_prefix, name)
        string path_value = is_directory ? relative_path + '/' : relative_path
        string value = build_completion_value(path_value, is_directory, parsed.is_at_prefix, parsed.is_quoted_prefix)
        suggestions.push(completion_item_t {value: value, label: name + (is_directory ? '/' : '')})
    }
    // Directories first, then alphabetically.
    for int index = 1; index < suggestions.len(); index += 1 {
        var current = suggestions[index]
        int cursor = index - 1
        for cursor >= 0 && order_before(suggestions[cursor], current) {
            suggestions[cursor + 1] = suggestions[cursor]
            cursor -= 1
        }
        suggestions[cursor + 1] = current
    }
    return suggestions
}

fn build_relative_path(string display_prefix, string name): string {
    if display_prefix.ends_with('/') {
        return display_prefix + name
    }
    if display_prefix.contains('/') {
        if display_prefix.starts_with('~/') {
            string home_relative = display_prefix.slice(2, display_prefix.len())
            string dir = path.dir(home_relative)
            if dir == '.' {
                return '~/' + name
            }
            return '~/' + path.join(dir, name)
        }
        if display_prefix.starts_with('/') {
            string dir = path.dir(display_prefix)
            if dir == '/' {
                return '/' + name
            }
            return dir + '/' + name
        }
        string joined = path.join(path.dir(display_prefix), name)
        if display_prefix.starts_with('./') && !joined.starts_with('./') {
            return './' + joined
        }
        return joined
    }
    if display_prefix.starts_with('~') {
        return '~/' + name
    }
    return name
}

fn order_before(completion_item_t left, completion_item_t right): bool {
    bool left_dir = left.value.ends_with('/')
    bool right_dir = right.value.ends_with('/')
    if left_dir && !right_dir {
        return false
    }
    if !left_dir && right_dir {
        return true
    }
    return left.label.to_lower() > right.label.to_lower()
}

fn is_directory_path(string full_path): bool {
    var stat = syscall.stat(full_path) catch error {
        return false
    }
    return syscall.stat_is_dir(stat.mode)
}

// Pi's fd-backed fuzzy attachment search (autocomplete.ts
// getFuzzyFileSuggestions): walk the working tree without a git submodule
// or hidden-noise filter, score candidates against the query and return the
// top matches as @-prefixed completions.  Adou replaces the fd subprocess
// with a bounded recursive walk.
// B1-R4-05: like `fd --base-directory`, every entry carries a path RELATIVE
// to the base directory — the absolute cwd never leaks into value, label or
// description.
pub fn get_fuzzy_file_suggestions(string query, string base_path, string home): [completion_item_t] {
    var entries = walk_fuzzy(base_path, base_path, query, 0)
    [completion_item_t] result = []
    for entry in entries {
        string display_path = entry.path
        bool is_directory = entry.is_directory
        string completion_path = is_directory ? display_path + '/' : display_path
        string value = build_completion_value(completion_path, is_directory, true, false)
        string label = entry.name + (is_directory ? '/' : '')
        result.push(completion_item_t {value: value, label: label, description: display_path,})
    }
    return result
}

// B1-R4-12: the unified attachment/file completion replacement (Pi
// applyCompletion) expressed as an editor range: (start_col, end_col,
// replacement, cursor_col).  The @ attachment branch appends one space
// after a FILE value and none after a directory (label ends with '/'); a
// quoted completion drops the closing quote from the cursor suffix; a
// quoted directory keeps the cursor one cell before the closing quote.
pub fn completion_range(int cursor_col, string line, string prefix, completion_item_t item, bool is_at): (int, int, string, int) {
    if cursor_col > line.len() {
        cursor_col = line.len()
    }
    int start = cursor_col - prefix.len()
    if start < 0 {
        start = 0
    }
    string value = item.value
    bool is_quoted = prefix.starts_with('"') || prefix.starts_with('@"')
    bool trailing_quote = value.ends_with('"')
    bool leading_quote_after = line.slice(cursor_col, line.len()).starts_with('"')
    int end = cursor_col
    if is_quoted && trailing_quote && leading_quote_after {
        end += 1
    }
    bool is_directory = item.label.ends_with('/')
    string replacement = value
    if is_at && !is_directory {
        replacement = value + ' '
    }
    int offset = value.len()
    if is_directory && trailing_quote {
        offset = value.len() - 1
    }
    int cursor = start + offset + (is_at && !is_directory ? 1 : 0)
    return (start, end, replacement, cursor)
}

type fuzzy_entry_t = struct {
    string path
    string name
    bool is_directory
    int score
}

const FUZZY_WALK_LIMIT = 100
const FUZZY_WALK_MAX_DEPTH = 8

fn walk_fuzzy(string directory, string base_path, string query, int depth): [fuzzy_entry_t] {
    [fuzzy_entry_t] entries = []
    if depth > FUZZY_WALK_MAX_DEPTH {
        return entries
    }
    [string] names = os.listdir(directory) catch error {
        return entries
    }
    string lower_query = query.to_lower()
    for name in names {
        if entries.len() >= FUZZY_WALK_LIMIT {
            break
        }
        if name == '.git' {
            continue
        }
        string full_path = path.join(directory, name)
        bool is_directory = false
        var stat = syscall.stat(full_path) catch error {
            continue
        }
        is_directory = syscall.stat_is_dir(stat.mode)
        int score = fuzzy_score(name, lower_query, is_directory, full_path)
        if score > 0 {
            string relative = relative_to(directory, base_path, name)
            entries = insert_fuzzy_sorted(entries, fuzzy_entry_t {path: relative, name: name, is_directory: is_directory, score: score})
        }
        if is_directory {
            var children = walk_fuzzy(full_path, base_path, query, depth + 1)
            for child in children {
                entries = insert_fuzzy_sorted(entries, child)
            }
        }
    }
    return entries
}

// The display path of `name` inside `directory`, relative to `base_path`.
fn relative_to(string directory, string base_path, string name): string {
    if directory == base_path {
        return name
    }
    string rest = directory.slice(base_path.len(), directory.len())
    if rest.starts_with('/') {
        rest = rest.slice(1, rest.len())
    }
    if rest == '' {
        return name
    }
    return rest + '/' + name
}

fn fuzzy_score(string file_name, string lower_query, bool is_directory, string full_path): int {
    if lower_query == '' {
        return is_directory ? 10 : 1
    }
    string lower_name = file_name.to_lower()
    int score = 0
    if lower_name == lower_query {
        score = 100
    } else if lower_name.starts_with(lower_query) {
        score = 80
    } else if lower_name.contains(lower_query) {
        score = 50
    } else if full_path.to_lower().contains(lower_query) {
        score = 30
    }
    if is_directory && score > 0 {
        score += 10
    }
    return score
}

fn insert_fuzzy_sorted([fuzzy_entry_t] entries, fuzzy_entry_t entry): [fuzzy_entry_t] {
    [fuzzy_entry_t] merged = []
    bool placed = false
    for existing in entries {
        if !placed && existing.score < entry.score {
            merged.push(entry)
            placed = true
        }
        merged.push(existing)
    }
    if !placed {
        merged.push(entry)
    }
    if merged.len() > 20 {
        merged = merged.slice(0, 20)
    }
    return merged
}
