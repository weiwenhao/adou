import adou.src.tools.command
import strings
import syscall

// Port of vendors/pi/packages/coding-agent/src/core/resolve-config-value.ts.
// Configuration values (API keys, header values) may be shell commands
// (`!cmd`), environment templates ($VAR / ${VAR}, $$ and $! escapes) or
// literals.

pub fn is_command_config_value(string config): bool {
    return config.starts_with('!')
}

pub fn get_config_value_env_var_names(string config): [string] {
    [string] names = []
    if config.starts_with('!') {
        return names
    }
    int index = 0
    for index < config.len() {
        if config[index] != '$'.char() {
            index += 1
            continue
        }
        if index + 1 >= config.len() {
            break
        }
        u8 next = config[index + 1]
        if next == '$'.char() || next == '!'.char() {
            index += 2
            continue
        }
        if next == '{'.char() {
            int end = find_from(config, '}', index + 2)
            if end < 0 {
                break
            }
            string name = config.slice(index + 2, end)
            if valid_env_name(name) && !contains(names, name) {
                names.push(name)
            }
            index = end + 1
            continue
        }
        string name = env_name_prefix(config, index + 1)
        if name != '' && !contains(names, name) {
            names.push(name)
        }
        index += 1 + name.len()
    }
    return names
}

pub fn is_config_value_configured(string config): bool {
    var names = get_config_value_env_var_names(config)
    for name in names {
        if syscall.get_env(name) == '' {
            return false
        }
    }
    return true
}

// The single env var name when a config value is exactly one environment
// reference ("$VAR" or "${VAR}"); '' otherwise.  Pi's getConfigValueEnvVarName.
pub fn get_config_value_env_var_name(string config): string {
    var names = get_config_value_env_var_names(config)
    if names.len() == 1 && single_env_reference(config) {
        return names[0]
    }
    return ''
}

// Environment references in a config value that are not currently set.
// Pi's getMissingConfigValueEnvVarNames.
pub fn get_missing_config_value_env_var_names(string config): [string] {
    [string] missing = []
    var names = get_config_value_env_var_names(config)
    for name in names {
        if syscall.get_env(name) == '' {
            missing.push(name)
        }
    }
    return missing
}

// Resolve a config value without consulting the shell command cache.
// Pi's resolveConfigValueUncached.
pub fn resolve_config_value_uncached(string config): string {
    if config.starts_with('!') {
        return execute_command_uncached(config.slice(1, config.len()))
    }
    return resolve_template_value(config)
}

// Resolve a config value or throw with the given description, matching
// Pi's resolveConfigValueOrThrow error text.
pub fn resolve_config_value_or_throw(string config, string description): string! {
    string resolved = resolve_config_value_uncached(config)
    if resolved != '' {
        return resolved
    }
    if config.starts_with('!') {
        throw errorf('Failed to resolve %s from shell command: %s', description, config.slice(1, config.len()))
    }
    var missing = get_missing_config_value_env_var_names(config)
    if missing.len() == 1 {
        throw errorf('Failed to resolve %s from environment variable: %s', description, missing[0])
    }
    if missing.len() > 1 {
        throw errorf('Failed to resolve %s from environment variables: %s', description, strings.join(missing, ', '))
    }
    throw errorf('Failed to resolve %s', description)
}

// Resolve every header value like Pi's resolveHeaders; unresolved or empty
// values are dropped.
pub fn resolve_headers({string:string} headers): {string:string} {
    {string:string} resolved = {}
    for name, value in headers {
        string resolved_value = resolve_config_value(value)
        if resolved_value != '' {
            resolved[name] = resolved_value
        }
    }
    return resolved
}

// Pi's resolveHeadersOrThrow: every header must resolve or the call throws.
pub fn resolve_headers_or_throw({string:string} headers, string description): {string:string}! {
    {string:string} resolved = {}
    for name, value in headers {
        resolved[name] = resolve_config_value_or_throw(value, description + ' header "' + name + '"')
    }
    return resolved
}

// Clear the shell command result cache.  Exported for testing like Pi.
pub fn clear_config_value_cache() {
    command_cache = {}
}

// Resolve a config value: run `!command` (cached), interpolate env vars, or
// return the literal.  Returns '' when an env reference is missing.
pub fn resolve_config_value(string config): string {
    if config.starts_with('!') {
        return execute_command(config.slice(1, config.len()))
    }
    return resolve_template_value(config)
}

// Template interpolation shared by resolve_config_value and the uncached
// variant; $$ and $! escape to a literal $ and !.
fn resolve_template_value(string config): string {
    string result = ''
    int index = 0
    for index < config.len() {
        if config[index] != '$'.char() {
            result += config.slice(index, index + 1)
            index += 1
            continue
        }
        if index + 1 >= config.len() {
            result += '$'
            break
        }
        u8 next = config[index + 1]
        if next == '$'.char() || next == '!'.char() {
            result += config.slice(index + 1, index + 2)
            index += 2
            continue
        }
        if next == '{'.char() {
            int end = find_from(config, '}', index + 2)
            if end < 0 {
                result += '$'
                index += 1
                continue
            }
            string name = config.slice(index + 2, end)
            if valid_env_name(name) {
                string value = syscall.get_env(name)
                if value == '' {
                    return ''
                }
                result += value
                index = end + 1
                continue
            }
            result += config.slice(index, end + 1)
            index = end + 1
            continue
        }
        string name = env_name_prefix(config, index + 1)
        if name != '' {
            string value = syscall.get_env(name)
            if value == '' {
                return ''
            }
            result += value
            index += 1 + name.len()
            continue
        }
        result += '$'
        index += 1
    }
    return result
}

// True when the whole config value is a single "$VAR"/"${VAR}" reference.
fn single_env_reference(string config): bool {
    int start = config.find('$')
    if start != 0 || start < 0 {
        return false
    }
    if start + 1 >= config.len() {
        return false
    }
    u8 next = config[start + 1]
    string name = ''
    if next == '{'.char() {
        int end = find_from(config, '}', start + 2)
        if end < 0 {
            return false
        }
        name = config.slice(start + 2, end)
        if !valid_env_name(name) {
            return false
        }
        if end != config.len() - 1 {
            return false
        }
    } else {
        name = env_name_prefix(config, start + 1)
        if name == '' {
            return false
        }
        if start + 1 + name.len() != config.len() {
            return false
        }
    }
    return true
}

// Cached shell command results, like Pi's commandResultCache.
{string:string} command_cache = {}

fn execute_command(string cmd): string {
    if command_cache.contains(cmd) {
        return command_cache[cmd]
    }
    string value = execute_command_uncached(cmd)
    command_cache[cmd] = value
    return value
}

fn execute_command_uncached(string cmd): string {
    var result = command.argv(syscall.get_env('HOME'), '/bin/sh', ['-c', cmd]) catch error {
        return ''
    }
    return result.stdout.trim([' ', '\t', '\n', '\r'])
}

fn valid_env_name(string name): bool {
    if name == '' {
        return false
    }
    u8 first = name[0]
    bool ok = first >= 'A'.char() && first <= 'Z'.char()
    ok = ok || first >= 'a'.char() && first <= 'z'.char()
    ok = ok || first == '_'.char()
    if !ok {
        return false
    }
    for int index = 1; index < name.len(); index += 1 {
        u8 byte = name[index]
        bool member = byte >= 'A'.char() && byte <= 'Z'.char()
        member = member || byte >= 'a'.char() && byte <= 'z'.char()
        member = member || byte >= '0'.char() && byte <= '9'.char()
        member = member || byte == '_'.char()
        if !member {
            return false
        }
    }
    return true
}

fn env_name_prefix(string config, int start): string {
    int cursor = start
    for cursor < config.len() {
        u8 byte = config[cursor]
        bool member = byte >= 'A'.char() && byte <= 'Z'.char()
        member = member || byte >= 'a'.char() && byte <= 'z'.char()
        member = member || byte >= '0'.char() && byte <= '9'.char()
        member = member || byte == '_'.char()
        if cursor == start {
            member = byte >= 'A'.char() && byte <= 'Z'.char()
            member = member || byte >= 'a'.char() && byte <= 'z'.char()
            member = member || byte == '_'.char()
        }
        if !member {
            break
        }
        cursor += 1
    }
    return config.slice(start, cursor)
}

fn find_from(string content, string needle, int start): int {
    for int cursor = start; cursor + needle.len() <= content.len(); cursor += 1 {
        if content.slice(cursor, cursor + needle.len()) == needle {
            return cursor
        }
    }
    return -1
}

fn contains([string] values, string target): bool {
    for value in values {
        if value == target {
            return true
        }
    }
    return false
}
