import adou.src.ai.types as ai_types
import adou.src.ai.providers.registry
import adou.src.config.auth
import adou.src.config.models
import adou.src.config.settings
import adou.src.config.trust
import adou.src.compaction.types as compaction_types
import adou.src.config.types
import adou.src.tools.path_utils
import syscall

// Pi's resolveProjectTrusted: an explicit --approve/--no-approve wins,
// otherwise a stored decision applies, and untrusted projects skip their
// local .pi settings overlay entirely.
// Relative --skill paths are fixed against the launch cwd right here: a
// resumed --session or /import can bind the runtime to a different project
// later, and the explicit paths must not drift with it.
pub fn resolve(types.cli_args_t arguments, string cwd): types.config_t! {
    if arguments.errors.len() > 0 {
        throw errorf('%s', join_errors(arguments.errors))
    }
    // defaultProjectTrust is Pi's one global-only settings key, so the trust
    // decision needs the global file before the project merge exists.
    var global_preferences = settings.load()
    bool project_trusted = trust.resolve_trust(arguments.trust_override_explicit, arguments.trust_override, cwd, global_preferences.default_project_trust)
    [string] skill_paths = []
    for raw_path in arguments.skill_paths {
        skill_paths.push(path_utils.resolve_to_cwd(raw_path, cwd))
    }
    var preferences = project_trusted ? settings.load_for(cwd) : global_preferences
    string requested_model = first(arguments.model, syscall.get_env('ADOU_MODEL'))
    string provider = first(arguments.provider, syscall.get_env('ADOU_PROVIDER'))
    bool model_explicit = arguments.model != '' || syscall.get_env('ADOU_MODEL') != ''
    string scoped_thinking = ''
    // A stale settings file may contain a model/provider from a local mock or
    // an extension that is outside the Nature MVP.  Pi still starts so the
    // user can authenticate or choose another model; only use persisted
    // defaults when their provider belongs to the built-in registry.
    bool stored_provider_supported = preferences.default_provider == 'deepseek' || preferences.default_provider == 'openai' || preferences.default_provider == 'anthropic'
    if requested_model == '' && arguments.scoped_models.len() > 0 {
        ref<ai_types.model_t>? scoped = models.first_allowed(arguments.scoped_models)
        if scoped is ref<ai_types.model_t> scoped_model {
            requested_model = scoped_model.id
            provider = scoped_model.provider
            scoped_thinking = models.thinking_for(scoped_model.provider + '/' + scoped_model.id, arguments.scoped_models)
        }
    }
    if requested_model == '' && preferences.enabled_model_ids.len() > 0 {
        // Pi uses the persisted model scope as the initial selector when no
        // explicit model or CLI scope was provided.  Keep that preference
        // distinct from the session's Ctrl+P scope, which the TUI restores
        // separately after the runner is created.
        ref<ai_types.model_t>? scoped = null
        string saved_reference = preferences.default_provider != '' && preferences.default_model != '' ? preferences.default_provider + '/' + preferences.default_model : ''
        if saved_reference != '' && models.allowed(saved_reference, preferences.enabled_model_ids) {
            scoped = models.find(saved_reference)
        }
        if !(scoped is ref<ai_types.model_t>) {
            scoped = models.first_allowed(preferences.enabled_model_ids)
        }
        if scoped is ref<ai_types.model_t> scoped_model {
            requested_model = scoped_model.id
            provider = scoped_model.provider
            scoped_thinking = models.thinking_for(scoped_model.provider + '/' + scoped_model.id, preferences.enabled_model_ids)
        } else {
        }
    }
    // Pi considers enabledModels a model scope, so it wins over the saved
    // default model for a fresh session.  The saved default is considered
    // only when it is itself in the scope; otherwise the first scoped model
    // is selected.  This ordering is also what lets a project .pi/settings
    // file override a conflicting user-level defaultModel.
    if requested_model == '' && preferences.default_model != '' && (preferences.default_provider == '' || stored_provider_supported) {
        requested_model = preferences.default_model
    }
    string model_suffix_thinking = ''
    int model_level_separator = requested_model.rfind(':')
    // With an explicit --thinking flag Pi treats any `:suffix` in the model
    // reference as part of the model ID. Otherwise a valid final suffix is
    // parsed as the requested thinking level.
    if !arguments.thinking_explicit && model_level_separator >= 0 {
        string candidate_level = requested_model.slice(model_level_separator + 1, requested_model.len()).to_lower()
        if candidate_level == 'off' || candidate_level == 'minimal' || candidate_level == 'low' || candidate_level == 'medium' || candidate_level == 'high' || candidate_level == 'xhigh' || candidate_level == 'max' {
            model_suffix_thinking = candidate_level
        }
        requested_model = requested_model.slice(0, model_level_separator)
    }
    // An explicit --model is resolved before the saved provider preference.
    // Pi treats `--model sonnet` as a model selection, not as a custom model
    // under whatever provider happened to be saved last time.
    if provider == '' && requested_model != '' {
        ref<ai_types.model_t>? inferred_model = models.find(requested_model)
        if inferred_model is ref<ai_types.model_t> known_model {
            provider = known_model.provider
            // Keep the canonical id selected by Pi's resolver. Without this
            // assignment a partial selector such as `--model sonnet` would
            // infer Anthropic but still send the literal custom id `sonnet`.
            requested_model = known_model.id
        }
    }
    if provider != '' && requested_model != '' {
        // A valid thinking suffix on a catalog model is still a model
        // shorthand when --thinking is supplied explicitly; the explicit
        // level only wins after the model has been resolved. Unknown custom
        // IDs retain their colon because Pi allows provider-specific IDs.
        string lookup = requested_model.find('/') >= 0 ? requested_model : provider + '/' + requested_model
        ref<ai_types.model_t>? known = models.find(lookup)
        if known is ref<ai_types.model_t> known_model {
            requested_model = known_model.id
            provider = known_model.provider
        }
    }
    if provider == '' && requested_model.find('/') >= 0 {
        provider = requested_model.slice(0, requested_model.find('/'))
    }
    if provider == '' && !model_explicit && preferences.default_provider != '' && stored_provider_supported {
        provider = preferences.default_provider
    }
    if provider == '' {
        // No explicit CLI/env provider and no valid persisted default:
        // fall back to deepseek/deepseek-v4-flash deterministically instead
        // of inferring from whichever API key happens to exist on this
        // machine (a stray OpenAI credential must not turn a fresh start
        // into a GPT session).  Explicit selection, valid persisted
        // defaults, project settings and session restore keep their higher
        // priority because they set `provider` before this point.
        provider = 'deepseek'
    }
    provider = provider.to_lower()
    if !is_known_provider(provider) {
        throw errorf('Unsupported provider: %s', provider)
    }
    string model_id = requested_model
    int model_separator = model_id.find('/')
    if model_separator >= 0 {
        model_id = model_id.slice(model_separator + 1, model_id.len())
    }
    if model_id == '' {
        model_id = provider == 'deepseek' ? 'deepseek-v4-flash' : provider == 'anthropic' ? 'claude-sonnet-4-5' : 'gpt-5.1-codex'
    }
    string base_url = arguments.base_url
    if base_url == '' {
        base_url = provider == 'deepseek' ? 'https://api.deepseek.com' : provider == 'anthropic' ? 'https://api.anthropic.com' : 'https://api.openai.com/v1'
    }
    string api_key = arguments.api_key
    if api_key == '' {
        api_key = auth.effective(provider)
    }
    int context_window = positive(arguments.context_window, env_int('ADOU_CONTEXT_WINDOW'))
    int max_tokens = positive(arguments.max_tokens, env_int('ADOU_MAX_TOKENS'))
    if context_window == 0 && model_id == 'deepseek-v4-flash' {
        context_window = 1000000
    } else if context_window == 0 && model_id == 'gpt-5.1-codex' {
        context_window = 400000
    } else if context_window == 0 && model_id == 'claude-sonnet-4-5' {
        context_window = 200000
    }
    if max_tokens == 0 && model_id == 'deepseek-v4-flash' {
        max_tokens = 384000
    } else if max_tokens == 0 && model_id == 'gpt-5.1-codex' {
        max_tokens = 128000
    } else if max_tokens == 0 && model_id == 'claude-sonnet-4-5' {
        max_tokens = 64000
    }
    string api = provider == 'anthropic' ? 'anthropic-messages' : provider == 'deepseek' ? 'openai-completions' : 'openai-responses'
    bool reasoning = provider == 'openai' || provider == 'deepseek' || provider == 'anthropic'
    bool adaptive_thinking = provider == 'anthropic'
    ref<ai_types.model_t>? catalog_model = models.find(provider + '/' + model_id)
    if catalog_model is ref<ai_types.model_t> catalog {
        // A catalog entry carries the provider's real protocol and metadata;
        // the CLI overrides below (base-url/context-window/max-tokens) still
        // take precedence over the catalog defaults.
        api = catalog.api
        reasoning = catalog.reasoning
        adaptive_thinking = catalog.adaptive_thinking
        if arguments.base_url == '' {
            base_url = catalog.base_url
        }
        if context_window == 0 {
            context_window = catalog.context_window
        }
        if max_tokens == 0 {
            max_tokens = catalog.max_tokens
        }
    }
    if context_window == 0 && model_id == 'deepseek-v4-flash' {
        context_window = 1000000
    } else if context_window == 0 && model_id == 'gpt-5.1-codex' {
        context_window = 400000
    } else if context_window == 0 && model_id == 'claude-sonnet-4-5' {
        context_window = 200000
    }
    if max_tokens == 0 && model_id == 'deepseek-v4-flash' {
        max_tokens = 384000
    } else if max_tokens == 0 && model_id == 'gpt-5.1-codex' {
        max_tokens = 128000
    } else if max_tokens == 0 && model_id == 'claude-sonnet-4-5' {
        max_tokens = 64000
    }
    var model = new ai_types.model_t(id = model_id, name = model_id, api = api, provider = provider, base_url = base_url, reasoning = reasoning, adaptive_thinking = adaptive_thinking, context_window = context_window, max_tokens = max_tokens)
    if catalog_model is ref<ai_types.model_t> catalog {
        // Copy the full catalog capability metadata, not just cost/headers:
        // thinking_level_map and compat drive clamp_thinking_level and the
        // request encoder, and dropping them degrades explicit/persisted
        // thinking levels (deepseek max -> high) or alters request shapes.
        model.cost = catalog.cost
        for header_name, header_value in catalog.headers {
            model.headers[header_name] = header_value
        }
        model.thinking_level_map = catalog.thinking_level_map
        model.compat = catalog.compat
    }
    if provider == 'deepseek' && model_id == 'deepseek-v4-flash' {
        model.cost.input = 0.14
        model.cost.output = 0.28
        model.cost.cache_read = 0.0028
    }
    // Pi httpIdleTimeoutMs supplies the default request timeout; an explicit
    // --timeout wins, and a configured 0 ("disabled") flows through as the
    // std client's no-timeout value.
    int timeout_ms = positive(arguments.timeout_ms, preferences.http_idle_timeout_ms)
    int max_retries = arguments.max_retries >= 0 ? arguments.max_retries : 2
    string thinking = arguments.thinking_explicit ? arguments.thinking : model_suffix_thinking != '' ? model_suffix_thinking : scoped_thinking != '' ? scoped_thinking : preferences.default_thinking_level
    thinking = models.clamp_thinking_level(model, thinking)
    var options = new ai_types.stream_options_t(api_key = api_key, timeout_ms = timeout_ms, max_tokens = max_tokens, max_retries = max_retries, reasoning_effort = thinking, thinking_enabled = thinking != 'off')
    options.transport = preferences.transport
    int reserve_tokens = positive(arguments.reserve_tokens, 16384)
    int keep_recent_tokens = positive(arguments.keep_recent_tokens, 20000)
    var compaction = compaction_types.settings_t {enabled: arguments.no_compaction ? false : preferences.auto_compaction, reserve_tokens: reserve_tokens, keep_recent_tokens: keep_recent_tokens,}
    string session_dir = first(arguments.session_dir, syscall.get_env('PI_CODING_AGENT_SESSION_DIR'))
    if session_dir == '' {
        session_dir = syscall.get_env('ADOU_SESSION_DIR')
    }
    string mode = arguments.mode
    bool print_mode = arguments.print_mode || mode == 'json'
    return types.config_t {serve_port: arguments.serve_port, cwd: cwd, provider: provider, model: model, stream_options: options, compaction: compaction, thinking: thinking, session_path: arguments.session_path, session_id: arguments.session_id, session_dir: session_dir, fork_path: arguments.fork_path, session_name: arguments.session_name, system_prompt: arguments.system_prompt, append_system_prompts: arguments.append_system_prompts, continue_recent: arguments.continue_recent, resume: arguments.resume, print_mode: print_mode, mode: mode, export_path: arguments.export_path, list_models: arguments.list_models, list_models_pattern: arguments.list_models_pattern, verbose: arguments.verbose, debug: arguments.debug, offline: arguments.offline, trust_override: arguments.trust_override, trust_override_explicit: arguments.trust_override_explicit, project_trusted: project_trusted, retry_enabled: preferences.retry_enabled, retry_max_attempts: preferences.retry_max_attempts, retry_base_delay_ms: preferences.retry_base_delay_ms, no_context_files: arguments.no_context_files, no_tools: arguments.no_tools, no_builtin_tools: arguments.no_builtin_tools, scoped_models: arguments.scoped_models, scoped_models_explicit: arguments.scoped_models_explicit, tool_names: arguments.tool_names, exclude_tool_names: arguments.exclude_tool_names, no_session: arguments.no_session, provider_explicit: arguments.provider != '' || syscall.get_env('ADOU_PROVIDER') != '', model_explicit: arguments.model != '' || syscall.get_env('ADOU_MODEL') != '', thinking_explicit: arguments.thinking_explicit, api_key_explicit: arguments.api_key != '', steering_mode: preferences.steering_mode, follow_up_mode: preferences.follow_up_mode, hide_thinking: preferences.hide_thinking, skill_paths: skill_paths, no_skills: arguments.no_skills, initial_messages: arguments.messages, default_project_trust: preferences.default_project_trust, enable_skill_commands: preferences.enable_skill_commands, quiet_startup: preferences.quiet_startup, transport: preferences.transport, http_idle_timeout_ms: preferences.http_idle_timeout_ms,}
}

// Shared skills options for a project cwd: explicit --skill paths always
// load, --no-skills gates only default discovery, and the trust decision is
// re-resolved against cwd so spawned serve instances and rebound sessions
// use the project's own stored decision (explicit --approve/--no-approve
// still wins).
pub fn skills_options_for(types.config_t config, string cwd): types.skills_options_t {
    return types.skills_options_t {skill_paths: config.skill_paths, no_skills: config.no_skills, project_trusted: trust.resolve_trust(config.trust_override_explicit, config.trust_override, cwd, config.default_project_trust), trust_override: config.trust_override, trust_override_explicit: config.trust_override_explicit, default_project_trust: config.default_project_trust,}
}

// Trust gate for a skills_options_t against a concrete project cwd; the
// captured options may outlive the launch directory (serve instances spawn
// per-cwd runners, RPC get_commands follows each instance's session cwd).
pub fn skills_trusted(types.skills_options_t options, string cwd): bool {
    return trust.resolve_trust(options.trust_override_explicit, options.trust_override, cwd, options.default_project_trust)
}

#local
pub fn first(string primary, string fallback): string {
    return primary != '' ? primary : fallback
}

pub fn positive(int primary, int fallback): int {
    return primary > 0 ? primary : fallback
}

#local
fn env_int(string name): int {
    string value = syscall.get_env(name)
    if value == '' {
        return 0
    }
    return value.to_int() catch error {0}
}

#local
fn join_errors([string] errors): string {
    string result = ''
    for index, message in errors {
        if index > 0 {
            result += '\n'
        }
        result += message
    }
    return result
}

#local
fn is_known_provider(string value): bool {
    var def = registry.find_def(value)
    return !(def is null)
}
