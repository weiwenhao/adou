import adou.src.ai.providers.registry
import adou.src.ai.types
import adou.src.json_util
import adou.src.tools.path_utils
import adou.src.config.paths
import adou.src.config.resolve_config_value
import fs
import json
import os
import path
import syscall

#linkid adou_auth_lock
fn native_auth_lock(anyptr path): i32
#linkid adou_auth_unlock
fn native_auth_unlock(i32 fd): i32
#linkid adou_auth_atomic_write
fn native_auth_atomic_write(anyptr path, anyptr data, i32 length): i32

// Pi's RuntimeCredentials overlay: non-persistent API keys win over the
// persisted auth.json store without writing to disk.
{string:string} runtime_api_keys = {}

// The persisted auth.json is parsed at most once between writes
// (pi-interactive-parity-audit-plan.md B1-R1-09): every mutation of the
// credential store (save/remove/modify_credential, the only write paths)
// invalidates the cache, so ordinary reads such as the ~1200-model
// autocomplete scan never re-open or re-parse the file.  Environment and
// runtime-key lookups stay uncached (process-static, no file I/O).
//
// B1-R2-05: the snapshot keeps the LAST VALID content.  A failed re-read
// (corrupt JSON, top-level non-object) must never clear it, and reload()
// gives external updates an explicit, one-shot re-read point (the /reload
// command).  Ordinary read/effective hot paths stay in-memory only.
//
// NOTE: no function here returns a map-in-tuple — the Nature compiler
// miscompiles `(map, bool)` returns into an infinite loop (observed hang in
// the Round 2A-3 targeted test).  reload_snapshot_from() writes the map
// directly and only returns bool.
{string:any} cached_auth_root = {}
bool auth_cache_valid = false

fn cached_root(): {string:any} {
    if !auth_cache_valid {
        reload_snapshot_from(auth_path())
        // Marked valid even on failure: the last valid snapshot stays and
        // the hot path does not retry the file on every call.
        auth_cache_valid = true
    }
    return cached_auth_root
}

// Explicit re-read of the current auth path (Pi AuthStorage.reload): a
// missing file is a valid EMPTY snapshot; valid JSON objects replace the
// snapshot; read/parse failures and top-level non-objects preserve the last
// valid snapshot.  Self-writes keep the invalidate-on-write path instead,
// so this function is only the external-change refresh point.
pub fn reload() {
    bool replaced = reload_snapshot_from(auth_path())
    if replaced {
        auth_cache_valid = true
    }
}

fn invalidate_auth_cache() {
    // Deliberately does NOT clear cached_auth_root: if the re-read after a
    // self-write ever fails, the last valid snapshot must survive.
    auth_cache_valid = false
}

pub fn set_runtime_api_key(string provider, string key) {
    runtime_api_keys[provider] = key
}

pub fn remove_runtime_api_key(string provider) {
    if runtime_api_keys.contains(provider) {
        runtime_api_keys.del(provider)
    }
}

pub fn has_runtime_api_key(string provider): bool {
    return runtime_api_keys.contains(provider)
}

pub fn effective(string provider): string {
    if runtime_api_keys.contains(provider) {
        return runtime_api_keys[provider]
    }
    var stored = read_credential(provider)
    if stored is ref<api_key_credential_t> api_key {
        return resolve_config_value.resolve_config_value(api_key.key)
    }
    if stored is ref<oauth_credential_t> oauth {
        return oauth.access
    }
    // A canonical provider entry owns credential resolution even when its
    // value is malformed or empty.  Never silently fall through to an env
    // key that could make a failed login appear configured.
    if cached_root().contains(provider) {
        return ''
    }
    return environment(provider)
}

pub fn oauth_access(string provider): string {
    var stored = read_credential(provider)
    if stored is ref<oauth_credential_t> oauth {
        return oauth.access
    }
    return ''
}

pub fn is_using_oauth(string provider): bool {
    return read_credential(provider) is ref<oauth_credential_t>
}

pub fn environment(string provider): string {
    var def = registry.find_def(provider)
    if def is types.provider_def_t found {
        for env_var in found.env_vars {
            string value = syscall.get_env(env_var)
            if value != '' {
                return value
            }
        }
    }
    return ''
}

pub fn read(string provider): string {
    var object = cached_root()
    if !object.contains(provider) || !json_util.is_obj(object[provider]) {
        return ''
    }
    var credential = object[provider] as {string:any}
    if !credential.contains('type') || !(credential['type'] is string) || credential['type'] as string != 'api_key' {
        return ''
    }
    if credential.contains('key') && credential['key'] is string {
        string stored = credential['key'] as string
        // Pi resolves `!command` / `$ENV` templates in stored credentials.
        return resolve_config_value.resolve_config_value(stored)
    }
    return ''
}

pub fn save(string provider, string key): void! {
    if provider == '' || key == '' {
        throw errorf('Provider and API key are required')
    }
    string file_path = auth_path()
    os.mkdirs(path.dir(file_path), 0o700)
    i32 lock_fd = acquire_lock(file_path)
    var object = read_root(file_path)
    {string:any} credential = {}
    credential['type'] = 'api_key'
    credential['key'] = key
    object[provider] = credential
    string serialized = json.serialize(object)
    i32 write_result = native_auth_atomic_write(file_path.ref(), serialized.ref(), serialized.len() as i32)
    i32 unlock_result = native_auth_unlock(lock_fd)
    if write_result < 0 {
        throw errorf('Could not atomically write auth storage')
    }
    if unlock_result < 0 {
        throw errorf('Could not unlock auth storage')
    }
    invalidate_auth_cache()
}

// B1-R4-06: logout must be deterministic regardless of external file
// state.  If the provider is present in the current disk object it is
// removed and written; if the file is missing, corrupt or the provider is
// absent, the disk is authoritative for "not configured" — the in-memory
// snapshot drops the provider in every case, so read/list/effective never
// keep reporting a logged-out credential.  reload()'s parse-failure
// last-valid contract is unaffected (the snapshot was already updated).
pub fn remove(string provider): void! {
    string file_path = auth_path()
    os.mkdirs(path.dir(file_path), 0o700)
    i32 lock_fd = acquire_lock(file_path)
    var object = read_root(file_path)
    if object.contains(provider) {
        object.del(provider)
        string serialized = json.serialize(object)
        i32 write_result = native_auth_atomic_write(file_path.ref(), serialized.ref(), serialized.len() as i32)
        i32 unlock_result = native_auth_unlock(lock_fd)
        if write_result < 0 {
            throw errorf('Could not atomically write auth storage')
        }
        if unlock_result < 0 {
            throw errorf('Could not unlock auth storage')
        }
        invalidate_auth_cache()
        return
    }
    native_auth_unlock(lock_fd)
    remove_from_snapshot(provider)
}

fn remove_from_snapshot(string provider) {
    if cached_auth_root.contains(provider) {
        cached_auth_root.del(provider)
        auth_cache_valid = true
    }
}

pub fn auth_path(): string {
    return paths.auth_path()
}

// Pi CredentialStore interface surface: one canonical tagged credential per
// provider.  The variants intentionally reject legacy `apiKey` and untagged
// objects; callers must migrate them explicitly instead of silently changing
// the credential meaning.
pub type api_key_credential_t = struct {
    string credential_type = 'api_key'
    string key
}

pub type oauth_credential_t = struct {
    string credential_type = 'oauth'
    string refresh
    string access
    int expires
    string account_id
    string enterprise_domain
    string base_url
    string gateway
    string scope
    [string] available_model_ids = []
    any gateway_config = null
}

pub type credential_t = ref<api_key_credential_t>|ref<oauth_credential_t>
pub type optional_credential_t = ref<api_key_credential_t>|ref<oauth_credential_t>|null

pub type credential_info_t = struct {
    string provider_id
    string credential_type
}

// B1-R3-06: read_credential/list_credentials/read all consume the SAME
// last-valid in-memory snapshot (cached_root), so an external corrupt or
// deleted file can never produce mutually contradictory results between
// calls; an explicit reload() is the only refresh point.  Only
// modify_credential reads the current disk object (serialized
// read-modify-write) and invalidates the snapshot on success.
pub fn read_credential(string provider): optional_credential_t {
    return credential_from_object(cached_root(), provider)
}

pub fn read_credential_env(string provider): {string:string} {
    {string:string} result = {}
    var object = cached_root()
    if !object.contains(provider) || !json_util.is_obj(object[provider]) {
        return result
    }
    var credential = object[provider] as {string:any}
    string credential_type = json_util.opt_string(credential, 'type')
    if credential_type != 'api_key' && credential_type != 'oauth' {
        return result
    }
    for env_name, env_value in credential {
        if credential_field(env_name) {
            continue
        }
        if env_value is string {
            result[env_name] = json_util.opt_string(credential, env_name)
        }
    }
    return result
}

pub fn list_credentials(): [credential_info_t] {
    [credential_info_t] result = []
    var object = cached_root()
    for provider_id, value in object {
        if !json_util.is_obj(value) {
            continue
        }
        var credential = value as {string:any}
        if !credential.contains('type') || !(credential['type'] is string) {
            continue
        }
        string credential_type = credential['type'] as string
        if credential_type == 'api_key' || credential_type == 'oauth' {
            result.push(credential_info_t {provider_id: provider_id, credential_type: credential_type})
        }
    }
    return result
}

// Build a typed credential for one provider from a parsed auth object.
fn credential_from_object({string:any} object, string provider): optional_credential_t {
    if !object.contains(provider) || !json_util.is_obj(object[provider]) {
        return null
    }
    var credential = object[provider] as {string:any}
    if !credential.contains('type') || !(credential['type'] is string) {
        return null
    }
    string credential_type = credential['type'] as string
    if credential_type == 'api_key' {
        if !credential.contains('key') || !(credential['key'] is string) {
            return null
        }
        var result = new api_key_credential_t()
        string stored_key = json_util.opt_string(credential, 'key')
        result.key = stored_key
        return result
    }
    if credential_type == 'oauth' {
        var result = new oauth_credential_t()
        result.refresh = json_util.opt_string(credential, 'refresh')
        result.access = json_util.opt_string(credential, 'access')
        result.expires = json_util.opt_int(credential, 'expires')
        result.account_id = json_util.opt_string(credential, 'accountId')
        result.enterprise_domain = json_util.opt_string(credential, 'enterpriseDomain')
        if result.enterprise_domain == '' {
            result.enterprise_domain = json_util.opt_string(credential, 'enterpriseUrl')
        }
        result.base_url = json_util.opt_string(credential, 'baseUrl')
        result.gateway = json_util.opt_string(credential, 'gateway')
        result.scope = json_util.opt_string(credential, 'scope')
        if credential.contains('availableModelIds') && credential['availableModelIds'] is [any] {
            for value in credential['availableModelIds'] as [any] {
                if value is string {
                    result.available_model_ids.push(value as string)
                }
            }
        }
        if credential.contains('gatewayConfig') && json_util.is_obj(credential['gatewayConfig']) {
            result.gateway_config = credential['gatewayConfig']
        }
        return result
    }
    return null
}

// Mutation callbacks use a concrete edit record.  Nature 0.82 currently
// miscompiles nullable reference unions when they cross a callback boundary;
// the public read path remains the canonical api_key/oauth union while this
// lock-held write ABI stays representationally stable.
pub type credential_edit_t = struct {
    string credential_type
    string key
    string refresh
    string access
    int expires
    string account_id
    string enterprise_domain
    string base_url
    string gateway
    string scope
    [string] available_model_ids = []
    any gateway_config = null
    {string:string} env = {}
}

pub type credential_modify_fn = fn(ref<credential_edit_t>? current): ref<credential_edit_t>?

// Serialized read-modify-write: the only write path, like Pi's modify.  The
// callback sees the CURRENT DISK credential (never the possibly stale
// snapshot); a successful write invalidates the snapshot so subsequent
// reads see the new state.
pub fn modify_credential(string provider, credential_modify_fn modify_fn): void! {
    string file_path = auth_path()
    os.mkdirs(path.dir(file_path), 0o700)
    i32 lock_fd = acquire_lock(file_path)
    var current = credential_edit_from_object(read_root(file_path), provider)
    var next = modify_fn(current) catch error {
        native_auth_unlock(lock_fd)
        throw error
    }
    if next is ref<credential_edit_t> replacement {
        persist_edit_locked(file_path, provider, replacement, lock_fd)
        return
    }
    native_auth_unlock(lock_fd)
}

fn persist_object_locked(string file_path, string provider, {string:any} credential, i32 lock_fd): void! {
    var object = read_root(file_path)
    object[provider] = credential
    string serialized = json.serialize(object)
    i32 write_result = native_auth_atomic_write(file_path.ref(), serialized.ref(), serialized.len() as i32)
    i32 unlock_result = native_auth_unlock(lock_fd)
    if write_result < 0 {
        throw errorf('Could not atomically write auth storage')
    }
    if unlock_result < 0 {
        throw errorf('Could not unlock auth storage')
    }
    invalidate_auth_cache()
}

fn persist_edit_locked(string file_path, string provider, ref<credential_edit_t> credential, i32 lock_fd): void! {
    {string:any} object = {}
    object['type'] = credential.credential_type
    if credential.credential_type == 'api_key' {
        object['key'] = credential.key
    } else if credential.credential_type == 'oauth' {
        object['refresh'] = credential.refresh
        object['access'] = credential.access
        object['expires'] = credential.expires
        if credential.account_id != '' {object['accountId'] = credential.account_id}
        if credential.enterprise_domain != '' {object['enterpriseDomain'] = credential.enterprise_domain}
        if credential.base_url != '' {object['baseUrl'] = credential.base_url}
        if credential.gateway != '' {object['gateway'] = credential.gateway}
        if credential.scope != '' {object['scope'] = credential.scope}
        if credential.available_model_ids.len() > 0 {object['availableModelIds'] = credential.available_model_ids}
        if json_util.is_obj(credential.gateway_config) {object['gatewayConfig'] = credential.gateway_config}
    }
    for name, value in credential.env {
        object[name] = value
    }
    persist_object_locked(file_path, provider, object, lock_fd)
}

fn credential_edit_from_object({string:any} object, string provider): ref<credential_edit_t>? {
    if !object.contains(provider) || !json_util.is_obj(object[provider]) {
        return null
    }
    var credential = object[provider] as {string:any}
    if !credential.contains('type') || !(credential['type'] is string) {
        return null
    }
    string credential_type = credential['type'] as string
    if credential_type != 'api_key' && credential_type != 'oauth' {
        return null
    }
    var result = new credential_edit_t(credential_type = credential_type)
    result.key = json_util.opt_string(credential, 'key')
    result.refresh = json_util.opt_string(credential, 'refresh')
    result.access = json_util.opt_string(credential, 'access')
    result.expires = json_util.opt_int(credential, 'expires')
    result.account_id = json_util.opt_string(credential, 'accountId')
    result.enterprise_domain = json_util.opt_string(credential, 'enterpriseDomain')
    if result.enterprise_domain == '' {
        result.enterprise_domain = json_util.opt_string(credential, 'enterpriseUrl')
    }
    result.base_url = json_util.opt_string(credential, 'baseUrl')
    result.gateway = json_util.opt_string(credential, 'gateway')
    result.scope = json_util.opt_string(credential, 'scope')
    if credential.contains('availableModelIds') && credential['availableModelIds'] is [any] {
        for value in credential['availableModelIds'] as [any] {
            if value is string {result.available_model_ids.push(value as string)}
        }
    }
    if credential.contains('gatewayConfig') && json_util.is_obj(credential['gatewayConfig']) {
        result.gateway_config = credential['gatewayConfig']
    }
    {string:string} env = {}
    restore_env(env, credential)
    result.env = env
    return result
}

fn restore_env({string:string} env, {string:any} credential) {
    for env_name, env_value in credential {
        if credential_field(env_name) {
            continue
        }
        if env_value is string {
            env[env_name] = json_util.opt_string(credential, env_name)
        }
    }
}

pub fn credential_field(string name): bool {
    return name == 'type' || name == 'key' || name == 'refresh' || name == 'access' || name == 'expires' || name == 'accountId' || name == 'enterpriseDomain' || name == 'enterpriseUrl' || name == 'baseUrl' || name == 'gateway' || name == 'scope' || name == 'availableModelIds' || name == 'gatewayConfig'
}

fn acquire_lock(string file_path): i32! {
    string lock_path = file_path + '.lock'
    i32 fd = native_auth_lock(lock_path.ref())
    if fd < 0 {
        throw errorf('Could not lock auth storage')
    }
    return fd
}

fn read_root(string file_path): {string:any} {
    // Plain object read for the save/remove/modify read-modify-write paths;
    // returns the parsed object or an empty map.  Never uses map-in-tuple.
    if !path_utils.exists(file_path) {
        {string:any} empty = {}
        return empty
    }
    var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {
        {string:any} empty = {}
        return empty
    }
    string content = input.content() catch error {
        input.close()
        {string:any} empty = {}
        return empty
    }
    input.close()
    var root = json_util.parse(content) catch error {
        {string:any} empty = {}
        return empty
    }
    if !json_util.is_obj(root) {
        {string:any} empty = {}
        return empty
    }
    return root as {string:any}
}

// Snapshot refresh helper (B1-R2-05), bool-only by design (no map-in-tuple,
// see the note at the top of the file).  A missing file replaces the
// snapshot with an empty map and reports success; unreadable/corrupt JSON
// or a top-level non-object leaves cached_auth_root untouched and reports
// failure so the last valid snapshot survives.
fn reload_snapshot_from(string file_path): bool {
    if !path_utils.exists(file_path) {
        {string:any} empty = {}
        cached_auth_root = empty
        return true
    }
    var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {
        return false
    }
    string content = input.content() catch error {
        input.close()
        return false
    }
    input.close()
    var root = json_util.parse(content) catch error {
        return false
    }
    if !json_util.is_obj(root) {
        return false
    }
    cached_auth_root = root as {string:any}
    return true
}

pub fn write_file(string file_path, string content): void! {
    os.mkdirs(path.dir(file_path), 0o700)
    i32 result = native_auth_atomic_write(file_path.ref(), content.ref(), content.len() as i32)
    if result < 0 {
        throw errorf('Could not atomically write auth storage')
    }
}
