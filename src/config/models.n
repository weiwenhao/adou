import adou.src.ai.providers.registry
import adou.src.ai.models_store
import adou.src.ai.remote_catalog
import adou.src.ai.types as ai_types
import adou.src.config.models_json
import adou.src.config.resolve_config_value
import adou.src.config.paths as config_paths
import adou.src.debug
import adou.src.tools.path_utils
import fmt
import path
import time
import strings
import syscall

// A resolved --models entry.  Pi resolves scope patterns once, preserves the
// user's pattern order, removes duplicate models, and carries an optional
// per-entry thinking level into model cycling.
pub type scoped_model_t = struct {
    ref<ai_types.model_t> model
    string thinking_level
}

// The full Pi-style catalog (generated from models.dev + OpenRouter + Vercel
// AI Gateway through scripts/generate-model-catalog.py) followed by the MVP
// defaults for ids the live catalog does not carry (e.g. gpt-5.1-codex).
// User-configured <agentDir>/models.json providers/models/modelOverrides
// compose over the built-in catalog once per process (Pi composes them at
// ModelRuntime construction); the parsed provider configs are cached, while
// the base catalog and the composed copies are rebuilt per call so runtime
// provider registrations stay visible.
// A persisted <agentDir>/models-store.json remote overlay (pi.dev catalog
// refreshes) merges over the baseline before models.json composition.
pub fn all(): [ref<ai_types.model_t>] {
    ensure_models_json()
    [ref<ai_types.model_t>] result = []
    var catalog = registry.all_models()
    for model in catalog {
        result.push(model)
    }
    for provider_id, overlay in remote_overlays {
        var overlay_models = overlay.models
        result = remote_catalog.merge_models(result, overlay_models)
    }
    [string] provider_ids = []
    for provider_id, config in models_json_providers {
        provider_ids.push(provider_id)
    }
    for provider_id in provider_ids {
        var cfg = copy_provider(models_json_providers[provider_id])
        [ref<ai_types.model_t>] base = []
        for model in catalog {
            if model.provider == provider_id {
                base.push(model)
            }
        }
        var composed = models_json.compose_provider_models(provider_id, base, cfg) catch error {
            debug.log('config', 'models.json provider ' + provider_id + ' skipped: ' + error.msg())
            continue
        }
        [ref<ai_types.model_t>] kept = []
        for model in result {
            if model.provider != provider_id {
                kept.push(model)
            }
        }
        result = kept
        for model in composed {
            result.push(model)
        }
    }
    for fallback in [openai_default()] {
        if !catalog_contains(result, fallback) {
            result.push(fallback)
        }
    }
    return result
}

pub fn find(string reference): ref<ai_types.model_t>? {
    string raw_value = reference.trim([' ', '\t'])
    if raw_value == '' {
        return null
    }
    string value = strip_thinking_suffix(raw_value)
    string lower_value = value.to_lower()
    [ref<ai_types.model_t>] available = all()

    // A known provider prefix wins over bare-id matching so a provider-scoped
    // reference like `openai/gpt-5.1-codex` never resolves to an OpenRouter
    // routing id that literally contains `openai/`. Bare ids that contain a
    // slash (OpenRouter routing variants) still match through the unscoped
    // id comparison below.
    string provider = ''
    string id = value
    int separator = value.find('/')
    if separator >= 0 && known_provider(value.slice(0, separator).to_lower()) {
        provider = value.slice(0, separator).to_lower()
        id = value.slice(separator + 1, value.len())
    }
    string lower_id = id.to_lower()

    ref<ai_types.model_t>? exact = null
    int exact_count = 0
    for model in available {
        if provider != '' && model.provider.to_lower() != provider {
            continue
        }
        if model.id.to_lower() == lower_id {
            exact = model
            exact_count += 1
        }
    }
    if exact_count == 1 {
        if exact is ref<ai_types.model_t> selected {
            return selected
        }
    }

    // Pi's CLI resolver falls back to a case-insensitive partial id match.
    // Keep the result deterministic and reject ambiguous matches; the
    // registry can later add dated aliases without changing this contract.
    if !has_glob(value) {
        ref<ai_types.model_t>? partial = null
        int partial_count = 0
        for model in available {
            if provider != '' && model.provider.to_lower() != provider {
                continue
            }
            if model.id.to_lower().contains(lower_id) {
                partial = model
                partial_count += 1
            }
        }
        if partial_count == 1 {
            if partial is ref<ai_types.model_t> selected {
                return selected
            }
        }
    }
    return null
}

pub fn default_for(string provider): ref<ai_types.model_t>! {
    if provider == 'deepseek' {
        return deepseek_v4_flash()
    }
    if provider == 'anthropic' {
        return anthropic_default()
    }
    if provider == 'openai' {
        return openai_default()
    }
    throw errorf('Unsupported provider: %s', provider)
}

// Pi keeps the user-facing thinking levels stable while allowing individual
// model catalogs to remove levels that the provider cannot honor. DeepSeek V4
// exposes only off/high/max; unsupported levels are clamped to the nearest
// supported level (preferring a stronger level when walking upward).
pub fn clamp_thinking_level(ref<ai_types.model_t> model, string requested): string {
    [string] levels = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']
    string value = requested.to_lower()
    int requested_index = 0
    for index, level in levels {
        if level == value {
            requested_index = index
            break
        }
    }
    if !model.reasoning {
        return 'off'
    }
    if thinking_level_supported(model, value) {
        return value
    }
    for int index = requested_index; index < levels.len(); index += 1 {
        if thinking_level_supported(model, levels[index]) {
            return levels[index]
        }
    }
    for int index = requested_index - 1; index >= 0; index -= 1 {
        if thinking_level_supported(model, levels[index]) {
            return levels[index]
        }
    }
    return 'off'
}

// Match Pi's getSupportedThinkingLevels(): the catalog thinkingLevelMap
// marks unsupported levels with an empty value, xhigh/max only exist when
// explicitly mapped, and ordinary reasoning models keep the full sequence.
pub fn available_thinking_levels(ref<ai_types.model_t> model): [string] {
    [string] result = []
    for level in ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'] {
        if thinking_level_supported(model, level) {
            result.push(level)
        }
    }
    return result
}

fn thinking_level_supported(ref<ai_types.model_t> model, string level): bool {
    if !model.reasoning {
        return level == 'off'
    }
    if level == 'xhigh' || level == 'max' {
        return model.thinking_level_map.contains(level) && model.thinking_level_map[level] != ''
    }
    if model.thinking_level_map.contains(level) {
        return model.thinking_level_map[level] != ''
    }
    return true
}

pub fn list(): string {
    [string] names = []
    for model in all() {
        names.push(model.provider + '/' + model.id)
    }
    return strings.join(names, ', ')
}

pub fn list_filtered(string pattern): string {
    [string] names = []
    string needle = pattern.trim([' ', '\t'])
    for model in all() {
        string reference = model.provider + '/' + model.id
        if needle == '' || matches_model_pattern(model, needle) {
            names.push(reference)
        }
    }
    return strings.join(names, '\n')
}

pub fn allowed(string reference, [string] patterns): bool {
    if patterns.len() == 0 {return true}
    for pattern in patterns {
        if matches_reference_pattern(reference, pattern) {return true}
    }
    return false
}

// Resolve the first model in registry order that matches a CLI --models
// pattern. Pi uses the first scoped model as the initial selection when no
// existing session or explicit --model is present.
pub fn first_allowed([string] patterns): ref<ai_types.model_t>? {
    [scoped_model_t] resolved = resolve_scope(patterns)
    if resolved.len() > 0 {
        return resolved[0].model
    }
    return null
}

// Resolve --models exactly once in user order.  Non-glob patterns select one
// model (exact/partial matching follows find()), while glob patterns select
// every matching catalog model in catalog order.  A model selected by an
// earlier pattern is not reinserted when a later pattern also matches it.
pub fn resolve_scope([string] patterns): [scoped_model_t] {
    [scoped_model_t] result = []
    for raw_pattern in patterns {
        string pattern = raw_pattern.trim([' ', '\t'])
        if pattern == '' {continue}
        string base = strip_thinking_suffix(pattern)
        string level = ''
        if base != pattern {
            level = pattern.slice(base.len() + 1, pattern.len()).to_lower()
        } else if !has_glob(pattern) {
            // Pi warns for an invalid suffix but still resolves the model
            // prefix. There is no diagnostics channel in this MVP resolver;
            // preserve the selection and leave its thinking level unset.
            int separator = pattern.rfind(':')
            if separator >= 0 {
                string candidate = pattern.slice(0, separator)
                ref<ai_types.model_t>? fallback = find(candidate)
                if fallback is ref<ai_types.model_t> {
                    base = candidate
                }
            }
        }
        if has_glob(base) {
            for model in all() {
                string reference = model.provider + '/' + model.id
                if !matches_value_pattern(reference, base) && !matches_value_pattern(model.id, base) {
                    continue
                }
                if !scope_contains(result, model) {
                    result.push(scoped_model_t {model: model, thinking_level: level})
                }
            }
            continue
        }
        ref<ai_types.model_t>? selected = find(base)
        if selected is ref<ai_types.model_t> model {
            if !scope_contains(result, model) {
                result.push(scoped_model_t {model: model, thinking_level: level})
            }
        }
    }
    return result
}

// Return the optional `:thinking-level` suffix attached to the first scoped
// model pattern that matches a reference.  A matching pattern without a
// suffix intentionally stops the search: Pi treats the first occurrence as
// authoritative instead of letting a later duplicate override it.
pub fn thinking_for(string reference, [string] patterns): string {
    for pattern in patterns {
        string trimmed = pattern.trim([' ', '\t'])
        if trimmed == '' {continue}
        string base = strip_thinking_suffix(trimmed)
        if base == trimmed && !has_glob(trimmed) {
            int separator = trimmed.rfind(':')
            if separator >= 0 {
                string candidate = trimmed.slice(0, separator)
                ref<ai_types.model_t>? fallback = find(candidate)
                if fallback is ref<ai_types.model_t> {
                    base = candidate
                }
            }
        }
        if matches_reference_pattern(reference, base) || (has_glob(base) && matches_value_pattern(reference, base)) {
            if base != trimmed {
                string level = trimmed.slice(base.len() + 1, trimmed.len()).to_lower()
                if valid_thinking(level) {return level}
            }
            return ''
        }
    }
    return ''
}

// Deep-copy a parsed provider config into a fresh ref so compose can hand
// the struct to ref-taking helpers without aliasing the cached entry.
// Header values go through config-value resolution ("!cmd", "$VAR") like
// Pi's resolveHeaders; unresolvable values are dropped.
fn copy_provider(models_json.models_json_provider_t source): ref<models_json.models_json_provider_t> {
    var copy = new models_json.models_json_provider_t(name = source.name, base_url = source.base_url, api_key = source.api_key, api = source.api, auth_header = source.auth_header)
    var resolved_headers = resolve_config_value.resolve_headers(source.headers)
    for name, value in resolved_headers {
        copy.headers[name] = value
    }
    for model_id, definition in source.models {
        copy.models[model_id] = definition
    }
    for model_id, override in source.model_overrides {
        copy.model_overrides[model_id] = override
    }
    return copy
}

#local
fn ensure_models_json() {
    if models_json_loaded {
        return
    }
    models_json_loaded = true
    string file = path.join(config_paths.agent_dir(), 'models.json')
    if !path_utils.exists(file) {
        return
    }
    var providers = models_json.load_models_json(file)
    for provider_id, config in providers {
        models_json_providers[provider_id] = config
    }
}

// Load the persisted remote catalog overlay (<agentDir>/models-store.json)
// once per process.  Call before any catalog read so offline sessions still
// see the last fetched pi.dev overlay; the fetch itself is opt-in.
pub fn load_remote_overlays() {
    if remote_overlays_loaded {
        debug.log('models', 'remote overlays already loaded providers=' + fmt.sprintf('%d', remote_overlays.len()))
        return
    }
    remote_overlays_loaded = true
    debug.log('models', 'remote overlays load begin')
    string file = models_store_path()
    var store = models_store.new_store()
    store.load(file) catch error {
        debug.log('models', 'remote overlays load skipped: ' + error.msg())
        return
    }
    for provider_id, entry in store.entries {
        remote_overlays[provider_id] = entry
    }
    debug.log('models', 'remote overlays load complete providers=' + fmt.sprintf('%d', remote_overlays.len()))
}

// Pi's ModelRuntime.create refreshes the remote catalogs when networking is
// allowed (PI_OFFLINE unset) and the host opts in.  Adou mirrors that with
// the ADOU_CATALOG_NETWORK=1 opt-in; failures are silent and keep the
// stored overlay.
pub fn refresh_remote_catalogs() {
    refresh_remote_catalogs_with_status()
}

// Returns the number of provider catalogs that failed. The TUI uses this to
// report that it kept the cached snapshot without moving network work back
// onto the input loop. ADOU_CATALOG_BASE_URL supports self-hosted catalogs
// and deterministic local fixtures; the default remains pi.dev.
pub fn refresh_remote_catalogs_with_status(): int {
    bool offline_env = syscall.get_env('PI_OFFLINE') != ''
    bool network_opt_in = syscall.get_env('ADOU_CATALOG_NETWORK') != ''
    if offline_env || !network_opt_in {
        debug.log('models', 'remote catalog refresh skipped offline_env=' + (offline_env ? 'true' : 'false') + ' network_opt_in=' + (network_opt_in ? 'true' : 'false'))
        return 0
    }
    int failures = 0
    int attempted = 0
    debug.log('models', 'remote catalog refresh begin')
    var store = models_store.new_store()
    string file = models_store_path()
    string catalog_base_url = syscall.get_env('ADOU_CATALOG_BASE_URL')
    if catalog_base_url == '' {
        catalog_base_url = remote_catalog.DEFAULT_CATALOG_BASE_URL
    }
    store.load(file) catch error {}
    for def in registry.defs() {
        if def.api == '' && def.base_url == '' {
            continue
        }
        attempted += 1
        int started_at = time.now().ms_timestamp() as int
        debug.log('models', 'remote catalog provider=' + def.id + ' request begin')
        int now_ms = time.now().ms_timestamp() as int
        var catalog_models = remote_catalog.refresh_remote_catalog(def.id, store, catalog_base_url, 0, now_ms, true) catch error {
            failures += 1
            debug.log('models', 'remote catalog provider=' + def.id + ' request failed elapsed_ms=' + fmt.sprintf('%d', (time.now().ms_timestamp() as int) - started_at) + ' error=' + error.msg())
            continue
        }
        var stored = store.read(def.id)
        if stored is ref<models_store.models_store_entry_t> entry {
            remote_overlays[def.id] = entry
        }
        debug.log('models', 'remote catalog provider=' + def.id + ' request complete models=' + fmt.sprintf('%d', catalog_models.len()) + ' elapsed_ms=' + fmt.sprintf('%d', (time.now().ms_timestamp() as int) - started_at))
    }
    store.save(file) catch error {
        debug.log('models', 'remote catalog store save failed: ' + error.msg())
    }
    debug.log('models', 'remote catalog refresh end attempted=' + fmt.sprintf('%d', attempted) + ' failures=' + fmt.sprintf('%d', failures))
    return failures
}

// <agentDir>/models-store.json, Pi's FileModelsStore default path.
fn models_store_path(): string {
    return path.join(config_paths.agent_dir(), 'models-store.json')
}

{string:ref<models_store.models_store_entry_t>} remote_overlays = {}
bool remote_overlays_loaded = false

// Parsed once per process; composing happens per all() call so runtime
// registrations (extensions) remain visible in the catalog.
{string:models_json.models_json_provider_t} models_json_providers = {}
bool models_json_loaded = false

#local
fn scope_contains([scoped_model_t] values, ref<ai_types.model_t> candidate): bool {
    for value in values {
        if value.model.provider.to_lower() == candidate.provider.to_lower() && value.model.id.to_lower() == candidate.id.to_lower() {
            return true
        }
    }
    return false
}

#local
fn deepseek_v4_flash(): ref<ai_types.model_t> {
    var model = new ai_types.model_t(id = 'deepseek-v4-flash', api = 'openai-completions', provider = 'deepseek', base_url = 'https://api.deepseek.com', reasoning = true, context_window = 1000000, max_tokens = 384000)
    model.cost.input = 0.14
    model.cost.output = 0.28
    model.cost.cache_read = 0.0028
    model.compat.thinking_format = 'deepseek'
    model.compat.requires_reasoning_content_on_assistant_messages = true
    model.compat.max_tokens_field = 'max_tokens'
    model.compat.supports_reasoning_effort = true
    model.compat.supports_usage_in_streaming = true
    // Pi catalog capability metadata (docs/models.md deepseek family):
    // only high and max are supported thinking levels; the rest are null.
    model.thinking_level_map['minimal'] = ''
    model.thinking_level_map['low'] = ''
    model.thinking_level_map['medium'] = ''
    model.thinking_level_map['high'] = 'high'
    model.thinking_level_map['xhigh'] = ''
    model.thinking_level_map['max'] = 'max'
    return model
}

#local
fn openai_default(): ref<ai_types.model_t> {
    return new ai_types.model_t(id = 'gpt-5.1-codex', api = 'openai-responses', provider = 'openai', base_url = 'https://api.openai.com/v1', reasoning = true, context_window = 400000, max_tokens = 128000)
}

#local
fn anthropic_default(): ref<ai_types.model_t> {
    return new ai_types.model_t(id = 'claude-sonnet-4-5', api = 'anthropic-messages', provider = 'anthropic', base_url = 'https://api.anthropic.com', reasoning = true, adaptive_thinking = true, context_window = 200000, max_tokens = 64000)
}

pub fn valid_thinking(string value): bool {
    return value == 'off' || value == 'minimal' || value == 'low' || value == 'medium' || value == 'high' || value == 'xhigh' || value == 'max'
}

#local
fn catalog_contains([ref<ai_types.model_t>] values, ref<ai_types.model_t> candidate): bool {
    for value in values {
        if value.provider.to_lower() == candidate.provider.to_lower() && value.id.to_lower() == candidate.id.to_lower() {
            return true
        }
    }
    return false
}

#local
fn known_provider(string value): bool {
    var def = registry.find_def(value)
    if def is ai_types.provider_def_t {
        return true
    }
    return false
}

#local
fn strip_thinking_suffix(string value): string {
    int separator = value.rfind(':')
    if separator < 0 {
        return value
    }
    string level = value.slice(separator + 1, value.len()).to_lower()
    if valid_thinking(level) {
        return value.slice(0, separator)
    }
    return value
}

#local
fn has_glob(string value): bool {
    return value.contains('*') || value.contains('?') || value.contains('[')
}

#local
fn matches_model_pattern(ref<ai_types.model_t> model, string pattern): bool {
    string reference = model.provider + '/' + model.id
    if matches_value_pattern(reference, pattern) {
        return true
    }
    // Pi lets a pattern without a provider match the bare model id too.
    string base = strip_thinking_suffix(pattern.trim([' ', '\t']))
    if !base.contains('/') && matches_value_pattern(model.id, base) {
        return true
    }
    return false
}

#local
fn matches_reference_pattern(string reference, string pattern): bool {
    if matches_value_pattern(reference, pattern) {
        return true
    }
    string base = strip_thinking_suffix(pattern.trim([' ', '\t']))
    int separator = reference.find('/')
    if separator >= 0 && !base.contains('/') {
        return matches_value_pattern(reference.slice(separator + 1, reference.len()), base)
    }
    return false
}

#local
fn matches_value_pattern(string value, string pattern): bool {
    string lower_value = value.to_lower()
    string lower_pattern = strip_thinking_suffix(pattern.trim([' ', '\t'])).to_lower()
    if lower_pattern == '' {
        return false
    }
    // Pi's non-glob model patterns are case-insensitive partial matches;
    // minimatch-style glob patterns are anchored to the whole reference.
    if !has_glob(lower_pattern) {
        return lower_value.contains(lower_pattern)
    }
    return glob_matches(lower_pattern, lower_value)
}

pub fn glob_matches(string pattern, string value): bool {
    int width = value.len() + 1
    [i8] memo = []
    for int index = 0; index < (pattern.len() + 1) * width; index += 1 {
        memo.push(-1)
    }
    return glob_match_at(pattern, value, 0, 0, memo, width)
}

pub fn glob_match_at(string pattern, string value, int pattern_index, int value_index, [i8] memo, int width): bool {
    int memo_index = pattern_index * width + value_index
    if memo[memo_index] >= 0 {
        return memo[memo_index] == 1
    }
    bool matched = false
    if pattern_index == pattern.len() {
        matched = value_index == value.len()
    } else if pattern[pattern_index] == '*'.char() {
        int next = pattern_index
        for next < pattern.len() && pattern[next] == '*'.char() {
            next += 1
        }
        // A double-star crosses '/' boundaries; a single star does not.
        bool crosses_directories = next - pattern_index >= 2
        if crosses_directories && next < pattern.len() && pattern[next] == '/'.char() && glob_match_at(pattern, value, next + 1, value_index, memo, width) {
            matched = true
        }
        int cursor = value_index
        for !matched {
            if glob_match_at(pattern, value, next, cursor, memo, width) {
                matched = true
                break
            }
            if cursor >= value.len() || (!crosses_directories && value[cursor] == '/'.char()) {
                break
            }
            cursor += 1
        }
    } else if pattern[pattern_index] == '?'.char() {
        matched = value_index < value.len() && value[value_index] != '/'.char() && glob_match_at(pattern, value, pattern_index + 1, value_index + 1, memo, width)
    } else if pattern[pattern_index] == '['.char() {
        int close = pattern_index + 1
        bool negated = false
        if close < pattern.len() && (pattern[close] == '!'.char() || pattern[close] == '^'.char()) {
            negated = true
            close += 1
        }
        for close < pattern.len() && pattern[close] != ']'.char() {
            close += 1
        }
        if close >= pattern.len() || value_index >= value.len() {
            matched = value_index < value.len() && pattern[pattern_index] == value[value_index] && glob_match_at(pattern, value, pattern_index + 1, value_index + 1, memo, width)
        } else {
            bool member = false
            int cursor = pattern_index + 1 + (negated ? 1 : 0)
            for cursor < close {
                if cursor + 2 < close && pattern[cursor + 1] == '-'.char() {
                    if value[value_index] >= pattern[cursor] && value[value_index] <= pattern[cursor + 2] {
                        member = true
                    }
                    cursor += 3
                } else {
                    if pattern[cursor] == value[value_index] {
                        member = true
                    }
                    cursor += 1
                }
            }
            if negated {
                member = !member
            }
            matched = member && glob_match_at(pattern, value, close + 1, value_index + 1, memo, width)
        }
    } else if pattern[pattern_index] == '\\'.char() && pattern_index + 1 < pattern.len() {
        matched = value_index < value.len() && pattern[pattern_index + 1] == value[value_index] && glob_match_at(pattern, value, pattern_index + 2, value_index + 1, memo, width)
    } else {
        matched = value_index < value.len() && pattern[pattern_index] == value[value_index] && glob_match_at(pattern, value, pattern_index + 1, value_index + 1, memo, width)
    }
    memo[memo_index] = matched ? 1 : 0
    return matched
}
