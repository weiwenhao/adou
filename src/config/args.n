import adou.src.config.types

pub type string_result_t = struct {
    int index
    bool ok
    string value
    string error_message
}

pub type int_result_t = struct {
    int index
    bool ok
    int value
    string error_message
}

pub const HELP = 'adou - Nature coding agent with Pi core tools\n\nUsage:\n  adou [options] [@files...] [messages...]\n\nOptions:\n  --provider <deepseek|openai|anthropic>  Provider (default: inferred from API key, then deepseek)\n  --model <id>                   Model ID\n  --models <patterns>            Models allowed in the selector (comma-separated)\n  --list-models [pattern]        List available models, optionally filtered\n  --base-url <url>               Provider API base URL\n  --thinking <level>             off|minimal|low|medium|high|xhigh|max\n  --mode <text|json|rpc>         Output protocol (json emits newline-delimited events)\n  --serve-port <port>           RPC-over-IPC server port (localhost)\n  --session <path>               Open a Pi v3 JSONL session\n  --session-id <id>              Open a session by exact ID\n  --session-dir <dir>            Session storage directory\n  --continue, -c                 Continue the most recent project session\n  --resume, -r                   Resume the most recent project session\n  --fork <path>                  Fork an existing session into a new session\n  --name, -n <name>              Set the session display name\n  --print, -p                    One-shot mode; print the assistant response without the TUI\n  --export <path>                Export the current session and exit\n  --system-prompt <text>         Replace the default system prompt\n  --append-system-prompt <text>  Append text to the system prompt (repeatable)\n  --no-context-files, -nc        Do not load AGENTS.md or CLAUDE.md files\n  --no-tools, -nt                Disable all tools\n  --no-builtin-tools, -nbt       Disable built-in tools\n  --tools, -t <names>            Comma-separated built-in tools to enable\n  --exclude-tools, -xt <names>   Comma-separated built-in tools to disable\n  --skill <path>                 Load a skill file or directory (repeatable)\n  --no-skills, -ns               Disable default skill discovery (explicit --skill paths still load)\n  --no-session                   Keep the session in memory only\n  --approve, -a                  Mark the project as trusted\n  --no-approve, -na              Do not trust the project\n  --offline                      Do not make network requests\n  --verbose                     Show diagnostic errors\n  --debug                        Write lifecycle diagnostics to stderr\n  --context-window <tokens>      Model context window (required for threshold compaction on unknown models)\n  --max-tokens <tokens>          Maximum output tokens\n  --timeout-ms <milliseconds>    Provider timeout\n  --max-retries <count>          Transient provider retry count\n  --reserve-tokens <tokens>      Compaction reserve tokens\n  --keep-recent-tokens <tokens>  Tokens retained after compaction\n  --no-compaction                Disable automatic compaction\n  --api-key <key>                API key; may be retained in shell history, prefer environment variables\n  --help, -h                     Show this help\n  --version, -v                  Show version\n\nEnvironment:\n  DEEPSEEK_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, ADOU_MODEL, ADOU_PROVIDER\n  ADOU_CONTEXT_WINDOW, ADOU_MAX_TOKENS, ADOU_SESSION_DIR'

pub fn parse([string] argv): types.cli_args_t {
    var result = types.cli_args_t{}
    [string] errors = []
    int index = 1
    for index < argv.len() {
        string argument = argv[index]
        if argument == '--help' || argument == '-h' {
            result.help = true
        } else if argument == '--version' || argument == '-v' {
            result.version = true
        } else if argument == '--continue' || argument == '-c' {
            result.continue_recent = true
        } else if argument == '--resume' || argument == '-r' {
            result.resume = true
        } else if argument == '--print' || argument == '-p' {
            result.print_mode = true
            if index + 1 < argv.len() && !argv[index + 1].starts_with('@') && (!argv[index + 1].starts_with('-') || argv[index + 1].starts_with('---')) {
                result.messages.push(argv[index + 1])
                index += 1
            }
        } else if argument == '--mode' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {
                if consumed.value == 'text' || consumed.value == 'json' || consumed.value == 'rpc' {
                    result.mode = consumed.value
                    result.mode_explicit = true
                } else {
                    errors.push('--mode must be one of text, json or rpc')
                }
            } else {errors.push(consumed.error_message)}
        } else if argument == '--no-session' {
            result.no_session = true
        } else if argument == '--no-compaction' {
            result.no_compaction = true
        } else if argument == '--no-context-files' || argument == '-nc' {
            result.no_context_files = true
        } else if argument == '--no-tools' || argument == '-nt' {
            result.no_tools = true
        } else if argument == '--no-builtin-tools' || argument == '-nbt' {
            result.no_builtin_tools = true
        } else if argument == '--tools' || argument == '-t' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.tool_names = split_names(consumed.value)} else {errors.push(consumed.error_message)}
        } else if argument == '--exclude-tools' || argument == '-xt' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.exclude_tool_names = split_names(consumed.value)} else {errors.push(consumed.error_message)}
        } else if argument == '--skill' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.skill_paths.push(consumed.value)} else {errors.push(consumed.error_message)}
        } else if argument == '--no-skills' || argument == '-ns' {
            result.no_skills = true
        } else if argument == '--provider' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.provider = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--model' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.model = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--models' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.scoped_models = split_names(consumed.value)} else {errors.push(consumed.error_message)}
        } else if argument == '--base-url' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.base_url = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--api-key' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.api_key = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--thinking' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.thinking = consumed.value; result.thinking_explicit = true} else {errors.push(consumed.error_message)}
        } else if argument == '--session' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.session_path = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--session-id' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {
                result.session_id = consumed.value
                if !valid_session_id(result.session_id) {
                    errors.push('Session id must be non-empty, contain only alphanumeric characters, \'-\', \'_\', and \'.\', and start and end with an alphanumeric character')
                }
            } else {errors.push(consumed.error_message)}
        } else if argument == '--session-dir' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.session_dir = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--fork' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.fork_path = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--name' || argument == '-n' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {
                result.session_name = consumed.value
                if result.session_name.trim([' ', '\t', '\n', '\r']) == '' {
                    errors.push('--name requires a non-empty value')
                }
            } else {errors.push(consumed.error_message)}
        } else if argument == '--system-prompt' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.system_prompt = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--append-system-prompt' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.append_system_prompts.push(consumed.value)} else {errors.push(consumed.error_message)}
        } else if argument == '--context-window' {
            var consumed = consume_int(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.context_window = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--max-tokens' {
            var consumed = consume_int(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.max_tokens = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--timeout-ms' {
            var consumed = consume_int(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.timeout_ms = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--max-retries' {
            var consumed = consume_int(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.max_retries = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--reserve-tokens' {
            var consumed = consume_int(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.reserve_tokens = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--keep-recent-tokens' {
            var consumed = consume_int(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.keep_recent_tokens = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--export' {
            var consumed = consume_string(argv, index, argument)
            index = consumed.index
            if consumed.ok {result.export_path = consumed.value} else {errors.push(consumed.error_message)}
        } else if argument == '--list-models' {
            result.list_models = true
            if index + 1 < argv.len() && !argv[index + 1].starts_with('-') && !argv[index + 1].starts_with('@') {
                result.list_models_pattern = argv[index + 1]
                index += 1
            }
        } else if argument == '--verbose' {
            result.verbose = true
        } else if argument == '--debug' {
            result.debug = true
        } else if argument == '--serve-port' {
            var consumed = consume_int(argv, index, argument)
            if consumed.ok {
                result.serve_port = consumed.value
            } else {
                errors.push(consumed.error_message)
            }
            index = consumed.index
        } else if argument == '--offline' {
            result.offline = true
        } else if argument == '--approve' || argument == '-a' {
            result.trust_override = true
            result.trust_override_explicit = true
        } else if argument == '--no-approve' || argument == '-na' {
            result.trust_override = false
            result.trust_override_explicit = true
        } else if argument.starts_with('@') {
            if argument.len() > 1 {
                result.file_args.push(argument.slice(1, argument.len()))
            } else {
                errors.push('@ requires a file path')
            }
        } else if argument.starts_with('-') {
            errors.push('Unknown option: ' + argument)
        } else {
            result.messages.push(argument)
        }
        index += 1
    }
    if !valid_thinking(result.thinking) {
        errors.push('Invalid thinking level "' + result.thinking + '". Valid values: off, minimal, low, medium, high, xhigh, max')
    }
    if result.session_path != '' && result.session_id != '' {
        errors.push('--session-id cannot be combined with --session')
    }
    if result.session_id != '' && result.continue_recent {
        errors.push('--session-id cannot be combined with --continue')
    }
    if result.session_id != '' && result.resume {
        errors.push('--session-id cannot be combined with --resume')
    }
    if result.session_path != '' && result.continue_recent {
        errors.push('--session and --continue cannot be used together')
    }
    if result.session_path != '' && result.resume {
        errors.push('--session and --resume cannot be used together')
    }
    if result.no_session && (result.session_path != '' || result.continue_recent || result.resume || result.fork_path != '') {
        errors.push('--no-session cannot be combined with --session, --continue, --resume or --fork')
    }
    if result.fork_path != '' && (result.session_path != '' || result.continue_recent || result.resume) {
        errors.push('--fork cannot be combined with --session, --continue or --resume')
    }
    if result.mode == 'rpc' && result.print_mode {
        errors.push('--mode rpc cannot be combined with --print')
    }
    if result.export_path != '' && result.no_session {
        errors.push('--export cannot be combined with --no-session')
    }
    result.errors = errors
    return result
}

// Pi combines stdin and @file text with the first CLI message, then sends
// every remaining CLI message as a separate prompt.  Keep this transformation
// independent of the application loop so the text ordering can be tested
// without starting a provider.
pub fn prepend_initial_text([string] messages, string prefix): [string] {
    if prefix == '' {
        return messages
    }
    [string] result = []
    if messages.len() == 0 {
        result.push(prefix)
        return result
    }
    result.push(prefix + messages[0])
    int index = 1
    for index < messages.len() {
        result.push(messages[index])
        index += 1
    }
    return result
}

#local
fn consume_string([string] argv, int index, string option): string_result_t {
    if index + 1 >= argv.len() || argv[index + 1].starts_with('-') {
        return string_result_t {index: index, error_message: option + ' requires a value',}
    }
    return string_result_t {index: index + 1, ok: true, value: argv[index + 1],}
}

#local
fn consume_int([string] argv, int index, string option): int_result_t {
    var consumed = consume_string(argv, index, option)
    if !consumed.ok {
        return int_result_t {index: consumed.index, error_message: consumed.error_message,}
    }
    int parsed = consumed.value.to_int() catch error {
        return int_result_t {index: consumed.index, error_message: option + ' requires an integer, got: ' + consumed.value,}
    }
    if parsed < 0 {
        return int_result_t {index: consumed.index, error_message: option + ' must not be negative',}
    }
    return int_result_t {index: consumed.index, ok: true, value: parsed,}
}

pub fn valid_thinking(string value): bool {
    return value == 'off' || value == 'minimal' || value == 'low' || value == 'medium' || value == 'high' || value == 'xhigh' || value == 'max'
}

pub fn valid_session_id(string value): bool {
    if value == '' || !is_session_id_alphanumeric(value[0]) || !is_session_id_alphanumeric(value[value.len() - 1]) {
        return false
    }
    for int index = 0; index < value.len(); index += 1 {
        u8 character = value[index]
        if !is_session_id_alphanumeric(character) && character != '-'.char() && character != '_'.char() && character != '.'.char() {
            return false
        }
    }
    return true
}

#local
fn is_session_id_alphanumeric(u8 value): bool {
    return (value >= 'a'.char() && value <= 'z'.char()) || (value >= 'A'.char() && value <= 'Z'.char()) || (value >= '0'.char() && value <= '9'.char())
}

#local
fn split_names(string value): [string] {
    [string] result = []
    for item in value.split(',') {
        string name = item.trim([' ', '\t', '\n', '\r'])
        if name != '' {
            result.push(name)
        }
    }
    return result
}
