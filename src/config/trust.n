import adou.src.json_util
import adou.src.tools.path_utils
import adou.src.config.paths
import fs
import json
import os
import path
import syscall


// Project trust follows Pi's nearest-ancestor decision semantics.  It is
// independent from provider credentials and can be changed with `/trust`.
pub fn decision(string cwd): bool? {
    string file_path = trust_path()
    if !path_utils.exists(file_path) {return null}
    var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {return null}
    string content = input.content() catch error {
        input.close()
        return null
    }
    input.close()
    var root = json_util.parse(content) catch error {return null}
    if !json_util.is_obj(root) {return null}
    {string:any} object = root as {string:any}
    string current = normalize(cwd)
    for true {
        if object.contains(current) && object[current] is bool {
            return object[current] as bool
        }
        string parent = path.dir(current)
        if parent == current || parent == '' {break}
        current = parent
    }
    return null
}

pub fn save(string cwd, bool trusted): void! {
    string file_path = trust_path()
    {string:any} object = read_object(file_path)
    object[normalize(cwd)] = trusted
    write_object(file_path, object)
}

pub type trust_update_t = struct {
    string trust_path
    bool decision
    bool remove
}

// Pi's setMany: apply multiple updates in one locked read-modify-write; a
// null decision removes the entry instead of storing null.
pub fn set_many([trust_update_t] updates): void! {
    string file_path = trust_path()
    {string:any} object = read_object(file_path)
    for update in updates {
        string key = normalize(update.trust_path)
        if update.remove {
            if object.contains(key) {
                object.del(key)
            }
        } else {
            bool value = update.decision
            object[key] = value
        }
    }
    write_object(file_path, object)
}

pub fn clear(string cwd): void! {
    string file_path = trust_path()
    {string:any} object = read_object(file_path)
    string key = normalize(cwd)
    if object.contains(key) {
        object.del(key)
        write_object(file_path, object)
    }
}

// Pi's getProjectTrustOptions: the UI choice set for a project.  "Trust
// parent folder" also clears the current project entry so the parent
// decision governs it.  include_session_only adds the session-scoped
// variants (no persisted update).
pub type trust_option_t = struct {
    string label
    bool trusted
    [trust_update_t] updates = []
    string saved_path
}

pub fn get_project_trust_options(string cwd, bool include_session_only): [trust_option_t] {
    [trust_option_t] options = []
    string trust_path_value = normalize(cwd)
    [trust_update_t] trust_updates = []
    trust_updates.push(trust_update_t {trust_path: trust_path_value, decision: true, remove: false})
    options.push(trust_option_t {label: 'Trust', trusted: true, updates: trust_updates, saved_path: trust_path_value})
    string parent_path_value = trust_parent_path(cwd)
    if parent_path_value != '' {
        [trust_update_t] parent_updates = []
        parent_updates.push(trust_update_t {trust_path: parent_path_value, decision: true, remove: false})
        parent_updates.push(trust_update_t {trust_path: trust_path_value, decision: false, remove: true})
        options.push(trust_option_t {label: 'Trust parent folder (' + parent_path_value + ')', trusted: true, updates: parent_updates, saved_path: parent_path_value})
    }
    if include_session_only {
        [trust_update_t] session_updates = []
        options.push(trust_option_t {label: 'Trust (this session only)', trusted: true, updates: session_updates, saved_path: ''})
    }
    [trust_update_t] no_updates = []
    no_updates.push(trust_update_t {trust_path: trust_path_value, decision: false, remove: false})
    options.push(trust_option_t {label: 'Do not trust', trusted: false, updates: no_updates, saved_path: trust_path_value})
    if include_session_only {
        [trust_update_t] no_session_updates = []
        options.push(trust_option_t {label: 'Do not trust (this session only)', trusted: false, updates: no_session_updates, saved_path: ''})
    }
    return options
}

pub fn trust_parent_path(string cwd): string {
    string normalized = normalize(cwd)
    string parent = path.dir(normalized)
    if parent == normalized || parent == '' {
        return ''
    }
    return parent
}

// Pi's hasTrustRequiringProjectResources: project-local .pi resources or a
// non-user .agents/skills directory in cwd or an ancestor require trust.
pub fn has_trust_requiring_resources(string cwd): bool {    [string] resources = ['settings.json', 'extensions', 'skills', 'prompts', 'themes', 'SYSTEM.md', 'APPEND_SYSTEM.md']
    string current = normalize(cwd)
    string config_dir = path.join(current, CONFIG_DIR_NAME)
    for resource in resources {
        if path_utils.exists(path.join(config_dir, resource)) {
            return true
        }
    }
    string home = home_dir()
    string user_skills = path.join(home, '.agents', 'skills')
    for true {
        string agents_skills = path.join(current, '.agents', 'skills')
        if agents_skills != user_skills && path_utils.exists(agents_skills) {
            return true
        }
        string parent = path.dir(current)
        if parent == current || parent == '' {
            return false
        }
        current = parent
    }
    return false
}

#local
fn write_object(string file_path, {string:any} object): void! {
    os.mkdirs(path.dir(file_path), 0o700)
    var output = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o600)
    string content = json.serialize(object)
    int written = output.write(content as [u8])
    output.close()
    if written != content.len() {throw errorf('Could not write project trust store')}
}

#local
fn home_dir(): string {
    return syscall.get_env('HOME')
}

pub const CONFIG_DIR_NAME = '.pi'

#local
fn read_object(string file_path): {string:any} {
    if !path_utils.exists(file_path) {return {}}
    var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {return {}}
    string content = input.content() catch error {
        input.close()
        return {}
    }
    input.close()
    if content == '' {return {}}
    var parsed = json_util.parse(content) catch error {return {}}
    if !json_util.is_obj(parsed) {return {}}
    return parsed as {string:any}
}

pub fn trust_path(): string {
    return paths.trust_path()
}

pub fn normalize(string value): string {
    string result = path_utils.clean(value)
    if result == '' {return '/'}
    return result
}
