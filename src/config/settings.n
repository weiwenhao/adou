import adou.src.json_util
import adou.src.tools.path_utils
import adou.src.config.atomic_io
import adou.src.config.paths
import fs
import fmt
import json
import libc
import os
import path
import syscall


pub type settings_t = struct {
    string default_provider
    string default_model
    // Pi's default thinking level is medium. Keep an explicit `off` only
    // when the user selected it, rather than treating an absent setting as
    // disabled reasoning.
    string default_thinking_level = 'medium'
    bool auto_compaction = true
    string steering_mode = 'one-at-a-time'
    string follow_up_mode = 'one-at-a-time'
    bool hide_thinking
    // In-memory retry policy stays flat for the session runner; the on-disk
    // shape is Pi's nested retry.{enabled,maxRetries,baseDelayMs}.
    bool retry_enabled = true
    int retry_max_attempts = 3
    int retry_base_delay_ms = 2000
    // Pi compaction.reserveTokens / keepRecentTokens sub-settings.
    int reserve_tokens = 16384
    int keep_recent_tokens = 20000
    [string] enabled_model_ids = []
    // Preserve the distinction between an absent enabledModels key (all
    // enabled) and an explicitly configured ordered list, including [].
    bool enabled_models_configured
    // Theme value: 'light', 'dark', or Pi's automatic pair 'light/dark'
    // (lightTheme/darkTheme separated by '/').  The active variant is
    // resolved by the TUI from the terminal appearance.
    string theme = 'dark'
    [string] enabled_skill_names = []
    [string] enabled_prompt_names = []
    // An absent enabledSkills/enabledPrompts key means "all"; an explicit
    // empty array means "none".  Keep that distinction for Config toggles.
    bool enabled_skills_configured
    bool enabled_prompts_configured
    // Pi settings.autocompleteMaxVisible: max visible rows of the editor
    // autocomplete SelectList (3-20, default 5).
    int autocomplete_max_visible = 5
    // Pi settings.transport: preferred transport for providers that support
    // multiple transports. 'websocket-cached' is carried as-is.
    string transport = 'auto'
    // Pi settings.httpIdleTimeoutMs: default request idle timeout in ms;
    // 0 disables it.  300000 matches Pi's DEFAULT_HTTP_IDLE_TIMEOUT_MS.
    int http_idle_timeout_ms = 300000
    bool show_cache_miss_notices
    bool collapse_changelog
    bool quiet_startup
    bool enable_install_telemetry = true
    // Pi's first-time setup controls analytics independently from the
    // anonymous install/update ping.
    bool enable_analytics
    string tracking_id
    // Pi settings.defaultProjectTrust: global-only fallback for projects
    // with no stored decision ('ask' | 'always' | 'never').
    string default_project_trust = 'ask'
    bool enable_skill_commands = true
    // Pi settings.doubleEscapeAction: 'tree' | 'fork' | 'none'.
    string double_escape_action = 'tree'
    // Pi settings.treeFilterMode: default filter when opening /tree.
    string tree_filter_mode = 'default'
    // Pi settings.showHardwareCursor with ADOU_HARDWARE_CURSOR env fallback.
    bool show_hardware_cursor
    int editor_padding_x
    int output_pad = 1
    // Pi settings.terminal.clearOnShrink / showTerminalProgress.
    bool terminal_clear_on_shrink
    bool terminal_progress
    bool show_images = true
    int image_width_cells = 60
    bool auto_resize_images = true
    bool block_images
    // Pi settings.warnings.anthropicExtraUsage.
    bool warnings_anthropic_extra_usage = true
    // B6: remaining Pi keys with Adou consumers or persistence parity.
    string last_changelog_version
    string external_editor
    string shell_path
    string shell_command_prefix
    string http_proxy
    int websocket_connect_timeout_ms = 30000
    {string:string} thinking_budgets = {}
}

pub fn load(): settings_t {
    return load_file(settings_path(), settings_t{})
}

// Trust-aware settings resolution (B1-R2-06/07): a trusted project cwd
// merges global + project settings; an untrusted cwd sees ONLY the global
// settings, so project overrides (autocompleteMaxVisible, enabledSkills,
// enabledPrompts, ...) can never leak into an untrusted session.  All
// view-level runtime reads go through this single function.
pub fn load_trusted_for(string cwd, bool trusted): settings_t {
    if !trusted {
        return load()
    }
    return load_for(cwd)
}

// Adou keeps a global settings file and a project-local .adou/settings.json. The
// project object is a partial override: fields absent from the project file
// retain their global values, while arrays such as enabledModels replace the
// corresponding global array when explicitly present.  defaultProjectTrust
// is Pi's one global-only key: a project file can never override it.
pub fn load_for(string cwd): settings_t {
    var result = load_file(settings_path(), settings_t{})
    string global_trust = result.default_project_trust
    result = load_file(paths.project_settings_path(cwd), result)
    result.default_project_trust = global_trust
    return result
}

fn load_file(string file_path, settings_t initial): settings_t {
    var result = initial
    if !path_utils.exists(file_path) {return result}
    var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {return result}
    string content = input.content() catch error {
        input.close()
        return result
    }
    input.close()
    var root = json_util.parse(content) catch error {return result}
    if !json_util.is_obj(root) {return result}
    var object = root as {string:any}
    result.default_provider = string_value(object, 'defaultProvider', result.default_provider)
    result.default_model = string_value(object, 'defaultModel', result.default_model)
    result.default_thinking_level = thinking_level(string_value(object, 'defaultThinkingLevel', result.default_thinking_level))
    result.steering_mode = queue_mode(string_value(object, 'steeringMode', result.steering_mode))
    result.follow_up_mode = queue_mode(string_value(object, 'followUpMode', result.follow_up_mode))
    result.hide_thinking = bool_value(object, 'hideThinkingBlock', result.hide_thinking)
    result.show_cache_miss_notices = bool_value(object, 'showCacheMissNotices', result.show_cache_miss_notices)
    result.collapse_changelog = bool_value(object, 'collapseChangelog', result.collapse_changelog)
    result.quiet_startup = bool_value(object, 'quietStartup', result.quiet_startup)
    result.enable_install_telemetry = bool_value(object, 'enableInstallTelemetry', result.enable_install_telemetry)
    result.enable_analytics = bool_value(object, 'enableAnalytics', result.enable_analytics)
    result.tracking_id = string_value(object, 'trackingId', result.tracking_id)
    result.default_project_trust = trust_mode(string_value(object, 'defaultProjectTrust', result.default_project_trust))
    result.enable_skill_commands = bool_value(object, 'enableSkillCommands', result.enable_skill_commands)
    result.double_escape_action = double_escape(string_value(object, 'doubleEscapeAction', result.double_escape_action))
    result.tree_filter_mode = tree_filter(string_value(object, 'treeFilterMode', result.tree_filter_mode))
    result.transport = transport_value(string_value(object, 'transport', result.transport))
    result.editor_padding_x = padding_clamp(int_value(object, 'editorPaddingX', result.editor_padding_x))
    result.output_pad = int_value(object, 'outputPad', result.output_pad) == 0 ? 0 : 1
    if object.contains('showHardwareCursor') {
        result.show_hardware_cursor = bool_value(object, 'showHardwareCursor', result.show_hardware_cursor)
    } else {
        // Pi getShowHardwareCursor: file value wins, then ADOU_HARDWARE_CURSOR.
        result.show_hardware_cursor = syscall.get_env('ADOU_HARDWARE_CURSOR') == '1'
    }
    result.http_idle_timeout_ms = http_idle_timeout(object, result.http_idle_timeout_ms)
    string theme_value = string_value(object, 'theme', result.theme)
    if theme_value == 'light' || theme_value == 'dark' || theme_value.contains('/') {
        result.theme = theme_value
    }
    int max_visible = autocomplete_value(object, 'autocompleteMaxVisible', result.autocomplete_max_visible)
    result.autocomplete_max_visible = autocomplete_clamp(max_visible)
    if object.contains('enabledSkills') && object['enabledSkills'] is [any] {
        result.enabled_skills_configured = true
        result.enabled_skill_names = []
        for item in object['enabledSkills'] as [any] {
            if item is string && (item as string) != '' {
                result.enabled_skill_names.push(item as string)
            }
        }
    }
    if object.contains('enabledPrompts') && object['enabledPrompts'] is [any] {
        result.enabled_prompts_configured = true
        result.enabled_prompt_names = []
        for item in object['enabledPrompts'] as [any] {
            if item is string && (item as string) != '' {
                result.enabled_prompt_names.push(item as string)
            }
        }
    }
    result = load_compaction(object, result)
    result = load_retry(object, result)
    result = load_terminal(object, result)
    result = load_images(object, result)
    result = load_warnings(object, result)
    result.last_changelog_version = string_value(object, 'lastChangelogVersion', result.last_changelog_version)
    result.external_editor = string_value(object, 'externalEditor', result.external_editor)
    result.shell_path = string_value(object, 'shellPath', result.shell_path)
    result.shell_command_prefix = string_value(object, 'shellCommandPrefix', result.shell_command_prefix)
    result.http_proxy = string_value(object, 'httpProxy', result.http_proxy)
    result.websocket_connect_timeout_ms = positive_int(object, 'websocketConnectTimeoutMs', result.websocket_connect_timeout_ms)
    if object.contains('thinkingBudgets') && json_util.is_obj(object['thinkingBudgets']) {
        var budgets = object['thinkingBudgets'] as {string:any}
        for level, budget in budgets {
            if budget is string {
                result.thinking_budgets[level] = budget as string
            } else if budget is f64 {
                result.thinking_budgets[level] = fmt.sprintf('%d', budget as f64 as int)
            }
        }
    }
    if object.contains('enabledModels') && object['enabledModels'] is [any] {
        // An explicitly configured project array replaces the global scope;
        // it is not appended to it.
        result.enabled_model_ids = []
        result.enabled_models_configured = true
        var enabled_values = object['enabledModels'] as [any]
        for item in enabled_values {
            if item is string {
                string model_id = item as string
                if model_id != '' {result.enabled_model_ids.push(model_id)}
            }
        }
    }
    return result
}

// Pi migration behavior kept at load: a legacy flat autoCompaction key is
// only consulted when the Pi-shaped compaction.enabled key is absent.
fn load_compaction({string:any} object, settings_t initial): settings_t {
    var result = initial
    any compaction_value = null
    if object.contains('compaction') {
        compaction_value = object['compaction']
    }
    if json_util.is_obj(compaction_value) {
        var compaction = compaction_value as {string:any}
        if compaction.contains('enabled') {
            result.auto_compaction = bool_value(compaction, 'enabled', result.auto_compaction)
        } else if object.contains('autoCompaction') {
            result.auto_compaction = bool_value(object, 'autoCompaction', result.auto_compaction)
        }
        int reserve = positive_int(compaction, 'reserveTokens', result.reserve_tokens)
        if reserve > 0 {
            result.reserve_tokens = reserve
        }
        int keep_recent = positive_int(compaction, 'keepRecentTokens', result.keep_recent_tokens)
        if keep_recent > 0 {
            result.keep_recent_tokens = keep_recent
        }
    } else if object.contains('autoCompaction') {
        result.auto_compaction = bool_value(object, 'autoCompaction', result.auto_compaction)
    }
    return result
}

// Legacy flat retryEnabled/retryMaxAttempts/retryBaseDelayMs keys migrate
// into Pi's nested retry object shape; the nested shape wins when present.
fn load_retry({string:any} object, settings_t initial): settings_t {
    var result = initial
    any retry_value = null
    if object.contains('retry') {
        retry_value = object['retry']
    }
    if json_util.is_obj(retry_value) {
        var retry = retry_value as {string:any}
        result.retry_enabled = bool_value(retry, 'enabled', result.retry_enabled)
        result.retry_max_attempts = positive_int(retry, 'maxRetries', result.retry_max_attempts)
        result.retry_base_delay_ms = positive_int(retry, 'baseDelayMs', result.retry_base_delay_ms)
        return result
    }
    if object.contains('retryEnabled') {
        result.retry_enabled = bool_value(object, 'retryEnabled', result.retry_enabled)
    }
    if object.contains('retryMaxAttempts') {
        result.retry_max_attempts = positive_int(object, 'retryMaxAttempts', result.retry_max_attempts)
    }
    if object.contains('retryBaseDelayMs') {
        result.retry_base_delay_ms = positive_int(object, 'retryBaseDelayMs', result.retry_base_delay_ms)
    }
    return result
}

fn load_terminal({string:any} object, settings_t initial): settings_t {
    var result = initial
    any terminal_value = null
    if object.contains('terminal') {
        terminal_value = object['terminal']
    }
    if json_util.is_obj(terminal_value) {
        var terminal = terminal_value as {string:any}
        if terminal.contains('clearOnShrink') {
            result.terminal_clear_on_shrink = bool_value(terminal, 'clearOnShrink', result.terminal_clear_on_shrink)
        } else {
            result.terminal_clear_on_shrink = syscall.get_env('ADOU_CLEAR_ON_SHRINK') == '1'
        }
        result.terminal_progress = bool_value(terminal, 'showTerminalProgress', result.terminal_progress)
        result.show_images = bool_value(terminal, 'showImages', result.show_images)
        int image_width = int_value(terminal, 'imageWidthCells', result.image_width_cells)
        if image_width > 0 {result.image_width_cells = image_width}
        return result
    }
    // Pi: setting wins, then env, then default false.
    result.terminal_clear_on_shrink = syscall.get_env('ADOU_CLEAR_ON_SHRINK') == '1'
    return result
}

fn load_images({string:any} object, settings_t initial): settings_t {
    var result = initial
    if object.contains('images') && json_util.is_obj(object['images']) {
        var images = object['images'] as {string:any}
        result.auto_resize_images = bool_value(images, 'autoResize', result.auto_resize_images)
        result.block_images = bool_value(images, 'blockImages', result.block_images)
    }
    return result
}

fn load_warnings({string:any} object, settings_t initial): settings_t {
    var result = initial
    any warnings_value = null
    if object.contains('warnings') {
        warnings_value = object['warnings']
    }
    if !json_util.is_obj(warnings_value) {return result}
    var warnings = warnings_value as {string:any}
    result.warnings_anthropic_extra_usage = bool_value(warnings, 'anthropicExtraUsage', result.warnings_anthropic_extra_usage)
    return result
}

fn read_raw(string file_path): {string:any} {
    if !path_utils.exists(file_path) {return {}}
    var input = fs.open(file_path, syscall.O_RDONLY, 0) catch error {return {}}
    string content = input.content() catch error {
        input.close()
        return {}
    }
    input.close()
    var root = json_util.parse(content) catch error {return {}}
    if !json_util.is_obj(root) {return {}}
    return root as {string:any}
}
pub fn save(settings_t settings): void! {
    save_to(settings, settings_path())
}

// Project-local resource toggles use the same Pi-shaped document writer as
// global settings, but must never overwrite the user's global settings file.
// Keep the target explicit so a Config selector scope switch is observable
// in the correct file.
pub fn save_project(string cwd, settings_t settings): void! {
    save_to(settings, paths.project_settings_path(cwd))
}

fn save_to(settings_t settings, string file_path): void! {
    // Merge over the existing file so unknown keys (theme, packages,
    // transport, ...) survive a save; Pi's settings manager keeps the full
    // document shape.
    {string:any} object = read_raw(file_path)
    object['defaultProvider'] = settings.default_provider
    object['defaultModel'] = settings.default_model
    object['defaultThinkingLevel'] = settings.default_thinking_level
    object['theme'] = settings.theme
    object['steeringMode'] = queue_mode(settings.steering_mode)
    object['followUpMode'] = queue_mode(settings.follow_up_mode)
    object['hideThinkingBlock'] = settings.hide_thinking
    object['showCacheMissNotices'] = settings.show_cache_miss_notices
    object['collapseChangelog'] = settings.collapse_changelog
    object['quietStartup'] = settings.quiet_startup
    object['enableInstallTelemetry'] = settings.enable_install_telemetry
    object['enableAnalytics'] = settings.enable_analytics
    if settings.tracking_id != '' {
        object['trackingId'] = settings.tracking_id
    } else if object.contains('trackingId') {
        object.del('trackingId')
    }
    object['defaultProjectTrust'] = trust_mode(settings.default_project_trust)
    object['enableSkillCommands'] = settings.enable_skill_commands
    object['doubleEscapeAction'] = double_escape(settings.double_escape_action)
    object['treeFilterMode'] = tree_filter(settings.tree_filter_mode)
    object['transport'] = transport_value(settings.transport)
    object['httpIdleTimeoutMs'] = settings.http_idle_timeout_ms
    object['editorPaddingX'] = padding_clamp(settings.editor_padding_x)
    object['outputPad'] = settings.output_pad == 0 ? 0 : 1
    object['showHardwareCursor'] = settings.show_hardware_cursor
    object['autocompleteMaxVisible'] = autocomplete_clamp(settings.autocomplete_max_visible)
    // Pi-shaped nested compaction object replaces the legacy flat key.
    {string:any} compaction_object = json_util.opt_obj(object, 'compaction')
    compaction_object['enabled'] = settings.auto_compaction
    compaction_object['reserveTokens'] = settings.reserve_tokens
    compaction_object['keepRecentTokens'] = settings.keep_recent_tokens
    object['compaction'] = compaction_object
    if object.contains('autoCompaction') {
        object.del('autoCompaction')
    }
    // Pi-shaped nested retry object replaces the legacy flat keys.
    {string:any} retry_object = json_util.opt_obj(object, 'retry')
    retry_object['enabled'] = settings.retry_enabled
    retry_object['maxRetries'] = settings.retry_max_attempts
    retry_object['baseDelayMs'] = settings.retry_base_delay_ms
    object['retry'] = retry_object
    if object.contains('retryEnabled') {
        object.del('retryEnabled')
    }
    if object.contains('retryMaxAttempts') {
        object.del('retryMaxAttempts')
    }
    if object.contains('retryBaseDelayMs') {
        object.del('retryBaseDelayMs')
    }
    {string:any} terminal_object = json_util.opt_obj(object, 'terminal')
    terminal_object['clearOnShrink'] = settings.terminal_clear_on_shrink
    terminal_object['showTerminalProgress'] = settings.terminal_progress
    terminal_object['showImages'] = settings.show_images
    terminal_object['imageWidthCells'] = settings.image_width_cells
    object['terminal'] = terminal_object
    {string:any} images_object = json_util.opt_obj(object, 'images')
    images_object['autoResize'] = settings.auto_resize_images
    images_object['blockImages'] = settings.block_images
    object['images'] = images_object
    {string:any} warnings_object = json_util.opt_obj(object, 'warnings')
    warnings_object['anthropicExtraUsage'] = settings.warnings_anthropic_extra_usage
    object['warnings'] = warnings_object
    if settings.last_changelog_version != '' {
        object['lastChangelogVersion'] = settings.last_changelog_version
    }
    if settings.external_editor != '' {
        object['externalEditor'] = settings.external_editor
    }
    if settings.shell_path != '' {
        object['shellPath'] = settings.shell_path
    }
    if settings.shell_command_prefix != '' {
        object['shellCommandPrefix'] = settings.shell_command_prefix
    }
    if settings.http_proxy != '' {
        object['httpProxy'] = settings.http_proxy
    }
    if object.contains('websocketConnectTimeoutMs') || settings.websocket_connect_timeout_ms != 30000 {
        object['websocketConnectTimeoutMs'] = settings.websocket_connect_timeout_ms
    }
    if settings.thinking_budgets.len() > 0 {
        {string:any} budgets_object = {}
        for level, budget in settings.thinking_budgets {
            budgets_object[level] = budget
        }
        object['thinkingBudgets'] = budgets_object
    }
    if settings.enabled_models_configured {
        [any] enabled = []
        for model_id in settings.enabled_model_ids {
            enabled.push(model_id)
        }
        object['enabledModels'] = enabled
    } else if object.contains('enabledModels') {
        object.del('enabledModels')
    }
    if settings.enabled_skills_configured || settings.enabled_skill_names.len() > 0 {
        [any] skill_values = []
        for name in settings.enabled_skill_names {
            skill_values.push(name)
        }
        object['enabledSkills'] = skill_values
    } else if object.contains('enabledSkills') {
        object.del('enabledSkills')
    }
    if settings.enabled_prompts_configured || settings.enabled_prompt_names.len() > 0 {
        [any] prompt_values = []
        for name in settings.enabled_prompt_names {
            prompt_values.push(name)
        }
        object['enabledPrompts'] = prompt_values
    } else if object.contains('enabledPrompts') {
        object.del('enabledPrompts')
    }
    os.mkdirs(path.dir(file_path), 0o700)
    string content = json.serialize(object)
    // B1.4 (docs/porting-plan-100): Pi writes settings under proper-lockfile
    // with atomic replacement.  Hold the same exclusive lock across the
    // write and replace the file durably (temp + fsync + rename) so a crash
    // can never leave truncated settings behind.
    i32 lock_fd = atomic_io.acquire_lock(file_path)
    atomic_io.write_file_atomic(file_path, content) catch e {
        atomic_io.release_lock(lock_fd) catch e2 {}
        throw e
    }
    atomic_io.release_lock(lock_fd) catch e2 {}
}

// Pi persists the selected model immediately.  Keep this operation shared by
// the TUI, RPC, and headless callers instead of making it a UI-only side
// effect.
pub fn set_default_model(string provider, string model): void! {
    var settings = load()
    settings.default_provider = provider
    settings.default_model = model
    save(settings)
}

pub fn set_default_thinking(string level): void! {
    var settings = load()
    settings.default_thinking_level = thinking_level(level)
    save(settings)
}

pub fn set_enabled_models([string] enabled_model_ids, bool configured): void! {
    var settings = load()
    settings.enabled_model_ids = []
    for id in enabled_model_ids {
        settings.enabled_model_ids.push(id)
    }
    settings.enabled_models_configured = configured
    save(settings)
}

// Pi's SettingsManager persists each mutable session preference immediately.
// Keep the narrow setters here so RPC and TUI callers do not accidentally
// replace unrelated settings while changing one toggle.
pub fn set_auto_compaction(bool enabled): void! {
    var settings = load()
    settings.auto_compaction = enabled
    save(settings)
}

pub fn set_steering_mode(string mode): void! {
    var settings = load()
    settings.steering_mode = queue_mode(mode)
    save(settings)
}

pub fn set_follow_up_mode(string mode): void! {
    var settings = load()
    settings.follow_up_mode = queue_mode(mode)
    save(settings)
}

pub fn set_retry_enabled(bool enabled): void! {
    var settings = load()
    settings.retry_enabled = enabled
    save(settings)
}

pub fn set_theme(string value): void! {
    var settings = load()
    settings.theme = value
    save(settings)
}

pub fn set_transport(string value): void! {
    var settings = load()
    settings.transport = transport_value(value)
    save(settings)
}

pub fn set_http_idle_timeout_ms(int timeout_ms): void! {
    var settings = load()
    settings.http_idle_timeout_ms = timeout_ms < 0 ? 0 : timeout_ms
    save(settings)
}

pub fn set_show_cache_miss_notices(bool enabled): void! {
    var settings = load()
    settings.show_cache_miss_notices = enabled
    save(settings)
}

pub fn set_collapse_changelog(bool enabled): void! {
    var settings = load()
    settings.collapse_changelog = enabled
    save(settings)
}

pub fn set_quiet_startup(bool enabled): void! {
    var settings = load()
    settings.quiet_startup = enabled
    save(settings)
}

pub fn set_enable_install_telemetry(bool enabled): void! {
    var settings = load()
    settings.enable_install_telemetry = enabled
    save(settings)
}

pub fn set_enable_analytics(bool enabled, string tracking_id): void! {
    var settings = load()
    settings.enable_analytics = enabled
    settings.tracking_id = enabled ? tracking_id : settings.tracking_id
    save(settings)
}

pub fn set_default_project_trust(string mode): void! {
    var settings = load()
    settings.default_project_trust = trust_mode(mode)
    save(settings)
}

pub fn set_enable_skill_commands(bool enabled): void! {
    var settings = load()
    settings.enable_skill_commands = enabled
    save(settings)
}

pub fn set_double_escape_action(string action): void! {
    var settings = load()
    settings.double_escape_action = double_escape(action)
    save(settings)
}

pub fn set_tree_filter_mode(string mode): void! {
    var settings = load()
    settings.tree_filter_mode = tree_filter(mode)
    save(settings)
}

pub fn set_show_hardware_cursor(bool enabled): void! {
    var settings = load()
    settings.show_hardware_cursor = enabled
    save(settings)
}

pub fn set_editor_padding_x(int padding): void! {
    var settings = load()
    settings.editor_padding_x = padding_clamp(padding)
    save(settings)
}

pub fn set_output_pad(int padding): void! {
    var settings = load()
    settings.output_pad = padding == 0 ? 0 : 1
    save(settings)
}

pub fn set_terminal_clear_on_shrink(bool enabled): void! {
    var settings = load()
    settings.terminal_clear_on_shrink = enabled
    save(settings)
}

pub fn set_terminal_progress(bool enabled): void! {
    var settings = load()
    settings.terminal_progress = enabled
    save(settings)
}

// Pi markChangelogSeen: the /changelog dismissal loop records the version.
pub fn set_last_changelog_version(string version): void! {
    var settings = load()
    settings.last_changelog_version = version
    save(settings)
}

pub fn set_warnings_anthropic_extra_usage(bool enabled): void! {
    var settings = load()
    settings.warnings_anthropic_extra_usage = enabled
    save(settings)
}

pub fn settings_path(): string {
    return paths.settings_path()
}

fn queue_mode(string value): string {
    return value == 'all' ? value : 'one-at-a-time'
}

pub fn thinking_level(string value): string {
    if value == 'minimal' || value == 'low' || value == 'medium' || value == 'high' || value == 'xhigh' || value == 'max' {return value}
    return 'off'
}

fn trust_mode(string value): string {
    return value == 'always' || value == 'never' ? value : 'ask'
}

fn double_escape(string value): string {
    return value == 'tree' || value == 'fork' || value == 'none' ? value : 'tree'
}

fn tree_filter(string value): string {
    if value == 'no-tools' || value == 'user-only' || value == 'labeled-only' || value == 'all' {return value}
    return 'default'
}

fn transport_value(string value): string {
    if value == 'sse' || value == 'websocket' || value == 'websocket-cached' {return value}
    return 'auto'
}

// Pi parseHttpIdleTimeoutMs: numeric >= 0, or the string "disabled" (0);
// anything else keeps the inherited value (Adou load stays quiet where Pi
// records a load error).
fn http_idle_timeout({string:any} object, int fallback): int {
    if !object.contains('httpIdleTimeoutMs') {return fallback}
    any value = object['httpIdleTimeoutMs']
    if value is f64 {
        int parsed = value as f64 as int
        return parsed >= 0 ? parsed : fallback
    }
    if value is string && (value as string).trim([' ', '\t']) == 'disabled' {
        return 0
    }
    return fallback
}

fn string_value({string:any} object, string key, string fallback): string {
    if object.contains(key) && object[key] is string {return object[key] as string}
    return fallback
}

fn bool_value({string:any} object, string key, bool fallback): bool {
    if object.contains(key) && object[key] is bool {return object[key] as bool}
    return fallback
}

fn int_value({string:any} object, string key, int fallback): int {
    if !object.contains(key) || !(object[key] is f64) {return fallback}
    return object[key] as f64 as int
}

fn positive_int({string:any} object, string key, int fallback): int {
    if !object.contains(key) || !(object[key] is f64) {return fallback}
    int value = object[key] as f64 as int
    return value >= 0 ? value : fallback
}

// Pi editor.ts clamps present numeric autocompleteMaxVisible values to [3, 20];
// missing or non-numeric values retain the inherited value.
fn autocomplete_clamp(int value): int {
    if value < 3 {
        return 3
    }
    if value > 20 {
        return 20
    }
    return value
}

fn autocomplete_value({string:any} object, string key, int fallback): int {
    if !object.contains(key) || !(object[key] is f64) {return fallback}
    return object[key] as f64 as int
}

// Pi setEditorPaddingX clamps to [0, 3].
fn padding_clamp(int value): int {
    if value < 0 {
        return 0
    }
    if value > 3 {
        return 3
    }
    return value
}
