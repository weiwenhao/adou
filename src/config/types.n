import adou.src.ai.types as ai_types
import adou.src.compaction.types as compaction_types

pub type cli_args_t = struct {
    int serve_port = 0
    string provider
    string model
    string base_url
    string api_key
    string thinking = 'off'
    string session_path
    string session_id
    string session_dir
    string fork_path
    string session_name
    string system_prompt
    [string] append_system_prompts = []
    int context_window
    int max_tokens
    int timeout_ms
    int max_retries = -1
    int reserve_tokens
    int keep_recent_tokens
    bool continue_recent
    bool resume
    bool print_mode
    string mode = 'text'
    bool mode_explicit
    string export_path
    bool list_models
    string list_models_pattern
    bool verbose
    bool debug
    bool offline
    bool trust_override
    bool trust_override_explicit
    bool retry_enabled = true
    int retry_max_attempts = 3
    int retry_base_delay_ms = 2000
    bool no_context_files
    bool no_tools
    bool no_builtin_tools
    [string] scoped_models = []
    // B1-R3-05: whether --models was given on the CLI; propagated through
    // resolve into config_t.scoped_models_explicit.
    bool scoped_models_explicit
    [string] tool_names = []
    [string] exclude_tool_names = []
    bool no_session
    bool no_compaction
    bool help
    bool version
    bool thinking_explicit
    [string] skill_paths = []
    bool no_skills
    [string] messages = []
    [string] file_args = []
    [string] errors = []
}

pub type config_t = struct {
    int serve_port = 0
    string cwd
    string provider
    ref<ai_types.model_t> model
    ref<ai_types.stream_options_t> stream_options
    compaction_types.settings_t compaction
    string thinking
    string session_path
    string session_id
    string session_dir
    string fork_path
    string session_name
    string system_prompt
    [string] append_system_prompts = []
    bool continue_recent
    bool resume
    bool print_mode
    string mode = 'text'
    string export_path
    bool list_models
    string list_models_pattern
    bool verbose
    bool debug
    bool offline
    bool trust_override
    bool trust_override_explicit
    bool project_trusted
    bool retry_enabled = true
    int retry_max_attempts = 3
    int retry_base_delay_ms = 2000
    bool no_context_files
    bool no_tools
    bool no_builtin_tools
    [string] scoped_models = []
    // B1-R3-05: whether --models was given on the CLI.  An explicit scope
    // persists across session rebinds; without it the view refreshes the
    // model scope/selector backing from the trust-aware settings snapshot.
    bool scoped_models_explicit
    [string] tool_names = []
    [string] exclude_tool_names = []
    bool no_session
    bool provider_explicit
    bool model_explicit
    bool api_key_explicit
    bool thinking_explicit
    string steering_mode = 'one-at-a-time'
    string follow_up_mode = 'one-at-a-time'
    bool hide_thinking
    [string] skill_paths = []
    bool no_skills
    [string] initial_messages = []
    [ref<ai_types.image_attachment_t>] initial_images = []
    // Pi settings keys that flow from the trust-aware settings snapshot into
    // the runtime config (Batch 3).
    string default_project_trust = 'ask'
    bool enable_skill_commands = true
    bool quiet_startup
    bool auto_resize_images = true
    string transport = 'auto'
    int http_idle_timeout_ms = 300000
}

// Skills options shared by every runtime entry that rebuilds project-bound
// resources (session context, spawned serve instances, RPC get_commands).
// Explicit --skill paths always load; no_skills only gates default discovery;
// project_trusted gates project-scope discovery (.pi/skills, .agents/skills).
// The trust override fields are carried so the decision can be re-resolved
// per project cwd (a spawn or session rebind may leave the launch cwd).
pub type skills_options_t = struct {
    [string] skill_paths = []
    bool no_skills
    bool project_trusted
    bool trust_override
    bool trust_override_explicit
    string default_project_trust = 'ask'
}
