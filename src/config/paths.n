import path
import syscall

// Pi keeps all user-level agent state below ~/.pi/agent.  Keep path
// resolution in one module so auth, settings, trust, sessions, and global
// context files cannot silently drift apart.

fn agent_dir(): string {
    string configured = syscall.get_env('PI_CODING_AGENT_DIR')
    if configured == '' {
        // Compatibility alias for early Adou snapshots.  Pi's name remains
        // the canonical environment variable for new installations.
        configured = syscall.get_env('ADOU_CODING_AGENT_DIR')
    }
    if configured != '' {
        return expand_home(configured)
    }
    string home = syscall.get_env('HOME')
    if home == '' {home = '/'}
    return path.join(home, '.pi/agent')
}

fn sessions_dir(): string {
    string configured = syscall.get_env('PI_CODING_AGENT_SESSION_DIR')
    if configured == '' {
        configured = syscall.get_env('ADOU_SESSION_DIR')
    }
    if configured != '' {
        return expand_home(configured)
    }
    return path.join(agent_dir(), 'sessions')
}

fn auth_path(): string {return path.join(agent_dir(), 'auth.json')}
fn settings_path(): string {return path.join(agent_dir(), 'settings.json')}
fn trust_path(): string {return path.join(agent_dir(), 'trust.json')}
fn project_settings_path(string cwd): string {return path.join(cwd, '.pi/settings.json')}

#local
fn expand_home(string value): string {
    if value == '~' {
        string home = syscall.get_env('HOME')
        return home == '' ? '/' : home
    }
    if value.starts_with('~/') {
        string home = syscall.get_env('HOME')
        return path.join(home == '' ? '/' : home, value.slice(2, value.len()))
    }
    return value
}
