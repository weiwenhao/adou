import adou.src.ai.event_stream
import adou.src.ai.sse
import adou.src.ai.streaming_json
import adou.src.ai.types as ai_types
import adou.src.json_util
import adou.src.ai.types
import http.client
import json
import time

pub type options_t = struct {
    string proxy_url
    string auth_token
    int timeout_ms = 120000
}

pub fn stream_proxy(ref<ai_types.model_t> model, ref<ai_types.context_t> context, ref<ai_types.stream_options_t> stream_options, options_t options): ref<event_stream.assistant_stream_t> {
    var stream = event_stream.new()
    go run_proxy(stream, model, context, stream_options, options)
    return stream
}

fn run_proxy(ref<event_stream.assistant_stream_t> stream, ref<ai_types.model_t> model, ref<ai_types.context_t> context, ref<ai_types.stream_options_t> stream_options, options_t options): void {
    ref<ai_types.assistant_message_t> partial = new ai_types.assistant_message_t(api = model.api, provider = model.provider, model = model.id, timestamp = time.now().ms_timestamp())
    run_proxy_inner(stream, partial, model, context, stream_options, options) catch error {
        partial.stop_reason = ai_types.STOP_ABORTED
        partial.error_message = error.msg()
        var reason = error.msg().contains('aborted') ? ai_types.STOP_ABORTED : ai_types.STOP_ERROR
        partial.stop_reason = reason
        stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_ERROR, reason: reason, error: partial,}) catch ignored {}
        stream.end() catch ignored {}
    }
}

fn run_proxy_inner(ref<event_stream.assistant_stream_t> stream, ref<ai_types.assistant_message_t> partial, ref<ai_types.model_t> model, ref<ai_types.context_t> context, ref<ai_types.stream_options_t> stream_options, options_t options): void! {
    var response = send_proxy(model, context, stream_options, options)
    if response.status < 200 || response.status >= 300 {
        string body = response.text() catch error {''}
        response.close()
        throw errorf('Proxy error: HTTP %d %s', response.status, body)
    }
    stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_START, partial: partial,})
    var parser = sse.parser()
    [u8] buffer = vec<u8>.new(0, 8192)
    for true {
        int count = response.read(buffer) catch error {break}
        if count <= 0 {break}
        var frames = parser.feed(buffer.slice(0, count))
        for frame in frames {
            apply_proxy_event(stream, partial, frame.data)
        }
    }
    var pending = parser.finish_pending()
    for frame in pending {
        apply_proxy_event(stream, partial, frame.data)
    }
    response.close()
    if partial.stop_reason == ai_types.STOP_PENDING {
        partial.stop_reason = ai_types.STOP_STOP
        stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_DONE, reason: partial.stop_reason, message: partial,})
    }
    stream.end()
}

fn send_proxy(ref<ai_types.model_t> model, ref<ai_types.context_t> context, ref<ai_types.stream_options_t> stream_options, options_t options): ref<client.response_t>! {
    {string:any} body = {}
    body['model'] = model
    body['context'] = context
    body['options'] = stream_options
    var request = client.new().post(options.proxy_url + '/api/stream').timeout(options.timeout_ms).header('Authorization', 'Bearer ' + options.auth_token).header('Content-Type', 'application/json').header('Accept', 'text/event-stream')
    request.content(json.serialize(body))
    return request.send()
}

fn apply_proxy_event(ref<event_stream.assistant_stream_t> stream, ref<ai_types.assistant_message_t> partial, string data): void! {
    var parsed = json_util.parse(data) catch error {return}
    if !json_util.is_obj(parsed) {return}
    var object = parsed as {string:any}
    if object.contains('usage') && json_util.is_obj(object['usage']) {
        partial.usage = proxy_usage(object['usage'] as {string:any})
    }
    string kind = json_util.opt_string(object, 'type')
    int index = object.contains('contentIndex') ? json_util.opt_int(object, 'contentIndex') : -1
    match kind {
        'start' -> {
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_START, partial: partial,})
        }
        'text_start' -> {
            ensure_content(partial, index, new ai_types.text_content_t(text = ''))
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_TEXT_START, content_index: index, partial: partial,})
        }
        'text_delta' -> {
            string delta = json_util.opt_string(object, 'delta')
            var content = partial.content[index] as ref<ai_types.text_content_t>
            content.text += delta
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_TEXT_DELTA, content_index: index, delta: delta, partial: partial,})
        }
        'text_end' -> {
            if object.contains('contentSignature') { (partial.content[index] as ref<ai_types.text_content_t>).text_signature = json_util.opt_string(object, 'contentSignature') }
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_TEXT_END, content_index: index, content: (partial.content[index] as ref<ai_types.text_content_t>).text, partial: partial,})
        }
        'thinking_start' -> {
            ensure_content(partial, index, new ai_types.thinking_content_t(thinking = ''))
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_THINKING_START, content_index: index, partial: partial,})
        }
        'thinking_delta' -> {
            string delta = json_util.opt_string(object, 'delta')
            var content = partial.content[index] as ref<ai_types.thinking_content_t>
            content.thinking += delta
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_THINKING_DELTA, content_index: index, delta: delta, partial: partial,})
        }
        'thinking_end' -> {
            if object.contains('contentSignature') { (partial.content[index] as ref<ai_types.thinking_content_t>).thinking_signature = json_util.opt_string(object, 'contentSignature') }
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_THINKING_END, content_index: index, content: (partial.content[index] as ref<ai_types.thinking_content_t>).thinking, partial: partial,})
        }
        'toolcall_start' -> {
            var call = new ai_types.tool_call_t(id = json_util.opt_string(object, 'id'), name = json_util.opt_string(object, 'toolName'), arguments = {}, partial_json = '')
            ensure_content(partial, index, call)
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_TOOLCALL_START, content_index: index, tool_call: call, partial: partial,})
        }
        'toolcall_delta' -> {
            string delta = json_util.opt_string(object, 'delta')
            var call = partial.content[index] as ref<ai_types.tool_call_t>
            call.partial_json += delta
            call.arguments = streaming_json.parse(call.partial_json)
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_TOOLCALL_DELTA, content_index: index, delta: delta, partial: partial,})
        }
        'toolcall_end' -> {
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_TOOLCALL_END, content_index: index, partial: partial,})
        }
        'done' -> {
            partial.stop_reason = json_util.opt_string(object, 'reason')
            if partial.stop_reason == '' {partial.stop_reason = ai_types.STOP_STOP}
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_DONE, reason: partial.stop_reason, message: partial,})
        }
        'error' -> {
            partial.stop_reason = ai_types.STOP_ERROR
            partial.error_message = json_util.opt_string(object, 'errorMessage')
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_ERROR, reason: ai_types.STOP_ERROR, error: partial,})
        }
        _ -> {}
    }
}

fn proxy_usage({string:any} object): ai_types.usage_t {
    return ai_types.usage_t {
        input: json_util.opt_int(object, 'input'),
        output: json_util.opt_int(object, 'output'),
        cache_read: opt_int_or(object, 'cacheRead', 'cache_read'),
        cache_write: opt_int_or(object, 'cacheWrite', 'cache_write'),
        cache_write_1h: opt_int_or(object, 'cacheWrite1h', 'cache_write_1h'),
        reasoning: json_util.opt_int(object, 'reasoning'),
        total_tokens: opt_int_or(object, 'totalTokens', 'total_tokens'),
    }
}

fn opt_int_or({string:any} object, string primary, string alternate): int {
    if object.contains(primary) {return json_util.opt_int(object, primary)}
    return json_util.opt_int(object, alternate)
}

fn ensure_content(ref<ai_types.assistant_message_t> partial, int index, ai_types.content_t content) {
    for true {
        if partial.content.len() > index {break}
        partial.content.push(content)
    }
    partial.content[index] = content
}
