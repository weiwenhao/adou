import adou.src.ai.types as ai_types
import adou.src.session.identity
import adou.src.session.repository
import adou.src.session.types as session_types
import adou.src.storage.sqlite as sqlite
import adou.src.storage.sqlite_repo
import adou.src.tools.command
import adou.src.tools.path_utils
import json
import os
import path
import syscall

// Phase 7 repository backend contract: the minimal shared boundary for the
// two SessionRepo backends (Pi SessionRepo: create/open/list/delete/fork).
// JSONL remains the default backend; memory backends share the same
// manager_t surface.  This module concentrates the file-level list/delete
// helpers used by the contract tests; existing TUI call sites are not
// switched over in this batch (documented in docs/phase7-storage-design.md).

pub type backend_t = struct {
    string kind = 'jsonl'
    ref<repository.manager_t>? manager = null
    string session_dir = ''
    ref<sqlite_repo.db_t>? sqlite_db = null
}

pub fn mgr(backend_t b): ref<repository.manager_t> {
    return b.manager as ref<repository.manager_t>
}

// SessionRepo.create: persisted (JSONL) backend in a dedicated directory.
pub fn create_jsonl(string cwd, string session_dir): backend_t! {
    var manager = repository.create(cwd, session_dir)
    return backend_t {kind: 'jsonl', manager: manager, session_dir: session_dir, sqlite_db: null,}
}

// SessionRepo.create: in-memory backend (no file writes).
pub fn open_memory(string cwd): backend_t! {
    var manager = repository.in_memory(cwd)
    return backend_t {kind: 'memory', manager: manager, session_dir: '', sqlite_db: null,}
}

// SessionRepo.open: reopen an existing session from a SQLite database.
pub fn open_sqlite_session(string cwd, string db_path, string session_id): backend_t! {
    var handle = sqlite_repo.open_db(db_path)
    var manager = sqlite_repo.load_manager(handle, session_id, cwd)
    manager.persisted = true
    manager.storage_backend = 'sqlite'
    manager.session_dir = path.dir(db_path)
    // B1.5: no JSONL file exists for a SQLite session; pointing session_file
    // at the database made the manager append JSONL bytes into it.
    manager.session_file = ''
    return backend_t {kind: 'sqlite', manager: manager, session_dir: path.dir(db_path), sqlite_db: handle,}
}

// SessionRepo.open: reopen an existing JSONL session file.
pub fn open_jsonl(string file_path): backend_t! {
    var manager = repository.open(file_path)
    return backend_t {kind: 'jsonl', manager: manager, session_dir: path.dir(file_path), sqlite_db: null,}
}

// SessionRepo.create: SQLite backend in a dedicated database file.
pub fn open_sqlite(string cwd, string db_path): backend_t! {
    var handle = sqlite_repo.open_db(db_path)
    // B1.5: create_without_jsonl leaves no stray header file in the default
    // session directory and keeps every byte out of the database file.
    var manager = repository.create_without_jsonl(cwd)
    manager.session_dir = path.dir(db_path)
    var backend_ref = backend_t {kind: 'sqlite', manager: manager, session_dir: path.dir(db_path), sqlite_db: handle,}
    persist_created(backend_ref, manager.header)
    return backend_ref
}

// A SQLite backend persists every append through the shared manager into
// the database (JSONL/memory backends only touch the manager).
pub fn append_message(backend_t b, ai_types.message_t message): string! {
    string entry_id = mgr(b).append_message(message)
    if b.kind == 'sqlite' {
        persist_entry(b, entry_id)
    }
    return entry_id
}

// SessionRepo.list: identifiers of the backend's sessions (JSONL file
// paths contain the session id; SQLite returns session ids).
pub fn list_sessions(backend_t b): [string]! {
    if b.kind == 'sqlite' {
        [string] result = []
        var rows = sqlite_repo.list_sessions(b.sqlite_db as ref<sqlite_repo.db_t>) catch error {
            throw error
        }
        for row in rows {
            result.push(row.id)
        }
        return result
    }
    return list_session_paths(b.session_dir)
}

// SessionRepo.list filtered to one project cwd (SQLite backend).
pub fn list_sessions_in_cwd(backend_t b, string cwd): [string]! {
    if b.kind == 'sqlite' {
        [string] result = []
        var rows = sqlite_repo.list_sessions_for_cwd(b.sqlite_db as ref<sqlite_repo.db_t>, cwd) catch error {
            throw error
        }
        for row in rows {
            result.push(row.id)
        }
        return result
    }
    return list_session_paths(b.session_dir)
}

// SessionRepo.delete: remove the session from its backend.
pub fn delete_session(backend_t b, string session_id): (bool, string) {
    if b.kind == 'sqlite' {
        sqlite_repo.delete_session(b.sqlite_db as ref<sqlite_repo.db_t>, session_id) catch error {
            return (false, error.msg())
        }
        return (true, 'Session deleted from sqlite')
    }
    return delete_session_file(mgr(b).session_file, mgr(b).cwd)
}

// Full fork within the backend: JSONL writes a new file, SQLite creates a
// new session row with a parent lineage and copies every entry.
pub fn fork_to(backend_t b, string requested_id): backend_t! {
    return fork_to_with_options(b, sqlite_fork_options_t {entry_id: '', position: 'at', requested_id: requested_id,})
}

// Pi SqliteSessionRepo.fork options: an optional entryId plus position
// 'before'|'at' select the copied prefix of the tree; an empty entryId
// copies everything.
pub type sqlite_fork_options_t = struct {
    string entry_id
    string position = 'at'
    string requested_id
}

pub fn fork_to_with_options(backend_t b, sqlite_fork_options_t options): backend_t! {
    if b.kind == 'sqlite' {
        string new_id = options.requested_id == '' ? identity.uuid_v7() : options.requested_id
        string timestamp = identity.iso_now()
        var handle = b.sqlite_db as ref<sqlite_repo.db_t>
        sqlite_repo.create_session(handle, new_id, timestamp, mgr(b).cwd, mgr(b).header.id)
        [ref<session_types.entry_t>] selected = select_fork_entries(mgr(b).entries, options.entry_id, options.position)
        sqlite.sqlite3_int64_t branch_seq = 0
        for entry in selected {
            sqlite_repo.append_entry(handle, new_id, entry.id, entry.parent_id, entry.kind, entry.timestamp, json.serialize(entry.raw))
            // Each copied entry joins the new session's main branch with an
            // entry_seq following the copy order (upstream branch-entries.ts).
            sqlite_repo.record_branch_entry(handle, new_id, 'main', entry.id, branch_seq)
            branch_seq += 1
        }
        var manager = sqlite_repo.load_manager(handle, new_id, mgr(b).cwd)
        manager.persisted = true
        manager.storage_backend = 'sqlite'
        manager.session_dir = b.session_dir
        manager.session_file = ''
        return backend_t {kind: 'sqlite', manager: manager, session_dir: b.session_dir, sqlite_db: handle,}
    }
    var forked = mgr(b).fork_to(mgr(b).cwd, b.session_dir, options.requested_id)
    return backend_t {kind: b.kind, manager: forked, session_dir: b.session_dir, sqlite_db: null,}
}

// Upstream getEntriesToFork: without an entry id the whole entry list is
// copied; with one, only the root-to-entry chain is copied, and position
// 'before' excludes the target itself.
fn select_fork_entries([ref<session_types.entry_t>] entries, string entry_id, string position): [ref<session_types.entry_t>] {
    if entry_id == '' {
        return entries
    }
    {string:string} parent_of = {}
    for entry in entries {
        parent_of[entry.id] = entry.parent_id
    }
    {string:bool} keep = {}
    string cursor = entry_id
    for true {
        keep[cursor] = true
        if !parent_of.contains(cursor) || parent_of[cursor] == '' {
            break
        }
        cursor = parent_of[cursor]
    }
    bool include_target = position != 'before'
    [ref<session_types.entry_t>] result = []
    for entry in entries {
        if !keep.contains(entry.id) {
            continue
        }
        if entry.id == entry_id && !include_target {
            continue
        }
        result.push(entry)
    }
    return result
}

fn persist_created(backend_t b, ref<session_types.header_t> header): void! {
    sqlite_repo.create_session(b.sqlite_db as ref<sqlite_repo.db_t>, header.id, header.timestamp, header.cwd, '')
    mgr(b).persisted = true
}

fn persist_entry(backend_t b, string entry_id): void! {
    var entry = mgr(b).get_entry(entry_id)
    if entry is ref<session_types.entry_t> entry_ref {
        sqlite_repo.append_entry(b.sqlite_db as ref<sqlite_repo.db_t>, mgr(b).header.id, entry_ref.id, entry_ref.parent_id, entry_ref.kind, entry_ref.timestamp, json.serialize(entry_ref.raw))
    }
}

// SessionRepo.list: session file paths in a directory, newest file first
// (same semantics as the resume picker's scan; concentrated here so both
// backends and future SQLite listing share one shape).  A missing/unreadable
// session directory throws so callers can surface the failure instead of
// silently treating it as an empty store.
pub fn list_session_paths(string session_dir): [string]! {
    if session_dir == '' {
        return []
    }
    var names = os.listdir(session_dir) catch error {
        throw error
    }
    [string] candidates = []
    for name in names {
        if !name.ends_with('.jsonl') {
            continue
        }
        candidates.push(path.join(session_dir, name))
    }
    return sort_by_mtime(candidates)
}

// File-level delete: move to trash when available, else unlink.
// Returns (deleted, message); message distinguishes the method used.
pub fn delete_session_file(string file_path, string cwd): (bool, string) {
    if file_path == '' {
        return (false, 'Session file does not exist')
    }
    if !path_utils.exists(file_path) {
        // Pi treats a file that is gone after the attempt as a successful
        // deletion, so a missing target is already deleted.
        return (true, 'Session file does not exist')
    }
    // B3-EXT-01: only a completed trash run that actually removed the file
    // counts as a trash success.  A spawn failure (or a trash tool that
    // exits 0 without moving the file) falls through to the unlink fallback
    // instead of reporting a deletion that never happened.
    var trashed = command.argv(cwd, '/bin/sh', ['trash', file_path]) catch error {
        command.result_t {exit_code: -1}
    }
    if trashed.exit_code == 0 && !path_utils.exists(file_path) {
        return (true, 'Session moved to trash')
    }
    os.remove(file_path) catch error {
        return (false, 'Could not delete session: ' + error.msg())
    }
    return (true, 'Session deleted')
}

fn sort_by_mtime([string] values): [string] {
    [string] remaining = values.slice(0, values.len())
    [string] result = vec<string>.cap_of(values.len())
    for remaining.len() > 0 {
        int newest = 0
        i64 newest_sec = 0
        i64 newest_nsec = 0
        for index, value in remaining {
            var stat = syscall.stat(value) catch error {continue}
            if index == 0 || stat.mtim.sec > newest_sec || (stat.mtim.sec == newest_sec && stat.mtim.nsec > newest_nsec) {
                newest = index
                newest_sec = stat.mtim.sec
                newest_nsec = stat.mtim.nsec
            }
        }
        result.push(remaining[newest])
        [string] next = vec<string>.cap_of(remaining.len() - 1)
        for index, value in remaining {
            if index != newest {
                next.push(value)
            }
        }
        remaining = next
    }
    return result
}
