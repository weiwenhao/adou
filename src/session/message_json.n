import adou.src.ai.types
import adou.src.json_util
import adou.src.ai.streaming_json


pub fn encode(types.message_t message): any! {
    if message is ref<types.user_message_t> user {
        return encode_user(user)
    }
    if message is ref<types.assistant_message_t> assistant {
        return encode_assistant(assistant)
    }
    if message is ref<types.tool_result_message_t> tool {
        return encode_tool_result(tool)
    }
    if message is ref<types.custom_message_t> custom {
        return encode_custom(custom)
    }
    if message is ref<types.bash_execution_message_t> bash {
        return encode_bash_execution(bash)
    }
    throw errorf('unsupported session message')
}

pub fn decode(any value): types.message_t! {
    var object = value as {string:any}
    string role = required_string(object, 'role')
    if role == 'user' {
        return decode_user(object)
    }
    if role == 'assistant' {
        return decode_assistant(object)
    }
    if role == 'toolResult' {
        return decode_tool_result(object)
    }
    if role == 'custom' {
        return decode_custom(object)
    }
    if role == 'bashExecution' {
        return decode_bash_execution(object)
    }
    throw errorf('unsupported session message role: %s', role)
}

pub fn encode_usage(types.usage_t usage): any! {
    {string:any} cost = {}
    cost['input'] = usage.cost.input
    cost['output'] = usage.cost.output
    cost['cacheRead'] = usage.cost.cache_read
    cost['cacheWrite'] = usage.cost.cache_write
    cost['total'] = usage.cost.total
    {string:any} object = {}
    object['input'] = usage.input
    object['output'] = usage.output
    object['cacheRead'] = usage.cache_read
    object['cacheWrite'] = usage.cache_write
    if usage.cache_write_1h != 0 {
        object['cacheWrite1h'] = usage.cache_write_1h
    }
    if usage.reasoning != 0 {
        object['reasoning'] = usage.reasoning
    }
    object['totalTokens'] = usage.total_tokens
    object['cost'] = cost
    return object
}

pub fn decode_usage(any value): types.usage_t! {
    var object = value as {string:any}
    types.usage_t usage = types.usage_t{}
    usage.input = json_util.opt_int(object, 'input')
    usage.output = json_util.opt_int(object, 'output')
    usage.cache_read = json_util.opt_int(object, 'cacheRead')
    usage.cache_write = json_util.opt_int(object, 'cacheWrite')
    usage.cache_write_1h = json_util.opt_int(object, 'cacheWrite1h')
    usage.reasoning = json_util.opt_int(object, 'reasoning')
    usage.total_tokens = json_util.opt_int(object, 'totalTokens')
    if object.contains('cost') && object['cost'] is {string:any} {
        var cost = object['cost'] as {string:any}
        usage.cost.input = json_util.opt_float(cost, 'input')
        usage.cost.output = json_util.opt_float(cost, 'output')
        usage.cost.cache_read = json_util.opt_float(cost, 'cacheRead')
        usage.cost.cache_write = json_util.opt_float(cost, 'cacheWrite')
        usage.cost.total = json_util.opt_float(cost, 'total')
    }
    return usage
}

pub fn encode_content([types.content_t] content): any! {
    [any] result = []
    for block in content {
        {string:any} item = {}
        if block is ref<types.text_content_t> text {
            item['type'] = 'text'
            item['text'] = text.text
            if text.text_signature != '' {
                item['textSignature'] = text.text_signature
            }
        } else if block is ref<types.thinking_content_t> thinking {
            item['type'] = 'thinking'
            item['thinking'] = thinking.thinking
            if thinking.thinking_signature != '' {
                item['thinkingSignature'] = thinking.thinking_signature
            }
            if thinking.redacted {
                item['redacted'] = true
            }
        } else if block is ref<types.tool_call_t> call {
            item['type'] = 'toolCall'
            item['id'] = call.id
            item['name'] = call.name
            if call.arguments_json != '' {
                item['arguments'] = streaming_json.parse(call.arguments_json)
            } else {
                item['arguments'] = call.arguments
            }
        }
        result.push(item)
    }
    return result
}

pub fn decode_content(any value): [types.content_t]! {
    [types.content_t] result = []
    for item_value in value as [any] {
        var item = item_value as {string:any}
        string kind = required_string(item, 'type')
        if kind == 'text' {
            types.content_t block = new types.text_content_t(text = json_util.opt_string(item, 'text'), text_signature = json_util.opt_string(item, 'textSignature'))
            result.push(block)
        } else if kind == 'thinking' {
            types.content_t block = new types.thinking_content_t(thinking = json_util.opt_string(item, 'thinking'), thinking_signature = json_util.opt_string(item, 'thinkingSignature'), redacted = json_util.opt_bool(item, 'redacted'))
            result.push(block)
        } else if kind == 'toolCall' {
            any arguments = {}
            if item.contains('arguments') {
                arguments = json_util.clone(item['arguments'])
            }
            types.content_t block = new types.tool_call_t(id = required_string(item, 'id'), name = required_string(item, 'name'), arguments = arguments, arguments_json = json_util.stringify(arguments))
            result.push(block)
        }
    }
    return result
}

pub fn encode_text_blocks([ref<types.text_content_t>] content): any! {
    [any] result = []
    for text in content {
        {string:any} item = {}
        item['type'] = 'text'
        item['text'] = text.text
        if text.text_signature != '' {
            item['textSignature'] = text.text_signature
        }
        result.push(item)
    }
    return result
}

pub fn decode_text_blocks(any value): [ref<types.text_content_t>]! {
    [ref<types.text_content_t>] result = []
    for item_value in value as [any] {
        var item = item_value as {string:any}
        if json_util.opt_string(item, 'type') == 'text' {
            result.push(new types.text_content_t(text = json_util.opt_string(item, 'text'), text_signature = json_util.opt_string(item, 'textSignature')))
        }
    }
    return result
}

fn encode_user(ref<types.user_message_t> message): any! {
    {string:any} object = {}
    object['role'] = 'user'
    if message.images.len() == 0 {
        object['content'] = message.content
    } else {
        [any] content = []
        if message.content != '' {
            {string:any} text = {}
            text['type'] = 'text'
            text['text'] = message.content
            content.push(text)
        }
        for image in message.images {
            {string:any} item = {}
            item['type'] = 'image'
            item['mimeType'] = image.mime_type
            item['data'] = image.data
            content.push(item)
        }
        object['content'] = content
    }
    object['timestamp'] = message.timestamp
    return object
}

fn encode_assistant(ref<types.assistant_message_t> message): any! {
    {string:any} object = {}
    object['role'] = 'assistant'
    object['content'] = encode_content(message.content)
    object['api'] = message.api
    object['provider'] = message.provider
    object['model'] = message.model
    if message.response_id != '' {
        object['responseId'] = message.response_id
    }
    if message.response_model != '' {
        object['responseModel'] = message.response_model
    }
    object['usage'] = encode_usage(message.usage)
    object['stopReason'] = message.stop_reason
    if message.error_message != '' {
        object['errorMessage'] = message.error_message
    }
    object['timestamp'] = message.timestamp
    return object
}

pub fn encode_tool_result(ref<types.tool_result_message_t> message): any! {
    {string:any} object = {}
    object['role'] = 'toolResult'
    object['toolCallId'] = message.tool_call_id
    object['toolName'] = message.tool_name
    // Pi stores tool-result images as ImageContent items inside content.
    [any] content_items = encode_text_blocks(message.content) as [any]
    for image in message.images {
        {string:any} item = {}
        item['type'] = 'image'
        item['mimeType'] = image.mime_type
        item['data'] = image.data
        content_items.push(item)
    }
    object['content'] = content_items
    if !json_util.is_null(message.details) {
        object['details'] = message.details
    }
    if has_usage(message.usage) {
        object['usage'] = encode_usage(message.usage)
    }
    if message.added_tool_names.len() > 0 {
        [any] names = []
        for name in message.added_tool_names {
            names.push(name)
        }
        object['addedToolNames'] = names
    }
    object['isError'] = message.is_error
    object['timestamp'] = message.timestamp
    return object
}

fn encode_bash_execution(ref<types.bash_execution_message_t> message): any! {
    {string:any} object = {}
    object['role'] = 'bashExecution'
    object['command'] = message.command
    object['output'] = message.output
    if message.exit_code >= 0 {
        object['exitCode'] = message.exit_code
    }
    object['cancelled'] = message.cancelled
    object['truncated'] = message.truncated
    if message.full_output_path != '' {
        object['fullOutputPath'] = message.full_output_path
    }
    if message.exclude_from_context {
        object['excludeFromContext'] = true
    }
    object['timestamp'] = message.timestamp
    return object
}

fn encode_custom(ref<types.custom_message_t> message): any! {
    {string:any} object = {}
    object['role'] = 'custom'
    object['customType'] = message.custom_type
    object['content'] = message.content
    object['display'] = message.display
    if !json_util.is_null(message.details) {
        object['details'] = message.details
    }
    object['timestamp'] = message.timestamp
    return object
}

fn decode_user({string:any} object): types.message_t! {
    string content = ''
    [ref<types.image_attachment_t>] images = []
    if object.contains('content') {
        var raw = object['content']
        if raw is string {
            content = raw as string
        } else if raw is [any] {
            [string] texts = []
            for item in raw as [any] {
                if item is {string:any} {
                    var block = item as {string:any}
                    if json_util.opt_string(block, 'type') == 'text' {
                        texts.push(json_util.opt_string(block, 'text'))
                    } else if json_util.opt_string(block, 'type') == 'image' {
                        string mime = json_util.opt_string(block, 'mimeType')
                        string data = json_util.opt_string(block, 'data')
                        if mime != '' && data != '' {
                            images.push(new types.image_attachment_t(mime_type = mime, data = data))
                        }
                    }
                }
            }
            content = join_lines(texts)
        }
    }
    types.message_t result = new types.user_message_t(content = content, images = images, timestamp = json_util.opt_int(object, 'timestamp'))
    return result
}

fn decode_assistant({string:any} object): types.message_t! {
    [types.content_t] content = []
    if object.contains('content') && object['content'] is [any] {
        content = decode_content(object['content'])
    }
    types.usage_t usage = types.usage_t{}
    if object.contains('usage') && object['usage'] is {string:any} {
        usage = decode_usage(object['usage'])
    }
    types.message_t result = new types.assistant_message_t(content = content, api = json_util.opt_string(object, 'api'), provider = json_util.opt_string(object, 'provider'), model = json_util.opt_string(object, 'model'), response_id = json_util.opt_string(object, 'responseId'), response_model = json_util.opt_string(object, 'responseModel'), usage = usage, stop_reason = optional_string_default(object, 'stopReason', types.STOP_STOP), error_message = json_util.opt_string(object, 'errorMessage'), timestamp = json_util.opt_int(object, 'timestamp'))
    return result
}

fn decode_tool_result({string:any} object): types.message_t! {
    [ref<types.text_content_t>] content = []
    [ref<types.image_attachment_t>] images = []
    if object.contains('content') && object['content'] is [any] {
        for item_value in object['content'] as [any] {
            if !(item_value is {string:any}) {
                continue
            }
            var block = item_value as {string:any}
            string kind = json_util.opt_string(block, 'type')
            if kind == 'text' {
                content.push(new types.text_content_t(text = json_util.opt_string(block, 'text')))
            } else if kind == 'image' {
                string mime = json_util.opt_string(block, 'mimeType')
                string data = json_util.opt_string(block, 'data')
                if mime != '' && data != '' {
                    images.push(new types.image_attachment_t(mime_type = mime, data = data))
                }
            }
        }
    }
    // Older Adou files kept a separate top-level images key; still read it.
    if object.contains('images') && object['images'] is [any] {
        for raw_image in object['images'] as [any] {
            if raw_image is {string:any} image {
                string mime = json_util.opt_string(image, 'mimeType')
                string data = json_util.opt_string(image, 'data')
                if mime != '' && data != '' {
                    images.push(new types.image_attachment_t(mime_type = mime, data = data))
                }
            }
        }
    }
    any details = null
    if object.contains('details') {
        details = json_util.clone(object['details'])
    }
    types.usage_t usage = types.usage_t{}
    if object.contains('usage') && object['usage'] is {string:any} {
        usage = decode_usage(object['usage'])
    }
    [string] added = []
    if object.contains('addedToolNames') && object['addedToolNames'] is [any] {
        for name in object['addedToolNames'] as [any] {
            if name is string {
                added.push(name as string)
            }
        }
    }
    types.message_t result = new types.tool_result_message_t(tool_call_id = json_util.opt_string(object, 'toolCallId'), tool_name = json_util.opt_string(object, 'toolName'), content = content, images = images, details = details, usage = usage, added_tool_names = added, is_error = json_util.opt_bool(object, 'isError'), timestamp = json_util.opt_int(object, 'timestamp'))
    return result
}

fn decode_bash_execution({string:any} object): types.message_t! {
    types.message_t result = new types.bash_execution_message_t(command = json_util.opt_string(object, 'command'), output = json_util.opt_string(object, 'output'), exit_code = object.contains('exitCode') ? json_util.opt_int(object, 'exitCode') : -1, cancelled = json_util.opt_bool(object, 'cancelled'), truncated = json_util.opt_bool(object, 'truncated'), full_output_path = json_util.opt_string(object, 'fullOutputPath'), exclude_from_context = json_util.opt_bool(object, 'excludeFromContext'), timestamp = json_util.opt_int(object, 'timestamp'))
    return result
}

fn decode_custom({string:any} object): types.message_t! {
    string content = ''
    if object.contains('content') {
        if object['content'] is string {
            content = object['content'] as string
        } else if object['content'] is [any] {
            [string] texts = []
            for value in object['content'] as [any] {
                if value is {string:any} {
                    var block = value as {string:any}
                    if json_util.opt_string(block, 'type') == 'text' {
                        texts.push(json_util.opt_string(block, 'text'))
                    }
                }
            }
            content = join_lines(texts)
        }
    }
    any details = null
    if object.contains('details') {
        details = json_util.clone(object['details'])
    }
    types.message_t result = new types.custom_message_t(custom_type = json_util.opt_string(object, 'customType'), content = content, display = json_util.opt_bool(object, 'display'), details = details, timestamp = json_util.opt_int(object, 'timestamp'))
    return result
}

pub fn has_usage(types.usage_t usage): bool {
    return usage.input != 0 || usage.output != 0 || usage.cache_read != 0 || usage.cache_write != 0 || usage.total_tokens != 0 || usage.cost.total != 0.0
}

pub fn required_string({string:any} object, string key): string! {
    return json_util.required_string(object, key)
}

fn optional_string_default({string:any} object, string key, string fallback): string {
    string value = json_util.opt_string(object, key)
    if value == '' {
        return fallback
    }
    return value
}

fn join_lines([string] values): string {
    string result = ''
    for index, value in values {
        if index > 0 {
            result += '\n'
        }
        result += value
    }
    return result
}
