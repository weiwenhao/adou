import adou.src.ai.types as ai_types
import json

const CURRENT_VERSION = 3
const ENTRY_MESSAGE = 'message'
const ENTRY_COMPACTION = 'compaction'
const ENTRY_BRANCH_SUMMARY = 'branch_summary'
const ENTRY_MODEL_CHANGE = 'model_change'
const ENTRY_THINKING_CHANGE = 'thinking_level_change'
const ENTRY_SESSION_INFO = 'session_info'
const ENTRY_LABEL = 'label'
const COMPACTION_SUMMARY_PREFIX = 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n'
const COMPACTION_SUMMARY_SUFFIX = '\n</summary>'
const BRANCH_SUMMARY_PREFIX = 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n'
const BRANCH_SUMMARY_SUFFIX = '</summary>'

type header_t = struct {
    int version
    string id
    string timestamp
    string cwd
    string parent_session
    json.value_t raw
}

type entry_t = struct {
    string kind
    string id
    bool has_parent
    string parent_id
    string timestamp
    json.value_t raw
}

type context_t = struct {
    [ai_types.message_t] messages = []
    string thinking_level = 'off'
    bool has_thinking_level
    bool has_model
    string provider
    string model_id
}

type load_result_t = struct {
    ref<header_t> header
    [ref<entry_t>] entries = []
    bool recovered_tail
    int malformed_lines
    bool needs_separator
    bool migrated
    [string] warnings = []
}
