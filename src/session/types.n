import adou.src.ai.types as ai_types

pub const CURRENT_VERSION = 3
pub const ENTRY_MESSAGE = 'message'
pub const ENTRY_COMPACTION = 'compaction'
pub const ENTRY_BRANCH_SUMMARY = 'branch_summary'
pub const ENTRY_MODEL_CHANGE = 'model_change'
pub const ENTRY_THINKING_CHANGE = 'thinking_level_change'
pub const ENTRY_ACTIVE_TOOLS_CHANGE = 'active_tools_change'
pub const ENTRY_CUSTOM = 'custom'
pub const ENTRY_CUSTOM_MESSAGE = 'custom_message'
pub const ENTRY_SESSION_INFO = 'session_info'
pub const ENTRY_LABEL = 'label'
pub const ENTRY_LEAF = 'leaf'
pub const COMPACTION_SUMMARY_PREFIX = 'The conversation history before this point was compacted into the following summary:\n\n<summary>\n'
pub const COMPACTION_SUMMARY_SUFFIX = '\n</summary>'
pub const BRANCH_SUMMARY_PREFIX = 'The following is a summary of a branch that this conversation came back from:\n\n<summary>\n'
pub const BRANCH_SUMMARY_SUFFIX = '</summary>'

pub type header_t = struct {
    int version
    string id
    string timestamp
    string cwd
    string parent_session
    any raw
}

pub type entry_t = struct {
    string kind
    string id
    bool has_parent
    string parent_id
    string timestamp
    any raw
}

pub type context_t = struct {
    [ai_types.message_t] messages = []
    string thinking_level = 'off'
    bool has_thinking_level
    bool has_model
    string provider
    string model_id
    // Pi SessionContext.activeToolNames: the active tool set recorded by the
    // last active_tools_change entry.
    [string] active_tool_names = []
}

pub type load_result_t = struct {
    ref<header_t> header
    [ref<entry_t>] entries = []
    bool recovered_tail
    int malformed_lines
    bool needs_separator
    bool migrated
    [string] warnings = []
}
