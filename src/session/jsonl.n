import adou.src.json_util
import adou.src.session.types
import adou.src.session.identity
import fs
import fmt
import json
import syscall


pub fn load(string file_path): ref<types.load_result_t>! {
    var file = fs.open(file_path, syscall.O_RDONLY, 0)
    string content = file.content()
    file.close()
    bool needs_separator = content.len() > 0 && content[content.len() - 1] != '\n'.char()
    var lines = content.split('\n')
    ref<types.header_t>? header = null
    [any] entry_values = []
    bool recovered_tail = false
    int malformed_lines = 0
    [string] warnings = []
    for index, raw_line in lines {
        string line = raw_line.trim([' ', '\t', '\r'])
        if line == '' {
            continue
        }
        any parsed = null
        parsed = json_util.parse(line) catch error {
            malformed_lines += 1
            bool is_tail = index == lines.len() - 1 && needs_separator
            if is_tail {
                recovered_tail = true
                warnings.push(fmt.sprintf('Recovered incomplete trailing session record at line %d', index + 1))
            } else {
                warnings.push(fmt.sprintf('Skipped malformed session record at line %d: %s', index + 1, error.msg()))
            }
            {string:any} empty = {}
            parsed = empty
        }
        var value = parsed
        if !json_util.is_obj(value) {
            continue
        }
        var object = value as {string:any}
        if !object.contains('type') || !(object['type'] is string) {
            malformed_lines += 1
            warnings.push(fmt.sprintf('Skipped session record without type at line %d', index + 1))
            continue
        }
        string kind = object['type'] as string
        if kind == 'session' {
            if header is ref<types.header_t> {
                throw errorf('session file contains multiple headers')
            }
            header = parse_header(value)
            continue
        }
        entry_values.push(value)
    }
    if header is null {
        throw errorf('session file has no valid header')
    }
    var parsed_header = header as ref<types.header_t>
    int original_version = parsed_header.version
    bool migrated = parsed_header.version < types.CURRENT_VERSION
    if parsed_header.version < 2 {
        migrate_v1_to_v2(entry_values)
    }
    if parsed_header.version < 3 {
        migrate_v2_to_v3(entry_values)
    }
    if migrated {
        parsed_header.version = types.CURRENT_VERSION
        warnings.push(fmt.sprintf('Migrated session from v%d to v%d', original_version, types.CURRENT_VERSION))
    }
    [ref<types.entry_t>] entries = []
    for value in entry_values {
        entries.push(parse_entry(value))
    }
    var result = new types.load_result_t(header = parsed_header, entries = entries, recovered_tail = recovered_tail, malformed_lines = malformed_lines, needs_separator = needs_separator, migrated = migrated, warnings = warnings)
    return result
}

pub fn encode_header(ref<types.header_t> header): string! {
    {string:any} object = {}
    object['type'] = 'session'
    object['version'] = header.version
    object['id'] = header.id
    object['timestamp'] = header.timestamp
    object['cwd'] = header.cwd
    if header.parent_session != '' {
        object['parentSession'] = header.parent_session
    }
    return json.serialize(object)
}

pub fn parse_header(any value): ref<types.header_t>! {
    var object = value as {string:any}
    int version = optional_int(object, 'version', 1)
    if version < 1 || version > types.CURRENT_VERSION {
        throw errorf('unsupported session version %d; newest supported version is %d', version, types.CURRENT_VERSION)
    }
    return new types.header_t(version = version, id = required_string(object, 'id'), timestamp = required_string(object, 'timestamp'), cwd = required_string(object, 'cwd'), parent_session = optional_string(object, 'parentSession'), raw = value)
}

fn migrate_v1_to_v2([any] entries): void! {
    string previous_id = ''
    {string:bool} used = {}
    for index, value in entries {
        var object = value as {string:any}
        string id = identity.short_id()
        for used.contains(id) {
            id = identity.short_id()
        }
        used[id] = true
        object['id'] = id
        if previous_id == '' {
            object['parentId'] = null
        } else {
            object['parentId'] = previous_id
        }
        entries[index] = object
        previous_id = id
    }
    for index, value in entries {
        var object = value as {string:any}
        if optional_string(object, 'type') != types.ENTRY_COMPACTION || !object.contains('firstKeptEntryIndex') {
            continue
        }
        int file_index = optional_int(object, 'firstKeptEntryIndex', -1)
        int entry_index = file_index - 1
        if entry_index < 0 || entry_index >= entries.len() {
            throw errorf('v1 compaction entry at index %d has invalid firstKeptEntryIndex %d', index, file_index)
        }
        var target = entries[entry_index] as {string:any}
        object['firstKeptEntryId'] = required_string(target, 'id')
        object.del('firstKeptEntryIndex')
        entries[index] = object
    }
}

fn migrate_v2_to_v3([any] entries): void! {
    for index, value in entries {
        var object = value as {string:any}
        if optional_string(object, 'type') != types.ENTRY_MESSAGE || !object.contains('message') || !(object['message'] is {string:any}) {
            continue
        }
        var message = object['message'] as {string:any}
        if optional_string(message, 'role') == 'hookMessage' {
            message['role'] = 'custom'
            object['message'] = message
            entries[index] = object
        }
    }
}

pub fn parse_entry(any value): ref<types.entry_t>! {
    var object = value as {string:any}
    string kind = required_string(object, 'type')
    string id = required_string(object, 'id')
    string timestamp = required_string(object, 'timestamp')
    if !object.contains('parentId') {
        throw errorf('session entry %s has no parentId', id)
    }
    bool has_parent = !json_util.is_null(object['parentId'])
    string parent_id = ''
    if has_parent {
        parent_id = object['parentId'] as string
    }
    return new types.entry_t(kind = kind, id = id, has_parent = has_parent, parent_id = parent_id, timestamp = timestamp, raw = value)
}

pub fn required_string({string:any} object, string key): string! {
    if !object.contains(key) {
        throw errorf('session JSON missing `%s`', key)
    }
    return object[key] as string
}

pub fn optional_string({string:any} object, string key): string {
    if !object.contains(key) || !(object[key] is string) {
        return ''
    }
    return object[key] as string
}

pub fn optional_int({string:any} object, string key, int fallback): int {
    if !object.contains(key) || !(object[key] is f64) {
        return fallback
    }
    return object[key] as f64 as int
}
