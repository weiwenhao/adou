import adou.src.config.resolve_config_value
import syscall

test 'literal and env template resolution like Pi' {
    syscall.set_env('ADOU_TEST_KEY', 'secret-value')
    assert(resolve_config_value.resolve_config_value('plain') == 'plain')
    assert(resolve_config_value.resolve_config_value('$ADOU_TEST_KEY') == 'secret-value')
    assert(resolve_config_value.resolve_config_value('pre-${ADOU_TEST_KEY}-post') == 'pre-secret-value-post')
    syscall.set_env('ADOU_TEST_KEY', '')
}

test 'dollar escapes behave like Pi' {
    assert(resolve_config_value.resolve_config_value('$$ADOU_TEST_KEY') == '$ADOU_TEST_KEY')
    assert(resolve_config_value.resolve_config_value('$!ADOU_TEST_KEY') == '!ADOU_TEST_KEY')
}

test 'missing env references resolve to empty like Pi' {
    syscall.set_env('ADOU_NOPE_VAR', '')
    assert(resolve_config_value.resolve_config_value('$ADOU_NOPE_VAR') == '')
    assert(resolve_config_value.resolve_config_value('x$ADOU_NOPE_VAR') == '')
}

test 'command values execute and cache like Pi' {
    string value = resolve_config_value.resolve_config_value('!echo hello-world')
    assert(value == 'hello-world')
    // Cached: the command runs once.
    string again = resolve_config_value.resolve_config_value('!echo hello-world')
    assert(again == 'hello-world')
    assert(resolve_config_value.is_command_config_value('!echo x'))
    assert(!resolve_config_value.is_command_config_value('echo x'))
}

test 'configured checks track missing variables like Pi' {
    syscall.set_env('ADOU_CFG_A', 'set')
    syscall.set_env('ADOU_CFG_B', '')
    assert(resolve_config_value.is_config_value_configured('$ADOU_CFG_A'))
    assert(!resolve_config_value.is_config_value_configured('$ADOU_CFG_B'))
    assert(resolve_config_value.is_config_value_configured('literal'))
    syscall.set_env('ADOU_CFG_A', '')
}

test 'single env name and missing names like Pi' {
    syscall.set_env('ADOU_CFG_C', 'set')
    syscall.set_env('ADOU_CFG_D', '')
    assert(resolve_config_value.get_config_value_env_var_name('$ADOU_CFG_C') == 'ADOU_CFG_C')
    assert(resolve_config_value.get_config_value_env_var_name('${ADOU_CFG_C}') == 'ADOU_CFG_C')
    assert(resolve_config_value.get_config_value_env_var_name('x-$ADOU_CFG_C') == '')
    assert(resolve_config_value.get_config_value_env_var_name('!echo hi') == '')
    var missing = resolve_config_value.get_missing_config_value_env_var_names('$ADOU_CFG_C-$ADOU_CFG_D')
    assert(missing.len() == 1)
    assert(missing[0] == 'ADOU_CFG_D')
    syscall.set_env('ADOU_CFG_C', '')
}

test 'uncached and throwing resolution like Pi' {
    syscall.set_env('ADOU_CFG_E', 'secret')
    assert(resolve_config_value.resolve_config_value_uncached('!echo fresh') == 'fresh')
    assert(resolve_config_value.resolve_config_value_or_throw('$ADOU_CFG_E', 'test value') == 'secret')
    bool failed = false
    try {
        string value = resolve_config_value.resolve_config_value_or_throw('$ADOU_CFG_MISSING_XYZ', 'test value')
    } catch e {
        failed = true
    }
    assert(failed)
    syscall.set_env('ADOU_CFG_E', '')
}

test 'resolve_headers resolves every value like Pi' {
    syscall.set_env('ADOU_CFG_F', 'from-env')
    {string:string} headers = {}
    headers['X-Literal'] = 'plain'
    headers['X-Env'] = '$ADOU_CFG_F'
    headers['X-Command'] = '!echo via-shell'
    var resolved = resolve_config_value.resolve_headers(headers)
    assert(resolved.len() == 3)
    string literal = resolved['X-Literal'] catch error {'missing'}
    string env_value = resolved['X-Env'] catch error {'missing'}
    string command_value = resolved['X-Command'] catch error {'missing'}
    assert(literal == 'plain')
    assert(env_value == 'from-env')
    assert(command_value == 'via-shell')
    resolve_config_value.clear_config_value_cache()
    syscall.set_env('ADOU_CFG_F', '')
}

test 'env var name extraction like Pi' {
    var names = resolve_config_value.get_config_value_env_var_names('$A and ${B} and $A')
    assert(names.len() == 2)
    var none = resolve_config_value.get_config_value_env_var_names('!command')
    assert(none.len() == 0)
}
