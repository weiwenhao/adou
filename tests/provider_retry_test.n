import adou.src.ai.abort
import adou.src.ai.provider_retry
test 'matches provider retry status and override headers' {
    [provider_retry.header_t] headers = []
    assert(provider_retry.should_retry(429, headers))
    assert(!provider_retry.should_retry(400, headers))
    var allow = provider_retry.header_t {
        name: 'x-should-retry', value: 'true',
    }
    headers.push(allow)
    assert(provider_retry.should_retry(400, headers))
    headers = []
    var deny = provider_retry.header_t {
        name: 'x-should-retry', value: 'false',
    }
    headers.push(deny)
    assert(!provider_retry.should_retry(503, headers))
}
test 'honors retry-after milliseconds and seconds' {
    [provider_retry.header_t] headers = []
    var milliseconds = provider_retry.header_t {
        name: 'Retry-After-Ms', value: '12.9',
    }
    headers.push(milliseconds)
    assert(provider_retry.delay_ms(headers, 0, 100, 'rate limited') == 12)
    var seconds = provider_retry.header_t {
        name: 'Retry-After', value: '0.025',
    }
    headers = [seconds]
    assert(provider_retry.delay_ms(headers, 0, 100, 'rate limited') == 25)
}
test 'rejects server delays above the configured cap' {
    var retry_after = provider_retry.header_t {
        name: 'Retry-After', value: '2',
    }
    [provider_retry.header_t] headers = [retry_after]
    bool failed = false
    provider_retry.delay_ms(headers, 0, 1000, 'HTTP 429') catch e {
        failed = e.msg() == 'Server requested 2s retry delay (max: 1s). HTTP 429'
        0
    }
    assert(failed)
}
test 'retry backoff is bounded and cancellation is observed' {
    int first = provider_retry.exponential_delay_ms(0)
    int capped = provider_retry.exponential_delay_ms(20)
    assert(first >= 375 && first <= 500)
    assert(capped >= 6000 && capped <= 8000)
    var cancellation = abort.new()
    cancellation.abort()
    bool failed = false
    provider_retry.sleep(cancellation, 100) catch e {
        failed = e.msg() == 'Request aborted'
    }
    assert(failed)
}
