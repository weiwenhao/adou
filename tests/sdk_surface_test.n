import adou.src.ai.types as types
import fmt
import adou.src.sdk
import path
import syscall

fn isolate_settings(string name) {
    syscall.set_env('ADOU_CODING_AGENT_DIR', path.join('/tmp', 'adou-sdk-surface-' + name)) catch error {}
}

// B6 (docs/porting-plan-100): SDK surface completions — cycle/set/dispose
// exist on the session object and behave without a live provider.

test 'cycle model returns empty without authenticated providers' {
    isolate_settings('cycle')
    var model = new types.model_t(id = 'sdk-model', name = 'SDK model', api = 'test-api', provider = 'test-provider', base_url = 'https://example.invalid', context_window = 1000, max_tokens = 100)
    var session = sdk.create(sdk.options_t {cwd: '/tmp', model: model, api_key: 'test-key', system_prompt: 'system'})
    string cycled = session.cycle_model(true)
    // Environment-dependent: with credentials present the cycle lands on a
    // provider-qualified model; without any, it stays empty.
    assert(cycled == '' || cycled.contains('/'))
}

test 'set model applies through to the runner' {
    isolate_settings('set-model')
    var model = new types.model_t(id = 'sdk-next', name = 'SDK next', api = 'test-api', provider = 'test-provider', base_url = 'https://example.invalid', context_window = 1000, max_tokens = 100)
    var session = sdk.create(sdk.options_t {cwd: '/tmp', model: model, api_key: 'test-key', system_prompt: 'system'})
    var next = new types.model_t(id = 'sdk-next-2', name = 'SDK next 2', api = 'test-api', provider = 'test-provider', base_url = 'https://example.invalid', context_window = 1000, max_tokens = 100)
    session.set_model(next)
    assert(session.runner.agent_config.model.id == 'sdk-next-2')
}

test 'thinking level set applies through to the runner' {
    isolate_settings('thinking')
    var model = new types.model_t(id = 'sdk-model', name = 'SDK model', api = 'test-api', provider = 'test-provider', base_url = 'https://example.invalid', reasoning = true, context_window = 1000, max_tokens = 100)
    var session = sdk.create(sdk.options_t {cwd: '/tmp', model: model, api_key: 'test-key', system_prompt: 'system'})
    session.set_thinking_level('low')
    assert(session.runner.agent_config.stream_options.reasoning_effort == 'low')
}

test 'dispose is a safe no-op' {
    isolate_settings('dispose')
    var model = new types.model_t(id = 'sdk-model', name = 'SDK model', api = 'test-api', provider = 'test-provider', base_url = 'https://example.invalid', context_window = 1000, max_tokens = 100)
    var session = sdk.create(sdk.options_t {cwd: '/tmp', model: model, api_key: 'test-key', system_prompt: 'system'})
    session.dispose()
}
