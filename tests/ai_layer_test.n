import adou.src.ai.auth
import adou.src.config.auth as credential_store
import adou.src.ai.env_api_keys
import adou.src.ai.models_store
import adou.src.ai.session_resources
import adou.src.ai.types
import fmt
import os
import syscall

test 'env api keys report and resolve provider keys' {
    syscall.set_env('DEEPSEEK_API_KEY', 'ds-key')
    syscall.set_env('OPENAI_API_KEY', '')
    syscall.set_env('ANT_LING_API_KEY', '')
    var keys = env_api_keys.find_env_keys('deepseek')
    assert(keys.len() == 1 && keys[0] == 'DEEPSEEK_API_KEY')
    assert(env_api_keys.get_env_api_key('deepseek') == 'ds-key')
    assert(env_api_keys.find_env_keys('openai').len() == 0)
    syscall.set_env('DEEPSEEK_API_KEY', '')
}

test 'env api keys mark ambient credential sources' {
    syscall.set_env('AWS_ACCESS_KEY_ID', 'akid')
    syscall.set_env('AWS_SECRET_ACCESS_KEY', 'secret')
    assert(env_api_keys.get_env_api_key('amazon-bedrock') == '<authenticated>')
    syscall.set_env('AWS_ACCESS_KEY_ID', '')
    syscall.set_env('AWS_SECRET_ACCESS_KEY', '')
    assert(env_api_keys.get_env_api_key('amazon-bedrock') == '')
}

test 'models store keeps per-provider catalogs' {
    var store = models_store.new_store()
    var entry = models_store.models_store_entry_t {models: [new types.model_t(id = 'm1', api = 'openai-completions', provider = 'deepseek', base_url = 'https://api.deepseek.com'),], checked_at: 123,}
    store.write('deepseek', entry)
    var read = store.read('deepseek')
    assert(read is ref<models_store.models_store_entry_t>)
    if read is ref<models_store.models_store_entry_t> got {
        assert(got.models.len() == 1 && got.models[0].id == 'm1')
        assert(got.checked_at == 123)
    }
    store.delete('deepseek')
    assert(store.read('deepseek') is null)
}

test 'session resources register and run cleanups' {
    var resources = session_resources.new()
    int ran = 0
    session_resources.session_cleanup_fn cleanup = fn(string session_id) {
        ran += 1
    }
    resources.register(cleanup)
    resources.cleanup('session-1')
    assert(ran == 1)
    resources.unregister(cleanup)
    resources.cleanup('session-2')
    assert(ran == 1)
}

test 'auth resolution prefers stored credentials then env' {
    string home = '/tmp/adou-ai-auth-test'
    os.rmdir(home, true) catch error {}
    syscall.set_env('HOME', home)
    syscall.set_env('DEEPSEEK_API_KEY', 'env-key')
    assert(auth.api_key('deepseek') == 'env-key')
    assert(auth.is_configured('deepseek'))
    credential_store.save('deepseek', 'stored-key') catch error {}
    assert(auth.api_key('deepseek') == 'stored-key')
    credential_store.remove('deepseek')
    syscall.set_env('DEEPSEEK_API_KEY', '')
    assert(!auth.is_configured('deepseek'))
    os.rmdir(home, true)
}
