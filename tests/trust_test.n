import adou.src.config.paths
import adou.src.config.trust
import adou.src.json_util
import fmt
import fs
import os
import path
import syscall
import time

var trust_store_sequence = 0

pub fn isolate_trust_store() {
    // Redirect every case so inherited decisions cannot leak between tests
    // and the suite never touches the user's real agent directory.
    trust_store_sequence += 1
    string dir = path.join('/tmp', 'adou-trust-test-' + suffix() + '-' + fmt.sprintf('%d', trust_store_sequence))
    os.mkdirs(dir, 0o700) catch error {}
    syscall.set_env('PI_CODING_AGENT_DIR', dir) catch error {}
}

test 'decision resolves the nearest ancestor like Pi' {
    isolate_trust_store()
    os.mkdirs(path.join('/tmp', 'adou-trust-root-' + suffix()), 0o700)
    // Direct store manipulation through the module is exercised via save/decision.
    trust.save('/tmp/a/b/c', true) catch error {}
    bool first = trust.decision('/tmp/a/b/c') is bool && trust.decision('/tmp/a/b/c') as bool
    assert(first)
    bool nested = trust.decision('/tmp/a/b/c/sub') is bool && trust.decision('/tmp/a/b/c/sub') as bool
    assert(nested)
    assert(trust.decision_source('/tmp/a/b/c/sub') == '/tmp/a/b/c')
    assert(trust.decision('/tmp/a/b/x') is null)
    assert(trust.decision_source('/tmp/a/b/x') == '')
}

test 'clear removes a decision like Pi null updates' {
    isolate_trust_store()
    trust.save('/tmp/a/clear-test', false) catch error {}
    bool stored = trust.decision('/tmp/a/clear-test') is bool && !(trust.decision('/tmp/a/clear-test') as bool)
    assert(stored)
    trust.clear('/tmp/a/clear-test')
    assert(trust.decision('/tmp/a/clear-test') is null)
}

test 'set_many applies updates and null deletions like Pi' {
    isolate_trust_store()
    [trust.trust_update_t] updates = []
    updates.push(trust.trust_update_t {trust_path: '/tmp/a/multi-1', decision: true})
    updates.push(trust.trust_update_t {trust_path: '/tmp/a/multi-2', decision: false})
    trust.set_many(updates) catch error {}
    bool first = trust.decision('/tmp/a/multi-1') is bool && trust.decision('/tmp/a/multi-1') as bool
    assert(first)
    bool second = trust.decision('/tmp/a/multi-2') is bool && !(trust.decision('/tmp/a/multi-2') as bool)
    assert(second)
    [trust.trust_update_t] removals = []
    removals.push(trust.trust_update_t {trust_path: '/tmp/a/multi-1', decision: false, remove: true})
    trust.set_many(removals) catch error {}
    assert(trust.decision('/tmp/a/multi-1') is null)
    bool second_after = trust.decision('/tmp/a/multi-2') is bool && !(trust.decision('/tmp/a/multi-2') as bool)
    assert(second_after)
}

test 'trust_parent_path returns the parent directory like Pi' {
    isolate_trust_store()
    string parent = trust.trust_parent_path('/tmp/a/b/c')
    assert(parent == '/tmp/a/b')
    assert(trust.trust_parent_path('/') == '')
}

test 'has_trust_requiring_resources detects .pi resources and agents skills' {
    isolate_trust_store()
    string root = path.join('/tmp', 'adou-trust-res-' + suffix())
    os.mkdirs(path.join(root, '.pi'), 0o700)
    assert(!trust.has_trust_requiring_resources(root))
    os.mkdirs(path.join(root, '.pi', 'skills'), 0o700)
    var file = fs.open(path.join(root, '.pi', 'skills', 'SKILL.md'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    file.write('x' as [u8])
    file.close()
    assert(trust.has_trust_requiring_resources(root))
}

test 'resolve_trust applies stored decisions per cwd and explicit overrides win' {
    isolate_trust_store()
    // A project with trust-requiring resources picks up its stored decision.
    string project = path.join('/tmp', 'adou-trust-res-' + suffix())
    os.mkdirs(path.join(project, '.pi', 'skills'), 0o700)
    var file = fs.open(path.join(project, '.pi', 'skills', 'SKILL.md'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    file.write('x' as [u8])
    file.close()
    assert(trust.resolve_trust(false, true, project, 'ask'))
    trust.save(project, false) catch error {}
    assert(!trust.resolve_trust(false, true, project, 'ask'))
    // Without trust-requiring resources the default stays trusted even when
    // a stored decision exists (Pi returns true before consulting the store).
    string plain = path.join('/tmp', 'adou-trust-plain-' + suffix())
    trust.save(plain, false) catch error {}
    assert(trust.resolve_trust(false, true, plain, 'ask'))
    // An explicit --approve/--no-approve always wins for any cwd.
    assert(trust.resolve_trust(true, true, project, 'ask'))
    assert(!trust.resolve_trust(true, false, project, 'ask'))
    assert(trust.resolve_trust(true, true, plain, 'ask'))
    assert(!trust.resolve_trust(true, false, plain, 'ask'))
}

test 'defaultProjectTrust fallback gates projects without stored decisions' {
    isolate_trust_store()
    string project = path.join('/tmp', 'adou-trust-default-' + suffix())
    os.mkdirs(path.join(project, '.pi', 'skills'), 0o700)
    var file = fs.open(path.join(project, '.pi', 'skills', 'SKILL.md'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    file.write('x' as [u8])
    file.close()
    // No stored decision: the global settings fallback decides.
    assert(trust.resolve_trust(false, true, project, 'always'))
    assert(!trust.resolve_trust(false, true, project, 'never'))
    assert(trust.resolve_trust(false, true, project, 'ask'))
    // A stored decision still wins over the fallback.
    trust.save(project, false) catch error {}
    assert(!trust.resolve_trust(false, true, project, 'always'))
    // Explicit overrides still win over everything.
    assert(trust.resolve_trust(true, true, project, 'never'))
}

fn suffix(): string {
    return fmt.sprintf('%d', time.now().ms_timestamp())
}

test 'get_project_trust_options builds the Pi choice set' {
    isolate_trust_store()
    var options = trust.get_project_trust_options('/tmp/adou-trust-opt-' + suffix(), false)
    assert(options.len() == 3)
    assert(options[0].label == 'Trust')
    assert(options[0].trusted)
    assert(options[0].saved_path != '')
    assert(options[1].label.starts_with('Trust parent folder'))
    assert(options[1].updates.len() == 2)
    assert(options[1].updates[0].decision)
    assert(options[1].updates[1].remove)
    assert(options[2].label == 'Do not trust')
    assert(!options[2].trusted)
    var session_options = trust.get_project_trust_options('/tmp/x/' + suffix(), true)
    assert(session_options.len() == 5)
    assert(session_options[2].label == 'Trust (this session only)')
    assert(session_options[2].updates.len() == 0)
    var root_options = trust.get_project_trust_options('/', false)
    assert(root_options.len() == 2)
    assert(root_options[1].label == 'Do not trust')
}
