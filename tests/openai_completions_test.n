import adou.src.ai.providers.openai_completions
import adou.src.ai.sse
import adou.src.ai.types
import adou.src.json_util
import co
import json
import time

pub fn model(): ref<types.model_t> {
    return new types.model_t(id = 'deepseek-v4-flash', api = 'openai-completions', provider = 'deepseek')
}

pub fn frame(string data): sse.event_t {
    return sse.event_t {data: data,}
}

test 'processes DeepSeek text and reasoning stream' {
    var processor = openai_completions.processor(model(), 1)
    var start = processor.start()
    assert(start.kind == types.EVENT_START)
    var first = processor.feed(frame('{"id":"chat-1","choices":[{"delta":{"reasoning_content":"plan"},"finish_reason":null}]}'))
    assert(first.len() == 2 && first[0].kind == types.EVENT_THINKING_START && first[1].kind == types.EVENT_THINKING_DELTA)
    var second = processor.feed(frame('{"id":"chat-1","choices":[{"delta":{"content":"answer"},"finish_reason":null}]}'))
    assert(second.len() == 2 && second[0].kind == types.EVENT_TEXT_START && second[1].kind == types.EVENT_TEXT_DELTA)
    processor.feed(frame('{"id":"chat-1","choices":[{"delta":{},"finish_reason":"stop"}],"usage":{"prompt_tokens":10,"completion_tokens":4,"prompt_tokens_details":{"cached_tokens":2},"completion_tokens_details":{"reasoning_tokens":1}}}'))
    var done = processor.finish()
    assert(done.len() == 3)
    assert(done[0].kind == types.EVENT_THINKING_END && done[1].kind == types.EVENT_TEXT_END)
    assert(done[2].kind == types.EVENT_DONE)
    if done[2].message is ref<types.assistant_message_t> message {
        assert(message.usage.input == 8 && message.usage.cache_read == 2)
    } else {
        assert(false)
    }
}

test 'processes streamed function tool call and maps toolUse stop reason' {
    var processor = openai_completions.processor(model(), 1)
    processor.start()
    var first = processor.feed(frame('{"choices":[{"delta":{"tool_calls":[{"index":0,"id":"call_1","type":"function","function":{"name":"read","arguments":"{\\"path\\":\\""}}]},"finish_reason":null}]}'))
    assert(first.len() == 2 && first[0].kind == types.EVENT_TOOLCALL_START && first[1].kind == types.EVENT_TOOLCALL_DELTA)
    var partial = first[1].partial as ref<types.assistant_message_t>
    var partial_call = partial.content[0] as ref<types.tool_call_t>
    assert(json_util.is_obj(partial_call.arguments))
    assert((partial_call.arguments as {string:any})['path'] as string == '')
    processor.feed(frame('{"choices":[{"delta":{"tool_calls":[{"index":0,"function":{"arguments":"README.md\\"}"}}]},"finish_reason":null}]}'))
    processor.feed(frame('{"choices":[{"delta":{},"finish_reason":"tool_calls"}]}'))
    var done = processor.finish()
    assert(done[0].kind == types.EVENT_TOOLCALL_END)
    if done[0].tool_call is ref<types.tool_call_t> tool_call {
        assert(tool_call.name == 'read')
        assert((tool_call.arguments as {string:any})['path'] as string == 'README.md')
    } else {
        assert(false)
    }
    assert(done[1].kind == types.EVENT_DONE && done[1].reason == types.STOP_TOOL_USE)
}

test 'repairs incomplete final function arguments like Pi' {
    var processor = openai_completions.processor(model(), 1)
    processor.start()
    processor.feed(frame('{"choices":[{"delta":{"tool_calls":[{"index":0,"id":"call_partial","function":{"name":"read","arguments":"{\\"path\\":\\"README"}}]},"finish_reason":null}]}'))
    processor.feed(frame('{"choices":[{"delta":{},"finish_reason":"tool_calls"}]}'))
    var done = processor.finish()
    if done[0].tool_call is ref<types.tool_call_t> tool_call {
        assert(json_util.is_obj(tool_call.arguments))
        assert((tool_call.arguments as {string:any})['path'] as string == 'README')
    } else {
        assert(false)
    }
}

test 'continues a tool call by id when the provider omits index' {
    var processor = openai_completions.processor(model(), 1)
    processor.start()
    var first = processor.feed(frame('{"choices":[{"delta":{"tool_calls":[{"id":"call_no_index","function":{"name":"read","arguments":"{\\"path\\":\\""}}]},"finish_reason":null}]}'))
    assert(first.len() == 2 && first[0].kind == types.EVENT_TOOLCALL_START)
    var second = processor.feed(frame('{"choices":[{"delta":{"tool_calls":[{"id":"call_no_index","function":{"arguments":"main.n\\"}"}}]},"finish_reason":null}]}'))
    assert(second.len() == 1 && second[0].kind == types.EVENT_TOOLCALL_DELTA)
    processor.feed(frame('{"choices":[{"delta":{},"finish_reason":"tool_calls"}]}'))
    var done = processor.finish()
    assert(done.len() == 2 && done[0].kind == types.EVENT_TOOLCALL_END)
    if done[0].tool_call is ref<types.tool_call_t> tool_call {
        assert(tool_call.id == 'call_no_index')
        assert((tool_call.arguments as {string:any})['path'] as string == 'main.n')
    } else {
        assert(false)
    }
}

test 'coalesces tiny text deltas without losing the final message' {
    var processor = openai_completions.processor(model(), 1)
    processor.start()
    int emitted = 0
    for int index = 0; index < 300; index += 1 {
        processor.text_last_flush_ms = time.now().ms_timestamp()
        var events = processor.feed(frame('{"choices":[{"delta":{"content":"x"},"finish_reason":null}]}'))
        emitted += events.len()
    }
    processor.feed(frame('{"choices":[{"delta":{},"finish_reason":"stop"}]}'))
    var done = processor.finish()
    assert(emitted <= 4)
    if done[done.len() - 1].message is ref<types.assistant_message_t> message {
        assert(message.content.len() == 1)
        assert((message.content[0] as ref<types.text_content_t>).text.len() == 300)
    } else {
        assert(false)
    }
}

test 'bounds a same-tick snapshot burst for long reasoning streams' {
    var processor = openai_completions.processor(model(), 1)
    processor.start()
    string chunk = 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
    int emitted = 0
    int chunks = 8192
    for int index = 0; index < chunks; index += 1 {
        processor.thinking_last_flush_ms = time.now().ms_timestamp()
        var events = processor.feed(frame('{"choices":[{"delta":{"reasoning_content":"' + chunk + '"},"finish_reason":null}]}'))
        emitted += events.len()
    }
    processor.feed(frame('{"choices":[{"delta":{},"finish_reason":"stop"}]}'))
    var done = processor.finish()
    // A producer burst is capped by bytes even when the 16 ms render clock
    // has not advanced; ordinary live streaming flushes on that clock.
    assert(emitted < 32)
    if done[done.len() - 1].message is ref<types.assistant_message_t> message {
        assert(message.content.len() == 1)
        assert((message.content[0] as ref<types.thinking_content_t>).thinking.len() == chunk.len() * chunks)
    } else {
        assert(false)
    }
}

test 'flushes pending reasoning on Pi render cadence' {
    var processor = openai_completions.processor(model(), 1)
    processor.start()
    var first = processor.feed(frame('{"choices":[{"delta":{"reasoning_content":"a"},"finish_reason":null}]}'))
    assert(first.len() == 2)
    processor.thinking_last_flush_ms = time.now().ms_timestamp()
    var pending = processor.feed(frame('{"choices":[{"delta":{"reasoning_content":"b"},"finish_reason":null}]}'))
    assert(pending.len() == 0)
    co.sleep(20)
    var flushed = processor.feed(frame('{"choices":[{"delta":{"reasoning_content":"c"},"finish_reason":null}]}'))
    assert(flushed.len() == 1 && flushed[0].kind == types.EVENT_THINKING_DELTA && flushed[0].delta == 'bc')
}
