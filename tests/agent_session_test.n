test 'manual compaction aborts an active turn before summarizing' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 100, 0, 2)
    var active = session_stream.new()
    runner.begin_operation()
    runner.attach_stream(active)
    go release_after_abort(runner, active)
    var result = consume(runner.compact_now('compact after cancelling the turn'))
    assert(active.cancellation.is_aborted())
    assert(fixture.summary_calls == 1)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_START) == 1)
    assert(manager.latest_compaction() is ref<session_types.entry_t>)
}

test 'manual compaction retries transient summaries and emits Pi retry lifecycle' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    var fixture = new provider_fixture_t(summary_failures = 1)
    var runner = make_runner(manager, fixture, 100, 0, 2)
    runner.retry_base_delay_ms = 1
    var result = consume(runner.compact_now('retry the summary'))
    assert(fixture.summary_calls == 2)
    assert(count_kind(result[0], session_stream.EVENT_SUMMARIZATION_RETRY_SCHEDULED) == 1)
    assert(count_kind(result[0], session_stream.EVENT_SUMMARIZATION_RETRY_ATTEMPT_START) == 1)
    assert(count_kind(result[0], session_stream.EVENT_SUMMARIZATION_RETRY_FINISHED) == 1)
    bool attempt_matches = false
    for event in result[0] {
        if event.kind == session_stream.EVENT_SUMMARIZATION_RETRY_ATTEMPT_START {
            attempt_matches = event.retry_source == 'compaction' && event.retry_reason == 'manual'
        }
    }
    assert(attempt_matches)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_END) == 1)
    assert(manager.latest_compaction() is ref<session_types.entry_t>)
}

test 'starting a new session clears active context and keeps in-memory mode' {
    var manager = repository.in_memory('/tmp')
    manager.append_message(user('old'))
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 100, 0, 2)
    assert(runner.active_messages.len() == 1 && !runner.repository.persisted)
    string previous_id = runner.repository.get_session_id()
    runner.agent_config.stream_options.session_id = 'stale-session-id'
    runner.start_new_session()
    assert(runner.active_messages.len() == 0)
    assert(runner.repository.get_entries().len() == 2 && !runner.repository.persisted)
    assert(runner.repository.get_entries()[0].kind == session_types.ENTRY_MODEL_CHANGE)
    assert(runner.repository.get_entries()[1].kind == session_types.ENTRY_THINKING_CHANGE)
    assert(runner.repository.get_session_id() != previous_id)
    assert(runner.agent_config.stream_options.session_id == runner.repository.get_session_id())
}

test 'clone rejects a session without a current leaf' {
    var manager = repository.in_memory('/tmp')
