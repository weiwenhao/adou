    string message = ''
    runner.clone_session() catch error {
        message = error.msg()
    }
    assert(message == 'Cannot clone session: no current entry selected')
    assert(runner.repository == manager && runner.active_messages.len() == 0)
}

test 'switching to a legacy session repairs missing thinking metadata' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 100, 0, 2)
    var legacy = repository.in_memory('/tmp')
    legacy.append_message(user('legacy prompt'))
    runner.replace_repository(legacy)
    assert(runner.repository == legacy)
    assert(legacy.get_entries().len() == 2)
    assert(legacy.get_entries()[0].kind == session_types.ENTRY_MESSAGE)
    assert(legacy.get_entries()[1].kind == session_types.ENTRY_THINKING_CHANGE)
    assert(runner.active_messages.len() == 1)
}

test 'tree navigation to a user message selects its parent and restores editor text' {
    var manager = repository.in_memory('/tmp')
    string first_user = manager.append_message(user('first request'))
    ai_types.message_t first_answer = assistant('first answer', ai_types.STOP_STOP, '', 2, 3)
    string first_assistant = manager.append_message(first_answer)
    string selected_user = manager.append_message(user('rewrite this request'))
    ai_types.message_t selected_answer = assistant('old answer', ai_types.STOP_STOP, '', 2, 3)
    manager.append_message(selected_answer)
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    string editor_text = runner.navigate_tree(selected_user)
    assert(editor_text == 'rewrite this request')
    assert(manager.get_leaf_id() == first_assistant)
    assert(runner.active_messages.len() == 2)
    assert(runner.active_messages[0] is ref<ai_types.user_message_t>)
    assert(first_user != '')
}

test 'tree branch summary captures the abandoned branch and attaches at target parent' {
    var manager = repository.in_memory('/tmp')
    manager.append_message(user('root request'))
    ai_types.message_t base_answer = assistant('base answer', ai_types.STOP_STOP, '', 2, 3)
    string common = manager.append_message(base_answer)
    string target_user = manager.append_message(user('target draft'))
    ai_types.message_t target_answer = assistant('target answer', ai_types.STOP_STOP, '', 2, 3)
    manager.append_message(target_answer)
    manager.set_leaf(common)
    manager.append_message(user('abandoned request'))
    ai_types.message_t abandoned_answer = assistant('abandoned answer', ai_types.STOP_STOP, '', 2, 3)
    manager.append_message(abandoned_answer)
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var target = runner.inspect_tree_target(target_user)
    assert(target.editor_text == 'target draft' && target.new_leaf_id == common)
    var result = consume(runner.navigate_tree_with_summary(target_user, 'preserve branch decisions'))
    assert(fixture.summary_calls == 1)
    assert(fixture.summary_prompts[0].contains('abandoned request'))
    assert(fixture.summary_prompts[0].contains('abandoned answer'))
    assert(!fixture.summary_prompts[0].contains('target draft'))
    assert(fixture.summary_prompts[0].contains('Additional focus: preserve branch decisions'))
    assert(count_kind(result[0], session_stream.EVENT_BRANCH_SUMMARY_START) == 1)
    assert(count_kind(result[0], session_stream.EVENT_BRANCH_SUMMARY_END) == 1)
    var entries = manager.get_entries()
    var summary_entry = entries[entries.len() - 1]
    assert(summary_entry.kind == session_types.ENTRY_BRANCH_SUMMARY)
    assert(summary_entry.has_parent && summary_entry.parent_id == common)
    var summary_object = summary_entry.raw as {string:any}
    assert(summary_object['fromId'] as string == common)
    assert(result[1].len() == 3)
    assert(result[1][2] is ref<ai_types.branch_summary_message_t>)
}

test 'thinking level changes persist once and update provider options' {
    isolate_agent_dir()
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.set_thinking_level('high')
    assert(runner.agent_config.stream_options.thinking_enabled)
    assert(runner.agent_config.stream_options.reasoning_effort == 'high')
    assert(manager.get_entries().len() == 1)
    assert(manager.get_entries()[0].kind == session_types.ENTRY_THINKING_CHANGE)
    var stream = session_stream.new()
    runner.attach_stream(stream)
    runner.set_thinking_level('medium')
    var thinking_event = stream.recv()
    assert(thinking_event.kind == session_stream.EVENT_THINKING_LEVEL_CHANGED && thinking_event.thinking_level == 'medium')
    runner.set_session_name('Demo')
    var name_event = stream.recv()
    assert(name_event.kind == session_stream.EVENT_SESSION_INFO_CHANGED && name_event.session_name == 'Demo')
    runner.set_thinking_level('high')
    assert(manager.get_entries().len() == 4)
}

test 'model selection preserves an explicit in-memory API key' {
    isolate_agent_dir()
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.agent_config.stream_options.api_key = 'runtime-key'
    var next = new ai_types.model_t(id = 'mock-next', api = 'mock', provider = 'mock', base_url = 'http://example.invalid', reasoning = true, context_window = 1000, max_tokens = 100)
    runner.set_model(next)
    assert(runner.agent_config.model.id == 'mock-next')
    assert(runner.agent_config.stream_options.api_key == 'runtime-key')
    // set_model persists a default model: it must land in the isolated
    // agent dir, never in the real user configuration.
    string agent_dir = syscall.get_env('ADOU_CODING_AGENT_DIR')
    var stored = settings.load()
    assert(stored.default_model == 'mock-next')
    assert(agent_dir.starts_with('/tmp/adou-agent-session-isolated-'))
}

test 'transient provider errors retry with the failed message removed from active context' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ERROR, '503 service unavailable', 0, 0), assistant('recovered after retry', ai_types.STOP_STOP, '', 4, 5)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.retry_base_delay_ms = 1
    var result = consume(runner.prompt('retry this request'))
    assert(fixture.agent_calls == 2)
    assert(count_kind(result[0], session_stream.EVENT_RETRY_START) == 1)
    assert(count_kind(result[0], session_stream.EVENT_RETRY_END) == 1)
    bool saw_retrying_end = false
    bool saw_final_end = false
    for event in result[0] {
        if event.kind == agent_types.EVENT_AGENT_END {
            if event.will_retry {saw_retrying_end = true} else {saw_final_end = true}
        }
    }
    assert(saw_retrying_end && saw_final_end)
    assert(result[1].len() == 2)
    assert(manager.get_entries().len() == 3)
    assert(manager.build_context().messages.len() == 3)
    if result[1][1] is ref<ai_types.assistant_message_t> recovered {
        assert(recovered.content.len() == 1)
    } else {
        assert(false)
    }
}

test 'Nature TLS read failures retry after provider retries are exhausted' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ERROR, 'TLS read failed: end of file', 0, 0), assistant('recovered after TLS retry', ai_types.STOP_STOP, '', 4, 5)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.retry_base_delay_ms = 1
    var result = consume(runner.prompt('retry the interrupted TLS request'))
    assert(fixture.agent_calls == 2)
    assert(count_kind(result[0], session_stream.EVENT_RETRY_START) == 1)
    assert(count_kind(result[0], session_stream.EVENT_RETRY_END) == 1)
    assert(result[1].len() == 2)
    assert(manager.get_entries().len() == 3)
    assert(manager.build_context().messages.len() == 3)
    if result[1][1] is ref<ai_types.assistant_message_t> recovered {
        assert(recovered.error_message == '')
        assert(recovered.content.len() == 1)
    } else {
        assert(false)
    }
}

test 'abort_retry cancels only the retry backoff' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ERROR, '503 service unavailable', 0, 0)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.retry_base_delay_ms = 1000
    var stream = runner.prompt('cancel the retry')
    bool saw_retry_start = false
    for true {
        var event = stream.recv() catch error {break}
        if event.kind == session_stream.EVENT_RETRY_START {
            saw_retry_start = true
            for !(runner.active_retry_abort is ref<abort.abort_t>) {
                co.sleep(1)
            }
            runner.abort_retry()
            break
        }
    }
    assert(saw_retry_start)
    assert(!stream.cancellation.is_aborted())
    var result = consume(stream)
    assert(count_kind(result[0], session_stream.EVENT_RETRY_END) == 1)
    assert(count_kind(result[0], session_stream.EVENT_AGENT_SETTLED) == 1)
    assert(fixture.agent_calls == 1)
    assert(!runner.busy)
}

test 'rpc prompt keeps terminal delivery alive until the worker acknowledges it' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('rpc result', ai_types.STOP_STOP, '', 2, 3)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var stream = runner.prompt_rpc('rpc prompt')
    runner.require_rpc_delivery(stream)
    [session_stream.event_t] events = []
    for true {
        var event = stream.recv() catch error {break}
        events.push(event)
        if event.kind == session_stream.EVENT_SESSION_END {break}
    }
    var ignored = stream.result()
    runner.finish_rpc_delivery(stream)
    assert(count_kind(events, session_stream.EVENT_AGENT_SETTLED) == 1)
    assert(count_kind(events, session_stream.EVENT_SESSION_END) == 1)
    assert(!runner.busy)
}

test 'B1-R4-10 rpc prompt expands and publishes one resource snapshot' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('rpc expanded', ai_types.STOP_STOP, '', 2, 3)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var snapshot = new resource_snapshot.resource_snapshot_t()
    var template = new prompt_templates.prompt_template_t(name = 'rpc-template', content = 'Expanded $@')
    snapshot.prompt_templates.push(template)
    snapshot.settings.steering_mode = 'all'
    snapshot.settings.follow_up_mode = 'all'
    snapshot.settings.auto_compaction = false
    snapshot.settings.retry_enabled = false
    snapshot.settings.retry_max_attempts = 2
    snapshot.settings.retry_base_delay_ms = 17
    snapshot.settings.block_images = true
    [ref<agent_types.agent_tool_t>] no_tools = []
    runner.publish_rpc_resources(snapshot, 'snapshot system', no_tools, true)
    assert(runner.agent_config.stream_options.block_images)

    var stream = runner.prompt_rpc('/rpc-template one two')
    for true {
        var event = stream.recv()
        if event.kind == session_stream.EVENT_SESSION_END {break}
    }
    var result = stream.result()
    stream.mark_delivery_done()
    assert(result.len() == 2)
    assert(fixture.agent_contexts.len() == 1)
    assert(fixture.agent_contexts[0].len() == 1)
    assert(fixture.agent_contexts[0][0] is ref<ai_types.user_message_t>)
    var submitted = fixture.agent_contexts[0][0] as ref<ai_types.user_message_t>
    assert(submitted.content == 'Expanded one two')
    assert(runner.context_from_repository().system_prompt == 'snapshot system')
    assert(runner.agent_config.queues.steering_mode == 'all')
    assert(runner.agent_config.queues.follow_up_mode == 'all')
    assert(!runner.compaction_settings.enabled && !runner.retry_enabled)
    assert(runner.retry_max_attempts == 2 && runner.retry_base_delay_ms == 17)
}

test 'rpc stream result wakes at terminal before delivery acknowledgement' {
    var stream = session_stream.new()
    stream.require_delivery()
    var completed = chan<u8>.new(1)
    go wait_stream_result(stream, completed)
    co.sleep(10)
    stream.finish([])
    completed.recv()
    assert(stream.is_terminal())
    assert(stream.recv().kind == session_stream.EVENT_SESSION_END)
    stream.mark_delivery_done()
}

test 'abort_bash only cancels the active bash stream' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var prompt_stream = session_stream.new()
    runner.begin_operation()
    runner.attach_stream(prompt_stream)
    runner.abort_bash()
    assert(!prompt_stream.cancellation.is_aborted())
    runner.end_operation()

    var bash_stream = session_stream.new()
    runner.begin_operation()
    runner.attach_bash_stream(bash_stream)
    runner.abort_bash()
    assert(bash_stream.cancellation.is_aborted())
    runner.end_operation()
}

// B4: Pi setModel has no streaming guard — a mid-stream swap lands on the
// next turn instead of throwing.
test 'set model applies while a stream is marked busy' {
    isolate_agent_dir()
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.agent_config.stream_options.api_key = 'runtime-key'
    var next = new ai_types.model_t(id = 'mock-busy', api = 'mock', provider = 'mock', base_url = 'http://example.invalid', reasoning = true, context_window = 1000, max_tokens = 100)
    runner.busy = true
    runner.set_model(next) catch e {
        assert(false)
    }
    runner.busy = false
    assert(runner.agent_config.model.id == 'mock-busy')
}
