import time

pub type provider_fixture_t = struct {
    ref<mutex.mutex_t> lock = mutex.mutex_t.new()
    [ref<ai_types.assistant_message_t>] agent_responses = []
    int agent_index
    int agent_calls
    int summary_calls
    int summary_failures
    [[ai_types.message_t]] agent_contexts = []
    [string] summary_prompts = []
}

pub fn model(int context_window): ref<ai_types.model_t> {
    return new ai_types.model_t(id = 'mock', api = 'mock', provider = 'mock', base_url = 'http://example.invalid', reasoning = true, context_window = context_window, max_tokens = 100)
}

pub fn assistant(string text, string stop_reason, string error_message, int input_tokens, int total_tokens): ref<ai_types.assistant_message_t> {
    [ai_types.content_t] content = []
    if text != '' {
        ai_types.content_t block = new ai_types.text_content_t(text = text)
        content.push(block)
    }
    return new ai_types.assistant_message_t(content = content, api = 'mock', provider = 'mock', model = 'mock', usage = ai_types.usage_t {input: input_tokens, total_tokens: total_tokens,}, stop_reason = stop_reason, error_message = error_message, timestamp = time.now().ms_timestamp())
}

pub fn assistant_tool(string call_id): ref<ai_types.assistant_message_t>! {
    var message = assistant('', ai_types.STOP_TOOL_USE, '', 1, 1)
    ai_types.content_t call = new ai_types.tool_call_t(id = call_id, name = 'session_echo', arguments = json_util.parse('{"value":"hello"}'))
    message.content.push(call)
    return message
}

pub type session_echo_executor_t: agent_types.tool_executor_t = struct {}

pub fn session_echo_executor_t.execute(&self, string tool_call_id, any arguments, ref<abort.abort_t> cancellation, agent_types.tool_update_fn on_update): tool_types.tool_result_t! {
    return tool_types.text_result('echoed from tool')
}

pub fn session_echo_tool(): ref<agent_types.agent_tool_t>! {
    var parameters = json_util.parse('{"type":"object","properties":{"value":{"type":"string"}},"required":["value"]}')
    agent_types.tool_executor_t executor = session_echo_executor_t{}
    return new agent_types.agent_tool_t(name = 'session_echo', label = 'session_echo', description = 'session_echo', parameters = parameters, executor = executor)
}

pub fn user(string text): ai_types.message_t {
    ai_types.message_t message = new ai_types.user_message_t(content = text, timestamp = time.now().ms_timestamp())
    return message
}

pub fn provider_fn(ref<provider_fixture_t> fixture): agent_types.stream_fn {
    agent_types.stream_fn result = fn(ref<ai_types.model_t> current_model, ref<ai_types.context_t> context, ref<ai_types.stream_options_t> options): ref<event_stream.assistant_stream_t> {
        fixture.lock.lock()
        ref<ai_types.assistant_message_t> response = assistant('', ai_types.STOP_ERROR, 'fixture response missing', 0, 0)
        if context.system_prompt == serialize.SUMMARIZATION_SYSTEM_PROMPT {
            fixture.summary_calls += 1
            if context.messages.len() > 0 {
                if context.messages[0] is ref<ai_types.user_message_t> prompt {
                    fixture.summary_prompts.push(prompt.content)
                }
            }
            if fixture.summary_failures > 0 {
                fixture.summary_failures -= 1
                response = assistant('', ai_types.STOP_ERROR, '503 service unavailable', 0, 0)
            } else {
                response = assistant('## Goal\ncontinue', ai_types.STOP_STOP, '', 8, 10)
            }
        } else {
            fixture.agent_calls += 1
            fixture.agent_contexts.push(context.messages.slice(0, context.messages.len()))
            response = fixture.agent_responses[fixture.agent_index]
            fixture.agent_index += 1
        }
        fixture.lock.unlock()
        var stream = event_stream.new()
        if response.stop_reason == ai_types.STOP_ERROR || response.stop_reason == ai_types.STOP_ABORTED {
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_ERROR, reason: response.stop_reason, error: response,}) catch error {}
        } else {
            stream.push(ai_types.assistant_event_t {kind: ai_types.EVENT_DONE, reason: response.stop_reason, message: response,}) catch error {}
        }
        stream.end() catch error {}
        return stream
    }
    return result
}

pub fn make_runner(ref<repository.manager_t> manager, ref<provider_fixture_t> fixture, int context_window, int reserve_tokens, int keep_recent_tokens): ref<session.runner_t>! {
    var context = new agent_types.context_t(system_prompt = 'coding agent')
    var config = new agent_types.config_t(model = model(context_window), stream_options = new ai_types.stream_options_t(api_key = 'fixture-key', max_retries = 0))
    var settings = compaction_types.settings_t {reserve_tokens: reserve_tokens, keep_recent_tokens: keep_recent_tokens,}
    return session.new(manager, context, config, provider_fn(fixture), settings)
}

// Guard against persisting test fixtures into the real user agent
// directory: every test that calls a settings-persisting runner method
// (set_model, set_thinking_level, ...) must run with ADOU_CODING_AGENT_DIR
// redirected to a throwaway directory.
fn isolate_agent_dir(): void {
    string root = path.join('/tmp', 'adou-agent-session-isolated-' + fmt.sprintf('%d', time.now().ms_timestamp()))
    syscall.set_env('ADOU_CODING_AGENT_DIR', path.join(root, 'agent')) catch error {}
}

pub fn write_settings_file(string file_path, string content): void! {
    os.mkdirs(path.dir(file_path), 0o700)
    var output = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o600)
    int written = output.write(content as [u8])
    output.close()
    assert(written == content.len())
}

pub fn prompt_error(ref<session.runner_t> runner, string text): string {
    runner.prompt(text) catch error {
        return error.msg()
    }
    return ''
}

pub fn consume(ref<session_stream.stream_t> stream): ([session_stream.event_t], [ai_types.message_t])! {
    [session_stream.event_t] events = []
    for true {
        var event = stream.recv() catch error {break}
        events.push(event)
    }
    return (events, stream.result())
}

pub fn wait_stream_result(ref<session_stream.stream_t> stream, chan<u8> completed): void! {
    var ignored = stream.result()
    completed.send(1)
}

pub fn count_kind([session_stream.event_t] events, string kind): int {
    int count = 0
    for event in events {
        if event.kind == kind {
            count += 1
        }
    }
    return count
}

pub fn last_compaction_error([session_stream.event_t] events): string {
    string result = ''
    for event in events {
        if event.kind == session_stream.EVENT_COMPACTION_END && event.error_message != '' {
            result = event.error_message
        }
    }
    return result
}

pub fn seed_history(ref<repository.manager_t> manager): void! {
    manager.append_message(user('old request with enough text to summarize'))
    ai_types.message_t old_assistant = assistant('old response with enough text to keep near the cut', ai_types.STOP_STOP, '', 20, 20)
    manager.append_message(old_assistant)
}

pub fn release_after_abort(ref<session.runner_t> runner, ref<session_stream.stream_t> stream): void! {
    for !stream.cancellation.is_aborted() {
        co.sleep(1)
    }
    runner.end_operation()
}

test 'session forwards lifecycle and persists each completed message' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('hello', ai_types.STOP_STOP, '', 2, 3)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var result = consume(runner.prompt('hi'))
    assert(fixture.agent_calls == 1 && fixture.summary_calls == 0)
    assert(manager.get_entries().len() == 2 && result[1].len() == 2)
    assert(count_kind(result[0], agent_types.EVENT_MESSAGE_END) == 2)
    assert(count_kind(result[0], session_stream.EVENT_AGENT_SETTLED) == 1)
    assert(count_kind(result[0], session_stream.EVENT_SESSION_END) == 1)
}

test 'B3 apply_preferences_snapshot applies transport, image blocking and http idle timeout' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var preferences = settings.settings_t {transport: 'websocket', block_images: true, http_idle_timeout_ms: 60000}
    runner.apply_preferences_snapshot(preferences)
    assert(runner.agent_config.stream_options.transport == 'websocket')
    assert(runner.agent_config.stream_options.timeout_ms == 60000)
    assert(runner.agent_config.stream_options.block_images)
    runner.set_runtime_transport('sse')
    runner.set_runtime_http_idle_timeout_ms(0)
    assert(runner.agent_config.stream_options.transport == 'sse')
    assert(runner.agent_config.stream_options.timeout_ms == 0)
}

test 'tool prompt forwards complete agent and session lifecycle in Pi order' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant_tool('session-call'), assistant('final answer', ai_types.STOP_STOP, '', 2, 3)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.base_context.tools.push(session_echo_tool())
    var result = consume(runner.prompt('use the tool'))
    int agent_end = -1
    int settled = -1
    int session_end = -1
    int tool_start = -1
    int tool_message_end = -1
    for index, event in result[0] {
        if event.kind == agent_types.EVENT_TOOL_START && tool_start < 0 {tool_start = index}
        if event.kind == agent_types.EVENT_MESSAGE_END && event.has_agent_event && event.agent_event.tool_message is ref<ai_types.tool_result_message_t> tool_message && tool_message_end < 0 {tool_message_end = index}
        if event.kind == agent_types.EVENT_AGENT_END && agent_end < 0 {agent_end = index}
        if event.kind == session_stream.EVENT_AGENT_SETTLED && settled < 0 {settled = index}
        if event.kind == session_stream.EVENT_SESSION_END && session_end < 0 {session_end = index}
    }
    assert(fixture.agent_calls == 2)
    assert(result[1].len() == 4 && manager.get_entries().len() == 4)
    assert(tool_start >= 0 && tool_message_end > tool_start)
    assert(agent_end >= 0 && settled > agent_end && session_end > settled)
}

test 'session snapshots tool schemas for later provider turns and validation' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant_tool('stable-schema-call'), assistant('final answer', ai_types.STOP_STOP, '', 2, 3)])
    var tool = session_echo_tool()
    var context = new agent_types.context_t(system_prompt = 'coding agent', tools = [tool,])
    var config = new agent_types.config_t(model = model(1000), stream_options = new ai_types.stream_options_t(api_key = 'fixture-key', max_retries = 0))
    var runner = session.new(manager, context, config, provider_fn(fixture), compaction_types.settings_t {reserve_tokens: 100, keep_recent_tokens: 20,})
    assert(tool.parameters_json.contains('"required":["value"]'))
    // The stable snapshot, rather than this GC-sensitive dynamic field, is
    // the source for both request construction and schema validation.
    tool.parameters = {}
    var result = consume(runner.prompt('use the cached tool schema'))
    assert(fixture.agent_calls == 2)
    assert(result[1].len() == 4)
    if result[1][2] is ref<ai_types.tool_result_message_t> tool_result {
        assert(!tool_result.is_error)
        assert(tool_result.content[0].text == 'echoed from tool')
    } else {
        assert(false)
    }
}

test 'resource refresh snapshots replacement tool schemas before the next turn' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant_tool('refreshed-schema-call'), assistant('final answer', ai_types.STOP_STOP, '', 2, 3)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var snapshot = new resource_snapshot.resource_snapshot_t()
    var replacement = session_echo_tool()
    [ref<agent_types.agent_tool_t>] replacement_tools = [replacement,]
    runner.publish_rpc_resources(snapshot, 'replacement system', replacement_tools, false)
    assert(replacement.parameters_json.contains('"required":["value"]'))
    // Simulate the TUI refresh boundary replacing built-ins after startup.
    replacement.parameters = {}
    var result = consume(runner.prompt('use the refreshed schema'))
    assert(fixture.agent_calls == 2)
    if result[1][2] is ref<ai_types.tool_result_message_t> tool_result {
        assert(!tool_result.is_error)
    } else {
        assert(false)
    }
}

test 'sequential prompts can start after the previous session_end' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('first answer', ai_types.STOP_STOP, '', 1, 2), assistant('second answer', ai_types.STOP_STOP, '', 1, 2)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var first = consume(runner.prompt('first'))
    var second = consume(runner.prompt('second'))
    assert(fixture.agent_calls == 2)
    assert(second[1].len() == 4)
    assert(second[1][2] is ref<ai_types.user_message_t>)
    var submitted = second[1][2] as ref<ai_types.user_message_t>
    assert(submitted.content == 'second')
}

test 'prompt accepts an empty message like Pi' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('empty prompt answer', ai_types.STOP_STOP, '', 1, 2)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var result = consume(runner.prompt(''))
    assert(fixture.agent_calls == 1)
    assert(result[1].len() == 2)
    assert(result[1][0] is ref<ai_types.user_message_t>)
    var submitted = result[1][0] as ref<ai_types.user_message_t>
    assert(submitted.content == '')
}

test 'busy prompt reports the Pi queue guidance' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('busy answer', ai_types.STOP_STOP, '', 1, 2)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.begin_operation()
    string message = prompt_error(runner, 'second prompt')
    assert(message == "Agent is already processing. Specify streamingBehavior ('steer' or 'followUp') to queue the message.")
    runner.end_operation()
}

test 'B1-R3-04 replace_repository leaves preferences untouched; the boundary applies trust-aware snapshots' {
    string root = '/tmp/adou-session-project-settings-test'
    os.rmdir(root, true) catch error {}
    string previous_agent_dir = syscall.get_env('ADOU_CODING_AGENT_DIR')
    syscall.set_env('ADOU_CODING_AGENT_DIR', path.join(root, 'agent'))
    write_settings_file(path.join(root, 'agent/settings.json'), '{"autoCompaction":false,"steeringMode":"one-at-a-time","followUpMode":"one-at-a-time","retryEnabled":true,"retryMaxAttempts":8,"retryBaseDelayMs":4000}')
    string project = path.join(root, 'project')
    write_settings_file(path.join(project, '.adou/settings.json'), '{"autoCompaction":true,"steeringMode":"all","followUpMode":"all","retryEnabled":false,"retryMaxAttempts":2,"retryBaseDelayMs":17}')
    var manager = repository.in_memory('/tmp/adou-session-old-project')
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    string steering_before = runner.agent_config.queues.steering_mode
    string follow_before = runner.agent_config.queues.follow_up_mode
    bool compaction_before = runner.compaction_settings.enabled
    bool retry_before = runner.retry_enabled
    int retry_max_before = runner.retry_max_attempts
    int retry_delay_before = runner.retry_base_delay_ms
    // Core must NOT read project settings: replacing the repository never
    // mutates queue/compaction/retry preferences (R3-04) — the caller
    // decides trust at the rebind boundary.
    var next = repository.in_memory(project)
    runner.replace_repository(next)
    assert(runner.agent_config.queues.steering_mode == steering_before)
    assert(runner.agent_config.queues.follow_up_mode == follow_before)
    assert(runner.compaction_settings.enabled == compaction_before)
    assert(runner.retry_enabled == retry_before)
    assert(runner.retry_max_attempts == retry_max_before)
    assert(runner.retry_base_delay_ms == retry_delay_before)
    // Trusted boundary: global + project merged snapshot applies the
    // project's queue/compaction/retry policy.
    var trusted = settings.load_trusted_for(project, true)
    runner.apply_preferences_snapshot(trusted)
    assert(runner.agent_config.queues.steering_mode == 'all' && runner.agent_config.queues.follow_up_mode == 'all')
    assert(runner.compaction_settings.enabled && !runner.retry_enabled)
    assert(runner.retry_max_attempts == 2 && runner.retry_base_delay_ms == 17)
    // Untrusted boundary: the global-only snapshot must never leak the
    // project's values.
    var untrusted = settings.load_trusted_for(project, false)
    runner.apply_preferences_snapshot(untrusted)
    assert(runner.agent_config.queues.steering_mode == 'one-at-a-time' && runner.agent_config.queues.follow_up_mode == 'one-at-a-time')
    assert(!runner.compaction_settings.enabled && runner.retry_enabled)
    assert(runner.retry_max_attempts == 8 && runner.retry_base_delay_ms == 4000)
    syscall.set_env('ADOU_CODING_AGENT_DIR', previous_agent_dir)
    os.rmdir(root, true)
}

test 'prompt rejects missing authentication before starting an operation' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('should not run', ai_types.STOP_STOP, '', 1, 1)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.agent_config.stream_options.api_key = ''
    string message = prompt_error(runner, 'missing credentials')
    assert(message.starts_with('No API key found for mock.'))
    assert(message.contains('Use /login to log into a provider via OAuth or API key.'))
    assert(!runner.busy && fixture.agent_calls == 0 && runner.active_messages.len() == 0)
}

test 'non-retryable provider errors settle without a secondary repository decode failure' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ERROR, '401 unauthorized', 0, 0)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    runner.retry_enabled = false
    var result = consume(runner.prompt('surface the provider error'))
    assert(fixture.agent_calls == 1)
    assert(count_kind(result[0], session_stream.EVENT_AGENT_SETTLED) == 1)
    assert(result[1].len() == 2)
    if result[1][1] is ref<ai_types.assistant_message_t> failed {
        assert(failed.stop_reason == ai_types.STOP_ERROR)
        assert(failed.error_message == '401 unauthorized')
    } else {
        assert(false)
    }
}

test 'threshold compaction runs after a successful turn without retrying' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('a response long enough to create a split cut point', ai_types.STOP_STOP, '', 90, 90)])
    var runner = make_runner(manager, fixture, 100, 20, 5)
    var result = consume(runner.prompt('hello threshold'))
    assert(fixture.agent_calls == 1 && fixture.summary_calls == 1)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_START) == 1)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_END) == 1)
    assert(manager.latest_compaction() is ref<session_types.entry_t>)
}

test 'overflow compacts and retries once without the saved error in active context' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ERROR, 'prompt is too long', 0, 0), assistant('recovered', ai_types.STOP_STOP, '', 5, 6)])
    var runner = make_runner(manager, fixture, 100, 0, 5)
    var result = consume(runner.prompt('new prompt'))
    assert(fixture.agent_calls == 2 && fixture.summary_calls == 1)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_START) == 1)
    assert(fixture.agent_contexts[1].len() > 0)
    var retry_tail = fixture.agent_contexts[1][fixture.agent_contexts[1].len() - 1]
    assert(retry_tail is ref<ai_types.user_message_t>)
    var final_tail = result[1][result[1].len() - 1]
    assert(final_tail is ref<ai_types.assistant_message_t>)
    var final_message = final_tail as ref<ai_types.assistant_message_t>
    assert(final_message.stop_reason == ai_types.STOP_STOP)
}

test 'a second overflow emits the Pi recovery error and never compacts twice' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ERROR, 'prompt is too long', 0, 0), assistant('', ai_types.STOP_ERROR, 'maximum context length', 0, 0)])
    var runner = make_runner(manager, fixture, 100, 0, 5)
    var result = consume(runner.prompt('retry only once'))
    assert(fixture.agent_calls == 2 && fixture.summary_calls == 1)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_START) == 1)
    assert(last_compaction_error(result[0]) == 'Context overflow recovery failed after one compact-and-retry attempt. Try reducing context or switching to a larger-context model.')
}

test 'successful over-window response compacts but is not retried' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    var fixture = new provider_fixture_t(agent_responses = [assistant('completed answer', ai_types.STOP_STOP, '', 101, 101)])
    var runner = make_runner(manager, fixture, 100, 0, 5)
    var result = consume(runner.prompt('large but successful'))
    assert(fixture.agent_calls == 1 && fixture.summary_calls == 1)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_START) == 1)
}

test 'aborted response never triggers compaction' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ABORTED, 'cancelled', 1000, 1000)])
    var runner = make_runner(manager, fixture, 100, 20, 5)
    var result = consume(runner.prompt('cancel'))
    assert(fixture.agent_calls == 1 && fixture.summary_calls == 0)
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_START) == 0)
}

test 'next prompt compacts an over-window aborted response before sending' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ABORTED, 'cancelled', 1000, 1000), assistant('next answer', ai_types.STOP_STOP, '', 5, 6)])
    var runner = make_runner(manager, fixture, 100, 20, 5)
    var first = consume(runner.prompt('cancel first'))
    assert(fixture.agent_calls == 1 && fixture.summary_calls == 0)
    var second = consume(runner.prompt('continue after cancel'))
    assert(fixture.agent_calls == 2 && fixture.summary_calls == 1)
    int first_compaction = -1
    int first_agent_start = -1
    for index, event in second[0] {
        if event.kind == session_stream.EVENT_COMPACTION_START && first_compaction < 0 {first_compaction = index}
        if event.kind == agent_types.EVENT_AGENT_START && first_agent_start < 0 {first_agent_start = index}
    }
    assert(first_compaction >= 0 && first_agent_start >= 0 && first_compaction < first_agent_start)
}

test 'abort and wait returns only after the session operation is idle' {
    var manager = repository.in_memory('/tmp')
    var fixture = new provider_fixture_t(agent_responses = [assistant('', ai_types.STOP_ABORTED, 'cancelled', 0, 0)])
    var runner = make_runner(manager, fixture, 1000, 100, 20)
    var stream = runner.prompt('cancel from rpc')
    runner.abort_and_wait()
    assert(!runner.busy)
    var result = consume(stream)
    assert(count_kind(result[0], session_stream.EVENT_SESSION_END) == 1)
}

test 'manual compaction uses the shared path and forwards custom instructions' {
    var manager = repository.in_memory('/tmp')
    seed_history(manager)
    manager.append_message(user('recent request'))
    var fixture = new provider_fixture_t()
    var runner = make_runner(manager, fixture, 100, 0, 2)
    var result = consume(runner.compact_now('preserve exact filenames'))
    assert(fixture.agent_calls == 0 && fixture.summary_calls == 1)
    assert(fixture.summary_prompts[0].contains('Additional focus: preserve exact filenames'))
    assert(count_kind(result[0], session_stream.EVENT_COMPACTION_START) == 1)
    assert(manager.latest_compaction() is ref<session_types.entry_t>)
}

