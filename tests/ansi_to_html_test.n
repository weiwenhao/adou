import adou.src.session.ansi_to_html

test 'plain text passes through escaped like Pi' {
    assert(ansi_to_html.ansi_to_html('hello & <world>') == 'hello &amp; &lt;world&gt;')
}

test 'basic colors wrap in spans like Pi' {
    string html = ansi_to_html.ansi_to_html('\x1b[31mred\x1b[0m')
    assert(html == '<span style="color:#800000">red</span>')
}

test 'styles compose in one span like Pi' {
    string html = ansi_to_html.ansi_to_html('\x1b[1;3;32mbold italic green\x1b[0m')
    assert(html.find('font-weight:bold') >= 0)
    assert(html.find('font-style:italic') >= 0)
    assert(html.find('color:#008000') >= 0)
}

test '256-color and true color sequences like Pi' {
    assert(ansi_to_html.color256_to_hex(196) == '#ff0000')
    assert(ansi_to_html.color256_to_hex(0) == '#000000')
    string html = ansi_to_html.ansi_to_html('\x1b[38;5;196mX\x1b[0m')
    assert(html == '<span style="color:#ff0000">X</span>')
    string rgb = ansi_to_html.ansi_to_html('\x1b[38;2;10;20;30mY\x1b[0m')
    assert(rgb.find('color:rgb(10,20,30)') >= 0)
}

test 'backgrounds and bright colors like Pi' {
    string html = ansi_to_html.ansi_to_html('\x1b[44;97mX\x1b[0m')
    assert(html.find('background-color:#000080') >= 0)
    assert(html.find('color:#ffffff') >= 0)
}

test 'ansi_lines_to_html wraps every line like Pi' {
    [string] lines = ['a', '\x1b[31mb\x1b[0m', '']
    string html = ansi_to_html.ansi_lines_to_html(lines)
    assert(html.find('<div class="ansi-line">a</div>') >= 0)
    assert(html.find('<div class="ansi-line">&nbsp;</div>') >= 0)
    assert(html.find('<div class="ansi-line"><span style="color:#800000">b</span></div>') >= 0)
}

test 'unterminated escapes keep the remaining text like Pi' {
    string html = ansi_to_html.ansi_to_html('before \x1b[31')
    assert(html == 'before \x1b[31')
    string escaped = ansi_to_html.ansi_to_html('raw \x1b[31mtext')
    assert(escaped.find('color:#800000') >= 0)
    assert(escaped.find('text') >= 0)
}
