import adou.src.tui.components
import adou.src.tui.markdown
import adou.src.tui.text_utils
import strings

test 'container text spacer box and truncation stay within width' {
    var root = components.container()
    root.add(components.text('hello 界 world', 1, 0))
    root.add(components.spacer(1))
    var box = components.box(1, 1)
    box.add(components.truncated_text('abcdefghijklmnopqrstuvwxyz', 0, 0))
    root.add(box)
    var lines = root.render(12)
    assert(lines.len() >= 5)
    for line in lines {
        assert(text_utils.visible_width(line) <= 12)
    }
}

test 'loaders animate and cancellable loader records abort state' {
    var loading = components.loader('Working...')
    var first = loading.render(20)
    loading.tick()
    var second = loading.render(20)
    assert(first[1] != second[1])
    var cancellable = components.cancellable_loader('Request')
    cancellable.cancel()
    var cancelled = cancellable.render(30)
    assert(cancelled[1].contains('(cancelled)'))
}

test 'markdown covers chat heading list quote code emphasis and links' {
    string source = '# Head\n- **bold** and *italic*\n> quote\n`code` [site](https://example.com)\n```n\nlet x = 1\n```'
    var lines = markdown.render(source, 40)
    assert(lines.len() >= 6)
    assert(lines[0].contains('\x1b[1m') && lines[1].contains('- '))
    assert(lines[2].contains('│') && lines[3].contains('\x1b[7m'))
    assert(lines[3].contains('\x1b]8;;https://example.com'))
    for line in lines {
        assert(text_utils.visible_width(line) <= 40)
    }
}

test 'markdown handles nested markers, strike, rules, and fenced borders' {
    string source = '## Title\n  - nested **bold** and ~~removed~~\n_italic_\n---\n~~~nature\nlet x = 1\n~~~'
    var lines = markdown.render(source, 32)
    bool has_strike = false
    bool has_rule = false
    bool has_fence = false
    for line in lines {
        has_strike = has_strike || line.contains('\x1b[9m')
        has_rule = has_rule || line.contains('───')
        has_fence = has_fence || line.contains('~~~')
        assert(text_utils.visible_width(line) <= 32)
    }
    assert(has_strike && has_rule && has_fence)
}

test 'markdown tables render aligned columns with a bold header' {
    string source = '| Name | Value |\n|------|-------|\n| alpha | 1 |\n| beta gamma | 22 |'
    var lines = markdown.render(source, 40)
    assert(lines.len() >= 3)
    assert(lines[0].contains('│') && lines[0].contains('\x1b[1m'))
    assert(lines[1].contains('├') && lines[1].contains('┼'))
    for line in lines {
        assert(text_utils.visible_width(line) <= 40)
    }
    // Body cells align under the header columns.
    assert(lines[2].contains('alpha') && lines[2].contains('1'))
    assert(lines[3].contains('beta gamma'))
}

test 'nested blockquotes render one gutter per depth' {
    string source = '> outer\n>> inner quote'
    var lines = markdown.render(source, 40)
    assert(lines[0].contains('│'))
    assert(lines[1].contains('│ │') || lines[1].contains('│  │'))
    assert(lines[1].contains('inner quote'))
}

test 'narrow tables shrink to the terminal width' {
    string source = '| Long Header Column | Other |\n|-------------------|-------|\n| value | x |'
    var lines = markdown.render(source, 24)
    for line in lines {
        assert(text_utils.visible_width(line) <= 24)
    }
}

test 'intraword underscores stay literal while flanking emphasis still works' {
    // CommonMark: foo_bar_baz and PARITY_TOOL_OK keep their underscores;
    // _italic_ and __bold__ still render as emphasis.
    var literal = markdown.render('foo_bar_baz and PARITY_TOOL_OK', 80)
    string joined = strings.join(literal, '\n')
    assert(joined.contains('foo_bar_baz'))
    assert(joined.contains('PARITY_TOOL_OK'))
    // No italic ANSI (ESC 'm' with 3=italic) must wrap "bar".
    assert(!joined.contains('\x1b[3mbar\x1b[23m'))

    var emphasis = markdown.render('_italic_ and __bold__', 80)
    string em = strings.join(emphasis, '\n')
    assert(em.contains('\x1b[3mitalic\x1b[23m'))
    assert(em.contains('\x1b[1mbold\x1b[22m'))

    // _x_ delimiters at word edges still work.
    var edge = markdown.render('start _mid_ end', 80)
    string edge_joined = strings.join(edge, '\n')
    assert(edge_joined.contains('\x1b[3mmid\x1b[23m'))
}
