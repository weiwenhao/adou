import adou.src.ai.types as ai_types
import adou.src.session.jsonl
import adou.src.session.repository
import adou.src.session.types
import co
import fs
import json
import os
import syscall

fn append_worker(ref<repository.manager_t> session, string content, chan<int> done): void! {
    ai_types.message_t message = new ai_types.user_message_t(content = content, timestamp = 100)
    session.append_message(message)
    done.send(1)
}

fn text_of(ai_types.message_t message): string {
    if message is ref<ai_types.user_message_t> user {
        return user.content
    }
    if message is ref<ai_types.assistant_message_t> assistant {
        if assistant.content.len() > 0 && assistant.content[0] is ref<ai_types.text_content_t> text {
            return text.text
        }
    }
    if message is ref<ai_types.compaction_summary_message_t> summary {
        return types.COMPACTION_SUMMARY_PREFIX + summary.summary + types.COMPACTION_SUMMARY_SUFFIX
    }
    if message is ref<ai_types.branch_summary_message_t> summary {
        return types.BRANCH_SUMMARY_PREFIX + summary.summary + types.BRANCH_SUMMARY_SUFFIX
    }
    if message is ref<ai_types.bash_execution_message_t> bash {
        return ai_types.bash_execution_text(bash)
    }
    return ''
}

fn append_bytes(string file_path, string content): void! {
    var file = fs.open(file_path, syscall.O_WRONLY | syscall.O_APPEND, 0)
    file.write(content as [u8])
    file.close()
}

fn replace_header_timestamp(string file_path, string old_value, string new_value): void! {
    var input = fs.open(file_path, syscall.O_RDONLY, 0)
    string content = input.content()
    input.close()
    content = content.replace(old_value, new_value)
    var output = fs.open(file_path, syscall.O_WRONLY | syscall.O_TRUNC, 0)
    output.write(content as [u8])
    output.close()
}

fn write_bytes(string file_path, string content): void! {
    var output = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o600)
    output.write(content as [u8])
    output.close()
}

test 'v1 sessions migrate tree ids and compaction references to v3' {
    string root = '/tmp/adou-session-test-migrate-v1'
    os.rmdir(root, true) catch error {}
    os.mkdirs(root, 0o700)
    string file_path = root + '/legacy.jsonl'
    string content = '{"type":"session","id":"legacy-v1","timestamp":"2025-01-01T00:00:00.000Z","cwd":"' + root + '"}\n'
    content += '{"type":"message","timestamp":"2025-01-01T00:00:01.000Z","message":{"role":"user","content":"old","timestamp":1}}\n'
    content += '{"type":"message","timestamp":"2025-01-01T00:00:02.000Z","message":{"role":"user","content":"keep","timestamp":2}}\n'
    content += '{"type":"compaction","timestamp":"2025-01-01T00:00:03.000Z","summary":"legacy summary","firstKeptEntryIndex":2,"tokensBefore":100}\n'
    content += '{"type":"message","timestamp":"2025-01-01T00:00:04.000Z","message":{"role":"user","content":"after","timestamp":4}}\n'
    write_bytes(file_path, content)
    var migrated = repository.open(file_path)
    assert(migrated.header.version == types.CURRENT_VERSION)
    assert(migrated.get_warnings().len() == 1)
    assert(migrated.get_warnings()[0].contains('v1 to v3'))
    var entries = migrated.get_entries()
    assert(entries.len() == 4)
    assert(!entries[0].has_parent)
    assert(entries[1].has_parent && entries[1].parent_id == entries[0].id)
    var compact = entries[2].raw.as_object()
    assert(!compact.contains('firstKeptEntryIndex'))
    assert(compact['firstKeptEntryId'].as_string() == entries[1].id)
    var context = migrated.build_context()
    assert(context.messages.len() == 3)
    assert(text_of(context.messages[0]).contains('legacy summary'))
    assert(text_of(context.messages[1]) == 'keep')
    assert(text_of(context.messages[2]) == 'after')
    var reopened = repository.open(file_path)
    assert(reopened.header.version == types.CURRENT_VERSION)
    assert(reopened.get_warnings().len() == 0)
    os.rmdir(root, true)
}

test 'v2 hook messages migrate to custom messages and remain in context' {
    string root = '/tmp/adou-session-test-migrate-v2'
    os.rmdir(root, true) catch error {}
    os.mkdirs(root, 0o700)
    string file_path = root + '/legacy.jsonl'
    string content = '{"type":"session","version":2,"id":"legacy-v2","timestamp":"2025-01-01T00:00:00.000Z","cwd":"' + root + '"}\n'
    content += '{"type":"message","id":"custom01","parentId":null,"timestamp":"2025-01-01T00:00:01.000Z","message":{"role":"hookMessage","customType":"legacy-hook","content":"injected context","display":true,"details":{"ok":true},"timestamp":1}}\n'
    write_bytes(file_path, content)
    var migrated = repository.open(file_path)
    var context = migrated.build_context()
    assert(context.messages.len() == 1)
    var custom = context.messages[0] as ref<ai_types.custom_message_t>
    assert(custom.custom_type == 'legacy-hook')
    assert(custom.content == 'injected context')
    assert(custom.display)
    var reopened = repository.open(file_path)
    assert(reopened.get_warnings().len() == 0)
    assert(reopened.build_context().messages.len() == 1)
    os.rmdir(root, true)
}

test 'Pi v3 session persists messages and rebuilds context' {
    string root = '/tmp/adou-session-test-basic'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    ai_types.message_t user = new ai_types.user_message_t(content = 'hello', timestamp = 100)
    session.append_message(user)
    ai_types.content_t block = new ai_types.text_content_t(text = 'world')
    ai_types.message_t assistant = new ai_types.assistant_message_t(content = [block], api = 'openai-responses', provider = 'openai', model = 'gpt-test', stop_reason = ai_types.STOP_STOP, timestamp = 200)
    session.append_message(assistant)
    var reopened = repository.open(session.get_session_file())
    var context = reopened.build_context()
    assert(context.messages.len() == 2)
    assert(text_of(context.messages[0]) == 'hello')
    assert(text_of(context.messages[1]) == 'world')
    assert(context.has_model && context.provider == 'openai' && context.model_id == 'gpt-test')
    os.rmdir(root, true)
}

test 'usage totals include compacted history and summary entries' {
    string root = '/tmp/adou-session-test-usage-totals'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string first_id = session.append_message(new ai_types.user_message_t(content = 'old', timestamp = 1))
    ai_types.usage_t assistant_usage = ai_types.usage_t{}
    assistant_usage.input = 100
    assistant_usage.output = 40
    assistant_usage.cache_read = 20
    assistant_usage.cost.total = 0.125
    session.append_message(new ai_types.assistant_message_t(usage = assistant_usage, timestamp = 2))
    ai_types.usage_t tool_usage = ai_types.usage_t{}
    tool_usage.input = 7
    tool_usage.output = 3
    tool_usage.cost.total = 0.010
    session.append_message(new ai_types.tool_result_message_t(tool_call_id = 'call-1', tool_name = 'read', usage = tool_usage, timestamp = 3))
    ai_types.usage_t compaction_usage = ai_types.usage_t{}
    compaction_usage.input = 11
    compaction_usage.output = 5
    compaction_usage.cost.total = 0.020
    session.append_compaction('summary', first_id, 200, json.null_value(), compaction_usage)
    ai_types.usage_t branch_usage = ai_types.usage_t{}
    branch_usage.input = 13
    branch_usage.output = 6
    branch_usage.cost.total = 0.030
    session.append_branch_summary('root', 'branch', json.null_value(), branch_usage)
    var totals = session.usage_totals()
    assert(totals.input == 131)
    assert(totals.output == 54)
    assert(totals.cache_read == 20)
    assert(totals.cost.total > 0.184 && totals.cost.total < 0.186)
    os.rmdir(root, true)
}

test 'bash execution messages round-trip and preserve context exclusion' {
    string root = '/tmp/adou-session-test-bash'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    ai_types.message_t included = new ai_types.bash_execution_message_t(command = 'pwd', output = '/tmp/project', exit_code = 0, timestamp = 100)
    ai_types.message_t excluded = new ai_types.bash_execution_message_t(command = 'env', output = 'SECRET=value', exit_code = 0, exclude_from_context = true, timestamp = 200)
    session.append_message(included)
    session.append_message(excluded)
    var reopened = repository.open(session.get_session_file())
    var context = reopened.build_context()
    assert(context.messages.len() == 2)
    assert(text_of(context.messages[0]).contains('Ran `pwd`'))
    var hidden = context.messages[1] as ref<ai_types.bash_execution_message_t>
    assert(hidden.exclude_from_context)
    os.rmdir(root, true)
}

test 'session context follows the selected parentId branch' {
    string root = '/tmp/adou-session-test-tree'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string root_id = session.append_message(new ai_types.user_message_t(content = 'root', timestamp = 1))
    string left_id = session.append_message(new ai_types.user_message_t(content = 'left', timestamp = 2))
    session.set_leaf(root_id)
    string right_id = session.append_message(new ai_types.user_message_t(content = 'right', timestamp = 3))
    session.set_leaf(left_id)
    var left_context = session.build_context()
    assert(left_context.messages.len() == 2)
    assert(text_of(left_context.messages[1]) == 'left')
    session.set_leaf(right_id)
    var right_context = session.build_context()
    assert(right_context.messages.len() == 2)
    assert(text_of(right_context.messages[1]) == 'right')
    os.rmdir(root, true)
}

test 'clone_active creates a Pi-compatible child session at the selected leaf' {
    string root = '/tmp/adou-session-test-clone'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string root_id = session.append_message(new ai_types.user_message_t(content = 'root', timestamp = 1))
    string left_id = session.append_message(new ai_types.user_message_t(content = 'left', timestamp = 2))
    session.set_leaf(root_id)
    session.append_message(new ai_types.user_message_t(content = 'right', timestamp = 3))
    session.set_leaf(left_id)
    var child = session.clone_active()
    assert(child.header.parent_session == session.get_session_file())
    assert(child.build_context().messages.len() == 2)
    assert(text_of(child.build_context().messages[1]) == 'left')
    os.rmdir(root, true)
}

test 'CLI fork copies complete history into target directory with requested id' {
    string source_root = '/tmp/adou-session-test-cli-fork-source'
    string target_root = '/tmp/adou-session-test-cli-fork-target'
    os.rmdir(source_root, true) catch error {}
    os.rmdir(target_root, true) catch error {}
    var session = repository.create(source_root, source_root + '/sessions')
    string first_id = session.append_message(new ai_types.user_message_t(content = 'first', timestamp = 1))
    session.append_message(new ai_types.user_message_t(content = 'second', timestamp = 2))
    session.set_leaf(first_id)
    session.append_message(new ai_types.user_message_t(content = 'branch', timestamp = 3))
    int source_entries = session.get_entries().len()
    string source_file = session.get_session_file()
    var child = session.fork_to(target_root, target_root + '/sessions', 'cli-fork')
    assert(child.header.id == 'cli-fork')
    assert(child.header.cwd == target_root)
    assert(child.header.parent_session == source_file)
    assert(child.get_session_file().starts_with(target_root + '/sessions/'))
    assert(child.get_entries().len() == source_entries)
    assert(child.build_context().messages.len() == 2)
    os.rmdir(source_root, true)
    os.rmdir(target_root, true)
}

test 'fork_before creates a new child session before the selected user message' {
    string root = '/tmp/adou-session-test-fork'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string first_id = session.append_message(new ai_types.user_message_t(content = 'first', timestamp = 1))
    string selected_id = session.append_message(new ai_types.user_message_t(content = 'edit me', timestamp = 2))
    session.append_message(new ai_types.user_message_t(content = 'later', timestamp = 3))
    string source_file = session.get_session_file()
    var child = session.fork_before(selected_id)
    assert(child.get_session_file() != source_file)
    assert(child.header.parent_session == source_file)
    assert(child.get_leaf_id() == first_id)
    assert(child.build_context().messages.len() == 1)
    assert(text_of(child.build_context().messages[0]) == 'first')
    assert(session.build_context().messages.len() == 3)
    os.rmdir(root, true)
}

test 'fork_before the first user message creates an empty child session' {
    string root = '/tmp/adou-session-test-fork-root'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string selected_id = session.append_message(new ai_types.user_message_t(content = 'edit me', timestamp = 1))
    var child = session.fork_before(selected_id)
    assert(child.header.parent_session == session.get_session_file())
    assert(child.get_entries().len() == 0)
    assert(child.build_context().messages.len() == 0)
    os.rmdir(root, true)
}

