test 'branch summary entries participate in Pi context and survive reopen' {
    string root = '/tmp/adou-session-test-branch-summary'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string root_id = session.append_message(new ai_types.user_message_t(content = 'start', timestamp = 1))
    string abandoned_id = session.append_message(new ai_types.user_message_t(content = 'abandoned', timestamp = 2))
    session.set_leaf(root_id)
    session.append_branch_summary(abandoned_id, 'Tried the abandoned approach', json.null_value(), ai_types.usage_t{})
    session.append_message(new ai_types.user_message_t(content = 'new direction', timestamp = 3))
    var reopened = repository.open(session.get_session_file())
    var context = reopened.build_context()
    assert(context.messages.len() == 3)
    assert(text_of(context.messages[1]) == types.BRANCH_SUMMARY_PREFIX + 'Tried the abandoned approach' + types.BRANCH_SUMMARY_SUFFIX)
    assert(text_of(context.messages[2]) == 'new direction')
    os.rmdir(root, true)
}

test 'labels are append-only metadata and the latest change wins after reopen' {
    string root = '/tmp/adou-session-test-label'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string message_id = session.append_message(new ai_types.user_message_t(content = 'checkpoint', timestamp = 1))
    session.append_label_change(message_id, 'first')
    session.append_label_change(message_id, 'important')
    var reopened = repository.open(session.get_session_file())
    assert(reopened.get_label(message_id) == 'important')
    assert(reopened.get_label_timestamp(message_id) != '')
    reopened.append_label_change(message_id, '')
    assert(reopened.get_label(message_id) == '')
    assert(reopened.build_context().messages.len() == 1)
    os.rmdir(root, true)
}

test 'clone_active preserves effective labels and rechains removed label entries' {
    string root = '/tmp/adou-session-test-label-clone'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    string first_id = session.append_message(new ai_types.user_message_t(content = 'first', timestamp = 1))
    session.append_label_change(first_id, 'start')
    string second_id = session.append_message(new ai_types.user_message_t(content = 'second', timestamp = 2))
    session.append_label_change(second_id, 'end')
    var child = session.clone_active()
    assert(child.get_label(first_id) == 'start')
    assert(child.get_label(second_id) == 'end')
    assert(child.build_context().messages.len() == 2)
    ref<types.entry_t>? second = null
    int labels = 0
    for entry in child.get_entries() {
        if entry.id == second_id {second = entry}
        if entry.kind == types.ENTRY_LABEL {labels += 1}
    }
    assert(second is ref<types.entry_t>)
    var second_entry = second as ref<types.entry_t>
    assert(second_entry.has_parent && second_entry.parent_id == first_id)
    assert(labels == 2)
    os.rmdir(root, true)
}

test 'compaction preserves JSONL history and rebuilds summary plus kept tail' {
    string root = '/tmp/adou-session-test-compaction'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    ai_types.message_t first = new ai_types.user_message_t(content = 'old', timestamp = 100)
    session.append_message(first)
    ai_types.message_t kept = new ai_types.user_message_t(content = 'keep', timestamp = 200)
    string kept_id = session.append_message(kept)
    int before = session.get_entries().len()
    session.append_compaction('summary text', kept_id, 1234, json.null_value(), ai_types.usage_t{})
    ai_types.message_t after = new ai_types.user_message_t(content = 'after', timestamp = 300)
    session.append_message(after)
    assert(session.get_entries().len() == before + 2)
    var context = session.build_context()
    assert(context.messages.len() == 3)
    assert(text_of(context.messages[0]).contains('<summary>\nsummary text\n</summary>'))
    assert(text_of(context.messages[1]) == 'keep')
    assert(text_of(context.messages[2]) == 'after')
    var loaded = jsonl.load(session.get_session_file())
    assert(loaded.entries.len() == 4)
    os.rmdir(root, true)
}

test 'incomplete trailing JSONL record is reported and future appends stay parseable' {
    string root = '/tmp/adou-session-test-recovery'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    ai_types.message_t first = new ai_types.user_message_t(content = 'one', timestamp = 100)
    session.append_message(first)
    string file_path = session.get_session_file()
    append_bytes(file_path, '{"type":"message"')
    var recovered = repository.open(file_path)
    assert(recovered.get_warnings().len() == 1)
    ai_types.message_t second = new ai_types.user_message_t(content = 'two', timestamp = 200)
    recovered.append_message(second)
    var loaded = repository.open(file_path)
    var context = loaded.build_context()
    assert(context.messages.len() == 2)
    assert(text_of(context.messages[1]) == 'two')
    os.rmdir(root, true)
}

test 'unknown v3 entries remain in the append-only log and do not break known context' {
    string root = '/tmp/adou-session-test-unknown'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    ai_types.message_t first = new ai_types.user_message_t(content = 'one', timestamp = 100)
    string first_id = session.append_message(first)
    append_bytes(session.get_session_file(), '{"type":"future_entry","id":"future01","parentId":"' + first_id + '","timestamp":"2026-07-30T00:00:00.000Z","payload":{"keep":true}}\n')
    var reopened = repository.open(session.get_session_file())
    assert(reopened.get_entries().len() == 2)
    ai_types.message_t second = new ai_types.user_message_t(content = 'two', timestamp = 200)
    reopened.append_message(second)
    var final_session = repository.open(session.get_session_file())
    assert(final_session.get_entries().len() == 3)
    assert(final_session.get_entries()[1].kind == 'future_entry')
    var context = final_session.build_context()
    assert(context.messages.len() == 2 && text_of(context.messages[1]) == 'two')
    os.rmdir(root, true)
}

test 'session file is private and concurrent records never interleave' {
    string root = '/tmp/adou-session-test-concurrent'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    var stat = syscall.stat(session.get_session_file())
    assert((stat.mode & 0o777) == 0o600)
    chan<int> done = chan<int>.new(2)
    go append_worker(session, 'first', done)
    go append_worker(session, 'second', done)
    done.recv()
    done.recv()
    var reopened = repository.open(session.get_session_file())
    assert(reopened.get_entries().len() == 2)
    assert(reopened.get_warnings().len() == 0)
    os.rmdir(root, true)
}

test 'continue recent selects the newest session for the same cwd' {
    string root = '/tmp/adou-session-test-recent'
    os.rmdir(root, true) catch error {}
    var first = repository.create(root, root + '/sessions')
    ai_types.message_t message = new ai_types.user_message_t(content = 'saved', timestamp = 100)
    first.append_message(message)
    var recent = repository.continue_recent(root, root + '/sessions')
    assert(recent.get_session_id() == first.get_session_id())
    assert(recent.build_context().messages.len() == 1)
    os.rmdir(root, true)
}

test 'session id lookup opens an exact or unique prefixed Pi session id' {
    string root = '/tmp/adou-session-test-id'
    os.rmdir(root, true) catch error {}
    var created = repository.create(root, root + '/sessions')
    string id = created.get_session_id()
    created.append_message(new ai_types.user_message_t(content = 'by id', timestamp = 100))
    var exact = repository.open_by_id(root, root + '/sessions', id)
    assert(exact.get_session_id() == id && exact.build_context().messages.len() == 1)
    string prefix = id.slice(0, 8)
    var partial = repository.open_by_id(root, root + '/sessions', prefix)
    assert(partial.get_session_id() == id)
    os.rmdir(root, true)
}

test 'session context distinguishes an explicit off thinking change from an absent one' {
    string root = '/tmp/adou-session-test-thinking-presence'
    os.rmdir(root, true) catch error {}
    var session = repository.create(root, root + '/sessions')
    ai_types.message_t message = new ai_types.user_message_t(content = 'hello', timestamp = 100)
    session.append_message(message)
    var absent = session.build_context()
    assert(!absent.has_thinking_level && absent.thinking_level == 'off')
    session.append_thinking_change('off')
    var explicit = session.build_context()
    assert(explicit.has_thinking_level && explicit.thinking_level == 'off')
    os.rmdir(root, true)
}

test 'import copies an external Pi session into the active session directory' {
    string root = '/tmp/adou-session-test-import'
    os.rmdir(root, true) catch error {}
    string source_root = root + '/source'
    string target_root = root + '/target'
    var source = repository.create(source_root, source_root + '/sessions')
    source.append_message(new ai_types.user_message_t(content = 'import me', timestamp = 100))
    var target = repository.create(target_root, target_root + '/sessions')
    var imported = target.import_file(source.get_session_file())
    assert(imported.get_session_file() != source.get_session_file())
    assert(imported.get_session_file().starts_with(target_root + '/sessions/'))
    assert(imported.build_context().messages.len() == 1)
    assert(text_of(imported.build_context().messages[0]) == 'import me')
    os.rmdir(root, true)
}

test 'explicit session paths and ids follow Pi create-or-open semantics' {
    string root = '/tmp/adou-session-test-explicit'
    os.rmdir(root, true) catch error {}
    string explicit_path = root + '/nested/explicit.jsonl'
    var by_path = repository.open_or_create(explicit_path, root)
    assert(by_path.persisted && by_path.get_session_file() == explicit_path)
    string first_id = by_path.get_session_id()
    var reopened = repository.open_or_create(explicit_path, root)
    assert(reopened.get_session_id() == first_id)
    var by_id = repository.open_by_id_or_create(root, root + '/sessions', 'fixed-session')
    assert(by_id.get_session_id() == 'fixed-session')
    var by_prefix = repository.open_reference(root, root + '/sessions', 'fixed-ses')
    assert(by_prefix.get_session_id() == 'fixed-session')
    os.rmdir(root, true)
}

test 'session references fall back to other projects in a shared session directory' {
    string root = '/tmp/adou-session-test-global-reference'
    os.rmdir(root, true) catch error {}
    string source_root = root + '/source'
    string target_root = root + '/target'
    string shared = root + '/shared'
    var source = repository.create(source_root, shared)
    string id = source.get_session_id()
    source.append_message(new ai_types.user_message_t(content = 'global id', timestamp = 100))
    var selected = repository.open_reference(target_root, shared, id.slice(0, 8))
    assert(selected.get_session_id() == id)
    assert(selected.cwd == source_root)
    assert(selected.build_context().messages.len() == 1)
    os.rmdir(root, true)
}

test 'continue recent uses file modification time instead of header timestamp' {
    string root = '/tmp/adou-session-test-recent-order'
    os.rmdir(root, true) catch error {}
    var older = repository.create(root, root + '/sessions')
    string older_file = older.get_session_file()
    string older_timestamp = older.header.timestamp
    older.append_message(new ai_types.user_message_t(content = 'older', timestamp = 100))
    var newer = repository.create(root, root + '/sessions')
    string newer_file = newer.get_session_file()
    string newer_timestamp = newer.header.timestamp
    newer.append_message(new ai_types.user_message_t(content = 'newer', timestamp = 200))
    replace_header_timestamp(older_file, older_timestamp, '2030-01-01T00:00:00.000Z')
    co.sleep(20)
    replace_header_timestamp(newer_file, newer_timestamp, '2020-01-01T00:00:00.000Z')
    var recent = repository.continue_recent(root, root + '/sessions')
    assert(recent.get_session_file() == newer_file)
    os.rmdir(root, true)
}
