import adou.src.tools.managed_tools
import adou.src.tools.path_utils
import os
import path
import syscall

test 'managed tools match Pi release asset matrix' {
    assert(managed_tools.asset_name('fd', '10.3.0', 'darwin', 'arm64') == 'fd-v10.3.0-aarch64-apple-darwin.tar.gz')
    assert(managed_tools.asset_name('fd', '10.3.0', 'darwin', 'x64') == 'fd-v10.3.0-x86_64-apple-darwin.tar.gz')
    assert(managed_tools.asset_name('fd', '10.3.0', 'linux', 'x64') == 'fd-v10.3.0-x86_64-unknown-linux-gnu.tar.gz')
    assert(managed_tools.asset_name('rg', '14.1.0', 'darwin', 'arm64') == 'ripgrep-14.1.0-aarch64-apple-darwin.tar.gz')
    assert(managed_tools.asset_name('rg', '14.1.0', 'linux', 'x64') == 'ripgrep-14.1.0-x86_64-unknown-linux-musl.tar.gz')
    assert(managed_tools.asset_name('rg', '14.1.0', 'win32', 'x64') == 'ripgrep-14.1.0-x86_64-pc-windows-msvc.zip')
    assert(managed_tools.asset_name('rg', '14.1.0', 'plan9', 'x64') == '')
}

test 'managed tools reject unknown names without network access' {
    assert(!managed_tools.known_tool('grep'))
    assert(managed_tools.find('grep') == '')
    string result = managed_tools.ensure('grep') catch error {''}
    assert(result == '')
}

test 'managed tools honor configured platform and architecture' {
    string old_platform = syscall.get_env('ADOU_TOOL_PLATFORM')
    string old_arch = syscall.get_env('ADOU_TOOL_ARCH')
    syscall.set_env('ADOU_TOOL_PLATFORM', 'LINUX')
    syscall.set_env('ADOU_TOOL_ARCH', 'AMD64')
    assert(managed_tools.platform() == 'linux')
    assert(managed_tools.architecture() == 'x64')
    syscall.set_env('ADOU_TOOL_PLATFORM', old_platform)
    syscall.set_env('ADOU_TOOL_ARCH', old_arch)
}

test 'managed tools offline mode does not download a missing binary' {
    string old_dir = syscall.get_env('ADOU_MANAGED_TOOLS_DIR')
    string old_offline = syscall.get_env('ADOU_OFFLINE')
    string old_path = syscall.get_env('PATH')
    string root = '/tmp/adou-managed-tools-offline'
    os.rmdir(root, true) catch error {}
    syscall.set_env('ADOU_MANAGED_TOOLS_DIR', root)
    syscall.set_env('ADOU_OFFLINE', 'true')
    syscall.set_env('PATH', '/usr/local/nature/bin:/usr/bin:/bin')
    if managed_tools.find('rg') == '' {
        string result = managed_tools.ensure('rg') catch error {''}
        assert(result == '')
        assert(!path_utils.exists(path.join(root, 'rg')))
    }
    syscall.set_env('ADOU_MANAGED_TOOLS_DIR', old_dir)
    syscall.set_env('ADOU_OFFLINE', old_offline)
    syscall.set_env('PATH', old_path)
    os.rmdir(root, true) catch error {}
}
