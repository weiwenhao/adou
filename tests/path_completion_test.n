import adou.src.tui.path_completion
import fmt
import fs
import os
import path
import syscall
import time

pub fn write_file(string file_path, string content): void! {
    var parent = path.dir(file_path)
    os.mkdirs(parent, 0o700)
    var file = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644) catch error {
        throw error
    }
    file.write(content as [u8])
    file.close()
}

pub fn fixture_base(): string {
    string root = path.join('/tmp', 'adou-complete-' + suffix())
    write_file(path.join(root, 'main.n'), '') catch error {}
    write_file(path.join(root, 'README.md'), '') catch error {}
    write_file(path.join(root, 'src', 'app.n'), '') catch error {}
    write_file(path.join(root, 'src', 'tools.n'), '') catch error {}
    write_file(path.join(root, 'src', 'nested', 'deep.n'), '') catch error {}
    write_file(path.join(root, 'with space.txt'), '') catch error {}
    return root
}

test 'find_last_delimiter and quote extraction like Pi' {
    assert(path_completion.find_last_delimiter('hello world') == 5)
    assert(path_completion.find_last_delimiter('hello') == -1)
    assert(path_completion.find_unclosed_quote_start('open "src/app') == 5)
    assert(path_completion.find_unclosed_quote_start('"closed"') == -1)
    assert(path_completion.extract_quoted_prefix('open "src/app') == '"src/app')
}

test 'parse_path_prefix distinguishes at and quoted forms like Pi' {
    var plain = path_completion.parse_path_prefix('src/')
    assert(!plain.is_at_prefix && !plain.is_quoted_prefix)
    var at = path_completion.parse_path_prefix('@src/')
    assert(at.is_at_prefix && !at.is_quoted_prefix)
    var quoted = path_completion.parse_path_prefix('"src/')
    assert(!quoted.is_at_prefix && quoted.is_quoted_prefix)
    var at_quoted = path_completion.parse_path_prefix('@"src/')
    assert(at_quoted.is_at_prefix && at_quoted.is_quoted_prefix)
}

test 'get_file_suggestions lists directory contents with directories first like Pi' {
    string base = fixture_base()
    var suggestions = path_completion.get_file_suggestions('', base, '/tmp')
    assert(suggestions.len() >= 3)
    // Directories sort before files.
    assert(suggestions[0].label.ends_with('/'))
    assert(suggestions[0].label == 'src/')
    os.rmdir(base, true)
}

test 'prefix filtering matches case-insensitively like Pi' {
    string base = fixture_base()
    var suggestions = path_completion.get_file_suggestions('MA', base, '/tmp')
    assert(suggestions.len() == 1)
    assert(suggestions[0].label == 'main.n')
    os.rmdir(base, true)
}

test 'directory prefix completes children like Pi' {
    string base = fixture_base()
    var suggestions = path_completion.get_file_suggestions('src/', base, '/tmp')
    assert(suggestions.len() == 3)
    bool has_nested = false
    for suggestion in suggestions {
        if suggestion.label == 'nested/' {
            has_nested = true
        }
    }
    assert(has_nested)
    os.rmdir(base, true)
}

test 'values quote paths with spaces like Pi' {
    string base = fixture_base()
    var suggestions = path_completion.get_file_suggestions('with', base, '/tmp')
    assert(suggestions.len() == 1)
    assert(suggestions[0].value == '"with space.txt"')
    os.rmdir(base, true)
}

test 'quoted attachment completions do not double-wrap existing quotes' {
    assert(path_completion.quoted_at_completion_value('@plain.txt') == '@"plain.txt"')
    assert(path_completion.quoted_at_completion_value('@"with space.txt"') == '@"with space.txt"')
}

fn suffix(): string {
    return fmt.sprintf('%d', time.now().ms_timestamp())
}

test 'fuzzy attachment search scores and ranks like Pi' {
    string root = '/tmp/adou-fuzzy-at-' + fmt.sprintf('%d', time.now().ms_timestamp())
    os.mkdirs(path.join(root, 'src', 'main'), 0o755)
    os.mkdirs(path.join(root, 'docs'), 0o755)
    var doc = fs.open(path.join(root, 'docs', 'guide.md'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    doc.close()
    var entry = fs.open(path.join(root, 'src', 'main', 'app.n'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    entry.close()
    var suggestions = path_completion.get_fuzzy_file_suggestions('guide', root, '/tmp')
    assert(suggestions.len() == 1)
    assert(suggestions[0].label == 'guide.md')
    assert(suggestions[0].value.starts_with('@'))
    assert(suggestions[0].description.contains('guide.md'))
    // Directory bonus ranks directories above file substring matches.
    var dir_suggestions = path_completion.get_fuzzy_file_suggestions('src', root, '/tmp')
    assert(dir_suggestions.len() >= 1)
    os.rmdir(root, true)
}

test 'B1-R4-05 fuzzy attachment values are baseDir-relative and never leak the absolute cwd' {
    string root = '/tmp/adou-fuzzy-relative-' + fmt.sprintf('%d', time.now().ms_timestamp())
    os.mkdirs(path.join(root, 'src', 'main'), 0o755)
    var entry = fs.open(path.join(root, 'src', 'main', 'app.n'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    entry.close()
    var suggestions = path_completion.get_fuzzy_file_suggestions('app', root, '/tmp')
    assert(suggestions.len() == 1)
    // value/label/description must be relative to base_path (fd
    // --base-directory semantics): the absolute cwd never appears.
    assert(suggestions[0].value == '@src/main/app.n')
    assert(suggestions[0].label == 'app.n')
    assert(suggestions[0].description == 'src/main/app.n')
    assert(!suggestions[0].value.contains(root))
    assert(!suggestions[0].description.contains(root))
    var dir_suggestions = path_completion.get_fuzzy_file_suggestions('main', root, '/tmp')
    // 'app.n' also matches via its full path, but the exact directory match
    // ranks first; the top candidate must be the relative directory.
    assert(dir_suggestions.len() >= 1)
    assert(dir_suggestions[0].value == '@src/main/')
    assert(dir_suggestions[0].label == 'main/')
    assert(dir_suggestions[0].description == 'src/main')
    assert(!dir_suggestions[0].value.contains(root))
    os.rmdir(root, true)
}

test 'B1-R4-04 extract_at_prefix honors token boundaries and keeps email literals plain' {
    // me@domain is a single token without a delimiter before @: plain text.
    assert(path_completion.extract_at_prefix('me@domain') == '')
    assert(path_completion.extract_at_prefix('send to me@domain') == '')
    assert(path_completion.extract_at_prefix('a=b@c') == '')
    // A token-boundary @ (after a delimiter or at line start) is a prefix.
    assert(path_completion.extract_at_prefix('@file.txt') == '@file.txt')
    assert(path_completion.extract_at_prefix('attach @file.txt') == '@file.txt')
    assert(path_completion.extract_at_prefix('attach @dir/file') == '@dir/file')
    // Quoted @" form is preserved.
    assert(path_completion.extract_at_prefix('attach @"my file.txt') == '@"my file.txt')
}

test 'B1-R4-12 completion_range: @file appends a space, @dir/ does not, quotes adjust' {
    // @file: one trailing space, cursor after it.
    var file_range = path_completion.completion_range(5, 'at @a', '@a', path_completion.completion_item_t {value: '@app.n', label: 'app.n'}, true)
    assert(file_range[0] == 3 && file_range[1] == 5)
    assert(file_range[2] == '@app.n ')
    assert(file_range[3] == 10)
    // @dir/: no space, cursor at the value end.
    var dir_range = path_completion.completion_range(5, 'at @s', '@s', path_completion.completion_item_t {value: '@src/', label: 'src/'}, true)
    assert(dir_range[2] == '@src/')
    assert(dir_range[3] == 8)
    // Plain path (Tab) mode: no space for files either.
    var path_range = path_completion.completion_range(2, 'ap', 'ap', path_completion.completion_item_t {value: 'app.n', label: 'app.n'}, false)
    assert(path_range[2] == 'app.n')
    assert(path_range[3] == 5)
    // Quoted item with a following quote: the cursor sits right after the
    // typed quoted prefix ('"@a' at index 3), the closing quote is dropped
    // from the suffix and directories keep the cursor one cell inside.
    var quoted_file = path_completion.completion_range(3, '"@a"', '"@a', path_completion.completion_item_t {value: '"@app.n"', label: 'app.n'}, true)
    assert(quoted_file[0] == 0 && quoted_file[1] == 4)
    assert(quoted_file[2] == '"@app.n" ')
    assert(quoted_file[3] == 9)
    var quoted_dir = path_completion.completion_range(3, '"@s"', '"@s', path_completion.completion_item_t {value: '"@src/"', label: 'src/'}, true)
    assert(quoted_dir[0] == 0 && quoted_dir[1] == 4)
    assert(quoted_dir[2] == '"@src/"')
    assert(quoted_dir[3] == 6)
}
