import adou.src.agent.schema
import adou.src.json_util
import json

test 'schema coerces Pi-compatible primitive tool arguments' {
    var definition = json_util.parse('{"type":"object","properties":{"count":{"type":"number"},"enabled":{"type":"boolean"},"label":{"type":"string"}},"required":["count","enabled","label"]}')
    var input = json_util.parse('{"count":"42","enabled":"true","label":1}')
    var result = schema.validate_and_coerce('echo', definition, input)
    assert(json_util.num_token((result as {string:any})['count']) == '42')
    assert((result as {string:any})['enabled'] as bool)
    assert((result as {string:any})['label'] as string == '1')
}

test 'schema validates required and nested array values' {
    var definition = json_util.parse('{"type":"object","properties":{"items":{"type":"array","items":{"type":"string"}}},"required":["items"]}')
    var result = schema.validate_and_coerce('echo', definition, json_util.parse('{"items":[1,true]}'))
    assert((((result as {string:any})['items']) as [any])[0] as string == '1')
    assert((((result as {string:any})['items']) as [any])[1] as string == 'true')
    bool failed = false
    var caught = schema.validate_and_coerce('echo', definition, json_util.parse('{}')) catch e {
        failed = e.msg().contains('items: Expected required property')
        {}
    }
    assert(failed)
}

test 'schema rejects invalid boolean coercion' {
    var definition = json_util.parse('{"type":"object","properties":{"value":{"type":"boolean"}},"required":["value"]}')
    bool failed = false
    var caught = schema.validate_and_coerce('echo', definition, json_util.parse('{"value":"1"}')) catch e {
        failed = e.msg().contains('Validation failed for tool "echo"')
        {}
    }
    assert(failed)
}
