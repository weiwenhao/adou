import adou.src.agent.event_json
import adou.src.agent.session_stream
import adou.src.agent.types as agent_types
import adou.src.ai.types as ai_types
import json

test 'json mode serializes session lifecycle and retry fields' {
    var start = session_stream.event_t {kind: session_stream.EVENT_RETRY_START, retry_attempt: 1, retry_max_attempts: 3, retry_delay_ms: 2000, retry_error_message: '503 service unavailable',}
    string encoded = event_json.encode(start)
    var value = json.parse(encoded)
    assert(value.kind == json.VALUE_OBJECT)
    var object = value.as_object()
    assert(object['type'].as_string() == session_stream.EVENT_RETRY_START)
    assert(object['attempt'].number == '1')
    assert(object['maxAttempts'].number == '3')
    assert(object['delayMs'].number == '2000')
    assert(object['retryError'].as_string() == '503 service unavailable')
}

test 'json mode matches Pi summarization retry event payloads' {
    var scheduled = session_stream.event_t {kind: session_stream.EVENT_SUMMARIZATION_RETRY_SCHEDULED, retry_attempt: 1, retry_max_attempts: 3, retry_delay_ms: 2000, retry_error_message: '503 service unavailable', retry_source: 'compaction', retry_reason: 'manual',}
    var scheduled_object = json.parse(event_json.encode(scheduled)).as_object()
    assert(scheduled_object['type'].as_string() == session_stream.EVENT_SUMMARIZATION_RETRY_SCHEDULED)
    assert(scheduled_object['errorMessage'].as_string() == '503 service unavailable')
    assert(!scheduled_object.contains('source') && !scheduled_object.contains('reason'))

    var attempt = session_stream.event_t {kind: session_stream.EVENT_SUMMARIZATION_RETRY_ATTEMPT_START, retry_source: 'compaction', retry_reason: 'manual',}
    var attempt_object = json.parse(event_json.encode(attempt)).as_object()
    assert(attempt_object['source'].as_string() == 'compaction' && attempt_object['reason'].as_string() == 'manual')

    var finished = session_stream.event_t {kind: session_stream.EVENT_SUMMARIZATION_RETRY_FINISHED, retry_attempt: 1, retry_success: true, retry_source: 'compaction', retry_reason: 'manual',}
    var finished_object = json.parse(event_json.encode(finished)).as_object()
    assert(finished_object.len() == 1 && finished_object['type'].as_string() == session_stream.EVENT_SUMMARIZATION_RETRY_FINISHED)
}

test 'json mode emits assistant message payloads on message end' {
    var assistant = new ai_types.assistant_message_t(provider = 'deepseek', model = 'deepseek-v4-flash', stop_reason = ai_types.STOP_STOP)
    var event = agent_types.agent_event_t {kind: agent_types.EVENT_MESSAGE_END, assistant_message: assistant,}
    var envelope = session_stream.event_t {kind: agent_types.EVENT_MESSAGE_END, has_agent_event: true, agent_event: event,}
    var value = json.parse(event_json.encode(envelope))
    var object = value.as_object()
    assert(object['type'].as_string() == agent_types.EVENT_MESSAGE_END)
    assert(object['assistantMessage'].kind == json.VALUE_OBJECT)
}

test 'json mode preserves Pi agent lifecycle payloads and settled event' {
    var user = new ai_types.user_message_t(content = 'hello')
    var assistant = new ai_types.assistant_message_t(provider = 'deepseek', model = 'deepseek-v4-flash', stop_reason = ai_types.STOP_STOP)
    var user_message = agent_types.agent_event_t {kind: agent_types.EVENT_MESSAGE_END, user_message: user,}
    var turn = agent_types.agent_event_t {kind: agent_types.EVENT_TURN_END, assistant_message: assistant, tool_results: [new ai_types.tool_result_message_t(tool_call_id = 'call-1', tool_name = 'read')],}
    var ended = agent_types.agent_event_t {kind: agent_types.EVENT_AGENT_END, messages: [user, assistant],}

    var user_object = json.parse(event_json.encode(session_stream.event_t {kind: agent_types.EVENT_MESSAGE_END, has_agent_event: true, agent_event: user_message,})).as_object()
    assert(user_object['message'].kind == json.VALUE_OBJECT)
    var turn_object = json.parse(event_json.encode(session_stream.event_t {kind: agent_types.EVENT_TURN_END, has_agent_event: true, agent_event: turn,})).as_object()
    assert(turn_object['message'].kind == json.VALUE_OBJECT && turn_object['toolResults'].kind == json.VALUE_ARRAY)
    assert(turn_object['toolResults'].as_array().len() == 1)
    var ended_object = json.parse(event_json.encode(session_stream.event_t {kind: agent_types.EVENT_AGENT_END, has_agent_event: true, agent_event: ended,})).as_object()
    assert(ended_object['messages'].kind == json.VALUE_ARRAY && ended_object['messages'].as_array().len() == 2)
    var settled = json.parse(event_json.encode(session_stream.event_t {kind: session_stream.EVENT_AGENT_SETTLED,})).as_object()
    assert(settled.len() == 1 && settled['type'].as_string() == session_stream.EVENT_AGENT_SETTLED)
}

test 'json mode encodes Pi queue_update snapshots' {
    var event = session_stream.event_t {kind: session_stream.EVENT_QUEUE_UPDATE, queue_steering: ['stop and inspect'], queue_follow_up: ['summarize after'],}
    var object = json.parse(event_json.encode(event)).as_object()
    assert(object['type'].as_string() == session_stream.EVENT_QUEUE_UPDATE)
    assert(object['steering'].kind == json.VALUE_ARRAY && object['followUp'].kind == json.VALUE_ARRAY)
    assert(object['steering'].as_array().len() == 1 && object['followUp'].as_array().len() == 1)
    assert(object['steering'].as_array()[0].as_string() == 'stop and inspect')
}
