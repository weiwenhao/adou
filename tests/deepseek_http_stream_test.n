import adou.src.ai.providers.deepseek
import adou.src.ai.providers.openai_completions_provider
import adou.src.ai.types
import co
import fmt
import http
import net.tcp
import time

pub const DEEPSEEK_PORT = 18790
pub const DEEPSEEK_KEEPALIVE_ERROR_PORT = 18791

pub type capture_t = struct {
    string body
    string authorization
    string endpoint
}

pub fn serve_fixture(ref<http.server_t> server): void! {
    server.listen(server.port)
}

pub fn serve_keepalive_error_fixture(): void! {
    var server = tcp.listen(fmt.sprintf('127.0.0.1:%d', DEEPSEEK_KEEPALIVE_ERROR_PORT))
    var conn = server.accept()
    var request = vec<u8>.new(0, 4096)
    conn.read(request)
    string body = '{"error":{"message":"invalid key"}}'
    string response = fmt.sprintf('HTTP/1.1 401 Authorization Required\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: keep-alive\r\n\r\n%s', body.len(), body)
    conn.write(response as [u8])
    // Keep the socket open longer than the assertion threshold. The client
    // must stop at Content-Length instead of waiting for connection EOF.
    co.sleep(1200)
    conn.close()
    server.close()
}

pub fn fixture_model(int port): ref<types.model_t> {
    var model = new types.model_t(id = 'deepseek-v4-flash', api = 'openai-completions', provider = 'deepseek', base_url = fmt.sprintf('http://127.0.0.1:%d', port), reasoning = true, max_tokens = 128)
    // Since 595f4de the thinking format is detected at runtime and carried
    // per model; the fixture must declare the deepseek shape explicitly.
    model.compat.thinking_format = 'deepseek'
    return model
}

pub fn fixture_context(): ref<types.context_t> {
    var context = new types.context_t()
    types.message_t user = new types.user_message_t(content = 'hello')
    context.messages.push(user)
    return context
}

pub fn kinds_has([string] kinds, string kind): bool {
    for existing in kinds {
        if existing == kind {
            return true
        }
    }
    return false
}

pub fn success_sse(): string {
    string body = ''
    body += 'data: {"id":"chatcmpl_ds","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"role":"assistant","content":""}}]}\n\n'
    body += 'data: {"id":"chatcmpl_ds","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"reasoning_content":"thinking..."}}]}\n\n'
    body += 'data: {"id":"chatcmpl_ds","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"你好"}}]}\n\n'
    body += 'data: {"id":"chatcmpl_ds","object":"chat.completion.chunk","choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}\n\n'
    body += 'data: {"usage":{"prompt_tokens":3,"completion_tokens":4,"total_tokens":7}}\n\n'
    body += 'data: [DONE]\n\n'
    return body
}

test 'streams a real DeepSeek HTTP response through the completions provider' {
    var capture = new capture_t()
    var server = http.server()
    server.port = DEEPSEEK_PORT
    http.callback_fn handler = fn (http.request_t request, ref<http.response_t> response): void! {
        capture.endpoint = request.path
        capture.body = request.body
        capture.authorization = request.headers['Authorization'] catch e {''}
        response.content_type = 'text/event-stream'
        response.send(success_sse())
        server.close()
    }
    server.post('/chat/completions', handler)
    go serve_fixture(server)
    co.sleep(500)
    var options = new types.stream_options_t(api_key = 'deepseek-test-key', timeout_ms = 5000, max_retries = 0, thinking_enabled = true, reasoning_effort = 'high',)
    var stream = openai_completions_provider.stream(fixture_model(DEEPSEEK_PORT), fixture_context(), options)
    co.sleep(800)
    [string] kinds = []
    for true {
        var event = stream.recv() catch error {break}
        kinds.push(event.kind)
    }
    var result = stream.result()
    assert(kinds[0] == types.EVENT_START)
    assert(kinds_has(kinds, types.EVENT_THINKING_DELTA))
    assert(kinds_has(kinds, types.EVENT_THINKING_END))
    assert(kinds_has(kinds, types.EVENT_TEXT_DELTA))
    assert(kinds_has(kinds, types.EVENT_TEXT_END))
    assert(kinds[kinds.len() - 1] == types.EVENT_DONE)
    assert(result.stop_reason == types.STOP_STOP)
    assert(capture.endpoint == '/chat/completions')
    assert(capture.authorization == 'Bearer deepseek-test-key')
    assert(capture.body.find('"model":"deepseek-v4-flash"') >= 0)
    assert(capture.body.find('"stream":true') >= 0)
    assert(capture.body.find('"thinking":{"type":"enabled"}') >= 0)
    var text = text_block(result)
    assert(text.text == '你好')
    assert(result.usage.total_tokens == 7)
}

test 'bounded error body does not wait for keep-alive EOF' {
    go serve_keepalive_error_fixture()
    co.sleep(100)
    var options = new types.stream_options_t(api_key = 'invalid-key', timeout_ms = 5000, max_retries = 0,)
    i64 started = time.now().ms_timestamp()
    var stream = openai_completions_provider.stream(fixture_model(DEEPSEEK_KEEPALIVE_ERROR_PORT), fixture_context(), options)
    var event = stream.recv()
    var result = stream.result()
    i64 elapsed = time.now().ms_timestamp() - started
    assert(event.kind == types.EVENT_ERROR)
    assert(result.stop_reason == types.STOP_ERROR)
    assert(result.error_message.find('HTTP 401 Authorization Required') >= 0)
    assert(result.error_message.find('invalid key') >= 0)
    assert(elapsed < 800)
    co.sleep(1200)
}

pub fn text_block(ref<types.assistant_message_t> message): ref<types.text_content_t> {
    for block in message.content {
        if block is ref<types.text_content_t> text {
            return text
        }
    }
    return new types.text_content_t()
}

test 'deepseek provider metadata matches Pi' {
    var def = deepseek.def()
    assert(def.id == 'deepseek')
    assert(def.name == 'DeepSeek')
    assert(def.api == 'openai-completions')
    assert(def.base_url == 'https://api.deepseek.com')
    assert(def.env_vars.len() == 1 && def.env_vars[0] == 'DEEPSEEK_API_KEY')
    var models = deepseek.models()
    assert(models.len() == 2)
    var flash = models[0]
    assert(flash.id == 'deepseek-v4-flash')
    assert(flash.reasoning)
    assert(flash.context_window == 1000000)
    assert(flash.max_tokens == 384000)
    assert(flash.cost.input == 0.14)
    assert(flash.cost.output == 0.28)
    assert(flash.cost.cache_read == 0.0028)
    assert(flash.thinking_level_map['high'] == 'high')
    assert(flash.thinking_level_map['max'] == 'max')
    assert(flash.thinking_level_map['low'] == '')
}
