import adou.src.tui.renderer
import adou.src.tui.virtual_terminal

test 'first render appends with synchronized output and no clear' {
    var value = renderer.new()
    var result = value.render(['one', 'two'], 20, 5)
    assert(result.strategy == renderer.STRATEGY_FIRST)
    assert(result.output.starts_with('\x1b[?2026h'))
    assert(!result.output.contains('\x1b[2J') && result.output.ends_with('\x1b[?2026l'))
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(result.output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'one' && screen[1] == 'two')
}

test 'ordinary update clears and replaces only changed range' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    var first = value.render(['one', 'two', 'three'], 20, 5)
    terminal.write(first.output)
    var changed = value.render(['one', 'TWO', 'three'], 20, 5)
    assert(changed.strategy == renderer.STRATEGY_DIFF && changed.first_changed == 1 && changed.last_changed == 1)
    assert(changed.output.contains('\x1b[2K') && !changed.output.contains('\x1b[2J'))
    terminal.write(changed.output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'one' && screen[1] == 'TWO' && screen[2] == 'three')
}

test 'width height and changes above viewport force full redraw' {
    var width_value = renderer.new()
    width_value.render(['a'], 20, 5)
    assert(width_value.render(['a'], 21, 5).strategy == renderer.STRATEGY_FULL)
    var height_value = renderer.new()
    height_value.render(['a'], 20, 5)
    assert(height_value.render(['a'], 20, 4).strategy == renderer.STRATEGY_FULL)
    var viewport = renderer.new()
    viewport.render(['0', '1', '2', '3', '4', '5'], 20, 3)
    var redraw = viewport.render(['X', '1', '2', '3', '4', '5'], 20, 3)
    assert(redraw.strategy == renderer.STRATEGY_FULL && redraw.output.contains('\x1b[2J\x1b[H\x1b[3J'))
}

test 'scrolling content keeps the visible tail aligned while appending' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    [string] initial = ['pre 0', 'pre 1', 'pre 2', 'pre 3', 'pre 4', 'pre 5', 'pre 6', 'pre 7']
    terminal.write(value.render(initial, 20, 5).output)
    [string] next = initial.slice(0, initial.len())
    next.push('tool 0')
    next.push('tool 1')
    next.push('post 0')
    terminal.write(value.render(next, 20, 5).output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'pre 6' && screen[1] == 'pre 7' && screen[2] == 'tool 0' && screen[3] == 'tool 1' && screen[4] == 'post 0')
}

test 'viewport moves upward with Pi full redraw when a tail is deleted' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    [string] initial = ['line 0', 'line 1', 'line 2', 'line 3', 'line 4', 'line 5', 'line 6', 'line 7', 'line 8', 'line 9', 'line 10', 'line 11']
    terminal.write(value.render(initial, 20, 5).output)
    [string] shortened = initial.slice(0, 7)
    var result = value.render(shortened, 20, 5)
    assert(result.strategy == renderer.STRATEGY_FULL && result.output.contains('\x1b[2J\x1b[H\x1b[3J'))
    terminal.write(result.output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'line 2' && screen[1] == 'line 3' && screen[2] == 'line 4' && screen[3] == 'line 5' && screen[4] == 'line 6')
}

test 'deleting all scrolled content uses a full redraw' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['line 0', 'line 1', 'line 2', 'line 3', 'line 4', 'line 5', 'line 6', 'line 7'], 20, 5).output)
    var result = value.render([], 20, 5)
    assert(result.strategy == renderer.STRATEGY_FULL && result.output.contains('\x1b[2J\x1b[H\x1b[3J'))
    terminal.write(result.output)
    var screen = terminal.snapshot()
    assert(screen[0] == '' && screen[1] == '' && screen[2] == '' && screen[3] == '' && screen[4] == '')
}

test 'deleting more than one viewport clears with a full redraw' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['line 0', 'line 1', 'line 2', 'line 3', 'line 4', 'line 5', 'line 6', 'line 7'], 20, 5).output)
    var result = value.render(['line 0'], 20, 5)
    assert(result.strategy == renderer.STRATEGY_FULL && result.output.contains('\x1b[2J\x1b[H\x1b[3J'))
    terminal.write(result.output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'line 0' && screen[1] == '' && screen[2] == '' && screen[3] == '' && screen[4] == '')
}

test 'shrink clears deleted rows through differential output' {
    var value = renderer.new()
    // Pi settings.terminal.clearOnShrink (default off): the clearing
    // behavior is opt-in; the existing shrink contract runs with it on.
    value.set_clear_on_shrink(true)
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['one', 'two', 'three'], 20, 5).output)
    var shrink = value.render(['one'], 20, 5)
    assert(shrink.strategy == renderer.STRATEGY_DIFF)
    terminal.write(shrink.output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'one' && screen[1] == '' && screen[2] == '')
}

test 'clearOnShrink off leaves shrunk rows untouched like Pi default' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['one', 'two', 'three'], 20, 5).output)
    var shrink = value.render(['one'], 20, 5)
    assert(shrink.strategy == renderer.STRATEGY_DIFF)
    terminal.write(shrink.output)
    var screen = terminal.snapshot()
    // Pi default: the previous rows stay visible below the shrunk content.
    assert(screen[0] == 'one' && screen[1] == 'two' && screen[2] == 'three')
}

test 'overlay frame clears removed rows independent of global shrink setting' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render_overlay_frame(['selector', 'option one', 'option two'], 20, 5).output)
    terminal.write(value.render_overlay_frame(['prompt'], 20, 5).output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'prompt' && screen[1] == '' && screen[2] == '')
}

test 'shrink after a changed first line preserves the replacement line' {
    var value = renderer.new()
    value.set_clear_on_shrink(true)
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['old', 'two', 'three'], 20, 5).output)
    terminal.write(value.render(['NEW'], 20, 5).output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'NEW' && screen[1] == '' && screen[2] == '')
}

test 'shrink after a changed prefix clears only the deleted tail' {
    var value = renderer.new()
    value.set_clear_on_shrink(true)
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['old', 'two', 'three', 'four'], 20, 5).output)
    terminal.write(value.render(['NEW', 'tail'], 20, 5).output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'NEW' && screen[1] == 'tail' && screen[2] == '' && screen[3] == '')
}

test 'no changes emit nothing and oversized lines are rejected' {
    var value = renderer.new()
    value.render(['same'], 10, 3)
    var unchanged = value.render(['same'], 10, 3)
    assert(unchanged.strategy == renderer.STRATEGY_NONE && unchanged.output == '')
    bool failed = false
    try {
        value.render(['this is too long'], 5, 3)
    } catch e {
        failed = e.msg().contains('exceeds terminal width')
    }
    assert(failed)
}

test 'embedded line breaks are expanded before differential rendering' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['alpha\nbeta'], 20, 5).output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'alpha' && screen[1] == 'beta')
}

test 'invalidate forces a cleared full repaint exactly once' {
    var value = renderer.new()
    var terminal = virtual_terminal.new(20, 5)
    terminal.write(value.render(['one', 'two'], 20, 5).output)
    // A frame skipped during terminal suspension must not leave the diff in
    // sync: invalidate demands a full repaint WITH the clear sequence (a
    // first-render join would not erase foreign shell/editor content).
    value.invalidate()
    var repaint = value.render(['one', 'two'], 20, 5)
    assert(repaint.strategy == renderer.STRATEGY_FULL)
    assert(repaint.output.contains('\x1b[2J\x1b[H\x1b[3J'))
    terminal.write(repaint.output)
    var screen = terminal.snapshot()
    assert(screen[0] == 'one' && screen[1] == 'two')
    // The force flag is consumed by the repaint: the next identical frame
    // stays a no-op instead of repainting forever.
    assert(value.render(['one', 'two'], 20, 5).strategy == renderer.STRATEGY_NONE)
}
