import adou.src.ai.providers.openai_provider
import adou.src.ai.types
import co
import fmt
import http
import net.tcp
const FIXTURE_PORT = 18765
const RETRY_PORT = 18766
const ERROR_PORT = 18767
const ABORT_PORT = 18768
const CHUNKED_PORT = 18769
const TIMEOUT_PORT = 18770
const ABORT_STREAM_PORT = 18771
type server_capture_t = struct {
    string body
    string authorization
    string session_id
    int attempts
}
fn serve_fixture(ref<http.server_t> server): void! {
    server.listen(server.port)
}
fn fixture_model(int port): ref<types.model_t> {
    return new types.model_t(id = 'gpt-5-mini', api = 'openai-responses', provider = 'openai', base_url = fmt.sprintf('http://127.0.0.1:%d/v1', port), max_tokens = 128,)
}
fn fixture_context(): ref<types.context_t> {
    var context = new types.context_t()
    types.message_t user = new types.user_message_t(content = 'hello')
    context.messages.push(user)
    return context
}
fn success_sse(): string {
    string body = ''
    body += 'data: {"type":"response.created","response":{"id":"resp_http"}}\n\n'
    body += 'data: {"type":"response.output_item.added","output_index":0,"item":{"type":"message","id":"msg_http","content":[]}}\n\n'
    body += 'data: {"type":"response.output_text.delta","output_index":0,"delta":"你好"}\n\n'
    body += 'data: {"type":"response.output_item.done","output_index":0,"item":{"type":"message","id":"msg_http","content":[{"type":"output_text","text":"你好"}]}}\n\n'
    body += 'data: {"type":"response.completed","response":{"id":"resp_http","status":"completed","usage":{"input_tokens":3,"output_tokens":2,"total_tokens":5}}}\n\n'
    return body
}
fn serve_chunked_fixture(): void! {
    var server = tcp.listen(fmt.sprintf('127.0.0.1:%d', CHUNKED_PORT))
    var conn = server.accept()
    var request = vec<u8>.new(0, 4096)
    conn.read(request)
    conn.write(('HTTP/1.1 200 OK\r\n' + 'Transfer-Encoding: chunked\r\n' + 'Content-Type: text/event-stream\r\n' + '\r\n') as [u8])
    [u8] payload = success_sse() as [u8]
    int offset = 0
    for offset < payload.len() {
        int next = offset + 7
        if next > payload.len() {
            next = payload.len()
        }
        var chunk = payload.slice(offset, next)
        conn.write(fmt.sprintf('%x\r\n', chunk.len()) as [u8])
        conn.write(chunk)
        conn.write('\r\n' as [u8])
        offset = next
    }
    conn.write('0\r\n\r\n' as [u8])
    co.sleep(20)
    conn.close()
    co.sleep(20)
    server.close()
}
fn serve_timeout_fixture(): void! {
    var server = tcp.listen(fmt.sprintf('127.0.0.1:%d', TIMEOUT_PORT))
    var conn = server.accept()
    var request = vec<u8>.new(0, 4096)
    conn.read(request)
    co.sleep(200)
    conn.close()
    co.sleep(20)
    server.close()
}
fn serve_abort_stream_fixture(): void! {
    var server = tcp.listen(fmt.sprintf('127.0.0.1:%d', ABORT_STREAM_PORT))
    var conn = server.accept()
    var request = vec<u8>.new(0, 4096)
    conn.read(request)
    conn.write(('HTTP/1.1 200 OK\r\n' + 'Transfer-Encoding: chunked\r\n' + 'Content-Type: text/event-stream\r\n' + '\r\n') as [u8])
    co.sleep(500)
    conn.close()
    server.close()
}
test 'streams a real HTTP response through Nature HTTP and SSE' {
    var capture = new server_capture_t()
    var server = http.server()
    server.port = FIXTURE_PORT
    http.callback_fn handler = fn (http.request_t request, ref<http.response_t> response): void! {
        capture.body = request.body
        capture.authorization = request.headers['Authorization'] catch e {
            ''
        }
        capture.session_id = request.headers['session_id'] catch e {
            ''
        }
        response.content_type = 'text/event-stream'
        response.send(success_sse())
        server.close()
    }
    server.post('/v1/responses', handler)
    go serve_fixture(server)
    co.sleep(500)
    var model = fixture_model(FIXTURE_PORT)
    var context = fixture_context()
    var options = new types.stream_options_t(api_key = 'test-key', timeout_ms = 5000, session_id = 'session-http',)
    var stream = openai_provider.stream(model, context, options)
    [string] event_kinds = []
    for true {
        var event = stream.recv()
        event_kinds.push(event.kind)
        if event.kind == types.EVENT_DONE || event.kind == types.EVENT_ERROR {
            break
        }
    }
    var result = stream.result()
    assert(event_kinds.len() == 5)
    assert(event_kinds[0] == types.EVENT_START)
    assert(event_kinds[1] == types.EVENT_TEXT_START)
    assert(event_kinds[2] == types.EVENT_TEXT_DELTA)
    assert(event_kinds[3] == types.EVENT_TEXT_END)
    assert(event_kinds[4] == types.EVENT_DONE)
    assert(result.stop_reason == types.STOP_STOP)
    assert(result.response_id == 'resp_http')
    assert(result.usage.total_tokens == 5)
    var text = result.content[0] as ref<types.text_content_t>
    assert(text.text == '你好')
    assert(capture.authorization == 'Bearer test-key')
    assert(capture.session_id == 'session-http')
    assert(capture.body.find('"stream":true') >= 0)
}
test 'retries a retryable HTTP response before emitting start' {
    var capture = new server_capture_t()
    var server = http.server()
    server.port = RETRY_PORT
    http.callback_fn handler = fn (http.request_t request, ref<http.response_t> response): void! {
        capture.attempts += 1
        if capture.attempts == 1 {
            response.status = 429
            response.message = 'Too Many Requests'
            response.headers['Retry-After-Ms'] = '1'
            response.send('{"error":"slow down"}')
            return
        }
        response.content_type = 'text/event-stream'
        response.send(success_sse())
        server.close()
    }
    server.post('/v1/responses', handler)
    go serve_fixture(server)
    co.sleep(500)
    var options = new types.stream_options_t(api_key = 'test-key', timeout_ms = 5000, max_retries = 2,)
    var stream = openai_provider.stream(fixture_model(RETRY_PORT), fixture_context(), options)
    [string] event_kinds = []
    for true {
        var event = stream.recv()
        event_kinds.push(event.kind)
        if event.kind == types.EVENT_DONE || event.kind == types.EVENT_ERROR {
            break
        }
    }
    var result = stream.result()
    assert(capture.attempts == 2)
    assert(event_kinds[0] == types.EVENT_START)
    assert(result.stop_reason == types.STOP_STOP)
}
test 'does not retry a deterministic HTTP 400 response' {
    var capture = new server_capture_t()
    var server = http.server()
    server.port = ERROR_PORT
    http.callback_fn handler = fn (http.request_t request, ref<http.response_t> response): void! {
        capture.attempts += 1
        response.status = 400
        response.message = 'Bad Request'
        response.send('{"error":"bad request"}')
        server.close()
    }
    server.post('/v1/responses', handler)
    go serve_fixture(server)
    co.sleep(500)
    var options = new types.stream_options_t(api_key = 'test-key', timeout_ms = 5000, max_retries = 2,)
    var stream = openai_provider.stream(fixture_model(ERROR_PORT), fixture_context(), options)
    var event = stream.recv()
    var result = stream.result()
    assert(capture.attempts == 1)
    assert(event.kind == types.EVENT_ERROR)
    assert(result.stop_reason == types.STOP_ERROR)
    assert(result.error_message.find('HTTP 400 Bad Request') >= 0)
    assert(result.error_message.find('bad request') >= 0)
}
test 'abort interrupts Retry-After backoff' {
    var capture = new server_capture_t()
    var server = http.server()
    server.port = ABORT_PORT
    http.callback_fn handler = fn (http.request_t request, ref<http.response_t> response): void! {
        capture.attempts += 1
        response.status = 429
        response.message = 'Too Many Requests'
        response.headers['Retry-After-Ms'] = '1000'
        response.send('{"error":"slow down"}')
        server.close()
    }
    server.post('/v1/responses', handler)
    go serve_fixture(server)
    co.sleep(500)
    var options = new types.stream_options_t(api_key = 'test-key', timeout_ms = 5000, max_retries = 2,)
    var stream = openai_provider.stream(fixture_model(ABORT_PORT), fixture_context(), options)
    co.sleep(50)
    stream.abort()
    var event = stream.recv()
    var result = stream.result()
    assert(capture.attempts == 1)
    assert(event.kind == types.EVENT_ERROR)
    assert(event.reason == types.STOP_ABORTED)
    assert(result.stop_reason == types.STOP_ABORTED)
}
test 'streams chunked SSE split across arbitrary byte boundaries' {
    go serve_chunked_fixture()
    co.sleep(100)
    var options = new types.stream_options_t(api_key = 'test-key', timeout_ms = 5000, max_retries = 0,)
    var stream = openai_provider.stream(fixture_model(CHUNKED_PORT), fixture_context(), options)
    [string] event_kinds = []
    for true {
        var event = stream.recv()
        event_kinds.push(event.kind)
        if event.kind == types.EVENT_DONE || event.kind == types.EVENT_ERROR {
            break
        }
    }
    var result = stream.result()
    assert(event_kinds.len() == 5)
    assert(event_kinds[0] == types.EVENT_START)
    assert(event_kinds[4] == types.EVENT_DONE)
    assert(result.stop_reason == types.STOP_STOP)
    var text = result.content[0] as ref<types.text_content_t>
    assert(text.text == '你好')
}
test 'surfaces a native HTTP response header timeout as a provider error' {
    go serve_timeout_fixture()
    co.sleep(100)
    var options = new types.stream_options_t(api_key = 'test-key', timeout_ms = 50, max_retries = 0,)
    var stream = openai_provider.stream(fixture_model(TIMEOUT_PORT), fixture_context(), options)
    var event = stream.recv()
    var result = stream.result()
    assert(event.kind == types.EVENT_ERROR)
    assert(result.stop_reason == types.STOP_ERROR)
    assert(result.error_message.find('HTTP response read timeout') >= 0)
}
test 'abort closes a native HTTP stream with a pending read' {
    go serve_abort_stream_fixture()
    co.sleep(100)
    var options = new types.stream_options_t(api_key = 'test-key', timeout_ms = 5000, max_retries = 0,)
    var stream = openai_provider.stream(fixture_model(ABORT_STREAM_PORT), fixture_context(), options)
    var start = stream.recv()
    assert(start.kind == types.EVENT_START)
    stream.abort()
    var event = stream.recv()
    var result = stream.result()
    assert(event.kind == types.EVENT_ERROR)
    assert(event.reason == types.STOP_ABORTED)
    assert(result.stop_reason == types.STOP_ABORTED)
}
