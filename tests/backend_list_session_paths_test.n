import adou.src.session.backend
import fmt
import fs
import os
import path
import syscall
import time

// Phase 7.1 TUI regression guard: the resume-picker scan must distinguish a
// failed scan (missing session directory throws) from a genuinely empty
// store (empty directory yields an empty list).  The picker surfaces the
// former as an explicit error instead of the "No persisted sessions" empty
// state.

test 'list_session_paths throws when the session directory does not exist' {
    string dir = path.join('/tmp', 'adou-list-paths-missing-' + fmt.sprintf('%d', time.now().ms_timestamp()))
    var listed = backend.list_session_paths(dir) catch error {
        assert(error.msg() != '')
        return
    }
    assert(false)
}

test 'list_session_paths returns an empty list for an empty directory' {
    string dir = path.join('/tmp', 'adou-list-paths-empty-' + fmt.sprintf('%d', time.now().ms_timestamp()))
    os.mkdirs(dir, 0o700)
    var listed = backend.list_session_paths(dir) catch error {
        os.rmdir(dir, true)
        assert(false)
        return
    }
    assert(listed.len() == 0)
    os.rmdir(dir, true)
}

// B3-EXT-01 regression: when the trash spawn fails (or trash is not on
// PATH), delete_session_file must fall through to unlink and must never
// report a deletion that did not happen.
test 'B3-EXT-01 delete falls back to unlink when trash is unavailable' {
    string dir = path.join('/tmp', 'adou-delete-fallback-' + fmt.sprintf('%d', time.now().ms_timestamp()))
    os.mkdirs(dir, 0o700)
    string file_path = path.join(dir, '2026-08-16T00-00-00-000Z_session.jsonl')
    var output = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o600)
    output.write('{}' as [u8])
    output.close()
    string previous_path = syscall.get_env('PATH')
    // No PATH: the `trash` lookup inside /bin/bash fails with 127, which
    // must route through os.remove instead of a false success.
    syscall.set_env('PATH', '/usr/local/nature/bin') catch error {}
    var (deleted, message) = backend.delete_session_file(file_path, dir)
    syscall.set_env('PATH', previous_path) catch error {}
    assert(deleted)
    assert(message == 'Session deleted')
    var probe = fs.open(file_path, syscall.O_RDONLY, 0) catch error {
        os.rmdir(dir, true)
        return
    }
    probe.close()
    os.rmdir(dir, true)
    assert(false)
}

test 'B3-EXT-01 delete of a missing file is already deleted' {
    string missing = path.join('/tmp', 'adou-delete-missing-' + fmt.sprintf('%d', time.now().ms_timestamp()) + '.jsonl')
    var (deleted, message) = backend.delete_session_file(missing, '/tmp')
    assert(deleted)
    assert(message != '')
}
