import adou.src.ai.types as ai_types
import adou.src.session.repository
import adou.src.session.types as session_types
import adou.src.tui.session_search
import fmt
import fs
import os
import path
import syscall
import time

fn temp_dir(): string {
    return path.join('/tmp', 'adou-session-search-' + fmt.sprintf('%d', time.now().ms_timestamp()))
}

pub fn write_file(string file_path, string content): void! {
    os.mkdirs(path.dir(file_path), 0o755)
    var file = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    file.write(content as [u8])
    file.close()
}

test 'parse_search_query handles tokens phrases and regex like Pi' {
    var tokens = session_search.parse_search_query('hello world')
    assert(tokens.tokens.len() == 2)
    assert(!tokens.tokens[0].phrase)
    var phrase = session_search.parse_search_query('"exact phrase" tail')
    assert(phrase.tokens.len() == 2)
    assert(phrase.tokens[0].phrase)
    assert(phrase.tokens[0].value == 'exact phrase')
    var regex = session_search.parse_search_query('re:error')
    assert(regex.regex == 'error')
    var empty = session_search.parse_search_query('re:')
    assert(empty.error == 'Empty regex')
}

test 'match_session scores phrases and fuzzy tokens like Pi' {
    string text = 'session-1 my name hello world some message /tmp/project'
    var tokens = session_search.parse_search_query('hello world')
    var matched = session_search.match_session(text, tokens)
    assert(matched[0])
    var phrase = session_search.parse_search_query('"some message"')
    var phrase_match = session_search.match_session(text, phrase)
    assert(phrase_match[0])
    var missing = session_search.parse_search_query('absent')
    var no_match = session_search.match_session(text, missing)
    assert(!no_match[0])
}

test 'search text covers name messages and cwd like Pi' {
    var manager = repository.create('/tmp/session-search-project', path.join(temp_dir(), 'sessions'))
    manager.append_session_info('searchable-name')
    var user = new ai_types.user_message_t(content = 'find this phrase inside')
    manager.append_message(user)
    var searchable = session_search.session_search_text(manager)
    assert(searchable.contains('searchable-name'))
    assert(searchable.contains('find this phrase inside'))
    assert(searchable.contains('/tmp/session-search-project'))
}

test 'filter_and_sort_sessions ranks relevance and respects name filter' {
    string dir = temp_dir()
    var sessions = path.join(dir, 'sessions')
    os.mkdirs(sessions, 0o755)
    var first = repository.create('/tmp/project-a', sessions)
    first.append_session_info('alpha session')
    var user_a = new ai_types.user_message_t(content = 'deploy the gateway')
    first.append_message(user_a)
    var second = repository.create('/tmp/project-b', sessions)
    second.append_session_info('beta session')
    var user_b = new ai_types.user_message_t(content = 'refactor the parser')
    second.append_message(user_b)
    var third = repository.create('/tmp/project-c', sessions)
    var user_c = new ai_types.user_message_t(content = 'alpha deploy check')
    third.append_message(user_c)
    var names = os.listdir(sessions) catch error {[]}
    [string] paths = []
    for name in names {
        if name.ends_with('.jsonl') {
            paths.push(path.join(sessions, name))
        }
    }
    // Search by message text across sessions.
    var deploy = session_search.filter_and_sort_sessions(paths, 'deploy', 2, false)
    assert(deploy.len() >= 1)
    // Name filter drops the unnamed session.
    var named = session_search.filter_and_sort_sessions(paths, '', 0, true)
    assert(named.len() == 2)
    // Empty query keeps everything.
    var all = session_search.filter_and_sort_sessions(paths, '', 0, false)
    assert(all.len() == 3)
    // A query that matches no session yields an empty list.
    var none = session_search.filter_and_sort_sessions(paths, 'zzz-absent', 2, false)
    assert(none.len() == 0)
    os.rmdir(dir, true)
}

test 'threaded ordering groups children under their parent session' {
    string dir = temp_dir()
    var sessions = path.join(dir, 'sessions')
    os.mkdirs(sessions, 0o755)
    // Parent session with a child fork.
    var parent = repository.create('/tmp/project-p', sessions)
    parent.append_session_info('parent session')
    var parent_file = parent.get_session_file()
    // Fork into a new persisted session to get a parentSessionPath link.
    var child = parent.fork_at(parent.get_leaf_id()) catch error {
        assert(false)
        parent
    }
    var child_path = child.get_session_file()
    var names = os.listdir(sessions) catch error {[]}
    [string] paths = []
    for name in names {
        if name.ends_with('.jsonl') {
            paths.push(path.join(sessions, name))
        }
    }
    var threaded = session_search.filter_and_sort_sessions_threaded(paths, '', false)
    // The parent appears before its child (root first).
    int parent_index = -1
    int child_index = -1
    for index, item in threaded {
        if item == parent_file {
            parent_index = index
        }
        if item == child_path {
            child_index = index
        }
    }
    assert(parent_index >= 0 && child_index >= 0)
    assert(parent_index < child_index)
    os.rmdir(dir, true)
}

test 'regex queries match against the full search text like Pi' {
    var manager = repository.create('/tmp/regex-project', path.join(temp_dir(), 'sessions'))
    manager.append_session_info('regex target')
    var user = new ai_types.user_message_t(content = 'deploy error 42 occurred')
    manager.append_message(user)
    var text = session_search.session_search_text(manager)
    var parsed = session_search.parse_search_query('re:error [0-9]+')
    var matched = session_search.match_session(text, parsed)
    assert(matched[0])
    var no_match = session_search.parse_search_query('re:nomatch [0-9]+')
    var rejected = session_search.match_session(text, no_match)
    assert(!rejected[0])
    var invalid = session_search.parse_search_query('re:[unclosed')
    var invalid_match = session_search.match_session(text, invalid)
    assert(!invalid_match[0])
}

test 'tree filter helpers classify entries like Pi' {
    var manager = repository.in_memory('/tmp/tree-filter-test')
    var user = new ai_types.user_message_t(content = 'plain message')
    string user_id = manager.append_message(user)
    var call = new ai_types.tool_call_t(id = 'c1', name = 'bash', arguments = {})
    ai_types.content_t call_block = call
    var assistant = new ai_types.assistant_message_t(content = [call_block,])
    ai_types.message_t assistant_message = assistant
    string assistant_id = manager.append_message(assistant_message)
    assert(session_search.entry_matches_tree_filter(manager, user_id, 2))
    assert(!session_search.entry_matches_tree_filter(manager, assistant_id, 1))
    assert(session_search.entry_matches_tree_filter(manager, user_id, 1))
    assert(!session_search.entry_matches_tree_filter(manager, assistant_id, 2))
    manager.append_label_change(user_id, 'important')
    assert(session_search.entry_matches_tree_filter(manager, user_id, 3))
    assert(session_search.entry_content_preview(manager, user_id) == 'plain message')
}
