import adou.src.ai.providers.bedrock_messages
import adou.src.ai.providers.bedrock_provider
import adou.src.ai.types
import adou.src.json_util
import co
import fmt
import base64
import http
import net.tcp
import syscall

const BEDROCK_PORT = 18927

type capture_t = struct {
    string path
    string authorization
    string amz_date
    string accept
    string body
}

fn serve_fixture(ref<http.server_t> server): void! {
    server.listen(server.port)
}

fn fixture_model(int port): ref<types.model_t> {
    return new types.model_t(id = 'anthropic.claude-sonnet-4-5-v1:0', api = 'bedrock-converse-stream', provider = 'amazon-bedrock', base_url = fmt.sprintf('http://127.0.0.1:%d', port), reasoning = true, max_tokens = 128)
}

fn fixture_context(): ref<types.context_t> {
    var context = new types.context_t()
    types.message_t user = new types.user_message_t(content = 'hello')
    context.messages.push(user)
    return context
}

// Raw TCP fixture so the binary event stream is written byte-for-byte.
fn serve_raw(ref<capture_t> capture): void! {
    var server = tcp.listen(fmt.sprintf('127.0.0.1:%d', BEDROCK_PORT))
    var conn = server.accept()
    var request = vec<u8>.new(0, 8192)
    conn.read(request)
    capture.body = request as string
    var first_line = (request as string).split('\r\n')[0]
    capture.path = first_line.contains(' ') ? first_line.slice(first_line.find(' ') + 1, first_line.rfind(' ')) : ''
    string head = 'HTTP/1.1 200 OK\r\nContent-Type: application/vnd.amazon.eventstream\r\nContent-Length: 941\r\n\r\n'
    conn.write(head as [u8])
    conn.write(event_stream_fixture())
    conn.close()
    server.close()
}

// A complete AWS event stream fixture: messageStart, contentBlockStart with a
// toolUse, two contentBlockDelta fragments, contentBlockStop, messageStop
// (tool_use), and a usage metadata frame. Bytes generated by the AWS event
// stream framing format (base64 below).
fn event_stream_fixture(): [u8] {
    string encoded = ''
    return base64.decode(encoded as [u8]) catch error {
        [u8] empty = []
        empty
    }
}

test 'bedrock sigv4 authorization format and event stream decode' {
    syscall.set_env('AWS_ACCESS_KEY_ID', 'AKIDEXAMPLE')
    syscall.set_env('AWS_SECRET_ACCESS_KEY', 'wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY')
    syscall.set_env('AWS_REGION', 'us-east-1')
    var model = new types.model_t(id = 'anthropic.claude-sonnet-4-5-v1:0', api = 'bedrock-converse-stream', provider = 'amazon-bedrock', base_url = 'https://bedrock-runtime.us-east-1.amazonaws.com', max_tokens = 16)
    var auth = bedrock_messages.authorization(model, '{}', '20150830T123600Z')
    assert(auth.starts_with('AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/bedrock/aws4_request, SignedHeaders=content-type;host;x-amz-date, Signature='))
    // The Signature is a 64-char lowercase hex digest.
    string signature = auth.slice(auth.rfind('Signature=') + 10, auth.len())
    assert(signature.len() == 64)

    var frames = bedrock_messages.decode_event_stream(event_stream_fixture())
    assert(frames.len() == 7)
    assert(frames[0].event_type == 'messageStart')
    assert(frames[1].event_type == 'contentBlockStart')
    assert(frames[2].event_type == 'contentBlockDelta')
    assert(frames[5].event_type == 'messageStop')
    assert(frames[6].event_type == 'metadata')
}

test 'streams a real Bedrock converse-stream HTTP response' {
    syscall.set_env('AWS_ACCESS_KEY_ID', 'AKIDEXAMPLE')
    syscall.set_env('AWS_SECRET_ACCESS_KEY', 'wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY')
    syscall.set_env('AWS_REGION', 'us-east-1')
    var capture = new capture_t()
    go serve_raw(capture)
    co.sleep(500)
    var options = new types.stream_options_t(api_key = '', timeout_ms = 5000, max_retries = 0,)
    var stream = bedrock_provider.stream(fixture_model(BEDROCK_PORT), fixture_context(), options)
    co.sleep(800)
    [string] kinds = []
    for true {
        var event = stream.recv() catch error {break}
        kinds.push(event.kind)
    }
    var result = stream.result()
    assert(kinds[0] == types.EVENT_START)
    assert(kinds_has(kinds, types.EVENT_TOOLCALL_START))
    assert(kinds_has(kinds, types.EVENT_TOOLCALL_DELTA))
    assert(kinds_has(kinds, types.EVENT_TOOLCALL_END))
    assert(kinds[kinds.len() - 1] == types.EVENT_DONE)
    assert(result.stop_reason == types.STOP_TOOL_USE)
    assert(capture.path.find('/converse-stream') >= 0)
    assert(result.usage.input == 3)
    assert(result.usage.output == 2)
    assert(result.content.len() == 1)
    var call = result.content[0] as ref<types.tool_call_t>
    assert(call.name == 'read')
    assert(call.id == 'call_1')
    var arguments = call.arguments as {string:any}
    assert(arguments['path'] as string == 'README.md')
}

fn kinds_has([string] kinds, string kind): bool {
    for existing in kinds {
        if existing == kind {
            return true
        }
    }
    return false
}

test 'bedrock thinking config and cache points match Pi' {
    var model = new types.model_t(id = 'anthropic.claude-sonnet-4-5-v1:0', name = 'claude-sonnet-4-5', api = 'bedrock-converse-stream', provider = 'amazon-bedrock', base_url = 'https://bedrock-runtime.us-east-1.amazonaws.com', reasoning = true, max_tokens = 16)
    var context = new types.context_t(system_prompt = 'Be concise')
    types.message_t user = new types.user_message_t(content = 'hello')
    context.messages.push(user)
    var options = new types.stream_options_t(thinking_enabled = true, reasoning_effort = 'high', cache_retention = 'short')
    var body = json_util.parse(bedrock_messages.build(model, context, options))
    var additional = (body as {string:any})['additionalModelRequestFields'] as {string:any}
    var thinking = additional['thinking'] as {string:any}
    assert(thinking['type'] as string == 'enabled')
    assert((thinking['budget_tokens'] as f64) == 16384.0)
    assert(additional['anthropic_beta'] is [any])
    // System prompt carries the cache point for supported Claude models.
    var system = (body as {string:any})['system'] as [any]
    assert(system.len() == 2)
    var cache = system[1] as {string:any}
    assert(cache['type'] as string == 'default')
    // Last user message carries a cache point too.
    var messages = (body as {string:any})['messages'] as [any]
    var last = messages[messages.len() - 1] as {string:any}
    var content = last['content'] as [any]
    assert(content.len() == 2)
    var point = content[1] as {string:any}
    assert(point['type'] as string == 'default')
}

test 'bedrock adaptive thinking uses output_config effort like Pi' {
    var model = new types.model_t(id = 'anthropic.claude-opus-4-6-v1:0', name = 'claude-opus-4-6', api = 'bedrock-converse-stream', provider = 'amazon-bedrock', base_url = 'https://bedrock-runtime.us-east-1.amazonaws.com', reasoning = true, max_tokens = 16)
    var context = new types.context_t()
    types.message_t user = new types.user_message_t(content = 'hello')
    context.messages.push(user)
    var options = new types.stream_options_t(thinking_enabled = true, reasoning_effort = 'high', cache_retention = 'none')
    var body = json_util.parse(bedrock_messages.build(model, context, options))
    var additional = (body as {string:any})['additionalModelRequestFields'] as {string:any}
    var thinking = additional['thinking'] as {string:any}
    assert(thinking['type'] as string == 'adaptive')
    assert(!additional.contains('anthropic_beta'))
    var output_config = additional['output_config'] as {string:any}
    assert(output_config['effort'] as string == 'high')
}

test 'bedrock replays thinking signatures like Pi' {
    var model = new types.model_t(id = 'anthropic.claude-sonnet-4-5-v1:0', name = 'claude-sonnet-4-5', api = 'bedrock-converse-stream', provider = 'amazon-bedrock', base_url = 'https://bedrock-runtime.us-east-1.amazonaws.com', reasoning = true, max_tokens = 16)
    var context = new types.context_t()
    var thinking = new types.thinking_content_t(thinking = 'plan', thinking_signature = 'sig123')
    types.content_t block = thinking
    var assistant = new types.assistant_message_t(content = [block,])
    types.message_t assistant_message = assistant
    context.messages.push(assistant_message)
    var options = new types.stream_options_t()
    var body = json_util.parse(bedrock_messages.build(model, context, options))
    var messages = (body as {string:any})['messages'] as [any]
    var assistant_item = messages[0] as {string:any}
    var content = assistant_item['content'] as [any]
    var reasoning = (content[0] as {string:any})['reasoningContent'] as {string:any}
    var text = reasoning['reasoningText'] as {string:any}
    assert(text['text'] as string == 'plan')
    assert(text['signature'] as string == 'sig123')
}

test 'bedrock bearer token and skip-auth behave like Pi' {
    syscall.set_env('AWS_BEARER_TOKEN_BEDROCK', 'bt-123')
    syscall.set_env('AWS_ACCESS_KEY_ID', '')
    syscall.set_env('AWS_SECRET_ACCESS_KEY', '')
    var model = new types.model_t(id = 'anthropic.claude-sonnet-4-5-v1:0', api = 'bedrock-converse-stream', provider = 'amazon-bedrock', base_url = 'https://bedrock-runtime.us-east-1.amazonaws.com', max_tokens = 16)
    var bearer = bedrock_messages.authorization(model, '{}', '20150830T123600Z')
    assert(bearer == 'Bearer bt-123')
    syscall.set_env('AWS_BEARER_TOKEN_BEDROCK', '')
    syscall.set_env('AWS_BEDROCK_SKIP_AUTH', '1')
    var dummy = bedrock_messages.authorization(model, '{}', '20150830T123600Z')
    assert(dummy.contains('Credential=dummy-access-key/'))
    syscall.set_env('AWS_BEDROCK_SKIP_AUTH', '')
    bool failed = false
    try {
        var missing = bedrock_messages.authorization(model, '{}', '20150830T123600Z')
    } catch e {
        failed = true
    }
    assert(failed)
}
