import adou.src.ai.models
import adou.src.ai.types
import adou.src.config.models as config_models

test 'calculates Pi-compatible tiered and long-cache costs' {
    var model = new types.model_t()
    model.cost.input = 1000000.0
    model.cost.output = 2000000.0
    model.cost.cache_read = 500000.0
    model.cost.cache_write = 1500000.0
    var tier = types.cost_tier_t {input_tokens_above: 10, input: 3000000.0, output: 4000000.0, cache_read: 1000000.0, cache_write: 2500000.0,}
    model.cost.tiers.push(tier)
    var usage = types.usage_t {input: 5, output: 2, cache_read: 5, cache_write: 3, cache_write_1h: 2,}
    usage = models.calculate_cost(model, usage)
    assert(usage.cost.input == 15.0)
    assert(usage.cost.output == 8.0)
    assert(usage.cost.cache_read == 5.0)
    assert(usage.cost.cache_write == 14.5)
    assert(usage.cost.total == 42.5)
}

test 'clamps invalid one-hour cache counts to the total cache write count' {
    var model = new types.model_t()
    model.cost.input = 1000000.0
    model.cost.cache_write = 1500000.0
    var usage = types.usage_t {cache_write: 3, cache_write_1h: 10,}
    usage = models.calculate_cost(model, usage)
    assert(usage.cost.cache_write == 6.0)
}

test 'clamps DeepSeek V4 thinking levels like Pi' {
    var model = config_models.find('deepseek/deepseek-v4-flash') as ref<types.model_t>
    assert(config_models.clamp_thinking_level(model, 'off') == 'off')
    assert(config_models.clamp_thinking_level(model, 'minimal') == 'high')
    assert(config_models.clamp_thinking_level(model, 'medium') == 'high')
    assert(config_models.clamp_thinking_level(model, 'high') == 'high')
    assert(config_models.clamp_thinking_level(model, 'xhigh') == 'max')
    // Explicit/persisted max must survive resolution (regression: it was
    // degraded to high because the catalog capability map was missing).
    assert(config_models.clamp_thinking_level(model, 'max') == 'max')
}

test 'reports Pi supported thinking levels per model' {
    var deepseek = config_models.find('deepseek/deepseek-v4-flash') as ref<types.model_t>
    var openai = config_models.find('openai/gpt-5.1-codex') as ref<types.model_t>
    var deepseek_levels = config_models.available_thinking_levels(deepseek)
    var openai_levels = config_models.available_thinking_levels(openai)
    assert(deepseek_levels.len() == 3 && deepseek_levels[0] == 'off' && deepseek_levels[1] == 'high' && deepseek_levels[2] == 'max')
    // The gpt-5.1-codex fallback carries no thinkingLevelMap, so xhigh/max
    // are unsupported exactly like Pi's undefined-map semantics.
    assert(openai_levels.len() == 5 && openai_levels[0] == 'off' && openai_levels[4] == 'high')
}

test 'resolves Pi model scopes in pattern order with per-entry thinking' {
    var scoped = config_models.resolve_scope(['anthropic/claude-sonnet-4-5:low', 'openai/gpt-5.1-codex:medium', 'deepseek/deepseek-v4-flash:max'])
    assert(scoped.len() == 3)
    assert(scoped[0].model.provider == 'anthropic' && scoped[0].model.id == 'claude-sonnet-4-5' && scoped[0].thinking_level == 'low')
    assert(scoped[1].model.provider == 'openai' && scoped[1].model.id == 'gpt-5.1-codex' && scoped[1].thinking_level == 'medium')
    assert(scoped[2].model.provider == 'deepseek' && scoped[2].model.id == 'deepseek-v4-flash' && scoped[2].thinking_level == 'max')
}

test 'scoped model resolution removes duplicate matches without later override' {
    var scoped = config_models.resolve_scope(['deepseek/deepseek-v4-flash', 'deepseek/deepseek-v4-flash:max'])
    assert(scoped.len() == 1)
    assert(scoped[0].thinking_level == '')
    assert(config_models.thinking_for('deepseek/deepseek-v4-flash', ['deepseek/deepseek-v4-flash', 'deepseek/deepseek-v4-flash:max']) == '')
}

test 'full catalog exposes every registered provider family' {
    var scoped = config_models.resolve_scope(['deepseek/deepseek-v4-pro:max'])
    assert(scoped.len() == 1)
    assert(scoped[0].model.id == 'deepseek-v4-pro' && scoped[0].thinking_level == 'max')
    var xai = config_models.find('xai/grok-4.5')
    assert(xai is ref<types.model_t>)
    if xai is ref<types.model_t> model {
        assert(model.api == 'openai-responses')
    }
    var router = config_models.find('openrouter/openai/gpt-5.1-codex')
    assert(router is ref<types.model_t>)
}

test 'invalid scope thinking suffix falls back to the resolved model prefix' {
    var scoped = config_models.resolve_scope(['deepseek/deepseek-v4-flash:bogus', 'deepseek/deepseek-v4-flash:max'])
    assert(scoped.len() == 1)
    assert(scoped[0].model.id == 'deepseek-v4-flash' && scoped[0].thinking_level == '')
    assert(config_models.thinking_for('deepseek/deepseek-v4-flash', ['deepseek/deepseek-v4-flash:bogus', 'deepseek/deepseek-v4-flash:max']) == '')
}
