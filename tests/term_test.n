import adou.src.debug
import adou.src.tui.term
import fs
import os
import syscall

test 'terminal package detects non-tty test streams' {
    assert(!term.is_tty(term.STDIN))
    assert(!term.is_tty(term.STDOUT))
}

pub fn can_open_terminal():bool {
    var terminal = term.open() catch e {
        return false
    }
    terminal.restore() catch e {}
    return true
}

test 'terminal open rejects non-tty streams without changing state' {
    assert(!can_open_terminal())
}

test 'terminal reads through fs and writes through the fd bridge' {
    var dir = '/tmp/adou-term-fs-io'
    os.mkdirs(dir, 0o755)
    var input = fs.open(dir + '/input.txt', syscall.O_RDWR | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    input.write('hello\n' as [u8])
    input.seek(0, syscall.SEEK_SET)
    var output = fs.open(dir + '/output.txt', syscall.O_RDWR | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    // The input fd bridge reads from the fixture descriptor; writes go
    // through the native bridge on the fixture descriptor, never stdout.
    var terminal = new term.terminal_t(input_fd = input.fd, output_fd = output.fd, input = input, active = false, restored = true)

    var bytes = terminal.read()
    assert(bytes as string == 'hello\n')
    assert(!terminal.is_eof())

    bytes = terminal.read()
    assert(bytes.len() == 0)
    assert(terminal.is_eof())

    terminal.write('world')
    output.seek(0, syscall.SEEK_SET)
    var written = vec<u8>.new(0, 16)
    int count = output.read(written)
    assert(written.slice(0, count) as string == 'world')
}

test 'terminal read status uses fixed numeric EINTR and EAGAIN codes' {
    assert(term.INPUT_READ_INTERRUPTED == -2)
    assert(term.INPUT_READ_WOULD_BLOCK == -1)
    assert(term.INPUT_READ_INTERRUPTED != term.INPUT_READ_WOULD_BLOCK)
}

test 'terminal write surfaces permanent bridge errors instead of swallowing them' {
    // A permanently invalid descriptor must raise the bridge's -errno, not
    // spin on the EAGAIN retry budget and not vanish silently.
    var broken = new term.terminal_t(input_fd = syscall.STDIN, output_fd = -1, input = fs.stdin(), active = true, restored = false)
    bool failed = false
    try {
        broken.write('hello')
    } catch e {
        failed = e.msg().contains('terminal write failed')
    }
    assert(failed)
}

test 'B1-R5-01 tui io diagnostic is default-off and only file-targeted' {
    // Default off.
    syscall.set_env('ADOU_TUI_IO_DIAG', '')
    assert(!debug.tui_io_diag_enabled())
    // Explicitly on / off values.
    syscall.set_env('ADOU_TUI_IO_DIAG', '1')
    assert(debug.tui_io_diag_enabled())
    syscall.set_env('ADOU_TUI_IO_DIAG', '0')
    assert(!debug.tui_io_diag_enabled())
    syscall.set_env('ADOU_TUI_IO_DIAG', '')
    // Line format is fixed and payload-safe (no paths/credentials in the
    // categories or the message plumbing).
    assert(debug.tui_io_line(term.TUI_IO_EOF, 'read returned 0 (EOF)') == '[tui-io] eof: read returned 0 (EOF)')
}

test 'B1-R5-01 eintr retry budget boundary is pure and exact' {
    assert(term.eintr_retry_allowed(0, term.INPUT_EINTR_RETRY_LIMIT))
    assert(term.eintr_retry_allowed(term.INPUT_EINTR_RETRY_LIMIT - 1, term.INPUT_EINTR_RETRY_LIMIT))
    assert(!term.eintr_retry_allowed(term.INPUT_EINTR_RETRY_LIMIT, term.INPUT_EINTR_RETRY_LIMIT))
    assert(!term.eintr_retry_allowed(term.INPUT_EINTR_RETRY_LIMIT + 1, term.INPUT_EINTR_RETRY_LIMIT))
}

test 'B1-R5-01 diagnostic event categories are fixed and distinct' {
    [string] events = [
        term.TUI_IO_EINTR_RETRY,
        term.TUI_IO_EINTR_EXHAUSTED,
        term.TUI_IO_EOF,
        term.TUI_IO_READ_FAILURE,
        term.TUI_IO_WRITE_FAILURE,
        term.TUI_IO_RESTORE,
        term.TUI_IO_QUIT,
    ]
    for index, event in events {
        assert(event != '')
        for int other = index + 1; other < events.len(); other += 1 {
            assert(event != events[other])
        }
    }
}

test 'B1-R5-01 restore event is recorded only after the write succeeds' {
    syscall.set_env('ADOU_TUI_IO_DIAG', '1')
    string log_path = '/tmp/adou-tui-io-restore-order.log'
    os.remove(log_path) catch error {}
    syscall.set_env('ADOU_DEBUG_FILE', log_path)
    // A broken output fd makes the restore write throw BEFORE any restore
    // event could be logged; the log must not claim the sequences were
    // issued.
    var broken = new term.terminal_t(input_fd = syscall.STDIN, output_fd = -1, input = fs.stdin(), active = true, restored = false)
    bool failed = false
    try {
        broken.restore()
    } catch e {
        failed = true
    }
    assert(failed)
    string content = ''
    try {
        var file = fs.open(log_path, syscall.O_RDONLY, 0)
        content = file.content() catch read_error {
            file.close()
            ''
        }
        file.close()
    } catch open_error {}
    assert(content.find('[tui-io] restore') < 0)
    // Cleanup: restore the env and remove the scratch log.
    syscall.set_env('ADOU_TUI_IO_DIAG', '')
    syscall.set_env('ADOU_DEBUG_FILE', '')
    os.remove(log_path) catch error {}
}
