import adou.src.config.args
import adou.src.config.models as config_models
import adou.src.config.paths as config_paths
import adou.src.config.resolve
import fmt
import fs
import os
import path
import syscall
import time

fn isolate_env(): string! {
    string previous = syscall.get_env('ADOU_CODING_AGENT_DIR')
    string root = path.join('/tmp', 'adou-resolver-isolated-' + fmt.sprintf('%d', time.now().ms_timestamp()))
    syscall.set_env('ADOU_CODING_AGENT_DIR', path.join(root, 'agent'))
    return path.join(root, 'agent')
}

test 'Adou agent directory variables use the ADOU prefix' {
    string previous_adou_dir = syscall.get_env('ADOU_CODING_AGENT_DIR')
    string previous_adou_sessions = syscall.get_env('ADOU_SESSION_DIR')
    syscall.set_env('ADOU_CODING_AGENT_DIR', '/tmp/adou-agent')
    syscall.set_env('ADOU_SESSION_DIR', '/tmp/adou-sessions')
    assert(config_paths.agent_dir() == '/tmp/adou-agent')
    assert(config_paths.sessions_dir() == '/tmp/adou-sessions')
    syscall.set_env('ADOU_CODING_AGENT_DIR', previous_adou_dir)
    syscall.set_env('ADOU_SESSION_DIR', previous_adou_sessions)
}

test 'no explicit selection and no valid persisted default falls back to deepseek-v4-flash' {
    isolate_env()
    var arguments = args.parse(['adou'])
    var config = resolve.resolve(arguments, '/tmp')
    assert(config.provider == 'deepseek')
    assert(config.model.id == 'deepseek-v4-flash')
}

test 'stale mock persisted default with OpenAI credentials still falls back to deepseek-v4-flash' {
    string agent_dir = isolate_env()
    os.mkdirs(agent_dir, 0o755) catch error {}
    var file = fs.open(path.join(agent_dir, 'settings.json'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644) catch error {
        assert(false)
        return
    }
    file.write('{"defaultProvider":"mock","defaultModel":"mock-next"}' as [u8])
    file.close()
    var previous_openai = syscall.get_env('OPENAI_API_KEY')
    syscall.set_env('OPENAI_API_KEY', 'sk-stray-openai') catch error {}
    var previous_pi = syscall.get_env('ADOU_CODING_AGENT_DIR')
    syscall.set_env('ADOU_CODING_AGENT_DIR', agent_dir) catch error {}
    var arguments = args.parse(['adou'])
    var config = resolve.resolve(arguments, '/tmp')
    assert(config.provider == 'deepseek')
    assert(config.model.id == 'deepseek-v4-flash')
    if previous_openai == '' {
        syscall.set_env('OPENAI_API_KEY', '') catch error {}
    } else {
        syscall.set_env('OPENAI_API_KEY', previous_openai) catch error {}
    }
    syscall.set_env('ADOU_CODING_AGENT_DIR', previous_pi) catch error {}
}

test 'explicit --thinking max survives resolution with catalog capability metadata' {
    isolate_env()
    var arguments = args.parse(['adou', '--provider', 'deepseek', '--model', 'deepseek-v4-flash', '--thinking', 'max'])
    var config = resolve.resolve(arguments, '/tmp')
    assert(config.thinking == 'max')
    assert(config.stream_options.reasoning_effort == 'max')
    // The resolved model must carry the catalog thinking map so clamping
    // sees max as supported and unsupported levels fall back to high.
    assert(config_models.clamp_thinking_level(config.model, 'max') == 'max')
    assert(config_models.clamp_thinking_level(config.model, 'high') == 'high')
    assert(config_models.clamp_thinking_level(config.model, 'medium') == 'high')
    assert(config_models.clamp_thinking_level(config.model, 'off') == 'off')
}

test 'explicit provider still wins over the fallback' {
    isolate_env()
    var arguments = args.parse(['adou', '--provider', 'openai', '--model', 'gpt-5.1-codex'])
    var config = resolve.resolve(arguments, '/tmp')
    assert(config.provider == 'openai')
    assert(config.model.id == 'gpt-5.1-codex')
}

test 'unknown provider is a recoverable configuration error' {
    var arguments = args.parse(['adou', '--provider', 'mock'])
    bool failed = false
    try {
        resolve.resolve(arguments, '/tmp')
    } catch error {
        failed = error.msg().contains('Unsupported provider: mock')
    }
    assert(failed)
}

test 'B3 transport and httpIdleTimeoutMs flow into the runtime config' {
    string agent_dir = isolate_env()
    os.mkdirs(agent_dir, 0o755) catch error {}
    var file = fs.open(path.join(agent_dir, 'settings.json'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    file.write('{"transport":"websocket","httpIdleTimeoutMs":60000}' as [u8])
    file.close()
    var config = resolve.resolve(args.parse(['adou']), '/tmp')
    assert(config.stream_options.transport == 'websocket')
    assert(config.transport == 'websocket')
    assert(config.stream_options.timeout_ms == 60000)
    assert(config.http_idle_timeout_ms == 60000)
    // "disabled" flows through as the std client's no-timeout value.
    var disabled_file = fs.open(path.join(agent_dir, 'settings.json'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    disabled_file.write('{"httpIdleTimeoutMs":"disabled"}' as [u8])
    disabled_file.close()
    var disabled_config = resolve.resolve(args.parse(['adou']), '/tmp')
    assert(disabled_config.stream_options.timeout_ms == 0)
    // An explicit --timeout-ms wins over the setting.
    var explicit_config = resolve.resolve(args.parse(['adou', '--timeout-ms', '90000']), '/tmp')
    assert(explicit_config.stream_options.timeout_ms == 90000)
}

test 'images autoResize flows into the runtime tool configuration' {
    string agent_dir = isolate_env()
    os.mkdirs(agent_dir, 0o755) catch error {}
    var file = fs.open(path.join(agent_dir, 'settings.json'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    file.write('{"images":{"autoResize":false}}' as [u8])
    file.close()
    var config = resolve.resolve(args.parse(['adou']), '/tmp')
    assert(!config.auto_resize_images)
}

test 'B3 defaultProjectTrust decides projects without stored decisions' {
    string agent_dir = isolate_env()
    os.mkdirs(agent_dir, 0o755) catch error {}
    var file = fs.open(path.join(agent_dir, 'settings.json'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    file.write('{"defaultProjectTrust":"never"}' as [u8])
    file.close()
    string project = path.join('/tmp', 'adou-resolve-trust-' + fmt.sprintf('%d', time.now().ms_timestamp()))
    os.mkdirs(path.join(project, '.adou', 'skills'), 0o700)
    var skill = fs.open(path.join(project, '.adou', 'skills', 'SKILL.md'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    skill.write('x' as [u8])
    skill.close()
    var never_config = resolve.resolve(args.parse(['adou']), project)
    assert(!never_config.project_trusted)
    // Global-only: a project settings file cannot override the trust mode.
    os.mkdirs(path.join(project, '.adou'), 0o700) catch error {}
    var project_settings = fs.open(path.join(project, '.adou', 'settings.json'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    project_settings.write('{"defaultProjectTrust":"always"}' as [u8])
    project_settings.close()
    var still_never = resolve.resolve(args.parse(['adou']), project)
    assert(!still_never.project_trusted)
    // 'always' trusts without a stored decision.
    var agent_file = fs.open(path.join(agent_dir, 'settings.json'), syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644)
    agent_file.write('{"defaultProjectTrust":"always"}' as [u8])
    agent_file.close()
    var always_config = resolve.resolve(args.parse(['adou']), project)
    assert(always_config.project_trusted)
}
