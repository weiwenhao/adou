import adou.src.compaction.token_estimate
import adou.src.compaction.types as compaction_types
import adou.src.config.args
import adou.src.config.resolve
import adou.src.context.project
import adou.src.context.system_prompt
import adou.src.session.identity
import fs
import os
import path
import syscall

pub fn write_file(string file_path, string content): void! {
    os.mkdirs(path.dir(file_path), 0o700)
    var output = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o600)
    int written = output.write(content as [u8])
    output.close()
    assert(written == content.len())
}

test 'MVP CLI parses provider model sessions compaction and messages' {
    var parsed = args.parse(['adou', '--provider', 'anthropic', '--model', 'claude-test', '--base-url', 'http://localhost:9999', '--thinking', 'high', '--session', 'session.jsonl', '--context-window', '1234', '--max-tokens', '99', '--timeout-ms', '55', '--max-retries', '0', '--reserve-tokens', '10', '--keep-recent-tokens', '20', 'hello'])
    assert(parsed.errors.len() == 0)
    assert(parsed.provider == 'anthropic' && parsed.model == 'claude-test')
    assert(parsed.context_window == 1234 && parsed.max_tokens == 99 && parsed.timeout_ms == 55 && parsed.max_retries == 0)
    assert(parsed.reserve_tokens == 10 && parsed.keep_recent_tokens == 20)
    assert(parsed.messages.len() == 1 && parsed.messages[0] == 'hello')
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.model.api == 'anthropic-messages' && config.model.context_window == 1234)
    assert(config.stream_options.max_retries == 0 && config.stream_options.thinking_enabled)
}

test 'debug mode is an explicit startup option and preserves the prompt' {
    var parsed = args.parse(['adou', '--debug', 'hello'])
    assert(parsed.errors.len() == 0 && parsed.debug && parsed.messages.len() == 1 && parsed.messages[0] == 'hello')
}

test 'defaults to the Pi DeepSeek V4 Flash model' {
    var parsed = args.parse(['adou'])
    assert(parsed.errors.len() == 0)
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.provider == 'deepseek')
    assert(config.model.id == 'deepseek-v4-flash')
    assert(config.model.api == 'openai-completions')
    assert(config.model.base_url == 'https://api.deepseek.com')
    assert(config.model.context_window == 1000000 && config.model.max_tokens == 384000)
}

test 'model references may carry their provider' {
    var parsed = args.parse(['adou', '--model', 'openai/gpt-5.1-codex'])
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.provider == 'openai' && config.model.id == 'gpt-5.1-codex' && config.model.api == 'openai-responses')
}

test 'model references may carry Pi thinking suffixes' {
    var parsed = args.parse(['adou', '--model', 'deepseek/deepseek-v4-flash:high'])
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.provider == 'deepseek' && config.model.id == 'deepseek-v4-flash')
    assert(config.thinking == 'high' && config.stream_options.reasoning_effort == 'high')
}

test 'explicit thinking keeps a colon-bearing custom model id intact' {
    var parsed = args.parse(['adou', '--provider', 'ANTHROPIC', '--model', 'custom:high', '--thinking', 'medium'])
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.provider == 'anthropic')
    assert(config.model.id == 'custom:high')
    assert(config.thinking == 'medium' && config.stream_options.reasoning_effort == 'medium')
}

test 'explicit thinking overrides a known model suffix without changing its id' {
    var parsed = args.parse(['adou', '--provider', 'ANTHROPIC', '--model', 'claude-sonnet-4-5:high', '--thinking', 'low'])
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.provider == 'anthropic')
    assert(config.model.id == 'claude-sonnet-4-5')
    assert(config.thinking == 'low' && config.stream_options.reasoning_effort == 'low')
}

test 'Pi-compatible one-shot and prompt/session options are preserved' {
    var parsed = args.parse(['adou', '--print', '--name', 'review', '--fork', 'source.jsonl', '--system-prompt', 'Answer tersely', '--append-system-prompt', 'Keep edits small', '--no-context-files', 'inspect this'])
    assert(parsed.errors.len() == 0)
    assert(parsed.print_mode && parsed.session_name == 'review' && parsed.fork_path == 'source.jsonl')
    assert(parsed.system_prompt == 'Answer tersely' && parsed.append_system_prompts.len() == 1)
    assert(parsed.no_context_files && parsed.messages.len() == 1 && parsed.messages[0] == 'inspect this')
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.print_mode && config.no_context_files && config.system_prompt == 'Answer tersely')
}

test 'short print mode keeps the appended prompt and later turns separate' {
    var parsed = args.parse(['adou', '-p', 'first prompt', 'second prompt'])
    assert(parsed.errors.len() == 0 && parsed.print_mode)
    assert(parsed.messages.len() == 2)
    assert(parsed.messages[0] == 'first prompt' && parsed.messages[1] == 'second prompt')
}

test 'CLI keeps @file arguments separate from the prompt' {
    var parsed = args.parse(['adou', '@src/main.n', 'summarize'])
    assert(parsed.errors.len() == 0)
    assert(parsed.file_args.len() == 1 && parsed.file_args[0] == 'src/main.n')
    assert(parsed.messages.len() == 1 && parsed.messages[0] == 'summarize')
}

test 'Pi initial message composition prefixes stdin and files only onto the first prompt' {
    [string] prompts = args.prepend_initial_text(['first', 'second'], 'stdin')
    prompts = args.prepend_initial_text(prompts, '<file>')
    assert(prompts.len() == 2)
    assert(prompts[0] == '<file>stdinfirst')
    assert(prompts[1] == 'second')

    [string] file_only = args.prepend_initial_text([], '<file>')
    assert(file_only.len() == 1 && file_only[0] == '<file>')
}

test 'Pi startup rejects empty names and api keys without an explicit model' {
    var empty_name = args.parse(['adou', '--name', '   '])
    assert(empty_name.errors.len() == 1 && empty_name.errors[0] == '--name requires a non-empty value')

    var key_without_model = args.parse(['adou', '--api-key', 'test-key'])
    assert(key_without_model.errors.len() == 0 && key_without_model.api_key == 'test-key')
}

test 'print mode is set even when it reads the prompt from stdin' {
    var parsed = args.parse(['adou', '--print'])
    assert(parsed.errors.len() == 0 && parsed.print_mode && parsed.messages.len() == 0)
}

test 'Pi allows session ids with ephemeral and forked sessions' {
    var ephemeral = args.parse(['adou', '--no-session', '--session-id', 'ephemeral-id', '--help'])
    assert(ephemeral.errors.len() == 0 && ephemeral.no_session && ephemeral.session_id == 'ephemeral-id')

    var fork_target = args.parse(['adou', '--fork', 'source.jsonl', '--session-id', 'child-id'])
    assert(fork_target.errors.len() == 0 && fork_target.fork_path == 'source.jsonl' && fork_target.session_id == 'child-id')
}

test 'session ids follow Pi character and boundary rules' {
    var invalid = args.parse(['adou', '--session-id', 'bad id'])
    assert(invalid.errors.len() == 1)
    assert(invalid.errors[0].starts_with('Session id must be non-empty'))

    var punctuation_boundary = args.parse(['adou', '--session-id', '.bad'])
    assert(punctuation_boundary.errors.len() == 1)
}

test 'session id conflicts match Pi continue and resume validation' {
    var continued = args.parse(['adou', '--session-id', 'child-id', '--continue'])
    assert(continued.errors.len() == 1 && continued.errors[0] == '--session-id cannot be combined with --continue')

    var resumed = args.parse(['adou', '--session-id', 'child-id', '--resume'])
    assert(resumed.errors.len() == 1 && resumed.errors[0] == '--session-id cannot be combined with --resume')
}

test 'Pi output and session selection flags parse without losing prompts' {
    var parsed = args.parse(['adou', '--mode', 'json', '--session-id', '01ABC', '--models', 'deepseek/*,anthropic/*', '--no-builtin-tools', '--export', 'session.html', '--verbose', '--offline', 'inspect'])
    assert(parsed.errors.len() == 0)
    assert(parsed.mode == 'json' && parsed.print_mode == false)
    assert(parsed.session_id == '01ABC' && parsed.scoped_models.len() == 2)
    assert(parsed.no_builtin_tools && parsed.export_path == 'session.html')
    assert(parsed.verbose && parsed.offline && parsed.messages.len() == 1)
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.mode == 'json' && config.print_mode && config.session_id == '01ABC')
    assert(config.no_builtin_tools && config.scoped_models.len() == 2)
}

test 'model listing accepts a provider pattern' {
    var parsed = args.parse(['adou', '--list-models', 'anthropic'])
    assert(parsed.errors.len() == 0 && parsed.list_models && parsed.list_models_pattern == 'anthropic')
}

test 'B1-R3-05 explicit --models propagates through args and resolve' {
    var without = args.parse(['adou', '--model', 'deepseek/deepseek-v4-flash'])
    assert(without.errors.len() == 0)
    assert(without.scoped_models.len() == 0)
    assert(!without.scoped_models_explicit)
    var config_without = resolve.resolve(without, '/tmp/work')
    assert(config_without.scoped_models.len() == 0)
    assert(!config_without.scoped_models_explicit)
    var with_scope = args.parse(['adou', '--model', 'deepseek/deepseek-v4-flash', '--models', 'deepseek/deepseek-v4-flash,openai/gpt-5.1-codex'])
    assert(with_scope.errors.len() == 0)
    assert(with_scope.scoped_models.len() == 2)
    assert(with_scope.scoped_models_explicit)
    var config_with = resolve.resolve(with_scope, '/tmp/work')
    assert(config_with.scoped_models.len() == 2)
    assert(config_with.scoped_models[0] == 'deepseek/deepseek-v4-flash')
    assert(config_with.scoped_models[1] == 'openai/gpt-5.1-codex')
    assert(config_with.scoped_models_explicit)
}

test 'tool scope flags preserve order and exclusions' {
    var parsed = args.parse(['adou', '--no-tools', '--tools', 'read, bash,edit', '--exclude-tools', 'bash'])
    assert(parsed.errors.len() == 0 && parsed.no_tools)
    assert(parsed.tool_names.len() == 3 && parsed.tool_names[1] == 'bash')
    assert(parsed.exclude_tool_names.len() == 1 && parsed.exclude_tool_names[0] == 'bash')
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.no_tools && config.tool_names.len() == 3 && config.exclude_tool_names[0] == 'bash')
}

test 'skill flags collect repeatable paths and no-skills aliases like Pi' {
    var parsed = args.parse(['adou', '--skill', 'one', '--no-skills', '--skill', 'two/dir', '-ns'])
    assert(parsed.errors.len() == 0)
    assert(parsed.no_skills)
    assert(parsed.skill_paths.len() == 2)
    assert(parsed.skill_paths[0] == 'one' && parsed.skill_paths[1] == 'two/dir')
    // Relative --skill paths are fixed against the launch cwd at resolve
    // time so a later --session/rebind to another project cannot drift them.
    var config = resolve.resolve(parsed, '/tmp/work')
    assert(config.no_skills)
    assert(config.skill_paths.len() == 2)
    assert(config.skill_paths[0] == '/tmp/work/one' && config.skill_paths[1] == '/tmp/work/two/dir')

    // Absolute paths pass through untouched.
    var absolute = args.parse(['adou', '--skill', '/abs/skill'])
    var absolute_config = resolve.resolve(absolute, '/tmp/work')
    assert(absolute_config.skill_paths.len() == 1 && absolute_config.skill_paths[0] == '/abs/skill')

    var missing = args.parse(['adou', '--skill'])
    assert(missing.errors.len() == 1 && missing.errors[0] == '--skill requires a value')
}

test 'CLI reports missing invalid conflicting and unknown options together' {
    var parsed = args.parse(['adou', '--provider', '--thinking', 'impossible', '--session', 'one', '--continue', '--unknown'])
    assert(parsed.errors.len() == 4)
    assert(parsed.errors[0] == '--provider requires a value')
    assert(parsed.errors[1] == 'Unknown option: --unknown')
    assert(parsed.errors[2].starts_with('Invalid thinking level'))
    assert(parsed.errors[3] == '--session and --continue cannot be used together')
}

test 'unknown context window never triggers threshold compaction' {
    var settings = compaction_types.settings_t {reserve_tokens: 16384, keep_recent_tokens: 20000,}
    assert(!token_estimate.should_compact(1000000, 0, settings))
}

test 'project context loads global then root-to-leaf with Pi candidate precedence' {
    string root = '/tmp/adou-context-' + identity.short_id()
    string agent_dir = path.join(root, 'agent')
    string project_dir = path.join(root, 'project')
    string nested_dir = path.join(project_dir, 'src/sub')
    write_file(path.join(agent_dir, 'AGENTS.md'), 'global rules')
    write_file(path.join(project_dir, 'AGENTS.md'), 'root rules')
    write_file(path.join(project_dir, 'CLAUDE.md'), 'shadowed by agents')
    write_file(path.join(project_dir, 'src/CLAUDE.md'), 'nested rules')
    os.mkdirs(nested_dir, 0o700)
    var loaded = project.load(nested_dir, agent_dir)
    assert(loaded.warnings.len() == 0 && loaded.files.len() == 3)
    assert(loaded.files[0].content == 'global rules')
    assert(loaded.files[1].content == 'root rules')
    assert(loaded.files[2].content == 'nested rules')
    string prompt = system_prompt.build(nested_dir, loaded.files, 'extra guideline')
    assert(prompt.contains('<project_context>'))
    assert(prompt.find('global rules') < prompt.find('root rules') && prompt.find('root rules') < prompt.find('nested rules'))
    assert(prompt.ends_with('Current working directory: ' + nested_dir))
    assert(prompt.contains('- read: Read file contents'))
    assert(prompt.contains('- bash: Execute bash commands (ls, grep, find, etc.)'))
    assert(prompt.contains('- edit: Make precise file edits with exact text replacement, including multiple disjoint edits in one call'))
    assert(prompt.contains('- write: Create or overwrite files'))
    assert(!prompt.contains('- grep:'))
    assert(!prompt.contains('- find:'))
    assert(!prompt.contains('- ls:'))
    string no_tools_prompt = system_prompt.build_with_tools(nested_dir, [], '', '', [])
    assert(no_tools_prompt.contains('Available tools:\n(none)'))
    assert(!no_tools_prompt.contains('- read:'))
    string prompt_tools = system_prompt.build_with_tools(nested_dir, [], '', '', ['read', 'edit', 'write', 'bash'])
    assert(prompt_tools.contains('- edit: Make precise file edits with exact text replacement, including multiple disjoint edits in one call'))
    assert(prompt_tools.contains('- read: Read file contents'))
    assert(prompt_tools.contains('Use read to examine files instead of cat or sed.'))
    assert(prompt_tools.contains('Use write only for new files or complete rewrites.'))
    assert(prompt_tools.contains('Inspect PI_* environment variables for current model and session details.'))
    os.rmdir(root, true)
}

test 'project .pi system files override user files with user fallback' {
    string root = '/tmp/adou-project-prompt-' + identity.short_id()
    string agent_dir = path.join(root, 'agent')
    string project_dir = path.join(root, 'project')
    string nested_dir = path.join(project_dir, 'src')
    write_file(path.join(agent_dir, 'SYSTEM.md'), 'global system')
    write_file(path.join(agent_dir, 'APPEND_SYSTEM.md'), 'global append')
    write_file(path.join(nested_dir, '.pi/SYSTEM.md'), 'project system')
    write_file(path.join(nested_dir, '.pi/APPEND_SYSTEM.md'), 'project append')
    os.mkdirs(nested_dir, 0o700)
    var system = project.system_prompt_file(nested_dir, agent_dir)
    var append = project.append_system_prompt_file(nested_dir, agent_dir)
    assert(system is ref<project.file_t>)
    if system is ref<project.file_t> system_file {
        assert(system_file.content == 'project system')
    }
    assert(append is ref<project.file_t>)
    if append is ref<project.file_t> append_file {
        assert(append_file.content == 'project append')
    }
    os.rmdir(path.join(nested_dir, '.pi'), true)
    var fallback = project.system_prompt_file(nested_dir, agent_dir)
    var append_fallback = project.append_system_prompt_file(nested_dir, agent_dir)
    assert(fallback is ref<project.file_t>)
    if fallback is ref<project.file_t> fallback_file {
        assert(fallback_file.content == 'global system')
    }
    assert(append_fallback is ref<project.file_t>)
    if append_fallback is ref<project.file_t> global_append {
        assert(global_append.content == 'global append')
    }
    os.rmdir(root, true)
}
