import adou.src.tui.text_utils
import strings

test 'visible width strips terminal strings and normalizes tabs' {
    assert(text_utils.visible_width('\x1b[31m红\x1b[0m\tX') == 6)
    assert(text_utils.visible_width('\x1b]8;;https://example.com\x07link\x1b]8;;\x07') == 4)
    assert(text_utils.visible_width('\x1b_payload\x1b\\ok') == 2)
    assert(text_utils.normalize_terminal_output('กำ\t\x1b]x\t\x07') == 'กํา   \x1b]x\t\x07')
}

test 'visible width handles large styled rows without per-byte rebuilding' {
    [u8] bytes = vec<u8>.new('x'.char(), 50000)
    string styled = '\x1b[38;2;102;102;102m' + (bytes as string) + '\x1b[0m'
    assert(text_utils.visible_width(styled) == 50000)
}

test 'normalize terminal output does not rebuild ANSI-only rows' {
    string row = '\x1b[38;2;212;212;212mcolored assistant text\x1b[39m'
    assert(text_utils.normalize_terminal_output(row) == row)
}

test 'truncate is grapheme safe preserves ANSI and pads by cells' {
    string plain = text_utils.truncate_to_width('ab界cd', 5, '...', false)
    assert(text_utils.visible_width(plain) == 5)
    assert(plain.contains('ab') && !plain.contains('界'))
    string styled = text_utils.truncate_to_width('\x1b[31mabcdef', 4, '…', true)
    assert(text_utils.visible_width(styled) == 4)
    assert(styled.contains('\x1b[0m…\x1b[0m'))
    assert(text_utils.truncate_to_width('界x', 1, '...', false) == '.')
}

test 'slice uses visible columns and strict wide boundary handling' {
    var loose = text_utils.slice_with_width('\x1b[31ma界b', 1, 2, false)
    assert(loose.text.contains('\x1b[31m') && loose.text.contains('界') && loose.width == 2)
    var strict = text_utils.slice_with_width('a界b', 1, 1, true)
    assert(strict.text == '' && strict.width == 0)
}

test 'wrap preserves styles hyperlinks words and CJK boundaries' {
    var words = text_utils.wrap_text_with_ansi('one two three', 7)
    assert(words.len() == 2 && text_utils.visible_width(words[0]) <= 7 && text_utils.visible_width(words[1]) <= 7)
    var cjk = text_utils.wrap_text_with_ansi('中文测试', 4)
    assert(cjk.len() == 2 && text_utils.visible_width(cjk[0]) == 4 && text_utils.visible_width(cjk[1]) == 4)
    var mixed = text_utils.wrap_text_with_ansi('alpha θ beta gamma', 10)
    assert(mixed.len() == 2 && mixed[0] == 'alpha θ' && mixed[1] == 'beta gamma')
    var styled = text_utils.wrap_text_with_ansi('\x1b[4;31mabcdef', 3)
    assert(styled.len() == 2 && styled[0].contains('\x1b[24m') && styled[1].contains('\x1b[4;31m'))
    var linked = text_utils.wrap_text_with_ansi('\x1b]8;;u\x07abcdef\x1b]8;;\x07', 3)
    assert(linked.len() == 2 && linked[0].contains('\x1b]8;;\x07') && linked[1].contains('\x1b]8;;u\x07'))
    var thinking = text_utils.wrap_text_with_ansi(' \x1b[3m\x1b[38;2;128;128;128mplan the styled streaming response carefully\x1b[39m\x1b[23m', 18)
    assert(thinking.len() == 3)
    for line in thinking {
        assert(text_utils.visible_width(line) <= 18 && line.contains('\x1b[3m') && line.contains('\x1b[23m'))
    }
}

test 'wraps large colored output without rebuilding each byte' {
    [u8] bytes = vec<u8>.new('x'.char(), 50000)
    string styled = '\x1b[38;2;102;102;102m' + (bytes as string) + '\x1b[0m'
    var wrapped = text_utils.wrap_text_with_ansi(styled, 100)
    assert(wrapped.len() == 500)
    for line in wrapped {
        assert(text_utils.visible_width(line) <= 100)
    }
}

test 'wraps large colored CJK output without rebuilding each grapheme' {
    [string] parts = vec<string>.cap_of(5000)
    for int index = 0; index < 5000; index += 1 {
        parts.push('中')
    }
    string styled = '\x1b[38;2;102;102;102m' + strings.join(parts, '') + '\x1b[0m'
    var wrapped = text_utils.wrap_text_with_ansi(styled, 100)
    assert(wrapped.len() == 100)
    for line in wrapped {
        assert(text_utils.visible_width(line) <= 100)
    }
}

test 'truncates large streamed rows without retaining the full visual history' {
    [u8] bytes = vec<u8>.new('x'.char(), 50000)
    string styled = '\x1b[38;2;102;102;102m' + (bytes as string) + '\x1b[0m'
    var truncated = text_utils.truncate_visual_lines(styled, 100, 20)
    assert(truncated[1] == 480)
    var rows = truncated[0].split('\n')
    assert(rows.len() == 20)
    for line in rows {
        assert(text_utils.visible_width(line) <= 100)
    }
}

test 'wraps high-frequency ANSI sequences in linear time' {
    [string] parts = vec<string>.cap_of(5000)
    for int index = 0; index < 5000; index += 1 {
        parts.push('\x1b[31mx\x1b[0m')
    }
    var wrapped = text_utils.wrap_text_with_ansi(strings.join(parts, ''), 100)
    assert(wrapped.len() == 50)
    for line in wrapped {
        assert(text_utils.visible_width(line) <= 100)
    }
}
