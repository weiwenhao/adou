import adou.src.context.skills
import adou.src.json_util
import fmt
import fs
import os
import path
import syscall
import time

pub fn write_file(string file_path, string content): void! {
    var parent = path.dir(file_path)
    os.mkdirs(parent, 0o700)
    var file = fs.open(file_path, syscall.O_WRONLY | syscall.O_CREAT | syscall.O_TRUNC, 0o644) catch error {
        throw error
    }
    file.write(content as [u8])
    file.close()
}

test 'frontmatter parses scalars like Pi' {
    string content = '---\nname: my-skill\ndescription: "Does things"\ndisable-model-invocation: true\n---\n\nBody text'
    var parsed = skills.parse_frontmatter(content)
    var frontmatter = parsed[0]
    var body = parsed[1]
    assert(json_util.opt_string(frontmatter, 'name') == 'my-skill')
    assert(json_util.opt_string(frontmatter, 'description') == 'Does things')
    assert(json_util.opt_bool(frontmatter, 'disable-model-invocation'))
    assert(body == 'Body text')
}

test 'frontmatter without a block keeps the whole body' {
    string content = 'plain markdown without frontmatter'
    var parsed = skills.parse_frontmatter(content)
    var frontmatter = parsed[0]
    var body = parsed[1]
    assert(json_util.opt_string(frontmatter, 'name') == '')
    assert(body == content)
}

test 'skill name validation follows the Agent Skills spec' {
    assert(skills.validate_skill_name('good-skill').len() == 0)
    assert(skills.validate_skill_name('-leading').len() > 0)
    assert(skills.validate_skill_name('trailing-').len() > 0)
    assert(skills.validate_skill_name('double--hyphen').len() > 0)
    assert(skills.validate_skill_name('Upper-Case').len() > 0)
    assert(skills.validate_skill_name('with_underscore').len() > 0)
}

test 'skill description is required' {
    assert(skills.validate_skill_description('').len() > 0)
    assert(skills.validate_skill_description('valid description').len() == 0)
}

test 'loads a skill from a directory root SKILL.md' {
    string dir = path.join('/tmp', 'adou-skills-test-' + random_suffix())
    write_file(path.join(dir, 'SKILL.md'), '---\nname: demo\ndescription: A demo skill\n---\n\nInstructions')
    var result = skills.load_skills_from_dir(dir, 'path')
    assert(result.skills.len() == 1)
    assert(result.skills[0].name == 'demo')
    assert(result.skills[0].description == 'A demo skill')
    assert(result.skills[0].base_dir == dir)
    assert(result.skills[0].source_info.scope == 'temporary')
    assert(result.diagnostics.len() == 0)
    os.rmdir(dir, true)
}

test 'falls back to the parent directory name and warns on missing description' {
    string dir = path.join('/tmp', 'adou-skills-test-' + random_suffix())
    write_file(path.join(dir, 'SKILL.md'), '---\n---\n\nInstructions without description')
    var result = skills.load_skills_from_dir(dir, 'path')
    assert(result.skills.len() == 0)
    assert(result.diagnostics.len() > 0)
    os.rmdir(dir, true)
}

test 'recurses into subdirectories for SKILL.md and loads root md files' {
    string root = path.join('/tmp', 'adou-skills-test-' + random_suffix())
    write_file(path.join(root, 'solo.md'), '---\nname: solo\ndescription: Solo skill\n---\n\nx')
    write_file(path.join(root, 'nested', 'SKILL.md'), '---\nname: nested-skill\ndescription: Nested skill\n---\n\nx')
    var result = skills.load_skills_from_dir(root, 'path')
    assert(result.skills.len() == 2)
    os.rmdir(root, true)
}

test 'a SKILL.md root stops recursion like Pi' {
    string root = path.join('/tmp', 'adou-skills-test-' + random_suffix())
    write_file(path.join(root, 'SKILL.md'), '---\nname: root-skill\ndescription: Root skill\n---\n\nx')
    write_file(path.join(root, 'nested', 'SKILL.md'), '---\nname: nested-skill\ndescription: Nested skill\n---\n\nx')
    var result = skills.load_skills_from_dir(root, 'path')
    assert(result.skills.len() == 1)
    assert(result.skills[0].name == 'root-skill')
    os.rmdir(root, true)
}

test 'honors ignore rules from .gitignore' {
    string root = path.join('/tmp', 'adou-skills-test-' + random_suffix())
    write_file(path.join(root, 'ignored', 'SKILL.md'), '---\nname: hidden\ndescription: Ignored skill\n---\n\nx')
    write_file(path.join(root, '.gitignore'), 'ignored/\n')
    var result = skills.load_skills_from_dir(root, 'path')
    assert(result.skills.len() == 0)
    os.rmdir(root, true)
}

test 'collision diagnostics report name conflicts across sources' {
    string root = path.join('/tmp', 'adou-skills-user-' + random_suffix())
    string user_dir = path.join(root, 'user')
    string project_dir = path.join(root, 'project')
    string home = path.join(root, 'home')
    write_file(path.join(user_dir, 'skills', 'SKILL.md'), '---\nname: shared\ndescription: User version\n---\n\nx')
    write_file(path.join(project_dir, '.pi', 'skills', 'SKILL.md'), '---\nname: shared\ndescription: Project version\n---\n\nx')
    write_file(path.join(project_dir, '.git', 'HEAD'), '')
    [string] extra = []
    // Pi's resourcePrecedenceRank puts trusted project auto (rank 1) above
    // user auto (rank 3), so the project .pi/skills version wins the name.
    // load_skills_full keeps home isolated (load_skills would read the real
    // HOME's ~/.agents/skills and leak user skills into this fixture).
    var result = skills.load_skills_full(project_dir, user_dir, home, extra, true, true)
    assert(result.skills.len() == 1)
    assert(result.skills[0].description == 'Project version')
    assert(result.skills[0].source_info.scope == 'project')
    assert(result.diagnostics.len() == 1)
    assert(result.diagnostics[0].kind == 'collision')
    assert(result.diagnostics[0].collision_winner == path.join(project_dir, '.pi', 'skills', 'SKILL.md'))
    assert(result.diagnostics[0].collision_loser == path.join(user_dir, 'skills', 'SKILL.md'))
    os.rmdir(root, true)
}

test 'project auto beats user auto and agent_dir beats home .agents' {
    string root = path.join('/tmp', 'adou-skills-rank-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    string project = path.join(root, 'proj')
    write_file(path.join(project, '.git', 'HEAD'), '')
    write_file(path.join(project, '.pi', 'skills', 'ranked', 'SKILL.md'), '---\nname: ranked\ndescription: Project .pi version\n---\n\nx')
    write_file(path.join(agent, 'skills', 'ranked', 'SKILL.md'), '---\nname: ranked\ndescription: Agent dir version\n---\n\nx')
    write_file(path.join(agent, 'skills', 'user-beats-home', 'SKILL.md'), '---\nname: user-beats-home\ndescription: Agent dir version\n---\n\nx')
    write_file(path.join(home, '.agents', 'skills', 'user-beats-home', 'SKILL.md'), '---\nname: user-beats-home\ndescription: Home .agents version\n---\n\nx')
    [string] extra = []
    var result = skills.load_skills_full(project, agent, home, extra, true, true)
    {string:string} by_name = {}
    for skill in result.skills {
        by_name[skill.name] = skill.description
    }
    assert(by_name['ranked'] == 'Project .pi version')
    assert(by_name['user-beats-home'] == 'Agent dir version')
    assert(result.skills.len() == 2)
    assert(result.diagnostics.len() == 2)
    for diagnostic in result.diagnostics {
        assert(diagnostic.kind == 'collision')
        assert(diagnostic.collision_winner == path.join(project, '.pi', 'skills', 'ranked', 'SKILL.md') || diagnostic.collision_winner == path.join(agent, 'skills', 'user-beats-home', 'SKILL.md'))
    }
    os.rmdir(root, true)
}

test 'agents discovery mode ignores root md files while pi mode loads them' {
    string root = path.join('/tmp', 'adou-skills-mode-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    string project = path.join(root, 'proj')
    write_file(path.join(project, '.git', 'HEAD'), '')
    write_file(path.join(project, '.pi', 'skills', 'root-skill.md'), '---\nname: root-skill\ndescription: .pi root md\n---\n\nx')
    write_file(path.join(project, '.pi', 'skills', 'nested', 'SKILL.md'), '---\nname: pi-nested\ndescription: .pi nested SKILL.md\n---\n\nx')
    write_file(path.join(project, '.agents', 'skills', 'ignored-root.md'), '---\nname: ignored-root\ndescription: .agents root md\n---\n\nx')
    write_file(path.join(project, '.agents', 'skills', 'agents-nested', 'SKILL.md'), '---\nname: agents-nested\ndescription: .agents nested SKILL.md\n---\n\nx')
    [string] extra = []
    var result = skills.load_skills_full(project, agent, home, extra, true, true)
    {string:bool} names = {}
    for skill in result.skills {
        names[skill.name] = true
    }
    assert(names.contains('root-skill'))
    assert(names.contains('pi-nested'))
    assert(!names.contains('ignored-root'))
    assert(names.contains('agents-nested'))
    // Home .agents/skills is agents mode too: root md never loads.
    write_file(path.join(home, '.agents', 'skills', 'home-root.md'), '---\nname: home-root\ndescription: Home root md\n---\n\nx')
    var with_home = skills.load_skills_full(project, agent, home, extra, true, true)
    {string:bool} home_names = {}
    for skill in with_home.skills {
        home_names[skill.name] = true
    }
    assert(!home_names.contains('home-root'))
    os.rmdir(root, true)
}

test 'above-repo .agents/skills layers never load' {
    string root = path.join('/tmp', 'adou-skills-above-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    string repo = path.join(root, 'repo')
    write_file(path.join(repo, '.git', 'HEAD'), '')
    write_file(path.join(root, '.agents', 'skills', 'above-repo', 'SKILL.md'), '---\nname: above-repo\ndescription: Above the git root\n---\n\nx')
    write_file(path.join(repo, '.agents', 'skills', 'in-repo', 'SKILL.md'), '---\nname: in-repo\ndescription: Inside the git root\n---\n\nx')
    [string] extra = []
    var result = skills.load_skills_full(path.join(repo, 'src'), agent, home, extra, true, true)
    {string:bool} names = {}
    for skill in result.skills {
        names[skill.name] = true
    }
    assert(names.contains('in-repo'))
    assert(!names.contains('above-repo'))
    assert(result.skills.len() == 1)
    os.rmdir(root, true)
}

