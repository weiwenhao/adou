test 'discovers user skills, home .agents/skills and project layers in Pi order' {
    string root = path.join('/tmp', 'adou-skills-tree-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    string project = path.join(root, 'proj')
    write_file(path.join(project, '.git', 'HEAD'), '')
    write_file(path.join(agent, 'skills', 'agent-only', 'SKILL.md'), '---\nname: agent-only\ndescription: From agent dir\n---\n\nx')
    write_file(path.join(home, '.agents', 'skills', 'home-only', 'SKILL.md'), '---\nname: home-only\ndescription: From home .agents\n---\n\nx')
    write_file(path.join(project, '.pi', 'skills', 'pi-only', 'SKILL.md'), '---\nname: pi-only\ndescription: From .pi/skills\n---\n\nx')
    write_file(path.join(project, '.agents', 'skills', 'agents-only', 'SKILL.md'), '---\nname: agents-only\ndescription: From project .agents\n---\n\nx')
    [string] extra = []
    var result = skills.load_skills_full(project, agent, home, extra, true, true)
    assert(result.skills.len() == 4)
    for skill in result.skills {
        if skill.name == 'home-only' {
            assert(skill.source_info.scope == 'user')
        }
        if skill.name == 'agents-only' {
            assert(skill.source_info.scope == 'project')
        }
    }
    os.rmdir(root, true)
}

test '.agents/skills layers walk up to the git root, nearest layer wins' {
    string root = path.join('/tmp', 'adou-skills-walk-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    write_file(path.join(root, '.git', 'HEAD'), '')
    write_file(path.join(root, 'proj', 'nested', '.agents', 'skills', 'layer-skill', 'SKILL.md'), '---\nname: layer-skill\ndescription: Near layer\n---\n\nx')
    write_file(path.join(root, '.agents', 'skills', 'layer-skill', 'SKILL.md'), '---\nname: layer-skill\ndescription: Far layer (git root)\n---\n\nx')
    write_file(path.join(root, '.agents', 'skills', 'git-root-only', 'SKILL.md'), '---\nname: git-root-only\ndescription: At the git root\n---\n\nx')
    [string] extra = []
    var result = skills.load_skills_full(path.join(root, 'proj', 'nested', 'deep'), agent, home, extra, true, true)
    {string:string} names = {}
    for skill in result.skills {
        names[skill.name] = skill.description
    }
    assert(names.contains('layer-skill'))
    assert(names['layer-skill'] == 'Near layer')
    assert(names.contains('git-root-only'))
    assert(result.skills.len() == 2)
    assert(result.diagnostics.len() == 1)
    assert(result.diagnostics[0].kind == 'collision')
    os.rmdir(root, true)
}

test '.pi/skills beats .agents/skills at the same level' {
    string root = path.join('/tmp', 'adou-skills-pi-wins-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    write_file(path.join(root, '.git', 'HEAD'), '')
    write_file(path.join(root, '.pi', 'skills', 'shared', 'SKILL.md'), '---\nname: shared\ndescription: .pi version\n---\n\nx')
    write_file(path.join(root, '.agents', 'skills', 'shared', 'SKILL.md'), '---\nname: shared\ndescription: .agents version\n---\n\nx')
    [string] extra = []
    var result = skills.load_skills_full(root, agent, home, extra, true, true)
    assert(result.skills.len() == 1)
    assert(result.skills[0].description == '.pi version')
    assert(result.diagnostics.len() == 1)
    assert(result.diagnostics[0].collision_winner == path.join(root, '.pi', 'skills', 'shared', 'SKILL.md'))
    os.rmdir(root, true)
}

test 'untrusted projects skip project layers but keep user and explicit skills' {
    string root = path.join('/tmp', 'adou-skills-trust-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    string project = path.join(root, 'proj')
    write_file(path.join(project, '.git', 'HEAD'), '')
    write_file(path.join(agent, 'skills', 'user-skill', 'SKILL.md'), '---\nname: user-skill\ndescription: User level\n---\n\nx')
    write_file(path.join(project, '.pi', 'skills', 'project-skill', 'SKILL.md'), '---\nname: project-skill\ndescription: Project level\n---\n\nx')
    write_file(path.join(project, '.agents', 'skills', 'agents-skill', 'SKILL.md'), '---\nname: agents-skill\ndescription: Agents level\n---\n\nx')
    [string] extra = []
    var result = skills.load_skills_full(project, agent, home, extra, true, false)
    assert(result.skills.len() == 1)
    assert(result.skills[0].name == 'user-skill')
    [string] explicit = [path.join(project, '.pi', 'skills')]
    var explicit_result = skills.load_skills_full(project, agent, home, explicit, false, false)
    assert(explicit_result.skills.len() == 1)
    assert(explicit_result.skills[0].name == 'project-skill')
    assert(explicit_result.diagnostics.len() == 0)
    os.rmdir(root, true)
}

test 'no-skills disables default discovery while explicit paths still load' {
    string root = path.join('/tmp', 'adou-skills-noskill-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    string project = path.join(root, 'proj')
    write_file(path.join(project, '.git', 'HEAD'), '')
    write_file(path.join(project, '.pi', 'skills', 'default-skill', 'SKILL.md'), '---\nname: default-skill\ndescription: Default discovery\n---\n\nx')
    write_file(path.join(project, 'explicit-skill', 'SKILL.md'), '---\nname: explicit-skill\ndescription: Explicit path\n---\n\nx')
    [string] none = []
    var result = skills.load_skills_full(project, agent, home, none, false, true)
    assert(result.skills.len() == 0)
    [string] explicit = [path.join(project, 'explicit-skill')]
    var explicit_result = skills.load_skills_full(project, agent, home, explicit, false, true)
    assert(explicit_result.skills.len() == 1)
    assert(explicit_result.skills[0].name == 'explicit-skill')
    os.rmdir(root, true)
}

test 'explicit paths keep user scope attribution when defaults are disabled' {
    string root = path.join('/tmp', 'adou-skills-scope-' + random_suffix())
    string home = path.join(root, 'home')
    string agent = path.join(root, 'agent')
    write_file(path.join(agent, 'skills', 'scoped', 'SKILL.md'), '---\nname: scoped\ndescription: Explicit user-dir path\n---\n\nx')
    [string] explicit = [path.join(agent, 'skills', 'scoped')]
    var result = skills.load_skills_full(root, agent, home, explicit, false, true)
    assert(result.skills.len() == 1)
    assert(result.skills[0].source_info.scope == 'user')
    os.rmdir(root, true)
}

test 'format_skills_for_prompt emits Agent Skills XML and skips disabled skills' {
    var visible = new skills.skill_t(name = 'demo', description = 'A <demo> skill', file_path = '/tmp/x/SKILL.md', base_dir = '/tmp/x', disable_model_invocation = false)
    var hidden = new skills.skill_t(name = 'manual', description = 'Manual only', file_path = '/tmp/y/SKILL.md', base_dir = '/tmp/y', disable_model_invocation = true)
    [ref<skills.skill_t>] list = [visible, hidden]
    string formatted = skills.format_skills_for_prompt(list)
    assert(formatted.find('<available_skills>') >= 0)
    assert(formatted.find('<name>demo</name>') >= 0)
    assert(formatted.find('A &lt;demo&gt; skill') >= 0)
    assert(formatted.find('<name>manual</name>') < 0)
    [ref<skills.skill_t>] none = []
    assert(skills.format_skills_for_prompt(none) == '')
}

test 'glob matching covers gitignore star and double-star semantics' {
    assert(skills.glob_match('*.md', 'notes.md'))
    assert(!skills.glob_match('*.md', 'sub/notes.md'))
    assert(skills.glob_match('**/*.md', 'sub/notes.md'))
    assert(skills.glob_match('**', 'sub'))
    assert(!skills.glob_match('a/*/c', 'a/b/d/c'))
    assert(skills.glob_match('a/*/c', 'a/b/c'))
}

fn random_suffix(): string {
    return fmt.sprintf('%d', time.now().ms_timestamp())
}
