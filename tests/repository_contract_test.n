import adou.src.ai.types as ai_types
import adou.src.session.backend
import adou.src.session.repository
import adou.src.storage.sqlite_repo
import adou.src.session.types as session_types
import os
import path
import syscall
import time
import fmt

// Phase 7 batch 1: shared SessionRepo contract exercised against both the
// JSONL and the in-memory backend through one assertion suite (no duplicated
// assertions).  Covers create/open/list/delete, duplicate and missing
// errors, full fork, fork before/at, parent lineage, entry order and JSONL
// reopen persistence.

fn user_message(string text): ai_types.message_t {
    return new ai_types.user_message_t(content = text)
}

fn fixture_cwd(): string {
    return syscall.getcwd() catch error {
        '/tmp'
    }
}

fn fork_before_throws(ref<repository.manager_t> manager, string entry_id): bool {
    manager.fork_before(entry_id) catch error {
        return true
    }
    return false
}

fn fork_to_throws(ref<repository.manager_t> manager, string cwd, string dir, string id): bool {
    manager.fork_to(cwd, dir, id) catch error {
        return true
    }
    return false
}

fn backend_fork_throws(backend.backend_t b, string id): bool {
    backend.fork_to(b, id) catch error {
        return true
    }
    return false
}

// Shared assertions run for any backend.  `persisted` selects the
// file-level list/delete checks that only apply to the JSONL backend.
fn run_contract_suite(backend.backend_t backend_ref, bool persisted): void! {
    var manager = backend.mgr(backend_ref)

    // create: header carries version, id and cwd.
    assert(manager.header.version == session_types.CURRENT_VERSION)
    assert(manager.header.id.len() > 0)
    assert(manager.header.cwd == fixture_cwd())

    // append two messages: entry order follows append order (SQLite
    // persists through the backend layer).
    // B2.3: an assistant entry flushes JSONL sessions so list/delete see them.
    backend.append_message(backend_ref, new ai_types.assistant_message_t(timestamp = 1)) catch e {throw e}
    string first_id = backend.append_message(backend_ref, user_message('contract first'))
    string second_id = backend.append_message(backend_ref, user_message('contract second'))
    var entries = manager.get_entries()
    // metadata entries may vary by backend; the two messages must be present
    // in append order with the second as the leaf.
    var message_kinds = 0
    var first_seen = 0
    var second_seen = 0
    for entry in entries {
        if entry.kind == session_types.ENTRY_MESSAGE {
            message_kinds += 1
            if entry.id == first_id {
                first_seen = message_kinds
            }
            if entry.id == second_id {
                second_seen = message_kinds
            }
        }
    }
    assert(message_kinds == 3)
    // Assistant seeds position 1; the user messages follow in order.
    assert(first_seen == 2 && second_seen == 3)
    assert(manager.get_leaf_id() == second_id)

    // parent lineage: the second message links to the first.
    var second = manager.get_entry(second_id)
    assert(second is ref<session_types.entry_t>)
    var second_ref = second as ref<session_types.entry_t>
    assert(second_ref.has_parent)
    assert(second_ref.parent_id == first_id)

    // missing entry: fork paths surface an explicit error.
    assert(fork_before_throws(manager, 'no-such-entry'))

    // fork before a user message keeps only its ancestors (target excluded).
    var before = manager.fork_before(first_id)
    var before_entries = before.get_entries()
    var before_has_target = false
    var before_has_second = false
    for entry in before_entries {
        if entry.id == first_id {
            before_has_target = true
        }
        if entry.id == second_id {
            before_has_second = true
        }
    }
    assert(!before_has_target)
    assert(!before_has_second)

    // fork at keeps the target as the new leaf.
    var at = manager.fork_at(first_id)
    var at_entries = at.get_entries()
    var at_has_target = false
    for entry in at_entries {
        if entry.id == first_id {
            at_has_target = true
        }
    }
    assert(at_has_target)
    assert(at.get_leaf_id() == first_id)

    // full fork: every entry is copied and the new header records the
    // parent session lineage.  JSONL keeps the source file reference in
    // header.parent_session; SQLite records the source session id.
    if persisted {
        var full = backend.fork_to(backend_ref, 'contract-fork')
        assert(backend.mgr(full).get_entries().len() == entries.len())
        assert(backend.mgr(full).header.parent_session != '')
        assert(backend.mgr(full).get_leaf_id() == manager.get_leaf_id())
        // duplicate id is rejected with an explicit error.
        assert(backend_fork_throws(backend_ref, 'contract-fork'))
    } else {
        var full = backend.fork_to(backend_ref, '')
        assert(backend.mgr(full).get_entries().len() == entries.len())
        assert(backend.mgr(full).header.parent_session == '')
    }

    // list/delete are backend-level and only apply to persisted backends.
    if persisted {
        var listed = backend.list_sessions(backend_ref)
        var found = false
        for candidate in listed {
            if candidate.contains(manager.header.id) {
                found = true
            }
        }
        assert(found)
        var (deleted, message) = backend.delete_session(backend_ref, manager.header.id)
        assert(deleted)
        assert(message.len() > 0)
        var listed_after = backend.list_sessions(backend_ref)
        for candidate in listed_after {
            assert(!candidate.contains(manager.header.id))
        }
    }
}

fn temp_dir(string tag): string {
    return path.join('/tmp', 'adou-contract-' + tag + '-' + fmt.sprintf('%d', time.now().ms_timestamp()))
}

test 'SessionRepo contract: JSONL backend' {
    string tmp_dir = temp_dir('jsonl')
    defer os.rmdir(tmp_dir, true) catch error {}
    var backend_ref = backend.create_jsonl(fixture_cwd(), tmp_dir)
    run_contract_suite(backend_ref, true)
}

test 'SessionRepo contract: in-memory backend' {
    var backend_ref = backend.open_memory(fixture_cwd())
    run_contract_suite(backend_ref, false)
}

test 'SessionRepo contract: SQLite backend' {
    string tmp_dir = temp_dir('sqlite')
    defer os.rmdir(tmp_dir, true) catch error {}
    string db_path = path.join(tmp_dir, 'sessions.db')
    var backend_ref = backend.open_sqlite(fixture_cwd(), db_path)
    run_contract_suite(backend_ref, true)
}

test 'SQLite reopen persists entries, order and lineage' {
    string tmp_dir = temp_dir('sqlite-reopen')
    defer os.rmdir(tmp_dir, true) catch error {}
    string db_path = path.join(tmp_dir, 'sessions.db')
    var created = backend.open_sqlite(fixture_cwd(), db_path)
    string first_id = backend.append_message(created, user_message('reopen first'))
    string second_id = backend.append_message(created, user_message('reopen second'))
    sqlite_repo.close_db(created.sqlite_db as ref<sqlite_repo.db_t>)

    var reopened = backend.open_sqlite_session(fixture_cwd(), db_path, backend.mgr(created).header.id)
    var entries = backend.mgr(reopened).get_entries()
    var messages = 0
    var first_seen = 0
    var second_seen = 0
    for entry in entries {
        if entry.kind == session_types.ENTRY_MESSAGE {
            messages += 1
            if entry.id == first_id {
                first_seen = messages
            }
            if entry.id == second_id {
                second_seen = messages
            }
        }
    }
    assert(messages == 2)
    assert(first_seen == 1 && second_seen == 2)
    var second = backend.mgr(reopened).get_entry(second_id)
    var second_ref = second as ref<session_types.entry_t>
    assert(second_ref.has_parent)
    assert(second_ref.parent_id == first_id)
}

test 'JSONL reopen persists entries, order and lineage' {
    string tmp_dir = temp_dir('reopen')
    defer os.rmdir(tmp_dir, true) catch error {}
    var created = backend.create_jsonl(fixture_cwd(), tmp_dir)
    string first_id = backend.mgr(created).append_message(user_message('reopen first'))
    string second_id = backend.mgr(created).append_message(user_message('reopen second'))
    string file_path = backend.mgr(created).session_file

    var reopened = backend.open_jsonl(file_path)
    assert(reopened.kind == 'jsonl')
    var entries = backend.mgr(reopened).get_entries()
    var messages = 0
    var first_seen = 0
    var second_seen = 0
    for entry in entries {
        if entry.kind == session_types.ENTRY_MESSAGE {
            messages += 1
            if entry.id == first_id {
                first_seen = messages
            }
            if entry.id == second_id {
                second_seen = messages
            }
        }
    }
    assert(messages == 2)
    // append order survives the reopen.
    assert(first_seen == 1 && second_seen == 2)
    var second = backend.mgr(reopened).get_entry(second_id)
    var second_ref = second as ref<session_types.entry_t>
    assert(second_ref.has_parent)
    assert(second_ref.parent_id == first_id)
}
