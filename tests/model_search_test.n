import adou.src.tui.model_search

test 'model search matches id provider and name like Pi' {
    assert(model_search.match_model('deepseek/deepseek-v4-flash', 'DeepSeek V4 Flash', ''))
    assert(model_search.match_model('deepseek/deepseek-v4-flash', 'DeepSeek V4 Flash', 'deepseek-v4'))
    assert(model_search.match_model('deepseek/deepseek-v4-flash', 'DeepSeek V4 Flash', 'deepseek'))
    assert(model_search.match_model('deepseek/deepseek-v4-flash', 'DeepSeek V4 Flash', 'v4 flash'))
    assert(!model_search.match_model('deepseek/deepseek-v4-flash', 'DeepSeek V4 Flash', 'gpt'))
}

test 'provider scope filtering follows the models patterns' {
    assert(model_search.provider_in_scope('deepseek', []))
    assert(model_search.provider_in_scope('deepseek', ['deepseek', 'openai/*']))
    assert(model_search.provider_in_scope('deepseek', ['deepseek/deepseek-v4-flash']))
    assert(!model_search.provider_in_scope('anthropic', ['deepseek']))
    assert(!model_search.provider_in_scope('anthropic', ['openai/*']))
}
