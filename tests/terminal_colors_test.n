import adou.src.tui.terminal_colors

test 'is_osc11_background_color_response matches Pi patterns' {
    assert(terminal_colors.is_osc11_background_color_response('\x1b]11;rgb:1a/2b/3c\x07'))
    assert(terminal_colors.is_osc11_background_color_response('\x1b]11;#123456\x1b\\'))
    assert(!terminal_colors.is_osc11_background_color_response('plain'))
}

test 'parses hex backgrounds like Pi' {
    var color = terminal_colors.parse_osc11_background_color('\x1b]11;#123456\x07')
    if color is terminal_colors.rgb_color_t parsed {
        assert(parsed.r == 0x12)
        assert(parsed.g == 0x34)
        assert(parsed.b == 0x56)
    } else {
        assert(false)
    }
}

test 'parses rgba channel ratios like Pi' {
    var color = terminal_colors.parse_osc11_background_color('\x1b]11;rgb:ffff/0000/8080\x07')
    if color is terminal_colors.rgb_color_t parsed {
        assert(parsed.r == 255)
        assert(parsed.g == 0)
        assert(parsed.b == 128)
    } else {
        assert(false)
    }
    var four = terminal_colors.parse_osc11_background_color('\x1b]11;rgba:ffff/ffff/0000/0000\x1b\\')
    if four is terminal_colors.rgb_color_t parsed {
        assert(parsed.r == 255)
        assert(parsed.g == 255)
    } else {
        assert(false)
    }
}

test 'rejects malformed backgrounds like Pi' {
    assert(terminal_colors.parse_osc11_background_color('not-osc') is null)
    assert(terminal_colors.parse_osc11_background_color('\x1b]11;#12\x07') is null)
    assert(terminal_colors.parse_osc11_background_color('\x1b]11;rgb:gg/00/00\x07') is null)
}

test 'parses the color scheme report like Pi' {
    assert(terminal_colors.parse_terminal_color_scheme_report('\x1b[?997;1n') == 'dark')
    assert(terminal_colors.parse_terminal_color_scheme_report('\x1b[?997;2n') == 'light')
    assert(terminal_colors.parse_terminal_color_scheme_report('nope') == '')
}
